ngm:personal-digital-asset-account a owl:Class ;
    rdfs:label "Personal Digital Asset Account"@en ;
    rdfs:comment "Personal accounts are individual user accounts that grant access to digital services, platforms, or financial instruments, uniquely associated with a natural person. In the context of digital assets and cryptocurrency, personal accounts include exchange accounts, self-custody wallets, and HMRC Self Assessment registrations through which an individual reports capital gains from asset disposals. Proper management of personal accounts intersects identity management, authentication, privacy, and tax compliance obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:dependsOn ngm:corporate-tax-compliance-framework,
        ngm:corporate-tax-compliance-framework-treatment-crypto,
        ngm:cryptocurrency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:digital-identity,
        ngm:privacy ;
    vc:requires ngm:authentication,
        ngm:identity-management ;
    vc:slug "personal-digital-asset-account" ;
    vc:sourceDomain "infrastructure" .

ngm:physics-material a owl:Class ;
    rdfs:label "Physics Material"@en ;
    rdfs:comment "A data structure encoding surface interaction properties — friction coefficients, coefficient of restitution, density, and drag — that govern object behaviour within a physics simulation engine. Physics materials are distinct from visual rendering materials and are consumed by simulation solvers to produce physically plausible contact responses for metaverse avatars, props, and environments."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
