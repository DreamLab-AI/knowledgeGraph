    vc:relatedTo ngm:point-cloud ;
    vc:relatedTo ngm:proximity-sensor ;
    vc:relatedTo ngm:slam ;
    vc:relatedTo ngm:ultrasonic-sensor ;
    vc:slug "2-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar-scanning .
