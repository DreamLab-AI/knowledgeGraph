    rdfs:label "Data Anonymization Pipeline"@en ;
    rdfs:comment "An automated, multi-stage process that systematically removes, masks, or generalizes personally identifiable information (PII) from datasets to protect individual privacy while preserving data utility for analysis."@en ;
    rdfs:subClassOf ngm:data-protection ;
    vc:enables ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:privacy-preserving-analytics,
        ngm:secure-data-sharing ;
    vc:hasPart ngm:de-identification-module,
        ngm:generalization-engine,
        ngm:perturbation-function,
        ngm:pii-detector,
        ngm:risk-assessor,
        ngm:suppression-filter ;
    vc:isPartOf ngm:compliance-framework,
        ngm:data-governance,
        ngm:privacy-engineering ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-classification,
        ngm:privacy-policy,
        ngm:risk-assessment ;
    vc:slug "data-anonymization-pipeline" ;
    vc:sourceDomain "spatial-computing" .

