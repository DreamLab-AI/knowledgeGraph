    vc:enables ngm:reasoning,
        ngm:semantic-reasoning-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:description-logic,
        ngm:rdf ;
    vc:slug "owl-2-web-ontology-language" ;
    vc:sourceDomain "standards" .

ngm:password-authentication a owl:Class ;
    rdfs:label "Password Authentication"@en ;
    rdfs:comment "Password authentication is a knowledge-based method of verifying a user's identity by checking a secret string they supply against a stored credential. The stored credential is typically a salted cryptographic hash rather than the plaintext password, so that the secret is never recovered even if the store is compromised. As a single-factor mechanism it is widely deployed but vulnerable to guessing, reuse, phishing, and credential-stuffing attacks, motivating stronger or supplementary methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:session-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:authentication ;
    vc:contrastsWith ngm:biometric-authentication,
        ngm:multi-factor-authentication ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:access-control,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:privacy,
        ngm:security ;
    vc:requires ngm:identity-management,
        ngm:session-management ;
    vc:slug "password-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:cryptography,
        ngm:salt .

ngm:policy-enforcement-point a owl:Class ;
    rdfs:label "Policy Enforcement Point"@en ;
    rdfs:comment "A Policy Enforcement Point (PEP) is a runtime architectural component in access control systems that intercepts every request for a protected resource, forwards a structured authorisation query to a Policy Decision Point (PDP), and enforces the returned permit, deny, or obligation decision at the resource boundary. The PEP–PDP separation, first formalised in the OASIS XACML standard, decouples policy logic from enforcement infrastructure and enables centralised policy management across heterogeneous systems. In zero-trust architectures every network transaction passes through a PEP, which may be realised as a reverse proxy, API gateway, service mesh sidecar, network firewall, or identity-aware proxy. The model extends naturally to software-defined perimeters, ABAC deployments, and AI governance enforcement layers where model prompts and outputs must satisfy content policies before reaching end users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-information-point ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-decision-point ],
        ngm:access-control ;
    vc:bridgesTo ngm:ai-governance,
        ngm:data-mesh ;
    vc:contrastsWith ngm:network-perimeter-security,
        ngm:role-based-access-control ;
    vc:enables ngm:attribute-based-access-control,
        ngm:continuous-verification,
        ngm:least-privilege,
        ngm:privileged-access-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:access-control-policy,
        ngm:authorisation ;
    vc:isPartOf ngm:zero-trust-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:identity-and-access-management,
        ngm:policy-administration-point,
        ngm:policy-enforcement,
        ngm:reverse-proxy,
        ngm:software-defined-perimeter ;
    vc:requires ngm:authentication,
        ngm:policy-decision-point,
        ngm:policy-information-point ;
    vc:slug "policy-enforcement-point" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-sp-800-207,
        ngm:xacml ;
    vc:supports ngm:audit-logging,
        ngm:data-governance ;
    vc:uses ngm:api-gateway,
        ngm:mutual-tls,
        ngm:oauth-2-0,
        ngm:service-mesh .

ngm:policy-gradient-methods a owl:Class ;
    rdfs:label "Policy Gradient Methods"@en ;
    rdfs:comment "Policy Gradient Methods are a class of reinforcement-learning algorithms that directly optimise a parameterised policy by ascending the gradient of expected cumulative reward. Rather than deriving a policy from a learned value function, they adjust action probabilities to make rewarding behaviour more likely, using estimators such as REINFORCE and actor-critic variants. They naturally handle continuous and stochastic action spaces and underpin modern algorithms like proximal policy optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value-function ],
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:value-function ;
    vc:enables ngm:proximal-policy-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:reward-function,
        ngm:value-function ;
    vc:implements ngm:policy-optimisation ;
    vc:isPartOf ngm:policy-optimisation,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning ;
    vc:requires ngm:markov-decision-process,
        ngm:reward-function ;
    vc:slug "policy-gradient-methods" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-reinforcement-learning ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network .

ngm:prior-distribution a owl:Class ;
    rdfs:label "Prior Distribution"@en ;
    rdfs:comment "A prior distribution is the probability distribution over unknown quantities that encodes belief before observing data, in Bayesian inference. It is combined with the likelihood via Bayes' theorem to produce the posterior. The choice of prior, ranging from informative to weakly informative or uninformative, encodes assumptions and regularises inference, especially with limited data."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:posterior-distribution,
        ngm:probabilistic-model ;
    vc:slug "prior-distribution" ;
    vc:sourceDomain "ai" .

ngm:privacy-preserving-analytics a owl:Class ;
    rdfs:label "Privacy Preserving Analytics"@en ;
    rdfs:comment "Privacy Preserving Analytics (PPA) is a cross-disciplinary field at the intersection of cryptography, statistics, and data engineering concerned with enabling quantitative analysis of datasets containing sensitive personal or proprietary information without exposing the underlying individual-leve..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
