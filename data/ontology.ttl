    vc:slug "generative-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:message-passing a owl:Class ;
    rdfs:label "Message Passing"@en ;
    rdfs:comment "Message passing is a foundational communication paradigm in which processes, objects, or distributed agents interact exclusively by sending and receiving discrete, self-contained messages rather than accessing shared memory. It underlies actor-model concurrency, microservice architectures, and distributed AI agent frameworks, providing loose coupling, location transparency, and inherent support for asynchronous execution. Messages may traverse in-process channels, persistent message queues, or wide-area network transports, and may be delivered synchronously (blocking until acknowledgement) or asynchronously (fire-and-forget). Formal semantics are studied through process calculi such as the pi-calculus and CSP, and the paradigm has grown from Hewitt's 1973 Actor Model into the backbone of modern cloud-native and multi-agent AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:inter-agent-communication,
        ngm:model-context-protocol,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:remote-procedure-call,
        ngm:shared-memory ;
    vc:enables ngm:actor-model,
        ngm:distributed-computing,
        ngm:event-driven-architecture,
        ngm:fault-tolerance,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:message-broker,
        ngm:message-queue ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:apache-kafka,
        ngm:protocol-buffer ;
    vc:requires ngm:network-transport,
        ngm:serialisation ;
    vc:slug "message-passing" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:asynchronous-communication,
        ngm:concurrency,
        ngm:distributed-architecture ;
    vc:uses ngm:middleware,
        ngm:publish-subscribe-pattern,
        ngm:remote-procedure-call .

ngm:quality-assurance a owl:Class ;
    rdfs:label "Quality Assurance"@en ;
    rdfs:comment "Quality Assurance (QA) is the systematic discipline of establishing and maintaining defined standards of correctness, reliability, safety, and fitness-for-purpose across the full lifecycle of software systems, AI models, and digital infrastructure. It encompasses planned and systematic activities — including requirements analysis, process audits, test design, validation, verification, and continuous monitoring — that prevent defects from reaching production rather than merely detecting them after the fact. In AI contexts, QA extends beyond functional correctness to encompass model fairness, adversarial robustness, data quality, and distributional-shift monitoring, increasingly mandated by governance frameworks such as the EU AI Act and ISO/IEC 42001. Effective QA integrates with DevOps and MLOps pipelines through automated gates that enforce quality thresholds before any artefact is promoted to the next deployment stage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:requirements-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:test-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:code-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-validation ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:explainability,
        ngm:model-evaluation ;
    vc:contrastsWith ngm:quality-control ;
    vc:enables ngm:compliance-framework,
        ngm:continuous-delivery,
        ngm:model-governance,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:code-review,
