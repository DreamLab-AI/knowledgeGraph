ngm:hardware-security-module a owl:Class ;
    rdfs:label "Hardware Security Module"@en ;
    rdfs:comment "A Hardware Security Module (HSM) is a dedicated, tamper-evident and tamper-resistant hardware appliance that generates, stores, and manages cryptographic keys in a physically protected environment and performs sensitive cryptographic operations—such as signing, encryption, and key derivation—entirely within that secure boundary, so that plaintext key material is never exposed to the host system. HSMs are validated against formal security standards such as FIPS 140-2/140-3 (at levels 2 and 3) and Common Criteria, and are mandated by financial payment schemes (PCI-DSS), certificate authorities, and government PKI infrastructures."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:key-management,
        ngm:public-key-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:secure-enclave,
        ngm:trusted-execution-environment ;
    vc:slug "hardware-security-module" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-key-management,
        ngm:encryption .

ngm:industrial-robot a owl:Class ;
