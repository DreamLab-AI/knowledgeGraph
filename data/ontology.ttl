ngm:erc-3475 a owl:Class ;
    rdfs:label "ERC-3475"@en ;
    rdfs:comment "ERC-3475 is an Ethereum standard defining an interface for abstract bonds, supporting multiple redemption conditions within a single token contract."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum-smart-contract-platform ;
    vc:slug "erc-3475" ;
    vc:sourceDomain "standards" .

