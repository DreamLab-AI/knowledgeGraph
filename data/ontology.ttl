    vc:slug "ai-hardware" ;
    vc:sourceDomain "artificial-intelligence" .

vf:analog-to-digital-converter a owl:Class ;
    rdfs:label "Analog To Digital Converter"@en ;
    rdfs:comment "Analog To Digital Converter (ADC) is an electronic component that converts continuous analog signals such as sound, light, or voltage into discrete digital representations through sampling, quantization, and encoding processes, enabling digital processing, storage, and transmission of real-world signals."@en ;
    rdfs:subClassOf <urn:visionflow:linked:signal-processing-hardware> ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables <urn:visionflow:linked:digital-audio-recording>,
