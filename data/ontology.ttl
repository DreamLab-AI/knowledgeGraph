ngm:emission-factors a owl:Class ;
    rdfs:label "Emission Factors"@en ;
    rdfs:comment "Emission Factors are coefficients that quantify the average amount of a pollutant—typically greenhouse gases expressed in CO2-equivalent—released per unit of an activity, such as per kilowatt-hour of electricity consumed or per kilometre driven by a particular vehicle class. They are derived from empirical measurement campaigns and modelling studies, and published by bodies such as the IPCC, the IEA, and national environmental agencies. Emission factors are the fundamental input to carbon accounting frameworks such as the GHG Protocol, enabling organisations to calculate their Scope 1, 2, and 3 inventories from activity data. Regular revision of these factors reflects technological change and regional grid decarbonisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activity-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ghg-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-1-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-2-emissions ],
        ngm:carbon-accounting ;
    vc:bridgesTo ngm:supply-chain-transparency ;
    vc:dependsOn ngm:measurement-uncertainty ;
    vc:enables ngm:carbon-disclosure,
        ngm:carbon-footprint-measurement,
