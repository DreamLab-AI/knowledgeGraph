        ngm:distributed-systems ;
    vc:contrastsWith ngm:centralized-robot-control,
        ngm:single-robot-system ;
    vc:dependsOn ngm:fault-tolerance,
        ngm:self-organization ;
    vc:enables ngm:collective-intelligence,
        ngm:environmental-monitoring,
        ngm:robot-learning,
        ngm:search-and-rescue ;
    vc:hasMaturity ngmi:maturity-emerging ;
