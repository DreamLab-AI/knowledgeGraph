ngm:contract-theory a owl:Class ;
    rdfs:comment "Contract theory is the branch of economics that studies how parties design agreements under asymmetric information, incentive conflicts, and incomplete contracting. It analyses problems such as moral hazard, adverse selection, and signalling to derive incentive-compatible contracts that align the interests of principals and agents. It provides the formal foundations for mechanism and incentive design, including in tokenised and decentralised systems."@en ;
    rdfs:label "Contract Theory"@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
