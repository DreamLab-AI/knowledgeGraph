ngm:video-conferencing a owl:Class ;
    rdfs:label "Video Conferencing"@en ;
    rdfs:comment "\"Real-time audio-visual communication technology enabling multiple geographically distributed participants to see and hear each other simultaneously through internet-connected devices, supporting face-to-face interaction across distances.\""@en ;
