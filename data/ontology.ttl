        ngm:cybersecurity,
        ngm:explainability,
        ngm:interpretability,
        ngm:knowledge-graph,
        ngm:user-experience ;
    vc:requires ngm:data-analytics,
        ngm:supervised-learning ;
    vc:slug "behavior-analysis" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:avatar-behavior ;
    vc:uses ngm:deep-learning,
        ngm:neural-network,
        ngm:reinforcement-learning .

ngm:benchmark-evaluation a owl:Class ;
    rdfs:label "Benchmark Evaluation"@en ;
    rdfs:comment "Benchmark evaluation is the systematic measurement of a model or system against a standardised dataset and scoring protocol so that results are comparable across systems and over time. A benchmark specifies the task, the data splits, the permitted inputs, and the metrics used to rank performance. In machine learning, benchmark evaluation drives the field's empirical progress, but it is subject to well-known failure modes including train-test contamination, overfitting to leaderboards, and construct validity gaps between the benchmark and the real-world capability it purports to measure."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:evaluation-harness ;
    vc:slug "benchmark-evaluation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:evaluation-metric,
        ngm:performance-benchmarks .

ngm:beneficial-ownership-disclosure a owl:Class ;
    rdfs:label "Beneficial Ownership Disclosure"@en ;
    rdfs:comment "Beneficial ownership disclosure is the regulatory requirement for legal entities such as companies, trusts, and partnerships to identify and register the natural persons who ultimately own or control them above a defined threshold, typically 25% of shares or voting rights. The primary purpose is to prevent the misuse of corporate structures for money laundering, tax evasion, corruption, and sanctions circumvention by making true ownership transparent to regulators and, increasingly, the public."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fatf,
        ngm:know-your-customer ;
    vc:requires ngm:data-governance,
        ngm:identity-verification ;
    vc:slug "beneficial-ownership-disclosure" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:aml-kyc-compliance,
        ngm:anti-money-laundering .

ngm:binding-corporate-rules a owl:Class ;
    rdfs:label "Binding Corporate Rules"@en ;
    rdfs:comment "Binding Corporate Rules (BCRs) are an intra-group data transfer mechanism approved by EU data protection authorities that allow multinational corporate groups to transfer personal data from the European Economic Area to group entities in third countries lacking an EU adequacy decision, provided the group adopts and enforces a comprehensive, legally binding internal data protection code. BCRs are assessed and approved by a lead supervisory authority under the GDPR framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance-framework ],
        ngm:cross-border-data-transfer-rule ;
    vc:contrastsWith ngm:standard-contractual-clauses ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-sovereignty ;
    vc:requires ngm:data-governance-framework,
        ngm:gdpr ;
    vc:slug "binding-corporate-rules" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-protection,
        ngm:privacy-by-design .

ngm:bip-process a owl:Class ;
    rdfs:label "BIP Process"@en ;
    rdfs:comment "The Bitcoin Improvement Proposal (BIP) process is the standardised social and technical workflow by which proposed changes to the Bitcoin protocol, best practices, and informational standards are drafted, reviewed, debated, and either accepted or rejected by the Bitcoin developer community. It defines the lifecycle of a proposal from Draft through Proposed, Final, Active, Withdrawn, or Rejected, providing a structured mechanism for decentralised protocol governance without a centralised authority."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:bitcoin-improvement-proposals,
        ngm:nakamoto-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-327,
        ngm:bip-342,
        ngm:nakamoto-coefficient ;
    vc:slug "bip-process" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-core .

ngm:bitcoin-centralisation-risks a owl:Class ;
    rdfs:label "Bitcoin Centralisation Risks"@en ;
    rdfs:comment "Bitcoin Centralisation Risks refers to the ensemble of systemic vulnerabilities arising from the progressive concentration of economic power, computational control, physical infrastructure, custody arrangements, development authority, and payment routing within Bitcoin's nominally decentralised e..."@en ;
