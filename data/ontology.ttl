        ngm:convolutional-neural-network .

ngm:membership-inference a owl:Class ;
    rdfs:label "Membership Inference"@en ;
    rdfs:comment "A privacy attack that determines wher a specific data point was included in a model's training dataset by analyzing the model's behavior on that input, potentially revealing sensitive information about individuals' participation in datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:differential-privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attack,
        ngm:data-protection,
        ngm:model-inversion,
        ngm:privacy ;
    vc:requires ngm:machine-learning-model,
        ngm:training-data ;
    vc:slug "membership-inference" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:message-passing a owl:Class ;
    rdfs:label "Message Passing"@en ;
    rdfs:comment "Message passing is a paradigm for inter-process and inter-component communication in which discrete, self-contained messages are sent between processes, objects, or distributed nodes rather than using shared memory. It underlies actor-model concurrency, microservice architectures, and distributed systems, providing loose coupling, location transparency, and inherent support for asynchronous execution. Messages can be delivered synchronously (blocking) or asynchronously (non-blocking), and may traverse in-process channels, message queues, or network transports."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:distributed-computing,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-communication,
        ngm:event-driven-architecture,
        ngm:inter-agent-communication ;
    vc:slug "message-passing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-architecture ;
    vc:uses ngm:message-queue,
        ngm:middleware .

ngm:meta-learning a owl:Class ;
    rdfs:label "Meta-Learning"@en ;
    rdfs:comment "Meta-Learning, colloquially described as 'learning to learn', is the study and design of machine learning systems that improve their own learning algorithms or initialisation through experience across multiple tasks, enabling rapid adaptation to new tasks with minimal data. Rather than learning a task directly, a meta-learning algorithm learns a prior or inductive bias that facilitates fast generalisation. Key paradigms include model-agnostic meta-learning (MAML), which optimises for a parameter initialisation that is close to good solutions for many tasks, and metric-based approaches such as prototypical networks that learn a task-agnostic embedding space. Meta-learning is central to few-shot learning, continual learning, and automated machine learning research."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:parameter-efficient-fine-tuning,
        ngm:training-dataset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:slug "meta-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:gradient-descent .

ngm:metaverse-venue a owl:Class ;
    rdfs:label "Metaverse Venue"@en ;
    rdfs:comment "Virtual 3D spaces within metaverse platforms designed to host events, conferences, exhibitions, and social gatherings, enabling global participation through customisable avatars and interactive environments that transcend physical location constraints."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:global-virtual-gatherings ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metaverse-venue" ;
    vc:sourceDomain "spatial-computing" .

ngm:monetary-policy a owl:Class ;
    rdfs:label "Monetary Policy"@en ;
    rdfs:comment "Monetary policy is the set of decisions made by a monetary authority — traditionally a central bank — to manage the supply of money, credit conditions, and interest rates in order to achieve macroeconomic objectives such as price stability, full employment, and sustainable growth. In traditional finance it encompasses tools such as open market operations, reserve requirements, and benchmark interest-rate setting. In decentralised systems and blockchain protocols, monetary policy is often encoded algorithmically into protocol rules that govern token emission schedules, inflation rates, halving events, and burn mechanisms, removing discretionary human intervention."@en ;
    rdfs:subClassOf ngm:economic-governance ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:economics,
        ngm:inflation-control ;
    vc:slug "monetary-policy" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:monetary-policy-transmission ;
    vc:uses ngm:economic-mechanism,
        ngm:tokenomics .

ngm:motion-capture-rig a owl:Class ;
    rdfs:label "Motion Capture Rig"@en ;
    rdfs:comment "Physical hardware or software system capturing human motion for animation or simulation through cameras, markers, sensors, and tracking infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration-target ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-markers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-solver-software ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:animation-retargeting,
        ngm:biomechanical-analysis,
        ngm:performance-capture,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:calibration-target,
        ngm:data-processing-unit,
        ngm:imu-sensors,
        ngm:motion-markers,
        ngm:optical-cameras,
        ngm:tracking-volume ;
    vc:isPartOf ngm:reality-capture-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:camera-calibration,
        ngm:high-speed-networking,
        ngm:motion-solver-software,
        ngm:synchronized-timing ;
    vc:slug "motion-capture-rig" ;
    vc:sourceDomain "spatial-computing" .

ngm:multi-agent-system a owl:Class ;
    rdfs:label "Multi-Agent System"@en ;
    rdfs:comment "A multi-agent system (MAS) is a computational architecture in which multiple autonomous agents—each with local perception, state, and decision-making capability—interact within a shared environment to accomplish individual or collective objectives. Agents may be cooperative, competitive, or mixed-motive, and coordination emerges from direct communication, environmental signalling, or market-like mechanisms. MAS formalises distributed problem-solving where no single agent possesses global knowledge or centralised control. The paradigm spans robotics, AI orchestration, financial modelling, and decentralised protocol design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inter-agent-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        ngm:ai-agent-system ;
    vc:enables ngm:collective-decision-making,
        ngm:swarm-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-agent,
        ngm:inter-agent-communication ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:emergence,
        ngm:multi-agent-systems ;
    vc:slug "multi-agent-system" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:reinforcement-learning .

ngm:multi-signature a owl:Class ;
    rdfs:label "Multi-Signature"@en ;
    rdfs:comment "Multi-Signature (multisig) is a cryptographic access-control scheme requiring that a transaction or operation be authorised by a threshold number of independent private keys from a defined set before it is considered valid. Commonly expressed as m-of-n (e.g. 2-of-3), multisig eliminates single points of failure in key custody and enforces shared governance over digital assets or smart contracts. It is foundational to institutional cryptocurrency custody, DAO treasury management, and hardware-secure wallet architectures. Multisig schemes may be implemented at the protocol layer, at the script level (as in Bitcoin P2SH), or at the application layer via smart contracts."@en ;
    rdfs:subClassOf ngm:signature-scheme ;
    vc:enables ngm:dao-governance,
        ngm:multi-sig-governance,
        ngm:multi-signature-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ecdsa,
        ngm:schnorr-signature,
        ngm:threshold-signature-scheme ;
    vc:slug "multi-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-keys,
        ngm:smart-contract .

ngm:ne-rf a owl:Class ;
    rdfs:label "NeRF"@en ;
    rdfs:comment "Neural Radiance Field (NeRF) is a neural scene representation technique that encodes a continuous volumetric scene as a multi-layer perceptron mapping 3D coordinates and viewing directions to colour and density values, enabling photorealistic novel view synthesis from a sparse set of input images. Originally introduced by Mildenhall et al. in 2020, NeRF uses volumetric ray marching during rendering to integrate along rays through the implicit field, producing high-fidelity reconstructions without explicit geometry. It has catalysed a broad family of neural rendering methods spanning real-time variants, dynamic scenes, and large-scale outdoor capture."@en ;
    rdfs:subClassOf ngm:neural-radiance-field ;
    vc:enables ngm:3-d-reconstruction,
        ngm:novel-view-synthesis,
        ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:point-cloud,
        ngm:volumetric-capture ;
    vc:slug "ne-rf" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:deep-learning,
        ngm:differentiable-rendering,
        ngm:neural-network .

ngm:network-performance-metrics a owl:Class ;
    rdfs:label "Network Performance Metrics"@en ;
    rdfs:comment "Network Performance Metrics are quantitative measures used to characterise the operational quality of a communication network, encompassing latency, throughput, packet loss rate, jitter, and availability. These metrics are collected continuously from network devices, links, and endpoints to support quality-of-service enforcement, capacity planning, fault detection, and SLA compliance verification. They underpin all layers of network management from physical links to application-level experience."@en ;
    rdfs:subClassOf ngm:quality-of-service ;
    vc:enables ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:edge-computing,
        ngm:internet-infrastructure,
        ngm:latency ;
    vc:slug "network-performance-metrics" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:latency-management-protocol,
        ngm:real-time-monitoring .

ngm:networking-technology a owl:Class ;
    rdfs:label "Networking Technology"@en ;
    rdfs:comment "The protocols, hardware, and software frameworks that enable real-time data transmission, synchronisation, and communication between distributed participants. In spatial computing contexts this encompasses WebRTC, QUIC, UDP/TCP stacks, adaptive bitrate streaming, and delta-compression techniques that support low-latency avatar synchronisation and shared world-state updates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-quality-metric ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:multi-user-systems,
        ngm:real-time ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:network-quality-metric,
        ngm:open-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "networking-technology" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:spatial-computing ;
    vc:uses ngm:distributed-system .

ngm:neural-machine-translation a owl:Class ;
    rdfs:label "Neural Machine Translation"@en ;
    rdfs:comment "Neural Machine Translation (NMT) is an approach to automated language translation in which end-to-end neural networks — typically based on encoder-decoder architectures with attention mechanisms — learn to map source-language sequences directly to target-language sequences from parallel corpora. Unlike earlier statistical phrase-based methods, NMT systems capture long-range dependencies and global sentence context, producing more fluent and contextually accurate translations. The Transformer architecture has become the dominant NMT paradigm since its introduction in 2017."@en ;
    rdfs:subClassOf ngm:language-translation ;
    vc:enables ngm:real-time-language-translation,
        ngm:real-time-translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:language-model,
        ngm:natural-language-processing ;
    vc:slug "neural-machine-translation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:transformer-architecture .

ngm:neural-radiance-fields a owl:Class ;
    rdfs:label "Neural Radiance Fields"@en ;
    rdfs:comment "A neural rendering technique that represents 3D scenes as continuous volumetric radiance functions encoded by multilayer perceptrons, mapping 5D inputs (3D spatial position plus 2D viewing direction) to colour and volume density. Novel viewpoints are synthesised by volumetric ray marching through the learned representation, enabling photorealistic view synthesis from sparse photograph sets without explicit 3D geometry. Introduced by Mildenhall et al. (ECCV 2020), NeRF has driven a generation of implicit neural scene representations spanning telepresence, virtual production, and robotics."@en ;
    rdfs:subClassOf ngm:dc-telepresence,
        ngm:real-time-rendering-pipeline ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:photorealistic-rendering,
        ngm:scene-capture-and-reconstruction,
        ngm:telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:3-d-content-generation,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-reconstruction,
        ngm:computer-vision,
        ngm:neural-rendering,
        ngm:point-cloud ;
    vc:slug "neural-radiance-fields" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning,
        ngm:ray-marching .

ngm:neuromorphic-computing a owl:Class ;
    rdfs:label "Neuromorphic Computing"@en ;
    rdfs:comment "A computational paradigm that designs hardware and software systems to mirror the structure and function of biological neural networks, integrating memory and processing units to enable parallel, event-driven information processing inspired by how neurons communicate through electrical spikes. Unlike conventional von Neumann architectures, neuromorphic systems perform computation asynchronously at the location of data, enabling orders-of-magnitude improvements in energy efficiency for AI inference at the edge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neuromorphic-chips ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neuromorphic-chip ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:artificial-general-intelligence,
        ngm:cognitive-architecture ;
    vc:enables ngm:autonomous-system,
        ngm:edge-ai-accelerator,
        ngm:edge-ai-system,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:neuromorphic-chip,
        ngm:neuromorphic-chips ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:edge-computing,
        ngm:event-driven-architecture,
        ngm:hardware-acceleration,
        ngm:parallel-processing ;
    vc:requires ngm:ai-hardware,
        ngm:inference-hardware ;
    vc:slug "neuromorphic-computing" ;
    vc:sourceDomain "spatial-computing" .

ngm:nostr a owl:Class ;
    rdfs:label "Nostr"@en ;
    rdfs:comment "Nostr (Notes and Other Stuff Transmitted by Relays) is an open, censorship-resistant social-messaging protocol built around a minimal event model in which users identify themselves by a secp256k1 cryptographic key pair and publish signed JSON events to one or more relay servers over WebSocket connections. The protocol has no central server: identity is purely the public key, and relays are interchangeable infrastructure that store and forward events without requiring accounts or trust; clients subscribe to relays using filter objects and receive matching events. Nostr Improvement Proposals (NIPs) extend the core event kind system to cover short-form notes, long-form articles, direct messages (encrypted with NIP-04/NIP-44), zap payments (Lightning Network), community moderation, and identity verification. Its radical simplicity and cryptographic self-sovereignty have made Nostr the primary decentralised social-layer for the Bitcoin and Lightning ecosystem."@en ;
    rdfs:subClassOf ngm:nostr-protocol ;
    vc:enables ngm:decentralised-identity,
        ngm:decentralised-web,
        ngm:social-network-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance,
        ngm:did-nostr-identity,
        ngm:self-sovereign-identity ;
    vc:slug "nostr" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:public-key,
        ngm:public-key-cryptography,
        ngm:web-socket .

ngm:notified-body a owl:Class ;
    rdfs:label "Notified Body"@en ;
    rdfs:comment "An independent third-party conformity assessment organisation formally designated by a national notifying authority under the EU AI Act (Articles 29–39) to audit and certify high-risk AI systems — particularly biometric identification and product-safety-component systems — against technical documentation, quality management, and harmonised standards requirements."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:regulatory-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:dependsOn ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:conformity-assessment ;
    vc:isPartOf ngm:regulatory-framework ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "notified-body" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:national-competent-authority .

ngm:object-recognition a owl:Class ;
    rdfs:label "Object Recognition"@en ;
    rdfs:comment "Object recognition is a computer vision task that involves identifying and localising instances of predefined object categories within images or video streams, producing class labels, bounding boxes, segmentation masks, or pose estimates depending on the task variant. It subsumes tasks including image classification, object detection, semantic segmentation, and instance segmentation, and has become a core capability of autonomous systems, augmented reality, and content understanding pipelines. Modern approaches are dominated by deep convolutional and transformer-based architectures trained on large annotated datasets."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection,
        ngm:pattern-recognition ;
    vc:slug "object-recognition" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:feature-extraction .

ngm:on-device-learning a owl:Class ;
    rdfs:label "On-Device Learning"@en ;
    rdfs:comment "Machine learning model training and adaptation occurring directly on end-user devices using only local data, without transmitting raw data to cloud servers. Enables personalised model adaptation, privacy preservation, and offline functionality while addressing challenges of limited compute, memory, and energy. Implemented through transfer learning, few-shot adaptation, and continual learning techniques on mobile and embedded platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-deployment,
        ngm:edge-ai-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-privacy,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:knowledge-distillation-for-edge,
        ngm:tiny-ml ;
    vc:requires ngm:model-compression-for-edge ;
    vc:slug "on-device-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:federated-learning,
        ngm:machine-learning-framework,
        ngm:transfer-learning .

ngm:open-cv a owl:Class ;
    rdfs:label "OpenCV"@en ;
    rdfs:comment "OpenCV (Open Source Computer Vision Library) is a BSD-licensed open-source library providing over 2,500 optimised algorithms for real-time computer vision, image processing, and machine learning, originally developed by Intel and now maintained by the OpenCV Foundation. It supports C++, Python, Java, and JavaScript bindings and runs on Linux, Windows, macOS, iOS, and Android. The library encompasses classical algorithms for feature detection, camera calibration, stereo vision, optical flow, and object tracking, as well as deep learning inference through the DNN module, which supports models from TensorFlow, PyTorch, and ONNX. OpenCV is the de facto standard toolkit for robotics perception pipelines, augmented reality applications, and embedded vision systems."@en ;
    rdfs:subClassOf ngm:computer-vision-system ;
    vc:enables ngm:camera-calibration,
        ngm:depth-estimation,
        ngm:object-detection-and-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:image-processing-software,
        ngm:object-detection ;
    vc:slug "open-cv" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:augmented-reality,
        ngm:perception-system ;
    vc:uses ngm:feature-extraction,
        ngm:image-segmentation .

ngm:open-id4-vci a owl:Class ;
    rdfs:label "OpenID4VCI"@en ;
    rdfs:comment "OpenID for Verifiable Credential Issuance (OpenID4VCI) is an OpenID Foundation protocol specification that defines a standard API by which an Issuer can deliver W3C Verifiable Credentials to a Holder's digital wallet using OAuth 2.0 and OpenID Connect as the underlying authorisation and identity layer. The protocol specifies credential offer flows, authorisation code and pre-authorised code grant types, credential endpoint interactions, and metadata discovery, enabling interoperable credential issuance across identity wallet implementations and issuing authority systems. It is designed to complement OpenID4VP (Verifiable Presentations) to form a complete self-sovereign identity exchange ecosystem."@en ;
    rdfs:subClassOf ngm:credential-issuance ;
    vc:enables ngm:decentralized-identity,
        ngm:digital-identity-wallet ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:open-id4-vp,
        ngm:sd-jwt ;
    vc:slug "open-id4-vci" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:verifiable-credentials .

ngm:optical-tracking a owl:Class ;
    rdfs:label "Optical Tracking"@en ;
    rdfs:comment "A sensing technology that uses camera-based systems and computer vision algorithms to determine the position and orientation of objects or users within physical space. Implementations range from marker-based infrared systems achieving sub-millimetre accuracy to markerless inside-out tracking using SLAM, enabling motion capture, hand tracking, and environmental mapping for XR applications."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:photogrammetry,
        ngm:structure-from-motion ;
    vc:enables ngm:hand-tracking,
        ngm:motion-capture,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "optical-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:pose-estimation,
        ngm:slam .

ngm:parallel-robot a owl:Class ;
    rdfs:label "Parallel Robot"@en ;
    rdfs:comment "A robot whose end-effector is connected to the base by multiple independent, simultaneously actuated kinematic chains (limbs), giving it a closed-loop structure. Parallel robots achieve high rigidity, speed, and accuracy with low moving mass; canonical examples include the Delta robot and Stewart platform used in pick-and-place, machining, and flight simulation applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stewart-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delta-robot ],
        ngm:manipulator-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:cylindrical-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delta-robot,
        ngm:stewart-platform ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:scara-robot ;
    vc:slug "parallel-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:electric-linear-actuator,
        ngm:forward-kinematics,
        ngm:robot-joint .

ngm:parameter-count a owl:Class ;
    rdfs:label "Parameter Count"@en ;
    rdfs:comment "The total number of trainable weights and biases in a neural network, serving as the primary measure of model size and capacity. Parameter count typically ranges from millions to hundreds of billions in modern language models, and governs memory requirements, inference cost, and the upper bound on information that can be encoded; scaling law research relates it to training compute and dataset size."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:dependsOn ngm:neural-network-architecture ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:large-language-models,
        ngm:neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-infrastructure ;
    vc:slug "parameter-count" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:particle-system a owl:Class ;
    rdfs:label "Particle System"@en ;
    rdfs:comment "A computer graphics technique that simulates fuzzy, chaotic, or fluid phenomena by managing large numbers of small graphical objects with properties like position, velocity, color, and lifetime, controlled by emitters and affected by forces to create effects like fire, smoke, water, and magical e..."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:visual-effects ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:dynamic-visual-effects ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "particle-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:paxos a owl:Class ;
    rdfs:label "Paxos"@en ;
    rdfs:comment "Paxos is a family of fault-tolerant distributed consensus algorithms first formally described by Leslie Lamport in 1989 and published in 1998, designed to allow a cluster of processes to agree on a single value or sequence of values despite the failure of a minority of participants. The algorithm proceeds through prepare and accept phases orchestrated by a proposer, with acceptors voting to commit proposed values and learners observing the final agreement. Multi-Paxos extends the basic protocol to achieve consensus on a log of commands efficiently, forming the algorithmic foundation of replicated state machines. Paxos and its derivatives, including Raft and HotStuff, underpin virtually every strongly consistent distributed database and coordination service in production use today."@en ;
    rdfs:subClassOf ngm:consensus-algorithm ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-computing,
        ngm:distributed-ledger ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism,
        ngm:state-machine-replication ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:distributed-protocol,
        ngm:hot-stuff-consensus,
        ngm:nakamoto-consensus,
        ngm:quorum ;
    vc:slug "paxos" ;
    vc:sourceDomain "infrastructure" .

ngm:permissionless-trading a owl:Class ;
    rdfs:label "Permissionless Trading"@en ;
    rdfs:comment "Permissionless trading refers to the ability to execute financial trades — buying, selling, or swapping digital assets — without requiring authorisation from a centralised intermediary, gatekeeper, or identity provider. Enabled by on-chain smart contracts and automated market makers (AMMs), permissionless trading removes the account approval, KYC, and whitelist requirements of traditional financial markets, allowing any wallet address to interact directly with liquidity pools. It is a foundational property of decentralised finance (DeFi) protocols."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:asset-trading,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:permissionless-network,
        ngm:token-swapping,
        ngm:uniswap ;
    vc:slug "permissionless-trading" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:point-cloud-processing a owl:Class ;
    rdfs:label "Point Cloud Processing"@en ;
    rdfs:comment "Point cloud processing is the set of computational algorithms and pipelines that transform raw collections of georeferenced 3D coordinate samples — produced by LiDAR scanners, depth cameras, structured-light systems, or photogrammetric reconstruction — into structured, semantically meaningful representations suitable for downstream applications such as autonomous navigation, digital twin construction, heritage documentation, and environmental monitoring. Core operations include filtering, registration (alignment of multiple scans), segmentation, feature extraction, surface reconstruction, and compression, often executed on GPU-accelerated or specialised embedded hardware to meet real-time constraints."@en ;
    rdfs:subClassOf ngm:point-cloud ;
    vc:enables ngm:3-d-gaussian-splatting,
        ngm:ne-rf,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:lidar-scanning,
        ngm:photogrammetry ;
    vc:slug "point-cloud-processing" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:depth-sensing,
        ngm:lidar,
        ngm:spatial-data-structure .

ngm:power-systems a owl:Class ;
    rdfs:label "Power Systems"@en ;
    rdfs:comment "Power Systems refers to the interconnected infrastructure of electrical generation, transmission, distribution, and consumption that constitutes a modern electricity network, together with the engineering discipline that analyses, designs, and controls this infrastructure. Key concerns include power flow analysis, voltage stability, frequency regulation, fault analysis, and the integration of variable renewable generation sources into grid operations. Power systems engineering underpins all modern industrial economies and is undergoing significant transformation as decarbonisation mandates, distributed energy resources, and digital control systems reshape traditional architectures. The discipline employs optimisation, control theory, and increasingly machine learning for real-time grid management."@en ;
    rdfs:subClassOf ngm:energy-and-power ;
    vc:enables ngm:battery-management-system,
        ngm:industrial-io-t ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:energy-management,
        ngm:renewable-energy,
        ngm:smart-grid ;
    vc:slug "power-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:optimal-control,
        ngm:optimisation,
        ngm:sensor-data .

ngm:preimage-resistance a owl:Class ;
    rdfs:label "Preimage Resistance"@en ;
    rdfs:comment "Preimage Resistance is a security property of a cryptographic hash function requiring that, given a hash output h, it is computationally infeasible to find any input m such that H(m) = h. This one-way property is foundational for password hashing, proof-of-work puzzles, and blockchain address derivation, ensuring that knowledge of a public address does not reveal the corresponding private key."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-security,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blake2,
        ngm:collision-resistance,
        ngm:keccak-256,
        ngm:private-key,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "preimage-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:presence-detection a owl:Class ;
    rdfs:label "Presence Detection"@en ;
    rdfs:comment "Presence Detection is the real-time determination of whether a user, avatar, or entity is active and spatially located within a digital environment. It combines sensor fusion, computer vision, and network signalling to maintain accurate availability states, enabling responsive social interactions, attention-aware interfaces, and adaptive content delivery in spatial computing systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:spatial-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:context-aware-computing,
        ngm:presence ;
    vc:slug "presence-detection" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:sensor-fusion .

ngm:pretrained-model a owl:Class ;
    rdfs:label "Pretrained Model"@en ;
    rdfs:comment "A neural network or machine learning model that has been trained on a large dataset (often a broad corpus) before being adapted to a specific downstream task through fine-tuning or prompting. Pretrained models encode general representations—linguistic, visual, or multimodal—that can be efficiently transferred, dramatically reducing the data and compute required for specialised applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:checkpoints ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pretrained-weights ],
        ngm:ai-technique,
        ngm:model ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:lo-ra-fine-tuning,
        ngm:neural-network-quantisation,
        ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:checkpoints,
        ngm:pretrained-weights ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:large-language-models,
        ngm:transfer-learning ;
    vc:slug "pretrained-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:pre-training .

ngm:privacy-enhancing-computation-pec a owl:Class ;
    rdfs:label "Privacy-Enhancing Computation (PEC)"@en ;
    rdfs:comment "Computational techniques that enable data processing and analysis while preserving privacy through cryptographic mods such as homomorphic encryption, secure multi-party computation, and differential privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-infrastructure ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:confidential-computing,
        ngm:privacy-compliant-processing,
        ngm:privacy-preserving-analytics,
        ngm:secure-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:isPartOf ngm:privacy-architecture,
        ngm:security-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-primitive,
        ngm:key-management,
        ngm:trust-infrastructure ;
    vc:slug "privacy-enhancing-computation-pec" ;
    vc:sourceDomain "spatial-computing" .

ngm:privacy-enhancing-technologies a owl:Class ;
    rdfs:label "Privacy Enhancing Technologies"@en ;
    rdfs:comment "Privacy Enhancing Technologies (PETs) are a family of cryptographic and systems-engineering techniques designed to minimise the collection, use, and disclosure of personal data while still enabling legitimate data processing for analytics, machine learning, and regulatory compliance. The family encompasses Zero-Knowledge Proofs, Differential Privacy, Homomorphic Encryption, Secure Multi-Party Computation, Trusted Execution Environments, anonymisation pipelines, pseudonymisation, and synthetic data generation. PETs implement the data-minimisation and privacy-by-design principles mandated by frameworks such as GDPR and the UK Data Protection Act 2018. They are increasingly deployed by financial institutions, healthcare providers, and government agencies to unlock the utility of sensitive data without exposing individual records, and are recognised by the UK ICO, European Data Protection Board, and US NIST as essential infrastructure for trustworthy data ecosystems."@en ;
    rdfs:subClassOf ngm:privacy-preserving-technology ;
    vc:enables ngm:data-minimisation,
        ngm:privacy-preserving-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:gdpr,
        ngm:privacy-by-design ;
    vc:slug "privacy-enhancing-technologies" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-protection-regulation ;
    vc:uses ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof .

ngm:privacy-mechanism a owl:Class ;
    rdfs:label "Privacy Mechanism"@en ;
    rdfs:comment "A Privacy Mechanism is a technical method or protocol designed to preserve individuals' data privacy during data collection, processing, or publication. Examples include differential privacy, federated learning, and homomorphic encryption, each providing mathematically grounded guarantees against disclosure of sensitive information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:gdpr-compliance ;
    vc:requires ngm:privacy-by-design ;
    vc:slug "privacy-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:privacy .

ngm:privileged-access-management a owl:Class ;
    rdfs:label "Privileged Access Management"@en ;
    rdfs:comment "Privileged Access Management (PAM) is a cybersecurity discipline and category of technology solutions that controls, monitors, and audits the access rights of users, accounts, and systems with elevated permissions in IT environments. PAM encompasses vaulting of privileged credentials, just-in-time access provisioning, session recording, and anomaly detection for privileged sessions. It addresses the risk that compromised administrator accounts represent the most damaging attack vector in enterprise breaches. PAM solutions enforce the principle of least privilege and provide forensic audit trails required by compliance frameworks such as ISO/IEC 27001 and SOX."@en ;
    rdfs:subClassOf ngm:identity-and-access-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:identity-management,
        ngm:multi-factor-authentication,
        ngm:zero-trust-architecture ;
    vc:slug "privileged-access-management" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:compliance-audit-trail,
        ngm:information-security,
        ngm:iso-iec-27001 ;
    vc:uses ngm:digital-certificate,
        ngm:session-management .

ngm:procedural-animation a owl:Class ;
    rdfs:label "Procedural Animation"@en ;
    rdfs:comment "Procedural Animation is a spatial computing technique that generates character and object motion algorithmically at runtime rather than from pre-authored keyframe sequences. It encompasses inverse kinematics systems, physics-based secondary motion, dynamic environmental adaptation, and behaviour-driven posing, enabling responsive and scalable animation in interactive metaverse environments."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:animation-technique,
        ngm:avatar-behavior ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:animation-retargeting,
        ngm:motion-capture ;
    vc:slug "procedural-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:inverse-kinematics,
        ngm:physics-engine,
        ngm:physics-simulation .

ngm:projects a owl:Class ;
    rdfs:label "Projects"@en ;
    rdfs:comment "Projects is the top-level organisational concept grouping active development initiatives within this knowledge graph. It serves as a Kanban and progress-tracking container for ongoing technical, research, and creative workstreams, linking to child project nodes such as PlayerTwo, BroBots, and Automated Podcast."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:player-two ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:project-bro-bots ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:player-two,
        ngm:project-automated-podcast,
        ngm:project-bro-bots ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:agentic-alliance ;
    vc:slug "projects" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:automated-planning .

ngm:proof-based-consensus a owl:Class ;
    rdfs:label "Proof-Based Consensus"@en ;
    rdfs:comment "Proof-Based Consensus is the family of blockchain consensus mechanisms in which participants must provide a verifiable cryptographic or computational proof to earn the right to propose or validate blocks. This family includes proof-of-work (computational puzzle), proof-of-stake (economic stake), delegated proof-of-stake, proof-of-authority, proof-of-history, and related variants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pure-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-history ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        ngm:bc-protocol-and-consensus,
        ngm:consensus-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake,
        ngm:proof-of-authority,
        ngm:proof-of-history,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:pure-proof-of-stake ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:nakamoto-consensus ;
    vc:slug "proof-based-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:proprioceptive-sensor a owl:Class ;
    rdfs:label "Proprioceptive Sensor"@en ;
    rdfs:comment "ProprioceptiveSensor is a transducer or sensing system that measures a robot's internal physical state — encompassing joint angle, angular velocity, linear and angular acceleration, motor torque, drive current, strain, and contact force — without reference to external landmarks or environmental f..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tactile-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:current-sensor ],
        ngm:control-feedback-element,
        ngm:mechatronic-component,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:closed-loop-control,
        ngm:collision-detection,
        ngm:impedance-control,
        ngm:legged-locomotion,
        ngm:safe-physical-human-robot-interaction,
        ngm:sensor-fusion,
        ngm:state-estimation,
        ngm:torque-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:current-sensor,
        ngm:force-torque-sensor,
        ngm:inertial-measurement-unit,
        ngm:joint-encoder,
        ngm:resolver,
        ngm:strain-gauge,
        ngm:tachometer,
        ngm:tactile-sensor ;
    vc:implements ngm:hall-effect-sensing,
        ngm:mems-gyroscope,
        ngm:photometric-stereo,
        ngm:quadrature-encoding,
        ngm:series-elastic-actuation,
        ngm:wheatstone-bridge-measurement ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:model-predictive-control,
        ngm:reinforcement-learning-for-robotics,
        ngm:robot-operating-system,
        ngm:whole-body-control ;
    vc:requires ngm:actuator,
        ngm:analog-to-digital-converter,
        ngm:motor-driver,
        ngm:real-time-operating-system,
        ngm:sensor-calibration,
        ngm:signal-conditioning ;
    vc:slug "proprioceptive-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61800-adjustable-speed-drives,
        ngm:ieee-1451-sensor-standard,
        ngm:iso-9283-robot-performance-standard ;
    vc:supports ngm:exoskeleton-control,
        ngm:legged-locomotion,
        ngm:manipulation,
        ngm:soft-robotics,
        ngm:surgical-robotics ;
    vc:uses ngm:bi-ss-c-protocol,
        ngm:can-bus,
        ngm:ether-cat,
        ngm:i2-c,
        ngm:spi,
        ngm:ssi-protocol .

ngm:protocol-buffer a owl:Class ;
    rdfs:label "Protocol Buffer"@en ;
    rdfs:comment "Protocol Buffer is a technology infrastructure concept and a type of Data Format."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:data-format ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "protocol-buffer" ;
    vc:sourceDomain "infrastructure" .

ngm:public-blockchain a owl:Class ;
    rdfs:label "Public Blockchain"@en ;
    rdfs:comment "A permissionless, decentralised distributed ledger network in which any party may participate, validate transactions, and inspect the chain state without requiring authorisation. Public blockchains such as Bitcoin and Ethereum achieve censorship resistance and immutability through global state replication and open consensus mechanisms, at the cost of reduced transaction throughput and higher energy consumption relative to permissioned alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:permissioned-blockchain ;
    vc:enables ngm:censorship-resistance,
        ngm:cryptocurrency,
        ngm:immutability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:distributed-ledger-technology ;
    vc:slug "public-blockchain" ;
    vc:sourceDomain "infrastructure" .

ngm:qlo-ra a owl:Class ;
    rdfs:label "QLoRA"@en ;
    rdfs:comment "An extension of LoRA (Low-Rank Adaptation) that combines 4-bit NormalFloat quantisation of frozen base model weights with full-precision trainable low-rank adapter matrices. QLoRA additionally employs double quantisation and paged optimisers to achieve extreme memory efficiency, enabling fine-tuning of 65B-parameter models on a single 48GB GPU without significant performance degradation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation ;
    vc:requires ngm:neural-network-quantisation,
        ngm:quantisation ;
    vc:slug "qlo-ra" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:large-language-models .

ngm:radiology-ai a owl:Class ;
    rdfs:label "Radiology AI"@en ;
    rdfs:comment "Radiology AI comprises artificial intelligence systems designed for automated interpretation and quantitative analysis of radiological imaging modalities — X-ray, CT, MRI, and ultrasound. These systems perform lesion detection, organ segmentation, and structured reporting at radiologist-level accuracy, integrating with PACS workflows and validated through prospective clinical trials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:medical-imaging ],
        ngm:ai-application,
        ngm:medical-imaging-ai ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:object-detection ;
    vc:requires ngm:medical-imaging ;
    vc:slug "radiology-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:image-segmentation .

ngm:raft a owl:Class ;
    rdfs:label "Raft"@en ;
    rdfs:comment "Raft is a distributed consensus algorithm designed explicitly for understandability, introduced by Diego Ongaro and John Ousterhout at USENIX ATC 2014 as a more comprehensible alternative to the Paxos family of protocols. Raft decomposes the consensus problem into three relatively independent sub-problems: leader election, log replication, and safety. A Raft cluster maintains a replicated log of commands through a strong leader that serialises all writes; followers replicate the leader's log entries and redirect client requests. Leader election uses randomised timeouts to avoid split votes. Raft has become the dominant consensus algorithm in modern distributed systems infrastructure, underpinning etcd, CockroachDB, TiKV, Consul, and many other widely deployed systems."@en ;
    rdfs:subClassOf ngm:consensus-algorithm ;
    vc:contrastsWith ngm:byzantine-fault-tolerant-system ;
    vc:enables ngm:distributed-ledger-technology,
        ngm:distributed-system-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-protocol,
        ngm:raft-consensus ;
    vc:slug "raft" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-replication,
        ngm:distributed-system .

ngm:rb-0024-workspace a owl:Class ;
    rdfs:label "rb 0024 workspace"@en ;
    rdfs:comment "The workspace of a robot manipulator is the total volume of space that the end-effector can reach, given the joint range limits of all links. The reachable workspace encompasses every point the tool-centre-point (TCP) can attain in at least one orientation, while the dexterous workspace is the subset reachable in all possible orientations. Workspace volume, shape, and dexterity distribution are primary design criteria for robot selection and cell layout, and must account for self-collisions, payload, and safety exclusion zones."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0026-robot-joint ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:manipulator-arm,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity,
        ngm:rb-0033-payload,
        ngm:rb-0037-dexterity,
        ngm:rb-0095-safety-zone ;
    vc:slug "rb-0024-workspace" ;
    vc:sourceDomain "robotics" .

ngm:rb-0039-stiffness a owl:Class ;
    rdfs:label "rb 0039 stiffness"@en ;
    rdfs:comment "Stiffness, in robotics, is the ratio of applied force (or torque) to the resulting displacement (or angular deflection) of a robot link, joint, or end-effector. High stiffness yields precise positioning at the cost of storing large elastic energy that can be hazardous in contact; low stiffness (compliance) absorbs impact and is preferred in human-robot collaboration. Variable-stiffness actuation and impedance control allow robots to modulate stiffness dynamically, trading accuracy against safety depending on task context."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0027-robot-link ;
    vc:enables ngm:force-control,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:impedance-control,
        ngm:inertia,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics ;
    vc:slug "rb-0039-stiffness" ;
    vc:sourceDomain "robotics" .

ngm:rb-0055-velocity-control a owl:Class ;
    rdfs:label "rb 0055 velocity control"@en ;
    rdfs:comment "Velocity control is a robot control strategy in which joint or Cartesian velocities are the primary commanded quantities, with a feedback controller (typically PID-based) continuously correcting deviations between desired and measured velocities. It is used for smooth trajectory following, compliant interaction with soft contacts, and speed-and-separation monitoring safety functions that require real-time speed capping. Velocity control is distinct from position control — it does not inherently resist positional drift — and from torque control, which acts at the force level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pid-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encoder ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0092-protective-stop,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:torque-control,
        ngm:velocity,
        ngm:velocity-control ;
    vc:requires ngm:encoder,
        ngm:feedback-control,
        ngm:pid-controller ;
    vc:slug "rb-0055-velocity-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0057-admittance-control a owl:Class ;
    rdfs:label "rb 0057 admittance control"@en ;
    rdfs:comment "Admittance control is an interaction-control strategy in which a robot measures contact forces and torques and converts them into corresponding desired motion (position or velocity) using a virtual mass-spring-damper model. It is the dual of impedance control: the robot senses force input and renders motion output, enabling compliant, safe physical human-robot interaction in collaborative tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-control ],
        ngm:interaction-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:rb-0041-inertia,
        ngm:rb-0053-force-control,
        ngm:rb-0056-impedance-control ;
    vc:requires ngm:force-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0057-admittance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0068-vision-system a owl:Class ;
    rdfs:label "rb 0068 vision system"@en ;
    rdfs:comment "A robotic vision system is an integrated sensor subsystem that captures and processes visual data—using cameras, depth sensors, or LiDAR—to provide a robot with spatial awareness, object recognition, and scene understanding capabilities. Vision systems underpin tasks including visual servoing, part inspection, SLAM-based localisation, and human-robot interaction, and conform to ISO 8373:2021 perception-system definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0077-depth-camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:human-robot-interaction,
        ngm:rb-0065-visual-servoing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0066-robot-sensor,
        ngm:rb-0077-depth-camera ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:perception-system,
        ngm:rb-0069-lidar ;
    vc:slug "rb-0068-vision-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:object-detection,
        ngm:point-cloud,
        ngm:slam .

ngm:rb-1013-localization a owl:Class ;
    rdfs:label "RB 1013 localization"@en ;
    rdfs:comment "RB 1013 localization is a robotics navigation concept addressing the problem of a mobile robot determining its pose within a known or partially known environment. It encompasses probabilistic state estimation techniques such as particle filters, extended Kalman filters, and scan-matching algorithms applied to sensor data from LiDAR, wheel odometry, and IMUs to produce continuous pose estimates suitable for autonomous navigation."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:localization,
        ngm:slam,
        ngm:visual-odometry ;
    vc:slug "rb-1013-localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:particle-filter .

ngm:recommendation-engine a owl:Class ;
    rdfs:label "Recommendation Engine"@en ;
    rdfs:comment "A recommendation engine is a system that filters, ranks, and surfaces content or items most relevant to an individual user by analysing preferences, behaviour history, and contextual signals. It employs collaborative filtering, content-based filtering, or hybrid deep-learning approaches to personalise discovery at scale across e-commerce, media, and metaverse platforms."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:data-pipeline,
        ngm:deep-learning ;
    vc:enables ngm:information-retrieval,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:search-technology ;
    vc:slug "recommendation-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedding-model,
        ngm:machine-learning .

ngm:recommendation-system a owl:Class ;
    rdfs:label "Recommendation System"@en ;
    rdfs:comment "A recommendation system is an information filtering infrastructure that predicts and surfaces items, content, or actions likely to be of interest to a specific user, based on behavioural history, explicit preferences, item features, or combinations thereof. It encompasses collaborative filtering approaches that exploit user-item interaction patterns, content-based methods that match item attributes to user profiles, and hybrid models that combine multiple signals. Modern recommendation systems employ deep learning, graph neural networks, and large language models to capture complex preference patterns at scale. They are commercially critical infrastructure in e-commerce, streaming media, social networks, and digital advertising."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:e-commerce,
        ngm:personalized-virtual-experiences,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:social-media,
        ngm:video-streaming ;
    vc:slug "recommendation-system" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:collaborative-filtering,
        ngm:deep-learning,
        ngm:embeddings,
        ngm:reinforcement-learning .

ngm:reference-architecture a owl:Class ;
    rdfs:label "Reference Architecture"@en ;
    rdfs:comment "A standardized architectural template that provides proven structural frameworks and design patterns for building scalable, resilient enterprise applications, establishing shared vocabulary and best practices across development teams."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:software-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:scalable-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reference-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:regulatory-standards a owl:Class ;
    rdfs:label "Regulatory Standards"@en ;
    rdfs:comment "Legal and compliance frameworks governing metaverse and extended reality platforms, including data protection (GDPR), artificial intelligence (EU AI Act), digital services (DSA), and accessibility requirements that ensure user rights protection in immersive environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:compliance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "regulatory-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:research-methods a owl:Class ;
    rdfs:label "Research Methods"@en ;
    rdfs:comment "Research Methods are the systematic procedures and techniques used to collect, analyse, and interpret data in order to generate reliable knowledge. They encompass qualitative approaches (interviews, ethnography), quantitative approaches (controlled experiments, statistical analysis), and mixed-methods designs, with evaluation benchmarks and user studies being particularly relevant to AI and spatial computing research."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:evaluation-benchmarks-and-leaderboards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-research-area,
        ngm:clinical-trials,
        ngm:data-augmentation-strategies ;
    vc:slug "research-methods" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:user-research .

ngm:risk-mitigation a owl:Class ;
    rdfs:label "Risk Mitigation"@en ;
    rdfs:comment "Actions taken to reduce the likelihood or impact of identified AI risks through technical, organizational, or procedural controls, implemented throughout the AI lifecycle to achieve acceptable risk levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:compliance-framework,
        ngm:robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-principle,
        ngm:bias-mitigation-techniques ;
    vc:requires ngm:ai-safety,
        ngm:risk-management ;
    vc:slug "risk-mitigation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:robot-component a owl:Class ;
    rdfs:label "Robot Component"@en ;
    rdfs:comment "A Robot Component is any modular element forming part of a robotic system, encompassing hardware modules (motors, sensors, links, joints), electrical components (power supplies, motor drivers, embedded computers), software components (perception modules, planners, controllers), and interface components (communication protocols, connectors, mounting systems). Standardised component interfaces—ISO 9409 tool flanges, EtherCAT, ROS 2—enable plug-and-play integration, reducing development time and supporting modular system design, component reuse, and hierarchical decomposition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:sensor-fusion ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "robot-component" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-system .

ngm:robotics-domain a owl:Class ;
    rdfs:label "Robotics Domain"@en ;
    rdfs:comment "The Robotics Domain is a top-level knowledge domain encompassing the design, construction, operation, and governance of intelligent machines. It provides a formal ontological framework — anchored in standards such as IEEE 1872 (CORA) — for representing robot architectures, sensor systems, actuators, motion planning, perception, and human-robot interaction, enabling unambiguous knowledge transfer among humans, robots, and AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
