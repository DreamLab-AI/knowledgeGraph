        ngm:schema-validator,
        ngm:vocabulary-services ;
    vc:slug "semantic-metadata-registry" ;
    vc:sourceDomain "infrastructure" .

ngm:shape-memory-alloy-actuator a owl:Class ;
    rdfs:label "Shape Memory Alloy Actuator"@en ;
    rdfs:comment "A shape memory alloy (SMA) actuator exploits the thermoelastic phase transformation of nickel-titanium (Nitinol) or similar alloys, which contract and generate force when thermally activated, then return to their original shape on cooling. SMA actuators are valued for their high force-to-weight ratio, silent operation, and inherent compliance, making them well-suited to soft robotics, minimally invasive surgical tools, and wearable exoskeletons. Control bandwidth is limited by thermal cycle times, which remains a key engineering challenge."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:exoskeleton-robot,
        ngm:haptic-feedback,
        ngm:surgical-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:soft-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:hydraulic-actuator,
        ngm:manipulation,
        ngm:pneumatic-actuator,
        ngm:robot-actuator ;
    vc:slug "shape-memory-alloy-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:tactile-sensor .

ngm:should a owl:Class ;
    rdfs:label "SHOULD"@en ;
    rdfs:comment "SHOULD is an RFC 2119 normative keyword indicating that a particular behaviour or implementation choice is strongly recommended but not absolutely required. In specification and standards documents, SHOULD implies that valid reasons may exist in particular circumstances to deviate from the stated guidance, but the implementer must understand the implications and weigh the trade-offs carefully before choosing a different course. It contrasts with MUST (mandatory) and MAY (optional)."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:standards-conformance-testing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:standards-conformance ;
    vc:slug "should" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compliance-standards .

ngm:smart-royalties-ledger a owl:Class ;
    rdfs:label "Smart Royalties Ledger"@en ;
    rdfs:comment "An automated tracking and distribution system that records creator royalty obligations, calculates payment amounts, and executes compensation transfers for digital content and NFT sales in virtual economy environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
