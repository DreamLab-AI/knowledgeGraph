    vc:isPartOf ngm:ai-alignment ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-safety-evaluation ;
    vc:requires ngm:chain-of-thought-reasoning,
        ngm:large-language-models,
        ngm:reinforcement-learning ;
    vc:slug "constitutional-ai-training-methodology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-ethics,
