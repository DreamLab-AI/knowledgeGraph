    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-delivery-network,
        ngm:data-centre,
        ngm:distributed-systems,
        ngm:edge-computing,
        ngm:internet-exchange-point ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-security ;
    vc:requires ngm:domain-name-system,
        ngm:network-protocol ;
    vc:slug "internet-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:internet-engineering-task-force ;
    vc:supports ngm:internet-of-things,
        ngm:spatial-computing ;
    vc:uses ngm:cloud-infrastructure,
