ngm:real-time-rendering a owl:Class ;
    rdfs:label "Real-Time Rendering"@en ;
    rdfs:comment "Real-time rendering is the sub-field of computer graphics focused on producing and analyzing images at interactive frame rates, typically using a graphics processing unit (GPU) to transform 3D scene data into 2D display output within milliseconds. The graphics pipeline processes geometry, applies textures and lighting, and rasterizes the final image fast enough to support interactive applications such as video games, simulations, and virtual reality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:occlusion-culling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        ngm:three-dimensional-graphics ;
    vc:bridgesTo ngm:edge-computing,
        ngm:machine-learning-inference ;
    vc:contrastsWith ngm:offline-rendering ;
    vc:dependsOn ngm:parallel-computing,
        ngm:spatial-data-structures ;
    vc:enables ngm:augmented-reality,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:interactive-visualization,
        ngm:video-games,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:graphics-pipeline,
        ngm:level-of-detail,
        ngm:occlusion-culling,
        ngm:rasterization,
        ngm:texture-mapping ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:physically-based-rendering ;
    vc:requires ngm:graphics-api,
        ngm:graphics-processing-unit,
        ngm:shader-program ;
    vc:slug "real-time-rendering" ;
    vc:sourceDomain "spatial-computing" ;
