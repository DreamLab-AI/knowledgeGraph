        ngm:drake-toolbox,
        ngm:hpipm,
        ngm:mu-jo-co,
        ngm:osqp-solver,
        ngm:pinocchio .

ngm:model-capacity a owl:Class ;
    rdfs:label "Model Capacity"@en ;
    rdfs:comment "The measure of a machine learning model's ability to represent a wide variety of functions, determined by parameter count, architecture depth and width, and representational power. Models with insufficient capacity underfit the data; those with excessive capacity risk overfitting. Capacity is formally bounded by concepts such as the Vapnik–Chervonenkis dimension, and is managed in practice through regularisation, pruning, and architecture search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:overfitting,
        ngm:regularisation,
        ngm:underfitting ;
    vc:requires ngm:neural-network,
        ngm:training-data ;
    vc:slug "model-capacity" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:model-inversion a owl:Class ;
    rdfs:label "Model Inversion"@en ;
    rdfs:comment "An inference-time privacy attack that reconstructs sensitive training data or personal attributes from a trained model by iteratively querying model outputs, confidence scores, or internal representations. Model inversion attacks expose a fundamental tension between model utility and data privacy, motivating defences such as differential privacy, federated learning, and membership-inference auditing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-weights ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:differential-privacy,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attacks,
        ngm:membership-inference ;
    vc:requires ngm:model-weights ;
    vc:slug "model-inversion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety .

ngm:multimodal a owl:Class ;
    rdfs:label "multimodal"@en ;
    rdfs:comment "Multimodal AI refers to artificial intelligence systems that process, fuse, and generate content across multiple data modalities—including text, images, audio, video, and 3D—within a unified model architecture. Multimodal systems learn cross-modal alignments through joint embedding spaces, enabling capabilities such as image captioning, visual question answering, text-to-image synthesis, and real-time audio-visual understanding that single-modality models cannot achieve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:ai-research-area,
        ngm:multimodal-ai ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:image-generation,
        ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:speech-recognition ;
    vc:requires ngm:computer-vision,
        ngm:large-language-models ;
    vc:slug "multimodal" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:multimodal-understanding a owl:Class ;
    rdfs:label "Multimodal Understanding"@en ;
    rdfs:comment "Multimodal Understanding is an AI research area concerned with systems that jointly process and reason over multiple sensory modalities — including text, images, audio, video, and structured data — producing unified semantic representations. It underpins vision-language models, audio-visual reasoning, and multi-sensor scene interpretation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-and-voice ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:natural-language-understanding,
        ngm:scene-understanding,
        ngm:speech-and-voice ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-technique,
        ngm:generative-ai,
        ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:slug "multimodal-understanding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:multimodal-ai,
        ngm:transformer .

ngm:nakamoto-coefficient a owl:Class ;
    rdfs:label "Nakamoto Coefficient"@en ;
    rdfs:comment "The Nakamoto Coefficient is a quantitative metric for blockchain decentralisation, defined as the minimum number of independent entities in a given subsystem (such as mining pool concentration, validator set, or client software diversity) whose collusion or failure would be sufficient to compromise network security, liveness, or integrity. A higher Nakamoto Coefficient indicates a more resilient, decentralised network; a coefficient of one denotes a single point of failure. The metric is applicable across multiple dimensions of a network simultaneously, yielding a multi-dimensional decentralisation profile rather than a single scalar."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-governance,
        ngm:sybil-resistance ;
    vc:slug "nakamoto-coefficient" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake,
        ngm:validator-set .

ngm:natural-interaction a owl:Class ;
    rdfs:label "Natural Interaction"@en ;
    rdfs:comment "Natural Interaction describes human-computer interaction modalities that leverage innate human capabilities—speech, gesture, gaze, touch, and whole-body movement—rather than requiring users to learn abstract symbolic interfaces such as keyboards or command-line syntax. The goal is to reduce cognitive translation costs and make technology accessible to a broader range of users by aligning the interaction channel with the way humans naturally communicate and manipulate objects in the physical world. Natural interaction is foundational to spatial computing, mixed reality, and embodied AI systems where traditional 2D pointing devices are ergonomically or practically unsuitable."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:embodied-ai,
        ngm:spatial-computing,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:gesture-recognition,
        ngm:haptic-feedback,
        ngm:speech-recognition ;
    vc:slug "natural-interaction" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:conversational-ai,
        ngm:hand-tracking,
        ngm:multimodal-ai .

ngm:network-hash-rate a owl:Class ;
    rdfs:label "Network Hash Rate"@en ;
    rdfs:comment "The aggregate computational power (measured in hashes per second) expended by all miners participating in a proof-of-work blockchain at a given time. A higher network hash rate increases attack cost for a 51% attack and triggers upward difficulty adjustments to maintain target block times; conversely, drops in hash rate trigger downward adjustments."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:nakamoto-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:block-reward,
        ngm:difficulty-adjustment,
        ngm:mining-pool,
        ngm:proof-of-work,
        ngm:selfish-mining ;
    vc:slug "network-hash-rate" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:mining .

ngm:network-quality-metric a owl:Class ;
    rdfs:label "Network Quality Metric"@en ;
    rdfs:comment "A quantitative measure used to characterise the performance and reliability of a network connection for real-time interactive applications, encompassing parameters such as latency (round-trip time), jitter, packet loss rate, available bandwidth, and connection stability. These metrics directly determine the feasibility of synchronised multi-user experiences in spatial computing environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking-technology ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:latency ;
    vc:requires ngm:networking-technology ;
    vc:slug "network-quality-metric" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:multi-user-systems,
        ngm:real-time .

ngm:neural-architecture-search a owl:Class ;
    rdfs:label "Neural Architecture Search"@en ;
    rdfs:comment "Neural Architecture Search (NAS) is an automated machine learning technique that searches a defined space of neural network designs to discover architectures that maximise predictive performance or satisfy multi-objective constraints such as latency, parameter count, and energy consumption. NAS algorithms explore the architecture search space using strategies that include reinforcement learning, evolutionary algorithms, differentiable relaxations (DARTS), and predictor-based approaches, each making different trade-offs between search cost and solution quality. The field emerged from the observation that hand-designed architectures require substantial expert knowledge and iterative experimentation, and that automated search can discover non-obvious configurations that outperform human-designed baselines on targeted hardware or task distributions."@en ;
    rdfs:subClassOf ngm:auto-ml ;
    vc:enables ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning-pipeline,
        ngm:neural-network-architecture ;
    vc:slug "neural-architecture-search" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:differentiable-architecture,
        ngm:hyperparameter-tuning,
        ngm:machine-learning-framework .

ngm:nostr-relay a owl:Class ;
    rdfs:label "Nostr Relay"@en ;
    rdfs:comment "A Nostr Relay is a server that implements the Nostr protocol, accepting signed event objects from clients, storing them, and forwarding them to subscribed clients according to filter criteria. Relays are the infrastructure backbone of the Nostr decentralised social network: because there is no central server or consensus chain, the network's availability and censorship-resistance derive entirely from the federated mesh of independently operated relays. Relays communicate with clients over persistent WebSocket connections using a simple JSON message format."@en ;
    rdfs:subClassOf ngm:nostr-protocol ;
    vc:enables ngm:decentralized-identity,
        ngm:did-nostr-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:federated-identity,
        ngm:nostr,
        ngm:relayer ;
    vc:slug "nostr-relay" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:public-key-cryptography,
        ngm:web-socket-protocol .

ngm:notary-service a owl:Class ;
    rdfs:label "Notary Service"@en ;
    rdfs:comment "A notary service is a trusted third-party function that attests to the authenticity, integrity, and existence of a document or digital artefact at a specific point in time, producing a tamper-evident record legally admissible as proof. In digital contexts, notary services hash document content and anchor that hash to a verifiable ledger — blockchain or traditional timestamping authority — binding the evidence to a precise timestamp without revealing the document contents. They bridge traditional legal document authentication with cryptographic proof mechanisms, enabling use cases ranging from intellectual property protection to supply chain provenance. Blockchain-anchored notary services eliminate single-point-of-failure trust assumptions present in classical certificate-authority-based approaches."@en ;
    rdfs:subClassOf ngm:security-services ;
    vc:enables ngm:credential-verification,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-verification,
        ngm:formal-verification,
        ngm:virtual-notary-service ;
    vc:slug "notary-service" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-certificate,
        ngm:digital-signature-verification .

ngm:objective a owl:Class ;
    rdfs:label "Objective"@en ;
    rdfs:comment "A formal specification of the goal or criterion that an AI system, optimisation algorithm, or training procedure is designed to satisfy or maximise. In machine learning this is typically expressed as a loss function or reward signal that guides parameter updates; in planning and reinforcement learning it encodes desired agent behaviour through utility or reward functions."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-optimisation-and-performance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:loss-function,
        ngm:model-training,
        ngm:optimiser,
        ngm:reward-function ;
    vc:slug "objective" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:optimization-algorithm,
        ngm:training-data .

ngm:open-source-development a owl:Class ;
    rdfs:label "Open Source Development"@en ;
    rdfs:comment "Open source development is a software production methodology in which source code is made publicly available under licences permitting inspection, modification, and redistribution, enabling distributed communities of contributors to collaboratively build and maintain software. The model contrasts with proprietary development by prioritising transparency, peer review, and meritocratic contribution over closed, hierarchical ownership. It encompasses practices including version-controlled public repositories, issue tracking, pull-request-based code review, and community governance structures. Open source development has become the dominant paradigm for infrastructure software, AI frameworks, and blockchain protocols."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:collaboration-platform,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:open-source-framework,
        ngm:open-source-software,
        ngm:version-control ;
    vc:slug "open-source-development" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-augmented-software-engineering,
        ngm:community-governance ;
    vc:uses ngm:software-development-process .

ngm:panoptic-segmentation a owl:Class ;
    rdfs:label "Panoptic Segmentation"@en ;
    rdfs:comment "A computer vision task that unifies semantic segmentation and instance segmentation by assigning every image pixel both a class label and an instance identifier, providing holistic scene parsing that distinguishes countable foreground objects (\"things\") from amorphous background regions (\"stuff\"). Architectures such as Panoptic FPN, Panoptic-DeepLab, and MaskFormer formalise this unified representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:instance-segmentation,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task ;
    vc:requires ngm:object-detection ;
    vc:slug "panoptic-segmentation" ;
    vc:sourceDomain "spatial-computing" .

ngm:payment-network a owl:Class ;
    rdfs:label "Payment Network"@en ;
    rdfs:comment "A payment network is an infrastructure system composed of interconnected nodes, protocols, and settlement mechanisms that enables the transfer of value between participants — individuals, merchants, institutions, or autonomous agents — with guarantees on finality, atomicity, and fraud prevention. Payment networks range from traditional card networks (Visa, Mastercard) and interbank clearing systems (SWIFT, ACH, SEPA) to cryptographic peer-to-peer blockchain networks and second-layer channel networks such as the Lightning Network. They underpin commerce, financial inclusion, and increasingly machine-to-machine value exchange in automated economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        ngm:financial-infrastructure ;
    vc:enables ngm:cross-border-payments,
        ngm:machine-to-machine-payments,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:payment-gateway,
        ngm:payment-system,
        ngm:state-channel ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:layer-2-scaling,
        ngm:lightning-network ;
    vc:slug "payment-network" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-protocol,
        ngm:digital-payment-system .

ngm:persistent-memory a owl:Class ;
    rdfs:label "Persistent Memory"@en ;
    rdfs:comment "Persistent Memory (PMEM) is a class of byte-addressable, non-volatile storage technology that occupies the memory bus and exposes its capacity directly to processor load/store instructions, combining the persistence of storage media with latency approaching that of DRAM. It sits in a new tier of the memory hierarchy between volatile DRAM and block-accessed SSDs, enabling applications to retain state across power cycles without the overhead of traditional I/O system calls."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:enables ngm:machine-learning-infrastructure,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:data-persistence,
        ngm:data-storage,
        ngm:hardware-acceleration ;
    vc:slug "persistent-memory" ;
    vc:sourceDomain "hardware" ;
    vc:supports ngm:inference-engine,
        ngm:vector-database .

ngm:personalized-virtual-experiences a owl:Class ;
    rdfs:label "Personalized Virtual Experiences"@en ;
    rdfs:comment "AI-driven customization of virtual environments, content, and interactions based on individual user preferences, behaviors, and interests, enabling tailored journeys through metaverse spaces with adaptive storytelling, avatars, and content recommendations."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-experience ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "personalized-virtual-experiences" ;
    vc:sourceDomain "spatial-computing" .

ngm:player-two a owl:Class ;
    rdfs:label "Player Two"@en ;
    rdfs:comment "Player Two is a decentralised AI-character and collaborative storytelling platform combining Nostr-relay messaging, BIP85 key derivation, and generative AI workflows. It enables trustless group interactions with AI-driven waifu characters, token-gated access, and a robot project with on-device edge compute for the ED3N distributed network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:player-two-code ],
        ngm:collaboration-platform,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:cryptography,
        ngm:decentralised-identity ;
    vc:enables ngm:identity-management,
        ngm:player-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:player-two-code ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "player-two" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:ai-video,
        ngm:generative-ai .

ngm:policy-decision-point a owl:Class ;
    rdfs:label "Policy Decision Point"@en ;
    rdfs:comment "A Policy Decision Point (PDP) is the logical component in an attribute-based or policy-based access control architecture that evaluates access requests against a set of authorisation policies and returns a permit, deny, or indeterminate decision. The PDP receives a request context—including subject attributes, resource attributes, action, and environment conditions—from a Policy Enforcement Point (PEP), retrieves applicable policies from a Policy Information Point (PIP) or Policy Administration Point (PAP), and applies the XACML combining algorithms or equivalent logic to reach a binding decision. PDPs are the computational core of fine-grained, dynamic authorisation systems used in zero-trust security architectures, identity federation, API gateways, and cloud IAM platforms."@en ;
    rdfs:subClassOf ngm:access-control-system ;
    vc:dependsOn ngm:authentication,
        ngm:cryptographic-verification ;
    vc:enables ngm:policy-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:policy-enforcement,
        ngm:policy-enforcement-point,
        ngm:policy-engine ;
    vc:slug "policy-decision-point" ;
    vc:sourceDomain "security" .

ngm:policy-framework a owl:Class ;
    rdfs:label "Policy Framework"@en ;
    rdfs:comment "A policy framework is a structured set of principles, rules, standards, and processes established by a government body, standards organisation, or institution to guide decision-making, regulate behaviour, and ensure accountability within a defined domain. It translates high-level objectives — such as safety, fairness, or interoperability — into operational requirements and compliance mechanisms. Policy frameworks provide the normative scaffolding that enables coordinated action across organisations and jurisdictions."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:ai-accountability,
        ngm:regulatory-compliance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:eu-ai-act,
        ngm:nist-ai-rmf ;
    vc:slug "policy-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-standards,
        ngm:nist .

ngm:polkadot a owl:Class ;
    rdfs:label "Polkadot"@en ;
    rdfs:comment "Polkadot is a heterogeneous multi-chain blockchain protocol designed by Gavin Wood and developed by Parity Technologies that enables independent blockchains — called parachains — to connect to a central relay chain, share its pooled security, and exchange messages and assets through the Cross-Consensus Message format. Its nominated proof-of-stake consensus mechanism uses DOT token validators to secure the relay chain whilst parachains benefit from shared security without needing to bootstrap their own validator sets. Polkadot is built on the Substrate framework, which allows developers to construct purpose-built application chains that plug into the ecosystem."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:contrastsWith ngm:cosmos-ibc ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:nominated-proof-of-stake,
        ngm:polkadot-parachains ;
    vc:slug "polkadot" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:validator-set,
        ngm:web-assembly .

ngm:practical-byzantine-fault-tolerance a owl:Class ;
    rdfs:label "Practical Byzantine Fault Tolerance"@en ;
    rdfs:comment "A consensus algorithm providing high-performance Byzantine state machine replication for asynchronous distributed systems, tolerating up to f faulty nodes in a system of 3f+1 total nodes. PBFT achieves deterministic finality through a three-phase protocol (pre-prepare, prepare, commit) and processes thousands of requests per second with sub-millisecond latency overhead, making it suitable for permissioned blockchain networks requiring strong consistency guarantees."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:nakamoto-consensus,
        ngm:proof-of-stake ;
    vc:enables ngm:blockchain-governance,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:deterministic-finality,
        ngm:federated-byzantine-fault-tolerance,
        ngm:hot-stuff-consensus ;
    vc:slug "practical-byzantine-fault-tolerance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:trusted-execution-pbft,
        ngm:validator-node .

ngm:privacy-preserving-authentication a owl:Class ;
    rdfs:label "Privacy-Preserving Authentication"@en ;
    rdfs:comment "Privacy-preserving authentication encompasses cryptographic mechanisms that allow a party to prove identity, membership, or credential possession to a verifier without revealing the underlying identity attributes, credential content, or linkage information across sessions. Core techniques include zero-knowledge proofs, anonymous credentials (e.g., U-Prove, BBS+), blind signatures, and selective disclosure, enabling authentication that is both unforgeable and unlinkable. The goal is to satisfy verifier assurance requirements while minimising the personal data exposed in each authentication event."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:decentralised-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:privacy-preserving-identity,
        ngm:selective-disclosure,
        ngm:zero-knowledge-proof ;
    vc:slug "privacy-preserving-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy-by-design ;
    vc:uses ngm:cryptographic-proof,
        ngm:zero-knowledge-proof-zkp .

ngm:privacy-preserving-identity a owl:Class ;
    rdfs:label "Privacy-Preserving Identity"@en ;
    rdfs:comment "Privacy-preserving identity refers to identity management architectures and protocols that enable individuals to prove attributes, credentials, or facts about themselves to verifiers without revealing unnecessary personal information, leveraging cryptographic techniques such as zero-knowledge proofs, selective disclosure, and unlinkable credentials. These systems aim to reconcile strong authentication guarantees with user privacy, countering surveillance by reducing the attack surface of identity data aggregation. They are foundational to self-sovereign identity, anonymous credential schemes, and privacy-respecting compliance workflows."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:enables ngm:identity-verification,
        ngm:privacy-preserving-authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-commitment,
        ngm:decentralized-identity,
        ngm:digital-identity-wallet,
        ngm:w3-c-verifiable-credentials ;
    vc:slug "privacy-preserving-identity" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:decentralized-identifiers,
        ngm:selective-disclosure,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof .

ngm:privacy-protection a owl:Class ;
    rdfs:label "Privacy Protection"@en ;
    rdfs:comment "Privacy Protection encompasses the legal frameworks, technical mechanisms, and organisational practices deployed to safeguard individuals' rights to control the collection, use, storage, and disclosure of their personal data. It spans regulatory instruments such as the GDPR, sector-specific legislation, and constitutional provisions, alongside technical controls including data minimisation, pseudonymisation, encryption, access control, and privacy-enhancing computation. Effective privacy protection requires privacy-by-design principles to be embedded in system architecture from inception rather than retrofitted. It is a foundational requirement for trust in digital services, particularly where sensitive personal, biometric, or health data are processed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr ],
        ngm:data-protection ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection-regulation,
        ngm:gdpr-compliance ;
    vc:requires ngm:consent-management,
        ngm:gdpr ;
    vc:slug "privacy-protection" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:data-minimisation,
        ngm:privacy-enhancing-technologies,
        ngm:zero-knowledge-proof .

ngm:proof-of-history a owl:Class ;
    rdfs:label "Proof of History"@en ;
    rdfs:comment "Proof of History is a cryptographic clock mechanism that timestamps transactions using a sequential, verifiable delay function (SHA-256 hash chain), establishing a tamper-evident historical record. This allows Solana validators to process transactions in parallel without requiring round-trip consensus on ordering, dramatically increasing throughput."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-based-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-network,
        ngm:deterministic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:proof-based-consensus ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:proof-of-stake,
        ngm:transaction-finality,
        ngm:validator-node ;
    vc:slug "proof-of-history" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction .

ngm:proximity-sensor a owl:Class ;
    rdfs:label "Proximity Sensor"@en ;
    rdfs:comment "An electronic device that detects the presence or distance of nearby objects without physical contact, using capacitive, inductive, ultrasonic, optical, or magnetic principles. Proximity sensors are foundational to robotic collision avoidance, autonomous navigation, and spatial mapping in both physical and hybrid physical-digital environments."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:autonomous-navigation,
        ngm:robot-safety,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-sensor,
        ngm:robotic-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:lidar,
        ngm:sensor-fusion ;
    vc:slug "proximity-sensor" ;
    vc:sourceDomain "robotics" .

ngm:query-interface a owl:Class ;
    rdfs:label "Query Interface"@en ;
    rdfs:comment "A query interface is a defined boundary — programmatic, visual, or linguistic — through which users or systems express requests for data retrieval, graph traversal, or knowledge discovery against a data store or knowledge base, receiving structured results in return. Query interfaces range from formal declarative languages such as SQL and SPARQL to REST endpoints, vector similarity APIs, and natural-language question-answering systems built on large language models. They abstract the internal organisation of a data source behind a stable contract, enabling diverse clients to access data without knowledge of storage implementation details. Well-designed query interfaces balance expressiveness, performance, and ease of use."@en ;
    rdfs:subClassOf ngm:data-access-interface ;
    vc:enables ngm:enterprise-search,
        ngm:knowledge-graph,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:nearest-neighbor-search,
        ngm:vector-database ;
    vc:slug "query-interface" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:database-query,
        ngm:information-retrieval,
        ngm:sparql .

ngm:rb-0007-collaborative-robot a owl:Class ;
    rdfs:label "rb 0007 collaborative robot"@en ;
    rdfs:comment "A collaborative robot (cobot) is an industrial robot designed and certified to work in direct physical proximity with human operators within a shared workspace, without requiring conventional hard safety guarding. Defined under ISO/TS 15066, cobots implement one or more of four collaborative operation modes — safety-rated monitored stop, hand guiding, speed-and-separation monitoring, and power-and-force limiting — each constraining robot behaviour so that human contact does not result in injury. Cobots typically feature lightweight, rounded structures, intrinsic force/torque sensing, and redundant safety-rated control architectures compliant with ISO 10218-1/-2."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:industrial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:rb-0093-speed-limitation,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0103-collaborative-operation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0056-impedance-control,
        ngm:rb-0105-speed-and-separation-monitoring,
        ngm:robo-human-robot-interaction ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0007-collaborative-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066,
        ngm:rb-0087-safety-standard .

ngm:rb-0034-repeatability a owl:Class ;
    rdfs:label "rb 0034 repeatability"@en ;
    rdfs:comment "Repeatability is a key performance metric of robot manipulators that quantifies the closeness of agreement between successive commanded returns to the same target position or pose, measured under identical conditions. It is formally defined in ISO 9283 as the radius of a sphere enclosing a specified percentage of attained positions from repeated attempts. Repeatability is distinct from accuracy — a robot may be highly repeatable but systematically offset from the commanded target — and is critical for applications such as assembly, welding, and precision manufacturing."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0047-feedback-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0036-resolution ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:calibration,
        ngm:performance-metrics,
        ngm:precision ;
    vc:slug "rb-0034-repeatability" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .

ngm:rb-0035-accuracy a owl:Class ;
    rdfs:label "rb 0035 accuracy"@en ;
    rdfs:comment "Robot accuracy is the closeness of agreement between a robot's commanded pose and its actual achieved pose, measured as the mean positional or orientational error across multiple repeated commanded positions. Defined in ISO 9283, it encompasses pose accuracy, path accuracy, and static compliance accuracy, and is distinct from repeatability, which measures the spread of repeated attempts at the same pose rather than deviation from the commanded value."@en ;
    rdfs:subClassOf ngm:accuracy,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0034-repeatability,
        ngm:rb-0036-resolution ;
    vc:dependsOn ngm:rb-0048-pid-controller ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:calibration,
        ngm:precision,
        ngm:rb-0021-robot-kinematics,
        ngm:rb-0029-inverse-kinematics ;
    vc:slug "rb-0035-accuracy" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .

ngm:rb-0062-model-predictive-control a owl:Class ;
    rdfs:label "rb 0062 model predictive control"@en ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced optimal control strategy that uses an explicit mathematical model of the plant to predict future system behaviour over a finite receding horizon, then solves an optimisation problem at each control step to determine the input sequence that minimises a cost function subject to state and input constraints. Only the first element of the computed sequence is applied before the optimisation is repeated. In robotics, MPC enables constraint-aware trajectory tracking, force regulation, and whole-body motion planning that classical PID controllers cannot achieve."@en ;
    rdfs:subClassOf ngm:optimal-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0048-pid-controller,
        ngm:rb-0063-sliding-mode-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0056-impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0060-optimal-control,
        ngm:rb-0061-nonlinear-control,
        ngm:state-space-control ;
    vc:slug "rb-0062-model-predictive-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0088-iso-13482-compliance a owl:Class ;
    rdfs:label "rb 0088 iso 13482 compliance"@en ;
    rdfs:comment "ISO 13482 compliance refers to conformance with ISO 13482:2014, the international safety standard for personal care robots that interact with humans in non-industrial settings. Achieving compliance requires demonstrating that hazards have been identified, risks reduced to acceptable levels via protective measures, and that the robot meets defined performance and safety integrity criteria throughout its operational life."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0100-safety-integrity-level ],
        ngm:functional-safety,
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:contrastsWith ngm:iso-10218 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0087-safety-standard,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0096-safeguarding,
        ngm:service-robot ;
    vc:requires ngm:rb-0089-risk-assessment,
        ngm:rb-0100-safety-integrity-level ;
    vc:slug "rb-0088-iso-13482-compliance" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508 .

ngm:rb-0100-safety-integrity-level a owl:Class ;
    rdfs:label "rb 0100 safety integrity level"@en ;
    rdfs:comment "Safety Integrity Level (SIL) is a discrete measure of the reliability required for a safety function in a robotic or automated system, defined by IEC 61508 on a four-level scale (SIL 1–4). A higher SIL demands greater hardware fault tolerance, stricter software development processes, and more comprehensive validation to ensure the safety function reduces risk to a tolerable level. SIL is assigned during risk assessment and drives the entire safety lifecycle of a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:cobot-safety-levels,
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0090-emergency-stop,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0100-safety-integrity-level" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:functional-safety,
        ngm:iec-61508 ;
    vc:supports ngm:rb-0092-protective-stop .

ngm:real-time-synchronization a owl:Class ;
    rdfs:label "Real-time Synchronization"@en ;
    rdfs:comment "Real-time synchronization is the class of distributed systems techniques that maintain consistent, up-to-date shared state across multiple nodes or clients within latency bounds tight enough to support interactive or time-critical applications. Unlike eventual consistency systems that tolerate temporary divergence, real-time synchronization protocols propagate and reconcile state changes fast enough that all participants perceive a coherent shared reality, typically within milliseconds. It underpins collaborative editing, multiplayer simulation, digital twin mirroring, and live sensor data aggregation."@en ;
    rdfs:subClassOf ngm:distributed-system ;
    vc:enables ngm:digital-twin,
        ngm:multi-user-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:network-synchronization,
        ngm:real-time-digital-twin-synchronization,
        ngm:state-synchronization ;
    vc:slug "real-time-synchronization" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:web-socket-protocol .

ngm:reranker a owl:Class ;
    rdfs:label "Reranker"@en ;
    rdfs:comment "A reranker is a second-stage scoring model in information retrieval and retrieval-augmented generation pipelines that reorders a set of candidate documents or passages — initially retrieved by a fast first-stage retriever such as a dense vector index — using a more computationally intensive cross-encoder or LLM-based relevance model that jointly encodes the query and each candidate together, producing a higher-precision relevance score than bi-encoder similarity alone. Rerankers trade retrieval speed for ranking quality, operating on a reduced candidate set (typically 50-200 passages) rather than the full corpus, thereby making deep transformer inference tractable at query time."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:language-model,
        ngm:machine-learning-technique ;
    vc:slug "reranker" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding-model,
        ngm:large-language-models,
        ngm:natural-language-processing .

ngm:revocation-registry a owl:Class ;
    rdfs:label "Revocation Registry"@en ;
    rdfs:comment "A revocation registry is a data structure or service that maintains the validity status of issued verifiable credentials or digital certificates, allowing verifiers to check whether a credential has been revoked by its issuer before accepting a presentation. In traditional PKI systems this role is fulfilled by Certificate Revocation Lists (CRLs) and OCSP responders; in self-sovereign identity ecosystems, revocation registries are implemented as privacy-preserving mechanisms including W3C Status List 2021 (bitstring-based), Hyperledger AnonCreds revocation with cryptographic accumulators, and on-chain smart contract registries. A well-designed revocation registry balances timely status updates, verifier privacy (preventing issuers from tracking when credentials are checked), and scalability to large credential populations."@en ;
    rdfs:subClassOf ngm:credential-verification ;
    vc:enables ngm:credential-issuance,
        ngm:decentralized-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:digital-certificate,
        ngm:verifiable-credential-standard,
        ngm:verifiable-credentials ;
    vc:slug "revocation-registry" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-proof,
        ngm:selective-disclosure .

ngm:robot-manipulation a owl:Class ;
    rdfs:label "Robot Manipulation"@en ;
    rdfs:comment "Robot manipulation is the sub-field of robotics concerned with the planning and execution of purposeful physical interactions between robotic systems and objects in the world, encompassing grasping, assembly, in-hand manipulation, and tool use. It integrates kinematics, dynamics, perception, and planning to move objects from one configuration to another, adapting to uncertainty in object shape, pose, surface properties, and environmental dynamics. Robust manipulation remains one of the hardest open problems in robotics due to the combinatorial complexity of contact mechanics."@en ;
    rdfs:subClassOf ngm:manipulation ;
    vc:enables ngm:human-robot-interaction,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:industrial-manipulation,
        ngm:object-manipulation,
        ngm:teleoperation ;
    vc:slug "robot-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:sensor-fusion .

ngm:robot-standard a owl:Class ;
    rdfs:label "Robot Standard"@en ;
    rdfs:comment "RobotStandard is a normative technical instrument — a specification, guideline, or regulation — issued by a recognised standards development organisation (SDO) or regulatory body to define mandatory or voluntary safety requirements, performance criteria, interoperability protocols, and terminolog..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-13482 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-ts-15066 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-10218 ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:autonomous-mobile-robot-safety,
        ngm:ce-marking,
        ngm:cobot-deployment,
        ngm:digital-product-passport,
        ngm:iio-t-integration,
        ngm:market-access,
        ngm:robot-interoperability,
        ngm:robot-skill-transfer,
        ngm:safe-human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conformity-assessment,
        ngm:ieee-1872,
        ngm:iso-10218,
        ngm:iso-13482,
        ngm:iso-3691-4,
        ngm:iso-ts-15066,
        ngm:normative-annex,
        ngm:opc-ua-robotics,
        ngm:performance-criterion,
        ngm:risk-assessment,
        ngm:safety-function,
        ngm:test-method ;
    vc:implements ngm:ehsr-framework,
        ngm:eu-machinery-regulation,
        ngm:force-control,
        ngm:industrial-safety,
        ngm:iso-tc-299,
        ngm:normative-framework,
        ngm:opc-ua-node-set,
        ngm:owl-ontology,
        ngm:performance-level-method,
        ngm:product-regulation,
        ngm:safety-integrity-level,
        ngm:speed-and-separation-monitoring ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:eu-ai-act,
        ngm:iec-61508,
        ngm:iec-62443,
        ngm:iec-80601-2-78,
        ngm:iso-12100,
        ngm:iso-13849,
        ngm:iso-13855,
        ngm:iso-8373,
        ngm:iso-9283,
        ngm:iso-sae-21434,
        ngm:niosh-guidelines,
        ngm:ros-industrial ;
    vc:requires ngm:ce-marking,
        ngm:conformity-assessment-body,
        ngm:declaration-of-conformity,
        ngm:harmonised-standard,
        ngm:protective-measure,
        ngm:risk-assessment,
        ngm:safety-function,
        ngm:technical-documentation ;
    vc:slug "robot-standard" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ansi,
        ngm:bsi,
        ngm:din,
        ngm:european-commission,
        ngm:ieee-robotics-and-automation-society,
        ngm:iso-tc-299,
        ngm:opc-foundation,
        ngm:ria ;
    vc:supports ngm:autonomous-mobile-robots,
        ngm:collaborative-robot,
        ngm:driverless-industrial-trucks,
        ngm:exoskeletons,
        ngm:industrial-robot,
        ngm:modular-robots,
        ngm:personal-care-robots,
        ngm:surgical-robot,
        ngm:swarm-robotics ;
    vc:uses ngm:force-torque-sensing,
        ngm:laser-scanner,
        ngm:ontology-engineering,
        ngm:opc-ua,
        ngm:owl-2-dl,
        ngm:performance-level,
        ngm:risk-graph-method,
        ngm:safety-integrity-level,
        ngm:slam-navigation,
        ngm:time-sensitive-networking .

ngm:robotic-control a owl:Class ;
    rdfs:label "Robotic Control"@en ;
    rdfs:comment "Robotic control is the discipline of designing algorithms and hardware that regulate the motion, force, and behaviour of robotic systems to achieve desired trajectories or task objectives in the presence of dynamic uncertainty, environmental disturbances, and physical constraints. It spans classical feedback control strategies such as PID, computed-torque, and impedance control, through to model-predictive and learning-based controllers that adapt online. Robotic control integrates kinematics, dynamics, estimation, and optimisation to translate high-level task plans into actuator commands. It is a foundational competency enabling manipulation, locomotion, and human-robot interaction across industrial and service robot applications."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:autonomous-robot,
        ngm:collaborative-robot,
        ngm:multi-robot-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:control-theory,
        ngm:optimal-control,
        ngm:torque-control ;
    vc:slug "robotic-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:pid-control .

ngm:room-scale a owl:Class ;
    rdfs:label "Room Scale"@en ;
    rdfs:comment "A VR interaction paradigm in which the user can physically walk within a tracked play area — typically 2m × 2m or larger — with inside-out or lighthouse-based positional tracking translating real-world movement into the virtual environment. Room-scale VR requires boundary (chaperone) systems to prevent collisions with physical obstacles, and is contrasted with seated or standing-only VR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:haptics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:xr-meeting-space ;
    vc:requires ngm:sensor-fusion,
        ngm:virtual-reality-platform ;
    vc:slug "room-scale" ;
    vc:sourceDomain "spatial-computing" .

ngm:scalability a owl:Class ;
    rdfs:label "Scalability"@en ;
    rdfs:comment "Scalability is the property of a system that describes its capacity to handle increasing workloads by adding resources, without proportionate degradation in performance, cost efficiency, or reliability. Horizontal scalability adds more nodes to a distributed cluster; vertical scalability increases the resources of existing nodes. In distributed systems, achieving linear or near-linear scalability requires careful attention to coordination overhead, data partitioning strategies, and consistency trade-offs as captured by the CAP theorem. Scalability is a first-order design concern in cloud-native architectures, blockchain networks, and AI inference platforms serving large user populations."@en ;
    rdfs:subClassOf ngm:scalable-architecture ;
    vc:enables ngm:fault-tolerance,
        ngm:high-performance-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:distributed-architecture,
        ngm:performance-optimization,
        ngm:resilience,
        ngm:scalability-pattern ;
    vc:slug "scalability" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-systems,
        ngm:kubernetes,
        ngm:microservices-architecture .

ngm:search-engine a owl:Class ;
    rdfs:label "Search Engine"@en ;
    rdfs:comment "Software systems that crawl, index, and retrieve digital content based on user queries, using algorithms for relevance ranking, natural language processing, and increasingly semantic understanding to connect users with metaverse assets and experiences."@en ;
    rdfs:subClassOf ngm:information-retrieval,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:content-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:search-index a owl:Class ;
    rdfs:label "Search Index"@en ;
    rdfs:comment "A data structure that maps terms, embeddings, or attributes to document locations, enabling rapid retrieval of relevant content from large metaverse asset catalogues through inverted indexes, vector indexes, or hybrid approaches."@en ;
    rdfs:subClassOf ngm:data-structure,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:fast-query-response ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:security-infrastructure a owl:Class ;
    rdfs:label "Security Infrastructure"@en ;
    rdfs:comment "Security infrastructure encompasses the integrated set of hardware, software, processes, and policies that protect an organisation's information systems, networks, and data assets from unauthorised access, disruption, and exploitation. It includes perimeter defences, identity and access management systems, cryptographic key management, endpoint protection, monitoring and detection platforms, and incident response capabilities. Effective security infrastructure is layered—applying defence-in-depth principles so that compromise of any single control does not expose the entire system. Modern security infrastructure increasingly adopts zero-trust architectural principles, eliminating implicit trust based on network location and requiring continuous verification of every access request. Security infrastructure must align with regulatory requirements and evolve continuously in response to the changing threat landscape."@en ;
    rdfs:subClassOf ngm:security-framework ;
    vc:enables ngm:identity-and-access-management,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:vulnerability,
        ngm:zero-trust-architecture ;
    vc:slug "security-infrastructure" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:audit-trail,
        ngm:nist ;
    vc:uses ngm:access-control,
        ngm:authentication,
        ngm:cryptographic-key-management .

ngm:sensor-input a owl:Class ;
    rdfs:label "Sensor Input"@en ;
    rdfs:comment "Sensor input refers to the raw or pre-processed signals acquired from physical or virtual transducers that convert observable environmental quantities—position, force, temperature, light intensity, pressure, chemical concentration—into electrical or digital representations suitable for computation. It constitutes the primary interface between an autonomous system and its environment, providing the perceptual foundation for state estimation, feedback control, and situational awareness. Sensor inputs vary by modality, sampling rate, resolution, and noise characteristics, and effective use requires calibration, filtering, and often fusion with complementary modalities to produce reliable world-state estimates."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:perception-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:sensor-data,
        ngm:sensor-system,
        ngm:sensor-technology ;
    vc:slug "sensor-input" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-system,
        ngm:control-system ;
    vc:uses ngm:digital-signal-processing,
        ngm:real-time-computation .

ngm:sensor-technology a owl:Class ;
    rdfs:label "Sensor Technology"@en ;
    rdfs:comment "Sensor Technology encompasses the diverse hardware devices and fusion algorithms that capture physical-world data for use in robotics, spatial computing, and XR systems. This includes inertial measurement units, LiDAR scanners, depth cameras, eye-tracking, haptic sensors, and biometric devices, combined with fusion techniques such as visual-inertial odometry and Kalman filtering to produce accurate, robust state estimates for autonomous systems and immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:perception-system,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:camera,
        ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:imu,
        ngm:lidar ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "sensor-technology" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:depth-sensing .

ngm:series-elastic-actuation a owl:Class ;
    rdfs:label "Series Elastic Actuation"@en ;
    rdfs:comment "Series Elastic Actuation (SEA) is a robotic actuation paradigm in which a calibrated compliant element—typically a torsional or linear spring—is interposed between the gearbox output and the robot link. Deflection of the spring under load provides an indirect force measurement, enabling closed-loop torque control without strain-gauge complexity. The compliance also attenuates shock loads, reduces reflected inertia at the joint, and passively limits peak interaction forces, which is critical for safe operation in human-robot collaborative environments. SEA is widely employed in legged robots, prosthetic limbs, and rehabilitation exoskeletons where stable force regulation and back-driveability are essential."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-control,
        ngm:impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "series-elastic-actuation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robo-human-robot-interaction ;
    vc:uses ngm:actuator,
        ngm:robot-joint .

ngm:sha-256-hashing a owl:Class ;
    rdfs:label "SHA-256 Hashing"@en ;
    rdfs:comment "SHA-256 Hashing refers to the application of the SHA-256 (Secure Hash Algorithm 256-bit) cryptographic hash function — a member of the SHA-2 family standardised by NIST in 2001 — to produce a fixed-length 256-bit (32-byte) message digest from an arbitrary-length input, with the properties of determinism, pre-image resistance, second pre-image resistance, and collision resistance. The algorithm operates via 64 rounds of bit manipulation, modular addition, and nonlinear functions over a 512-bit block schedule. SHA-256 is the foundational hash function of Bitcoin's proof-of-work mining, block header commitments, and Merkle tree construction, as well as a critical primitive in TLS, code signing, and certificate transparency."@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    vc:enables ngm:bitcoin-mining,
        ngm:data-integrity,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:merkle-tree,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "sha-256-hashing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:blockchain-security,
        ngm:cryptographic-hash .

ngm:shader-language a owl:Class ;
    rdfs:label "Shader Language"@en ;
    rdfs:comment "A Shader Language is a domain-specific programming language designed for expressing GPU-executable algorithms that control the stages of a rendering pipeline. Major shader languages include GLSL for OpenGL/WebGL, HLSL for DirectX, Metal Shading Language for Apple platforms, and WGSL for WebGPU. They support specialised data types such as vectors and matrices, and are compiled to intermediate representations like SPIR-V for hardware-agnostic deployment."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:physically-based-rendering,
        ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:real-time-rendering ;
    vc:slug "shader-language" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:vertex-shader .

ngm:sidechain a owl:Class ;
    rdfs:label "Sidechain"@en ;
    rdfs:comment "Independent blockchain connected to a parent blockchain via a two-way peg mechanism that operates with its own consensus and validation rules while enabling asset transfers between chains, providing scalability and experimental capabilities without impacting the main chain."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:two-way-peg ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "sidechain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cross-chain-bridge .

ngm:simulation-software a owl:Class ;
    rdfs:label "Simulation Software"@en ;
    rdfs:comment "Application software that constructs and executes computational models of physical, biological, or social systems, allowing experimental manipulation of parameters to study behaviour over time. Simulation software spans physics engines, agent-based frameworks, and digital twin environments, and is used across engineering, scientific research, training, and metaverse development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:simulation-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:simulation-engine ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:slug "simulation-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:rendering-engine .

ngm:social-media a owl:Class ;
    rdfs:label "social media"@en ;
    rdfs:comment "Digital platforms and applications that enable users to create, share, and interact with user-generated content within networked communities. Social media platforms combine content distribution infrastructure, algorithmic recommendation, identity and profile management, and real-time communication at scale. They are significant vectors for AI application (content moderation, recommendation, advertising optimisation) and raise governance challenges around bias, privacy, and misinformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:privacy,
        ngm:social-platform ;
    vc:requires ngm:content-delivery-network,
        ngm:platform-governance ;
    vc:slug "social-media" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-moderation,
        ngm:machine-learning .

ngm:solid a owl:Class ;
    rdfs:label "Solid"@en ;
    rdfs:comment "Solid (Social Linked Data) is an open-source, W3C-specification-grounded decentralised web architecture conceived by Sir Tim Berners-Lee at MIT CSAIL (Massachusetts Institute of Technology Computer Science and Artificial Intelligence Laboratory) commercialised through the startup Inrupt and steer..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-ld ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparql ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-id-profile ],
        [ a owl:Restriction ;
