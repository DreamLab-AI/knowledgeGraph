ngm:thesaurus a owl:Class ;
    rdfs:label "Thesaurus"@en ;
    rdfs:comment "A thesaurus is a controlled vocabulary that organises preferred terms together with their synonyms and structured semantic relationships, principally broader, narrower and related-term links. By mapping non-preferred synonyms onto a single preferred descriptor, it enforces consistent indexing and improves retrieval by reconciling the many ways people express the same concept. Thesauri underpin information retrieval, library cataloguing and knowledge organisation, and are formalised by standards such as ISO 25964 and expressible in SKOS."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary ],
        ngm:controlled-vocabulary ;
    vc:bridgesTo ngm:semantic-web ;
    vc:contrastsWith ngm:ontology ;
    vc:dependsOn ngm:knowledge-organization ;
    vc:enables ngm:information-retrieval,
        ngm:search-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:controlled-vocabulary ;
    vc:isPartOf ngm:knowledge-organization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:indexing,
        ngm:metadata,
        ngm:ontology ;
    vc:requires ngm:vocabulary ;
    vc:slug "thesaurus" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:indexing,
        ngm:information-retrieval ;
    vc:uses ngm:classification,
        ngm:vocabulary .

ngm:three-js a skos:Concept ;
    rdfs:label "Three Js"@en .

ngm:timelock-contract a owl:Class ;
    rdfs:label "Timelock Contract"@en ;
    rdfs:comment "A smart contract or transaction condition that prevents funds or actions from being executed until a specified time or block height is reached. It is used to enforce delays and to coordinate conditional payments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:smart-contract ;
    vc:enables ngm:hash-time-locked-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract ;
    vc:slug "timelock-contract" ;
    vc:sourceDomain "blockchain" .

ngm:timer a owl:Class ;
    rdfs:label "Timer"@en ;
    rdfs:comment "A timer is a software or hardware mechanism that measures elapsed time or schedules an action to occur after a delay or at a recurring interval. In collaborative and real-time applications it provides shared countdowns, time-boxing, and synchronised triggers that all participants observe consistently. Timers are a basic building block of event scheduling, animation, and time-bounded interaction."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-whiteboard,
        ngm:real-time ;
    vc:slug "timer" ;
    vc:sourceDomain "metaverse" .

ngm:timestamping-service a owl:Class ;
    rdfs:label "Timestamping Service"@en ;
    rdfs:comment "A timestamping service is a system that issues verifiable proof that a piece of data existed at or before a particular time, often using cryptographic methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptographic-protocol ;
    vc:enables ngm:content-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography,
        ngm:hash-function ;
    vc:slug "timestamping-service" ;
    vc:sourceDomain "security" .

ngm:tlv-encoding a owl:Class ;
    rdfs:label "TLV Encoding"@en ;
    rdfs:comment "Type-Length-Value (TLV) encoding is a compact, extensible binary serialisation scheme in which each data field is represented by a type identifier, a length descriptor, and the value payload. Its self-describing structure allows parsers to skip unknown record types while preserving forward and backward compatibility, which is why protocols such as Lightning and Taproot Assets use it to embed optional metadata in transaction records."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:taproot-assets ;
    vc:slug "tlv-encoding" ;
    vc:sourceDomain "blockchain" .

ngm:tnfd a owl:Class ;
    rdfs:label "TNFD"@en ;
    rdfs:comment "The Taskforce on Nature-related Financial Disclosures (TNFD) is a global framework that guides organisations in assessing, reporting, and acting on nature- and biodiversity-related risks, dependencies, and impacts. Modelled on the climate-focused TCFD, it provides recommended disclosures structured around governance, strategy, risk management, and metrics so that capital can be redirected toward nature-positive outcomes."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting ;
    vc:slug "tnfd" ;
    vc:sourceDomain "governance" .

ngm:token-issuance a owl:Class ;
    rdfs:label "Token Issuance"@en ;
    rdfs:comment "Token issuance is the process by which a blockchain protocol or smart contract creates and distributes new digital tokens into circulation, establishing the initial and ongoing supply available to network participants. It encompasses the technical minting of token units according to predefined rules as well as the economic policies governing distribution, vesting schedules, and supply caps. Issuance mechanisms range from one-time generation events to continuous emission programmes tied to staking rewards or protocol activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:token-economics ;
    vc:bridgesTo ngm:finance ;
    vc:enables ngm:cryptocurrency,
        ngm:initial-coin-offering,
        ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-asset,
        ngm:governance-token ;
    vc:isPartOf ngm:token-economics,
        ngm:tokenomics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:on-chain-governance ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "token-issuance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:treasury-management,
        ngm:validator ;
    vc:uses ngm:monetary-policy .

ngm:token-sale a owl:Class ;
    rdfs:label "Token Sale"@en ;
    rdfs:comment "A Token Sale is a fundraising mechanism in which a blockchain project issues and sells digital tokens to investors or users in exchange for cryptocurrency or fiat currency, typically prior to or during the launch of a protocol or application. Token sales include initial coin offerings (ICOs), initial exchange offerings (IEOs), and initial DEX offerings (IDOs), each with differing levels of regulatory oversight and platform involvement. The proceeds are used to fund development, while purchasers receive tokens that may grant utility, governance rights, or speculative value within the ecosystem."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance ;
    vc:slug "token-sale" ;
    vc:sourceDomain "blockchain" .

ngm:tool-augmented-reasoning a owl:Class ;
    rdfs:label "Tool-Augmented Reasoning"@en ;
    rdfs:comment "Tool-augmented reasoning is an approach in which a language model invokes external tools such as calculators, search or code execution to solve tasks beyond its parametric knowledge. The model interleaves reasoning steps with tool calls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:reasoning ;
    vc:enables ngm:agentic-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:reasoning,
        ngm:tool-use ;
    vc:slug "tool-augmented-reasoning" ;
    vc:sourceDomain "ai" .

ngm:tornado-cash a owl:Class ;
    rdfs:label "Tornado Cash"@en ;
    rdfs:comment "Tornado Cash is a set of non-custodial smart contracts on Ethereum and compatible networks that obscure the on-chain link between a deposit and a withdrawal. Users deposit a fixed denomination of a token into a pool and later withdraw the same amount to a different address, using a zero-knowledge proof to demonstrate ownership of a valid deposit without revealing which one. It became widely known both as a privacy tool and as the subject of sanctions by the United States Office of Foreign Assets Control in 2022."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zk-snark ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:financial-privacy,
        ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:blockchain-analysis,
        ngm:custodial-exchange ;
    vc:enables ngm:transaction-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:decentralised-finance ;
    vc:requires ngm:ethereum-smart-contract-platform,
        ngm:merkle-tree,
        ngm:zero-knowledge-proof,
        ngm:zk-snark ;
    vc:slug "tornado-cash" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:commitment-scheme,
        ngm:relayer .

ngm:traceability-mechanism a owl:Class ;
    rdfs:label "Traceability Mechanism"@en ;
    rdfs:comment "A Traceability Mechanism is a systematic approach for recording, maintaining, and retrieving comprehensive documentation of an AI system's development process, data lineage, decision-making logic, and operational history to enable accountability, auditability, and debugging. It encompasses data provenance tracking, model versioning, decision logging, and tamper-evident audit trails that allow stakeholders to reconstruct the causal chain from system outputs back to training data and design choices. Regulatory frameworks including the EU AI Act and GDPR increasingly mandate specific traceability capabilities for high-risk AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:compliance-verification,
        ngm:explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:data-provenance,
        ngm:metadata-management ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:gdpr-compliance,
        ngm:transparency ;
    vc:requires ngm:data-governance,
        ngm:model-training ;
    vc:slug "traceability-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-risk-management .

ngm:tracking-technology a owl:Class ;
    rdfs:label "Tracking Technology"@en ;
    rdfs:comment "Tracking Technology refers to the hardware and software systems that determine the real-time position, orientation, and motion of a user or device in physical space for extended reality applications. Approaches include inside-out tracking using onboard cameras and SLAM, outside-in tracking using fixed base stations, eye tracking for gaze-based interaction, and hand/finger tracking for controller-free input."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:xr-hardware ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "tracking-technology" ;
    vc:sourceDomain "infrastructure" .

ngm:training-hardware a owl:Class ;
    rdfs:label "Training Hardware"@en ;
    rdfs:comment "Training Hardware is a artificial intelligence concept and a type of High-Performance Computing. that enables Neural Network Training."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:bridgesTo ngm:high-performance-computing ;
    vc:enables ngm:neural-network-training ;
