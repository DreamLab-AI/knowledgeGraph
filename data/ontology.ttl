ngm:test-driven-development a owl:Class ;
    rdfs:comment "Test-driven development is a software practice in which developers write an automated test that defines a desired behaviour before writing the code to satisfy it, then refactor once the test passes. This red-green-refactor cycle drives design from the perspective of usage and ensures that every feature is covered by tests as it is built. The discipline tends to produce modular, well-specified code and a comprehensive regression suite."@en ;
    rdfs:label "Test-Driven Development"@en ;
    rdfs:subClassOf ngm:software-testing ;
    rdfs:subClassOf _:r20707 ;
    rdfs:subClassOf _:r20708 ;
