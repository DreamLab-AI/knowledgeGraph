ngm:just-transition a owl:Class ;
    rdfs:label "Just Transition"@en ;
    rdfs:comment "A just transition is a framework for shifting economies toward low-carbon and sustainable production while ensuring that the burdens and benefits of that shift are distributed fairly. It seeks to protect workers, communities and developing regions dependent on carbon-intensive industries through retraining, social support and inclusive planning. The concept links climate policy with social equity and labour rights."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing,
        ngm:global-inequality ;
    vc:slug "just-transition" ;
    vc:sourceDomain "governance" .

ngm:keypoint-detection a owl:Class ;
    rdfs:label "Keypoint Detection"@en ;
    rdfs:comment "Keypoint detection is a computer vision task that locates salient, semantically meaningful points in an image, such as body joints, facial landmarks or object corners. It outputs spatial coordinates, often with confidence scores, that can be tracked across frames or matched between views. Keypoint detection is a building block for pose estimation, image registration and structure-from-motion."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:pose-estimation ;
    vc:slug "keypoint-detection" ;
    vc:sourceDomain "ai" .

ngm:large-scale-datasets a owl:Class ;
    rdfs:label "Large-Scale Datasets"@en ;
    rdfs:comment "Large-scale datasets are very large collections of data, often spanning billions of examples and many terabytes, assembled to train modern machine learning models. They are typically aggregated from web crawls, public corpora and curated sources, then filtered, deduplicated and tokenised. Their scale, diversity and quality are primary determinants of the capabilities of large language and generative models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "large-scale-datasets" ;
    vc:sourceDomain "ai" .

