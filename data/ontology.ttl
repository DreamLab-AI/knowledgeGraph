ngm:ethan-mollick a owl:Class ;
    rdfs:label "Ethan Mollick"@en ;
    rdfs:comment "Ethan Mollick is an American academic, professor at the Wharton School of the University of Pennsylvania, and widely cited public intellectual on the practical deployment of generative artificial intelligence in work, education, and entrepreneurship. His research bridges management science and AI-adoption theory, investigating how large language models augment human productivity, reshape organisational workflows, and alter pedagogical practice. He is the author of the book 'Co-Intelligence: Living and Working with AI' and is known for his hands-on experimental approach to understanding AI capabilities and their societal implications."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:behavioural-economics,
        ngm:educational-technology,
        ngm:management-science ;
    vc:contrastsWith ngm:ai-doomerism,
        ngm:ai-scepticism ;
    vc:enables ngm:ai-adoption,
        ngm:ai-literacy,
        ngm:human-ai-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-policy,
        ngm:chatgpt,
        ngm:co-intelligence,
        ngm:future-of-work,
        ngm:organisational-learning,
        ngm:wharton-school ;
    vc:slug "ethan-mollick" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-in-education,
        ngm:entrepreneurship,
        ngm:innovation-management,
        ngm:knowledge-work-augmentation ;
    vc:uses ngm:generative-ai,
        ngm:large-language-models,
        ngm:prompt-engineering .

