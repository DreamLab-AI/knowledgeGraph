    vc:slug "quantexa" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:quantum-ai a owl:Class ;
    rdfs:label "Quantum AI"@en ;
    rdfs:comment "Quantum AI is a research area at the intersection of quantum computing and artificial intelligence, applying quantum mechanical phenomena — superposition, entanglement, and interference — to accelerate or qualitatively improve machine learning algorithms, combinatorial optimisation, and probabilistic inference. Quantum circuits can in principle represent exponentially large state spaces with polynomial resources, offering potential speed-ups for specific learning and search tasks beyond classical limits. The field encompasses variational quantum algorithms, quantum neural networks, quantum-enhanced sampling, and the use of quantum hardware as accelerators within classical AI pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-computation-paradigm ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:deep-learning,
        ngm:optimization-algorithm ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:compute-infrastructure,
        ngm:cryptography,
        ngm:neural-network,
        ngm:post-quantum-cryptography,
        ngm:quantum-network-node ;
    vc:requires ngm:algorithm,
        ngm:machine-learning-discipline,
        ngm:quantum-computation-paradigm ;
    vc:slug "quantum-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:quantum-threat-to-cryptography a owl:Class ;
    rdfs:label "Quantum Threat to Cryptography"@en ;
    rdfs:comment "Existential risk to public-key cryptographic systems (ECDSA, RSA) from sufficiently powerful quantum computers capable of running Shor's algorithm. Q-Day—the point at which quantum advantage breaks deployed cryptography—threatens the security foundations of blockchain networks, TLS, and digital identity systems."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:contrastsWith ngm:post-quantum-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:quantum-computation-paradigm ;
    vc:slug "quantum-threat-to-cryptography" ;
    vc:sourceDomain "blockchain" .

ngm:radicle-decentralised-code-forge a owl:Class ;
    rdfs:label "Radicle Decentralised Code Forge"@en ;
    rdfs:comment "Radicle is a decentralised, peer-to-peer code collaboration platform built on Git that eliminates dependence on centralised forges such as GitHub or GitLab. It uses a content-addressed, cryptographically signed data model where repositories are identified by public keys rather than server-hosted URLs, enabling sovereign code hosting, offline collaboration, and censorship-resistant software development. Radicle integrates with Ethereum-based smart contracts for governance and funding, positioning it at the intersection of blockchain infrastructure and open-source software tooling."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralized-governance,
        ngm:open-source-software ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:distributed-system,
        ngm:smart-contract ;
    vc:slug "radicle-decentralised-code-forge" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-signature,
        ngm:peer-to-peer-network,
        ngm:version-control .

ngm:raycast-system a owl:Class ;
    rdfs:label "Raycast System"@en ;
    rdfs:comment "A Raycast System is the interaction subsystem in a spatial computing or XR engine that casts geometric rays from a controller, gaze direction, or cursor into the 3D scene to detect intersections with scene objects, enabling selection, pointing, UI interaction, and collision queries. It forms the primary input-resolution layer in VR/AR user interfaces, translating physical or tracked user intent into object picks within the scene graph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:gaze-control,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:collision-detection,
        ngm:physics-engine,
        ngm:scene-graph ;
    vc:slug "raycast-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:vr-controllers .

ngm:rb-0019-exoskeleton-robot a owl:Class ;
    rdfs:label "rb 0019 exoskeleton robot"@en ;
    rdfs:comment "An exoskeleton robot is a wearable robotic device that attaches to the human body and augments, supports, or replaces the wearer's physical capabilities. Exoskeletons may be powered (actuated) or passive (spring-and-damper based), and are used for physical rehabilitation after stroke or spinal cord injury, industrial worker fatigue reduction, and military load-carrying augmentation. Safety is paramount because the robot shares the mechanical structure with a human; ISO 13482 governs safety requirements for personal care robots including exoskeletons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0088-iso-13482-compliance ],
        ngm:exoskeleton-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:human-robot-interaction,
        ngm:rb-0007-collaborative-robot,
        ngm:service-robot,
        ngm:wearable-computing-platform ;
    vc:requires ngm:rb-0088-iso-13482-compliance,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0019-exoskeleton-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:uses ngm:rb-0056-impedance-control,
        ngm:rb-0067-force-torque-sensor .

ngm:rb-1002-closedloopcontrol a owl:Class ;
    rdfs:label "RB 1002 closedloopcontrol"@en ;
    rdfs:comment "RB 1002 Closed-Loop Control is an ontology term in the NarrativeGoldmine robotics hierarchy denoting the general class of feedback-based control architectures in which sensor measurements of a system's output are continuously fed back to the controller to correct deviations from a desired set-point. As a superclass it subsumes specific strategies including PID control, model-predictive control, adaptive control, and state-estimation-driven controllers used in robotic actuation and manipulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adaptive-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-predictive-control ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:trajectory-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:adaptive-control,
        ngm:model-predictive-control,
        ngm:pid-control ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:feedback-control,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:slug "rb-1002-closedloopcontrol" ;
    vc:sourceDomain "robotics" .

ngm:rb-1016-pathplanning a owl:Class ;
    rdfs:label "RB 1016 pathplanning"@en ;
    rdfs:comment "RB 1016 Path Planning is an ontology term in the NarrativeGoldmine robotics hierarchy representing the superclass of algorithms that compute collision-free trajectories from a start configuration to a goal configuration in a robot's configuration space. It encompasses graph-search methods (A*, Dijkstra), sampling-based planners (RRT, PRM), and reactive local-planning strategies (DWA, potential fields), all of which underpin autonomous navigation in structured and unstructured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rrt-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dijkstra-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:autonomous-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dijkstra-algorithm,
        ngm:graph-search,
