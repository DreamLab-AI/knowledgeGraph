    vc:enables ngm:adoption-of-convergent-technologies ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-reporting ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:asia-pacific-regulation ;
    vc:requires ngm:consumer-protection,
        ngm:regulatory-approval,
