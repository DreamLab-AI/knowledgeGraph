ngm:fatf-travel-rule a owl:Class ;
    rdfs:label "FATF Travel Rule"@en ;
    rdfs:comment "The FATF Travel Rule (Recommendation 16 as applied to virtual assets) requires Virtual Asset Service Providers (VASPs) to collect, verify, and transmit originator and beneficiary identity information alongside cryptocurrency transactions that meet or exceed the applicable threshold. Issued by the Financial Action Task Force, it extends traditional wire-transfer obligations to crypto-asset transfers, obligating sending VASPs to share identifying data with receiving VASPs before or simultaneously with the transfer. Compliance demands interoperability protocols and data-sharing infrastructure between exchanges, wallets, and custodians operating in different jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:virtual-asset ;
    vc:requires ngm:anti-money-laundering,
        ngm:digital-identity ;
    vc:slug "fatf-travel-rule" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:fatf .

ngm:fca a owl:Class ;
    rdfs:label "FCA"@en ;
    rdfs:comment "The Financial Conduct Authority (FCA) is the statutory regulator of financial services and markets in the United Kingdom, operating independently of government under the Financial Services and Markets Act 2000. It supervises conduct in retail and wholesale markets, authorises financial firms, and enforces anti-money-laundering obligations. In the blockchain and digital asset domain, the FCA registers crypto-asset businesses under the Money Laundering Regulations, oversees financial promotions for crypto assets, and implements policy derived from international standards bodies such as the Financial Action Task Force."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:fatf,
        ngm:financial-regulation ;
    vc:slug "fca" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:anti-money-laundering,
        ngm:financial-stability .

ngm:financial-instruments a owl:Class ;
    rdfs:label "Financial Instruments"@en ;
    rdfs:comment "Financial Instruments are contractual agreements that represent a monetary value and can be created, traded, modified, or settled. In blockchain and decentralised finance ecosystems they include smart contract-based derivatives, lending protocols, automated market makers, yield aggregators, and synthetic assets that replicate exposure to real-world financial assets through on-chain collateralisation and oracle price feeds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:financial-services ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:tokenization ;
    vc:requires ngm:financial-regulation,
        ngm:smart-contracts ;
    vc:slug "financial-instruments" ;
    vc:sourceDomain "infrastructure" .

ngm:financial-services a owl:Class ;
    rdfs:label "Financial Services"@en ;
    rdfs:comment "Financial Services encompasses the suite of economic services provided by the finance industry, including banking, investment, insurance, and payment systems. In digital and decentralised contexts, financial services extend to blockchain-based instruments, smart contract-mediated lending, tokenised asset management, and cross-border payment rails operating without traditional intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
