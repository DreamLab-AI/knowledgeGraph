    vc:standardizedBy ngm:central-bank ;
    vc:supports ngm:order-book ;
    vc:uses ngm:atomic-settlement,
        ngm:real-time-gross-settlement .

ngm:climate-modelling a owl:Class ;
    rdfs:label "Climate Modelling"@en ;
    rdfs:comment "Climate Modelling is the scientific discipline of constructing mathematical and computational representations of Earth's climate system to simulate past, present, and future climate states. Models range from simple energy-balance equations to high-resolution coupled atmosphere-ocean-land-ice systems running on supercomputing infrastructure. They underpin global projections published by the Intergovernmental Panel on Climate Change and inform policy decisions on emissions reduction and adaptation. Machine learning is increasingly integrated to accelerate parameterisation and downscaling. Outputs feed directly into carbon accounting, sustainability planning, and digital twin applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        ngm:digital-twin ;
    vc:bridgesTo ngm:digital-twin-of-society-dto-s,
        ngm:smart-city-infrastructure,
        ngm:supply-chain-resilience ;
    vc:dependsOn ngm:parallel-computing ;
    vc:enables ngm:carbon-footprint-measurement,
        ngm:carbon-neutrality-planning,
        ngm:climate-risk-assessment,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:environmental-sustainability,
        ngm:iso-14064 ;
    vc:requires ngm:high-performance-computing ;
    vc:slug "climate-modelling" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:gpu-acceleration,
        ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:time-series-forecasting .

ngm:clinical-trials a owl:Class ;
    rdfs:label "Clinical Trials"@en ;
    rdfs:comment "Blockchain-based clinical trial management systems employ immutable audit trails, smart contracts for protocol compliance, and cryptographic verification to ensure data integrity, prevent fraud, and provide FDA 21 CFR Part 11 compliant tamper-proof records whilst reducing monitoring costs. These systems address pharmaceutical development challenges including data falsification, patient recruitment inefficiency, and multi-site coordination failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-compliance ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:dependsOn ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:blockchain-compliance,
        ngm:data-integrity ;
    vc:slug "clinical-trials" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:drug-discovery,
        ngm:healthcare-records ;
    vc:uses ngm:audit-trail,
        ngm:hyperledger-fabric,
        ngm:smart-contract .

ngm:clip-encoder a owl:Class ;
    rdfs:label "CLIP Encoder"@en ;
    rdfs:comment "A CLIP Encoder is either of the two paired neural network encoders — an image encoder and a text encoder — within the Contrastive Language-Image Pre-training (CLIP) framework developed by OpenAI. Each encoder maps its respective modality into a shared high-dimensional embedding space where semantically related image-text pairs are placed in proximity, enabling zero-shot image classification, cross-modal retrieval, and semantic image search without task-specific fine-tuning. CLIP Encoders serve as foundational components in multimodal AI pipelines, diffusion model conditioning, and vision-language models."@en ;
    rdfs:subClassOf ngm:encoder ;
    vc:enables ngm:diffusion-model,
        ngm:image-classification,
        ngm:multimodal-ai-architecture-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:computer-vision,
        ngm:embedding ;
    vc:slug "clip-encoder" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:contrastive-learning,
        ngm:transformer,
        ngm:vision-transformer .

ngm:cncf a owl:Class ;
    rdfs:label "CNCF"@en ;
    rdfs:comment "The Cloud Native Computing Foundation (CNCF) is a vendor-neutral, open-source foundation established in 2015 under the Linux Foundation to steward cloud-native software projects including Kubernetes, Prometheus, Envoy, and over 150 additional hosted projects. CNCF defines cloud-native computing as building and running scalable applications in modern, dynamic environments such as public, private, and hybrid clouds using techniques including containers, microservices, and declarative APIs. The Foundation operates a Technical Oversight Committee (TOC) that governs project acceptance through sandbox, incubating, and graduated maturity stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:envoy-proxy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prometheus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kubernetes ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-telemetry ],
        ngm:linux-foundation ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration,
        ngm:machine-learning ;
    vc:enables ngm:cloud-native-applications,
        ngm:container-orchestration,
        ngm:microservices-architecture,
        ngm:open-source-software,
        ngm:platform-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:envoy-proxy,
        ngm:kubernetes,
