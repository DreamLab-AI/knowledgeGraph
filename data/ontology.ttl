    vc:requires ngm:encryption,
        ngm:identity-and-access-management ;
    vc:slug "cloud-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-27001 ;
    vc:supports ngm:compliance,
        ngm:data-privacy ;
    vc:uses ngm:access-control,
        ngm:data-loss-prevention,
