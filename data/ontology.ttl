    vc:sourceDomain "spatial-computing" .

ngm:legal-accountability a owl:Class ;
    rdfs:label "Legal Accountability"@en ;
    rdfs:comment "Legal accountability is the principle that an identifiable party can be held answerable under law for actions, omissions, and harms, with attendant liability and remedies. In digital and metaverse contexts it requires attributing conduct to legal persons despite pseudonymity, automation, or cross-jurisdictional operation. Establishing it underpins liability models, dispute resolution, and regulatory enforcement."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-ethics-and-law,
        ngm:metaverse-liability-model ;
    vc:slug "legal-accountability" ;
    vc:sourceDomain "governance" .

ngm:legal-evidence a owl:Class ;
    rdfs:label "Legal Evidence"@en ;
    rdfs:comment "Legal evidence is information presented to a court or tribunal to establish facts in dispute, which must satisfy admissibility criteria such as authenticity, relevance, and chain of custody. In digital contexts it includes logs, signed records, timestamps, and cryptographic proofs that demonstrate integrity and origin. Sound evidence handling is essential for proving non-repudiation and supporting enforcement."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:evidence-collection,
        ngm:non-repudiation ;
    vc:slug "legal-evidence" ;
    vc:sourceDomain "security" .

ngm:legal-system a owl:Class ;
    rdfs:label "Legal System"@en ;
    rdfs:comment "A legal system is the institutional framework of laws, courts, enforcement bodies, and procedures through which a jurisdiction creates, interprets, and applies binding rules. Major traditions include common law, civil law, and religious or customary systems, each differing in sources of authority and precedent. Legal systems define the jurisdictional context within which digital and property rights are recognised and enforced."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-jurisdiction,
        ngm:virtual-property-right ;
    vc:slug "legal-system" ;
    vc:sourceDomain "governance" .

ngm:legal-tech-domain a owl:Class ;
    rdfs:label "Legal Tech Domain"@en ;
    rdfs:comment "The Legal Tech Domain covers the application of computational methods to legal practice and the administration of law. Its scope includes contract analysis, legal research, e-discovery and document automation. It is a top-level subject classification at the intersection of law and technology. The boundary excludes the general regulatory rule-making that applies across sectors, which belongs to the Regulation Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-retrieval-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:legal-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation-domain ],
        ngm:owl-thing ;
    vc:enables ngm:compliance-checking,
        ngm:contract-review,
        ngm:legal-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:case-prediction,
        ngm:contract-analysis,
        ngm:document-automation,
