ngm:construction-digital-twin a owl:Class ;
    rdfs:label "Construction Digital Twin"@en ;
    rdfs:comment "An integrated 3D model of built assets synchronized with real-time construction, operational, and maintenance data, enabling lifecycle management from design through decommissioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bim-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:io-t-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-synchronization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:io-t-sensor-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-database ],
        ngm:digital-twin,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:energy-optimization,
        ngm:lifecycle-management,
        ngm:predictive-maintenance,
        ngm:space-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-database,
        ngm:bim-model,
        ngm:energy-management-system,
        ngm:io-t-sensor-network,
        ngm:maintenance-schedule ;
    vc:isPartOf ngm:digital-twin,
        ngm:smart-building-ecosystem ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:bim-software,
        ngm:cloud-platform,
        ngm:io-t-infrastructure,
        ngm:real-time-synchronization ;
    vc:slug "construction-digital-twin" ;
    vc:sourceDomain "spatial-computing" .

