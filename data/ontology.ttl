ngm:stability-ai a owl:Class ;
    rdfs:label "Stability AI"@en ;
    rdfs:comment "Stability AI is a British AI company founded in 2019 (publicly prominent from 2022) that develops and releases open-weight generative models across image, audio, language, and video modalities, most notably the Stable Diffusion family of latent diffusion models for text-to-image synthesis. The company's open-weight release strategy, in which model weights are made freely downloadable rather than accessed only via hosted APIs, catalysed a large ecosystem of fine-tuned variants, community tools, and downstream commercial products. Stability AI also supports research into multimodal generation, efficient inference, and safety mechanisms for open foundation models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:content-moderation,
        ngm:creative-ai,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:adobe-firefly,
        ngm:midjourney,
        ngm:openai ;
    vc:enables ngm:fine-tuning,
        ngm:image-generation,
        ngm:open-weight-model,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:stable-audio,
        ngm:stable-diffusion,
        ngm:stable-video-diffusion,
        ngm:stablelm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:diffusion-model,
        ngm:foundation-model,
        ngm:training-data-provenance ;
    vc:requires ngm:gpu-compute,
        ngm:large-scale-training-data ;
    vc:slug "stability-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:clip,
        ngm:latent-diffusion-model,
        ngm:u-net,
        ngm:variational-autoencoder .

