artificial-intelligence:ComputerVision vcw:bridgesTo artificial-intelligence:DigitalTwin .

artificial-intelligence:ComputerVision vcw:bridgesTo artificial-intelligence:ArtificialIntelligence .

artificial-intelligence:ComputerVision vcw:bridgesTo artificial-intelligence:IoTSensors .

# Image Classification
artificial-intelligence:ImageClassification rdf:type owl:Class ;
    rdfs:label "Image Classification"@en ;
    rdfs:comment "Image Classification is the computer vision task of assigning a categorical label to an entire image from a predefined set of classes, determining what is depicted in the image as a whole. Modern image classification employs deep convolutional neural networks (ResNet, EfficientNet, Vision Transformers) trained on large-scale datasets (ImageNet) to achieve human-level or super-human performance on diverse visual recognition tasks."@en ;
    skos:prefLabel "Image Classification"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:image-classification" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:image-classification> ;
    vcw:contentHash "sha256-12-a6462e8711c9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0357" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0357" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Object Detection
spatial-computing:ObjectDetection rdf:type owl:Class ;
    rdfs:label "Object Detection"@en ;
    rdfs:comment "Object Detection is the computer vision task of identifying and localising multiple objects within an image by predicting bounding boxes and class labels for each detected instance. Object detectors (YOLO, Faster R-CNN, DETR) combine classification and localisation, outputting spatial coordinates and class probabilities for all objects of interest in real-time or near-real-time performance."@en ;
    skos:prefLabel "Object Detection"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:object-detection" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:object-detection> ;
    vcw:contentHash "sha256-12-23ce93cfe3ca" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0358" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0358" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Semantic Segmentation
artificial-intelligence:SemanticSegmentation rdf:type owl:Class ;
    rdfs:label "Semantic Segmentation"@en ;
    rdfs:comment "Semantic Segmentation is the computer vision task of assigning a class label to every pixel in an image, partitioning the image into semantically meaningful regions without distinguishing between individual object instances. Semantic segmentation networks (FCN, U-Net, DeepLab) produce dense pixel-wise predictions enabling scene understanding applications in medical imaging, autonomous driving, and satellite imagery analysis."@en ;
    skos:prefLabel "Semantic Segmentation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:semantic-segmentation" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:semantic-segmentation> ;
    vcw:contentHash "sha256-12-f02f934ac3ab" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0359" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0359" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Instance Segmentation
spatial-computing:InstanceSegmentation rdf:type owl:Class ;
    rdfs:label "Instance Segmentation"@en ;
    rdfs:comment "Instance Segmentation extends object detection by predicting precise pixel-level masks for each individual object instance, combining object detection with semantic segmentation to delineate exact boundaries of distinct objects. Instance segmentation models (Mask R-CNN, YOLACT, SOLOv2) enable fine-grained object localisation essential for robotics manipulation, autonomous driving, and medical image analysis."@en ;
    skos:prefLabel "Instance Segmentation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:instance-segmentation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:instance-segmentation> ;
    vcw:contentHash "sha256-12-f8f448a6a393" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0360" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0360" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Panoptic Segmentation
spatial-computing:PanopticSegmentation rdf:type owl:Class ;
    rdfs:label "Panoptic Segmentation"@en ;
    rdfs:comment "Panoptic Segmentation unifies semantic segmentation and instance segmentation by assigning every pixel both a class label and an instance ID, providing a complete scene understanding with \"thing\" classes (countable objects) and \"stuff\" classes (amorphous regions). Panoptic segmentation offers holistic scene parsing for applications requiring comprehensive visual understanding such as autonomous driving and robotics."@en ;
    skos:prefLabel "Panoptic Segmentation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:panoptic-segmentation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:panoptic-segmentation> ;
    vcw:contentHash "sha256-12-606e0bb6cd93" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0361" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0361" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Image Generation
spatial-computing:ImageGeneration rdf:type owl:Class ;
    rdfs:label "Image Generation"@en ;
    rdfs:comment "Image Generation is the synthesis of realistic or stylised images using generative AI models including Generative Adversarial Networks (GANs), Variational Autoencoders (VAEs), and Diffusion Models. Modern image generation systems (DALL-E, Stable Diffusion, Midjourney) produce high-fidelity images from text descriptions, sketches, or latent representations, enabling creative applications, data augmentation, and content creation."@en ;
    skos:prefLabel "Image Generation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:image-generation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:image-generation> ;
    vcw:contentHash "sha256-12-88957f90a47f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0362" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0362" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Image to Image Translation
spatial-computing:ImagetoImageTranslation rdf:type owl:Class ;
    rdfs:label "Image to Image Translation"@en ;
    rdfs:comment "Image-to-Image Translation transforms images from one visual domain to another whilst preserving content structure, converting between image modalities such as sketch-to-photo, day-to-night, satellite-to-map, or style transfer between artistic styles. Image translation models (Pix2Pix, CycleGAN, StyleGAN) employ conditional generation and adversarial learning to learn mappings between paired or unpaired image domains."@en ;
    skos:prefLabel "Image to Image Translation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:image-to-image-translation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:image-to-image-translation> ;
    vcw:contentHash "sha256-12-19414278c4b9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0363" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0363" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Style Transfer
spatial-computing:StyleTransfer rdf:type owl:Class ;
    rdfs:label "Style Transfer"@en ;
    rdfs:comment "Style Transfer is the technique of applying the artistic style of one image (style image) to the content of another image (content image), creating a new image that combines content from one source with the aesthetic style of another. Neural style transfer employs convolutional neural networks to separate and recombine content and style representations, enabling artistic rendering, photo enhancement, and creative visual effects."@en ;
    skos:prefLabel "Style Transfer"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:style-transfer" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:style-transfer> ;
    vcw:contentHash "sha256-12-9470c51e67a1" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0364" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0364" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Super Resolution
spatial-computing:SuperResolution rdf:type owl:Class ;
    rdfs:label "Super Resolution"@en ;
    rdfs:comment "Super-Resolution is the process of enhancing the resolution and quality of low-resolution images by predicting and synthesising high-frequency details using deep learning models. Single image super-resolution (SISR) networks (SRCNN, ESRGAN, Real-ESRGAN) reconstruct plausible high-resolution images from degraded inputs, enabling applications in medical imaging enhancement, satellite imagery analysis, and consumer photo enhancement."@en ;
    skos:prefLabel "Super Resolution"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:super-resolution" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:super-resolution> ;
    vcw:contentHash "sha256-12-46ccf608c76c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0365" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0365" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Machine Translation
artificial-intelligence:MachineTranslation rdf:type owl:Class ;
    rdfs:label "Machine Translation"@en ;
    rdfs:comment "Machine Translation is the automated translation of text or speech from one natural language to another using neural network models, particularly transformer-based sequence-to-sequence architectures. Modern neural machine translation systems (Google Translate, DeepL, NLLB) achieve near-human translation quality through pre-training on massive multilingual corpora, attention mechanisms, and cross-lingual transfer learning."@en ;
    skos:prefLabel "Machine Translation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:machine-translation" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:machine-translation> ;
    vcw:contentHash "sha256-12-f1880c8c2170" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0367" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0367" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Named Entity Recognition
spatial-computing:NamedEntityRecognition rdf:type owl:Class ;
    rdfs:label "Named Entity Recognition"@en ;
    rdfs:comment "Named Entity Recognition (NER) is the NLP task of identifying and classifying named entities (persons, organisations, locations, dates, quantities) within unstructured text into predefined categories. NER systems employ transformer-based models (BERT, RoBERTa) with sequence labelling architectures (CRF, BiLSTM-CRF) to extract structured information from documents, enabling information extraction, knowledge graph construction, and semantic search."@en ;
    skos:prefLabel "Named Entity Recognition"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:named-entity-recognition" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:named-entity-recognition> ;
    vcw:contentHash "sha256-12-2ade7a03fb81" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0368" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
