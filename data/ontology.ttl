# Social Presence Theory
tc:SocialPresenceTheory a owl:Class ;
    rdfs:subClassOf tc:MediaTheory ;
    rdfs:subClassOf tc:CommunicationTheory ;
    rdfs:label "Social Presence Theory"@en ;
    rdfs:comment "\"A theoretical framework explaining how communication media vary in their capacity to convey social cues (facial expressions, vocal intonation, body language, interpersonal warmth), thereby influencing the degree to which communicators perceive each other as psychologically present, real, and engaged in interpersonal exchange.\""@en ;
    skos:prefLabel "Social Presence Theory"@en ;
    dcterms:identifier "TC-0190" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
