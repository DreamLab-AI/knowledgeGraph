ngm:web-access-control a owl:Class ;
    rdfs:label "Web Access Control"@en ;
    rdfs:comment "Web Access Control (WAC) is a decentralised authorisation system for web resources that uses RDF-based access control lists to specify which agents may read, write, append, or control linked-data resources identified by URIs. It is a core mechanism in the Solid ecosystem, letting individuals govern access to their personal data pods using WebID-based identity. WAC decouples authorisation from any central server, aligning with self-sovereign data principles."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:solid ;
    vc:slug "web-access-control" ;
    vc:sourceDomain "security" .

ngm:web-application a skos:Concept ;
    rdfs:label "Web Application"@en .

ngm:web-browser a skos:Concept ;
    rdfs:label "Web Browser"@en .

ngm:web-gl a owl:Class ;
    rdfs:label "WebGL"@en ;
    rdfs:comment "WebGL (Web Graphics Library) is a royalty-free JavaScript API that exposes a subset of OpenGL ES 2.0 and 3.0 to web browsers, enabling hardware-accelerated 2D and 3D rendering directly inside an HTML canvas element without requiring browser plug-ins. It communicates directly with the GPU through the browser's graphics pipeline, exposing programmable vertex and fragment shaders written in GLSL ES. Standardised by the Khronos Group and supported natively in all major browsers, WebGL underpins interactive visualisations, browser-based games, scientific data rendering, and WebXR spatial computing experiences. Its successor API, WebGPU, offers a more modern GPU abstraction while WebGL remains the dominant, battle-tested standard for cross-platform GPU-accelerated web graphics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:graphics-api ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:machine-learning-in-browser ;
    vc:contrastsWith ngm:canvas-2d,
        ngm:direct3d,
        ngm:vulkan,
        ngm:web-gpu ;
    vc:dependsOn ngm:browser-graphics-pipeline,
        ngm:opengl-es ;
    vc:enables ngm:browser-based-games,
        ngm:data-visualisation,
        ngm:real-time-rendering,
        ngm:scientific-visualisation,
        ngm:web-xr ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:opengl-es ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:babylon-js,
        ngm:computer-graphics,
        ngm:three-js,
        ngm:webassembly ;
    vc:requires ngm:glsl-es,
        ngm:gpu,
        ngm:html-canvas,
        ngm:javascript ;
    vc:slug "web-gl" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:uses ngm:rasterisation,
        ngm:shader-programming,
        ngm:texture-mapping,
        ngm:vertex-buffer-object .

