    vc:slug "extreme-programming" ;
    vc:sourceDomain "infrastructure" .

ngm:fair-data-principles a owl:Class ;
    rdfs:label "FAIR Data Principles"@en ;
    rdfs:comment "The FAIR Data Principles are a set of guidelines stating that scientific and research data should be Findable, Accessible, Interoperable, and Reusable by both humans and machines. They emphasise persistent identifiers, rich machine-readable metadata, standardised vocabularies, and clear usage licences to maximise the long-term value of data. FAIR is widely adopted in research-data management, open science, and knowledge-graph and ontology engineering."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:metadata-schema ;
    vc:slug "fair-data-principles" ;
    vc:sourceDomain "data" .

ngm:fairness-in-machine-learning a owl:Class ;
    rdfs:label "Fairness in Machine Learning"@en ;
    rdfs:comment "Fairness in machine learning is the study and practice of ensuring that learned models do not produce systematically disadvantageous outcomes for individuals or groups defined by protected attributes such as race, gender, or age. It encompasses formal fairness criteria — including demographic parity, equalised odds, and individual fairness — and the techniques used to measure and mitigate disparate impact before, during, or after training. The field is central to responsible and ethical AI, balancing accuracy with equitable treatment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:responsible-ai ;
    vc:bridgesTo ngm:explainable-ai ;
    vc:contrastsWith ngm:bias ;
    vc:dependsOn ngm:bias ;
    vc:enables ngm:algorithmic-fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ethical-ai,
        ngm:responsible-ai ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-fairness,
        ngm:compliance,
        ngm:explainable-ai,
        ngm:governance ;
    vc:requires ngm:training-data ;
    vc:slug "fairness-in-machine-learning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:accountability,
        ngm:transparency ;
    vc:uses ngm:audit,
        ngm:model-interpretability .

ngm:fast-ai a owl:Class ;
    rdfs:label "fast.ai"@en ;
    rdfs:comment "fast.ai is a research lab, online course series, and open-source Python deep learning library founded by Jeremy Howard (former president and chief scientist of Kaggle, founder of FastMail and Optimal Decisions Group) and Rachel Thomas (UCSF / University of San Francisco data ics researcher), buil..."@en ;
