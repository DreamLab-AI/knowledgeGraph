        ngm:virtual-reality ;
    vc:slug "virtual-tourism" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-twin,
        ngm:volumetric-capture .

ngm:visual-inertial-odometry a owl:Class ;
    rdfs:label "Visual-Inertial Odometry"@en ;
    rdfs:comment "Visual-inertial odometry (VIO) is a technique that estimates a device's six-degree-of-freedom motion and pose by fusing camera imagery with inertial measurement unit data. The complementary fusion compensates for the drift of inertial sensors and the scale ambiguity of monocular vision, yielding robust, low-latency tracking. VIO underpins inside-out tracking for mixed-reality headsets, drones and mobile robots."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mixed-reality ;
    vc:slug "visual-inertial-odometry" ;
    vc:sourceDomain "robotics" .

ngm:vocabulary a owl:Class ;
    rdfs:label "Vocabulary"@en ;
    rdfs:comment "The complete set of unique tokens in a language model's tokenisation scheme, typically ranging from 32,000 to 128,000 entries in modern architectures. Vocabulary size directly governs embedding matrix dimensions, output layer size, and token-level granularity, with larger vocabularies improving expressiveness and training efficiency at the cost of increased memory during inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-text-tokenisation ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:inference,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:neural-network-text-tokenisation ;
    vc:slug "vocabulary" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:subword-tokenisation,
        ngm:word-piece .

ngm:volume-rendering a owl:Class ;
    rdfs:label "Volume Rendering"@en ;
    rdfs:comment "Volume rendering produces images directly from three-dimensional scalar or density fields by integrating colour and opacity along view rays, rather than rendering explicit surfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        ngm:computer-graphics ;
    vc:enables ngm:neural-radiance-fields ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:graphics-pipeline ;
    vc:slug "volume-rendering" ;
    vc:sourceDomain "metaverse" .

ngm:volumetric-video a owl:Class ;
    rdfs:label "Volumetric Video"@en ;
    rdfs:comment "Volumetric video captures a subject from many viewpoints to reconstruct a moving three-dimensional representation that can be viewed from any angle, rather than a fixed two-dimensional image sequence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:photogrammetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:metaverse,
        ngm:spatial-audio ;
    vc:contrastsWith ngm:2d-video,
        ngm:360-video ;
    vc:dependsOn ngm:performance-capture,
        ngm:real-time-rendering ;
    vc:enables ngm:free-viewpoint-video,
        ngm:holographic-display,
        ngm:immersive-telepresence,
        ngm:volume-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-map,
        ngm:point-cloud,
        ngm:texture-atlas ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:light-field-display ;
    vc:requires ngm:depth-sensor,
        ngm:multi-camera-rig,
        ngm:photogrammetry ;
    vc:slug "volumetric-video" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:digital-twin,
        ngm:extended-reality,
        ngm:virtual-production ;
    vc:uses ngm:3d-reconstruction,
        ngm:neural-radiance-field,
        ngm:video-compression .

ngm:vr-rendering-engine a owl:Class ;
    rdfs:label "VR Rendering Engine"@en ;
    rdfs:comment "Specialised real-time graphics software that generates stereoscopic imagery for virtual reality headsets, optimising frame rates (minimum 90 fps), motion-to-photon latency (sub-20 ms), and visual fidelity while managing VR-specific pipeline requirements including foveated rendering, asynchronous reprojection, and lens distortion correction. Leading implementations include Unreal Engine 5 (Lumen, Nanite) and Unity (URP/HDRP), both supporting major XR hardware via OpenXR and platform-specific SDKs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:foveated-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-device ],
        ngm:game-engine,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:foveated-rendering,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering,
        ngm:xr-device ;
    vc:slug "vr-rendering-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:spatial-computing .

ngm:web-standard a owl:Class ;
    rdfs:label "Web Standard"@en ;
    rdfs:comment "A Web Standard is a formally published technical specification developed by recognised standards bodies—primarily the W3C, WHATWG, IETF, and ECMA International—that defines interoperable behaviours, data formats, APIs, or protocols for the open web. These specifications undergird every browser-rendered application by guaranteeing that HTML, CSS, JavaScript, and associated platform APIs behave consistently across vendor implementations. Web Standards are normative documents that pass through community drafting, multi-stakeholder review, and vendor implementation before reaching Recommendation or Living Standard status, ensuring that the web remains an open, royalty-free platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:webassembly,
        ngm:webgl,
        ngm:webgpu ;
    vc:contrastsWith ngm:proprietary-technology,
        ngm:vendor-lock-in ;
    vc:enables ngm:open-web-platform,
        ngm:progressive-web-app,
        ngm:web-interoperability,
        ngm:webxr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:css,
        ngm:html,
        ngm:http,
        ngm:javascript,
        ngm:web-api ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:open-source,
        ngm:web-platform ;
    vc:requires ngm:browser-engine,
        ngm:vendor-implementation ;
    vc:slug "web-standard" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ecma-international,
        ngm:ietf,
        ngm:w3c,
        ngm:whatwg ;
    vc:supports ngm:accessibility,
        ngm:privacy,
        ngm:web-security .

ngm:webassembly a skos:Concept ;
    rdfs:label "Webassembly"@en .

ngm:wholesale-cbdc a owl:Class ;
    rdfs:label "Wholesale CBDC"@en ;
    rdfs:comment "A Wholesale Central Bank Digital Currency (wCBDC) is a form of central bank money issued in digital form and restricted to use by financial institutions—commercial banks, clearing houses, and other regulated entities—for large-value interbank settlement and financial market infrastructure operations, as distinct from retail CBDC which is available to the general public. Wholesale CBDCs are designed to modernise payment system infrastructure by enabling atomic delivery-versus-payment settlement, programmable payment conditions through smart contracts, and 24/7 settlement finality, addressing inefficiencies in legacy correspondent banking and real-time gross settlement systems. Multiple central banks are actively piloting wholesale CBDC, including Project Jura (BIS, Banque de France, SNB), Project Dunbar (BIS, MAS, SARB, RBA, BNM), and the Bank of England's New Payments Architecture."@en ;
    rdfs:subClassOf ngm:central-bank-digital-currency ;
    vc:enables ngm:cross-border-payments,
        ngm:instant-value-settlement,
        ngm:monetary-policy-implementation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:central-bank,
        ngm:financial-infrastructure ;
    vc:slug "wholesale-cbdc" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:monetary-sovereignty,
        ngm:monetary-system ;
    vc:uses ngm:digital-payment-system,
        ngm:interoperability-protocol .

ngm:wireless-connectivity a owl:Class ;
    rdfs:label "Wireless Connectivity"@en ;
    rdfs:comment "Wireless connectivity is the transmission of data between devices over radio frequencies without physical cabling. It spans short-range links such as Wi-Fi and Bluetooth and wide-area mobile networks such as 5G."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        ngm:communication-protocol ;
    vc:enables ngm:internet-of-things,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:communication-protocol ;
    vc:slug "wireless-connectivity" ;
    vc:sourceDomain "infrastructure" .

ngm:wireless-radio a owl:Class ;
    rdfs:label "Wireless Radio"@en ;
    rdfs:comment "Wireless radio refers to the technology and systems that transmit and receive information using electromagnetic waves propagated through free space without physical conductors, encompassing the hardware, protocols, modulation schemes, and spectrum management practices that enable wireless communication across a range of frequencies from kilohertz to millimetre-wave bands. It is the physical-layer foundation of all wireless networking standards including cellular, Wi-Fi, Bluetooth, and satellite communications."@en ;
    rdfs:subClassOf ngm:telecommunications ;
    vc:enables ngm:telecommunications-infrastructure,
        ngm:wi-fi ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:antenna-array,
        ngm:radio-access-network,
        ngm:wireless-connectivity ;
    vc:slug "wireless-radio" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:radio-transceiver .

ngm:workflow-orchestration a owl:Class ;
    rdfs:label "Workflow Orchestration"@en ;
    rdfs:comment "Workflow orchestration is the coordination of multiple interdependent tasks, services, or agents into a coherent end-to-end process, managing ordering, data flow, conditional branching, error handling, and resource allocation. It centralises control logic so that distributed components execute in the correct sequence with the right inputs. In agentic AI systems, orchestration governs how tool calls, sub-agents, and model invocations are sequenced to accomplish complex goals."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-application,
        ngm:function-calling ;
    vc:slug "workflow-orchestration" ;
    vc:sourceDomain "ai" .

ngm:xr-device a owl:Class ;
    rdfs:label "XR Device"@en ;
    rdfs:comment "Hardware equipment designed to create or enhance extended reality experiences, encompassing virtual reality headsets, augmented reality glasses, mixed reality displays, haptic feedback systems, and motion tracking sensors that enable immersive interaction with digital content."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:xr-hardware ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "xr-device" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:human-computer-interaction ;
    vc:uses ngm:haptic-feedback,
        ngm:motion-tracking .

ngm:3-d-content-pipeline a owl:Class ;
    rdfs:label "3D Content Pipeline"@en ;
    rdfs:comment "The comprehensive workflows, tools, and methodologies for creating, processing, optimising, and delivering three-dimensional assets for metaverse and spatial computing applications. A 3D content pipeline spans concept art, geometry modelling, UV mapping, PBR texturing, rigging, LOD generation, and platform-specific optimisation, integrating DCC tools, game engines, version control, and CI/CD systems to support distributed teams and continuous asset delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:artificial-intelligence-assisted-art,
        ngm:cloud-computing ;
    vc:contrastsWith ngm:2-d-content-pipeline ;
    vc:dependsOn ngm:asset-management-system,
        ngm:ci-cd-pipeline ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:procedural-generation,
        ngm:real-time-rendering,
        ngm:xr-content-delivery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-animation,
        ngm:3-d-asset,
        ngm:level-of-detail,
        ngm:pbr-texturing,
        ngm:rendering-pipeline,
        ngm:rigging-and-skinning ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-generation,
        ngm:digital-twin ;
    vc:requires ngm:digital-content-creation-tools,
        ngm:game-engine,
        ngm:version-control-system ;
    vc:slug "3-d-content-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
        ngm:universal-scene-description ;
    vc:supports ngm:continuous-asset-delivery,
        ngm:distributed-team-collaboration ;
    vc:uses ngm:geometry-processing,
        ngm:physically-based-rendering .

ngm:3-d-rendering a owl:Class ;
    rdfs:label "3D Rendering"@en ;
    rdfs:comment "3D rendering is the computational process of generating a two-dimensional image or animation from a three-dimensional scene description by simulating the interaction of light with surfaces, materials, and geometry. It encompasses techniques ranging from real-time rasterization used in interactive applications to physically-based ray tracing and path tracing used for photorealistic offline production. The pipeline converts geometric primitives, shader programs, texture maps, and lighting data into final pixel colours via a GPU compute pipeline or software renderer. Contemporary rendering also incorporates neural methods such as Neural Radiance Fields and 3D Gaussian Splatting, as well as AI-driven upscaling and denoising, blurring the boundary between classical computer graphics and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:3-d-gaussian-splatting,
        ngm:differentiable-rendering,
        ngm:generative-3-d,
        ngm:neural-radiance-field ;
    vc:dependsOn ngm:3-d-rendering-engine,
        ngm:linear-algebra ;
    vc:enables ngm:augmented-reality,
        ngm:foveated-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering,
        ngm:real-time-graphics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:path-tracing,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:ray-tracing,
        ngm:render-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-aliasing,
        ngm:global-illumination,
        ngm:level-of-detail,
        ngm:spatial-computing ;
    vc:requires ngm:depth-buffer,
        ngm:graphics-processing-unit,
        ngm:lighting-model ;
    vc:slug "3-d-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-model,
        ngm:gpu-compute,
        ngm:scene-graph,
        ngm:shader-programming,
        ngm:texture-mapping .

ngm:3-d-scanning a owl:Class ;
    rdfs:label "3D Scanning"@en ;
    rdfs:comment "3D Scanning is the process of capturing the three-dimensional shape, and optionally the colour and texture, of real-world objects, people, or environments using hardware such as structured-light scanners, time-of-flight LiDAR, photogrammetry rigs, or depth cameras, producing digital point clouds or meshes that represent the physical source. The resulting data feeds into digital preservation, reverse engineering, visual-effects production, quality inspection, and spatial computing pipelines. Accuracy, resolution, and scan volume are the primary quality axes that distinguish scanning technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        ngm:3-d-reconstruction ;
    vc:bridgesTo ngm:medical-imaging,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:neural-radiance-field,
        ngm:structure-from-motion ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:digital-twin-creation,
        ngm:heritage-digitisation,
        ngm:point-cloud-processing,
        ngm:reverse-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mesh-generation,
        ngm:point-cloud,
        ngm:scan-registration ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-perception,
        ngm:gaussian-splatting,
        ngm:simultaneous-localisation-and-mapping ;
    vc:requires ngm:calibration,
        ngm:depth-sensor ;
    vc:slug "3-d-scanning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:building-information-modelling,
        ngm:quality-inspection ;
    vc:uses ngm:3-d-li-dar,
        ngm:photogrammetry,
        ngm:structured-light,
        ngm:time-of-flight-sensor .

ngm:aave a owl:Class ;
    rdfs:label "Aave"@en ;
    rdfs:comment "Aave is a decentralised, non-custodial liquidity protocol deployed on Ethereum and multiple EVM-compatible networks that allows users to supply crypto assets into pooled reserves to earn algorithmically set interest, and to borrow against over-collateralised positions at variable or stable rates. Pioneered by Stani Kulechov and launched as ETHLend in 2017 before rebranding in 2020, it introduced the flash loan — an uncollateralised loan that must be atomically repaid within a single transaction block — as a foundational DeFi primitive. Governance is exercised by AAVE token holders who vote on Aave Improvement Proposals controlling risk parameters, supported asset listings, protocol upgrades, and treasury allocations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:ai-driven-trading,
        ngm:risk-modelling ;
    vc:contrastsWith ngm:compound-protocol,
        ngm:makerdao,
        ngm:traditional-finance ;
    vc:enables ngm:collateralised-borrowing,
        ngm:flash-loan,
        ngm:on-chain-arbitrage,
        ngm:self-liquidation,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:algorithmic-interest-rate,
        ngm:atoken,
        ngm:on-chain-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:gho-stablecoin,
        ngm:liquidation-mechanism,
        ngm:stablecoin,
        ngm:token-governance ;
    vc:requires ngm:ethereum-wallet,
        ngm:oracle,
        ngm:over-collateralisation ;
    vc:slug "aave" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:chainlink,
        ngm:ethereum,
        ngm:evm,
        ngm:liquidity-pool,
        ngm:smart-contracts .

ngm:accountability-mechanism a owl:Class ;
    rdfs:label "Accountability Mechanism"@en ;
    rdfs:comment "An accountability mechanism is a specific procedural, technical, or institutional instrument through which an actor can be held answerable for their decisions and conduct—for example, an audit trail, an ombudsman process, an algorithmic impact assessment, or a public reporting obligation. Whereas an accountability framework defines the overall structure of responsibility, an accountability mechanism is the concrete tool that makes accountability operational within or across that framework."@en ;
    rdfs:subClassOf ngm:accountability ;
    vc:enables ngm:compliance,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:accountability-framework ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
        ngm:regulatory-framework ;
    vc:slug "accountability-mechanism" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit-log,
        ngm:audit-trail .

ngm:action-space a owl:Class ;
    rdfs:label "Action Space"@en ;
    rdfs:comment "The action space in reinforcement learning and control theory is the complete set of actions available to an agent at any given decision step, defining the boundaries of what the agent may do when interacting with its environment. It may be discrete—a finite enumeration of choices—or continuous—a real-valued manifold such as joint torques or steering angles—and its structure fundamentally determines which learning algorithms are applicable and how efficiently a policy can be discovered."@en ;
    rdfs:subClassOf ngm:state-space ;
    vc:dependsOn ngm:environment-model ;
    vc:enables ngm:policy-optimisation,
        ngm:reinforcement-learning-algorithm ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning,
        ngm:reward-function ;
    vc:slug "action-space" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:reinforcement-learning-for-robotics .

ngm:adapter-modules a owl:Class ;
    rdfs:label "Adapter Modules"@en ;
    rdfs:comment "Adapter Modules are compact bottleneck neural network sub-networks inserted between frozen transformer layers, trained exclusively on task-specific data whilst leaving the base model unchanged. They typically comprise a down-projection, a non-linearity, and an up-projection with a residual connection, constituting under 1% of model parameters and enabling efficient multi-task deployment from a single frozen base model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:prefix-tuning,
        ngm:prompt-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:fine-tuning ;
    vc:slug "adapter-modules" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network-layer,
        ngm:transfer-learning .

ngm:agent-event-stream a owl:Class ;
    rdfs:label "Agent Event Stream"@en ;
    rdfs:comment "A real-time telemetry stream (surface S6) that emits ActivityStream|ActivityStreams-based JSON-LD events for agent lifecycle events (birth, startup, activity, completion, error, termination) via WebSocket, Nostr relay, or message queue, enabling external monitoring systems, dashboards, and or..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-ld-1-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-emission ],
        ngm:ai-infrastructure ;
    vc:enables ngm:anomaly-detection,
        ngm:automated-alerting,
        ngm:fleet-observability,
        ngm:real-time-monitoring,
        ngm:work-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-emission,
        ngm:event-filtering,
        ngm:event-indexing,
        ngm:event-subscription,
        ngm:real-time-streaming ;
    vc:implements ngm:activity-streams-2-0,
        ngm:json-data-interchange-format-ld-1-1,
        ngm:w3-c-event-streams ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:requires ngm:activity-streams-vocabulary,
        ngm:event-schemas,
        ngm:json-data-interchange-format-ld-1-1,
        ngm:web-socket-support ;
    vc:slug "agent-event-stream" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-augmented-software-engineering a owl:Class ;
    rdfs:label "AI-Augmented Software Engineering"@en ;
    rdfs:comment "AI-Augmented Software Engineering is the practice of integrating artificial intelligence tools and techniques — including large language models, code generation systems, and agentic AI — into the software development lifecycle to accelerate coding, testing, review, and deployment. It encompasses AI-assisted code completion, automated test generation, intelligent refactoring, and documentation synthesis, transforming how software teams design, build, and maintain systems at scale."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:rapid-ai-deployment,
        ngm:software-development-process,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline,
        ngm:software-architecture,
        ngm:software-engineering,
        ngm:software-testing ;
    vc:slug "ai-augmented-software-engineering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agentic-ai,
        ngm:code-generation,
        ngm:large-language-models .

ngm:ai-operator a owl:Class ;
    rdfs:label "AI Operator"@en ;
    rdfs:comment "An individual or organisational entity responsible for the operational management, monitoring, and control of an artificial intelligence system during its deployment and use, including activities such as configuring system parameters, overseeing system performance, responding to incidents, coordi..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-deployment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:competence-development,
        ngm:ongoing-support,
        ngm:training ;
    vc:slug "ai-operator" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-system a owl:Class ;
    rdfs:label "AI System"@en ;
    rdfs:comment "An integrated assembly of software, hardware, data, and processes that employs machine learning or related techniques to perceive inputs, infer patterns or decisions, and produce outputs that affect its environment or users. AI systems range from narrow task-specific classifiers to general-purpose language models and autonomous agents, and they are characterised by behaviour that emerges from learned parameters rather than explicit programming. Regulatory definitions such as that codified in the EU AI Act emphasise the system-level perspective, encompassing the full sociotechnical context of deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:sociotechnical-system ;
    vc:bridgesTo ngm:digital-infrastructure,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:conventional-software,
        ngm:rule-based-system ;
    vc:dependsOn ngm:data-governance,
        ngm:mlops,
        ngm:model-serving ;
    vc:enables ngm:ai-risk-assessment,
        ngm:autonomous-decision-making,
        ngm:intelligent-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-inference,
        ngm:ai-model,
        ngm:data-pipeline,
        ngm:inference-runtime,
        ngm:monitoring-instrumentation ;
    vc:implements ngm:machine-learning-algorithm ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-system-eu-definition,
        ngm:edge-ai-system,
        ngm:multi-agent-system ;
    vc:requires ngm:compute-infrastructure,
        ngm:machine-learning-framework,
        ngm:training-data ;
    vc:slug "ai-system" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:iso-iec-42001 ;
    vc:supports ngm:ai-governance,
        ngm:explainability .

ngm:algorithmic-trading a skos:Concept ;
    rdfs:label "Algorithmic Trading"@en .

ngm:ambient-occlusion a owl:Class ;
    rdfs:label "Ambient Occlusion"@en ;
    rdfs:comment "A shading and rendering technique that approximates the degree to which each point on a surface is occluded from ambient environmental light by surrounding geometry, producing soft shadows in crevices, corners, and contact areas that significantly enhance the perception of three-dimensional form and material grounding. Unlike direct illumination algorithms, ambient occlusion is view-independent and operates on the assumption that ambient light arrives uniformly from all directions, making it computationally tractable as either a pre-baked texture or a real-time screen-space approximation. It is a foundational element of physically plausible rendering pipelines."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:enables ngm:photorealistic-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ar-occlusion,
        ngm:dynamic-lighting,
        ngm:occlusion-culling ;
    vc:slug "ambient-occlusion" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physically-based-rendering,
        ngm:ray-tracing .

ngm:animation-technique a owl:Class ;
    rdfs:label "Animation Technique"@en ;
    rdfs:comment "An Animation Technique is a method or algorithm for generating the illusion of motion in digital content, encompassing keyframe interpolation, skeletal rigging, physics-based simulation, and procedural approaches. Animation techniques are fundamental to character representation, environmental dynamics, and interactive responsiveness in spatial computing environments."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:animation-retargeting,
        ngm:rendering-technique ;
    vc:slug "animation-technique" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:game-engine ;
    vc:uses ngm:motion-capture,
        ngm:physics-simulation .

ngm:anthropic a owl:Class ;
    rdfs:label "Anthropic"@en ;
    rdfs:comment "Anthropic is a frontier AI safety company founded in 2021 by Dario Amodei, Daniela Amodei, and colleagues formerly at OpenAI, whose primary mission is the responsible development and maintenance of advanced AI for the long-term benefit of humanity. The company develops and deploys the Claude family of large language models, distinguished by a Constitutional AI training methodology that uses AI self-critique and revision against explicit principles to systematically reduce harmful outputs. Anthropic's research agenda spans mechanistic interpretability, scalable oversight, red-teaming, and the Responsible Scaling Policy — a formal commitment tying capability advancement to mandatory safety evaluations at defined dangerous-capability thresholds. As a public-benefit corporation, Anthropic occupies a distinctive position among frontier AI laboratories by integrating commercial model deployment with open publication of alignment and interpretability research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:responsible-scaling-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanistic-interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constitutional-ai-training-methodology ],
        ngm:ai-safety-research ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:model-cards ;
    vc:contrastsWith ngm:google-deepmind,
        ngm:meta-ai,
        ngm:openai ;
    vc:enables ngm:agentic-ai,
        ngm:claude-model-family,
        ngm:model-api ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constitutional-ai-training-methodology,
        ngm:mechanistic-interpretability,
        ngm:responsible-scaling-policy ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-and-ethics,
        ngm:ai-safety-evaluation,
        ngm:frontier-ai,
        ngm:interpretability,
        ngm:superposition-hypothesis ;
    vc:slug "anthropic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-governance,
        ngm:scalable-oversight ;
    vc:uses ngm:large-language-models,
        ngm:red-teaming,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transformer-architecture .

ngm:asset-management-system a owl:Class ;
    rdfs:label "Asset Management System"@en ;
    rdfs:comment "An Asset Management System (AMS) is an integrated software platform that tracks, manages, and optimises the lifecycle of physical, digital, or financial assets across an organisation. It consolidates asset data including acquisition, depreciation, maintenance, and disposal into a single governed repository. Modern AMS platforms enforce audit trails, automate compliance reporting, and feed into enterprise resource planning (ERP) and financial systems. They enable organisations to reduce total cost of ownership, mitigate risk, and demonstrate regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-management ],
        ngm:asset-management ;
    vc:enables ngm:compliance-audit-trail,
        ngm:compliance-monitoring,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-asset-management,
        ngm:monitoring-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:digital-twin,
        ngm:supply-chain-management ;
    vc:slug "asset-management-system" ;
    vc:sourceDomain "infrastructure" .

ngm:avatar-standard a owl:Class ;
    rdfs:label "Avatar Standard"@en ;
    rdfs:comment "Avatar Standard refers to technical specifications defining file formats, data structures, rigging conventions, and metadata schemas for 3D humanoid avatars, particularly the VRM format built on glTF 2.0 that enables cross-platform avatar interoperability in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:format-compliance ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:technical-standard ;
    vc:enables ngm:avatar-interoperability,
        ngm:platform-independent-identities,
        ngm:standardized-rigging ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:format-compliance,
        ngm:metadata-specification,
        ngm:skeleton-configuration ;
    vc:slug "avatar-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:biosecurity a owl:Class ;
    rdfs:label "Biosecurity"@en ;
    rdfs:comment "Biosecurity is the set of policies, practices, and controls aimed at preventing the accidental or deliberate misuse of biological agents, including pathogens, toxins, and biotechnology. It spans laboratory containment, pathogen access controls, dual-use research oversight, and increasingly the governance of AI tools that could lower barriers to engineering dangerous organisms. As a field, it is central to mitigating biological existential and catastrophic risks."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bio-terror,
        ngm:existential-risk ;
    vc:slug "biosecurity" ;
    vc:sourceDomain "governance" .

ngm:bip-341 a owl:Class ;
    rdfs:label "BIP-341"@en ;
    rdfs:comment "BIP-341 is the Bitcoin Improvement Proposal that specifies the Taproot upgrade, introducing Pay-to-Taproot (P2TR) as a native SegWit version 1 output type that unifies key-path and script-path spending under a single Schnorr-based commitment. It integrates Merklised Alternative Script Trees (MAST) so that only the executed spending branch is revealed on-chain, preserving the privacy of unexplored script conditions. BIP-341 activated on the Bitcoin mainnet at block 709,632 in November 2021 via the Speedy Trial soft-fork mechanism, requiring 90% miner signalling. It forms part of the Taproot bundle alongside BIP-340 (Schnorr signatures for Bitcoin) and BIP-342 (Tapscript), collectively the largest upgrade to Bitcoin's scripting system since SegWit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-340 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-342 ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:smart-contract,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ecdsa-signature,
        ngm:pay-to-script-hash ;
    vc:dependsOn ngm:bitcoin-consensus,
        ngm:utxo-model ;
    vc:enables ngm:bitcoin-script,
        ngm:bitcoin-smart-contracts,
        ngm:lightning-network,
        ngm:multisignature,
        ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:merklised-alternative-script-tree,
        ngm:pay-to-taproot ;
    vc:isPartOf ngm:bitcoin-soft-fork,
        ngm:taproot-upgrade ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-core,
        ngm:bitcoin-fungibility,
        ngm:bitcoin-proof-of-work-protocol-network,
        ngm:coinjoin ;
    vc:requires ngm:bip-340,
        ngm:bip-342,
        ngm:segwit ;
    vc:slug "bip-341" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-improvement-proposals ;
    vc:uses ngm:cryptographic-commitment,
        ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:schnorr-signature,
        ngm:tagged-hash .

ngm:bip-342 a owl:Class ;
    rdfs:label "BIP-342"@en ;
    rdfs:comment "BIP-342 specifies Tapscript, the updated Bitcoin scripting language that replaces legacy script in the script-path spending branch of Taproot (BIP-341) outputs. Tapscript updates the signature opcodes to use BIP-340 Schnorr signatures, introduces the OP_CHECKSIGADD opcode to enable efficient threshold multisignature constructions, relaxes script resource limits, and establishes an extensible opcode upgrade mechanism via OP_SUCCESS opcodes for future soft forks."@en ;
    rdfs:subClassOf ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:enables ngm:multisignature,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-327,
        ngm:bip-340-schnorr-keypair ;
    vc:slug "bip-342" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-script,
        ngm:schnorr-signature .

ngm:bitcoin-protocol a owl:Class ;
    rdfs:label "Bitcoin Protocol"@en ;
    rdfs:comment "The set of rules governing how Bitcoin transactions are formed, validated, and ordered into blocks by proof-of-work consensus, including the UTXO model, scripting system, block reward schedule, and difficulty adjustment mechanism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
