ngm:ne-rf a owl:Class ;
    rdfs:label "NeRF"@en ;
    rdfs:comment "Neural Radiance Field (NeRF) is a neural scene representation technique that encodes a continuous volumetric scene as a multi-layer perceptron mapping 3D coordinates and viewing directions to colour and density values, enabling photorealistic novel view synthesis from a sparse set of calibrated input images. Introduced by Mildenhall et al. at ECCV 2020, NeRF employs volumetric ray marching and differentiable rendering to optimise network weights via photometric loss against held-out views, without requiring explicit mesh or voxel geometry. The technique catalysed a broad family of neural rendering methods spanning real-time variants, dynamic scenes, large-scale outdoor capture, and hybrid neural-explicit representations such as 3D Gaussian Splatting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:diffusion-model,
        ngm:metaverse,
        ngm:robotics-navigation ;
    vc:contrastsWith ngm:3-d-gaussian-splatting,
        ngm:photogrammetry,
        ngm:point-cloud,
        ngm:polygon-mesh ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin,
        ngm:novel-view-synthesis,
        ngm:photorealistic-rendering,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:structure-from-motion,
        ngm:volumetric-capture ;
    vc:requires ngm:camera-calibration,
        ngm:gpu-compute,
        ngm:multi-view-imagery ;
    vc:slug "ne-rf" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:differentiable-rendering,
        ngm:multilayer-perceptron,
        ngm:positional-encoding,
        ngm:volumetric-ray-marching .

ngm:near-field-communication a owl:Class ;
    rdfs:label "Near Field Communication"@en ;
    rdfs:comment "Near Field Communication (NFC) is a short-range wireless communication technology operating at 13.56 MHz that enables contactless data exchange between devices within approximately 4 centimetres. Based on inductive coupling and derived from RFID standards, NFC supports three operating modes: card emulation (device acts as a smart card), reader/writer (device reads or writes NFC tags), and peer-to-peer (two active devices exchange data). It underpins contactless payments, identity verification, and rapid device pairing."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:access-control-system,
        ngm:digital-payment-system,
        ngm:digital-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-interface,
        ngm:embedded-systems,
        ngm:io-t-sensor-network ;
    vc:slug "near-field-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hardware-security-module .

ngm:network-performance-metrics a owl:Class ;
    rdfs:label "Network Performance Metrics"@en ;
    rdfs:comment "Network Performance Metrics are quantitative measures used to characterise the operational quality of a communication network, encompassing latency, throughput, packet loss rate, jitter, and availability. These metrics are collected continuously from network devices, links, and endpoints to support quality-of-service enforcement, capacity planning, fault detection, and SLA compliance verification. They underpin all layers of network management from physical links to application-level experience."@en ;
    rdfs:subClassOf ngm:quality-of-service ;
    vc:enables ngm:latency-aware-edge-ai ;
