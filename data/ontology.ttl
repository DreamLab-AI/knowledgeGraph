ngm:3-d-scene-exchange-protocol-sxp a owl:Class ;
    rdfs:label "3D Scene Exchange Protocol (SXP)"@en ;
    rdfs:comment "Open standards framework enabling interoperable transfer of complete 3D scene graphs including geometric meshes (polygon topology vertex positions normals texture coordinates with indexed triangle lists optimized for GPU rendering), physically-based rendering (PBR) material systems (metallic-roug..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:3-d-asset-interchange,
        ngm:ar-vr-experiences,
        ngm:asset-portability,
        ngm:collaborative-workflows,
        ngm:cross-platform-compatibility,
        ngm:e-commerce-3-d,
        ngm:metaverse-interoperability,
        ngm:real-time-rendering,
        ngm:web-3-d-visualization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:animation-rig,
        ngm:camera-definition,
        ngm:geometric-mesh,
        ngm:lighting-environment,
        ngm:lod-specification,
        ngm:material-system,
        ngm:normal-map,
        ngm:pbr-workflow,
        ngm:polygon-topology,
        ngm:scene-hierarchy,
        ngm:skeletal-bone,
        ngm:texture-map,
        ngm:uv-coordinate,
        ngm:vertex-attribute ;
    vc:implements ngm:extension-mechanism,
        ngm:mesh-lod,
        ngm:non-destructive-editing,
        ngm:pbr-materials,
        ngm:progressive-loading,
        ngm:scene-composition,
        ngm:scene-graph-format,
        ngm:skeletal-animation,
        ngm:version-control ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-modeling-software,
        ngm:animation-tools,
        ngm:game-engine,
        ngm:material-converter,
        ngm:mesh-compression,
        ngm:rendering-pipeline,
        ngm:scene-validator,
        ngm:texture-authoring ;
    vc:slug "3-d-scene-exchange-protocol-sxp" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-user-interface a owl:Class ;
    rdfs:label "3D User Interface"@en ;
    rdfs:comment "A 3D User Interface (3DUI) is an interactive control system within three-dimensional virtual environments enabling users to manipulate objects, navigate spaces, and access functionality through spatial gestures, hand tracking, gaze-based selection, and voice commands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hand-tracking ],
        ngm:interaction-design,
        ngm:sc-interaction,
        ngm:user-interface ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:accessible-immersion,
        ngm:intuitive-interaction,
        ngm:user-navigation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:gaze-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:voice-input ;
    vc:slug "3-d-user-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:6-g-network-slice a owl:Class ;
    rdfs:label "6G Network Slice"@en ;
    rdfs:comment "Virtual partition of 6G infrastructure guaranteeing specified quality-of-service levels for immersive workloads through isolated resource allocation."@en ;
