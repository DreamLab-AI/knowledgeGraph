ngm:cognitive-ai a owl:Class ;
    rdfs:label "Cognitive AI"@en ;
    rdfs:comment "Cognitive AI is the family of artificial-intelligence systems built around cognitively-plausible architectures that explicitly model the components and information-flow of human cognition — working memory, declarative and procedural long-term memory, perception-action loops, attention, production..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conflict-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:ai-research-area,
        ngm:hybrid-ai,
        ngm:neurosymbolic-ai ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:cognitive-modelling,
        ngm:continual-learning,
        ngm:decision-support-system,
        ngm:explainable-reasoning,
        ngm:human-machine-teaming,
        ngm:intelligent-tutoring-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chunking-mechanism,
        ngm:declarative-memory,
        ngm:goal-stack,
        ngm:metacognitive-controller,
        ngm:motor-module,
        ngm:perception-module,
        ngm:procedural-memory,
