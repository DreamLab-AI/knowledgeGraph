            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-market-maker ],
        ngm:bc-defi-and-economics,
        ngm:smart-contract ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:decentralized-trading,
