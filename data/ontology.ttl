    vc:sourceDomain "robotics" .

ngm:rb-0066-robot-sensor a owl:Class ;
    rdfs:label "rb 0066 robot sensor"@en ;
    rdfs:comment "A robot sensor is a transducer or measurement device integrated into or used by a robot system to acquire information about the robot's own state or its surrounding environment. Robot sensors span proprioceptive types — such as encoders, IMUs, and force-torque sensors — and exteroceptive types such as vision systems, LiDAR, radar, and proximity sensors. The data they provide forms the perceptual basis for control, motion planning, and safety functions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0073-imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0069-lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0068-vision-system ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:sensor ;
    vc:enables ngm:rb-0052-collision-avoidance,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0067-force-torque-sensor,
        ngm:rb-0068-vision-system,
        ngm:rb-0069-lidar,
        ngm:rb-0072-encoder,
        ngm:rb-0073-imu ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:slug "rb-0066-robot-sensor" ;
    vc:sourceDomain "robotics" .

ngm:real-time-inference a owl:Class ;
    rdfs:label "Real-Time Inference"@en ;
    rdfs:comment "Real-time inference is the execution of a trained machine-learning model to produce predictions within strict, low-latency time bounds suitable for interactive or streaming applications. It demands optimised serving infrastructure, efficient model formats, and often hardware acceleration to meet sub-second or millisecond response targets. Real-time inference enables responsive AI features such as recommendations, fraud scoring, and perception in autonomous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:low-latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-acceleration ],
        ngm:model-serving ;
    vc:bridgesTo ngm:edge-ai ;
    vc:contrastsWith ngm:edge-computing ;
    vc:dependsOn ngm:inference,
        ngm:model-deployment ;
    vc:enables ngm:edge-ai,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inference-engine ;
    vc:implements ngm:inference ;
    vc:isPartOf ngm:model-serving ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-serving,
        ngm:real-time-processing ;
    vc:requires ngm:gpu-acceleration,
        ngm:low-latency ;
    vc:slug "real-time-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:on-device-inference,
        ngm:stream-processing ;
    vc:uses ngm:model-optimization,
        ngm:onnx .

ngm:real-time-rendering-pipeline a owl:Class ;
    rdfs:label "Real-Time Rendering Pipeline"@en ;
    rdfs:comment "Sequence of GPU processes converting 3D scene data into visual frames at interactive rates (typically 30-120+ FPS)."@en ;
