    vc:relatedTo ngm:collaborative-robot,
        ngm:delta-robot,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:trajectory-planning ;
    vc:slug "scara-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:encoder,
        ngm:pid-control,
        ngm:servo-motor .

ngm:script a owl:Class ;
    rdfs:label "Script"@en ;
    rdfs:comment "Bitcoin's stack-based, non-Turing-complete scripting language used to encode spending conditions on transaction outputs and to provide the corresponding unlocking data in transaction inputs. Script programs define locking and unlocking conditions—such as pay-to-public-key-hash—that a validator executes to authorise fund transfer, making transaction validation a programmable process without full smart-contract complexity."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:smart-contract,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:digital-signature,
        ngm:transaction-fee,
        ngm:transaction-pool ;
    vc:slug "script" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:opcodes,
        ngm:transaction,
        ngm:utxo-model .

ngm:sd-jwt a owl:Class ;
    rdfs:label "SD-JWT"@en ;
    rdfs:comment "SD-JWT (Selective Disclosure JSON Web Token) is an IETF-specified extension to the JSON Web Token standard that allows an Issuer to create a signed token containing hashed claim values, from which the Holder can selectively reveal only the specific claims needed for a given presentation — without exposing other claims or enabling correlation across presentations. The mechanism uses SHA-256 salted disclosure objects appended to the base JWT; verifiers can validate revealed disclosures against the issuer signature whilst remaining blind to undisclosed claims. SD-JWT forms the primary credential format for the European Union's eIDAS 2.0 digital identity wallet system."@en ;
    rdfs:subClassOf ngm:selective-disclosure ;
    vc:enables ngm:credential-verification,
        ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:open-id4-vci,
        ngm:zero-knowledge-proof ;
    vc:slug "sd-jwt" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:cryptographic-proof,
        ngm:json-web-token,
        ngm:verifiable-credentials .

ngm:secure-communication a owl:Class ;
    rdfs:label "Secure Communication"@en ;
    rdfs:comment "Secure communication is the practice and set of technologies that protect the confidentiality, integrity, and authenticity of information exchanged between parties over potentially adversarial networks, ensuring that eavesdroppers cannot read message content, tamperers cannot alter it undetected, and impersonators cannot forge the identity of legitimate participants. The discipline encompasses transport-layer security protocols (TLS, DTLS, QUIC with TLS), end-to-end encryption protocols (Signal Protocol, MLS, Matrix), secure messaging standards (S/MIME, PGP), VPN tunnelling (IPsec, WireGuard), and the cryptographic primitives—asymmetric key exchange, symmetric cipher suites, authenticated encryption, and digital signatures—that underpin them. Security properties are formally analysed through cryptographic protocol proofs and verified implementations."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:confidential-computing,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-security,
        ngm:network-security,
        ngm:tls-encryption ;
    vc:slug "secure-communication" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-key-management,
        ngm:digital-signature,
        ngm:encryption,
        ngm:tls .

ngm:securities-settlement a owl:Class ;
    rdfs:label "Securities Settlement"@en ;
    rdfs:comment "Securities settlement is the process by which the buyer of a security receives the asset and the seller receives payment, completing a trade through the final transfer of legal ownership and funds between counterparties, typically via a central securities depository (CSD) or clearing house. Traditional settlement occurs on a T+1 or T+2 basis after trade execution, involves complex chains of custodians, CSDs, and central counterparty clearing houses (CCPs), and carries counterparty risk during the settlement window. Distributed ledger technology and tokenised securities are driving a shift toward atomic and real-time settlement."@en ;
    rdfs:subClassOf ngm:financial-system ;
    vc:enables ngm:digital-asset-trading,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-settlement,
        ngm:instant-value-settlement,
        ngm:securities-regulation ;
    vc:slug "securities-settlement" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:digital-asset-infrastructure,
        ngm:financial-infrastructure .

ngm:series-elastic-actuator a owl:Class ;
    rdfs:label "Series Elastic Actuator"@en ;
    rdfs:comment "A Series Elastic Actuator (SEA) is a robotic joint mechanism that interposes a compliant spring element in series between the gearbox output and the load, deliberately introducing controlled elasticity into the drivetrain. By measuring the spring deflection with a position sensor, the SEA provides accurate, low-noise torque measurement without a dedicated force-torque sensor, while simultaneously providing passive mechanical compliance that absorbs impact energy and reduces stiffness at the point of contact. This architecture enables safe, backdrivable interactions between robots and humans or unstructured environments."@en ;
    rdfs:subClassOf ngm:robot-actuator ;
    vc:enables ngm:human-robot-interaction,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:impedance-control,
        ngm:series-elastic-actuation,
        ngm:variable-impedance-control ;
    vc:slug "series-elastic-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:position-sensor,
        ngm:torque-control .

ngm:sharding a owl:Class ;
    rdfs:label "Sharding"@en ;
    rdfs:comment "Sharding is a horizontal partitioning technique for distributed databases and blockchain networks in which a dataset or workload is divided into disjoint subsets called shards, each maintained by a distinct subset of nodes, so that the total system throughput scales with the number of shards rather than being bounded by the capacity of a single node. In databases, sharding routes queries to the appropriate shard by a sharding key. In blockchain, each shard processes its own subset of transactions and stores its own portion of the state, with cross-shard communication handled by a coordination layer. Sharding dramatically increases transaction throughput and reduces storage requirements per node at the cost of increased architectural complexity and cross-shard coordination overhead."@en ;
    rdfs:subClassOf ngm:blockchain-scalability ;
    vc:enables ngm:blockchain-network,
        ngm:distributed-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:distributed-data-structure,
        ngm:distributed-system,
        ngm:layer-2-scaling ;
    vc:slug "sharding" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:distributed-hash-table .

ngm:social-interaction a owl:Class ;
    rdfs:label "Social Interaction"@en ;
    rdfs:comment "Social Interaction refers to the dynamic process by which two or more agents — human or artificial — mutually influence one another's behaviour, cognition, and emotional states through communicative acts, physical co-presence, or mediated channels. It is the fundamental unit of social life, encompassing verbal conversation, nonverbal signals, turn-taking, joint attention, empathic responsiveness, and negotiation of shared meaning. In the context of digital and AI systems, social interaction extends to human-computer interfaces, social robotics, virtual environments, and AI-mediated communication platforms, where the design of interaction modalities profoundly shapes social outcomes and wellbeing."@en ;
    rdfs:subClassOf ngm:interaction-domain ;
    vc:enables ngm:conversational-ai,
        ngm:emotion-aware-interaction,
        ngm:social-network-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:human-robot-interaction,
        ngm:social-presence ;
    vc:slug "social-interaction" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:emotional-intelligence,
        ngm:natural-interaction,
        ngm:proxemics .

ngm:social-network-graph a owl:Class ;
    rdfs:label "Social Network Graph"@en ;
    rdfs:comment "A graph-theoretic representation of social relationships in which nodes denote individuals or entities and edges encode interactions, follows, or trust links. Social network graphs underpin recommendation systems, community detection, influence analysis, and decentralised identity federation protocols such as Nostr and ActivityPub."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:identity-federation,
        ngm:virtual-community-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:knowledge-graph ;
    vc:slug "social-network-graph" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-identity,
        ngm:nostr-protocol .

ngm:software-infrastructure a owl:Class ;
    rdfs:label "Software Infrastructure"@en ;
    rdfs:comment "Software Infrastructure comprises the foundational software layers — including operating systems, middleware, APIs, frameworks, and runtime environments — that underpin applications and services without being directly user-facing. It provides the shared services, communication channels, and execution contexts on which higher-level metaverse, AI, and distributed-systems applications are built, analogous to the role that physical infrastructure plays for built environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:microservices-architecture,
        ngm:serverless-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-gateway,
        ngm:middleware,
        ngm:software-architecture ;
    vc:isPartOf ngm:digital-infrastructure ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "software-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:software-platform a owl:Class ;
    rdfs:label "Software Platform"@en ;
    rdfs:comment "An integrated technology foundation providing common services, APIs, and infrastructure for developing, deploying, and running applications, including cloud-native platforms, container orchestration systems, and internal developer platforms that abstract underlying complexity while enabling scala..."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:technology-infrastructure ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:application-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "software-platform" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-computing-layer a owl:Class ;
    rdfs:label "Spatial Computing Layer"@en ;
    rdfs:comment "Computational layer linking digital and physical spaces through 3D mapping and context-aware processing for spatial awareness and interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-anchors ],
        ngm:infrastructure-layer,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:ar-experiences,
        ngm:environmental-understanding,
        ngm:spatial-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-mapping-engine,
        ngm:localization-service,
        ngm:spatial-anchors ;
    vc:isPartOf ngm:infrastructure-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compute-resources,
        ngm:positioning-system,
        ngm:sensor-data ;
    vc:slug "spatial-computing-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-mesh a owl:Class ;
    rdfs:label "Spatial Mesh"@en ;
    rdfs:comment "A three-dimensional geometric representation of real-world environments created through spatial mapping, where surfaces are reconstructed as interconnected polygonal meshes to enable accurate placement and occlusion of virtual objects in augmented reality applications."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ar-occlusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-mesh" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking-system a owl:Class ;
    rdfs:label "Spatial Tracking System"@en ;
    rdfs:comment "Technology for determining the six-degrees-of-freedom (6DOF) position and orientation of devices, controllers, or body parts in three-dimensional space, using visual-inertial SLAM, stereo cameras, and IMU sensors for precise real-time tracking in VR, AR, and mixed reality applications."@en ;
    rdfs:subClassOf ngm:motion-tracking,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:precise-spatial-positioning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-tracking-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:speculative-decoding a owl:Class ;
    rdfs:label "Speculative Decoding"@en ;
    rdfs:comment "Speculative decoding is an LLM inference acceleration technique that exploits the observation that a smaller, faster draft model can propose plausible multi-token continuations which a larger, higher-quality target model verifies in a single parallel forward pass. Accepted tokens are committed; rejected tokens are discarded, and generation resumes from the rejection point. Because the target model evaluates multiple candidate tokens simultaneously rather than autoregressively one at a time, the effective throughput in tokens per second increases substantially—often two to four times—while the output distribution remains statistically identical to that of the target model running alone. Speculative decoding is particularly effective when the draft and target models share a vocabulary and the task distribution is predictable."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:inference-hardware ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:model-compression-for-edge ;
    vc:slug "speculative-decoding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference,
        ngm:large-language-models .

ngm:speech-synthesis a owl:Class ;
    rdfs:label "SpeechSynthesis"@en ;
    rdfs:comment "Speech synthesis, or text-to-speech (TTS), is the artificial generation of human speech from text or linguistic representations using computational models that map phonetic, prosodic, and acoustic features to waveform output. Modern neural TTS systems use end-to-end deep learning pipelines—typically a text front-end, an acoustic model (Tacotron, FastSpeech, or diffusion-based), and a neural vocoder (WaveNet, HiFi-GAN, Vocos)—to produce speech that is perceptually natural, expressive, and stylistically controllable. Speech synthesis underpins screen readers, virtual assistants, navigation systems, voice cloning tools, and interactive conversational agents, and its quality is now at or approaching human parity on standard benchmarks for many languages."@en ;
    rdfs:subClassOf ngm:text-to-speech ;
    vc:enables ngm:speech-and-voice,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:voice-cloning ;
    vc:slug "speech-synthesis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:subword-tokenisation a owl:Class ;
    rdfs:label "Subword Tokenisation"@en ;
    rdfs:comment "A tokenisation strategy that segments text into sub-word units (via algorithms such as Byte-Pair Encoding, WordPiece, or SentencePiece), balancing vocabulary size against the ability to represent rare, morphologically complex, and out-of-vocabulary words. Subword tokenisation is the de facto standard preprocessing step for large language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:natural-language-understanding ;
    vc:requires ngm:language-modeling ;
    vc:slug "subword-tokenisation" ;
    vc:sourceDomain "spatial-computing" .

ngm:supply-cap a owl:Class ;
    rdfs:label "Supply Cap"@en ;
    rdfs:comment "A Supply Cap is a hard-coded or governance-determined upper bound on the total number of tokens or coins that will ever be issued by a blockchain protocol, creating a form of programmatic scarcity that underpins deflationary monetary policy. Bitcoin's 21 million coin cap is the canonical example, encoded in the protocol's halvening schedule and providing a predictable issuance curve. Supply caps differentiate blockchain-native assets from fiat currencies and influence long-run security models, since block rewards approach zero as the cap is neared and transaction fees must compensate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:fee-market ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:bitcoin-standard,
        ngm:bitcoin-value-proposition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circulating-supply,
        ngm:cryptocurrency,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:requires ngm:block-reward,
        ngm:consensus-algorithm ;
    vc:slug "supply-cap" ;
    vc:sourceDomain "blockchain" .

ngm:system-integration a owl:Class ;
    rdfs:label "System Integration"@en ;
    rdfs:comment "System Integration is the engineering practice of combining disparate software components, services, and data sources into a coherent, functioning whole. It encompasses API design and management, middleware orchestration, event-driven messaging, ETL pipelines, and identity federation to ensure that independently developed subsystems exchange information reliably and consistently across organisational and technical boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-pipeline,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture ;
    vc:requires ngm:api-gateway,
        ngm:middleware ;
    vc:slug "system-integration" ;
    vc:sourceDomain "infrastructure" .

ngm:systemic-risk a owl:Class ;
    rdfs:label "Systemic Risk"@en ;
    rdfs:comment "Risk specific to high-impact capabilities of general-purpose AI models with significant impact on the Union market due to reach, or actual or foreseeable negative effects on public health, safety, fundamental rights, environment, democracy, or rule of law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:conformity-assessment,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:cybersecurity,
        ngm:human-oversight ;
    vc:requires ngm:adversarial-testing,
        ngm:risk-assessment ;
    vc:slug "systemic-risk" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:tactile-sensing a owl:Class ;
    rdfs:label "Tactile Sensing"@en ;
    rdfs:comment "Tactile sensing is the ability of a robotic or prosthetic system to detect and interpret physical contact information — including contact force magnitude, direction, distribution, texture, slip, and temperature — through sensors embedded in or on the surface of an end effector or robotic skin. It is the mechanical analogue of the human sense of touch and provides information that visual sensing alone cannot supply, such as the internal stress distribution of a grasped object or the onset of slippage. Tactile sensing is fundamental to dexterous manipulation, safe human-robot interaction, and feedback-controlled assembly, and has become a defining capability differentiating next-generation robotic systems from conventional industrial manipulators."@en ;
    rdfs:subClassOf ngm:perception-system ;
    vc:enables ngm:force-control,
        ngm:haptic-feedback,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:human-robot-interaction ;
    vc:slug "tactile-sensing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-torque-sensor,
        ngm:pressure-sensor,
        ngm:proprioceptive-sensor .

ngm:target-tracking a owl:Class ;
    rdfs:label "Target Tracking"@en ;
    rdfs:comment "Target tracking is a computational and signal-processing discipline concerned with estimating the state — typically position, velocity, and orientation — of one or more moving objects over time from sequences of noisy sensor observations. It encompasses algorithms such as Kalman filters, particle filters, and multi-hypothesis trackers, applied across radar, sonar, computer vision, and LiDAR modalities. Applications span aerospace surveillance, autonomous vehicle perception, robotic manipulation, sports analytics, and augmented reality. Modern deep-learning-based trackers jointly perform detection and tracking, achieving robust performance in complex, cluttered environments."@en ;
    rdfs:subClassOf ngm:object-detection-and-tracking ;
    vc:enables ngm:anomaly-detection,
        ngm:human-tracking-and-slam-capture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:motion-tracking,
        ngm:object-detection,
        ngm:sensor-fusion ;
    vc:slug "target-tracking" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:spatial-tracking-system,
        ngm:trajectory-tracking .

ngm:technology-adoption a owl:Class ;
    rdfs:label "Technology Adoption"@en ;
    rdfs:comment "The process by which individuals, organizations, and societies integrate new technologies into their workflows, practices, and systems, encompassing awareness, etrial, implementation, and sustained use across AI, blockchain, metaverse, and robotics domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:awareness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
