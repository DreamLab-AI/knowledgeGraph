    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:ModelComparison
] .

# Medical AI
artificial-intelligence:MedicalAI rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ArtificialIntelligence ;
    rdfs:subClassOf artificial-intelligence:HealthcareTechnology ;
    rdfs:label "Medical AI"@en ;
    rdfs:comment "Medical AI encompasses artificial intelligence and machine learning applications in healthcare for disease detection, diagnosis, treatment planning, and clinical decision support. As of August 2024, approximately 950 FDA-approved AI/ML medical devices exist, with the global AI healthcare market valued at USD 26.6 billion (2024) projected to reach USD 187 billion by 2030 at ~38.5% CAGR."@en ;
    skos:prefLabel "Medical AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:medical-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:medical-ai> ;
    vcw:contentHash "sha256-12-e06b6a9a995a" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-7012" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "complete" ;
    vcw:authorityScore "0.92"^^xsd:decimal ;
    dcterms:identifier "AI-7012" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "ApplicationDomain" .

artificial-intelligence:MedicalAI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:MedicalImagingAnalysis
] .

artificial-intelligence:MedicalAI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:ClinicalDecisionSupport
] .

artificial-intelligence:MedicalAI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:DrugDiscovery
] .

artificial-intelligence:MedicalAI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:PersonalizedMedicine
] .

# Neural Network Architecture
artificial-intelligence:Neuralnetworkarchitecture rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ModelArchitecture ;
    rdfs:label "Neural Network Architecture"@en ;
    rdfs:comment "Neural network architecture defines the structural organization of artificial neurons into layers and the connectivity patterns between them, determining how the network processes and transforms input data through weighted connections and activation functions. Core architecture types include feedforward networks (unidirectional flow), CNNs (convolutional layers with filters for spatial features), RNNs (recurrent connections for sequential dependencies with variants like LSTM and GRU), and transformers (self-attention mechanisms enabling parallel processing)."@en ;
    skos:prefLabel "Neural Network Architecture"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:neural-network-architecture" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:neural-network-architecture> ;
    vcw:contentHash "sha256-12-be6f269926f6" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "AI-7013" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-7013" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# AI Fairness
artificial-intelligence:AiFairness rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:AIEthics ;
    rdfs:label "AI Fairness"@en ;
    rdfs:comment "AI Fairness refers to the principle and practice of ensuring artificial intelligence systems produce equitable outcomes without bias or discrimination based on protected characteristics such as race, gender, age, or socioeconomic status. It encompasses methodologies for detecting, measuring, and mitigating algorithmic bias throughout the AI development lifecycle to prevent disproportionate harm to specific demographic groups."@en ;
    skos:prefLabel "AI Fairness"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-fairness" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-fairness> ;
    vcw:contentHash "sha256-12-95e5f00607d9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-7014" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-7014" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Principle" .

artificial-intelligence:AiFairness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:EquitableAISystems
] .

artificial-intelligence:AiFairness vcw:bridgesTo artificial-intelligence:SmartContract .

# AI Security
artificial-intelligence:AiSecurity rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:Cybersecurity ;
    rdfs:label "AI Security"@en ;
    rdfs:comment "AI Security is the field of protecting artificial intelligence systems and their components from security threats and vulnerabilities, including adversarial attacks, data poisoning, model theft, and unauthorized access to ensure systems perform as intended. It encompasses defending AI models, algorithms, training data, and infrastructure from manipulation, misuse, and exploitation throughout the AI lifecycle."@en ;
    skos:prefLabel "AI Security"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-security" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-security> ;
