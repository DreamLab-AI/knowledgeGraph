ngm:attention-mechanisms a owl:Class ;
    rdfs:label "Attention Mechanisms"@en ;
    rdfs:comment "Attention mechanisms are a family of neural network components that compute context-dependent weighted combinations of value representations by scoring the relevance of query vectors against key vectors, enabling each output position to draw selectively from any position in an input sequence — overcoming the fixed-length bottleneck of recurrent encoders. Originally introduced as additive (Bahdanau) attention for neural machine translation in 2015, they were generalised to scaled dot-product attention and multi-head attention in the 2017 Transformer architecture, where they became the sole sequence-modelling primitive, replacing recurrence entirely. Attention mechanisms now underpin virtually all frontier deep learning systems across language, vision, speech, biology, and multimodal reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scaled-dot-product-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-key-value ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-weight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-head-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:causal-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:softmax-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mask ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:attention-mechanism,
        ngm:neural-network-component ;
    vc:dependsOn ngm:deep-learning,
        ngm:feed-forward-network,
        ngm:positional-encoding ;
    vc:enables ngm:diffusion-transformer,
        ngm:graph-attention-network,
        ngm:large-language-models,
        ngm:multimodal-ai-architecture,
        ngm:transformer,
        ngm:transformer-architecture,
        ngm:vision-transformer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mask,
        ngm:attention-weight,
        ngm:causal-attention,
        ngm:cross-attention,
        ngm:multi-head-attention,
        ngm:query-key-value,
        ngm:scaled-dot-product-attention,
        ngm:self-attention ;
    vc:implements ngm:ai-model-architecture ;
    vc:qualityScore "0.93"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai,
        ngm:flash-attention,
