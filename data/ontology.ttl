ngm:gs1 a owl:Class ;
    rdfs:label "GS1"@en ;
    rdfs:comment "GS1 is the global not-for-profit standards organisation responsible for designing, administering, and maintaining the world's most widely deployed open supply chain identification system, used by over two million companies in more than 150 countries. Its core standards define globally unique identification schemes for trade items (GTIN), locations (GLN), logistic units (SSCC), and assets (GIAI), encoding them in barcodes (EAN-13, ITF-14, GS1-128), two-dimensional symbols (GS1 DataMatrix, GS1 QR), and digital web URIs via GS1 Digital Link. GS1 also governs EPCIS (Electronic Product Code Information Services), the event-data exchange standard that captures What, Where, When, Why, and How across the supply chain, and underpins regulatory traceability mandates in pharmaceuticals, food safety, and sustainable products across the EU, US, and beyond."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:barcode ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gs1-digital-link ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gs1-epcis ],
        ngm:supply-chain-management ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:verifiable-credential-vc ;
    vc:enables ngm:food-safety-blockchain,
        ngm:pharmaceutical-traceability,
        ngm:supply-chain-traceability,
        ngm:supply-chain-visibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:global-location-number,
        ngm:global-trade-item-number,
        ngm:gs1-digital-link,
        ngm:gs1-epcis,
        ngm:serial-shipping-container-code ;
    vc:implements ngm:data-interoperability,
        ngm:open-standards ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:provenance-tracking,
        ngm:supply-chain,
        ngm:supply-chain-provenance ;
    vc:requires ngm:barcode,
        ngm:electronic-data-interchange ;
    vc:slug "gs1" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:iso-standards ;
    vc:supports ngm:digital-product-passport,
        ngm:rfid .

ngm:gs1-epcis a owl:Class ;
    rdfs:label "GS1 EPCIS"@en ;
    rdfs:comment "GS1 EPCIS (Electronic Product Code Information Services) is a global standard that defines a common data model and interface for capturing and sharing supply-chain visibility events, answering what, when, where, why, and how for product movements. It standardises event-based traceability across trading partners using GS1 identifiers. EPCIS is widely deployed in pharmaceuticals, food safety, and logistics to enable end-to-end provenance."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring ;
    vc:slug "gs1-epcis" ;
    vc:sourceDomain "supply-chain" .

ngm:halving a owl:Class ;
    rdfs:label "Halving"@en ;
    rdfs:comment "A programmatic event in proof-of-work blockchains, most notably Bitcoin, whereby the block reward issued to miners is cut in half at a predetermined block height. Halvings enforce a fixed, disinflationary supply schedule that asymptotically approaches the maximum coin supply. By reducing new coin issuance, halvings create predictable scarcity and are a central component of Bitcoin's monetary policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:deflationary-token,
        ngm:fixed-supply-token,
        ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:mining-reward ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:bitcoin-proof-of-work-protocol-value-proposition,
        ngm:circulating-supply,
        ngm:difficulty-adjustment,
        ngm:incentive-alignment,
        ngm:monetary-policy-implementation,
        ngm:tokenomics ;
    vc:requires ngm:consensus-rule,
        ngm:proof-of-work ;
    vc:slug "halving" ;
    vc:sourceDomain "blockchain" .

ngm:hmac a owl:Class ;
    rdfs:label "HMAC"@en ;
    rdfs:comment "HMAC (hash-based message authentication code) is a construction that combines a cryptographic hash function with a secret key to produce a fixed-length tag verifying both the integrity and the authenticity of a message. It applies the underlying hash twice with key-derived inner and outer padding, providing security that does not depend on the hash being collision-resistant in the same way a plain hash would. HMAC is widely used to authenticate API requests, tokens, and protocol messages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sha-256 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256 ],
        ngm:cryptography ;
    vc:bridgesTo ngm:token ;
    vc:contrastsWith ngm:authorization ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:sha-256 ;
    vc:implements ngm:authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:cryptography,
        ngm:sha-256,
        ngm:tls ;
    vc:requires ngm:sha-256 ;
    vc:slug "hmac" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:authentication,
        ngm:tls ;
    vc:uses ngm:sha-256 .

ngm:hyperledger-besu a owl:Class ;
    rdfs:label "Hyperledger Besu"@en ;
    rdfs:comment "Enterprise-grade Ethereum client developed by the Hyperledger Foundation supporting both public and permissioned private blockchain deployments with pluggable consensus mechanisms including Proof of Work, Proof of Authority (Clique/IBFT), and Practical Byzantine Fault Tolerance (PBFT). Besu provides full EVM compatibility, privacy extensions via private transaction groups, permissioning, and a JSON-RPC/WebSocket API surface, making it suitable for enterprise consortia, regulated financial networks, and cross-chain interoperability scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:bc-network-component ;
