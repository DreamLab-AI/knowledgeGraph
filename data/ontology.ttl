ngm:wireless-connectivity a owl:Class ;
    rdfs:comment "Wireless connectivity is the transmission of data between devices over radio frequencies without physical cabling. It encompasses short-range links such as Wi-Fi and Bluetooth, medium-range technologies such as Zigbee and LoRa, and wide-area mobile networks such as 4G LTE and 5G NR, all governed by spectrum allocation and standardised protocol stacks."@en ;
    rdfs:label "Wireless Connectivity"@en ;
