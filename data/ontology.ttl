ngm:market-surveillance a owl:Class ;
    rdfs:label "Market Surveillance"@en ;
    rdfs:comment "Market surveillance is the ongoing monitoring of trading venues and participant activity by exchanges and regulators to detect manipulation, abuse, and systemic risk. It ingests order, trade, and reference data in real time, applies alerting logic, and escalates suspected violations for enforcement. It underpins fair and orderly markets and is mandated by securities regulation."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-liability,
        ngm:securities-regulation ;
    vc:slug "market-surveillance" ;
    vc:sourceDomain "governance" .

ngm:material-flow-analysis a owl:Class ;
    rdfs:label "Material Flow Analysis"@en ;
    rdfs:comment "Material flow analysis (MFA) is a systematic accounting of the flows and stocks of materials within a defined system in space and time, grounded in the principle of mass conservation. It quantifies inputs, outputs, and accumulations to reveal resource use, losses, and recycling potential across an economy, industry, or region. MFA is a foundational method for industrial ecology, circular-economy design, and sustainability assessment."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:industrial-symbiosis ;
    vc:slug "material-flow-analysis" ;
    vc:sourceDomain "supply-chain" .

ngm:math-library a owl:Class ;
    rdfs:label "Math Library"@en ;
    rdfs:comment "A Math Library is a software library providing optimised implementations of mathematical operations — including vector and matrix arithmetic, quaternion transformations, geometric queries, interpolation, and numerical methods — that underpin real-time 3D graphics, physics simulation, and spatial computing systems. These libraries abstract hardware-level SIMD optimisations and GPU-friendly data layouts, enabling physics engines, rendering pipelines, and game engines to perform high-throughput computation at interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quaternion-math ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        ngm:sc-content-and-assets,
        ngm:software-library ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compute-shader,
        ngm:fluid-simulation,
        ngm:physics-engine,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:graphics-library,
        ngm:noise-function-library,
        ngm:spatial-coordinates ;
    vc:requires ngm:coordinate-system,
        ngm:quaternion-math ;
    vc:slug "math-library" ;
    vc:sourceDomain "spatial-computing" .

ngm:mechanistic-interpretability a owl:Class ;
    rdfs:label "Mechanistic Interpretability"@en ;
    rdfs:comment "Mechanistic interpretability is a research area that seeks to reverse-engineer the internal computations of neural networks into human-understandable algorithms. It studies features, circuits, and representations within model weights and activations to explain how specific behaviours arise. The field aims to make models transparent enough to predict, audit, and align, supporting AI safety."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:safety-and-alignment ;
    vc:slug "mechanistic-interpretability" ;
    vc:sourceDomain "ai" .

ngm:medical-diagnosis-ai a owl:Class ;
    rdfs:label "Medical Diagnosis AI"@en ;
    rdfs:comment "Medical Diagnosis AI refers to artificial intelligence systems that automate or assist in the diagnostic process by analysing patient symptoms, medical history, laboratory results, imaging findings, and other clinical data to generate differential diagnoses, diagnostic hypotheses, and diagnostic ..."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:medical-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:clinical-decision-support,
        ngm:treatment-planning-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
