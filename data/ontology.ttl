ngm:asymmetric-encryption a owl:Class ;
    rdfs:label "Asymmetric Encryption"@en ;
    rdfs:comment "A cryptographic system using mathematically related public-private key pairs where the public key encrypts data that only the corresponding private key can decrypt, enabling secure communication, digital signatures, and trustless verification without pre-shared secrets."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:blockchain,
        ngm:did-nostr-identity,
        ngm:threshold-signature-scheme ;
    vc:contrastsWith ngm:post-quantum-cryptography,
        ngm:symmetric-encryption ;
    vc:dependsOn ngm:number-theory ;
    vc:enables ngm:digital-signature,
        ngm:non-repudiation,
        ngm:public-key-infrastructure,
        ngm:secure-key-exchange,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:elliptic-curve-cryptography,
        ngm:rsa-cryptosystem,
        ngm:trapdoor-function ;
    vc:qualityScore "0.72"^^xsd:float ;
