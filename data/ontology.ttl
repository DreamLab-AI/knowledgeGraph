ngm:hd-maps a owl:Class ;
    rdfs:comment "HD maps (high-definition maps) are centimetre-accurate digital representations of road infrastructure — including lane geometry, traffic signs, signal positions and road markings — used by autonomous vehicles to localise themselves precisely and to anticipate road features beyond the range of onboard sensors. They are built from surveyed lidar and camera data and are typically fused with real-time perception output to cross-check and supplement what the vehicle currently observes. HD maps trade off high localisation accuracy against the cost and staleness risk of maintaining a pre-built map as road conditions change."@en ;
    rdfs:label "HD Maps"@en ;
    rdfs:subClassOf ngm:autonomous-driving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:autonomous-driving ;
    vc:qualityScore "0.55"^^xsd:float ;
