ngm:fine-tuning a owl:Class ;
    rdfs:label "Fine Tuning"@en ;
    rdfs:comment "The process of adapting a pre-trained model to a specific downstream task by continuing training on task-specific data, typically with a lower learning rate. Fine-tuning leverages knowledge acquired during pre-training whilst specialising the model for particular applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter-efficient-fine-tuning ],
        [ a owl:Restriction ;
