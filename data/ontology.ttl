ngm:digital-ownership a owl:Class ;
    rdfs:label "Digital Ownership"@en ;
    rdfs:comment "The cryptographically verified right to possess, control, and transfer digital assets including NFTs, virtual real estate, in-game items, and tokenised content, established through blockchain technology and smart contracts that provide immutable proof of authenticity and provenance within metaver..."@en ;
