        ngm:voice-user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder-decoder,
        ngm:neural-network,
        ngm:sequence-model ;
    vc:isPartOf ngm:speech-recognition ;
