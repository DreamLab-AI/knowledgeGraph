ngm:knowledge-base a owl:Class ;
    rdfs:label "Knowledge Base"@en ;
    rdfs:comment "A knowledge base is a structured, machine-readable repository of domain-specific information, factual assertions, and inference rules that software systems—including expert systems, question-answering engines, and AI agents—can query, reason over, and update. Knowledge bases range from relational tables and document stores to formal ontologies expressed in OWL/RDF and property graphs, each offering different trade-offs between expressiveness, scalability, and reasoning complexity. They function as the long-term declarative memory layer in AI architectures, enabling systems to retrieve, validate, and integrate facts without embedding all knowledge in model parameters. In contemporary retrieval-augmented generation pipelines a knowledge base serves as the authoritative external store from which a retriever selects grounding context for a large language model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:triple-store ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:decentralised-knowledge-graph,
        ngm:digital-twin ;
    vc:contrastsWith ngm:database,
        ngm:large-language-model,
        ngm:vector-database ;
    vc:dependsOn ngm:data-model,
        ngm:ontology ;
    vc:enables ngm:automated-reasoning,
        ngm:expert-systems,
        ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:inference-engine,
        ngm:ontology,
        ngm:production-rules,
        ngm:triple-store ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:natural-language-processing,
        ngm:semantic-web ;
    vc:requires ngm:data-schema,
        ngm:knowledge-acquisition ;
    vc:slug "knowledge-base" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:description-logic,
        ngm:knowledge-representation,
        ngm:rdf,
        ngm:sparql .

ngm:mining a owl:Class ;
    rdfs:label "Mining"@en ;
    rdfs:comment "Mining is the proof-of-work block-creation process in which participating nodes compete to solve a cryptographic hash puzzle, with the winner appending the next block to the chain and receiving a block reward. Mining provides Sybil resistance, ensures probabilistic finality, and anchors chain security to real-world energy expenditure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-energy-consumption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coinbase-transaction ],
        ngm:consensus-protocol ;
    vc:bridgesTo ngm:carbon-footprint,
        ngm:renewable-energy ;
    vc:contrastsWith ngm:proof-of-authority,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:distributed-ledger ;
    vc:enables ngm:double-spend-prevention,
        ngm:immutability,
        ngm:nakamoto-consensus,
        ngm:sybil-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:coinbase-transaction,
        ngm:mining-difficulty,
        ngm:mining-pool,
        ngm:mining-reward,
        ngm:network-hash-rate,
        ngm:nonce ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-finality,
        ngm:transaction-fee ;
    vc:requires ngm:block-header,
        ngm:blockchain-energy-consumption,
        ngm:peer-to-peer-network ;
    vc:slug "mining" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:application-specific-integrated-circuit,
