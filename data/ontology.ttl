ngm:neuromorphic-chips a owl:Class ;
    rdfs:comment "Neuromorphic Chips is a artificial intelligence concept and a type of Inference Hardware. that enables Ultra-Low-Power AI."@en ;
    rdfs:label "Neuromorphic Chips"@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
