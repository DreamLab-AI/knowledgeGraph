    vc:uses ngm:configuration-management,
        ngm:devops .

ngm:pay-to-script-hash a owl:Class ;
    rdfs:label "Pay-to-Script-Hash"@en ;
    rdfs:comment "Pay-to-Script-Hash (P2SH) is a Bitcoin transaction type, introduced in BIP 16, that locks funds to the hash of a redeem script rather than to a public key or full script. The spender must later provide both the original redeem script, whose hash matches the locking output, and the data that satisfies it. P2SH shifts the burden and storage cost of complex spending conditions from the sender to the recipient and underpins multi-signature and other advanced locking schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:script ],
        ngm:bitcoin-script ;
    vc:contrastsWith ngm:pay-to-public-key-hash,
        ngm:segregated-witness ;
    vc:dependsOn ngm:transaction ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bip-16,
        ngm:multi-signature-wallet ;
    vc:isPartOf ngm:bitcoin ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:address ;
    vc:requires ngm:script ;
    vc:slug "pay-to-script-hash" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bip-16 ;
    vc:supports ngm:blockchain ;
    vc:uses ngm:bitcoin-script,
        ngm:script .

ngm:payment-routing a owl:Class ;
    rdfs:label "Payment Routing"@en ;
    rdfs:comment "Payment routing is the process of determining a viable path along which value moves from a payer to a payee across one or more intermediaries, payment channels or networks. In layered payment systems such as the Lightning Network it involves finding a sequence of hops with sufficient liquidity and acceptable fees, whereas in conventional rails it selects acquirers, schemes or correspondent banks. Routing decisions balance cost, success probability, latency and privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:routing-table ],
        ngm:payment-processing ;
    vc:bridgesTo ngm:routing-algorithm ;
    vc:contrastsWith ngm:payment-gateway ;
    vc:dependsOn ngm:liquidity,
        ngm:routing-algorithm ;
    vc:enables ngm:open-banking,
        ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:htlc,
        ngm:routing-algorithm ;
    vc:isPartOf ngm:lightning-network,
        ngm:payment-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:payment-processing,
        ngm:transaction-fee ;
    vc:requires ngm:liquidity,
        ngm:routing-table ;
    vc:slug "payment-routing" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:payment-gateway,
        ngm:payment-network ;
    vc:uses ngm:payment-channel,
        ngm:transaction-fee .

ngm:peg-mechanism a owl:Class ;
    rdfs:label "Peg Mechanism"@en ;
    rdfs:comment "A peg mechanism is the set of economic and technical arrangements by which a token maintains a stable exchange rate against a reference asset such as a fiat currency or another token. It typically combines collateral backing, minting and redemption rules, and arbitrage incentives so that market deviations from the target price are pushed back towards parity. The design of the peg mechanism determines how robustly a stablecoin or wrapped asset holds its value under stress."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        ngm:stablecoin ;
    vc:bridgesTo ngm:de-fi ;
    vc:contrastsWith ngm:algorithmic-stablecoin ;
    vc:dependsOn ngm:arbitrage,
        ngm:liquidity ;
    vc:enables ngm:price-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collateral,
        ngm:peg ;
    vc:implements ngm:price-stability ;
    vc:isPartOf ngm:stablecoin,
        ngm:wrapped-token ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-stablecoin,
        ngm:dai,
        ngm:peg ;
    vc:requires ngm:collateral,
        ngm:liquidity ;
    vc:slug "peg-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:stablecoin,
        ngm:wrapped-token ;
    vc:uses ngm:arbitrage,
        ngm:collateral,
        ngm:token-minting .

ngm:permissionless-trading a owl:Class ;
    rdfs:label "Permissionless Trading"@en ;
    rdfs:comment "Permissionless trading refers to the ability to execute financial trades — buying, selling, or swapping digital assets — without requiring authorisation from a centralised intermediary, gatekeeper, or identity provider. Enabled by on-chain smart contracts and automated market makers (AMMs), permissionless trading removes the account approval, KYC, and whitelist requirements of traditional financial markets, allowing any wallet address to interact directly with liquidity pools. It is a foundational property of decentralised finance (DeFi) protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:non-custodial-wallet ],
        ngm:decentralized-finance-de-fi ;
    vc:bridgesTo ngm:finance,
        ngm:governance ;
    vc:contrastsWith ngm:centralized-exchange,
        ngm:know-your-customer,
        ngm:order-book ;
    vc:enables ngm:arbitrage,
        ngm:asset-trading,
        ngm:financial-inclusion,
        ngm:flash-loan,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance,
        ngm:concentrated-liquidity,
        ngm:decentralized-exchange,
        ngm:permissionless-network,
        ngm:slippage,
        ngm:token-swapping,
        ngm:uniswap ;
    vc:requires ngm:non-custodial-wallet,
        ngm:public-blockchain ;
    vc:slug "permissionless-trading" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:blockchain-wallet,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:plant-model a owl:Class ;
    rdfs:label "Plant Model"@en ;
    rdfs:comment "A plant model is a mathematical representation of the dynamic system being controlled, mapping control inputs and disturbances to the system's state and outputs over time. Usually expressed as differential equations, transfer functions, or state-space form, it captures how the plant responds so a controller can be designed and tuned against it. Accurate plant models are central to control theory and to model-based control synthesis and simulation."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm ;
    vc:slug "plant-model" ;
    vc:sourceDomain "robotics" .

ngm:platform-accountability a owl:Class ;
    rdfs:label "Platform Accountability"@en ;
    rdfs:comment "Platform accountability is the principle and regulatory expectation that online platforms bear responsibility for the systems, content, and harms arising on their services. It encompasses obligations such as transparency reporting, risk assessment, content-moderation due process, and remedies for illegal or harmful material. Frameworks like the Digital Services Act codify these duties, shifting platforms from passive intermediaries toward governed actors."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:death-of-the-internet,
        ngm:digital-services-act ;
    vc:slug "platform-accountability" ;
    vc:sourceDomain "governance" .

ngm:platform-as-a-service a owl:Class ;
    rdfs:label "Platform As A Service"@en ;
    rdfs:comment "Platform as a Service (PaaS) is a cloud computing service model that provides a managed execution environment — including runtime, middleware, databases, and development tools — over the internet, allowing developers to build, deploy, and scale applications without managing underlying infrastructure. PaaS abstracts operating system and server management from the development team, enabling faster iteration cycles and lower operational overhead. Examples include Heroku, Google App Engine, Microsoft Azure App Service, and AWS Elastic Beanstalk."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:runtime-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        ngm:cloud-computing ;
    vc:contrastsWith ngm:infrastructure-as-a-service,
        ngm:serverless-architecture,
        ngm:software-as-a-service ;
    vc:dependsOn ngm:infrastructure-as-a-service,
        ngm:virtualisation ;
    vc:enables ngm:application-development,
        ngm:continuous-integration,
        ngm:devops,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:database,
        ngm:middleware,
        ngm:runtime-environment ;
    vc:isPartOf ngm:cloud-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:containerisation ;
    vc:slug "platform-as-a-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api,
        ngm:microservices ;
    vc:uses ngm:automation,
        ngm:kubernetes .

ngm:pre-production a owl:Class ;
    rdfs:label "Pre Production"@en ;
    rdfs:comment "Pre-production is the planning and preparation phase of a creative or software project that occurs before active content creation or development commences. It encompasses conceptual design, narrative structuring, technical specification, asset planning, and prototyping activities that reduce risk and align stakeholder expectations in film, game, and metaverse content pipelines."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-content-creation,
        ngm:virtual-environment-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:game-development ;
    vc:slug "pre-production" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-production-workflow,
        ngm:creative-tools .

ngm:presentation-attack-detection a owl:Class ;
    rdfs:label "Presentation Attack Detection"@en ;
    rdfs:comment "Presentation attack detection (PAD) is the set of techniques that determine whether a biometric sample is presented by a genuine, live subject or by an artefact intended to spoof the system. Attacks include printed photographs, replayed video, silicone fingerprints, and three-dimensional masks. PAD, also known as liveness or anti-spoofing analysis, is standardised under ISO/IEC 30107 and is essential to the trustworthiness of biometric authentication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:biometric-authentication ;
    vc:bridgesTo ngm:deepfake-detection ;
    vc:contrastsWith ngm:adversarial-attack ;
    vc:dependsOn ngm:face-recognition ;
    vc:enables ngm:multi-factor-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:biometric-authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:deepfake-detection,
        ngm:face-recognition ;
    vc:requires ngm:biometric-authentication,
        ngm:model-training ;
    vc:slug "presentation-attack-detection" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:authentication ;
    vc:uses ngm:convolutional-neural-network,
        ngm:eye-tracking .

ngm:pressure-sensor a owl:Class ;
