ngm:gas-mechanism a owl:Class ;
    rdfs:comment "The system in a blockchain such as Ethereum that meters and prices computation, requiring users to pay fees denominated in units of gas for the operations their transactions perform. It limits resource use and prioritises transactions."@en ;
    rdfs:label "Gas Mechanism"@en ;
