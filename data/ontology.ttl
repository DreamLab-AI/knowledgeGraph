    vc:sourceDomain "standards" .

ngm:w-3-c-verifiable-credentials-data-model-v-2-0 a owl:Class ;
    rdfs:label "W3C Verifiable Credentials Data Model v2.0"@en ;
    rdfs:comment "Version 2.0 of the W3C Verifiable Credentials Data Model specifies a data model for cryptographically verifiable claims exchanged between issuers, holders and verifiers."@en ;
