ngm:smart-royalties-ledger a owl:Class ;
    rdfs:label "Smart Royalties Ledger"@en ;
    rdfs:comment "An automated tracking and distribution system that records creator royalty obligations, calculates payment amounts, and executes compensation transfers for digital content and NFT sales in virtual economy environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
