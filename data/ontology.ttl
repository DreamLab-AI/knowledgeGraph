ngm:agentic-ai a owl:Class ;
    rdfs:label "Agentic AI"@en ;
    rdfs:comment "Agentic AI refers to AI systems characterised by autonomy, goal-directedness, and the capacity to take sustained sequences of actions — including calling tools, spawning sub-agents, and modifying their own environment — in pursuit of high-level objectives specified by a user or orchestrator. Agentic systems differ from conversational AI in that they operate over extended time horizons, maintain state across steps, and may take consequential irreversible actions. The term is used both to describe individual agents and multi-agent architectures in which agentic components collaborate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-agents,
        ngm:orchestration ;
    vc:requires ngm:large-language-models,
        ngm:tool-use ;
    vc:slug "agentic-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cryptographic-hash a owl:Class ;
    rdfs:label "Cryptographic Hash"@en ;
    rdfs:comment "Deterministic mathematical function transforming arbitrary input data into fixed-length output ensuring data integrity verification and tamper detection through collision resistance properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signatures,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:hash-function ;
    vc:slug "cryptographic-hash" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain,
        ngm:encryption,
        ngm:zero-knowledge-proof .

ngm:cryptographic-keys a owl:Class ;
    rdfs:label "Cryptographic Keys"@en ;
    rdfs:comment "Strings of data used in cryptographic algorithms to encrypt, decrypt, sign, or verify data, serving as the secret parameters that transform plaintext to ciphertext and vice versa."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:cryptography ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "cryptographic-keys" ;
    vc:sourceDomain "blockchain" .

ngm:end-effector a owl:Class ;
    rdfs:label "End Effector"@en ;
    rdfs:comment "End Effector - A task-specific tool or manipulator mounted at the Robot Wrist that physically interacts with the environment (gripper, welder, drill, camera), translating robotic control commands into productive work through mechanical, electrical, or pneumatic actuation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-feedback ],
        ngm:mechanical-component,
