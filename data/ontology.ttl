vf:3-d-file-format a owl:Class ;
    rdfs:label "3D File Format"@en ;
    rdfs:comment "3D File Formats are standardised container structures for encoding three-dimensional geometric data, textures, materials, animations, and metadata. Common formats include [[glTF]] (GL Transmission Format), FBX, OBJ, and USD, each optimised for specific use cases such as real-time rendering, interoperability, or archival preservation in spatial computing environments."@en ;
