    vc:sourceDomain "security" .

ngm:certification a owl:Class ;
    rdfs:label "Certification"@en ;
    rdfs:comment "Certification is the formal process by which an independent authority attests that a product, system, process or person meets defined standards or requirements. It produces a verifiable credential or mark that signals conformance to interested parties and reduces the cost of establishing trust. Certification regimes are central to regulation, quality assurance and the safe interoperability of regulated goods and services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification ],
        ngm:compliance ;
    vc:bridgesTo ngm:quality-assurance ;
    vc:dependsOn ngm:quality-assurance ;
    vc:enables ngm:regulatory-compliance,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:governance-framework ;
    vc:isPartOf ngm:compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:conformance,
        ngm:regulation ;
    vc:requires ngm:audit,
        ngm:conformance,
        ngm:verification ;
    vc:slug "certification" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:regulation,
        ngm:safety-standard ;
    vc:uses ngm:iso .

ngm:collective-decision-making a owl:Class ;
    rdfs:label "Collective Decision Making"@en ;
    rdfs:comment "Collective decision making is the social and technical process by which a group of agents — human, algorithmic, or hybrid — aggregate individual preferences, information, or votes to arrive at a binding or advisory choice on behalf of the group. It encompasses the design and analysis of voting systems, preference aggregation mechanisms, deliberation protocols, and incentive structures that determine how group choices are reached and enforced. In digital and distributed contexts, collective decision making is formalised through on-chain governance mechanisms, decentralised autonomous organisations, and algorithmic consensus protocols that encode group agency in smart contract logic. The field draws on social choice theory, mechanism design, game theory, and organisational science to evaluate fairness, efficiency, and manipulation-resistance of alternative procedures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-aggregation ],
        ngm:social-choice-theory ;
    vc:bridgesTo ngm:consensus-algorithm,
        ngm:federated-learning,
        ngm:multi-agent-system ;
    vc:dependsOn ngm:game-theory,
        ngm:mechanism-design ;
    vc:enables ngm:community-governance,
        ngm:dao-governance,
        ngm:on-chain-governance,
        ngm:protocol-upgrades ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:quorum-requirement ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence-system,
        ngm:consent-management,
        ngm:deliberative-democracy,
        ngm:governance-token ;
    vc:requires ngm:identity-verification,
        ngm:preference-aggregation ;
    vc:slug "collective-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:conviction-voting,
        ngm:liquid-democracy,
        ngm:quadratic-voting,
        ngm:ranked-choice-voting,
        ngm:token-weighted-voting,
        ngm:voting-mechanism .

ngm:complex-systems a owl:Class ;
    rdfs:label "Complex Systems"@en ;
    rdfs:comment "Systems composed of many interacting components whose collective behaviour cannot be simply inferred from the behaviour of the individual parts; characterised by nonlinearity, emergence, self-organisation, and feedback dynamics across scales."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:phase-transition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-based-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamical-systems-theory ],
        ngm:systems-theory ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-systems,
        ngm:ecology,
        ngm:economics ;
    vc:dependsOn ngm:information-theory,
        ngm:statistical-mechanics ;
    vc:enables ngm:emergence,
        ngm:resilience-engineering,
        ngm:self-organisation,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-based-models,
        ngm:feedback-loop,
        ngm:phase-transition ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chaos-theory,
        ngm:cybernetics ;
    vc:requires ngm:dynamical-systems-theory,
        ngm:network-theory ;
    vc:slug "complex-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:adaptive-systems,
        ngm:swarm-intelligence .

ngm:consensus-process a owl:Class ;
    rdfs:label "Consensus Process"@en ;
    rdfs:comment "A consensus process is the structured, participatory procedure by which a standards body or governance group develops, refines, and adopts decisions through deliberation aimed at broad agreement rather than narrow majority voting. It gathers stakeholder input, circulates drafts for review and public comment, resolves objections substantively, and seeks a state of general acceptance — often characterised as rough consensus — where remaining dissent has been heard and addressed. The process underpins the legitimacy and durability of open standards by ensuring decisions reflect the considered views of affected parties rather than the preferences of a dominant actor."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-group ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decision-making ],
        ngm:standards ;
    vc:contrastsWith ngm:voting ;
    vc:dependsOn ngm:consensus,
        ngm:stakeholder-engagement ;
    vc:enables ngm:open-standards,
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:public-comment,
        ngm:working-group ;
    vc:implements ngm:standards-body ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ietf,
        ngm:iso ;
    vc:requires ngm:decision-making,
        ngm:deliberation,
        ngm:stakeholder-engagement ;
    vc:slug "consensus-process" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:interoperability ;
    vc:uses ngm:rough-consensus,
        ngm:voting .

ngm:contract-net-protocol a owl:Class ;
    rdfs:label "Contract Net Protocol"@en ;
    rdfs:comment "The Contract Net Protocol is a task-sharing interaction pattern for multi-agent systems in which a manager agent announces a task, soliciting bids from potential contractor agents, evaluates the responses, and awards the task to the most suitable bidder. It decomposes distributed problem solving into the phases of announcement, bidding, awarding, and result reporting, treating the agent population as a market for negotiating the allocation of work. The protocol provides a decentralised mechanism for dynamic task allocation without a fixed assignment table."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:consensus ;
    vc:dependsOn ngm:agent ;
    vc:enables ngm:automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus ;
    vc:implements ngm:consensus ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:automation,
        ngm:decentralization,
        ngm:distributed-systems ;
    vc:requires ngm:agent ;
    vc:slug "contract-net-protocol" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:decentralization ;
    vc:uses ngm:agent .

ngm:coordinate-frame a owl:Class ;
    rdfs:label "Coordinate Frame"@en ;
    rdfs:comment "A coordinate frame is a reference system defined by an origin and a set of axes against which positions, orientations, and motions are measured. In robotics and perception, multiple frames (world, base, sensor, tool) are related by rigid-body transforms so that data from different sources can be expressed consistently. Correct frame management is essential for sensor fusion, motion planning, and collision checking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotation-matrix ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:coordinate-system ;
    vc:dependsOn ngm:exteroceptive-sensor,
        ngm:inertial-measurement-unit ;
    vc:enables ngm:collision-detection,
        ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:axis-vector,
        ngm:origin-point,
        ngm:rotation-matrix ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:exteroceptive-sensor,
        ngm:odometry,
        ngm:transform-tree ;
    vc:requires ngm:homogeneous-transformation-matrix,
        ngm:rigid-body-transform ;
    vc:slug "coordinate-frame" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:denavit-hartenberg-parameters,
        ngm:ros ;
    vc:supports ngm:point-cloud,
        ngm:robot-kinematics,
        ngm:simultaneous-localisation-and-mapping ;
    vc:uses ngm:euler-angles,
        ngm:pose-estimation,
        ngm:quaternion-math .

ngm:coreference-resolution a owl:Class ;
    rdfs:label "Coreference Resolution"@en ;
    rdfs:comment "Coreference resolution is the natural language processing task of identifying all expressions in a text that refer to the same real-world entity, grouping noun phrases, pronouns, definite descriptions, and other referring expressions into coreference clusters so that downstream systems can maintain coherent entity representations across sentences and documents. It is a foundational subtask of information extraction, question answering, summarisation, and knowledge graph population, enabling models to track entities without re-identifying them from scratch at each mention."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-parsing ],
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:entity-linking,
        ngm:named-entity-recognition,
        ngm:text-mining ;
    vc:enables ngm:document-summarisation,
        ngm:information-extraction,
        ngm:knowledge-graph-construction,
        ngm:question-answering,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anaphora-resolution,
        ngm:antecedent-scoring,
        ngm:mention-clustering,
        ngm:mention-detection ;
    vc:isPartOf ngm:information-extraction,
        ngm:natural-language-understanding ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:natural-language-understanding,
        ngm:part-of-speech-tagging,
        ngm:relation-extraction ;
    vc:requires ngm:dependency-parsing,
        ngm:named-entity-recognition,
        ngm:semantic-parsing,
        ngm:span-representation ;
    vc:slug "coreference-resolution" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:entity-resolution,
        ngm:machine-translation,
        ngm:sentiment-analysis,
        ngm:slot-filling ;
    vc:uses ngm:bert,
        ngm:large-language-model,
        ngm:transformer-architecture,
        ngm:word-embeddings .

ngm:cost-function a owl:Class ;
    rdfs:label "Cost Function"@en ;
    rdfs:comment "A cost function is a scalar-valued mathematical function that maps a model's parameters or a system's state to a real number representing the magnitude of error, resource expenditure, or divergence from a desired outcome. In supervised machine learning, the cost function (also called a loss function) measures the aggregate discrepancy between predicted and ground-truth outputs across a training set, providing the objective that optimisation algorithms such as gradient descent minimise. In control theory and robotics, cost functions encode trajectory quality criteria including path length, energy consumption, and collision risk, enabling optimal control policies via formulations such as LQR and model predictive control. The design of the cost function is one of the most consequential decisions in any learning or optimisation system, as misspecified objectives lead to reward hacking, degenerate solutions, or physically unrealisable behaviours."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regularisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:inverse-reinforcement-learning,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:reward-function,
        ngm:utility-function ;
    vc:dependsOn ngm:loss-landscape,
        ngm:parametric-model ;
    vc:enables ngm:gradient-descent,
        ngm:inverse-reinforcement-learning,
        ngm:model-training,
        ngm:motion-planning,
        ngm:neural-architecture-search,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-fidelity-term,
        ngm:penalty-term,
        ngm:regularisation ;
    vc:implements ngm:bayesian-inference,
        ngm:maximum-likelihood-estimation ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:convex-optimisation,
        ngm:covariance-matrix,
        ngm:hyperparameter-tuning,
        ngm:neural-network,
        ngm:overfitting ;
    vc:requires ngm:differentiability,
        ngm:parametric-model,
        ngm:training-data ;
    vc:slug "cost-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:automatic-differentiation,
        ngm:backpropagation,
        ngm:reinforcement-learning .

ngm:creative-tools a owl:Class ;
    rdfs:label "Creative Tools"@en ;
    rdfs:comment "Creative Tools are AI-powered and digitally-augmented software applications that assist, augment, or automate human creative processes across modalities including image generation, music composition, video synthesis, 3D asset creation, and long-form text authoring. They typically expose foundation models—particularly diffusion models and large language models—through interactive interfaces or programmable API endpoints, enabling both professionals and non-expert users to produce high-quality creative outputs. Their role is dual: serving as productivity accelerators for practitioners and as accessibility bridges lowering barriers to creative expression. Provenance attribution, intellectual property frameworks, and content authentication standards such as C2PA are active governance concerns around AI-generated content produced by these tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:digital-twin,
        ngm:metaverse-content,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:design-software,
        ngm:procedural-generation ;
    vc:dependsOn ngm:api,
        ngm:training-data ;
    vc:enables ngm:3d-asset-creation,
        ngm:content-creation,
        ngm:image-generation,
        ngm:music-generation,
        ngm:text-to-image,
        ngm:video-synthesis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-application,
        ngm:c2pa,
        ngm:content-provenance,
        ngm:human-ai-collaboration,
        ngm:intellectual-property-rights-framework ;
    vc:requires ngm:foundation-model,
        ngm:gpu-compute ;
    vc:slug "creative-tools" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:creative-economy,
        ngm:human-computer-interaction ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai,
        ngm:large-language-model,
        ngm:multimodal-model,
        ngm:prompt-engineering .

ngm:crm a owl:Class ;
    rdfs:label "CRM"@en ;
    rdfs:comment "Customer Relationship Management (CRM) is a category of enterprise software and associated business processes that centralises the storage, tracking, and analysis of all interactions between an organisation and its customers, prospects, and partners across the full sales, marketing, and service lifecycle. A CRM system provides a shared record of each contact and account, enabling sales pipelines, service-case management, marketing campaign tracking, and analytical reporting from a single platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:crm-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:crm-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-resolution ],
        ngm:enterprise-software-platform ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:customer-data-platform,
        ngm:enterprise-resource-planning ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:rest-api ;
    vc:enables ngm:customer-experience-management,
        ngm:customer-support-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:crm-integration,
        ngm:crm-systems ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:business-intelligence,
        ngm:data-warehouse ;
    vc:requires ngm:data-integration,
        ngm:identity-resolution ;
    vc:slug "crm" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:consent-management,
        ngm:omnichannel ;
    vc:uses ngm:enterprise-workflow,
        ngm:natural-language-processing .

ngm:cross-platform-identity a owl:Class ;
    rdfs:label "Cross-Platform Identity"@en ;
    rdfs:comment "Cross-platform identity refers to the capability of linking and managing a user's electronic identity and attributes across multiple distinct systems, platforms, and organisational boundaries, enabling seamless authentication and authorisation across heterogeneous environments through federated identity management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-factor-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust ],
        ngm:identity-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identifiers,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:siloed-identity ;
    vc:dependsOn ngm:attribute-based-access-control,
        ngm:directory-service ;
    vc:enables ngm:authorisation,
        ngm:federated-identity-system,
        ngm:single-sign-on,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:federation,
        ngm:identity-provider ;
    vc:implements ngm:identity-federation,
        ngm:oauth-2-0,
        ngm:open-id-connect ;
    vc:isPartOf ngm:identity-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:zero-trust-architecture ;
    vc:requires ngm:multi-factor-authentication,
        ngm:public-key-infrastructure,
        ngm:trust ;
    vc:slug "cross-platform-identity" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:oasis-standards ;
    vc:uses ngm:saml,
        ngm:scim .

ngm:cryptographic-signing a owl:Class ;
    rdfs:label "Cryptographic Signing"@en ;
    rdfs:comment "Cryptographic signing is the process of producing a verifiable proof of authorship and integrity over a message or document using a private key, such that anyone holding the corresponding public key can confirm the signature without being able to forge it. It underpins authentication, non-repudiation, software-supply-chain integrity, and blockchain transaction authorisation. Signing schemes include RSA, ECDSA, EdDSA, and Schnorr, each defining how a hash of the message is transformed under the signer's secret key into a compact, publicly verifiable signature."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:key-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol ;
    vc:slug "cryptographic-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:public-key-cryptography .

ngm:cultural-heritage-preservation a owl:Class ;
    rdfs:label "Cultural Heritage Preservation"@en ;
    rdfs:comment "Cultural Heritage Preservation encompasses the methodologies, technologies, and institutional practices used to document, conserve, and transmit tangible and intangible cultural assets to future generations. Digital preservation extends these goals through high-fidelity capture technologies—photogrammetry, LiDAR scanning, and multispectral imaging—combined with long-lived archival formats and distributed storage. Immersive technologies increasingly enable experiential access to heritage sites and artefacts that physical access cannot support. The discipline spans archaeology, architecture, performing arts, indigenous knowledge, and language revitalisation, requiring interdisciplinary collaboration between cultural practitioners and technologists."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standard ],
        ngm:digital-heritage ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:dependsOn ngm:data-format-standard,
        ngm:distributed-storage ;
    vc:enables ngm:augmented-reality,
        ngm:collective-memory-archive,
        ngm:cultural-heritage-xr-experience,
        ngm:immersive-experience,
        ngm:virtual-tour ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cultural-provenance-record,
        ngm:digital-archive,
        ngm:digital-preservation,
        ngm:intangible-cultural-heritage,
        ngm:open-archival-information-system ;
    vc:requires ngm:institutional-repository,
        ngm:long-term-storage,
        ngm:metadata-standard ;
    vc:slug "cultural-heritage-preservation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:dublin-core,
        ngm:iso-14721 ;
    vc:uses ngm:3-d-reconstruction,
        ngm:gltf-standard,
        ngm:lidar-scanning,
        ngm:multispectral-imaging,
        ngm:photogrammetry,
        ngm:point-cloud .

ngm:data-poisoning a owl:Class ;
    rdfs:label "Data Poisoning"@en ;
    rdfs:comment "A training-time adversarial attack where malicious actors inject, modify, or manipulate training data to compromise model integrity, causing targeted misclassifications, backdoor triggers, or general performance degradation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:adversarial-attack,
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation-strategies,
        ngm:federated-learning,
        ngm:machine-learning-discipline ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "data-poisoning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:data-sharing a owl:Class ;
    rdfs:label "Data Sharing"@en ;
    rdfs:comment "The controlled exchange of datasets, data streams, or derived information between organisations, systems, or individuals under agreed governance, access control, and privacy constraints. Data sharing in distributed infrastructure contexts relies on interoperability standards, consent management frameworks, and data governance policies to balance openness with security and sovereignty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-interoperability,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-sovereignty,
        ngm:privacy ;
    vc:requires ngm:access-control,
        ngm:data-governance ;
    vc:slug "data-sharing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-standards,
        ngm:interoperability .

ngm:data-storage-layer a owl:Class ;
    rdfs:label "Data Storage Layer"@en ;
    rdfs:comment "Software layer managing persistent storage, retrieval, and lifecycle of digital assets, metadata, world state, user data, and transactional records in metaverse systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cache-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backup-and-recovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
