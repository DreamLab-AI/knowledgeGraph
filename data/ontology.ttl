ngm:distributed-hash-table a owl:Class ;
    rdfs:label "Distributed Hash Table"@en ;
    rdfs:comment "A distributed hash table (DHT) is a decentralised data structure that partitions a key-value store across a set of participating nodes so that each node is responsible for only a fraction of the total keyspace, with lookups routed through a structured overlay network in O(log n) hops without any central coordinator. Nodes join and leave dynamically, and the system rebalances key responsibility through consistent hashing or an XOR-metric routing algorithm, tolerating high churn without degrading availability. DHTs form the foundational lookup and routing primitive of peer-to-peer networks, underpinning decentralised content addressing, peer discovery, and distributed storage at global scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:distributed-system ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identifier ;
    vc:contrastsWith ngm:centralised-index,
        ngm:unstructured-overlay-network ;
    vc:dependsOn ngm:bootstrap-protocol,
        ngm:structured-overlay-network ;
    vc:enables ngm:censorship-resistant-communication,
        ngm:content-addressing,
        ngm:decentralised-peer-discovery,
        ngm:distributed-storage,
        ngm:ipfs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:keyspace-partition,
        ngm:node-identifier,
        ngm:routing-table ;
    vc:implements ngm:chord-protocol,
        ngm:kademlia-dht ;
    vc:isPartOf ngm:overlay-network,
        ngm:peer-to-peer-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:eclipse-attack,
        ngm:gossip-protocol,
        ngm:replication,
        ngm:sybil-attack ;
    vc:requires ngm:consistent-hashing,
        ngm:hash-function,
        ngm:network-node ;
    vc:slug "distributed-hash-table" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:bittorrent,
        ngm:ethereum,
        ngm:filecoin ;
    vc:uses ngm:k-bucket,
        ngm:libp2p,
        ngm:xor-metric .

ngm:domain-adaptation a owl:Class ;
    rdfs:label "Domain Adaptation"@en ;
    rdfs:comment "Domain adaptation is a sub-field of transfer learning that addresses the domain shift problem: a model trained on a labelled source distribution degrades when applied to a target distribution whose marginal or conditional statistics differ. Methods fall into feature-alignment approaches (learning domain-invariant representations via adversarial training, maximum mean discrepancy minimisation, or optimal transport), instance re-weighting schemes that correct for covariate shift, and self-training or pseudo-labelling strategies that exploit unlabelled target data. It spans unsupervised, semi-supervised, and multi-source settings and underpins practical deployment of models in NLP, computer vision, speech recognition, and scientific computing wherever labelled target data is scarce or costly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:transfer-learning ;
    vc:bridgesTo ngm:continual-learning,
        ngm:federated-learning ;
    vc:contrastsWith ngm:domain-generalisation,
        ngm:meta-learning,
        ngm:multi-task-learning ;
    vc:dependsOn ngm:pre-training,
        ngm:representation-learning ;
    vc:enables ngm:fine-tuning,
        ngm:low-resource-nlp,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:machine-learning,
        ngm:transfer-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:concept-drift,
        ngm:covariate-shift,
        ngm:distribution-shift,
        ngm:knowledge-distillation,
        ngm:parameter-efficient-fine-tuning ;
    vc:requires ngm:source-domain,
        ngm:target-domain,
        ngm:training-data ;
    vc:slug "domain-adaptation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:adversarial-training,
        ngm:maximum-mean-discrepancy,
        ngm:optimal-transport,
        ngm:pseudo-labelling,
        ngm:self-training .

ngm:eventual-consistency a owl:Class ;
    rdfs:label "Eventual Consistency"@en ;
    rdfs:comment "Eventual consistency is a consistency model for distributed data stores that guarantees that, in the absence of new updates, all replicas of a given data item will eventually converge to the same value. The model deliberately relaxes the requirement for immediate, global agreement in favour of higher availability and tolerance of network partitions, as described by the CAP theorem. Reads may transiently return stale data, and divergent replicas are reconciled through background propagation, gossip protocols, or explicit conflict resolution strategies such as last-write-wins or multi-version concurrency control. It is foundational to the design of large-scale internet-facing systems including DNS, distributed caches, and wide-area NoSQL databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-replication ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-consensus,
        ngm:federated-learning ;
    vc:contrastsWith ngm:acid-properties,
        ngm:linearizability,
        ngm:serializability,
        ngm:strong-consistency ;
    vc:enables ngm:distributed-storage,
        ngm:high-availability,
        ngm:horizontal-scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:base-properties,
        ngm:cap-theorem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:consistency-model,
        ngm:crdt,
        ngm:nosql-database,
        ngm:partition-tolerance,
        ngm:quorum-consensus ;
    vc:requires ngm:data-replication,
        ngm:distributed-computing ;
    vc:slug "eventual-consistency" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:conflict-resolution,
        ngm:gossip-protocol,
        ngm:merkle-tree,
        ngm:multi-version-concurrency-control,
        ngm:vector-clocks .

ngm:fatf a owl:Class ;
    rdfs:label "FATF"@en ;
    rdfs:comment "The Financial Action Task Force (FATF) is an intergovernmental policy-making body established in 1989 by the G7 that sets internationally recognised standards for combating money laundering, terrorist financing, and proliferation financing. Its Forty Recommendations and Nine Special Recommendations constitute the normative AML/CFT/CPF framework that member jurisdictions implement through national legislation and regulatory action. FATF conducts mutual evaluations of members' technical compliance and effectiveness, publishes grey and black lists of high-risk jurisdictions, and issues binding guidance on emerging risks including virtual assets, decentralised finance, and central bank digital currencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fatf-travel-rule ],
        ngm:regulatory-framework ;
    vc:bridgesTo ngm:blockchain-analytics,
        ngm:digital-identity ;
    vc:contrastsWith ngm:self-regulatory-organisation ;
    vc:enables ngm:anti-money-laundering,
        ngm:counter-terrorist-financing,
        ngm:financial-stability,
        ngm:proliferation-financing-controls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fatf-travel-rule,
        ngm:forty-recommendations,
        ngm:grey-list,
        ngm:mutual-evaluation ;
    vc:implements ngm:financial-intelligence-unit,
        ngm:risk-based-approach ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:compliance-framework,
        ngm:decentralised-finance,
        ngm:virtual-asset,
        ngm:virtual-asset-service-provider ;
    vc:requires ngm:customer-due-diligence,
        ngm:know-your-customer,
        ngm:suspicious-activity-report ;
    vc:slug "fatf" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-stability-board,
        ngm:g7,
        ngm:standards-organization ;
    vc:supports ngm:correspondent-banking,
        ngm:financial-crime-prevention,
        ngm:international-sanctions .

ngm:file-system a owl:Class ;
    rdfs:label "File System"@en ;
    rdfs:comment "A file system is the data structure and associated management software that an operating system uses to organise, store, retrieve, and manage data on storage media. It defines how data is logically partitioned into named files and directories, governs access permissions, maintains metadata such as timestamps and ownership, and translates logical file operations into physical block I/O against underlying storage hardware. File systems range from local single-disk formats (NTFS, ext4, APFS) to distributed and network-attached systems (NFS, HDFS, GFS) that span many physical storage nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-hardware ],
        ngm:operating-system ;
    vc:bridgesTo ngm:distributed-storage,
        ngm:ipfs ;
    vc:contrastsWith ngm:database,
        ngm:object-storage ;
    vc:dependsOn ngm:device-driver,
        ngm:virtual-file-system ;
    vc:enables ngm:access-control,
        ngm:content-addressed-storage,
        ngm:data-storage-layer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-allocation-table,
        ngm:directory-structure,
        ngm:inode ;
    vc:implements ngm:journaling,
        ngm:posix-interface ;
    vc:isPartOf ngm:operating-system,
        ngm:storage-stack ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-storage,
        ngm:storage-systems ;
    vc:requires ngm:block-device,
        ngm:kernel,
        ngm:storage-hardware ;
    vc:slug "file-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:posix ;
    vc:supports ngm:data-integrity,
        ngm:snapshot ;
    vc:uses ngm:storage-hardware,
        ngm:virtual-machine .

ngm:foveated-rendering a owl:Class ;
    rdfs:label "Foveated Rendering"@en ;
    rdfs:comment "Foveated rendering is a real-time graphics technique that exploits the non-uniform spatial acuity of the human visual system by rendering the region around the viewer's gaze point at full resolution whilst progressively reducing shading quality, texture resolution, and geometric detail in the peripheral visual field. Eye-tracking hardware continuously locates the foveal fixation point so that the high-quality region follows the gaze with sub-frame latency, making quality degradation imperceptible. The technique produces substantial GPU workload reductions that are critical for achieving high frame rates and thermal sustainability on power-constrained XR head-mounted displays, and is increasingly extended by neural super-resolution to reconstruct peripheral detail at low cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eye-tracking ],
        ngm:real-time-rendering ;
    vc:bridgesTo ngm:neural-network-inference,
        ngm:perceptual-quality-metric ;
    vc:contrastsWith ngm:temporal-anti-aliasing,
        ngm:uniform-shading ;
    vc:dependsOn ngm:display-hardware,
        ngm:gpu-compute,
        ngm:human-visual-system ;
    vc:enables ngm:extended-reality,
        ngm:high-fidelity-vr,
        ngm:power-efficient-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:foveal-region,
        ngm:peripheral-region,
        ngm:quality-transition-zone ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:perceptual-rendering,
        ngm:spatial-computing ;
    vc:requires ngm:eye-tracking,
        ngm:gaze-estimation,
