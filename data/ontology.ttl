ngm:credential-exchange a owl:Class ;
    rdfs:label "Credential Exchange"@en ;
    rdfs:comment "Credential exchange is the protocol-governed flow by which verifiable credentials are issued to, held by and presented from a digital identity wallet to relying parties. It defines how issuers offer credentials, how holders store and selectively disclose them, and how verifiers request and validate proofs. It is a foundational interaction pattern of decentralised and self-sovereign identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-issuance ],
        ngm:digital-identity-standards ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:oauth ;
    vc:dependsOn ngm:decentralised-identifier ;
    vc:enables ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:credential-issuance,
        ngm:presentation-exchange ;
    vc:implements ngm:verifiable-credentials ;
    vc:isPartOf ngm:digital-identity-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
