ngm:architectural-layer a owl:Class ;
    rdfs:label "Architectural Layer"@en ;
    rdfs:comment "An architectural layer is a discrete horizontal stratum within a layered software or system architecture, responsible for a cohesive set of concerns and communicating only with adjacent layers through well-defined interfaces. Layered decomposition is a fundamental pattern in software architecture that promotes separation of concerns, replaceability of individual layers, and independent evolution of distinct system capabilities. Classic examples include the OSI network model's seven layers, the three-tier application architecture (presentation, logic, data), and the cloud-native separation of infrastructure, platform, and application layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrastructure-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:application-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-layer ],
        ngm:software-architecture ;
    vc:enables ngm:hardware-abstraction,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
