    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Property Registry
blockchain:PropertyRegistry rdf:type owl:Class ;
    rdfs:label "Property Registry"@en ;
    rdfs:comment "Blockchain-based land title recording systems employing immutable distributed ledgers, cryptographic signatures, and timestamp verification to create tamper-proof property ownership records, reduce fraud, accelerate transaction processing from 30-90 days to 72 hours, and enable transparent title verification whilst addressing the global challenge where 70% of the world's population lacks access to formal land registration."@en ;
    skos:prefLabel "Property Registry"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:property-registry" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:property-registry> ;
