        ngm:large-language-models,
        ngm:rlhf ;
    vc:slug "constitutional-ai-language-model-family" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:responsible-ai .

ngm:cryptographic-verification a owl:Class ;
    rdfs:label "Cryptographic Verification"@en ;
    rdfs:comment "Cryptographic Verification is the process of using cryptographic primitives—such as digital signatures, hash functions, and zero-knowledge proofs—to confirm the authenticity, integrity, and non-repudiation of data, identities, or transactions. It forms the trust foundation for blockchain systems, content authentication, and decentralised identity schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:cryptographic-system,
        ngm:smart-contract,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:password-authentication ;
    vc:enables ngm:blockchain,
        ngm:content-authentication,
        ngm:decentralised-identity,
        ngm:non-repudiation,
        ngm:trusted-execution-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:certificate-authority,
        ngm:message-authentication-code,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:transport-layer-security,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-key-management ;
    vc:slug "cryptographic-verification" ;
    vc:sourceDomain "security" ;
