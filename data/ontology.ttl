ngm:industrial-manipulation a owl:Class ;
    rdfs:label "Industrial Manipulation"@en ;
    rdfs:comment "Industrial Manipulation refers to the robotic discipline and practice of using articulated robot arms and end-effectors to physically interact with objects in manufacturing, assembly, logistics, and processing environments, performing tasks such as pick-and-place, assembly, welding, painting, and material handling at production scale with repeatability and precision exceeding human capability. It encompasses the full kinematic and dynamic modelling of robot mechanisms, trajectory planning, force and torque control, and the integration of sensing for adaptive behaviour in structured industrial settings. Industrial manipulation robots are among the most economically significant deployed robotics systems, forming the backbone of automotive, electronics, and consumer goods production worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:kinematics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:manufacturing-automation ;
    vc:slug "industrial-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:motion-planning .

