ngm:acinq a owl:Class ;
    rdfs:label "ACINQ"@en ;
    rdfs:comment "ACINQ is a Paris-based Bitcoin technology company specialising in the development and operation of Lightning Network infrastructure, most notably the Eclair Lightning Network node implementation written in Scala and the Phoenix self-custodial mobile Bitcoin wallet. The company operates one of the largest publicly reachable Lightning Network routing nodes, providing significant liquidity and routing capacity to the network. ACINQ contributes to the BOLT (Basis of Lightning Technology) protocol specification process and has pioneered features such as trampoline routing to reduce the on-device computation required by mobile Lightning clients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eclair ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:core-lightning,
        ngm:lnd ;
    vc:enables ngm:micropayment,
        ngm:non-custodial-wallet,
        ngm:trampoline-routing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:eclair,
        ngm:phoenix-wallet ;
    vc:implements ngm:basis-of-lightning-technology,
        ngm:sphinx-routing ;
    vc:isPartOf ngm:lightning-network-ecosystem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-layer-2,
        ngm:bolt-12,
        ngm:channel-liquidity,
        ngm:routing-node ;
    vc:requires ngm:bitcoin,
        ngm:payment-channel ;
    vc:slug "acinq" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bitcoin-payment,
        ngm:splicing ;
    vc:uses ngm:htlc,
        ngm:onion-routing,
        ngm:scala-programming-language .

ngm:across-protocol a owl:Class ;
    rdfs:label "Across Protocol"@en ;
    rdfs:comment "Across Protocol is a decentralised cross-chain bridging protocol that uses an optimistic verification model and a network of liquidity providers—called relayers—to enable fast, capital-efficient transfers of ERC-20 tokens between Ethereum mainnet and Layer 2 networks such as Optimism, Arbitrum, and Polygon. Relayers front user funds immediately on the destination chain and are reimbursed from a liquidity pool on Ethereum after an optimistic challenge period, creating a bridge architecture that prioritises speed and low fees over trustless finality."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:dependsOn ngm:ethereum-smart-contract-platform,
        ngm:layer-2-solutions ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
