    vc:contrastsWith ngm:fungible-token,
        ngm:physical-asset ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-ledger ;
    vc:enables ngm:digital-ownership,
        ngm:peer-to-peer-trading,
        ngm:play-to-earn ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:in-game-item,
        ngm:nft,
        ngm:virtual-real-estate ;
    vc:isPartOf ngm:virtual-economy ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collectible,
        ngm:interoperability,
        ngm:metaverse-platform,
        ngm:procedural-generation ;
    vc:requires ngm:digital-identity,
        ngm:digital-wallet ;
    vc:slug "virtual-asset" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:erc-1155,
        ngm:erc-721 ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-hash,
        ngm:ipfs,
        ngm:smart-contract .

ngm:virtual-classroom a owl:Class ;
    rdfs:label "Virtual Classroom"@en ;
    rdfs:comment "An online learning environment that replicates a traditional classroom's interactive experience without physical boundaries, leveraging education technology to connect students and instructors through real-time engagement, collaboration tools, and shared learning materials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
