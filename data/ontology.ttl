# Light Client
blockchain:LightClient rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Light Client"@en ;
    rdfs:comment "Resource-efficient blockchain client that validates block headers and uses cryptographic proofs (Merkle proofs, state proofs) to verify transaction inclusion without downloading full blockchain state. Light clients enable trustless interaction from mobile devices, browsers, and IoT systems while requiring only megabytes of storage versus gigabytes for full nodes."@en ;
    skos:prefLabel "Light Client"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:light-client" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:light-client> ;
    vcw:contentHash "sha256-12-28dfb5c104e8" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-8010" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-8010" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:LightClient rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:CrossChainBridge
] .

# Lock and Mint Mechanism
blockchain:LockAndMintMechanism rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Lock and Mint Mechanism"@en ;
    rdfs:comment "Cross-chain asset transfer protocol where tokens are locked in a smart contract on the source chain and equivalent wrapped tokens are minted on the destination chain, maintaining a 1:1 backing ratio. Enables asset portability across heterogeneous blockchain ecosystems while preserving value equivalence."@en ;
    skos:prefLabel "Lock and Mint Mechanism"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:lock-and-mint-mechanism" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:lock-and-mint-mechanism> ;
    vcw:contentHash "sha256-12-ed47af57230c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-8011" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-8011" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:LockAndMintMechanism rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:Oracle
] .

blockchain:LockAndMintMechanism rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:WrappedToken
] .

blockchain:LockAndMintMechanism rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:CrossChainBridge
] .

# MEV
blockchain:Mev rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "MEV"@en ;
    rdfs:comment "Maximal Extractable Value (MEV) represents the profit that block producers can extract through strategic transaction ordering, inclusion, or exclusion within blocks, arising from their privileged position to control execution sequencing in blockchain networks."@en ;
    skos:prefLabel "MEV"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:mev" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:mev> ;
