    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:communication-protocol,
        ngm:digital-identity ;
    vc:slug "social-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:platform-governance,
        ngm:social-network-graph ;
    vc:uses ngm:content-moderation,
        ngm:user-interface .

ngm:social-token-economy a owl:Class ;
    rdfs:label "Social Token Economy"@en ;
    rdfs:comment "Economic model where communities issue tokens representing reputation, participation value, or creator-fan relationships, enabling decentralized governance and value distribution."@en ;
