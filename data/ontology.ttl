            owl:someValuesFrom ngm:actuators ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotic-process-automation ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:digital-twins,
        ngm:intelligent-agents ;
    vc:contrastsWith ngm:human-in-the-loop,
        ngm:manual-processes ;
