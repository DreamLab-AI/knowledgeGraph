    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:dao,
        ngm:dao-governance ;
    vc:slug "tele-252-dao-governance-telecollaboration" ;
    vc:sourceDomain "metaverse" .

ngm:term-index a owl:Class ;
    rdfs:label "TERM INDEX"@en ;
    rdfs:comment "A Term Index is a comprehensive reference catalogue mapping domain terminology, identifiers, and conceptual relationships within ontologies, enabling discovery and navigation of complex knowledge spaces across metaverse, blockchain, and robotics ecosystems. Well-structured indices provide hierarchical classification, cross-references, and semantic linking that facilitate knowledge retrieval, API design, and knowledge-graph integration, serving both user-facing navigation and machine-readable specifications supporting automated reasoning and SPARQL query optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:domain-ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:knowledge-graph,
        ngm:sparql ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:domain-ontology,
        ngm:ontology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:metaverse,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "term-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:third-party-vulnerability a owl:Class ;
    rdfs:label "Third-Party Vulnerability"@en ;
    rdfs:comment "A Third-Party Vulnerability is a security weakness originating in externally sourced software components, libraries, APIs, or services that are integrated into an AI system, creating risk vectors outside the direct control of the system developer or operator. Exploitation of these vulnerabilities can compromise model integrity, data confidentiality, or system availability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-auditor ],
        ngm:ai-governance-and-ethics,
        ngm:risk ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:enables ngm:adversarial-attack,
        ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:risk-management ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-security,
        ngm:cybersecurity,
        ngm:open-source-software,
        ngm:supply-chain,
        ngm:vulnerability ;
    vc:requires ngm:risk-assessment,
        ngm:third-party-auditor ;
    vc:slug "third-party-vulnerability" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:thorchain a owl:Class ;
    rdfs:label "THORChain"@en ;
    rdfs:comment "A decentralised cross-chain liquidity protocol that lets users swap native assets across different blockchains without wrapping them or relying on a single custodian. It uses bonded validators and liquidity pools denominated in its native asset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        ngm:cross-chain-bridge ;
    vc:enables ngm:atomic-swap,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool,
        ngm:validator ;
    vc:slug "thorchain" ;
    vc:sourceDomain "blockchain" .

ngm:tim-reutermann-decentralised-governance-thinker a owl:Class ;
    rdfs:label "Tim Reutermann Decentralised Governance Thinker"@en ;
    rdfs:comment "Tim Reutermann is a writer and technologist whose work synthesises cypherpunk philosophy, decentralised governance models, and AI-driven economic paradigm shifts. He advocates liquid democracy, universal basic income, and open-source systems as mechanisms for aligning economic incentives with social goods in the face of automation-driven disruption."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:cryptographic-privacy-activist,
        ngm:dao-governance ;
    vc:slug "tim-reutermann-decentralised-governance-thinker" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:decentralised-identity .

ngm:toxic-content-counter-narrative-system a owl:Class ;
    rdfs:label "Toxic Content Counter-Narrative System"@en ;
    rdfs:comment "Project BroBots is a multi-agent research initiative to identify, classify, and counter toxic online content using NLP-based harm detection and counter-narrative generation. It employs fine-tuned large language models on social media corpora, the Agentic Alliance tech stack, and is motivated by the harms of automated bot-driven misinformation and harassment across internet platforms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:death-of-the-internet,
        ngm:digital-society-harms ;
    vc:enables ngm:content-moderation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:active-research-projects-registry ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "toxic-content-counter-narrative-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:agents,
        ngm:decentralised-agent-coordination-initiative,
        ngm:natural-language-processing .

ngm:toxicity-detection a owl:Class ;
    rdfs:label "Toxicity Detection"@en ;
    rdfs:comment "Toxicity Detection is a machine learning discipline that automatically identifies harmful, abusive, or offensive language in user-generated content, typically using classifiers trained on annotated corpora of hate speech, threats, and harassment. It forms a core component of content moderation pipelines and operates at scale across social platforms, forums, and messaging systems. Toxicity detection systems must balance recall against false-positive rates to avoid over-censorship while protecting users from harm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:ai-application,
        ngm:content-moderation ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ai-safety,
        ngm:content-moderation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:bias-detection-methods,
        ngm:red-teaming ;
    vc:requires ngm:machine-learning-discipline-model,
        ngm:natural-language-processing ;
    vc:slug "toxicity-detection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-and-ethics ;
    vc:uses ngm:deep-learning,
        ngm:large-language-models,
        ngm:sentiment-analysis .

ngm:tracked-robot a owl:Class ;
    rdfs:label "Tracked Robot"@en ;
    rdfs:comment "A Tracked Robot is a ground mobile robot that uses continuous loop tracks—analogous to those on military tanks—rather than wheels to achieve locomotion. The large contact surface area of the track distributes the robot's weight, providing superior traction and stability on uneven, soft, or obstacle-dense terrain such as rubble, mud, stairs, and gravel. Tracked robots are widely deployed in search-and-rescue, military reconnaissance, inspection, and agricultural automation where wheeled platforms would lose grip or become immobilised."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        ngm:ground-robot ;
    vc:contrastsWith ngm:legged-robot,
        ngm:wheeled-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lidar ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inspection-robot,
        ngm:mobile-robot,
        ngm:rescue-robot ;
    vc:requires ngm:path-planning ;
    vc:slug "tracked-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:perception-system,
        ngm:slam .

ngm:traditional-carbon-registry a owl:Class ;
    rdfs:label "Traditional Carbon Registry"@en ;
    rdfs:comment "A traditional carbon registry is a centralised database that records the issuance, ownership, transfer and retirement of carbon credits to prevent double counting in carbon markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-registry ],
