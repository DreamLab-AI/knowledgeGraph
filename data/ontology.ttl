ngm:public-key-infrastructure a owl:Class ;
    rdfs:label "Public Key Infrastructure"@en ;
    rdfs:comment "Public Key Infrastructure (PKI) is the integrated set of roles, policies, hardware, software, and procedures used to create, manage, distribute, use, store, and revoke digital certificates and manage public-key encryption. PKI binds public keys to verified entity identities through a hierarchical trust chain anchored by Certificate Authorities (CAs), enabling secure authentication, data integrity, and confidential communication across distributed and internet-scale systems. It forms the foundational security layer for TLS/HTTPS, code signing, S/MIME email encryption, VPN access, and emerging decentralised identity frameworks. PKI standards are governed principally by IETF RFCs (X.509, PKIX), NIST guidelines, CA/Browser Forum Baseline Requirements, and ISO/IEC 27001 family controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:online-certificate-status-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asymmetric-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:certificate-revocation-list ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:root-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:cryptographic-infrastructure ;
    vc:bridgesTo ngm:blockchain-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:decentralised-identifier,
        ngm:web-of-trust ;
    vc:enables ngm:code-signing,
        ngm:digital-identity,
        ngm:encrypted-email,
        ngm:mutual-authentication,
        ngm:non-repudiation,
        ngm:transport-layer-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:certificate-authority,
        ngm:certificate-revocation-list,
        ngm:digital-certificate,
        ngm:online-certificate-status-protocol,
        ngm:registration-authority,
        ngm:root-certificate ;
    vc:implements ngm:rfc-5280,
        ngm:x509-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:encryption,
        ngm:post-quantum-cryptography ;
    vc:requires ngm:asymmetric-cryptography,
        ngm:cryptographic-keys,
        ngm:digital-signature,
        ngm:hash-function ;
    vc:slug "public-key-infrastructure" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ca-browser-forum,
        ngm:internet-engineering-task-force,
        ngm:nist ;
    vc:supports ngm:identity-and-access-management,
        ngm:secure-communication,
        ngm:zero-trust-architecture .

ngm:augmented-reality a owl:Class ;
    rdfs:label "Augmented Reality"@en ;
    rdfs:comment "Augmented Reality (AR) is a technology that overlays digital content onto the real world in real-time, enhancing users' perception of their physical environment through smartphones, head-mounted displays, or smart glasses. AR systems require coupling of real and virtual environments, real-time interaction, and precise 3D registration of virtual objects aligned with physical space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:marker-based-tracking ],
        ngm:extended-reality ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:dependsOn ngm:edge-computing,
        ngm:gpu,
        ngm:simultaneous-localisation-and-mapping ;
    vc:enables ngm:immersive-experiences,
        ngm:industrial-maintenance,
        ngm:remote-assistance,
        ngm:surgical-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:marker-based-tracking,
        ngm:spatial-mapping ;
    vc:isPartOf ngm:metaverse,
        ngm:spatial-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gesture-recognition,
        ngm:scene-understanding ;
    vc:requires ngm:computer-vision,
        ngm:inertial-measurement-unit,
        ngm:real-time-rendering ;
    vc:slug "augmented-reality" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:open-xr,
        ngm:web-xr ;
    vc:supports ngm:digital-twin,
        ngm:remote-collaboration ;
    vc:uses ngm:depth-sensor,
        ngm:head-mounted-display,
        ngm:machine-learning .

