        ngm:reinforcement-learning,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collision-detection,
        ngm:event-loop,
        ngm:physics-engine,
        ngm:scene-graph ;
    vc:isPartOf ngm:digital-twin-platform,
