        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:beam-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:subword-tokenisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-text-tokenisation ],
        ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:content-delivery,
        ngm:localisation,
        ngm:real-time-interpretation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:beam-search,
        ngm:decoder,
        ngm:encoder,
        ngm:language-model,
        ngm:parallel-corpus,
        ngm:tokeniser ;
    vc:implements ngm:back-translation,
        ngm:beam-search-decoding,
        ngm:byte-pair-encoding,
        ngm:contrastive-learning,
        ngm:knowledge-distillation,
        ngm:mixture-of-experts-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.52"^^xsd:float ;
