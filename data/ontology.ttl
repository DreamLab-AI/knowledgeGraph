    vc:supports ngm:medical-imaging ;
    vc:uses ngm:data-interoperability,
        ngm:hl7-fhir .

ngm:esg-investing a owl:Class ;
    rdfs:label "ESG Investing"@en ;
    rdfs:comment "ESG Investing is an investment methodology that systematically integrates Environmental, Social, and Governance criteria into the analysis, selection, and management of portfolios, enabling investors to assess material sustainability risks and ethical impact alongside conventional financial returns. Environmental factors encompass carbon emissions, resource consumption, and climate transition exposure; social factors cover labour practices, supply-chain conditions, human rights, and community impact; governance factors evaluate board composition, executive remuneration, audit independence, and shareholder rights. ESG signals are incorporated through negative screening, positive best-in-class selection, engagement and proxy voting, or the construction of fully ESG-integrated thematic funds, each reflecting different theories of how non-financial data predicts long-run financial performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:esg ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:corporate-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:materiality-assessment ],
        ngm:sustainable-finance ;
    vc:bridgesTo ngm:carbon-credits,
        ngm:decentralised-autonomous-organisation,
        ngm:tokenization ;
    vc:contrastsWith ngm:conventional-investing,
        ngm:greenwashing ;
    vc:dependsOn ngm:esg ;
    vc:enables ngm:green-bond-market,
        ngm:impact-measurement,
        ngm:stewardship ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:corporate-governance ;
    vc:isPartOf ngm:impact-investing,
        ngm:sustainable-finance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:green-finance,
        ngm:sustainability ;
    vc:requires ngm:esg,
        ngm:materiality-assessment ;
    vc:slug "esg-investing" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:gri-standards,
        ngm:sfdr,
        ngm:tcfd ;
    vc:supports ngm:climate-risk-management,
        ngm:governance,
        ngm:sustainable-development-goals ;
    vc:uses ngm:on-chain-voting,
        ngm:sanctions-screening,
        ngm:stakeholder-engagement .

ngm:event-sourcing a owl:Class ;
    rdfs:label "Event Sourcing"@en ;
    rdfs:comment "Event sourcing is an architectural pattern for data persistence in which the state of a system is stored not as a mutable current-state record but as an append-only, ordered log of discrete domain events — each representing a fact that occurred at a specific point in time. Current application state is derived by replaying the event log from the beginning (or from a periodic snapshot), making the full history of state transitions a first-class, queryable artefact. This contrasts with CRUD-oriented architectures where only the latest state is stored, discarding historical change information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:idempotency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:snapshot ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:agent-memory,
        ngm:distributed-ledger ;
    vc:enables ngm:agent-event-stream,
        ngm:retroactive-correction,
        ngm:state-management,
        ngm:temporal-query ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-projection,
        ngm:snapshot ;
    vc:implements ngm:cqrs,
        ngm:immutability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:domain-driven-design,
        ngm:event-driven-architecture,
        ngm:microservices-architecture,
        ngm:write-ahead-logging ;
    vc:requires ngm:event-store,
        ngm:idempotency ;
    vc:slug "event-sourcing" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:eventual-consistency,
        ngm:optimistic-concurrency-control ;
    vc:uses ngm:apache-kafka,
        ngm:append-only-log,
        ngm:data-persistence,
        ngm:eventstoredb,
        ngm:message-queue .

ngm:fault-tree-analysis a owl:Class ;
    rdfs:label "Fault Tree Analysis"@en ;
    rdfs:comment "Fault Tree Analysis (FTA) is a top-down, deductive reliability and safety method that models how combinations of component failures and events can lead to a defined undesired top-level event. Using Boolean logic gates to connect basic events, it identifies minimal cut sets — the smallest combinations of failures sufficient to cause the top event — and can be evaluated qualitatively or quantitatively with probabilities. Originating in aerospace and nuclear engineering, FTA is a cornerstone of system safety, risk assessment, and certification across safety-critical industries."@en ;
    rdfs:subClassOf ngm:risk-assessment ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:failure-mode-and-effects-analysis ;
    vc:enables ngm:probabilistic-risk-assessment,
        ngm:safety-certification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hazard-analysis,
        ngm:safety-evaluation ;
    vc:requires ngm:system-model ;
    vc:slug "fault-tree-analysis" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:mil-std-882 ;
    vc:supports ngm:functional-safety,
        ngm:reliability-engineering ;
    vc:uses ngm:boolean-algebra .

ngm:finite-element-analysis a owl:Class ;
    rdfs:label "Finite Element Analysis"@en ;
    rdfs:comment "Finite Element Analysis (FEA) is a numerical method for approximating solutions to physical field problems by subdividing a continuous domain into a mesh of small, simple elements and assembling their local equations into a global system. It is widely used in engineering to predict structural stress, deformation, heat transfer, vibration and electromagnetic behaviour. FEA is a core technique in computer-aided engineering, enabling virtual testing of designs before physical prototypes are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:numerical-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cad-software ],
        ngm:numerical-methods ;
    vc:bridgesTo ngm:physics-simulation ;
    vc:enables ngm:digital-twin,
        ngm:physics-simulation,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:physics-simulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cad-software,
        ngm:digital-twin,
        ngm:material-system ;
    vc:requires ngm:cad-software,
        ngm:numerical-methods ;
    vc:slug "finite-element-analysis" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:material-system,
        ngm:soft-robotics ;
    vc:uses ngm:numerical-methods,
        ngm:simulation .

ngm:heuristic-methods a owl:Class ;
    rdfs:label "Heuristic Methods"@en ;
    rdfs:comment "Heuristic methods in AI are problem-solving approaches that employ practical, experience-based techniques to find satisfactory solutions when optimal solutions are computationally infeasible. They include search heuristics such as A* and hill climbing, rule-of-thumb strategies, and metaheuristics such as genetic algorithms and simulated annealing, trading completeness for efficiency in combinatorial optimisation and planning tasks."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:robotics,
        ngm:supply-chain ;
    vc:dependsOn ngm:search-algorithm,
        ngm:state-space-representation ;
    vc:enables ngm:automated-planning,
        ngm:constraint-satisfaction,
        ngm:pathfinding-algorithm,
        ngm:planning-and-scheduling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:local-search ;
    vc:implements ngm:genetic-algorithm,
        ngm:simulated-annealing ;
    vc:isPartOf ngm:artificial-intelligence ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computational-complexity-theory,
        ngm:planning-and-scheduling,
        ngm:probabilistic-reasoning ;
    vc:slug "heuristic-methods" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:decision-making,
        ngm:machine-learning ;
    vc:uses ngm:optimization-algorithm,
        ngm:search-algorithms .

ngm:importance-sampling a owl:Class ;
    rdfs:label "Importance Sampling"@en ;
    rdfs:comment "Importance sampling is a variance-reduction technique in Monte Carlo estimation that draws samples from a proposal distribution that concentrates probability mass in regions contributing most to the quantity being estimated, then corrects for the distributional mismatch using importance weights. It is foundational to Bayesian inference, reinforcement learning, path-tracing renderers, and off-policy evaluation. Importance sampling allows tractable estimation of expectations under distributions that are difficult or impossible to sample from directly. Poor choice of proposal distribution can however lead to high-variance or even infinite-variance estimators, necessitating careful design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        ngm:monte-carlo-methods ;
    vc:bridgesTo ngm:particle-filter,
        ngm:path-tracing ;
    vc:contrastsWith ngm:rejection-sampling ;
    vc:enables ngm:bayesian-inference,
        ngm:reinforcement-learning,
        ngm:variance-reduction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:effective-sample-size,
        ngm:markov-chain-monte-carlo,
        ngm:monte-carlo-tree-search,
        ngm:optimization-algorithm,
        ngm:state-estimation ;
    vc:requires ngm:probability-distribution ;
    vc:slug "importance-sampling" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:gradient-descent,
        ngm:policy-gradient-methods,
        ngm:sequential-monte-carlo ;
    vc:uses ngm:probabilistic-model,
        ngm:proposal-distribution,
        ngm:sampling,
        ngm:variational-inference .

ngm:instruction-following-conversational-ai-system a owl:Class ;
    rdfs:label "Instruction-Following Conversational AI System"@en ;
    rdfs:comment "An instruction-following conversational AI system is a natural language processing architecture trained to interpret, decompose, and execute open-ended user directives within a multi-turn dialogue context, producing contextually coherent and task-appropriate responses. Such systems combine large-scale pre-training on diverse corpora with alignment techniques — notably reinforcement learning from human feedback (RLHF) and instruction fine-tuning — to bridge the gap between raw language modelling capability and safe, helpful behaviour. They are distinguished from earlier rule-based chatbots by their generalisation across task types (summarisation, coding, question-answering, reasoning) without requiring task-specific engineering. Representative instances include OpenAI's ChatGPT, Google's Gemini, and Anthropic's Claude."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        ngm:conversational-ai ;
    vc:bridgesTo ngm:eu-ai-act-regulatory-instrument,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:chatbot,
        ngm:dialogue-system ;
    vc:enables ngm:agentic-workflow,
        ngm:ai-agents,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:dialogue-management,
        ngm:natural-language-understanding ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:constitutional-ai-training-methodology-language-model-family,
        ngm:gemini-multimodal-language-model,
        ngm:gpt,
        ngm:hallucination ;
    vc:requires ngm:alignment-techniques,
        ngm:compute-infrastructure,
        ngm:human-feedback ;
    vc:slug "instruction-following-conversational-ai-system" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:openai-research-organisation ;
    vc:supports ngm:code-generation,
        ngm:document-summarisation ;
    vc:uses ngm:fine-tuning,
        ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:pre-training,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transformer .

ngm:inter-agent-communication a owl:Class ;
    rdfs:label "Inter-Agent Communication"@en ;
    rdfs:comment "Inter-Agent Communication (IAC) is the set of protocols, message formats, and transport mechanisms through which autonomous software agents exchange information, coordinate tasks, delegate subtasks, share observations, and negotiate commitments in multi-agent systems. It spans classical symbolic AI frameworks (FIPA ACL, KQML) and contemporary LLM-based architectures (Model Context Protocol, Agent2Agent Protocol, tool-calling schemas), defining the content language (what is expressed), the interaction protocol (how exchanges are sequenced), and the transport layer (how messages are delivered). Effective IAC enables heterogeneous agents built on different underlying models to collaborate without shared internal state, encompassing message authentication, semantic interoperability, context propagation, and trust boundaries between agents of differing capability and provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:multi-agent-system ;
    vc:bridgesTo ngm:microservices,
        ngm:service-oriented-architecture ;
    vc:contrastsWith ngm:monolithic-ai,
        ngm:single-agent-system ;
    vc:enables ngm:agentic-ai,
        ngm:agentic-workflow,
        ngm:orchestration,
        ngm:task-delegation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:fipa-acl,
        ngm:kqml ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent2-agent-protocol,
        ngm:distributed-systems,
        ngm:message-passing,
        ngm:semantic-interoperability,
        ngm:speech-act-theory ;
    vc:requires ngm:agent-identity,
        ngm:authentication,
        ngm:context-window ;
    vc:slug "inter-agent-communication" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:autonomous-agent,
        ngm:multi-agent-system,
        ngm:swarm-intelligence ;
    vc:uses ngm:function-calling,
        ngm:json-data-interchange-format-schema,
        ngm:model-context-protocol,
        ngm:rest-api,
        ngm:tool-use,
        ngm:websocket .

ngm:interest-rate a owl:Class ;
    rdfs:label "Interest Rate"@en ;
    rdfs:comment "An interest rate is the price of borrowing money or the return on lending it, expressed as a percentage of the principal over a defined period, typically annualised. It compensates lenders for the time value of money, expected inflation, and the credit risk of the borrower, and it acts as the principal lever through which central banks transmit monetary policy to the broader economy. Interest rates are categorised as nominal or real, fixed or floating, and short-term or long-term, with the term structure across maturities forming the yield curve."@en ;
    rdfs:subClassOf ngm:monetary-policy ;
    vc:dependsOn ngm:central-banking,
        ngm:inflation ;
    vc:enables ngm:quantitative-easing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:monetary-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-banking,
        ngm:credit-risk,
        ngm:gross-domestic-product,
        ngm:inflation,
        ngm:quantitative-easing ;
    vc:requires ngm:credit-risk ;
    vc:slug "interest-rate" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:fiscal-policy ;
    vc:uses ngm:gross-domestic-product .

ngm:inventory-management a owl:Class ;
    rdfs:label "Inventory Management"@en ;
    rdfs:comment "Inventory Management is the discipline of ordering, storing, tracking and controlling the stock of goods, components and materials an organisation holds across its supply chain. It seeks to balance the cost of holding stock against the risk of stock-outs, using forecasting, reorder policies and real-time visibility of quantities and locations. Modern implementations integrate barcodes, RFID and digital identifiers so that physical items can be reconciled against system records continuously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain-visibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:demand-forecasting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        ngm:supply-chain-management ;
    vc:bridgesTo ngm:supply-chain-visibility ;
    vc:dependsOn ngm:demand-forecasting ;
    vc:enables ngm:procurement,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-tracking,
        ngm:demand-forecasting ;
    vc:isPartOf ngm:logistics,
        ngm:supply-chain-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:logistics,
        ngm:procurement ;
    vc:requires ngm:supply-chain-visibility,
        ngm:traceability ;
    vc:slug "inventory-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:enterprise-resource-planning ;
    vc:uses ngm:barcode,
        ngm:digital-product-passport,
        ngm:rfid .

ngm:maximum-likelihood-estimation a owl:Class ;
    rdfs:label "Maximum Likelihood Estimation"@en ;
    rdfs:comment "Maximum Likelihood Estimation (MLE) is a method of estimating the parameters of a statistical model by choosing the parameter values that maximise the likelihood of the observed data under the model. Equivalently it minimises the negative log-likelihood, connecting it directly to many machine-learning loss functions. As a principled, asymptotically efficient estimator it underlies a large share of classical statistics and probabilistic machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sampling ],
        ngm:statistics ;
    vc:contrastsWith ngm:variational-inference ;
    vc:enables ngm:generative-model,
        ngm:system-identification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:regression ;
    vc:isPartOf ngm:statistics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:information-theory,
        ngm:probability-theory,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:sampling ;
    vc:slug "maximum-likelihood-estimation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:machine-learning,
        ngm:uncertainty-quantification ;
    vc:uses ngm:optimisation .

ngm:model-weights a owl:Class ;
    rdfs:label "Model Weights"@en ;
    rdfs:comment "The learnable numerical parameters in a neural network that encode the connection strengths adjusted during training via backpropagation to minimise loss. Model weights constitute the primary artefact of training and are the target of fine-tuning, quantisation, pruning, and transfer learning; their distribution and magnitude critically determine model capability and safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:weight-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:federated-learning,
        ngm:intellectual-property-rights-framework ;
    vc:contrastsWith ngm:model-architecture ;
    vc:dependsOn ngm:loss-function,
        ngm:optimiser ;
    vc:enables ngm:fine-tuning,
        ngm:inference,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bias,
        ngm:weight-matrix ;
    vc:isPartOf ngm:deep-learning,
        ngm:neural-network ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:interpretability,
        ngm:model-serialisation,
        ngm:network-architecture ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent,
        ngm:training ;
    vc:slug "model-weights" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-22989-2022,
        ngm:nist-ai-rmf ;
    vc:supports ngm:model-compression,
        ngm:pruning,
        ngm:quantisation .

ngm:multi-signature-wallet a owl:Class ;
    rdfs:label "Multi-Signature Wallet"@en ;
    rdfs:comment "A multi-signature wallet is a cryptographic account on a blockchain network that requires M-of-N authorisation — where a minimum of M private key holders out of a total of N authorised signers must collectively sign a transaction before it is considered valid and broadcast to the network. This threshold scheme eliminates single points of failure in asset custody, distributing the risk of key compromise or loss across multiple independent parties or hardware devices. Multi-signature wallets are widely deployed for treasury management, DAO governance, and exchange hot wallets, and are implemented both as native Bitcoin script constructs and as smart contracts on EVM-compatible chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timelock-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-signing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:digital-wallet ;
    vc:bridgesTo ngm:account-abstraction,
        ngm:multi-party-computation ;
    vc:contrastsWith ngm:custodial-wallet,
        ngm:single-key-wallet ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:digital-signature,
        ngm:key-management ;
    vc:enables ngm:dao-governance,
        ngm:institutional-custody,
        ngm:multi-sig-governance,
        ngm:social-recovery,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:quorum,
