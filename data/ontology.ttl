    vc:bridgesTo ngm:decentralised-finance,
        ngm:internet-of-things,
        ngm:virtual-economy ;
    vc:contrastsWith ngm:traditional-banking ;
    vc:dependsOn ngm:blockchain-infrastructure,
        ngm:lightning-network ;
    vc:enables ngm:content-monetisation,
