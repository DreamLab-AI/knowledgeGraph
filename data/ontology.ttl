ngm:medical-robotics a owl:Class ;
    rdfs:label "Medical Robotics"@en ;
    rdfs:comment "Medical Robotics is the application of robotic systems to clinical and surgical settings, encompassing robot-assisted surgery, rehabilitation robotics, diagnostic automation, and hospital logistics. These systems extend clinician precision, reduce invasiveness, and enable procedures at scales or locations beyond unaided human capability. Medical robots must meet rigorous safety, sterilisation, and regulatory standards before clinical deployment. The field intersects robotics engineering, clinical medicine, and regulatory science."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
