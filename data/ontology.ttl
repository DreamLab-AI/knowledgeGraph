ngm:dispute-resolution-mechanism a owl:Class ;
    rdfs:label "Dispute Resolution Mechanism"@en ;
    rdfs:comment "Agreed process and framework for resolving conflicts between metaverse participants through mediation, arbitration, or other structured resolution mods."@en ;
