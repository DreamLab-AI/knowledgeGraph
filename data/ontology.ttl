    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:algorithmic-fairness,
        ngm:data-minimisation,
        ngm:explainable-ai,
        ngm:federated-learning ;
    vc:requires ngm:cryptographic-primitive,
        ngm:data-governance-framework,
        ngm:sensitivity-analysis,
        ngm:trusted-execution-environment ;
    vc:slug "privacy-preserving-analytics" ;
    vc:sourceDomain "artificial-intelligence" ;
