    vc:slug "routing-protocol" ;
    vc:sourceDomain "distributed-systems" .

ngm:royalty-distribution a owl:Class ;
    rdfs:label "Royalty Distribution"@en ;
    rdfs:comment "Automated, trustless distribution of royalty payments to creators and rights-holders via blockchain smart contracts, triggered on every secondary-market sale or licensing event, enforcing on-chain revenue sharing without intermediaries and enabling programmable intellectual property economics."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:decentralized-finance-de-fi,
        ngm:digital-rights-management,
        ngm:erc-721,
        ngm:nft,
        ngm:nft-ownership-proof,
        ngm:royalty-mechanism ;
    vc:slug "royalty-distribution" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract,
        ngm:smart-contract-execution .

ngm:safetensors a owl:Class ;
    rdfs:label "Safetensors"@en ;
    rdfs:comment "Safetensors is a secure, simple, and fast file format for storing and loading neural network tensor weights, developed by Hugging Face as a safe alternative to Python's pickle-based serialisation. The format stores tensor metadata in a JSON header followed by raw binary data, enabling zero-copy memory-mapped loading without executing arbitrary code during deserialisation."@en ;
    rdfs:subClassOf ngm:data-serialization ;
    vc:enables ngm:ai-model-inference-engine,
        ngm:model-checkpoint ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:hugging-face-model-hub,
        ngm:safetensors-format ;
    vc:slug "safetensors" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hugging-face,
        ngm:model-weights .

ngm:safety-evaluation a owl:Class ;
    rdfs:label "Safety Evaluation"@en ;
    rdfs:comment "Safety evaluation is the systematic assessment of whether an AI system behaves acceptably under a defined threat and risk model, measuring propensities for harmful outputs, susceptibility to misuse, robustness under adversarial pressure, and the presence of dangerous capabilities. It combines automated benchmarks, red-teaming, and structured human review to produce evidence used in deployment decisions and governance reporting. Distinct from capability evaluation, safety evaluation asks not only what a model can do but how reliably it refrains from causing harm."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment ;
    vc:slug "safety-evaluation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-safety ;
    vc:uses ngm:red-teaming .

ngm:search-index a owl:Class ;
    rdfs:label "Search Index"@en ;
    rdfs:comment "A data structure that maps terms, embeddings, or attributes to document locations, enabling rapid retrieval of relevant content from large metaverse asset catalogues through inverted indexes, vector indexes, or hybrid approaches."@en ;
    rdfs:subClassOf ngm:data-structure,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:fast-query-response ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:security-infrastructure a owl:Class ;
    rdfs:label "Security Infrastructure"@en ;
    rdfs:comment "Security infrastructure encompasses the integrated set of hardware, software, processes, and policies that protect an organisation's information systems, networks, and data assets from unauthorised access, disruption, and exploitation. It includes perimeter defences, identity and access management systems, cryptographic key management, endpoint protection, monitoring and detection platforms, and incident response capabilities. Effective security infrastructure is layered—applying defence-in-depth principles so that compromise of any single control does not expose the entire system. Modern security infrastructure increasingly adopts zero-trust architectural principles, eliminating implicit trust based on network location and requiring continuous verification of every access request. Security infrastructure must align with regulatory requirements and evolve continuously in response to the changing threat landscape."@en ;
    rdfs:subClassOf ngm:security-framework ;
    vc:enables ngm:identity-and-access-management,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:vulnerability,
        ngm:zero-trust-architecture ;
    vc:slug "security-infrastructure" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:audit-trail,
        ngm:nist ;
    vc:uses ngm:access-control,
        ngm:authentication,
        ngm:cryptographic-key-management .

ngm:segmentation-and-identification a owl:Class ;
    rdfs:label "Segmentation and Identification"@en ;
    rdfs:comment "Segmentation and Identification is a foundational computer vision subdomain encompassing the computational processes of partitioning digital images and video frames into semantically meaningful regions and assigning categorical or instance-level identities to those regions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-object-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-pyramid-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:panoptic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:annotated-training-data ],
        ngm:ai-application,
        ngm:computer-vision,
        ngm:object-recognition ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ar-content-removal,
        ngm:autonomous-driving-perception,
        ngm:industrial-quality-control,
        ngm:medical-image-analysis,
        ngm:satellite-earth-observation,
        ngm:surgical-robotics-vision,
        ngm:video-editing-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:instance-segmentation,
        ngm:mask-decoder,
        ngm:medical-segmentation,
        ngm:open-vocabulary-segmentation,
        ngm:panoptic-segmentation,
        ngm:pixel-classification-head,
        ngm:promptable-segmentation,
        ngm:semantic-segmentation,
        ngm:video-object-segmentation ;
    vc:implements ngm:deep-lab,
        ngm:detr,
        ngm:grounded-sam,
        ngm:mask-r-cnn,
        ngm:mask2-former,
        ngm:med-sam,
        ngm:nn-unet,
        ngm:owlv2,
        ngm:panoptic-fpn,
        ngm:sam-2,
        ngm:seg-former,
        ngm:segment-anything-model,
        ngm:x-decoder ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:ai-diagram-tools,
        ngm:comfy-ui,
        ngm:computer-vision,
        ngm:human-tracking-and-slam-capture ;
    vc:requires ngm:annotated-training-data,
        ngm:backbone-network,
        ngm:convolutional-neural-network,
        ngm:feature-pyramid-network,
        ngm:gpu-acceleration,
        ngm:transformer-architecture ;
    vc:slug "segmentation-and-identification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:cityscapes-evaluation,
        ngm:coco-benchmark,
        ngm:medical-segmentation-decathlon,
        ngm:pascal-voc-protocol ;
    vc:supports ngm:ade20-k,
        ngm:bdd100-k,
        ngm:cityscapes-benchmark,
        ngm:coco-dataset,
        ngm:medical-segmentation-decathlon,
        ngm:nu-scenes ;
    vc:uses ngm:cross-entropy-loss,
        ngm:dice-loss,
        ngm:hungarian-matching,
        ngm:io-u-metric,
        ngm:mean-average-precision,
        ngm:panoptic-quality-metric .

ngm:sensor-input a owl:Class ;
    rdfs:label "Sensor Input"@en ;
    rdfs:comment "Sensor input refers to the raw or pre-processed signals acquired from physical or virtual transducers that convert observable environmental quantities—position, force, temperature, light intensity, pressure, chemical concentration—into electrical or digital representations suitable for computation. It constitutes the primary interface between an autonomous system and its environment, providing the perceptual foundation for state estimation, feedback control, and situational awareness. Sensor inputs vary by modality, sampling rate, resolution, and noise characteristics, and effective use requires calibration, filtering, and often fusion with complementary modalities to produce reliable world-state estimates."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:perception-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:sensor-data,
        ngm:sensor-system,
        ngm:sensor-technology ;
    vc:slug "sensor-input" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-system,
        ngm:control-system ;
    vc:uses ngm:digital-signal-processing,
        ngm:real-time-computation .

ngm:series-elastic-actuation a owl:Class ;
    rdfs:label "Series Elastic Actuation"@en ;
    rdfs:comment "Series Elastic Actuation (SEA) is a robotic actuation paradigm in which a calibrated compliant element—typically a torsional or linear spring—is interposed between the gearbox output and the robot link. Deflection of the spring under load provides an indirect force measurement, enabling closed-loop torque control without strain-gauge complexity. The compliance also attenuates shock loads, reduces reflected inertia at the joint, and passively limits peak interaction forces, which is critical for safe operation in human-robot collaborative environments. SEA is widely employed in legged robots, prosthetic limbs, and rehabilitation exoskeletons where stable force regulation and back-driveability are essential."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-control,
        ngm:impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "series-elastic-actuation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robo-human-robot-interaction ;
    vc:uses ngm:actuator,
        ngm:robot-joint .

ngm:settlement a owl:Class ;
    rdfs:label "Settlement"@en ;
    rdfs:comment "The final and irreversible transfer of an asset from one party to another that discharges the obligation arising from a trade or payment."@en ;
    rdfs:subClassOf ngm:financial-infrastructure-domain ;
    vc:enables ngm:atomic-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "settlement" ;
    vc:sourceDomain "blockchain" .

ngm:sha-256-hashing a owl:Class ;
    rdfs:label "SHA-256 Hashing"@en ;
    rdfs:comment "SHA-256 Hashing refers to the application of the SHA-256 (Secure Hash Algorithm 256-bit) cryptographic hash function — a member of the SHA-2 family standardised by NIST in 2001 — to produce a fixed-length 256-bit (32-byte) message digest from an arbitrary-length input, with the properties of determinism, pre-image resistance, second pre-image resistance, and collision resistance. The algorithm operates via 64 rounds of bit manipulation, modular addition, and nonlinear functions over a 512-bit block schedule. SHA-256 is the foundational hash function of Bitcoin's proof-of-work mining, block header commitments, and Merkle tree construction, as well as a critical primitive in TLS, code signing, and certificate transparency."@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    vc:enables ngm:bitcoin-mining,
        ngm:data-integrity,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:merkle-tree,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "sha-256-hashing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:blockchain-security,
        ngm:cryptographic-hash .

ngm:simulation-software a owl:Class ;
    rdfs:label "Simulation Software"@en ;
    rdfs:comment "Application software that constructs and executes computational models of physical, biological, or social systems, allowing experimental manipulation of parameters to study behaviour over time. Simulation software spans physics engines, agent-based frameworks, and digital twin environments, and is used across engineering, scientific research, training, and metaverse development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:simulation-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:simulation-engine ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:slug "simulation-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:rendering-engine .

ngm:spatial-anchors a owl:Class ;
    rdfs:label "Spatial Anchors"@en ;
    rdfs:comment "Virtual reference points that bind digital content to specific physical locations in augmented reality environments, using sensor fusion from cameras, GPS, and accelerometers to maintain persistent positioning and orientation of virtual objects relative to real-world spaces."@en ;
    rdfs:subClassOf ngm:ar-technology,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:persistent-ar-placement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-anchors" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-audio-system a owl:Class ;
    rdfs:label "Spatial Audio System"@en ;
    rdfs:comment "An integrated audio technology framework creating three-dimensional soundscapes for VR, AR, and metaverse applications by simulating sound direction, distance, and environmental acoustics, enabling realistic audio experiences that respond dynamically to user movement and head orientation."@en ;
    rdfs:subClassOf ngm:immersive-audio-technology,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-sound-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-audio-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-computing-domain a owl:Class ;
    rdfs:label "Spatial Computing Domain"@en ;
    rdfs:comment "The Spatial Computing Domain classifies concepts concerning computation that perceives, represents and acts within three-dimensional physical or virtual space. It covers tracking, mapping, registration and the rendering of content aligned to the environment. As a sub-domain of the Metaverse Domain it provides the spatial substrate on which augmented and virtual experiences are constructed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pose-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-graphics-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artificial-intelligence-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-understanding ],
        ngm:metaverse-domain ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:coordinate-registration,
        ngm:pose-tracking,
        ngm:scene-understanding,
        ngm:spatial-anchor,
        ngm:spatial-mapping ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:artificial-intelligence-domain,
        ngm:computer-graphics-domain ;
    vc:slug "spatial-computing-domain" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-presence a owl:Class ;
    rdfs:label "Spatial Presence"@en ;
    rdfs:comment "The psychological state of feeling physically located within a virtual environment, experiencing the sense of \"being there\" despite technological mediation, influenced by place illusion (perceived location), plausibility illusion (believable events), and temporal presence (immediacy of experience)."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:vr-psychology ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-presence" ;
    vc:sourceDomain "spatial-computing" .

ngm:speech-synthesis a owl:Class ;
    rdfs:label "SpeechSynthesis"@en ;
    rdfs:comment "Speech synthesis, or text-to-speech (TTS), is the artificial generation of human speech from text or linguistic representations using computational models that map phonetic, prosodic, and acoustic features to waveform output. Modern neural TTS systems use end-to-end deep learning pipelines—typically a text front-end, an acoustic model (Tacotron, FastSpeech, or diffusion-based), and a neural vocoder (WaveNet, HiFi-GAN, Vocos)—to produce speech that is perceptually natural, expressive, and stylistically controllable. Speech synthesis underpins screen readers, virtual assistants, navigation systems, voice cloning tools, and interactive conversational agents, and its quality is now at or approaching human parity on standard benchmarks for many languages."@en ;
    rdfs:subClassOf ngm:text-to-speech ;
    vc:enables ngm:speech-and-voice,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:voice-cloning ;
    vc:slug "speech-synthesis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:stakeholder-analysis a owl:Class ;
    rdfs:label "Stakeholder Analysis"@en ;
    rdfs:comment "Stakeholder analysis is a systematic methodology for identifying, mapping, and evaluating the individuals, groups, and organisations that have an interest in—or are affected by—a system, project, or policy, assessing their interests, power, influence, and potential impact on outcomes. It is a foundational practice in requirements engineering, impact assessment, governance design, and change management, enabling decision-makers to anticipate conflicts, prioritise engagement, and design participation mechanisms that are inclusive and legitimate. In AI and technology contexts, stakeholder analysis extends to affected communities who may not self-identify or organise, requiring proactive identification of indirect and diffuse impacts."@en ;
    rdfs:subClassOf ngm:stakeholder ;
    vc:enables ngm:ai-impact-assessment,
        ngm:privacy-impact-assessment,
        ngm:stakeholder-engagement-in-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment,
        ngm:stakeholder-engagement,
        ngm:stakeholder-trust ;
    vc:slug "stakeholder-analysis" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:participatory-policy-making .

ngm:stakeholder-trust a owl:Class ;
    rdfs:label "Stakeholder Trust"@en ;
    rdfs:comment "Stakeholder trust is the confident reliance that individuals, groups, or organisations — including users, operators, regulators, and affected communities — place in a system, institution, or technology to behave reliably, safely, and in accordance with stated values. In the context of AI and automated systems, stakeholder trust encompasses both calculative assessments of technical competence and affective judgements about integrity and ethical alignment, and is recognised as a prerequisite for adoption, legitimate deployment, and effective governance. It must be earned through demonstrated performance, transparency, and accountability rather than assumed."@en ;
    rdfs:subClassOf ngm:trust ;
    vc:enables ngm:ai-governance,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:stakeholder,
        ngm:stakeholder-engagement,
        ngm:trust-framework ;
    vc:slug "stakeholder-trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:trust-and-safety .

ngm:standards-conformance-testing a owl:Class ;
    rdfs:label "Standards Conformance Testing"@en ;
    rdfs:comment "Testing or verification activities that determine whether a process, product, or service complies with the requirements of a specification, technical standard, contract, or regulation. Conformance testing verifies that implementations faithfully meet specified requirements through structured test suites, automated harnesses, and formal certification regimes — and is distinct from functional testing in that it judges compliance against an external normative reference rather than internal design intent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:interoperability,
        ngm:standards-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-development-process,
        ngm:standards-validation ;
    vc:requires ngm:software-testing,
        ngm:standards ;
    vc:slug "standards-conformance-testing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accountability,
        ngm:interoperability-standard .

ngm:standards-validation a owl:Class ;
    rdfs:label "Standards Validation"@en ;
    rdfs:comment "Standards validation is the process of confirming that a development product satisfies its intended use and stakeholder requirements—distinct from verification, which checks only internal specification conformance. It employs testing, formal review, and compliance checks against published standards such as IEEE 1012 and FDA Computer Software Assurance to ensure the correct artefact was built."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:standards-conformance-testing ;
    vc:slug "standards-validation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards-body ;
    vc:supports ngm:interoperability,
        ngm:regulatory-compliance ;
    vc:uses ngm:compliance-verification,
        ngm:quality-assurance .

ngm:stochastic-differential-equation a owl:Class ;
    rdfs:label "Stochastic Differential Equation"@en ;
    rdfs:comment "A stochastic differential equation (SDE) is a differential equation in which one or more terms incorporate a stochastic process, typically Brownian motion or white noise, making the solution itself a stochastic process. SDEs generalise ordinary differential equations by including a diffusion term driven by a Wiener process, and their solutions are interpreted via Ito or Stratonovich calculus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:it-calculus ],
        ngm:differential-equations ;
    vc:enables ngm:markov-chain-monte-carlo,
        ngm:stochastic-gradient-descent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dynamical-systems,
        ngm:numerical-methods ;
    vc:requires ngm:it-calculus,
        ngm:probability-theory ;
    vc:slug "stochastic-differential-equation" ;
    vc:sourceDomain "science" .

ngm:storage-hardware a owl:Class ;
    rdfs:label "Storage Hardware"@en ;
    rdfs:comment "Storage Hardware comprises the physical devices and subsystems responsible for persistently recording, retrieving, and managing digital data within computing infrastructure. This category covers technologies ranging from solid-state drives and NVMe arrays to distributed storage nodes and archival media. In AI and spatial computing contexts, storage hardware is a critical constraint on model training throughput, inference latency, and the scalability of data pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        ngm:hardware-component,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-storage-layer,
        ngm:storage-layer ;
    vc:isPartOf ngm:computing-hardware,
        ngm:hardware-and-edge ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-processing-hardware,
        ngm:inference-hardware,
        ngm:processing-hardware,
        ngm:training-hardware ;
    vc:requires ngm:data-storage,
        ngm:storage-infrastructure ;
    vc:slug "storage-hardware" ;
    vc:sourceDomain "spatial-computing" .

ngm:super-resolution a owl:Class ;
    rdfs:label "Super Resolution"@en ;
    rdfs:comment "Super-Resolution is the process of enhancing the resolution and quality of low-resolution images by predicting and synthesising high-frequency details using deep learning models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:image-generation,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:rasterization ;
    vc:enables ngm:computer-vision,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:convolutional-neural-network,
        ngm:deep-learning ;
    vc:slug "super-resolution" ;
    vc:sourceDomain "spatial-computing" .

ngm:supply-chain-transparency a owl:Class ;
    rdfs:label "Supply Chain Transparency"@en ;
    rdfs:comment "Supply chain transparency is the degree to which information about the origins, provenance, conditions, custody chain, and environmental and social impacts of goods is visible and verifiable to stakeholders throughout the supply chain — including manufacturers, distributors, retailers, regulators, and consumers. It encompasses voluntary disclosure practices, mandatory reporting frameworks (e.g., the UK Modern Slavery Act), and technical systems including blockchain-based provenance tracking and IoT sensor data chains that create immutable audit trails. Transparency is increasingly mandated by due diligence regulations and demanded by sustainability-conscious markets."@en ;
    rdfs:subClassOf ngm:supply-chain-management ;
    vc:enables ngm:data-integrity,
        ngm:provenance-verification,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:pharmaceutical-traceability,
        ngm:supply-chain-provenance,
        ngm:supply-chain-visibility ;
    vc:slug "supply-chain-transparency" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:audit-trail,
        ngm:internet-of-things,
        ngm:provenance-tracking,
        ngm:supply-chain-blockchain .

ngm:supply-chain-visibility a owl:Class ;
    rdfs:label "Supply Chain Visibility"@en ;
    rdfs:comment "Supply chain visibility is the capability to track, monitor, and share accurate, real-time information about the location, status, and condition of goods, components, and materials as they move through a supply network from raw material sourcing through production, distribution, and delivery to end customers. It requires integration of data from disparate logistics systems, IoT sensors, carrier APIs, and ERP platforms, and provides the situational awareness needed for proactive disruption management, regulatory compliance, and demand-driven inventory optimisation."@en ;
    rdfs:subClassOf ngm:supply-chain-management ;
    vc:enables ngm:cold-chain-monitoring,
        ngm:compliance-monitoring,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:supply-chain,
        ngm:supply-chain-blockchain,
        ngm:supply-chain-transparency ;
    vc:slug "supply-chain-visibility" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:logistics-optimization,
        ngm:provenance-tracking,
        ngm:supply-chain-traceability .

ngm:surveillance-capitalism a owl:Class ;
    rdfs:label "Surveillance Capitalism"@en ;
    rdfs:comment "Surveillance Capitalism is an economic logic, theorised by Shoshana Zuboff (2019), in which human experience is unilaterally claimed as a free raw material to be translated into behavioural data, processed by machine intelligence into prediction products, and sold in behavioural futures markets to business customers who seek to influence human behaviour. The model originated in digital advertising — Google's repurposing of surplus behavioural data from search to predict and influence click-through — and has since colonised social media, IoT devices, retail analytics, health apps, and smart-city infrastructure. Unlike industrial capitalism's exploitation of natural resources, surveillance capitalism exploits human behaviour and psyche as its primary resource, generating epistemic asymmetries between platform owners and the surveilled population and challenging the foundational conditions for autonomous selfhood, democratic deliberation, and market competition."@en ;
    rdfs:subClassOf ngm:platform-economy ;
    vc:contrastsWith ngm:data-sovereignty,
        ngm:digital-rights ;
    vc:enables ngm:algorithmic-accountability,
        ngm:social-media ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:behavioral-analytics,
        ngm:digital-society,
        ngm:digital-society-surveillance ;
    vc:slug "surveillance-capitalism" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:consent-management,
        ngm:gdpr .

ngm:sustainable-bitcoin-protocol a owl:Class ;
    rdfs:label "Sustainable Bitcoin Protocol"@en ;
    rdfs:comment "The Sustainable Bitcoin Protocol (SBP) is a certification and tokenisation framework that attests the use of renewable or stranded energy in Bitcoin mining and issues on-chain Sustainable Bitcoin Certificates to verified miners. It enables green bitcoin premiums and provides institutional investors with auditable environmental provenance for Bitcoin holdings."@en ;
    rdfs:subClassOf ngm:blockchain-sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:carbon-neutral-blockchain,
        ngm:stranded-energy-monetisation ;
    vc:slug "sustainable-bitcoin-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:green-mining-pool,
        ngm:renewable-energy-certificates,
        ngm:sustainable-bitcoin-certificates .

ngm:sustainable-development a owl:Class ;
    rdfs:label "Sustainable Development"@en ;
    rdfs:comment "AI should contribute to the United Nations Sustainable Development Goals by addressing global challenges including climate change, resource depletion, biodiversity loss, and environmental degradation whilst ensuring development meets present needs without compromising future generations' ability ..."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:computational-sustainability,
        ngm:green-ai,
        ngm:sustainable-ai-operations ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "sustainable-development" ;
    vc:sourceDomain "spatial-computing" .

ngm:sustainable-finance a owl:Class ;
    rdfs:label "Sustainable Finance"@en ;
    rdfs:comment "Sustainable finance refers to the integration of environmental, social, and governance (ESG) criteria into financial decision-making, product design, and market regulation with the goal of channelling capital flows toward activities that support a sustainable economy. It encompasses green bonds, sustainability-linked loans, ESG investing, climate risk management, and regulatory taxonomies that define what qualifies as environmentally sustainable economic activity."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:enables ngm:green-bond-market,
        ngm:impact-investing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:climate-finance,
        ngm:esg-reporting ;
    vc:slug "sustainable-finance" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:esg,
        ngm:eu-taxonomy .

ngm:symbolic-reasoning a owl:Class ;
    rdfs:label "Symbolic Reasoning"@en ;
    rdfs:comment "A family of AI techniques that represent knowledge as explicit symbols, rules, and logical relations and derive new conclusions through formal inference mechanisms such as resolution, forward/backward chaining, or constraint propagation. Symbolic reasoning underpins expert systems, knowledge graphs, and logic programming, and contrasts with sub-symbolic connectionist approaches while being combined with them in neuro-symbolic architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logic-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:expert-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fuzzy-logic ],
        ngm:ai-technique,
        ngm:reasoning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:expert-systems,
        ngm:fuzzy-logic,
        ngm:knowledge-representation,
        ngm:logic-programming ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:automated-planning,
        ngm:chain-of-thought-reasoning,
        ngm:knowledge-graph,
        ngm:mathematical-reasoning ;
    vc:slug "symbolic-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference .

ngm:system-integration a owl:Class ;
    rdfs:label "System Integration"@en ;
    rdfs:comment "System Integration is the engineering practice of combining disparate software components, services, and data sources into a coherent, functioning whole. It encompasses API design and management, middleware orchestration, event-driven messaging, ETL pipelines, and identity federation to ensure that independently developed subsystems exchange information reliably and consistently across organisational and technical boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:middleware ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-pipeline,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture ;
    vc:requires ngm:api-gateway,
        ngm:middleware ;
    vc:slug "system-integration" ;
    vc:sourceDomain "infrastructure" .

ngm:system-interoperability a owl:Class ;
    rdfs:label "System Interoperability"@en ;
    rdfs:comment "System interoperability is the ability of different information technology systems, applications, and devices to exchange data, interpret shared information, and use it in a mutually useful way without requiring special translation or middleware."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:infra-network-and-comms,
        ngm:sc-standards-and-interop ;
    vc:enables ngm:data-sharing,
        ngm:enterprise-connectivity,
        ngm:system-integration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:common-data-formats,
        ngm:standard-protocols ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "system-interoperability" ;
    vc:sourceDomain "infrastructure" .

ngm:tactile-sensing a owl:Class ;
    rdfs:label "Tactile Sensing"@en ;
    rdfs:comment "Tactile sensing is the ability of a robotic or prosthetic system to detect and interpret physical contact information — including contact force magnitude, direction, distribution, texture, slip, and temperature — through sensors embedded in or on the surface of an end effector or robotic skin. It is the mechanical analogue of the human sense of touch and provides information that visual sensing alone cannot supply, such as the internal stress distribution of a grasped object or the onset of slippage. Tactile sensing is fundamental to dexterous manipulation, safe human-robot interaction, and feedback-controlled assembly, and has become a defining capability differentiating next-generation robotic systems from conventional industrial manipulators."@en ;
    rdfs:subClassOf ngm:perception-system ;
    vc:enables ngm:force-control,
        ngm:haptic-feedback,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:human-robot-interaction ;
    vc:slug "tactile-sensing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-torque-sensor,
        ngm:pressure-sensor,
        ngm:proprioceptive-sensor .

ngm:technology-domain a owl:Class ;
    rdfs:label "Technology Domain"@en ;
    rdfs:comment "The foundational meta-domain encompassing all technology-related knowledge domains within the Narrative Gold Mine ontology, serving as the top-level classification for artificial intelligence, blockchain, metaverse, robotics, and telecollaboration systems. It provides shared semantic infrastructure for cross-domain reasoning and relationship traversal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotics-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:blockchain-application,
        ngm:generative-ai,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:artificial-intelligence,
        ngm:blockchain-domain,
        ngm:infrastructure,
        ngm:robotics-systems ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-infrastructure,
        ngm:domain-ontology,
        ngm:knowledge-representation ;
    vc:slug "technology-domain" ;
    vc:sourceDomain "infrastructure" .

ngm:technology-infrastructure a owl:Class ;
    rdfs:label "Technology Infrastructure"@en ;
    rdfs:comment "Technology Infrastructure encompasses the foundational hardware, networking, cloud services, and software platforms upon which higher-level applications and services are built. In the metaverse and spatial-computing domains it includes compute clusters, edge nodes, low-latency networking, content delivery networks, and the operating standards and APIs that enable interoperable, scalable, and resilient digital environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:technology-ecosystem ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:distributed-computing,
        ngm:edge-computing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:systems-engineering,
        ngm:technical-architecture-framework ;
    vc:slug "technology-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning-infrastructure .

ngm:text-encoder a owl:Class ;
    rdfs:label "Text Encoder"@en ;
    rdfs:comment "A text encoder is a neural network component that maps raw text—after tokenisation—into dense, contextualised vector representations that capture semantic, syntactic, and relational information for use in downstream tasks. Transformer-based encoders such as BERT, RoBERTa, and ALBERT produce bidirectional contextual embeddings via masked language model pre-training, whilst CLIP's text tower produces contrastively aligned embeddings shared with a visual encoder. In generative image and video pipelines, the text encoder translates natural language prompts into conditioning vectors that guide the diffusion denoising process via cross-attention."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokeniser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:embedding-model,
        ngm:token-embedding ;
    vc:requires ngm:attention-mechanism,
        ngm:tokeniser ;
    vc:slug "text-encoder" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:threshold-signature-scheme a owl:Class ;
    rdfs:label "Threshold Signature Scheme"@en ;
    rdfs:comment "A Threshold Signature Scheme (TSS) is a cryptographic protocol in which a private key is distributed among n parties such that any subset of at least t parties can jointly compute a valid digital signature without any single party ever possessing the complete private key, while fewer than t parties gain zero information about the key. TSS extends threshold secret sharing (Shamir's Secret Sharing) to the signing operation itself, producing a signature that is indistinguishable on-chain from a standard single-key signature, thereby enhancing privacy and reducing transaction fees compared to traditional on-chain multisig. TSS underpins distributed key management for exchanges, MPC wallets, and cross-chain bridge custody architectures."@en ;
    rdfs:subClassOf ngm:signature-scheme ;
    vc:enables ngm:decentralized-governance,
        ngm:key-management,
        ngm:threshold-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:multi-party-computation,
        ngm:multi-signature,
        ngm:secure-multi-party-computation ;
    vc:slug "threshold-signature-scheme" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-keys,
        ngm:elliptic-curve-cryptography .

ngm:time-series-analysis a owl:Class ;
    rdfs:label "Time-Series Analysis"@en ;
    rdfs:comment "Time-series analysis is the statistical and computational study of data sequences indexed by time, encompassing methods for decomposition, modelling, forecasting, and anomaly detection of temporal patterns including trend, seasonality, and autocorrelation structures. Foundational techniques include ARIMA, exponential smoothing, spectral analysis, and state-space models, with deep learning approaches such as transformers and N-BEATS increasingly dominant in practice."@en ;
    rdfs:subClassOf ngm:data-analysis,
        ngm:signal-processing ;
    vc:enables ngm:anomaly-detection,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:markov-chain-monte-carlo,
        ngm:prediction-markets ;
    vc:slug "time-series-analysis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bayesian-inference,
        ngm:probabilistic-model .

ngm:token-economy a owl:Class ;
    rdfs:label "Token Economy"@en ;
    rdfs:comment "A token economy is an economic system in which digital tokens — cryptographic representations of value, rights, or access — serve as the primary medium of exchange, incentive, and governance within a defined platform or protocol. Token economies leverage blockchain infrastructure to create programmable, permissionless economic systems where tokens encode ownership (utility tokens, security tokens, governance tokens, NFTs), align participant incentives through staking and reward mechanisms, and enable decentralised governance. The concept spans DeFi protocols, Web3 platforms, creator economies, and emerging AI agent economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incentive-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
        ngm:blockchain-economics ;
    vc:dependsOn ngm:blockchain-protocol,
        ngm:smart-contracts ;
    vc:enables ngm:creator-economy,
        ngm:dao-governance,
        ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:incentive-alignment,
        ngm:mechanism-design,
        ngm:reward-distribution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crypto-token,
        ngm:governance-token,
        ngm:tokenomics,
        ngm:utility-token ;
    vc:slug "token-economy" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:nft,
        ngm:social-token-economy .

ngm:training-data-distribution a owl:Class ;
    rdfs:label "Training Data Distribution"@en ;
    rdfs:comment "Training data distribution refers to the statistical properties and compositional characteristics of the dataset used to train a machine learning model, including the relative frequencies of classes, the coverage of input feature space, the presence of rare or tail events, and the demographic or domain balance of examples. The training data distribution determines what patterns a model can learn, what it will generalise from, and where it will fail: a model trained on a distribution that differs from the deployment distribution will exhibit degraded performance due to covariate shift or prior probability shift. Deliberate control of training data distribution — through curation, resampling, augmentation, and synthetic data generation — is a primary lever for improving model robustness, fairness, and safety."@en ;
    rdfs:subClassOf ngm:training-data ;
    vc:enables ngm:machine-learning,
        ngm:training-dataset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias,
        ngm:domain-adaptation,
        ngm:fairness ;
    vc:slug "training-data-distribution" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:data-augmentation-strategies,
        ngm:data-collection,
        ngm:synthetic-data .

ngm:transfer-impact-assessment a owl:Class ;
    rdfs:label "Transfer Impact Assessment"@en ;
    rdfs:comment "A Transfer Impact Assessment (TIA) is a documented evaluation organisations conduct before transferring personal data across borders to determine whether the destination jurisdiction provides protection essentially equivalent to that of the originating data-protection regime. Required in the EU following the Schrems II ruling, a TIA examines the destination's surveillance laws, the legal remedies available to data subjects, and any supplementary technical and organisational measures needed to make the transfer lawful. It is a core compliance artefact for international data flows under the GDPR."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gdpr,
        ngm:privacy ;
    vc:slug "transfer-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance ;
    vc:uses ngm:data-protection .

ngm:trust-establishment a owl:Class ;
    rdfs:label "Trust Establishment"@en ;
    rdfs:comment "Trust Establishment is the process by which parties in a digital or physical system form justified confidence in each other's identities, capabilities, intentions, and assertions prior to exchanging sensitive information or delegating authority. It encompasses cryptographic mechanisms such as certificate chain validation, attestation, and verifiable credential presentation, as well as organisational mechanisms including trust frameworks, legal agreements, and reputation systems. In decentralised and multi-stakeholder environments, trust establishment must operate without relying on a single trusted authority, requiring distributed protocols such as web-of-trust models, blockchain-anchored attestations, and federated identity systems. Trust establishment is a foundational prerequisite for secure communication, authorisation, and coordination across organisational and jurisdictional boundaries."@en ;
    rdfs:subClassOf ngm:trust-architecture ;
    vc:enables ngm:authentication,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-verification,
        ngm:identity-verification,
        ngm:reputation-system,
        ngm:trust-framework ;
    vc:slug "trust-establishment" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature-verification,
        ngm:humanity-attestation .

ngm:trusted-timestamping a owl:Class ;
    rdfs:label "Trusted Timestamping"@en ;
    rdfs:comment "Trusted timestamping is the process of securely recording the time at which a piece of data existed, using a trusted third party that cryptographically binds a hash of the data to an authoritative time and signs the result. Standardised by RFC 3161, it produces a timestamp token that proves data integrity and existence-by-time without revealing the data, and is used in digital signatures, legal record-keeping, intellectual-property protection, and regulatory compliance. It establishes a verifiable temporal ordering that survives even after signing keys expire."@en ;
    rdfs:subClassOf ngm:timestamping-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:slug "trusted-timestamping" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:timestamp-authority .

ngm:trustless-settlement a owl:Class ;
    rdfs:label "Trustless Settlement"@en ;
    rdfs:comment "Trustless settlement is a mechanism for finalising financial or asset-transfer transactions in which parties need not extend personal or institutional trust to a counterparty or intermediary because correctness is guaranteed by cryptographic protocols and verifiable distributed consensus. The term reflects the displacement of counterparty trust with algorithmic certainty: smart contracts hold and release assets conditionally on cryptographically verifiable proofs, and immutable ledger state provides objective post-settlement finality. Trustless settlement underpins DeFi protocols, atomic swaps, and cross-chain bridges, enabling transaction finality without custodial banks, clearinghouses, or escrow agents."@en ;
    rdfs:subClassOf ngm:atomic-settlement ;
    vc:enables ngm:decentralized-exchange-dex,
        ngm:permissionless-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:decentralized-finance-de-fi,
        ngm:securities-settlement ;
    vc:slug "trustless-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:instant-value-settlement ;
    vc:uses ngm:consensus-mechanism,
        ngm:smart-contract-coordination,
        ngm:zero-knowledge .

ngm:turtle a owl:Class ;
    rdfs:label "Turtle"@en ;
    rdfs:comment "Turtle (Terse RDF Triple Language) is a W3C-standardised serialisation syntax for expressing RDF graphs in a compact, human-readable plain-text form. It extends Notation3 (N3) by providing a concise prefix-based shorthand for IRIs, support for blank nodes, and literal datatypes, enabling structured linked-data documents to be authored and exchanged without the verbosity of RDF/XML."@en ;
    rdfs:subClassOf ngm:data-serialization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:json-ld,
        ngm:n-triples,
        ngm:rdf,
        ngm:sparql ;
    vc:slug "turtle" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:knowledge-graph,
        ngm:linked-data ;
    vc:uses ngm:owl .

ngm:universal-design a owl:Class ;
    rdfs:label "Universal Design"@en ;
    rdfs:comment "Universal Design is the architectural, product, and communication design philosophy asserting that environments, systems, and products should be designed from the outset to be usable by all people — regardless of age, disability, or circumstance — to the greatest extent possible without the need for adaptation or specialised design. Codified by architect Ronald Mace at NC State University in the 1990s across seven principles (equitable use, flexibility, simple and intuitive use, perceptible information, tolerance for error, low physical effort, size and space for approach and use), Universal Design goes beyond legal accessibility compliance to treat inclusive design as a quality standard that benefits all users. It has been extended to digital products, extended reality experiences, and AI systems."@en ;
    rdfs:subClassOf ngm:inclusive-design ;
    vc:enables ngm:inclusive-participation,
        ngm:inclusive-xr-experience,
        ngm:xr-accessibility-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:accessibility-standards,
        ngm:user-experience ;
    vc:slug "universal-design" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:human-factors,
        ngm:product-design .

ngm:usability-testing a owl:Class ;
    rdfs:label "Usability Testing"@en ;
    rdfs:comment "Usability testing is an empirical user research method in which representative users are observed attempting to complete realistic tasks with a product, system, or prototype, while the evaluator records errors, task completion times, help-seeking behaviour, and verbal commentary to identify usability problems and inform design improvements. Unlike expert-based heuristic evaluation, usability testing generates direct evidence of how real people interact with an interface under ecologically valid conditions. It is a core practice in human-computer interaction, product design, and user experience research, conducted through moderated in-person sessions, remote think-aloud protocols, or automated unmoderated testing platforms."@en ;
    rdfs:subClassOf ngm:user-research ;
    vc:enables ngm:product-design,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:heuristic-methods,
        ngm:human-computer-interaction,
        ngm:user-experience ;
    vc:slug "usability-testing" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:quality-assurance,
        ngm:software-testing .

ngm:vae a owl:Class ;
    rdfs:label "VAE"@en ;
    rdfs:comment "A Variational Autoencoder (VAE) is a generative model that learns a probabilistic latent-space representation of data by jointly optimising a reconstruction loss and a KL-divergence regularisation term, using variational inference to make the latent posterior tractable. The encoder network maps input data to a distribution over latent codes, whilst the decoder network reconstructs data from samples drawn from that distribution, enabling the model to generate novel, coherent samples at inference time. VAEs are foundational to latent diffusion models, image synthesis pipelines, and representation learning tasks where structured, disentangled latent spaces are desirable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autoencoder ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
