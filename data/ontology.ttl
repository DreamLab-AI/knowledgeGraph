    vc:hasPart ngm:haptic-feedback,
        ngm:motion-tracking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction ;
    vc:slug "vr-controllers" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:virtual-reality-vr .

ngm:vulnerability-scanner a owl:Class ;
    rdfs:label "Vulnerability Scanner"@en ;
    rdfs:comment "A vulnerability scanner is a tool that inspects systems, networks or applications to identify known security weaknesses. It compares discovered software and configurations against databases of disclosed vulnerabilities."@en ;
