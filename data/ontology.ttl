ngm:telecollaboration-and-telepresence-domain a owl:Class ;
    rdfs:label "Telecollaboration and Telepresence Domain"@en ;
    rdfs:comment "Telecollaboration and Telepresence Domain is a distributed collaboration concept and a type of Telecollaboration. that enables DistributedWork."@en ;
