# Infrastructure Domain
infrastructure:InfrastructureDomain rdf:type owl:Class ;
    rdfs:label "Infrastructure Domain"@en ;
    rdfs:comment "The Infrastructure Domain provides an ontological framework for ICT infrastructure configuration items, resources, and resource groups common across IT service management systems. It encompasses network components, server infrastructure, data centers, software systems, databases, hardware components, and security configurations that enable network connectivity, communication, and computing services."@en ;
    skos:prefLabel "Infrastructure Domain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:infrastructure-domain" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:infrastructure-domain> ;
