    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:digital-wallet,
        ngm:token-standard ;
    vc:slug "decentralized-exchange-dex" ;
    vc:sourceDomain "blockchain" .

ngm:decision-engine a owl:Class ;
    rdfs:label "Decision Engine"@en ;
    rdfs:comment "A decision engine is a software component that encapsulates decision logic—rules, models, policies, or heuristics—and evaluates inputs against that logic to produce actionable outputs such as approvals, classifications, recommendations, or routing choices. Decision engines decouple business logic from application code, enabling non-developers to modify decision policies without code deployments, and support auditability by providing traceable reasoning paths for each decision. They range from rule-based expert systems to ML model inference services to hybrid architectures combining both."@en ;
    rdfs:subClassOf ngm:inference-engine ;
    vc:enables ngm:automated-planning,
        ngm:decision-support,
        ngm:informed-decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decision-transparency,
        ngm:orchestration ;
    vc:slug "decision-engine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:automated-reasoning,
        ngm:policy-engine .

ngm:decision-transparency a owl:Class ;
    rdfs:label "Decision Transparency"@en ;
    rdfs:comment "Decision transparency is the property of an AI system whereby the basis, logic, and contributing factors of its outputs are made accessible and comprehensible to relevant stakeholders. It requires that decision processes be traceable — from input data through model architecture to final output — and that explanations be appropriate to the audience, whether technical developers, domain experts, or affected individuals. Decision transparency is a foundational prerequisite for meaningful accountability, contestability, and regulatory compliance in AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:ai-model-card,
        ngm:algorithmic-transparency-index,
        ngm:human-oversight,
        ngm:model-interpretability,
        ngm:stakeholder-engagement-in-ai ;
    vc:requires ngm:audit-trail,
        ngm:explainable-ai,
        ngm:interpretability ;
    vc:slug "decision-transparency" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:regulatory-compliance,
        ngm:responsible-ai .

ngm:delta-robot a owl:Class ;
    rdfs:label "Delta Robot"@en ;
    rdfs:comment "Delta robot employs parallel kinematics where three or more kinematic chains connect actuators to an end-effector platform, constraining motion through parallelogram linkages to pure translation."@en ;
    rdfs:subClassOf ngm:industrial-robot,
        ngm:parallel-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:high-speed-picking,
        ngm:parallel-processing,
        ngm:rapid-sorting,
        ngm:ultra-fast-placement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator-motors,
        ngm:end-effector-platform,
        ngm:kinematic-chains,
        ngm:parallelogram-linkages ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:coordinated-control,
        ngm:high-performance-actuators,
        ngm:stiff-support-structure,
        ngm:synchronisation ;
    vc:slug "delta-robot" ;
    vc:sourceDomain "robotics" .

ngm:design-thinking a owl:Class ;
    rdfs:label "Design Thinking"@en ;
    rdfs:comment "Design Thinking is a human-centred, iterative problem-solving methodology that prioritises deep empathy with end users, rapid ideation, and prototype-driven experimentation to arrive at innovative solutions. Originating in industrial design and formalised at Stanford's d.school, it proceeds through five non-linear phases: empathise, define, ideate, prototype, and test. The approach deliberately suspends assumptions and defers judgement during divergent thinking stages, producing a rich solution space before converging on testable prototypes. Design Thinking is now applied widely in product development, service design, organisational strategy, and technology innovation contexts."@en ;
    rdfs:subClassOf ngm:knowledge-representation ;
    vc:enables ngm:generative-design-tool,
        ngm:product-design,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessible-design,
        ngm:etsi-domain-human-interface-ux,
        ngm:human-computer-interaction,
        ngm:information-architecture ;
    vc:slug "design-thinking" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:collaborative-design,
        ngm:design-software,
        ngm:user-research .

ngm:determinism a owl:Class ;
    rdfs:label "Determinism"@en ;
    rdfs:comment "Determinism, in computing and distributed systems, is the property by which a computational process produces identical outputs given identical inputs and initial state, regardless of when, where, or how many times it is executed. Deterministic systems are essential for reproducibility of scientific experiments, predictability of embedded and safety-critical control systems, and correctness of distributed consensus protocols where all participating nodes must reach the same conclusion from the same inputs. In the context of blockchain and smart contracts, determinism is a hard requirement because non-deterministic execution would cause different nodes to compute different state transitions, breaking consensus."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:contrastsWith ngm:probabilistic-model,
        ngm:stochastic-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:formal-verification,
        ngm:random-number-generation,
        ngm:state-machine-replication ;
    vc:slug "determinism" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:automated-reasoning,
        ngm:blockchain,
        ngm:cyber-physical-systems .

ngm:diffusion-transformer a owl:Class ;
    rdfs:label "Diffusion Transformer"@en ;
    rdfs:comment "A Diffusion Transformer (DiT) is a generative model architecture that replaces the convolutional U-Net backbone traditionally used in diffusion models with a scalable transformer architecture operating in a compressed latent space. DiT conditions the denoising process on class labels or text embeddings injected via adaptive layer normalisation or cross-attention, and processes image or video patches as sequences of tokens, enabling the model to leverage the scaling laws well-established for language transformers. Introduced by Peebles and Xie (2023), DiT demonstrated that transformer-based denoisers match or surpass U-Net performance while scaling predictably with model size and compute, forming the basis for state-of-the-art image and video generation systems including Stable Diffusion 3, FLUX, and OpenAI's Sora."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:enables ngm:image-generation,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:flow-matching,
        ngm:generative-ai ;
    vc:slug "diffusion-transformer" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:latent-diffusion,
        ngm:self-attention,
        ngm:transformer-architecture .

ngm:digital-goods a owl:Class ;
