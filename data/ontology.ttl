    vc:slug "cross-platform-interoperability" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:relayer .

ngm:data-integrity a owl:Class ;
    rdfs:label "Data Integrity"@en ;
    rdfs:comment "Data integrity is the property that data remains accurate, consistent, and unaltered throughout its entire lifecycle—spanning creation, storage, transmission, and processing—without authorised modification. It is enforced through a combination of technical controls including cryptographic hash functions, digital signatures, Merkle trees, and immutable audit trails, as well as procedural controls such as access management and change-control workflows. Violations of data integrity—whether from storage errors, transmission corruption, or malicious tampering—can have cascading consequences in systems that rely on the data for decision-making."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:audit-trail,
        ngm:immutability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:fault-tolerance ;
    vc:slug "data-integrity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hash-function,
        ngm:merkle-tree .

ngm:digital-asset-management a owl:Class ;
    rdfs:label "Digital Asset Management"@en ;
    rdfs:comment "The professional oversight and administration of cryptocurrency portfolios, tokenized assets, and blockchain-based investments through systematic strategies, risk management frameworks, and fiduciary practices to optimise returns and preserve capital for individuals and institutions."@en ;
    rdfs:subClassOf ngm:investment-management,
