ngm:sc-interaction a owl:Class,
        skos:Concept ;
    rdfs:label "Interaction Technology"@en ;
    rdfs:comment "Interaction Technology is the spatial-computing taxonomy hub for all modalities through which users perceive and manipulate virtual and mixed-reality environments — including hand tracking, eye tracking, gaze control, haptics, voice interaction, and VR controllers. It sits alongside Display and Rendering and Platform and Environment as a peer category within spatial computing."@en ;
