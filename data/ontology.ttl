ngm:remote-assistance a owl:Class ;
    rdfs:label "Remote Assistance"@en ;
    rdfs:comment "Remote assistance is a service modality in which an expert or system provides real-time guidance, intervention, or control to a person or machine at a physically separate location, mediated by communication and rendering technology. It spans technical IT support via screen-sharing, clinical guidance through telestration overlays on AR headsets, and safety-critical interventions in teleoperated robotics. Effective remote assistance requires low-latency bidirectional communication, shared situational awareness, and appropriate interaction modalities for the task domain."@en ;
    rdfs:subClassOf ngm:remote-collaboration ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:teleoperation,
        ngm:telepresence ;
    vc:slug "remote-assistance" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:remote-communication ;
    vc:uses ngm:communication-protocol,
        ngm:immersive-communication .

ngm:remote-communication a owl:Class ;
    rdfs:label "Remote Communication"@en ;
    rdfs:comment "Remote Communication encompasses the protocols, platforms, and practices that enable synchronous and asynchronous exchange of information between geographically distributed participants. It spans text, voice, video, and immersive modalities, and underpins distributed work, telecollaboration, and telepresence systems by abstracting physical distance through networked infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:distributed-work,
        ngm:telecollaboration,
        ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:immersive-communication ;
    vc:requires ngm:latency,
        ngm:network-protocol ;
    vc:slug "remote-communication" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:remote-pair-programming a owl:Class ;
    rdfs:label "Remote Pair Programming"@en ;
    rdfs:comment "Remote Pair Programming is a synchronous collaborative software-development practice in which two developers—one acting as driver (typing) and one as navigator (reviewing, guiding, strategising)—share a single logical programming environment across geographically separated workstations, communica..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:screen-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-conferencing ],
        ngm:agile-software-development,
        ngm:collaborative-development,
        ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:enables ngm:code-quality-assurance,
        ngm:collective-code-ownership,
        ngm:continuous-learning,
        ngm:distributed-code-review,
        ngm:knowledge-transfer,
        ngm:onboarding-acceleration,
        ngm:real-time-debugging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-video-channel,
        ngm:cursor-synchronisation,
        ngm:driver-role,
        ngm:navigator-role,
        ngm:role-rotation-protocol,
        ngm:screen-sharing,
        ngm:session-recording,
        ngm:shared-code-editor ;
    vc:implements ngm:continuous-integration,
        ngm:driver-navigator-pattern,
        ngm:extreme-programming,
        ngm:mob-programming,
        ngm:test-driven-development ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:code-review,
        ngm:continuous-integration,
