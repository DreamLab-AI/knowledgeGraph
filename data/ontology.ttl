ngm:bloom-filter a owl:Class ;
    rdfs:label "Bloom Filter"@en ;
    rdfs:comment "A Bloom Filter is a space-efficient probabilistic data structure that tests whether an element is a member of a set, accepting a controllable false-positive rate while guaranteeing zero false negatives. Invented by Burton Howard Bloom in 1970, the structure uses multiple hash functions to map elements to bit positions within a fixed-size bit array. Membership queries are answered in constant time regardless of set size, making Bloom Filters indispensable in high-throughput systems where exact lookup is prohibitively expensive. They are widely deployed in databases, networking, distributed caches, and blockchain nodes."@en ;
    rdfs:subClassOf ngm:data-structure ;
    vc:contrastsWith ngm:spatial-data-structure ;
    vc:enables ngm:latency,
        ngm:membership-inference,
        ngm:privacy-filter ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-data-structure,
        ngm:hash-function,
        ngm:probabilistic-model ;
    vc:slug "bloom-filter" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:hash-collision .

ngm:bounding-volume-hierarchy a owl:Class ;
    rdfs:label "Bounding Volume Hierarchy"@en ;
    rdfs:comment "A tree-structured acceleration data structure that recursively organizes geometric objects within nested bounding volumes, enabling efficient spatial queries, collision detection, and ray-scene intersection testing by rapidly culling large portions of geometry that cannot intersect with a query."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:spatial-data-structure ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:ray-tracing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:bounding-volume,
        ngm:traversal-algorithm,
        ngm:tree-construction ;
    vc:slug "bounding-volume-hierarchy" ;
    vc:sourceDomain "spatial-computing" .

