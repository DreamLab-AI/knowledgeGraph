ngm:layoff-tracker-and-threatened-roles a owl:Class ;
    rdfs:label "Layoff tracker and threatened roles"@en ;
    rdfs:comment "A curated record of mass layoffs in the technology sector from 2023 onwards, cataloguing headcount reductions at major firms alongside UK government estimates that AI automation may displace 10–30% of existing jobs. The tracker contextualises how AI adoption—particularly large language models and agentic AI—is accelerating workforce restructuring across white-collar roles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:generative-ai,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:artificial-intelligence,
        ngm:economics ;
    vc:slug "layoff-tracker-and-threatened-roles" ;
    vc:sourceDomain "infrastructure" .

