        ngm:dutch-auction,
        ngm:english-auction,
        ngm:vickrey-auction ;
    vc:isPartOf ngm:economics,
        ngm:mechanism-design ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:market-design,
        ngm:optimal-control,
        ngm:revenue-equivalence ;
    vc:requires ngm:bayesian-inference,
        ngm:game-theory,
        ngm:information-asymmetry ;
    vc:slug "auction-theory" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:incentive-compatibility,
        ngm:mechanism-design,
        ngm:nash-equilibrium .

ngm:audit-function a owl:Class ;
    rdfs:label "Audit Function"@en ;
    rdfs:comment "An organisational capability or dedicated unit responsible for the planning, execution, and reporting of audit activities within or on behalf of an enterprise. The audit function provides independent assurance over risk management, internal controls, and governance processes, acting as a critical third line of defence in enterprise risk frameworks."@en ;
