        ngm:large-language-model ;
    vc:requires ngm:international-cooperation,
        ngm:know-your-customer,
        ngm:semiconductor-supply-chain ;
    vc:slug "compute-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-risk-management,
        ngm:responsible-ai ;
    vc:uses ngm:cryptographic-verification,
        ngm:trusted-execution-environment .

ngm:computer-science a owl:Class ;
    rdfs:label "Computer Science"@en ;
    rdfs:comment "Computer science is the systematic study of computation, algorithms, data structures, programming languages, and the principles underlying the design and analysis of computing systems. It encompasses both theoretical foundations — including computability theory, computational complexity, formal languages, and logic — and applied disciplines such as software engineering, artificial intelligence, databases, and computer networks. As a rigorous scientific and engineering discipline, it provides the intellectual and practical frameworks for building reliable, efficient, and scalable digital systems. Computer science intersects with mathematics, electrical engineering, cognitive science, and the natural sciences, and it underpins virtually every domain of modern technological infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:programming-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computational-complexity-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:operating-system ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:blockchain,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:enables ngm:artificial-intelligence,
