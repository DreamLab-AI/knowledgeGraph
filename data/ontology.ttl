    dcterms:conformsTo "0.95"^^xsd:decimal .

# AlgorithmicFramework
ai:AlgorithmicFramework a owl:Class ;
    rdfs:subClassOf ai:AIFramework ;
    rdfs:label "AlgorithmicFramework"@en ;
    rdfs:comment "A algorithmic framework component in the Artificial Intelligence domain that required by ProceduralContentGeneration."@en ;
    skos:prefLabel "AlgorithmicFramework"@en ;
    dcterms:identifier "AI-4006" ;
    dcterms:subject "ai" ;
    dcterms:type "emerging" .

# ModelEvaluationResults
ai:ModelEvaluationResults a owl:Class ;
    rdfs:subClassOf ai:ModelArchitecture ;
    rdfs:subClassOf ai:AIMetadata ;
    rdfs:label "ModelEvaluationResults"@en ;
    rdfs:comment "A model evaluation results component in the Artificial Intelligence domain that required by AiModelCard."@en ;
    skos:prefLabel "ModelEvaluationResults"@en ;
    dcterms:identifier "AI-4008" ;
    dcterms:subject "ai" ;
    dcterms:type "emerging" .

# AI Safety
ai:AISafety a owl:Class ;
    rdfs:subClassOf ai:ArtificialIntelligence ;
    rdfs:label "AI Safety"@en ;
    rdfs:comment "AI Safety is the field of research and practice focused on ensuring that artificial intelligence systems operate safely, reliably, and in alignment with human values and intentions. It encompasses techniques for preventing unintended harm, maintaining robust behaviour under uncertainty, and ensuring systems remain controllable and predictable throughout their operational lifecycle."@en ;
    skos:prefLabel "AI Safety"@en ;
    dcterms:identifier "AI-4009" ;
    dcterms:subject "ai" .

ai:AISafety rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom ai:AIGovernance
] .

ai:AISafety rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom ai:AIAlignment
] .

ai:AISafety rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom ai:AdversarialRobustness
] .

ai:AISafety rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom ai:Interpretability
] .

ai:AISafety rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom ai:ValueAlignment
] .

