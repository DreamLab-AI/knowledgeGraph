ngm:sc-content-and-assets a owl:Class,
        skos:Concept ;
    rdfs:label "Content and Assets"@en ;
    rdfs:comment "Taxonomy hub for all content types and digital assets within the spatial computing domain, encompassing 3D models, avatars, NFTs, textures, rendering pipelines, and the digital asset lifecycle from creation through distribution. This category unifies the asset-creation and asset-management concerns that underpin immersive experiences."@en ;
