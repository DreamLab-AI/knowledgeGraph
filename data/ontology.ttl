ngm:multimedia-processing a owl:Class ;
    rdfs:comment "Multimedia processing is the broad category of computational techniques for capturing, encoding, transforming, analysing and rendering audio, video, image and other time-based media. It encompasses signal-processing operations such as filtering and transform coding, as well as higher-level tasks like compression, synchronisation and format conversion. Audio processing and video compression are specific disciplines within this wider field."@en ;
    rdfs:label "Multimedia Processing"@en ;
    rdfs:subClassOf ngm:signal-processing ;
