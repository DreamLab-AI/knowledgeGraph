        ngm:natural-language-processing,
        ngm:self-supervised-learning ;
    vc:requires ngm:distance-metric,
        ngm:embedding,
        ngm:feature-engineering ;
    vc:slug "clustering" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:dimensionality-reduction,
        ngm:predictive-analytics,
        ngm:representation-learning ;
    vc:uses ngm:dimensionality-reduction,
