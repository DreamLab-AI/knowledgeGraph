    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:artificial-intelligence,
        ngm:reinforcement-learning ;
    vc:uses ngm:neural-network .

ngm:newton-euler-dynamics a owl:Class ;
    rdfs:label "Newton-Euler Dynamics"@en ;
    rdfs:comment "Recursive formulation of rigid-body mechanics that applies Newton's second law (F=ma) and Euler's rotation equation (τ=Iα) to each link of a robot chain in outward and inward passes, computing joint torques and reaction forces for dynamics simulation, control, and real-time motion planning."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:control-system,
        ngm:embodied-ai-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robot-dynamics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:inertia,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:rigid-body-dynamics,
        ngm:robot-joint,
        ngm:robot-kinematics ;
    vc:slug "newton-euler-dynamics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-torque-sensor,
        ngm:physics-simulation .

ngm:next-token-prediction a owl:Class ;
    rdfs:label "Next Token Prediction"@en ;
    rdfs:comment "Next token prediction is the autoregressive language-modelling objective in which a model predicts the next token in a sequence given all preceding tokens. Trained by maximising the likelihood of each token conditioned on its left context, it requires no explicit labels and scales to vast text corpora. It is the core pre-training objective behind generative transformer language models such as the GPT family."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-supervised-learning ],
        ngm:pre-training ;
    vc:bridgesTo ngm:representation-learning ;
    vc:contrastsWith ngm:masked-language-modelling ;
    vc:dependsOn ngm:transformer ;
    vc:enables ngm:fine-tuning,
        ngm:language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cross-entropy-loss ;
    vc:implements ngm:autoregressive-model ;
    vc:isPartOf ngm:pre-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:language-model,
        ngm:loss-function,
        ngm:representation-learning ;
    vc:requires ngm:self-supervised-learning ;
    vc:slug "next-token-prediction" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:gpt ;
    vc:uses ngm:self-supervised-learning,
        ngm:transformer .

ngm:nist-privacy-framework a owl:Class ;
    rdfs:label "NIST Privacy Framework"@en ;
    rdfs:comment "A NIST framework providing voluntary guidance to help organisations manage privacy risks arising from data processing. It is structured around core functions to support privacy risk management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
