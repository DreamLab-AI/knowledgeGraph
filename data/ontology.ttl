# AI Lifecycle
artificial-intelligence:AILifecycle rdf:type owl:Class ;
    rdfs:label "AI Lifecycle"@en ;
    rdfs:comment "The series of distinct phases through which an artificial intelligence system progresses from initial conception to eventual decommissioning, encompassing planning, design, development, verification, deployment, operation, monitoring, maintenance, and retirement, with each phase involving specific activities, stakeholder roles, documentation requirements, and governance controls to ensure responsible and effective AI system management."@en ;
    skos:prefLabel "AI Lifecycle"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-lifecycle" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-lifecycle> ;
    vcw:contentHash "sha256-12-2b5cdb9ad0a6" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0092" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0092" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AILifecycle rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom artificial-intelligence:HumanOversight
] .

artificial-intelligence:AILifecycle rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom artificial-intelligence:Stakeholderengagementthroughout
] .

artificial-intelligence:AILifecycle vcw:bridgesTo artificial-intelligence:AIAgentSystem .

# AI Development
artificial-intelligence:AIDevelopment rdf:type owl:Class ;
    rdfs:label "AI Development"@en ;
    rdfs:comment "The phase of the AI lifecycle encompassing the design, creation, training, and validation of artificial intelligence systems, including activities such as algorithm selection, data preparation, model architecture design, training process execution, hyperparameter optimisation, performance evaluation, and documentation, conducted according to established engineering principles, ethical guidelines, and governance frameworks to produce AI systems suitable for their intended purpose."@en ;
    skos:prefLabel "AI Development"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-development" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-development> ;
    vcw:contentHash "sha256-12-b8263c951681" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0093" ;
