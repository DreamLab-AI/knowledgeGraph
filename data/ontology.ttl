# Cloud Infrastructure
infrastructure:CloudInfrastructure rdf:type owl:Class ;
    rdfs:label "Cloud Infrastructure"@en ;
    rdfs:comment "Cloud infrastructure is a computing model that provides on-demand access to virtualized computing resources including servers, storage, networking, and platform services delivered over the internet. It enables organizations to provision and scale IT resources dynamically without managing physical hardware, typically through service models such as IaaS, PaaS, and SaaS."@en ;
    skos:prefLabel "Cloud Infrastructure"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:cloud-infrastructure" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:cloud-infrastructure> ;
