        ngm:model-documentation ;
    vc:slug "algorithmic-transparency-index" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:analytics-engine a owl:Class ;
    rdfs:label "Analytics Engine"@en ;
    rdfs:comment "A software system or distributed platform that ingests, processes, and analyses large volumes of structured and unstructured data to extract insights, detect patterns, and support decision-making. Analytics engines abstract the complexity of distributed query execution, storage management, and statistical computation behind APIs and query interfaces, enabling analysts and applications to perform exploratory, diagnostic, predictive, and prescriptive analysis at scale. They serve as the computational backbone of business intelligence platforms, ML pipelines, and real-time operational monitoring systems."@en ;
    rdfs:subClassOf ngm:data-analytics ;
    vc:enables ngm:machine-learning-discipline-pipeline,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:emotional-analytics-engine,
        ngm:telemetry-and-analytics ;
    vc:slug "analytics-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-lake,
        ngm:data-pipeline,
        ngm:stream-processing .

ngm:anonymity a owl:Class ;
    rdfs:label "Anonymity"@en ;
    rdfs:comment "Anonymity is the property of an actor being unidentifiable within a set of potential actors, so that actions cannot be linked to a real-world identity. It is a core privacy goal achieved through techniques that obscure identifying attributes, network paths and metadata. Anonymity contrasts with pseudonymity, where a persistent but non-identifying handle is retained."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:privacy ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:identity,
        ngm:pseudonymity,
        ngm:surveillance ;
    vc:enables ngm:data-protection,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:differential-privacy ;
    vc:isPartOf ngm:privacy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:metadata,
        ngm:tor,
        ngm:vpn ;
    vc:requires ngm:cryptography ;
    vc:slug "anonymity" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:zero-knowledge-proof ;
    vc:uses ngm:anonymisation,
        ngm:encryption,
        ngm:onion-routing .

ngm:anti-aliasing a owl:Class ;
    rdfs:label "Anti Aliasing"@en ;
    rdfs:comment "Anti-aliasing is a family of rendering techniques that reduce the jagged, stair-stepped edges and shimmering artefacts that arise when continuous geometry and signals are sampled onto a discrete pixel grid. By increasing effective sampling, blending edge pixels, or reconstructing from accumulated samples, anti-aliasing produces smoother, more visually faithful images. It is a standard stage of real-time and offline rendering pipelines, with methods such as supersampling, multisampling, post-process filtering, and temporal accumulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sampling ],
        ngm:real-time-rendering ;
    vc:dependsOn ngm:gpu ;
    vc:enables ngm:rasterization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:post-processing,
        ngm:sampling ;
    vc:isPartOf ngm:real-time-rendering,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:offline-rendering,
        ngm:rasterization,
        ngm:ray-tracing,
        ngm:texture-mapping ;
    vc:requires ngm:graphics-pipeline ;
    vc:slug "anti-aliasing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:rasterization ;
    vc:uses ngm:gpu,
        ngm:sampling .

ngm:api-security a owl:Class ;
    rdfs:label "API Security"@en ;
    rdfs:comment "API security is the discipline of protecting application programming interfaces from misuse, abuse, and attack across their lifecycle, covering authentication, authorisation, input validation, transport encryption, rate limiting, and monitoring. As APIs expose business logic and data directly to clients and partners, they present a broad attack surface addressed through tokens such as OAuth and JWT, gateways, and threat modelling against risks like broken object-level authorisation. It is a core component of modern application and web security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rate-limiting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authorization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:security ;
    vc:enables ngm:api-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway,
        ngm:rate-limiting ;
    vc:implements ngm:zero-trust-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:microservices,
        ngm:penetration-testing ;
    vc:requires ngm:authentication,
        ngm:authorization ;
    vc:slug "api-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:tls ;
    vc:supports ngm:api-design,
        ngm:rest-api ;
    vc:uses ngm:encryption,
        ngm:mutual-tls,
        ngm:oauth,
        ngm:transport-layer-security .

ngm:ar-display-device a owl:Class ;
    rdfs:label "Ar Display Device"@en ;
    rdfs:comment "AR Display Device encompasses hardware systems including smart glasses, headsets, and head-mounted displays that superimpose computer-generated imagery onto the user's view of the real world through optical technologies such as waveguides, birdbath optics, holographic displays, and metasurfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-systems ],
        ngm:display-hardware,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:display-technology,
        ngm:optical-systems,
        ngm:pose-tracking ;
    vc:slug "ar-display-device" ;
    vc:sourceDomain "spatial-computing" .

ngm:arbitration-process a owl:Class ;
    rdfs:label "Arbitration Process"@en ;
    rdfs:comment "Arbitration Process in the blockchain and metaverse context refers to structured dispute resolution procedures using smart contracts and decentralized technologies, encompassing both on-chain mechanisms with automatic award enforcement and off-chain proceedings with traditional arbitral framework..."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:infra-legal-and-regulatory ;
    vc:enables ngm:dispute-resolution,
        ngm:smart-contract-enforcement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "arbitration-process" ;
    vc:sourceDomain "spatial-computing" .

ngm:architectural-visualisation a owl:Class ;
    rdfs:label "Architectural Visualisation"@en ;
    rdfs:comment "Architectural visualisation is the discipline of producing photorealistic or stylised two- and three-dimensional representations of proposed buildings, interiors, and urban environments to communicate design intent to clients, planners, and the public before construction. It combines techniques from 3D modelling, physically based rendering, and real-time graphics to produce still images, animations, and interactive walkthroughs. Advances in real-time rendering engines and spatial computing have extended the discipline to include immersive virtual reality experiences and augmented reality overlays on physical construction sites."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:bim-virtual-model ;
    vc:slug "architectural-visualisation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-model,
        ngm:real-time-rendering .

ngm:asynchronous-messaging a owl:Class ;
    rdfs:label "Asynchronous Messaging"@en ;
    rdfs:comment "Asynchronous Messaging is a communication pattern in which a sender dispatches a message to an intermediary and continues processing without waiting for the receiver to respond. Messages are buffered in queues or brokers and consumed when downstream services are ready, decoupling producers from consumers in time and load. This pattern improves resilience, scalability and fault tolerance in distributed and event-driven architectures."@en ;
    rdfs:subClassOf ngm:message-queue ;
    vc:contrastsWith ngm:synchronous-communication ;
    vc:enables ngm:fault-tolerance,
        ngm:resilience,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:apache-kafka,
        ngm:rabbitmq ;
    vc:isPartOf ngm:event-driven-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:rest-api ;
    vc:slug "asynchronous-messaging" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:amqp ;
    vc:supports ngm:microservices,
        ngm:webhook ;
    vc:uses ngm:message-broker,
        ngm:message-queue .

ngm:auction-theory a owl:Class ;
    rdfs:label "Auction Theory"@en ;
    rdfs:comment "Auction theory is a branch of applied mathematics, economics, and game theory that analyses competitive bidding mechanisms through which goods, services, or rights are allocated to participants. It characterises how auction format rules (e.g. English, Dutch, Vickrey), information structure (private vs. common values), and bidder strategy interact to determine allocative efficiency, revenue, and equilibrium outcomes. The field provides formal tools for designing mechanisms that incentivise truthful bidding, prevent collusion, and optimise social welfare or seller revenue. Foundational results include the Revenue Equivalence Theorem and optimal auction design frameworks due to Myerson."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-asymmetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dutch-auction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-theory ],
        ngm:game-theory ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance,
        ngm:multi-agent-system,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:negotiation ;
    vc:dependsOn ngm:information-theory,
        ngm:probability-theory ;
    vc:enables ngm:gas-mechanism,
        ngm:programmatic-advertising,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dutch-auction ;
    vc:isPartOf ngm:economics,
        ngm:mechanism-design ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:market-design,
        ngm:optimal-control ;
    vc:requires ngm:bayesian-inference,
        ngm:game-theory,
        ngm:information-asymmetry ;
    vc:slug "auction-theory" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:incentive-compatibility,
        ngm:mechanism-design,
        ngm:nash-equilibrium .

ngm:audio-technology a owl:Class ;
    rdfs:label "Audio Technology"@en ;
    rdfs:comment "The hardware, software, and signal-processing techniques used to capture, synthesise, spatialise, and reproduce sound within spatial computing and metaverse environments. Audio technology in immersive contexts encompasses spatial audio rendering, binaural processing, voice interaction, and real-time acoustic simulation to enhance presence and communication fidelity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-audio-technology ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:telepresence ;
    vc:enables ngm:virtual-presence,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:immersive-audio-technology,
        ngm:spatial-audio ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "audio-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audio-processing-system .

ngm:authenticated-encryption a owl:Class ;
    rdfs:label "Authenticated Encryption"@en ;
    rdfs:comment "Authenticated encryption is a class of symmetric cryptographic schemes that simultaneously provide confidentiality, integrity and authenticity of a message in a single operation. Authenticated encryption with associated data (AEAD) additionally binds unencrypted header data to the ciphertext, so any tampering with the message or its context is detected on decryption. Modern AEAD constructions such as AES-GCM and ChaCha20-Poly1305 are the recommended default for secure communication because they avoid the pitfalls of composing encryption and authentication separately."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:encryption ;
    vc:enables ngm:data-confidentiality,
        ngm:data-integrity,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:aes-gcm ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:hash-function ;
    vc:requires ngm:cryptographic-protocol,
        ngm:key-management ;
    vc:slug "authenticated-encryption" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:tls,
        ngm:tls-1-3 ;
    vc:uses ngm:message-authentication-code,
        ngm:nonce,
        ngm:symmetric-encryption .

ngm:authentication-system a owl:Class ;
    rdfs:label "Authentication System"@en ;
    rdfs:comment "An authentication system is an infrastructure component responsible for verifying the claimed identity of users, devices, or services before granting access to protected resources. It integrates credential management, identity verification workflows, session management, and integration with downstream access control mechanisms to enforce the principle that only legitimate principals can initiate authenticated sessions. Authentication systems range from simple password databases to federated multi-factor frameworks spanning organisational boundaries."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:decentralised-identity,
        ngm:identity-provider ;
    vc:slug "authentication-system" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-signature,
        ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:open-id-connect .

ngm:automated-compliance a owl:Class ;
    rdfs:label "Automated Compliance"@en ;
    rdfs:comment "Automated Compliance refers to the use of software systems and rule engines to continuously monitor, evaluate, and enforce regulatory requirements without manual intervention. It encompasses real-time policy checking, evidence collection, and exception reporting across business processes and IT systems. By embedding compliance logic directly into workflows, organisations can dramatically reduce audit burden and human error. The discipline draws on regulatory technology, policy engines, and audit trails to provide defensible evidence of conformance. It is particularly vital in heavily regulated sectors such as financial services, healthcare, and data protection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:security ;
    vc:contrastsWith ngm:audit ;
    vc:enables ngm:algorithmic-auditing,
        ngm:compliance-audit-trail,
        ngm:compliance-monitoring,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:compliance,
        ngm:policy-as-code ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:dev-sec-ops,
        ngm:smart-contract ;
    vc:requires ngm:data-governance,
        ngm:identity-management ;
    vc:slug "automated-compliance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:gdpr-compliance,
        ngm:regulatory-reporting,
        ngm:risk-management ;
    vc:uses ngm:access-control,
        ngm:audit-trail,
        ngm:digital-signature,
        ngm:policy-engine,
        ngm:regulatory-technology,
        ngm:rule-engine .

ngm:automated-decision-making a owl:Class ;
    rdfs:label "Automated Decision Making"@en ;
    rdfs:comment "Automated decision making is the use of algorithms or machine learning models to reach decisions about individuals or situations without meaningful human involvement. It ranges from rule-based scoring to predictions from trained models, applied to outcomes such as eligibility, pricing or risk classification. Because such decisions can significantly affect people, data protection frameworks like the GDPR grant rights around solely automated decisions, including a right to obtain human intervention and an explanation. Responsible deployment depends on fairness, transparency and accountability safeguards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:governance ;
    vc:contrastsWith ngm:human-in-the-loop ;
    vc:dependsOn ngm:model,
        ngm:predictive-analytics ;
    vc:enables ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:algorithmic-fairness ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:bias,
        ngm:explainable-ai,
        ngm:fairness ;
    vc:requires ngm:transparency ;
    vc:slug "automated-decision-making" ;
