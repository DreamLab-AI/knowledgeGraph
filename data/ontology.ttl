ngm:embodied-interaction a owl:Class ;
    rdfs:label "Embodied Interaction"@en ;
    rdfs:comment "Embodied interaction is an approach to human-computer interaction in which the user's body, physical movement, and spatial context are the primary means of engaging with digital systems. It draws on theories of embodied cognition, treating perception and action as inseparable, and is central to virtual, augmented, and mixed reality where users act through avatars and natural gesture. The paradigm prioritises tangible, gestural, and full-body input over abstract symbolic command."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:social-presence-theory ;
    vc:dependsOn ngm:proprioceptive-sensing ;
    vc:enables ngm:social-vr,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:gesture-recognition ;
    vc:isPartOf ngm:human-computer-interaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interaction-design,
        ngm:presence,
        ngm:proxemics ;
    vc:requires ngm:avatar ;
    vc:slug "embodied-interaction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:uses ngm:eye-tracking,
        ngm:haptics,
        ngm:spatial-audio .

ngm:embodied-minds a owl:Class ;
    rdfs:label "Embodied Minds"@en ;
    rdfs:comment "Embodied Minds denotes the theoretical and engineering position that genuine cognition, intelligence and meaning-making cannot be reduced to disembodied symbol manipulation or text-token prediction but instead arises from the dynamic, sensorimotor coupling of a physical body with a structured env..."@en ;
