        ngm:privacy-impact-assessment,
        ngm:privacy-utility-tradeoffs ;
    vc:requires ngm:differential-privacy,
        ngm:privacy-mechanism ;
    vc:slug "privacy-budget-management" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:responsible-ai ;
    vc:uses ngm:homomorphic-encryption,
        ngm:privacy-preserving-analytics .

ngm:privacy-preserving a owl:Class ;
    rdfs:label "Privacy-Preserving"@en ;
    rdfs:comment "Privacy-preserving describes methods and systems designed to perform useful computation or data analysis while limiting exposure of the underlying personal or sensitive data."@en ;
