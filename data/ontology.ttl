ngm:content-creation-tool a owl:Class ;
    rdfs:comment "A content creation tool is software that enables users to author, edit, and produce digital media such as text, images, audio, 3D assets, or video. It provides the interfaces and primitives needed to turn creative intent into finished, exportable artefacts. Generative AI has expanded this category to include tools that synthesise content from prompts and steer it within a production pipeline."@en ;
    rdfs:label "Content Creation Tool"@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
