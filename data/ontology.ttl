        ngm:digital-wallet,
        ngm:smart-contract ;
    vc:slug "cryptocurrency-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:erc-20,
        ngm:erc-721,
        ngm:token-standard ;
    vc:uses ngm:automated-market-maker,
        ngm:blockchain-oracle .

ngm:cryptographic-accumulator a owl:Class ;
    rdfs:label "Cryptographic Accumulator"@en ;
    rdfs:comment "A cryptographic accumulator is a primitive that compresses a large set of elements into a single short value while still permitting compact proofs that a given element is (or is not) a member of the set. Constructions based on RSA groups, bilinear pairings, or Merkle trees allow membership witnesses whose size is independent of the set's cardinality, and dynamic accumulators support efficient addition and removal of elements. Accumulators underpin scalable membership proofs in anonymous credentials, certificate revocation, and stateless blockchain clients."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:merkle-tree ;
    vc:slug "cryptographic-accumulator" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:hash-function .

ngm:cryptographic-proof-system a owl:Class ;
    rdfs:label "Cryptographic Proof System"@en ;
    rdfs:comment "A cryptographic proof system is a formal protocol allowing one party (a prover) to convince another party (a verifier) of the truth of a statement without revealing any information beyond the validity of that statement. These systems provide mathematical guarantees of soundness, completeness, and, in zero-knowledge variants, zero information leakage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:commitment-scheme ],
        ngm:cryptographic-protocol ;
    vc:enables ngm:authentication,
        ngm:cryptographic-proofs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:commitment-scheme,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "cryptographic-proof-system" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:zk-snarks,
        ngm:zk-starks .

ngm:cryptographic-proofs a owl:Class ;
    rdfs:label "Cryptographic Proofs"@en ;
    rdfs:comment "Cryptographic proofs are mathematical constructions that allow one party to convince another of the truth of a statement with cryptographic certainty, often without revealing the underlying data. They include proofs of knowledge, membership proofs, proofs of computation, and zero-knowledge proofs, and rely on primitives such as hash functions, commitments, and elliptic-curve operations. Cryptographic proofs underpin blockchain validity, verifiable computation, privacy-preserving authentication, and data-availability guarantees, letting verifiers trust outcomes they did not themselves compute."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-snark ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-hardness-assumption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-setup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-starks ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:machine-learning ;
    vc:contrastsWith ngm:fraud-proof,
        ngm:interactive-proof ;
    vc:enables ngm:data-availability,
        ngm:privacy-preserving-authentication,
        ngm:trust-minimisation,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:merkle-proof,
        ngm:zk-snark,
        ngm:zk-starks ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-accumulator,
        ngm:digital-signature,
        ngm:erasure-coding,
        ngm:merkle-tree ;
    vc:requires ngm:computational-hardness-assumption,
        ngm:trusted-setup ;
    vc:slug "cryptographic-proofs" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain,
        ngm:certificate-transparency,
        ngm:rollup ;
    vc:uses ngm:commitment-scheme,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:public-key-infrastructure,
        ngm:zero-knowledge-proof .

ngm:data-classification a owl:Class ;
    rdfs:label "Data Classification"@en ;
    rdfs:comment "Data classification is the process of organising data into categories based on its sensitivity, value and regulatory obligations, so that appropriate handling, protection and access controls can be applied consistently. Typical schemes assign labels such as public, internal, confidential and restricted, which then drive encryption, retention, sharing and disposal rules. It is a foundational activity in data governance and information security, enabling organisations to prioritise protection of their most sensitive information and to demonstrate regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:data-governance ;
    vc:dependsOn ngm:data-quality ;
    vc:enables ngm:access-control,
        ngm:data-loss-prevention,
        ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-lifecycle,
        ngm:metadata-management ;
    vc:isPartOf ngm:data-governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-lifecycle,
        ngm:data-validation ;
    vc:requires ngm:data-governance,
        ngm:metadata-management ;
    vc:slug "data-classification" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:data-privacy,
        ngm:regulatory-compliance ;
    vc:uses ngm:data-stewardship .

ngm:data-confidentiality a owl:Class ;
    rdfs:label "Data Confidentiality"@en ;
    rdfs:comment "The property that data is accessible only to those authorised to view it, protecting information from disclosure to unauthorised parties. It is one of the core objectives of information security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:information-security ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "data-confidentiality" ;
    vc:sourceDomain "security" .

ngm:data-loss-prevention a owl:Class ;
    rdfs:label "Data Loss Prevention"@en ;
    rdfs:comment "Data loss prevention (DLP) is a set of security controls and technologies that detect and block the unauthorised exfiltration, leakage or misuse of sensitive data. DLP systems classify content, monitor data in use, in motion and at rest, and enforce policies at endpoints, networks and cloud services. It is a core data-protection capability supporting compliance with privacy and confidentiality requirements."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:data-protection ;
    vc:slug "data-loss-prevention" ;
    vc:sourceDomain "security" .

ngm:data-modelling a owl:Class ;
    rdfs:label "Data Modelling"@en ;
    rdfs:comment "Data modelling is the process of defining the structure, relationships, constraints, and semantics of data to be stored, processed, or exchanged in an information system. It produces formal artefacts — conceptual, logical, and physical models — that guide database design, API contracts, and data integration. Effective data modelling ensures data consistency, reduces redundancy, and aligns technical storage structures with the business domain concepts they represent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:statistical-analysis ],
        ngm:data-management ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:euclidean-distance ;
    vc:dependsOn ngm:data-schema,
        ngm:statistical-analysis ;
    vc:enables ngm:distributed-ledger,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-schema,
        ngm:statistical-analysis ;
    vc:implements ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:governance,
        ngm:tensor-computation ;
    vc:requires ngm:data-schema,
        ngm:linear-algebra ;
    vc:slug "data-modelling" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:personal-data,
        ngm:privacy ;
    vc:uses ngm:fourier-transform,
        ngm:python-programming-language .

ngm:data-partitioning a owl:Class ;
    rdfs:label "Data Partitioning"@en ;
    rdfs:comment "Data partitioning is the practice of dividing a dataset into smaller, independently manageable subsets distributed across storage nodes or processing units to improve scalability, performance, and availability. Partitioning strategies include horizontal splitting by key range or hash, vertical splitting by column, and functional splitting by domain, each balancing query locality against load distribution. Effective partitioning underpins distributed databases and large-scale data systems by enabling parallel processing while minimising cross-partition coordination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sharding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:replication ],
        ngm:sharding ;
    vc:contrastsWith ngm:replication ;
    vc:enables ngm:load-balancing,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:replication,
        ngm:sharding ;
    vc:implements ngm:scalability ;
    vc:isPartOf ngm:distributed-ledger ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:replication,
        ngm:scalability,
        ngm:sharding ;
    vc:requires ngm:replication ;
    vc:slug "data-partitioning" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:load-balancing ;
    vc:uses ngm:sharding .

ngm:data-protection-law a owl:Class ;
    rdfs:label "Data Protection Law"@en ;
    rdfs:comment "The body of law governing how personal data may be collected, processed, stored and shared, and the rights afforded to individuals over their personal information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
