    vc:uses ngm:api-standard,
        ngm:distributed-system,
        ngm:semantic-conventions .

ngm:open-zeppelin-governor a owl:Class ;
    rdfs:label "OpenZeppelin Governor"@en ;
    rdfs:comment "OpenZeppelin Governor is a modular, security-audited Solidity smart-contract framework that provides the core infrastructure for deploying on-chain governance systems on EVM-compatible blockchains, succeeding the Compound Governor Bravo pattern. It implements a canonical proposal lifecycle — proposal creation, configurable voting delay, voting period, quorum validation, and timelock-guarded execution — with pluggable extension modules for vote-counting strategies (simple majority, Bravo-style, fractional), token-based voting-power sources (ERC-20 with EIP-5805 checkpointing or ERC-721), and TimelockController integration. The framework is maintained by the OpenZeppelin security team as part of OpenZeppelin Contracts, has undergone multiple third-party audits, and is adopted as the de facto governance standard by major decentralised autonomous organisations and DeFi protocols including Uniswap, ENS, and Compound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-delegation ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:liquid-democracy ;
    vc:contrastsWith ngm:multisig-wallet,
        ngm:optimistic-governance ;
    vc:dependsOn ngm:eip-5805,
        ngm:eip-712,
        ngm:openzeppelin-contracts ;
    vc:enables ngm:dao-governance,
        ngm:protocol-upgrade,
        ngm:treasury-management,
        ngm:voting-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:compound-governor-bravo,
        ngm:on-chain-governance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:quorum-fraction,
        ngm:snapshot-voting,
        ngm:token-weighted-voting ;
    vc:requires ngm:ethereum-virtual-machine,
        ngm:solidity,
        ngm:vote-delegation ;
    vc:slug "open-zeppelin-governor" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-autonomous-organisation,
        ngm:defi-protocol,
        ngm:upgradeable-proxy ;
    vc:uses ngm:erc-20,
        ngm:erc-721,
        ngm:governance-token,
        ngm:smart-contract,
        ngm:timelock-controller .

