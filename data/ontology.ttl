# RRT Algorithm
rb:RRTAlgorithm a owl:Class ;
    rdfs:subClassOf rb:RB1016pathplanning ;
    rdfs:label "RRT Algorithm"@en ;
    rdfs:comment "A sampling-based path planning algorithm that incrementally builds a tree of collision-free configurations by randomly sampling the configuration space and connecting samples to the nearest existing tree node. It efficiently explores high-dimensional spaces and is probabilistically complete."@en ;
    skos:prefLabel "RRT Algorithm"@en ;
    dcterms:identifier "RB-1017" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.96"^^xsd:decimal ;
    rdf:type owl:AlgorithmClass .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:alternativeTo ;
    owl:someValuesFrom rb:RB1018dijkstraalgorithm
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:alternativeTo ;
    owl:someValuesFrom rb:AStarAlgorithm
] .

