# Kalman Filter
robotics:KalmanFilter rdf:type owl:Class ;
    rdfs:subClassOf robotics:StateEstimation ;
    rdfs:subClassOf robotics:BayesFilter ;
    rdfs:label "Kalman Filter"@en ;
    rdfs:comment "An optimal recursive Bayesian filter that estimates the state of a linear dynamic system from a series of noisy measurements. It minimizes the mean squared error of the estimated state by combining predictions with measurements using weighted averaging based on uncertainty."@en ;
    skos:prefLabel "Kalman Filter"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:kalman-filter" ;
    owl:sameAs <urn:visionclaw:concept:robotics:kalman-filter> ;
    vcw:contentHash "sha256-12-62ba72c5c04d" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "RB-1015" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.98"^^xsd:decimal ;
    dcterms:identifier "RB-1015" ;
    dcterms:subject "robotics" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2025-11-24T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Algorithm" .

