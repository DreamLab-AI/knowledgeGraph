ngm:acid-transactions a owl:Class ;
    rdfs:label "Acid Transactions"@en ;
    rdfs:comment "ACID transactions are units of database work that uphold four guarantees: atomicity, consistency, isolation and durability. Atomicity ensures a transaction either fully completes or has no effect; consistency keeps the database in a valid state; isolation prevents concurrent transactions from interfering; and durability guarantees committed changes survive failures. Together these properties allow reliable, predictable updates to shared data and form the bedrock of relational database systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:two-phase-commit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database ],
        ngm:database-management-system ;
    vc:dependsOn ngm:database-management-system,
        ngm:write-ahead-logging ;
    vc:enables ngm:relational-database ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:two-phase-commit ;
    vc:implements ngm:data-integrity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:centralised-database,
        ngm:data ;
    vc:requires ngm:database ;
    vc:slug "acid-transactions" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:sql ;
    vc:uses ngm:two-phase-commit,
        ngm:write-ahead-logging .

ngm:active-research-projects-registry a owl:Class ;
    rdfs:label "Active Research Projects Registry"@en ;
    rdfs:comment "An Active Research Projects Registry is a structured, queryable catalogue that maintains authoritative records of ongoing research initiatives, development workstreams, and collaborative projects within an organisation or knowledge graph, capturing metadata such as status, ownership, objectives, dependencies, and timelines. It serves as a single source of truth for portfolio governance, enabling stakeholders to discover, track, and coordinate active work without duplicating effort or losing context across distributed teams. Unlike a static document index, a living registry integrates with project management workflows, version control systems, and knowledge management platforms to reflect real-time project state. It supports prioritisation, resource allocation, and strategic alignment by surfacing the relationships between concurrent initiatives and shared infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:applied-ai-research-portfolio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:project-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph-kanban-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:data-registry ;
    vc:bridgesTo ngm:fair-data-principles,
        ngm:open-data ;
    vc:contrastsWith ngm:data-catalog,
        ngm:empirical-experimental-design-tracking ;
    vc:enables ngm:automated-planning,
        ngm:collaboration,
        ngm:knowledge-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:applied-ai-research-portfolio,
        ngm:knowledge-graph-kanban-board,
        ngm:project-management ;
    vc:isPartOf ngm:knowledge-management-system ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:agentic-workflow,
        ngm:collaboration-platform,
        ngm:knowledge-graph-publication-classifier ;
    vc:requires ngm:data-governance,
        ngm:metadata-management,
        ngm:version-control ;
    vc:slug "active-research-projects-registry" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-research-tooling-suite,
        ngm:decentralised-agent-coordination-initiative ;
    vc:uses ngm:agile-software-development,
        ngm:data-catalog,
        ngm:knowledge-graph .

ngm:adapter-tuning a skos:Concept ;
    rdfs:label "Adapter Tuning"@en .

ngm:adaptive-behaviour a owl:Class ;
    rdfs:label "Adaptive Behaviour"@en ;
    rdfs:comment "Adaptive behaviour refers to the capacity of an agent, system, or organism to modify its actions, strategies, or responses in real time based on feedback from its environment, internal state, or prior experience. In computational and robotics contexts, it describes dynamic adjustment of policies or control laws to optimise performance under changing conditions. The concept underpins reinforcement learning, autonomous agents, and self-organising systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:exploration-exploitation-tradeoff ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
