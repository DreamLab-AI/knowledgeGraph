        ngm:evaluation-metric,
        ngm:forecast-horizon,
        ngm:interval-forecast,
        ngm:lookback-window,
        ngm:point-forecast,
        ngm:probabilistic-forecast,
        ngm:reconciliation-step ;
    vc:implements ngm:arima,
        ngm:exponential-smoothing,
        ngm:hierarchical-reconciliation,
        ngm:lstm,
        ngm:normalising-flows,
        ngm:quantile-regression,
