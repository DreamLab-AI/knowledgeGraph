        ngm:risk-management,
        ngm:security-operations-centre ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:indicators-of-compromise,
        ngm:malware-analysis,
        ngm:threat-actor-profiling,
        ngm:vulnerability-intelligence ;
    vc:implements ngm:mitre-attack-framework,
        ngm:stix-taxii ;
    vc:isPartOf ngm:information-security ;
    vc:qualityScore "0.75"^^xsd:float ;
