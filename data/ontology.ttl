    vc:uses ngm:fiat-currency,
        ngm:kyc .

ngm:customer-experience a owl:Class ;
    rdfs:label "Customer Experience"@en ;
    rdfs:comment "Customer experience (CX) is the holistic perception a customer forms of an organisation across every interaction and touchpoint throughout the customer lifecycle, from initial awareness through purchase, post-sale service, and eventual advocacy or churn. It encompasses emotional, cognitive, sensory, and behavioural dimensions of customer engagement and is recognised as a primary competitive differentiator in markets where product parity is high. Organisations systematically measure and engineer CX through journey mapping, voice-of-customer programmes, service design, and data-driven personalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:customer-data-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-resolution ],
        ngm:user-experience ;
    vc:bridgesTo ngm:agentic-ai,
        ngm:artificial-intelligence,
        ngm:spatial-computing ;
    vc:enables ngm:customer-lifetime-value,
        ngm:customer-retention,
        ngm:customer-service-automation,
        ngm:hyper-personalisation,
        ngm:loyalty-programs,
        ngm:next-best-action ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:journey-mapping,
        ngm:omnichannel-orchestration,
        ngm:service-blueprint,
        ngm:service-design,
        ngm:voice-of-customer ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:crm,
        ngm:customer-rewards,
        ngm:customer-support,
        ngm:data-governance,
        ngm:data-privacy,
        ngm:digital-twin-of-the-customer,
        ngm:service-design ;
    vc:requires ngm:consent-management,
        ngm:customer-data-platform,
        ngm:first-party-data,
        ngm:identity-resolution,
        ngm:unified-customer-profile ;
    vc:slug "customer-experience" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:behavioral-analytics,
        ngm:conversational-ai,
        ngm:journey-mapping,
        ngm:large-language-models,
        ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:predictive-personalization,
        ngm:real-time-decisioning,
        ngm:sentiment-analysis,
        ngm:voice-of-customer .

ngm:danksharding a owl:Class ;
    rdfs:label "Danksharding"@en ;
    rdfs:comment "Danksharding is a data-availability scaling design for Ethereum that scales the blockchain by providing large amounts of cheap data space for rollups rather than sharding execution. It uses a unified fee market and a merged block-building process in which a single proposer commits to a block containing many data blobs, the availability of which is verified through data-availability sampling and erasure coding. Danksharding is the long-term target architecture that proto-danksharding incrementally builds towards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kzg-commitment ],
        ngm:sharding ;
    vc:bridgesTo ngm:optimistic-rollup,
        ngm:zk-rollup ;
    vc:dependsOn ngm:beacon-chain,
        ngm:data-availability ;
    vc:enables ngm:rollup,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-availability-sampling,
        ngm:erasure-coding ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:proof-of-stake,
        ngm:proto-danksharding ;
    vc:requires ngm:blob-transaction,
        ngm:kzg-commitment ;
    vc:slug "danksharding" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:validator ;
    vc:uses ngm:polynomial-commitment .

ngm:data-consistency a owl:Class ;
    rdfs:label "Data Consistency"@en ;
    rdfs:comment "Data consistency is the guarantee that data remains valid, coherent and in agreement across copies, transactions and nodes of a system. In distributed systems it spans a spectrum from strong consistency, where all readers observe the latest write, to eventual consistency, where replicas converge over time. It is a core correctness property traded off against availability and latency, and it underpins fault-tolerant data layers."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:fault-tolerance ;
    vc:slug "data-consistency" ;
    vc:sourceDomain "infrastructure" .

ngm:data-discovery a owl:Class ;
    rdfs:label "Data Discovery"@en ;
    rdfs:comment "Data Discovery is the iterative process of locating, profiling, cataloguing, and contextualising data assets distributed across an organisation's storage systems, databases, data lakes, SaaS applications, and streaming pipelines to make them findable, understandable, and trustworthy for analytics, governance, and compliance purposes. It encompasses automated metadata extraction, schema inference, data profiling (statistical characterisation), lineage tracing (upstream/downstream dependencies), and classification (sensitivity tagging). Data Discovery is foundational to implementing Data Governance frameworks and enabling self-service analytics in data mesh and data fabric architectures."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-governance,
        ngm:metadata-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-discovery" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-management ;
    vc:uses ngm:data-lake,
        ngm:metadata-registry .

ngm:data-labelling a owl:Class ;
    rdfs:label "Data Labelling"@en ;
    rdfs:comment "Data labelling is the process of annotating raw data, such as images, text, audio or sensor readings, with the target outputs or categories a supervised model is expected to predict. It produces the ground-truth signal that links inputs to desired outputs and largely determines the achievable accuracy of trained models. Labelling combines human annotators, guidelines, tooling and quality control, increasingly augmented by model-assisted and active-learning workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        ngm:data-annotation ;
    vc:bridgesTo ngm:dataset-curation ;
    vc:contrastsWith ngm:active-learning ;
    vc:dependsOn ngm:data-quality ;
    vc:enables ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dataset-curation,
        ngm:ground-truth ;
    vc:isPartOf ngm:training-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-quality,
        ngm:ground-truth ;
    vc:requires ngm:human-in-the-loop,
        ngm:training-data ;
    vc:slug "data-labelling" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:active-learning,
        ngm:supervised-learning ;
    vc:uses ngm:human-in-the-loop .

ngm:data-protection-officer a owl:Class ;
    rdfs:label "Data Protection Officer"@en ;
    rdfs:comment "A Data Protection Officer (DPO) is an organisational role responsible for overseeing an entity's data-protection strategy and monitoring compliance with applicable privacy law such as the GDPR. The DPO advises on data-protection obligations, conducts and reviews privacy impact assessments, serves as the contact point for supervisory authorities and data subjects, and operates with independence from operational management. Designation of a DPO is mandatory under the GDPR for public authorities and for controllers or processors whose core activities involve large-scale or sensitive personal-data processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        ngm:data-governance ;
    vc:dependsOn ngm:gdpr ;
    vc:enables ngm:consent-management,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:pseudonymisation ;
    vc:isPartOf ngm:data-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:data-protection,
        ngm:supervisory-authority ;
    vc:requires ngm:privacy-impact-assessment,
        ngm:regulatory-compliance ;
    vc:slug "data-protection-officer" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:data-privacy,
        ngm:data-subject-rights .

ngm:data-transformation a owl:Class ;
    rdfs:label "Data Transformation"@en ;
    rdfs:comment "Data transformation is the process of converting data from one structure, format or representation into another to make it suitable for storage, integration or analysis. It includes cleansing, type conversion, normalisation, aggregation, enrichment, schema mapping and serialisation, and is typically expressed as declarative or programmatic steps within a pipeline. Transformation reconciles heterogeneous sources, enforces quality and conformance rules, and shapes raw inputs into the canonical forms required by downstream systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-cleaning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-serialization ],
        ngm:data-processing ;
    vc:bridgesTo ngm:data-integration ;
    vc:dependsOn ngm:data-engineering ;
    vc:enables ngm:data-analytics,
        ngm:data-integration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-cleaning,
        ngm:data-serialization ;
    vc:implements ngm:etl ;
    vc:isPartOf ngm:data-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:data-processing ;
    vc:requires ngm:data-quality ;
    vc:slug "data-transformation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-warehouse,
        ngm:feature-engineering ;
    vc:uses ngm:data-validation,
        ngm:schema .

ngm:dds-middleware a owl:Class ;
    rdfs:label "DDS Middleware"@en ;
    rdfs:comment "Data Distribution Service (DDS) Middleware is an OMG-standardised publish-subscribe communication middleware designed for real-time, scalable, and decentralised data exchange in safety-critical and high-performance distributed systems. It defines a Data-Centric Publish-Subscribe (DCPS) model in which participants discover each other automatically and exchange typed data via a global data space, governed by a rich set of Quality of Service (QoS) policies covering reliability, latency, deadline, liveliness, and durability. DDS is the foundational communication layer for ROS 2, NATO's STANAG 4910 tactical networks, and aerospace control systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:publish-subscribe-pattern ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-of-service ],
        ngm:middleware ;
    vc:bridgesTo ngm:infrastructure,
        ngm:robotics ;
    vc:contrastsWith ngm:message-broker,
        ngm:mqtt ;
    vc:enables ngm:autonomous-vehicle,
        ngm:collaborative-systems-modality-robotics,
        ngm:industrial-robot,
        ngm:real-time,
        ngm:robot-kinematics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:publish-subscribe-pattern,
        ngm:quality-of-service ;
    vc:implements ngm:communication-protocol,
        ngm:distributed-system-protocol,
        ngm:publish-subscribe-pattern ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:middleware-layer,
        ngm:time-sensitive-networking ;
    vc:requires ngm:network-transport ;
    vc:slug "dds-middleware" ;
    vc:sourceDomain "distributed-systems" ;
    vc:standardizedBy ngm:object-management-group ;
    vc:supports ngm:digital-twin,
        ngm:ros-2,
        ngm:safety-critical-systems ;
    vc:uses ngm:distributed-systems,
        ngm:embedded-systems .

ngm:democratic-governance a owl:Class ;
    rdfs:label "Democratic Governance"@en ;
    rdfs:comment "Democratic Governance is an infrastructure concept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:regulatory-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "democratic-governance" ;
    vc:sourceDomain "infrastructure" .

ngm:dialogue-management a owl:Class ;
    rdfs:label "Dialogue Management"@en ;
    rdfs:comment "Dialogue management is the component of a conversational system that tracks the evolving state of an interaction and decides the system's next action at each turn. It maintains context across utterances, integrates recognised user intents and slots, and selects responses or operations that move the conversation toward the user's goal. It is the control layer that connects language understanding to language generation in a dialogue agent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slot-filling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-management ],
        ngm:conversational-ai ;
    vc:bridgesTo ngm:natural-language-understanding ;
    vc:dependsOn ngm:natural-language-understanding ;
    vc:enables ngm:chatbot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:context-management,
        ngm:state-tracking ;
    vc:implements ngm:conversational-ai ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:chatbot,
        ngm:context-management ;
    vc:requires ngm:intent-recognition,
        ngm:slot-filling ;
    vc:slug "dialogue-management" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:reinforcement-learning .

ngm:did a owl:Class ;
    rdfs:label "DID"@en ;
    rdfs:comment "A decentralised identifier, a type of globally unique identifier that enables verifiable, self-sovereign digital identity without reliance on a central registry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        ngm:self-sovereign-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralized-identifiers,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:federated-identity ;
    vc:enables ngm:authentication,
        ngm:decentralized-identity,
        ngm:key-agreement,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:did-method,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:service-endpoint,
        ngm:trust-registry,
        ngm:wallet ;
    vc:requires ngm:cryptography,
        ngm:did-document,
        ngm:did-resolver,
        ngm:public-key ;
    vc:slug "did" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:privacy-preserving-authentication,
        ngm:selective-disclosure,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:digital-signature,
        ngm:json-data-interchange-format-ld,
        ngm:public-key-infrastructure .

ngm:diffie-hellman-key-exchange a owl:Class ;
    rdfs:label "Diffie-Hellman Key Exchange"@en ;
    rdfs:comment "Diffie-Hellman Key Exchange is a cryptographic method by which two parties establish a shared secret over an insecure channel without ever transmitting the secret itself. Each party combines its private value with the other party's public value such that both arrive at the same key, which an eavesdropper cannot feasibly compute. Its security rests on the difficulty of the discrete logarithm problem, with elliptic-curve variants offering equivalent strength at smaller key sizes. It underpins forward-secret session establishment in protocols such as Transport Layer Security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        ngm:key-exchange ;
    vc:contrastsWith ngm:symmetric-encryption ;
    vc:dependsOn ngm:asymmetric-cryptography ;
    vc:enables ngm:perfect-forward-secrecy,
        ngm:secure-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:private-key,
        ngm:public-key ;
    vc:implements ngm:key-agreement ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:elliptic-curve-cryptography ;
    vc:slug "diffie-hellman-key-exchange" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:tls-handshake,
        ngm:transport-layer-security ;
    vc:uses ngm:discrete-logarithm-problem,
        ngm:modular-arithmetic .

ngm:digital-asset-market a owl:Class ;
    rdfs:label "Digital Asset Market"@en ;
    rdfs:comment "A marketplace — centralised or decentralised — where digital assets including cryptocurrencies, NFTs, and tokenised securities are bought, sold, and exchanged. Digital asset markets encompass order-book exchanges, automated market makers, NFT marketplaces, and OTC desks, each governed by distinct liquidity, pricing, and regulatory mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-provision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-trading ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft-marketplace ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-infrastructure ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:distributed-ledger-technology ;
    vc:dependsOn ngm:custodial-settlement,
        ngm:digital-wallet ;
    vc:enables ngm:decentralised-finance,
        ngm:tokenised-securities ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralised-exchange,
        ngm:digital-asset-trading,
        ngm:nft-marketplace,
        ngm:order-book ;
    vc:isPartOf ngm:digital-asset-ecosystem,
        ngm:financial-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:cryptocurrency,
        ngm:market-microstructure ;
    vc:requires ngm:blockchain,
        ngm:digital-asset-infrastructure,
        ngm:liquidity-provision,
        ngm:price-discovery ;
    vc:slug "digital-asset-market" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:travel-rule ;
    vc:supports ngm:anti-money-laundering,
        ngm:market-surveillance ;
    vc:uses ngm:automated-market-maker,
        ngm:cryptographic-token,
        ngm:smart-contract .

ngm:digital-forensics a owl:Class ;
    rdfs:label "Digital Forensics"@en ;
    rdfs:comment "Digital forensics is the scientific discipline concerned with the identification, preservation, extraction, analysis, and presentation of digital evidence from computing systems, networks, storage media, and connected devices in a manner that is legally admissible and reproducible. It applies structured methodologies — including write-blocked acquisition, cryptographic hashing for evidence integrity, and chain-of-custody documentation — to support criminal investigations, civil litigation, incident response, and regulatory compliance inquiries. Sub-disciplines include network forensics, mobile forensics, memory forensics, and cloud forensics, each requiring specialist tools and legal frameworks adapted to the peculiarities of the evidence medium. Practitioner outputs must survive rigorous judicial scrutiny, compelling both technical rigour and defensible, auditable process documentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-custody ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:data-analytics,
        ngm:machine-learning ;
    vc:contrastsWith ngm:penetration-testing,
        ngm:vulnerability-assessment ;
    vc:enables ngm:e-discovery,
        ngm:threat-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:incident-response,
        ngm:log-management,
        ngm:network-security,
        ngm:penetration-testing,
        ngm:threat-detection,
        ngm:threat-model ;
    vc:requires ngm:chain-of-custody ;
    vc:slug "digital-forensics" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27037 ;
    vc:supports ngm:cybersecurity-standard,
        ngm:legal-proceedings,
        ngm:regulatory-compliance ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-evidence-chain-of-custody,
        ngm:digital-forensics-framework,
        ngm:write-blocker .

ngm:digital-regulation a owl:Class ;
    rdfs:label "Digital Regulation"@en ;
    rdfs:comment "Digital Regulation is the body of law, policy instruments, technical standards, and enforcement mechanisms that govern the development, deployment, operation, and use of digital technologies — including artificial intelligence systems, online platforms, data-driven services, and digital communications infrastructure. It addresses algorithmic accountability, platform liability, data sovereignty, content moderation obligations, cybersecurity requirements, and cross-border regulatory harmonisation, aiming to balance innovation incentives with fundamental rights protections, market competition, and public safety objectives. Digital Regulation operates across multiple jurisdictional layers — supranational, national, and sector-specific — and increasingly relies on regulatory sandboxes, conformity assessments, and co-regulatory models that involve both government bodies and industry stakeholders. Its scope has expanded rapidly with the proliferation of AI, cloud computing, and large-scale data ecosystems, making it a central mechanism for translating societal values into enforceable technical and operational constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-sovereignty ],
        ngm:governance ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:deregulation,
        ngm:self-regulation ;
    vc:dependsOn ngm:policy-framework,
        ngm:standards ;
    vc:enables ngm:ai-safety,
        ngm:consumer-protection,
        ngm:data-protection,
        ngm:digital-rights ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:algorithmic-accountability,
        ngm:content-moderation,
        ngm:data-sovereignty,
        ngm:platform-liability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:cybersecurity,
        ngm:intellectual-property-rights-framework,
        ngm:privacy ;
    vc:requires ngm:compliance,
        ngm:governance,
        ngm:regulatory-framework ;
    vc:slug "digital-regulation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:digital-trust,
        ngm:market-competition .

ngm:directed-acyclic-graph a owl:Class ;
    rdfs:label "Directed Acyclic Graph"@en ;
    rdfs:comment "A directed acyclic graph (DAG) is a graph whose edges have direction and which contains no directed cycles, so no path returns to its starting vertex. This structure naturally encodes ordered dependencies, enabling a topological ordering of vertices and making DAGs foundational for scheduling, dependency resolution, version histories, and certain distributed-ledger designs. The absence of cycles guarantees that dependency chains terminate, which underpins many algorithms built on top of the structure."@en ;
    rdfs:subClassOf ngm:graph-theory ;
    vc:contrastsWith ngm:merkle-dag ;
    vc:dependsOn ngm:graph-theory ;
    vc:enables ngm:distributed-ledger,
        ngm:workflow-orchestration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:version-control,
        ngm:workflow-orchestration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:git,
        ngm:merkle-dag ;
    vc:slug "directed-acyclic-graph" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:distributed-systems ;
    vc:uses ngm:graph-theory .

ngm:distance-metric a owl:Class ;
    rdfs:label "Distance Metric"@en ;
    rdfs:comment "A distance metric is a function that quantifies how dissimilar two data points are, satisfying non-negativity, identity, symmetry and the triangle inequality. In machine learning it defines the geometry of a feature space and thereby governs nearest-neighbour search, clustering and similarity-based retrieval. Choosing or learning an appropriate metric is often as important as the model itself for tasks driven by proximity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cosine-similarity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-embedding ],
        ngm:machine-learning ;
    vc:contrastsWith ngm:cosine-similarity ;
    vc:enables ngm:clustering,
        ngm:nearest-neighbor-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cosine-similarity ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:clustering,
        ngm:cosine-similarity ;
    vc:requires ngm:statistics,
        ngm:vector-embedding ;
    vc:slug "distance-metric" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:vector-embedding ;
    vc:uses ngm:vector-embedding .

ngm:distributed-databases a owl:Class ;
    rdfs:label "Distributed Databases"@en ;
    rdfs:comment "A distributed database stores and manages data across multiple networked nodes, presenting a unified logical database while partitioning and replicating data for scale and resilience. It must reconcile the trade-offs of the CAP theorem, choosing among strong consistency, availability, and partition tolerance through consensus, quorum, or conflict-resolution strategies. It underpins large-scale applications that exceed the capacity or fault-tolerance limits of a single server."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:distributed-computing ;
    vc:slug "distributed-databases" ;
    vc:sourceDomain "data" .

ngm:e-idas a owl:Class ;
    rdfs:label "eIDAS"@en ;
    rdfs:comment "A European Union regulation establishing a framework for electronic identification and trust services for electronic transactions across the internal market, defining assurance levels, legal effects for electronic signatures, seals, timestamps and certificates, and mandating mutual recognition of notified national identity schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:regulatory-framework ;
    vc:bridgesTo ngm:blockchain-identity,
        ngm:decentralised-identifier,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:fido2,
        ngm:self-sovereign-identity ;
    vc:enables ngm:cross-border-authentication,
        ngm:digital-identity,
        ngm:identity-verification,
        ngm:timestamp ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eu-digital-single-market ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:know-your-customer ;
    vc:requires ngm:certificate-authority,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "e-idas" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:etsi,
        ngm:european-commission ;
    vc:supports ngm:digital-identity-wallet,
        ngm:gdpr,
        ngm:open-banking ;
    vc:uses ngm:qualified-electronic-signature,
        ngm:x-509-certificate .

ngm:embedded-system a owl:Class ;
    rdfs:label "Embedded System"@en ;
    rdfs:comment "An embedded system is a dedicated computing system designed to perform specific functions within a larger mechanical or electrical system, typically under real-time constraints. It combines a microcontroller or microprocessor with firmware and tightly coupled hardware such as sensors and actuators, often operating with limited memory, power, and processing resources. Embedded systems are ubiquitous in consumer devices, vehicles, industrial equipment, and robotics."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:dependsOn ngm:firmware,
        ngm:hardware-abstraction-layer,
        ngm:rtos ;
    vc:enables ngm:automation,
        ngm:io-t,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:control-system,
        ngm:internet-of-things ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:firmware,
        ngm:fpga,
        ngm:microcontroller,
        ngm:real-time,
        ngm:system-on-chip ;
    vc:slug "embedded-system" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:edge-computing,
        ngm:power-management ;
    vc:uses ngm:actuator,
        ngm:microcontroller,
        ngm:sensor .

ngm:ethereum-smart-contract-platform-foundation a owl:Class ;
    rdfs:label "Ethereum Foundation"@en ;
    rdfs:comment "The Ethereum Foundation is a non-profit organisation, registered in Switzerland, that supports the development of the Ethereum protocol and its surrounding research and developer community. It funds core protocol research, client development, security audits and educational initiatives, but does not control the network, which is maintained by a decentralised set of clients, validators and contributors. The Foundation was established around the 2014 to 2015 launch of Ethereum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-governance ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:open-source-governance ;
    vc:contrastsWith ngm:bitcoin-proof-of-work-protocol-core ;
    vc:dependsOn ngm:ethereum-improvement-proposal,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:enables ngm:decentralised-application,
        ngm:ethereum-smart-contract-platform,
        ngm:layer-2-scaling,
        ngm:proof-of-stake ;
