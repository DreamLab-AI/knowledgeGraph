ngm:case-management a owl:Class ;
    rdfs:comment "A business-process discipline for handling unstructured, knowledge-intensive work items — 'cases' — whose resolution path cannot be fully predetermined, such as compliance investigations, insurance claims, legal matters, and customer disputes. Each case aggregates documents, tasks, participants, deadlines, and an audit trail around a single subject, and progresses through investigation, decision, and resolution stages guided by worker judgement rather than a rigid predefined flow."@en ;
    rdfs:label "Case Management"@en ;
    rdfs:subClassOf ngm:business-process-management ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:transaction-monitoring ;
