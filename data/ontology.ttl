ngm:model-predictive-control a owl:Class ;
    rdfs:label "Model Predictive Control"@en ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced control methodology in which a mathematical model of the controlled process is used to predict future system states over a receding finite time horizon, and a constrained optimisation problem is solved at each control step to determine the optimal sequence of control inputs. Only the first input of the computed sequence is applied, and the optimisation is repeated at the next step with an updated state estimate, producing a closed-loop feedback effect. MPC handles multi-input multi-output systems, hard constraints on states and inputs, and competing control objectives in a unified framework, making it widely used in chemical process control, autonomous vehicles, and robotic manipulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        ngm:optimal-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:feedback-control ;
    vc:enables ngm:robot-control,
        ngm:trajectory-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:control-system,
        ngm:state-estimation ;
    vc:slug "model-predictive-control" ;
    vc:sourceDomain "robotics" .

ngm:network-component a owl:Class ;
    rdfs:label "Network Component"@en ;
    rdfs:comment "Network Component represents the fundamental infrastructure elements that constitute blockchain networks, including different node types, network protocols, and communication layers."@en ;
