ngm:greenhouse-gas-inventory a owl:Class ;
    rdfs:label "Greenhouse Gas Inventory"@en ;
    rdfs:comment "A greenhouse gas inventory is a systematic, periodic accounting of the greenhouse gas emissions and removals attributable to an organisation, activity or jurisdiction over a defined period, expressed in carbon-dioxide-equivalent units. It categorises emissions by source and by scope, applies emission factors to activity data, and forms the quantitative basis for target-setting, reporting and reduction strategies. Inventories underpin compliance, disclosure and progress toward net-zero commitments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ghg-protocol ],
        ngm:carbon-accounting ;
    vc:enables ngm:carbon-neutrality,
