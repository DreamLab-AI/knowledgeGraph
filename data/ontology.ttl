ngm:chain-state a owl:Class ;
    rdfs:label "Chain State"@en ;
    rdfs:comment "Chain State is the complete, current snapshot of all data held by a blockchain at a given block height, encompassing account balances, smart contract storage, unspent transaction outputs (UTXOs), and any other data structures committed to the ledger. It represents the authoritative, globally agreed world-state that full nodes maintain and update after each validated block, serving as the ground truth against which new transactions are validated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:account-model ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:smart-contract,
        ngm:smart-contracts ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:account-model,
        ngm:merkle-root,
        ngm:merkle-tree ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:distributed-data-structure,
        ngm:distributed-ledger,
        ngm:distributed-ledger-technology ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism,
        ngm:consensus-protocol ;
    vc:slug "chain-state" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-header,
        ngm:merkle-proof .

