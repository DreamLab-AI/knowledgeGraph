    vc:slug "shamir-secret-sharing" ;
    vc:sourceDomain "metaverse" .

ngm:shap a owl:Class ;
    rdfs:label "SHAP"@en ;
    rdfs:comment "SHAP, short for SHapley Additive exPlanations, is a method for explaining the output of machine-learning models by attributing each prediction to its input features. It is grounded in Shapley values from cooperative game theory, which fairly distribute a payoff among contributors, treating each feature as a player and the prediction as the payoff. SHAP provides locally accurate, consistent feature attributions and unifies several earlier explanation techniques under a common framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        ngm:machine-learning-domain ;
    vc:enables ngm:feature-attribution,
        ngm:model-interpretability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:machine-learning-model,
        ngm:shapley-value ;
    vc:slug "shap" ;
    vc:sourceDomain "shap" .

ngm:shape-memory-alloy-actuator a owl:Class ;
    rdfs:label "Shape Memory Alloy Actuator"@en ;
    rdfs:comment "A shape memory alloy (SMA) actuator exploits the thermoelastic phase transformation of nickel-titanium (Nitinol) or similar alloys, which contract and generate force when thermally activated, then return to their original shape on cooling. SMA actuators are valued for their high force-to-weight ratio, silent operation, and inherent compliance, making them well-suited to soft robotics, minimally invasive surgical tools, and wearable exoskeletons. Control bandwidth is limited by thermal cycle times, which remains a key engineering challenge."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:exoskeleton-robot,
        ngm:haptic-feedback,
        ngm:surgical-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:soft-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:hydraulic-actuator,
        ngm:manipulation,
        ngm:pneumatic-actuator,
        ngm:robot-actuator ;
    vc:slug "shape-memory-alloy-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:tactile-sensor .

ngm:sheffield a owl:Class ;
    rdfs:label "Sheffield"@en ;
    rdfs:comment "A city in South Yorkshire, England, historically associated with steel and now with advanced manufacturing, materials research, and engineering."@en ;
