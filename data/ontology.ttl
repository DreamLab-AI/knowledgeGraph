ngm:mlflow a owl:Class ;
    rdfs:label "MLflow"@en ;
    rdfs:comment "MLflow is an open-source platform for managing the machine learning lifecycle, covering experiment tracking, reproducible runs, model packaging, and a model registry. It records parameters, metrics, code versions, and artefacts including checkpoints, enabling teams to compare experiments and promote models to production. It is framework-agnostic and integrates with most training libraries and serving backends."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints ;
    vc:slug "mlflow" ;
    vc:sourceDomain "ai" .

ngm:mobile-edge-computing a owl:Class ;
    rdfs:label "Mobile Edge Computing"@en ;
    rdfs:comment "Mobile edge computing, also termed multi-access edge computing, places cloud computing capabilities at the edge of the mobile network, close to end users and devices. By hosting applications and services at base stations or aggregation points it reduces latency, conserves backhaul bandwidth and enables real-time processing. It is a foundational enabler for 5G use cases such as augmented reality, autonomous vehicles and industrial automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-architecture ],
        ngm:edge-computing ;
    vc:bridgesTo ngm:latency ;
    vc:contrastsWith ngm:cloud-computing ;
    vc:dependsOn ngm:cloud-computing ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-vehicle,
        ngm:ultra-low-latency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:edge-computing-architecture,
        ngm:network-slicing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:fog-computing,
        ngm:mobile-computing ;
    vc:requires ngm:network-architecture ;
    vc:slug "mobile-edge-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-ai,
        ngm:io-t,
        ngm:smart-city ;
    vc:uses ngm:content-delivery-network .

ngm:mobile-manipulation a owl:Class ;
    rdfs:label "Mobile Manipulation"@en ;
    rdfs:comment "Mobile manipulation is the subfield of robotics that integrates a locomoting mobile base with one or more robotic manipulator arms, enabling a robot to traverse unstructured environments and physically interact with objects beyond the reach of a fixed-base system. It requires the coordinated control of both navigation and dexterous manipulation, necessitating joint motion planning, whole-body control, and perception pipelines that resolve the relative pose of targets in the robot's frame. The discipline addresses challenges absent in purely fixed-arm or purely mobile systems, including base-arm kinematic coupling, dynamic stability during manipulation, and long-horizon task planning across navigation and contact phases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mobile-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotic-arm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:manipulator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        ngm:manipulation ;
    vc:bridgesTo ngm:human-robot-interaction,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:autonomous-navigation ;
    vc:dependsOn ngm:force-control,
        ngm:robot-perception,
        ngm:task-and-motion-planning ;
    vc:enables ngm:service-robotics,
        ngm:surgical-robot,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:end-effector,
        ngm:robotic-arm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot,
        ngm:legged-robot,
        ngm:reinforcement-learning,
        ngm:robot-learning ;
    vc:requires ngm:manipulator,
        ngm:mobile-robot,
        ngm:motion-planning,
        ngm:perception ;
    vc:slug "mobile-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inverse-kinematics,
        ngm:joint-configuration,
        ngm:simultaneous-localisation-and-mapping,
        ngm:whole-body-control .

ngm:model-based-reinforcement-learning a owl:Class ;
    rdfs:label "Model Based Reinforcement Learning"@en ;
    rdfs:comment "Model-based reinforcement learning is a class of reinforcement learning in which the agent learns or is given an explicit model of the environment's dynamics and reward, then uses that model to plan or to generate simulated experience for policy improvement. By predicting future states it can be far more sample-efficient than model-free methods, at the cost of vulnerability to model error. It underpins planning algorithms, world models and many robotics control approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:q-learning ;
    vc:dependsOn ngm:world-model ;
    vc:enables ngm:planning,
        ngm:sample-efficiency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:planning,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:markov-decision-process,
        ngm:reinforcement-learning,
        ngm:world-model ;
    vc:requires ngm:markov-decision-process ;
    vc:slug "model-based-reinforcement-learning" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:agent,
        ngm:robotics ;
    vc:uses ngm:model-predictive-control,
        ngm:planning,
        ngm:world-model .

ngm:model-scaling a owl:Class ;
    rdfs:label "Model Scaling"@en ;
    rdfs:comment "Model scaling is the practice of systematically increasing the size of a machine learning model, the volume of training data, and the compute budget to improve performance in line with empirical scaling laws. Predictable power-law relationships link these resources to reductions in loss, guiding decisions about parameter counts and data allocation. Scaling has been a primary driver behind the capabilities of modern foundation models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:scaling-laws ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:scaling-laws ;
    vc:enables ngm:foundation-model,
        ngm:large-language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:scaling-laws ;
    vc:isPartOf ngm:scaling-laws ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:parameter-count,
        ngm:transformer ;
    vc:requires ngm:compute-infrastructure,
        ngm:model-training ;
    vc:slug "model-scaling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:foundation-model ;
    vc:uses ngm:distributed-training,
        ngm:parameter-count .

ngm:molecular-dynamics a owl:Class ;
    rdfs:label "Molecular Dynamics"@en ;
    rdfs:comment "Molecular dynamics is a computational simulation method that models the physical movement of atoms and molecules by numerically integrating Newton's equations of motion under an interatomic force field. It produces time-resolved trajectories from which thermodynamic and kinetic properties are derived. The method bridges physics-based simulation and machine learning in computational biology and chemistry."@en ;
    rdfs:subClassOf ngm:simulation ;
    vc:bridgesTo ngm:computational-biology ;
    vc:dependsOn ngm:physics-simulation ;
    vc:enables ngm:drug-discovery,
        ngm:protein-structure-prediction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:simulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computational-biology,
        ngm:drug-discovery,
        ngm:protein-structure-prediction,
        ngm:simulation ;
    vc:slug "molecular-dynamics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:drug-discovery ;
    vc:uses ngm:linear-algebra,
        ngm:physics-simulation .

ngm:monte-carlo-localization a owl:Class ;
    rdfs:label "Monte Carlo Localization"@en ;
    rdfs:comment "A probabilistic localization algorithm that represents the robot's belief about its position using a set of weighted particles (samples), where each particle represents a hypothesis of the robot's pose. It implements a particle filter to recursively estimate the robot's pose distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-measurements ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-model ],
        ngm:rb-1013-localization,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:localization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:motion-model,
        ngm:sensor-measurements ;
    vc:slug "monte-carlo-localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:importance-sampling,
        ngm:rb-1008-odometry,
        ngm:sensor-fusion .

ngm:move-it-2 a owl:Class ;
    rdfs:label "MoveIt 2"@en ;
    rdfs:comment "MoveIt 2 is the open-source motion-planning framework for ROS 2, providing manipulation capabilities including inverse kinematics, collision-aware path planning, trajectory generation, and execution for robotic arms and mobile manipulators. It integrates planners, perception, and control through a plugin architecture and is the de facto standard for arm motion planning in the ROS ecosystem. The ROS 2 version adds real-time and lifecycle improvements over the original MoveIt."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:robotics-platform ;
    vc:slug "move-it-2" ;
    vc:sourceDomain "robotics" .

ngm:multi-hop-reasoning a owl:Class ;
    rdfs:label "Multi-Hop Reasoning"@en ;
    rdfs:comment "Multi-hop reasoning is the capability to answer a question or draw a conclusion by chaining together several intermediate inferences or retrieved facts, rather than relying on a single piece of evidence. In language models and retrieval systems it requires composing information across multiple documents or knowledge-graph edges. It is central to complex question answering and is a known weak point for shallow retrieval and single-pass models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "multi-hop-reasoning" ;
    vc:sourceDomain "ai" .

ngm:multiformats a owl:Class ;
    rdfs:label "Multiformats"@en ;
    rdfs:comment "Multiformats is a collection of self-describing protocol and value specifications designed to make data formats future-proof and interoperable across decentralised systems. Rather than hard-coding a single hash, encoding, or address scheme, each multiformat prefixes the value with a compact code declaring which algorithm or format it uses, so software can interpret it unambiguously and evolve without breaking. Components include multihash, multibase, multicodec, and multiaddr, and the family underpins content addressing in IPFS and libp2p."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multihash ],
        ngm:content-addressing ;
    vc:enables ngm:content-addressing,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-identifier,
        ngm:multihash ;
    vc:implements ngm:content-identifier ;
    vc:isPartOf ngm:content-addressing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralised-file-storage,
        ngm:distributed-hash-table,
        ngm:interoperability ;
    vc:slug "multiformats" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:ipfs,
        ngm:libp2p ;
    vc:uses ngm:cryptography .

ngm:multimodal-ai-architecture-understanding a owl:Class ;
    rdfs:label "Multimodal Understanding"@en ;
    rdfs:comment "Multimodal Understanding is an AI research area concerned with systems that jointly process and reason over multiple sensory modalities — including text, images, audio, video, and structured data — producing unified semantic representations. It underpins vision-language models, audio-visual reasoning, and multi-sensor scene interpretation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-and-voice ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
