    rdfs:label "Digital Signature"@en ;
    rdfs:comment "A Digital Signature is a cryptographic mechanism using Public Key Infrastructure that authenticates the origin and integrity of digital data, where a private key creates a unique mathematical binding to a message that can be verified using the corresponding public key, ensuring Non-Repudiation."@en ;
    skos:prefLabel "Digital Signature"@en ;
