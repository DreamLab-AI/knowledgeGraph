ngm:accessibility-domain a owl:Class ;
    rdfs:label "Accessibility Domain"@en ;
    rdfs:comment "The Accessibility Domain classifies concepts concerned with making products, content, and services usable by people with the widest range of abilities, including those with disabilities. It covers perceivable, operable, and understandable design, assistive technology compatibility, and the standards that define conformance. As a top-level subject classification, it scopes inclusive access rather than general usability or interface aesthetics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inclusive-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:assistive-technology ],
        ngm:owl-thing ;
    vc:enables ngm:assistive-technology-support,
        ngm:inclusive-access,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accessible-content,
        ngm:assistive-technology,
        ngm:conformance-standard,
        ngm:inclusive-design,
        ngm:semantic-markup ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:design-guidelines,
        ngm:semantic-structure ;
    vc:slug "accessibility-domain" ;
    vc:sourceDomain "accessibility" .

