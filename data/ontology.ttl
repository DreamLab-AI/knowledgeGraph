ngm:data-format a owl:Class ;
    rdfs:label "Data Format"@en ;
    rdfs:comment "A Data Format is a formal structural and encoding specification that governs how raw bytes are organised, typed, and interpreted when data is stored, transmitted, or exchanged between computational systems. Formats encode decisions about byte ordering, field delimitation, schema evolution, compression, and type systems, ranging from binary serialisation protocols (Protocol Buffers, Apache Avro, MessagePack) to human-readable interchange formats (JSON, XML, YAML, TOML) and domain-specific schemas (DICOM for medical imaging, glTF for 3D assets, FITS for astronomical data). The choice of data format critically determines interoperability scope, parsing overhead, storage efficiency, schema evolution capability, and compatibility with downstream processing pipelines and analytics engines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-registry ],
        ngm:data-management ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:linked-data ;
    vc:dependsOn ngm:type-system ;
    vc:enables ngm:api-design,
        ngm:data-exchange,
        ngm:data-interoperability,
        ngm:data-pipeline ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:encoding,
        ngm:schema,
        ngm:serialisation ;
    vc:implements ngm:open-standard ;
    vc:isPartOf ngm:data-architecture,
        ngm:data-standards ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:apache-parquet,
        ngm:json-data-interchange-format-ld,
        ngm:protocol-buffer ;
    vc:requires ngm:codec,
        ngm:schema-registry ;
    vc:slug "data-format" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:iso,
        ngm:w3-c ;
    vc:uses ngm:data-compression,
        ngm:data-validation .

ngm:did-method a owl:Class ;
    rdfs:label "DID Method"@en ;
    rdfs:comment "A DID Method is a specification that defines how a particular type of Decentralised Identifier (DID) is created, resolved, updated, and deactivated, encoding the syntax rules and CRUD semantics for identifiers anchored to a specific verifiable data registry, ledger, or peer-to-peer network. Each method is identified by a unique method name embedded in the DID string (e.g. did:web, did:key, did:ion), and must provide a compliant DID Resolver that retrieves the corresponding DID Document containing public keys and service endpoints. DID Methods are standardised through the W3C DID Core specification and registered in the DIF DID Method Registry, enabling interoperable self-sovereign identity across heterogeneous systems. The diversity of methods reflects trade-offs between decentralisation guarantees, key management complexity, ledger dependency, and resolver performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:decentralized-identity ;
    vc:bridgesTo ngm:ipfs,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:oauth,
        ngm:x-509-certificate ;
    vc:enables ngm:decentralised-authentication,
        ngm:digital-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:did-resolution,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:did-resolver,
        ngm:digital-identity-wallet,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:decentralized-identifier,
        ngm:did-document,
        ngm:public-key-infrastructure,
        ngm:verifiable-data-registry ;
    vc:slug "did-method" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:decentralized-identity-foundation,
        ngm:w3-c ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-key-pair,
        ngm:distributed-ledger-technology .

ngm:embeddings a owl:Class ;
    rdfs:label "Embeddings"@en ;
    rdfs:comment "Embeddings are dense, low-dimensional vector representations of discrete objects—words, sentences, images, code, graphs, or arbitrary entities—learned by neural networks such that geometric relationships in the vector space correspond to semantic or functional relationships between the original objects. The core property is that semantically similar inputs map to nearby vectors, enabling tasks like similarity search, clustering, and retrieval to be performed as efficient geometric operations. Embeddings are the foundational representation layer of modern deep learning, underpinning language models, recommendation systems, search engines, and retrieval-augmented generation pipelines. They transform high-dimensional sparse inputs into compact continuous representations that downstream neural architectures—particularly attention-based transformers—can process and reason over."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-prompt-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:knowledge-graph-embedding ;
    vc:contrastsWith ngm:bag-of-words,
        ngm:one-hot-encoding ;
    vc:dependsOn ngm:backpropagation,
        ngm:loss-function ;
    vc:enables ngm:anomaly-detection,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-model,
        ngm:positional-encoding,
        ngm:soft-prompt-embedding,
        ngm:token-embedding ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cosine-similarity,
        ngm:knowledge-graph,
        ngm:multimodal-ai-architecture-learning,
        ngm:nearest-neighbor-search ;
    vc:requires ngm:neural-network,
        ngm:training-data ;
    vc:slug "embeddings" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:contrastive-learning,
        ngm:dimensionality-reduction,
        ngm:natural-language-processing,
        ngm:transformer .

ngm:gas-fee a owl:Class ;
    rdfs:label "Gas Fee"@en ;
    rdfs:comment "A gas fee is the payment a user must make to compensate the network validators or miners for the computational resources consumed when processing a transaction or executing a smart contract on a blockchain. On Ethereum-compatible networks, 'gas' is an abstract unit measuring the computational effort required by an operation; the fee is calculated as gas units consumed multiplied by a price per unit (the gas price), denominated in the network's native currency. Following EIP-1559 on Ethereum, gas fees split into a protocol-set base fee — which is burned, permanently removing supply — and an optional priority tip paid directly to the block proposer. Gas fees serve the dual purpose of economically compensating validators and acting as a spam-prevention mechanism by making resource-intensive computation costly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:native-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:transaction-fee ;
    vc:bridgesTo ngm:mechanism-design,
        ngm:microeconomics,
        ngm:tokenomics ;
    vc:contrastsWith ngm:feeless-blockchain,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:gas-limit,
        ngm:gas-price,
        ngm:network-congestion ;
    vc:enables ngm:block-production,
        ngm:spam-prevention,
        ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-1559 ;
    vc:isPartOf ngm:blockchain-network,
        ngm:ethereum ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:base-fee,
        ngm:miner-extractable-value,
        ngm:priority-fee ;
    vc:requires ngm:consensus-mechanism,
        ngm:native-token ;
    vc:slug "gas-fee" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:layer-2-scaling,
        ngm:non-fungible-token ;
    vc:uses ngm:mempool,
        ngm:smart-contract .

ngm:hash-time-locked-contract a owl:Class ;
    rdfs:label "Hash Time-Locked Contract"@en ;
    rdfs:comment "A Hash Time-Locked Contract (HTLC) is a type of smart contract that conditionally releases funds to a recipient only if they present a valid cryptographic preimage satisfying a specified hash condition within a defined time window; if the condition remains unmet before the timeout expires, the funds automatically revert to the sender. HTLCs combine two complementary mechanisms—a hashlock, which binds settlement to knowledge of a secret, and a timelock, which enforces a bounded settlement window—to achieve trustless atomicity across one or more blockchain ledgers. They are foundational to payment channel networks such as the Lightning Network and to cross-chain atomic swap protocols, enabling conditional payment routing without custodial intermediaries or mutual trust. As a composable on-chain primitive, HTLCs underpin a wide range of decentralised finance and interoperability constructs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:cryptography,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:custodial-exchange,
        ngm:point-time-locked-contract,
        ngm:trusted-third-party ;
    vc:dependsOn ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:enables ngm:atomic-swap,
        ngm:cross-chain-interoperability,
        ngm:lightning-network,
        ngm:micropayments,
        ngm:payment-channel,
        ngm:trustless-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:atomic-swap,
        ngm:conditional-payment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adaptor-signature,
        ngm:cross-chain-bridge,
        ngm:de-fi,
        ngm:payment-system,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:timelock ;
    vc:slug "hash-time-locked-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:public-key-cryptography,
        ngm:script,
        ngm:sha-256 .

ngm:iso-10218 a owl:Class ;
    rdfs:label "ISO 10218"@en ;
    rdfs:comment "ISO 10218 is a two-part international safety standard published by the International Organisation for Standardisation specifying mandatory requirements for the design, construction, and safeguarding of industrial robots and robotic systems. Part 1 (ISO 10218-1) governs the robot unit itself, requiring manufacturers to implement safety-rated monitored stop, speed and force limitation, workspace monitoring, and control-reliable safety stop circuits before market placement. Part 2 (ISO 10218-2) governs robot system integration into workcells, requiring formal risk assessments per ISO 12100, safety control architecture documentation per ISO 13849 performance levels, and comprehensive declarations of conformity by system integrators. Together the two parts form the normative safety foundation for industrial robotics globally and are the prerequisite for CE marking of robot workcells in European markets under the EU Machinery Directive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-integrity-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-10218-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:bridgesTo ngm:ai-safety,
        ngm:autonomous-system ;
    vc:dependsOn ngm:iso-12100,
        ngm:iso-13849 ;
    vc:enables ngm:ce-marking,
        ngm:collaborative-systems-modality-robot,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:iso-10218-1 ;
    vc:implements ngm:eu-machinery-directive ;
    vc:isPartOf ngm:safety-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ansi-ria-r15-06,
        ngm:human-robot-interaction,
        ngm:iec-62061,
        ngm:iso-ts-15066 ;
    vc:requires ngm:functional-safety,
        ngm:risk-assessment,
        ngm:safety-integrity-level ;
    vc:slug "iso-10218" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:collaborative-systems-modality-robot,
        ngm:industrial-automation,
        ngm:robot-safety .

ngm:kv-cache a owl:Class ;
    rdfs:label "KV Cache"@en ;
    rdfs:comment "A KV Cache (Key-Value Cache) in transformer-based language models is a memory structure that stores the computed key and value projection tensors from the multi-head self-attention mechanism for all previously processed tokens in a sequence, allowing autoregressive decoding to reuse these intermediate results rather than recomputing them at every generation step, thereby reducing the per-token computational cost from O(N²) to O(N) in generation. Each decoder layer maintains its own KV cache, which grows linearly with sequence length and model width, making memory bandwidth and GPU HBM capacity the primary constraints on inference throughput for long-context models. KV cache management strategies — including paged allocation (PagedAttention), prefix sharing, quantisation, and off-loading — are critical determinants of serving efficiency and cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:inference-engine ;
    vc:bridgesTo ngm:distributed-inference,
        ngm:virtual-memory-management ;
    vc:contrastsWith ngm:linear-attention,
        ngm:state-space-model ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:query-key-value,
        ngm:self-attention ;
    vc:enables ngm:autoregressive-decoding,
        ngm:inference,
        ngm:prompt-caching,
        ngm:speculative-decoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:paged-attention ;
    vc:isPartOf ngm:inference-engine,
        ngm:transformer-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:grouped-query-attention,
        ngm:large-language-models ;
    vc:requires ngm:gpu-memory,
        ngm:high-bandwidth-memory ;
    vc:slug "kv-cache" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:flash-attention,
        ngm:gpu-compute,
        ngm:hardware-acceleration,
        ngm:quantisation .

ngm:markov-chain-monte-carlo a owl:Class ;
    rdfs:label "Markov Chain Monte Carlo"@en ;
    rdfs:comment "Markov Chain Monte Carlo (MCMC) is a family of computational algorithms that generate samples from an arbitrary target probability distribution by constructing a Markov chain whose stationary distribution equals the target, enabling tractable approximate Bayesian inference and numerical integration over high-dimensional parameter spaces that are intractable by exact analytical methods. Foundational algorithms include Metropolis-Hastings, Gibbs sampling, Hamiltonian Monte Carlo (HMC), and the No-U-Turn Sampler (NUTS). MCMC is the standard tool for posterior inference in probabilistic programming and Bayesian statistical modelling across science, engineering, and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:detailed-balance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:monte-carlo-methods ;
    vc:bridgesTo ngm:computational-biology,
        ngm:statistical-physics ;
    vc:contrastsWith ngm:normalising-flows,
        ngm:sequential-monte-carlo,
        ngm:variational-inference ;
    vc:enables ngm:bayesian-inference,
        ngm:posterior-inference,
        ngm:probabilistic-programming,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:gibbs-sampling,
        ngm:metropolis-hastings,
        ngm:no-u-turn-sampler ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:gaussian-process,
        ngm:neural-network,
        ngm:probabilistic-model ;
    vc:requires ngm:detailed-balance,
        ngm:ergodicity,
        ngm:probability-theory ;
    vc:slug "markov-chain-monte-carlo" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gradient-descent,
        ngm:hamiltonian-dynamics,
        ngm:markov-chain,
        ngm:sampling .

ngm:model-compression a owl:Class ;
    rdfs:label "Model Compression"@en ;
    rdfs:comment "Model compression is the family of techniques that reduce the size, memory footprint, and computational cost of a machine learning model while preserving as much of its predictive accuracy as possible. Common methods include quantisation of weights to lower precision, pruning of redundant parameters, knowledge distillation into a smaller student model, and weight sharing. Compression is essential for deploying large neural networks on resource-constrained hardware and for reducing inference latency and energy use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pruning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:weight-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:model-optimization ;
    vc:dependsOn ngm:deep-learning ;
    vc:enables ngm:ai-inference,
        ngm:edge-computing,
        ngm:latency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:pruning,
        ngm:quantisation,
        ngm:weight-sharing ;
    vc:isPartOf ngm:model-deployment,
