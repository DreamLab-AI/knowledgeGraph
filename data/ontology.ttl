    vc:slug "kotlin" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:web-assembly ;
    vc:uses ngm:compiler,
        ngm:type-system .

ngm:kullback-leibler-divergence a owl:Class ;
    rdfs:label "Kullback-Leibler Divergence"@en ;
    rdfs:comment "The Kullback-Leibler (KL) divergence is a measure from information theory that quantifies how much one probability distribution differs from a second, reference distribution, expressed as the expected excess number of bits required to encode samples from the first using a code optimised for the second. It is non-negative, equal to zero only when the two distributions are identical, and is asymmetric, so it is a divergence rather than a true metric. KL divergence is central to machine learning, appearing in cross-entropy loss, variational inference, the evidence lower bound of variational autoencoders, and regularisation of policy updates in reinforcement learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        ngm:information-theory ;
    vc:enables ngm:model-training,
        ngm:variational-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:entropy ;
    vc:implements ngm:loss-function ;
    vc:isPartOf ngm:information-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:deep-learning,
        ngm:generative-model,
        ngm:gradient-descent,
        ngm:machine-learning ;
    vc:requires ngm:probability-distribution,
        ngm:statistics ;
    vc:slug "kullback-leibler-divergence" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:knowledge-distillation,
        ngm:reinforcement-learning,
        ngm:variational-autoencoder ;
    vc:uses ngm:probability-theory .

ngm:latent-variable-model a owl:Class ;
    rdfs:label "Latent Variable Model"@en ;
    rdfs:comment "A latent variable model is a statistical model that explains observed data in terms of unobserved (latent) variables, which capture hidden structure such as cluster membership, low-dimensional factors, or underlying states. By positing latent causes, these models compactly represent complex distributions and support tasks like density estimation, dimensionality reduction, and generation. Inference recovers distributions over the latent variables given the observations."@en ;
    rdfs:subClassOf ngm:probabilistic-model ;
    vc:contrastsWith ngm:principal-component-analysis ;
    vc:dependsOn ngm:probabilistic-model ;
    vc:enables ngm:generative-model,
        ngm:unsupervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:latent-space ;
    vc:implements ngm:dimensionality-reduction ;
    vc:isPartOf ngm:probabilistic-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dimensionality-reduction,
        ngm:graphical-model,
        ngm:representation-learning ;
    vc:slug "latent-variable-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:gaussian-mixture-model,
        ngm:variational-autoencoder ;
    vc:uses ngm:bayesian-inference,
        ngm:expectation-maximisation .

ngm:layer-1 a owl:Class ;
    rdfs:label "Layer 1"@en ;
    rdfs:comment "Layer 1 is the foundational base protocol of a blockchain network that maintains its own independently verified state, executes a native consensus mechanism, and provides cryptographically final transaction ordering without relying on any external chain. It defines the canonical ledger, enforces network rules (including token issuance schedules and validity criteria), and serves as the trust anchor from which all higher-order protocols derive their security guarantees. Notable examples include Bitcoin, Ethereum, Solana, Cardano, and Avalanche, each differing in their consensus approach, throughput characteristics, and programmability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:native-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:data-provenance,
        ngm:decentralised-finance,
        ngm:digital-identity ;
    vc:contrastsWith ngm:centralised-database,
        ngm:layer-2-networks,
        ngm:sidechain ;
    vc:enables ngm:decentralised-application,
        ngm:layer-2-networks,
        ngm:smart-contract,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block,
        ngm:distributed-ledger,
        ngm:mempool,
        ngm:native-token ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:finality,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:sharding ;
    vc:requires ngm:consensus-protocol,
        ngm:cryptographic-hash-function,
        ngm:peer-to-peer-network,
        ngm:validator-node ;
    vc:slug "layer-1" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:ethereum-improvement-proposal .

ngm:layer-1-blockchain a owl:Class ;
    rdfs:label "Layer 1 Blockchain"@en ;
    rdfs:comment "A Layer 1 Blockchain is a base-layer distributed ledger that provides its own consensus, settlement and security without relying on another chain. It defines the native protocol, block production rules and economic security that applications and higher layers build upon, and is where transactions achieve final settlement. Examples include Bitcoin, Ethereum, Avalanche and Cardano. Layer 1 design choices around consensus and data structures determine the throughput, decentralisation and security trade-offs that Layer 2 solutions later seek to extend."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain-network ;
    vc:bridgesTo ngm:avalanche,
        ngm:cardano ;
    vc:contrastsWith ngm:layer-2-scaling,
        ngm:layer-2-solutions ;
    vc:dependsOn ngm:scalability ;
    vc:enables ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:distributed-ledger ;
    vc:implements ngm:distributed-ledger ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:ethereum,
        ngm:sharding ;
    vc:requires ngm:consensus-mechanism ;
    vc:slug "layer-1-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:layer-2-solutions,
        ngm:smart-contract ;
    vc:uses ngm:proof-of-stake,
        ngm:proof-of-work .

ngm:layer-2-networks a owl:Class ;
    rdfs:label "Layer 2 Networks"@en ;
    rdfs:comment "Layer 2 Networks are secondary protocols constructed atop a base blockchain (Layer 1) that execute transactions off the main chain, batching or compressing them before posting commitments back to Layer 1 for final settlement and security. They address the fundamental scalability trilemma by separating execution from consensus, enabling higher throughput and lower fees without compromising the decentralisation or security guarantees of the underlying chain. Primary architectural families include optimistic rollups, zero-knowledge rollups, state channels, and sidechains, each making different trade-offs between latency, data availability, and trust assumptions. Settlement finality and fraud or validity proof mechanisms determine the trust model and the withdrawal period users must endure before funds are considered unconditionally settled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:layer-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:payment-infrastructure ;
    vc:contrastsWith ngm:layer-1,
        ngm:plasma,
        ngm:sharding ;
    vc:enables ngm:decentralised-finance,
        ngm:micropayments,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rollup,
        ngm:sidechain,
        ngm:state-channel ;
    vc:implements ngm:optimistic-rollup,
        ngm:zk-rollup ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-lightning-network,
        ngm:blockchain-interoperability,
        ngm:ethereum,
        ngm:sequencer ;
    vc:requires ngm:data-availability,
        ngm:layer-1,
        ngm:smart-contracts ;
    vc:slug "layer-2-networks" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proofs,
        ngm:fraud-proof,
        ngm:merkle-tree,
        ngm:zero-knowledge-proof .

ngm:layer-2-protocol a owl:Class ;
    rdfs:label "Layer-2 Protocol"@en ;
    rdfs:comment "A layer-2 protocol is a scaling construction built on top of an underlying layer-1 blockchain that executes transactions off the base chain while inheriting its security guarantees through periodic settlement. By batching, compressing, or channelling activity off-chain and committing only succinct proofs or state commitments to layer 1, these protocols dramatically increase throughput and reduce fees without changing the base consensus. Major families include rollups (optimistic and zero-knowledge), state channels, and sidechains, each trading off security, latency, and capital efficiency differently while bridging assets and messages back to the secured base layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rollup ],
        ngm:blockchain-scalability ;
    vc:bridgesTo ngm:ethereum,
        ngm:sidechain ;
    vc:contrastsWith ngm:layer-1-blockchain,
        ngm:sidechain ;
    vc:dependsOn ngm:data-availability,
        ngm:layer-1-blockchain ;
    vc:enables ngm:smart-contract,
        ngm:transaction-throughput ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rollup,
        ngm:state-channel ;
    vc:implements ngm:optimistic-rollup,
        ngm:zk-rollup ;
    vc:isPartOf ngm:blockchain-scalability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:arbitrum,
        ngm:lightning-network,
        ngm:optimism ;
    vc:slug "layer-2-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum .

ngm:learning-algorithm a owl:Class ;
    rdfs:label "Learning Algorithm"@en ;
    rdfs:comment "LearningAlgorithm is a computational procedure that enables a model or agent to improve task performance through exposure to data or environmental interaction, encompassing the full spectrum of paradigms — supervised learning unsupervised learning (discovering latent structure in unlabelled data ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-gradient-methods ],
        [ a owl:Restriction ;
