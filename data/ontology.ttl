] .

# Spatial Queries
spatial-computing:SpatialQueries rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DatabaseQuery ;
    rdfs:label "Spatial Queries"@en ;
    rdfs:comment "Database queries that select geographic features based on location or spatial relationships such as intersection, containment, proximity, and adjacency, implemented using R-tree spatial indexing and filter-refine strategies per OGC Simple Features and SQL/MM Spatial standards."@en ;
    skos:prefLabel "Spatial Queries"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:spatial-queries" ;
