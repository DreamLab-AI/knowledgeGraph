        ngm:digital-identity,
        ngm:gdpr,
        ngm:identity-proofing,
        ngm:regulatory-compliance ;
    vc:requires ngm:consent-management,
        ngm:identity-document-verification ;
    vc:slug "age-verification" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-29115,
        ngm:w3c-verifiable-credentials ;
    vc:supports ngm:data-minimisation,
        ngm:online-safety-act-2023,
