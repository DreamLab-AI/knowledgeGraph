        ngm:sybil-attack ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:public-key-cryptography ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:decentralised-governance,
        ngm:fair-airdrop,
        ngm:quadratic-voting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:humanity-attestation,
        ngm:proof-of-personhood,
        ngm:reputation-system,
        ngm:verifiable-credential,
        ngm:web-of-trust ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-proof,
        ngm:identity-verification ;
    vc:slug "sybil-resistance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:biometric-authentication,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:trust-graph,
        ngm:zero-knowledge-proof .

ngm:telecollaboration a owl:Class ;
