ngm:zero-trust-architecture a owl:Class ;
    rdfs:label "Zero Trust Architecture"@en ;
    rdfs:comment "Zero Trust Architecture (ZTA) is a cybersecurity paradigm that abandons the notion of a trusted network perimeter and instead requires explicit, continuous verification of every principal — user, device, or service — for every request regardless of network origin. Grounded in least-privilege access, ZTA evaluates contextual signals including identity assertions, device health posture, behavioural risk, and data sensitivity at each access decision point, enforced by a Policy Decision Point and Policy Enforcement Point pair operating across micro-segmented environments. Formalised in NIST SP 800-207, ZTA has become the dominant enterprise security reference model in response to the dissolution of traditional perimeter boundaries by cloud-native, remote-work, and supply-chain threat vectors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-factor-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:ai-driven-threat-detection,
        ngm:federated-identity ;
    vc:contrastsWith ngm:perimeter-security,
        ngm:virtual-private-network ;
    vc:enables ngm:continuous-monitoring,
        ngm:just-in-time-access,
        ngm:least-privilege-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:secure-access-service-edge,
        ngm:software-defined-perimeter ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:endpoint-detection-and-response,
        ngm:security-information-and-event-management,
        ngm:supply-chain-security ;
    vc:requires ngm:authentication,
        ngm:device-attestation,
        ngm:identity-and-access-management,
        ngm:multi-factor-authentication ;
    vc:slug "zero-trust-architecture" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-sp-800-207 ;
    vc:supports ngm:cloud-security,
        ngm:privileged-access-management ;
    vc:uses ngm:access-control,
        ngm:behavioural-analytics,
        ngm:micro-segmentation,
        ngm:mutual-tls,
        ngm:policy-engine .

ngm:certificate-authority a owl:Class ;
    rdfs:label "Certificate Authority"@en ;
    rdfs:comment "A Certificate Authority (CA) is a trusted third-party organisation that issues, signs, and manages the lifecycle of X.509 digital certificates, cryptographically binding a public key to an entity's verified identity within a Public Key Infrastructure (PKI). CAs operate within a hierarchical trust model where offline root CAs delegate signing authority to online intermediate CAs, which in turn issue end-entity certificates for servers, users, clients, and devices. The CA's signing operations — governed by RFC 5280, the CA/Browser Forum Baseline Requirements, and WebTrust auditing standards — underpin the TLS handshake, code-signing pipelines, S/MIME email encryption, mutual TLS (mTLS) in service meshes, and document-signing workflows across the internet. Trust propagates via chain-of-trust verification: a relying party validates each certificate against its issuer's signature, tracing back to an implicitly trusted root embedded in OS or browser trust stores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:verifiable-credential,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:decentralised-identity,
        ngm:self-sovereign-identity,
        ngm:web-of-trust ;
    vc:enables ngm:code-signing,
        ngm:digital-certificate,
        ngm:encryption,
        ngm:transport-layer-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:certificate-revocation-list,
        ngm:intermediate-certificate-authority,
        ngm:online-certificate-status-protocol,
        ngm:root-certificate ;
    vc:isPartOf ngm:public-key-infrastructure,
        ngm:trust-hierarchy ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:acme-protocol,
        ngm:certificate-transparency,
        ngm:domain-validation,
        ngm:key-management ;
    vc:requires ngm:asymmetric-key-cryptography,
        ngm:cryptography,
        ngm:digital-signature,
        ngm:hardware-security-module ;
    vc:slug "certificate-authority" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ca-browser-forum,
        ngm:rfc-5280,
        ngm:webtrust ;
    vc:supports ngm:authentication,
        ngm:identity-management,
        ngm:mutual-tls,
        ngm:zero-trust-security .

