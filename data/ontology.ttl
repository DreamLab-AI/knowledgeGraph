    vc:relatedTo ngm:cloud-native-applications,
        ngm:microservices-architecture,
        ngm:software-development-process,
        ngm:virtual-machine ;
    vc:slug "devpod" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:version-control .

