ngm:autonomous-governance a owl:Class ;
    rdfs:comment "Autonomous governance is a model in which decision-making and rule enforcement are executed by code and protocol rather than by a central administrator, typically via smart contracts and on-chain voting. It enables decentralised organisations such as DAOs to allocate resources, upgrade parameters, and resolve disputes through transparent, programmatically binding processes. The approach trades human discretion for verifiable, tamper-resistant execution of collectively agreed rules."@en ;
    rdfs:label "Autonomous Governance"@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
