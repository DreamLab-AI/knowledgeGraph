    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:assistive-technology-integration,
        ngm:inclusive-xr-design,
        ngm:universal-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:best-practice,
        ngm:implementation-examples ;
    vc:isPartOf ngm:accessibility-standard ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:accessibility-audit-tool,
        ngm:user-research ;
    vc:slug "xr-accessibility-guideline" ;
    vc:sourceDomain "spatial-computing" .

ngm:yaml a skos:Concept ;
    rdfs:label "Yaml"@en .

ngm:z-wave a owl:Class ;
    rdfs:label "Z Wave"@en ;
    rdfs:comment "Z-Wave is a low-power wireless communication protocol designed specifically for home automation and smart home devices, operating in the sub-GHz frequency band (868 MHz in Europe, 908 MHz in North America). It uses a mesh networking topology where each device can relay signals, extending range and improving reliability throughout a building. Z-Wave supports up to 232 nodes per network and is governed by the Z-Wave Alliance, which maintains interoperability standards across manufacturers."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:bluetooth-low-energy,
        ngm:thread-protocol,
        ngm:wifi,
        ngm:zigbee ;
    vc:enables ngm:home-automation,
        ngm:iot-device,
        ngm:smart-home ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:mesh-networking,
        ngm:wireless-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:industrial-io-t,
        ngm:interoperability,
        ngm:lpwan ;
    vc:slug "z-wave" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:uses ngm:aes,
        ngm:encryption .

ngm:3-d-li-dar a owl:Class ;
    rdfs:label "3D LiDAR"@en ;
    rdfs:comment "3D LiDAR is a active ranging sensor that emits pulsed laser light across multiple vertical channels to capture dense three-dimensional point clouds of the surrounding environment. Spinning or solid-state variants measure range and intensity for hundreds of thousands of points per second, enabling robots and autonomous vehicles to perform obstacle detection, SLAM, and high-fidelity scene reconstruction in real time."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:simultaneous-localisation-and-mapping,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:2-d-li-dar,
        ngm:lidar-scanning,
        ngm:multirotor-uav,
        ngm:stereo-camera ;
    vc:slug "3-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:perception-system,
        ngm:sensor-fusion .

ngm:3-d-perception a owl:Class ;
    rdfs:label "3D Perception"@en ;
    rdfs:comment "3D Perception is the computational capability to interpret sensor data — from cameras, LiDAR, radar, and depth sensors — and derive accurate three-dimensional understanding of the surrounding environment, including object detection, pose estimation, scene structure, and semantic labelling. It forms a foundational layer for autonomous systems, robotic manipulation, augmented reality registration, and spatial computing. The discipline draws on computer vision, geometry, and deep learning to transform raw observations into actionable 3D representations."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:6-do-f-tracking,
        ngm:object-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:slug "3-d-perception" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:point-cloud,
        ngm:sensor-fusion .

ngm:5-g-connectivity a owl:Class ;
    rdfs:label "5G Connectivity"@en ;
    rdfs:comment "5G Connectivity is the set of radio access and core network capabilities delivered by a 5G NR network that provides devices and applications with wireless communication services characterised by high throughput, ultra-low latency, and high device density. It encompasses the radio link between user equipment and the gNB base station, quality-of-service mechanisms, network slicing for application-specific service guarantees, and the APIs through which applications access network capabilities. 5G Connectivity is a critical enabler for cloud XR, autonomous systems, and real-time industrial applications."@en ;
    rdfs:subClassOf ngm:5-g ;
    vc:enables ngm:io-t-infrastructure,
        ngm:low-latency,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-gpp,
        ngm:guaranteed-bandwidth,
        ngm:latency ;
    vc:slug "5-g-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization .

ngm:MaturityLevel a owl:Class ;
    rdfs:label "Maturity Level"@en .

ngm:aaai a owl:Class ;
    rdfs:label "AAAI"@en ;
    rdfs:comment "AAAI (the Association for the Advancement of Artificial Intelligence), founded in 1979 under the original name 'American Association for Artificial Intelligence' and renamed in 2007, is the principal non-profit scientific society devoted to advancing research in and responsible use of artificial intelligence. It is best known for its flagship annual peer-reviewed conference — one of the most selective and broadly scoped venues in AI — alongside the AI, Ethics and Society (AIES) conference, symposia, workshops, and the journal AI Magazine. AAAI also engages in education, public communication, and policy discussion concerning AI; administers the AAAI Fellows Program recognising sustained contributions to the discipline; and maintains historical continuity as the first professional society dedicated exclusively to AI, founded by leaders including Allen Newell, Edward Feigenbaum, Marvin Minsky, and John McCarthy. AAAI 2026 — the 40th annual conference — received 23,680 submissions and accepted 4,167 papers at a 17.6% acceptance rate, making it the most competitive edition in the conference's history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-review ],
        ngm:academic-conference,
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:ai-governance,
        ngm:artificial-intelligence ;
    vc:contrastsWith ngm:cvpr,
        ngm:iclr,
        ngm:icml,
        ngm:ijcai,
        ngm:neur-ips ;
    vc:enables ngm:ai-for-social-good,
        ngm:ai-research,
        ngm:benchmark-standard,
        ngm:research-dissemination ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:aaai-conference,
        ngm:aaai-fellows-program,
        ngm:ai-magazine,
        ngm:peer-review,
        ngm:poster-session,
        ngm:programme-committee,
        ngm:tutorial,
        ngm:workshop ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:academic-conference,
        ngm:knowledge-representation,
        ngm:multi-agent-system,
        ngm:research-institution,
        ngm:scientific-conference,
        ngm:symbolic-ai ;
    vc:slug "aaai" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:double-blind-review,
        ngm:peer-review ;
    vc:supports ngm:ai-ethics,
        ngm:ai-policy,
        ngm:artificial-intelligence,
        ngm:machine-learning,
        ngm:open-science,
        ngm:responsible-ai .

ngm:access-token a owl:Class ;
    rdfs:label "Access Token"@en ;
    rdfs:comment "An access token is a credential that a client presents to a resource server to access protected resources within a granted scope and lifetime. Typically short-lived and often a bearer token, it carries or references the authorisation decision so the resource server need not re-check with the authorisation server on every request. Access tokens are the workhorse credential of OAuth 2.0 and API authorisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:oauth-2-0 ;
    vc:bridgesTo ngm:identity-provider ;
    vc:contrastsWith ngm:refresh-token ;
    vc:dependsOn ngm:oauth ;
    vc:enables ngm:api ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:token ;
    vc:implements ngm:authorization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authorization,
        ngm:oauth,
        ngm:session-management,
        ngm:token ;
    vc:requires ngm:authentication ;
    vc:slug "access-token" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:bearer-token,
        ngm:oauth-2-0 .

ngm:accountability-framework a owl:Class ;
    rdfs:label "Accountability Framework"@en ;
    rdfs:comment "An accountability framework is a structured set of principles, roles, processes, and controls that together define how responsibility for outcomes is assigned, tracked, and enforced within an organisation or system. It specifies who is answerable for decisions and actions, what evidence of responsible conduct must be maintained, and what redress or corrective measures apply when obligations are unmet. Accountability frameworks appear across governance, AI ethics, financial regulation, and public sector administration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        ngm:governance-framework ;
    vc:enables ngm:accountability-mechanism,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:regulatory-framework ;
    vc:requires ngm:audit,
        ngm:transparency ;
    vc:slug "accountability-framework" ;
    vc:sourceDomain "governance" .

ngm:address a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "A blockchain Address is a compact, human-transmissible identifier derived from a public key via cryptographic hashing (typically SHA-256 followed by RIPEMD-160 for Bitcoin, or Keccak-256 for Ethereum), which designates the recipient or controller of blockchain funds or smart-contract state. Addresses function as pseudonymous identifiers: they reveal nothing about the owner's real identity while allowing cryptographic proof of ownership through digital signature with the corresponding private key. They are encoded in formats such as Base58Check (Bitcoin legacy), Bech32 (Bitcoin native SegWit), or hexadecimal with EIP-55 checksum (Ethereum)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-transaction,
        ngm:digital-identity,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:account-model,
        ngm:digital-wallet,
        ngm:hash-function,
        ngm:secp256k1,
        ngm:utxo-model ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography ;
    vc:slug "address" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature,
        ngm:private-key,
        ngm:public-key .

ngm:advanced-manufacturing a owl:Class ;
    rdfs:label "Advanced Manufacturing"@en ;
    rdfs:comment "Advanced manufacturing is the application of innovative technologies—including automation, robotics, additive manufacturing, digital twins, and data-driven process control—to improve the productivity, flexibility, and quality of producing goods. It integrates cyber-physical systems across the production lifecycle, blurring the boundary between digital design and physical fabrication. Advanced manufacturing is a central pillar of Industry 4.0 and modern industrial strategy."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:supply-chain ;
    vc:enables ngm:additive-manufacturing,
        ngm:economic-development,
        ngm:precision-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:industry-4-0 ;
    vc:isPartOf ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:io-t ;
    vc:slug "advanced-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:logistics,
        ngm:supply-chain,
        ngm:uk-industrial-strategy ;
    vc:uses ngm:automation,
        ngm:digital-twin,
        ngm:industrial-automation .

ngm:advertising-and-marketing a owl:Class ;
    rdfs:label "Advertising and Marketing"@en ;
    rdfs:comment "Advertising and marketing is the combined domain of commercial practices concerned with identifying customer needs, developing products and services to meet them, communicating value propositions to target audiences through paid and unpaid channels, and building lasting brand relationships. Marketing encompasses the strategic disciplines of market research, product development, pricing, distribution, and communications, while advertising is the paid communications subset of the marketing mix. Together they constitute the primary commercial mechanism by which organisations acquire customers and generate revenue in market economies."@en ;
    rdfs:subClassOf ngm:digital-marketing ;
    vc:enables ngm:advertising,
        ngm:programmatic-advertising ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:customer-experience,
        ngm:data-privacy ;
    vc:slug "advertising-and-marketing" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:behavioral-analytics,
        ngm:predictive-analytics,
        ngm:recommendation-engine .

ngm:agent-based-models a owl:Class ;
    rdfs:label "Agent-Based Models"@en ;
    rdfs:comment "Agent-Based Models (ABMs) are computational simulation frameworks that represent systems as collections of autonomous, heterogeneous agents that interact with one another and their environment according to local rules, allowing complex global behaviours and emergent phenomena to arise from the bottom up without being explicitly programmed at the system level. They are a primary tool in complexity science for studying social, biological, economic, and technical systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environment-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scientific-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-loop ],
        ngm:computational-intelligence,
        ngm:simulation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:large-language-models,
        ngm:multi-agent-reinforcement-learning ;
    vc:contrastsWith ngm:equation-based-modelling,
        ngm:system-dynamics ;
    vc:dependsOn ngm:behavioural-modelling,
        ngm:complex-adaptive-systems,
        ngm:network-science ;
    vc:enables ngm:collective-intelligence,
