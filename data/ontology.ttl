    vc:sourceDomain "supply-chain" ;
    vc:uses ngm:blockchain,
        ngm:computer-vision,
        ngm:iot-sensor .

ngm:rfc-5280 a owl:Class ;
    rdfs:label "RFC 5280"@en ;
    rdfs:comment "RFC 5280 is the IETF standard that defines the Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) profile. It specifies the structure, encoding, and processing rules for X.509 v3 certificates and v2 CRLs, including the required and optional extensions and the certification path validation algorithm. The document is the normative reference that governs how PKI implementations issue, encode, and validate certificates on the public Internet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:technical-standard ;
    vc:contrastsWith ngm:ocsp ;
    vc:enables ngm:digital-certificate,
        ngm:trust-anchor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:certificate-revocation-list,
        ngm:x-509-certificate ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:certificate-transparency,
        ngm:interoperability-standard,
        ngm:revocation-registry ;
    vc:requires ngm:certificate-authority ;
    vc:slug "rfc-5280" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:internet-engineering-task-force ;
    vc:supports ngm:certificate-authority,
        ngm:cryptographic-infrastructure ;
    vc:uses ngm:digital-signature,
        ngm:public-key-cryptography .

ngm:right-to-be-forgotten a owl:Class ;
    rdfs:label "Right to Be Forgotten"@en ;
    rdfs:comment "A privacy right framework enabling individuals to request deletion or removal of personal data from online platforms and databases, with verification and audit mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
