    vc:slug "bsi-germany" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:cybersecurity-standard ;
    vc:supports ngm:data-protection .

ngm:bullet-physics a owl:Class ;
    rdfs:label "Bullet Physics"@en ;
    rdfs:comment "Bullet Physics is an open-source, real-time physics simulation library that provides collision detection, rigid body dynamics, and soft body simulation for use in games, robotics, visual effects, and scientific computing. Originally developed by Erwin Coumans, it implements discrete and continuous collision detection alongside a constraint solver, enabling physically plausible interactions between complex 3D geometries at interactive frame rates."@en ;
    rdfs:subClassOf ngm:physics-engine ;
    vc:enables ngm:fluid-simulation,
        ngm:rigid-body-dynamics,
        ngm:soft-body-dynamics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:game-development,
        ngm:game-engine ;
    vc:slug "bullet-physics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:collision-detection,
        ngm:constraint-solver .

ngm:byzantine-agreement a owl:Class ;
    rdfs:label "Byzantine Agreement"@en ;
    rdfs:comment "Byzantine Agreement is a class of distributed consensus protocols that guarantee correct operation even when a subset of participating nodes behave arbitrarily — sending conflicting, malicious, or unpredictable messages. Originating from the Byzantine Generals Problem formalised by Lamport, Shostak, and Pease in 1982, these protocols ensure that all honest nodes reach the same decision provided the number of faulty nodes does not exceed one-third of the total. Byzantine Agreement is foundational to blockchain consensus mechanisms and safety-critical distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-round ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:crash-fault-tolerance ;
    vc:dependsOn ngm:cryptographic-hash ;
    vc:enables ngm:blockchain-data,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:voting-round ;
    vc:implements ngm:consensus-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:slug "byzantine-agreement" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:distributed-computing-research ;
    vc:uses ngm:cryptographic-signature,
        ngm:peer-to-peer-network .

ngm:ca-browser-forum a owl:Class ;
    rdfs:label "Ca Browser Forum"@en ;
    rdfs:comment "The CA/Browser Forum (CA/B Forum) is a voluntary industry consortium of Certification Authorities (CAs), web browser vendors, and other relying parties that collaboratively develops and enforces minimum standards for the issuance and management of X.509 digital certificates used in TLS/HTTPS, code signing, and S/MIME email. Its Baseline Requirements documents define mandatory technical and procedural controls that CAs must meet to remain trusted by member browsers such as Chrome, Firefox, Safari, and Edge. Compliance is a prerequisite for inclusion in browser root stores, giving the Forum significant de facto regulatory power over internet PKI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:security ;
    vc:contrastsWith ngm:ietf,
        ngm:w3c ;
    vc:enables ngm:code-signing,
        ngm:https,
        ngm:web-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:certificate-transparency,
        ngm:extended-validation,
        ngm:root-store,
        ngm:x509 ;
    vc:requires ngm:audit-compliance,
        ngm:cryptography ;
    vc:slug "ca-browser-forum" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:certificate-authority,
        ngm:standards ;
    vc:supports ngm:digital-identity,
        ngm:internet-security ;
    vc:uses ngm:public-key-infrastructure .

ngm:cable-drive a owl:Class ;
    rdfs:label "Cable Drive"@en ;
    rdfs:comment "A cable drive (cable-driven transmission) is a mechanical actuation mechanism that transmits force and motion through tensioned cables, tendons, or belts routed over pulleys, rather than through rigid gear trains. It allows actuators to be located remotely from the joint they drive, reducing distal mass and inertia in robotic limbs and surgical instruments. Cable drives matter in robotics because they enable lightweight, compliant, backdrivable joints with low backlash."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "cable-drive" ;
    vc:sourceDomain "robotics" .

ngm:calculation-parameters a owl:Class ;
    rdfs:label "Calculation Parameters"@en ;
    rdfs:comment "Configurable variables and settings that control the behavior, accuracy, and performance of computational simulations and models, including solver options, convergence criteria, time steps, and optimization constraints that fine-tune simulation outputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-rules ],
        [ a owl:Restriction ;
