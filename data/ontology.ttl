        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:industrial-automation,
        ngm:robotic-process-automation,
        ngm:test-automation,
        ngm:workflow-automation ;
    vc:qualityScore "0.75"^^xsd:float ;
