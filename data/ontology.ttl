ngm:distributed-key-generation a owl:Class ;
    rdfs:label "Distributed Key Generation"@en ;
    rdfs:comment "Distributed Key Generation (DKG) is a cryptographic protocol in which a group of mutually distrusting participants collaboratively compute a shared public key together with secret key shares, without any single party ever learning or holding the complete private key. Each participant contributes randomness so that the final key material is the joint product of all honest parties, providing resilience against compromise of individual nodes. DKG underpins threshold signatures and secure multi-party computation, removing the single point of failure inherent in a centrally generated key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secret-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-party-computation ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:blockchain ;
    vc:enables ngm:multi-signature-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:key-management,
        ngm:private-key ;
    vc:implements ngm:threshold-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hardware-security-module,
        ngm:self-custody ;
    vc:requires ngm:cryptographic-protocol,
        ngm:multi-party-computation,
        ngm:secret-sharing ;
    vc:slug "distributed-key-generation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:multi-sig-governance,
        ngm:threshold-cryptography,
        ngm:threshold-signature-scheme ;
    vc:uses ngm:secret-sharing .

ngm:distributed-team-collaboration a owl:Class ;
    rdfs:label "Distributed Team Collaboration"@en ;
    rdfs:comment "Distributed team collaboration encompasses the practices, tools, and organisational patterns that enable geographically dispersed individuals working across multiple time zones to coordinate effectively on shared goals without co-location. It integrates asynchronous communication protocols, synchronous video conferencing, shared digital workspaces, version-controlled artefacts, and social norms around documentation and decision-making transparency to replicate — and often surpass — the coordination bandwidth of co-located teams. The discipline has grown from a niche practice of open-source communities and multinational corporations into a mainstream organisational capability following the global shift to remote work accelerated by the 2020 pandemic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-building ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:spatial-computing ;
    vc:enables ngm:hybrid-work,
        ngm:synchronous-collaboration,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:virtual-team ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-collaboration,
        ngm:knowledge-management,
        ngm:open-source-development,
        ngm:remote-collaboration,
        ngm:remote-work ;
    vc:requires ngm:communication-infrastructure,
        ngm:documentation-culture,
        ngm:trust-building ;
    vc:slug "distributed-team-collaboration" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:agile-software-development,
        ngm:organisational-resilience ;
    vc:uses ngm:asynchronous-communication,
        ngm:collaboration-platform,
        ngm:project-management-software,
        ngm:realtime-communication,
        ngm:version-control,
        ngm:video-conferencing .

ngm:domain-randomisation a owl:Class ;
    rdfs:label "Domain Randomisation"@en ;
    rdfs:comment "Domain randomisation is a technique for training robot and agent policies in simulation by randomising the parameters of the simulated environment, such as textures, lighting, dynamics, masses and sensor noise, so that the real world appears as just another variation. By forcing a policy to be robust across a wide distribution of simulated conditions, the approach narrows the reality gap and improves zero-shot or few-shot transfer of policies trained purely in simulation to physical hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:system-identification ;
    vc:enables ngm:deep-reinforcement-learning,
        ngm:domain-adaptation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-actuation-and-control ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:machine-learning,
        ngm:uncertainty-quantification ;
    vc:requires ngm:reinforcement-learning ;
    vc:slug "domain-randomisation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:perception,
        ngm:robotics ;
    vc:uses ngm:physics-simulation,
        ngm:procedural-generation,
        ngm:robot-simulation,
        ngm:simulation .

ngm:eclipse-attack a owl:Class ;
    rdfs:label "Eclipse Attack"@en ;
    rdfs:comment "An Eclipse Attack is a peer-to-peer network attack in which an adversary monopolises all of a target node's inbound and outbound connections, isolating it from the honest network. The eclipsed node is fed a fabricated view of the blockchain, enabling the attacker to double-spend against that node, delay its transaction confirmations, or waste its mining resources on a private fork. Countermeasures include connection diversity, random peer selection, and detecting network-level routing anomalies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-attack ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:infrastructure,
        ngm:security ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:distributed-hash-table,
        ngm:network-synchronization ;
    vc:dependsOn ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:enables ngm:double-spending,
        ngm:selfish-mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain,
        ngm:network-security ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-protocol,
        ngm:consensus-mechanism,
        ngm:denial-of-service,
        ngm:routing-attack ;
    vc:requires ngm:network-routing,
        ngm:peer-discovery,
        ngm:sybil-attack ;
    vc:slug "eclipse-attack" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:network-topology .

ngm:edge-gateway a owl:Class ;
    rdfs:label "Edge Gateway"@en ;
    rdfs:comment "An edge gateway is a network device or software component deployed at the boundary between a local edge environment and wider network infrastructure—such as the internet or a cloud backend—that performs protocol translation, security enforcement, traffic routing, and local data preprocessing before forwarding selected data to upstream systems. Edge gateways aggregate data from IoT devices, sensors, and local compute nodes, filter and normalise it, enforce access control policies, and reduce bandwidth consumption by processing and compressing data at the point of collection rather than transmitting raw streams to the cloud. They are essential components of edge computing architectures in industrial IoT, smart cities, autonomous systems, and distributed XR infrastructure."@en ;
    rdfs:subClassOf ngm:edge-computing-node ;
    vc:enables ngm:edge-orchestration,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:edge-computing-architecture,
        ngm:edge-network ;
    vc:slug "edge-gateway" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-gateway,
        ngm:edge-computing,
        ngm:network-protocol,
        ngm:network-security .

ngm:electric-motor a owl:Class ;
    rdfs:label "Electric Motor"@en ;
    rdfs:comment "Electric motor converts electrical energy into rotational mechanical power through electromagnetic forces, forming the most widespread actuation technology in modern robotics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
