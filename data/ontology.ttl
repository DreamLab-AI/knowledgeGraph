ngm:algorithm-layer a owl:Class ;
    rdfs:label "Algorithm Layer"@en ;
    rdfs:comment "The Algorithm Layer is the architectural stratum that defines the computational methods, procedures, and decision logic operating above the data and protocol layers. It encompasses the design, selection, and composition of algorithms — sorting, search, optimisation, consensus, cryptographic, and learning algorithms — that transform inputs into outputs under defined correctness and complexity guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
