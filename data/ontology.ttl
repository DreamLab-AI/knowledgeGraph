        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:collision-free-motion,
        ngm:safe-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:proximity-sensor,
        ngm:real-time-processing ;
    vc:slug "obstacle-avoidance" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:lidar,
        ngm:radar,
        ngm:ultrasonic-sensor .

ngm:open-source-software a owl:Class ;
    rdfs:label "Open Source Software"@en ;
    rdfs:comment "Open Source Software is software whose source code is made publicly available under a licence that permits inspection, modification, and redistribution. In the AI and metaverse infrastructure ecosystem, open-source projects provide the foundational frameworks — including deep learning libraries, rendering engines, and interoperability toolkits — that accelerate innovation, reduce vendor lock-in, and enable community-driven governance. Licences such as MIT, Apache 2.0, and GPL govern the permissibility of commercial reuse and derivative works."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:collaboration,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:open-source-framework,
        ngm:software-library ;
    vc:slug "open-source-software" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:license,
        ngm:version-control .

ngm:operating-system a owl:Class ;
    rdfs:label "Operating System"@en ;
    rdfs:comment "An Operating System (OS) is the foundational software layer that manages hardware resources — CPU scheduling, memory allocation, file systems, device drivers, and process isolation — and provides a stable interface for application software. In spatial computing and XR contexts, OS-level capabilities such as real-time scheduling, GPU access, and sensor integration are critical; specialised spatial OSes must coordinate head-tracking, display refresh, and input fusion at sub-millisecond latencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resource-management ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:edge-computing,
        ngm:embedded-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:resource-management,
        ngm:virtual-machine ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:hardware ;
    vc:slug "operating-system" ;
    vc:sourceDomain "infrastructure" .

ngm:optimization-algorithm a owl:Class ;
    rdfs:label "Optimization Algorithm"@en ;
    rdfs:comment "A procedure that iteratively adjusts model parameters to minimise or maximise an objective function. In machine learning, optimisation algorithms govern the training dynamics of neural networks by computing gradient-based parameter updates; prominent instances include stochastic gradient descent, Adam, and their adaptive variants, each balancing convergence speed, memory cost, and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adam-optimiser ],
        ngm:ai-technique,
        ngm:algorithm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:machine-learning-model,
        ngm:neural-network-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adam-optimiser,
        ngm:gradient-descent,
        ngm:learning-rate-schedule,
        ngm:stochastic-gradient-descent ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:hyperparameter ;
    vc:requires ngm:backpropagation,
        ngm:loss-function ;
    vc:slug "optimization-algorithm" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:overfitting a owl:Class ;
    rdfs:label "Overfitting"@en ;
    rdfs:comment "Overfitting is a phenomenon in machine learning where a model learns the training data too precisely—including noise and spurious correlations—resulting in poor generalisation to unseen data. It corresponds to high variance and low bias in the bias-variance tradeoff, and is mitigated through regularisation, dropout, early stopping, and data augmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:underfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:dropout,
        ngm:model-capacity ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "overfitting" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:private-key a owl:Class ;
    rdfs:label "Private Key"@en ;
    rdfs:comment "A Private Key is a secret scalar value generated through cryptographically secure randomness that serves as the sole proof of ownership within asymmetric cryptographic systems. In blockchain contexts it authorises transaction signing via digital signatures, controls access to associated public addresses and funds, and underpins the non-custodial security model where loss or exposure is irreversible."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-signature,
        ngm:digital-certificate ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-key-management,
        ngm:cryptographic-keys,
        ngm:cryptographic-protocol,
        ngm:preimage-resistance ;
    vc:slug "private-key" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography .

ngm:rb-0021-robot-kinematics a owl:Class ;
    rdfs:label "rb 0021 robot kinematics"@en ;
    rdfs:comment "Robot kinematics is the study of the geometry and motion of robot mechanisms — particularly manipulator arms — without regard to the forces or torques that cause motion. It encompasses forward kinematics (computing end-effector pose from joint configurations), inverse kinematics (computing joint configurations for a desired end-effector pose), Jacobian analysis relating joint velocities to Cartesian velocities, and singularity analysis. Kinematic models are foundational inputs to motion planning, trajectory generation, and control law design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity ;
    vc:slug "rb-0021-robot-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:robot-operating-system a owl:Class ;
    rdfs:label "Robot Operating System"@en ;
    rdfs:comment "The Robot Operating System (ROS / ROS 2) is an open-source middleware framework providing a structured communication layer, tool ecosystem, and package repository for robotic software development, enabling modular composition of perception, planning, and actuation subsystems through a publish-sub..."@en ;
    rdfs:subClassOf ngm:publish-subscribe-framework,
        ngm:robo-actuation-and-control,
        ngm:robotic-middleware ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-navigation,
        ngm:hardware-abstraction,
        ngm:motion-planning,
        ngm:robot-simulation,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:colcon-build-system,
        ngm:ros-action,
        ngm:ros-node,
        ngm:ros-package,
        ngm:ros-service,
        ngm:ros-topic,
        ngm:urdf-robot-model ;
    vc:implements ngm:dds-rtps-protocol,
        ngm:rep-standards,
        ngm:sros2-security ;
    vc:isPartOf ngm:autonomous-systems-platform,
        ngm:robotic-software-stack ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:cmake-build-system,
        ngm:data-distribution-service,
        ngm:python-3 ;
    vc:slug "robot-operating-system" ;
    vc:sourceDomain "robotics" .

ngm:robot-safety a owl:Class ;
    rdfs:label "Robot Safety"@en ;
    rdfs:comment "Robot Safety encompasses the engineering principles, risk assessment methods, and regulatory standards that ensure robotic systems operate without causing harm to humans, other machines, or the environment. It includes functional safety standards (ISO 10218, ISO 13849), collaborative robot (cobot) application requirements, dynamic risk assessment, and the emerging challenges of AI-integrated and autonomous robot deployment in shared workspaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
