ngm:coordination-layer a owl:Class ;
    rdfs:label "Coordination Layer"@en ;
    rdfs:comment "The Coordination Layer is the cross-cutting stratum that orchestrates the work of multiple agents or services toward a shared objective. It sits above control and integration concerns and below the application goals it serves. It contains schedulers, workflow engines, consensus on task assignment, and the protocols that keep distributed actors aligned."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:integration-layer ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:agent-layer,
        ngm:application-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:integration-layer ;
    vc:slug "coordination-layer" ;
    vc:sourceDomain "distributed-systems" .

ngm:credential-store a owl:Class ;
    rdfs:label "Credential Store"@en ;
    rdfs:comment "A credential store is the component within an identity system that holds user identifiers, secrets, and account attributes used during authentication. Implemented as a directory, database, or secrets vault, it is queried by an identity provider to validate sign-in attempts and issue tokens. Its integrity and confidentiality are critical to the security of the surrounding identity infrastructure."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:identity-provider ;
    vc:slug "credential-store" ;
    vc:sourceDomain "security" .

ngm:cryptocurrency-token a owl:Class ;
    rdfs:label "Cryptocurrency Token"@en ;
    rdfs:comment "A programmable digital asset implemented via smart contracts on a blockchain platform, categorised into utility tokens (access rights), security tokens (equity or debt instruments), governance tokens (protocol voting rights), and non-fungible tokens (NFTs, unique digital ownership). Token behaviour and interoperability are defined by standards such as ERC-20, ERC-721, and ERC-1155."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fungible-token,
        ngm:governance-token,
        ngm:utility-token ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:token-economics ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "cryptocurrency-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:erc-20,
        ngm:erc-721,
        ngm:token-standard .

ngm:cryptographic-infrastructure a owl:Class ;
    rdfs:label "Cryptographic Infrastructure"@en ;
    rdfs:comment "Cryptographic infrastructure is the ensemble of hardware, software, protocols, and institutional processes that provision, manage, and operate cryptographic primitives at scale across a computing environment. It encompasses key generation and distribution, certificate authorities, hardware security modules, and the policies governing their lifecycle. As a foundational layer, it underpins secure communications, digital identity, and data integrity across both centralised and decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph-publication-classifier-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:cryptographic-algorithm ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cryptographic-hash-function,
        ngm:cryptographic-key-management,
        ngm:knowledge-graph-publication-classifier-key-infrastructure ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:cryptographic-signing,
        ngm:digital-signature ;
    vc:slug "cryptographic-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:cryptographic-layer a owl:Class ;
    rdfs:label "Cryptographic Layer"@en ;
    rdfs:comment "The Cryptographic Layer is the stratum that provides confidentiality, integrity, and authenticity primitives to the layers above. It sits above the Hardware Layer, which supplies entropy and acceleration, and below identity, consensus, and security strata that depend on its guarantees. It contains ciphers, hash functions, signature schemes, and key management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-layer ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:consensus-layer,
        ngm:identity-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware-layer ;
    vc:slug "cryptographic-layer" ;
    vc:sourceDomain "security" .

ngm:cryptographic-system a owl:Class ;
    rdfs:label "Cryptographic System"@en ;
    rdfs:comment "An integrated framework of mathematical algorithms, protocols, and mechanisms designed to provide information security properties including confidentiality, integrity, authentication, and non-repudiation in adversarial environments. Blockchain cryptographic systems enable trustless operation through mathematical guarantees rather than trusted intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph-publication-classifier-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
