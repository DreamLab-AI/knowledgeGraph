    rdfs:subClassOf vf:artificial-intelligence ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "attention-head" ;
    vc:sourceDomain "artificial-intelligence" .

vf:attribute-sharing a owl:Class ;
    rdfs:label "Attribute Sharing"@en ;
    rdfs:comment "Attribute Sharing refers to identity federation mechanisms that enable selective disclosure of user credentials and identity attributes across metaverse platforms and blockchain applications, using Self-Sovereign Identity (SSI) principles and decentralized identifiers to maintain user control while enabling verification without centralized authorities."@en ;
