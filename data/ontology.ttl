ngm:vector-store a owl:Class ;
    rdfs:label "Vector Store"@en ;
    rdfs:comment "A storage system optimised for holding high-dimensional vector embeddings and retrieving them by similarity. It supports nearest-neighbour search used in semantic retrieval and machine learning applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
