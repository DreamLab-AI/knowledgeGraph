ngm:cryptographic-security a owl:Class ;
    rdfs:label "Cryptographic Security"@en ;
    rdfs:comment "Cryptographic Security is the application of cryptographic primitives and protocols—including symmetric and asymmetric encryption, digital signatures, hash functions, and zero-knowledge proofs—to protect data confidentiality, integrity, and authenticity. In blockchain and metaverse contexts it underpins transaction authorisation, identity verification, secure key management, and privacy-preserving computation, forming the bedrock upon which trustless systems and decentralised applications are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:infra-security-and-identity,
        ngm:security-framework ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-signature,
        ngm:encryption,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "cryptographic-security" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:blockchain,
        ngm:privacy-framework .

ngm:diffusion-models a owl:Class ;
    rdfs:label "Diffusion Models"@en ;
    rdfs:comment "Diffusion Models are a class of deep generative models that learn the data distribution p_data(x) by reversing a fixed forward Markov noising process q(x_t | x_{t-1}) that progressively corrupts data x_0 with Gaussian noise across T timesteps until x_T ≈ N(0,I), then training a neural denoiser ε_..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-schedule ],
        ngm:ai-model-architecture,
        ngm:generative-model ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:3-d-generation,
        ngm:audio-synthesis,
        ngm:image-editing,
        ngm:image-synthesis,
        ngm:inpainting,
        ngm:super-resolution,
        ngm:video-synthesis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:forward-noising-process,
        ngm:noise-schedule,
        ngm:reverse-denoising-process,
        ngm:sampler,
        ngm:score-network,
        ngm:text-encoder,
        ngm:variational-lower-bound ;
    vc:implements ngm:denoising-score-matching,
        ngm:flow-matching,
        ngm:rectified-flow,
        ngm:stochastic-differential-equation,
        ngm:variational-lower-bound-maximisation ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:representation-learning,
        ngm:synthetic-media,
        ngm:text-to-image,
        ngm:text-to-video ;
    vc:requires ngm:differentiable-architecture,
        ngm:gpu-compute,
        ngm:stochastic-gradient-descent,
        ngm:training-data-distribution,
        ngm:variational-inference ;
    vc:slug "diffusion-models" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:cvpr,
        ngm:fid-benchmark-protocol,
        ngm:iclr,
        ngm:icml,
        ngm:neur-ips ;
    vc:supports ngm:creative-tools,
        ngm:drug-discovery,
        ngm:game-asset-generation,
        ngm:medical-image-synthesis,
        ngm:synthetic-data-generation,
        ngm:world-models ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip-encoder,
        ngm:control-net,
        ngm:cross-attention,
        ngm:diffusion-transformer,
        ngm:t5-encoder,
        ngm:u-net,
        ngm:variational-autoencoders .

ngm:distributed-collaboration a owl:Class,
        skos:Concept ;
    rdfs:label "Distributed Collaboration"@en ;
    rdfs:comment "Distributed Collaboration is the set of technologies, protocols, and practices that enable geographically dispersed individuals or teams to work together on shared tasks in real time or asynchronously. It encompasses communication protocols, version control systems, shared workspaces, and presence mechanisms, and serves as the umbrella concept for synchronous, asynchronous, and spatial collaboration modalities in the ontology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synchronous-collaboration ],
        owl:Thing ;
