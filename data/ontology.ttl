ngm:erc-4626 a owl:Class ;
    rdfs:label "ERC-4626"@en ;
    rdfs:comment "ERC-4626 is a finalised Ethereum Improvement Proposal that specifies a standardised application-programming interface for tokenised yield-bearing vaults, extending the ERC-20 fungible token standard with deposit, withdrawal, and share-accounting functions. It allows any vault — whether backed by lending protocols, automated market makers, or staking contracts — to expose a uniform interface so that aggregators, routers, and analytics tools can interact with all vaults without bespoke adapters. The standard mandates methods such as deposit, mint, withdraw, redeem, and convertToAssets alongside preview variants that return expected amounts without state changes, enabling safe, read-only price discovery. Adoption of ERC-4626 reduces integration friction across decentralised finance, enabling composable yield strategies and dramatically lowering the cost of building multi-vault products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20 ],
        ngm:token-standard ;
    vc:bridgesTo ngm:portfolio-management,
        ngm:real-world-asset-tokenisation ;
    vc:contrastsWith ngm:eip-1155,
        ngm:erc-4337 ;
    vc:enables ngm:composability,
        ngm:decentralised-finance,
        ngm:liquidity-mining,
        ngm:yield-aggregator ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ethereum-improvement-proposal,
        ngm:yield-generation ;
    vc:isPartOf ngm:ethereum ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:lending-protocol,
        ngm:liquid-staking,
        ngm:smart-contract-security ;
    vc:requires ngm:erc-20,
        ngm:ethereum-smart-contract-platform-smart-contracts ;
    vc:slug "erc-4626" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-smart-contract-platform-foundation ;
    vc:uses ngm:fungible-token,
        ngm:solidity .

ngm:ergodic-theory a owl:Class ;
    rdfs:label "Ergodic Theory"@en ;
    rdfs:comment "Ergodic theory is the branch of mathematics that studies the long-term statistical behaviour of dynamical systems that preserve a measure. Its central result, the ergodic theorem, gives conditions under which the time average of a quantity along a single trajectory equals its average over the whole state space. The theory provides the foundations for understanding when sampling a process over time yields the same information as sampling its underlying distribution, which is essential for Monte Carlo methods and statistical learning."@en ;
    rdfs:subClassOf ngm:dynamical-systems ;
    vc:bridgesTo ngm:machine-learning ;
    vc:dependsOn ngm:probability-theory ;
    vc:enables ngm:markov-chain-monte-carlo,
        ngm:monte-carlo-methods,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:density-estimation,
        ngm:entropy,
        ngm:probabilistic-programming ;
    vc:slug "ergodic-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:probabilistic-model,
        ngm:statistical-inference ;
    vc:uses ngm:markov-chain,
        ngm:probability-theory,
        ngm:stochastic-process .

