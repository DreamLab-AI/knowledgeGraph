        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:game-asset-generation,
        ngm:play-to-earn-p2-e ;
    vc:qualityScore "0.0"^^xsd:float ;
