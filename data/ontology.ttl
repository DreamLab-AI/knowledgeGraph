        ngm:media-server,
        ngm:websocket ;
    vc:requires ngm:audio-codec,
        ngm:nat-traversal,
        ngm:network-latency,
        ngm:video-compression ;
    vc:slug "real-time-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:w3c ;
    vc:uses ngm:congestion-control,
        ngm:data-channel,
        ngm:secure-real-time-transport-protocol .

