ngm:json-data-interchange-format-ld-1-1-standard a owl:Class ;
    rdfs:comment "JSON-LD 1.1 is a W3C Recommendation defining a JSON-based serialization for Linked Data, allowing JSON documents to be interpreted as RDF graphs. It introduces a context mechanism that maps JSON keys to IRIs, plus features such as framing, nested contexts and typed values added in the 1.1 revision. It is the dominant format for embedding machine-readable semantics in web data."@en ;
    rdfs:label "JSON-LD 1.1 Standard"@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
