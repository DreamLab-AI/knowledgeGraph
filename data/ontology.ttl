ngm:container-runtime a owl:Class ;
    rdfs:label "Container Runtime"@en ;
    rdfs:comment "A container runtime is the software responsible for running containers on a host: pulling and unpacking images, configuring isolation and resource limits, and starting, stopping and supervising container processes. Runtimes operate at low and high levels, from minimal process launchers to daemons that manage image lifecycles, and present standard interfaces consumed by orchestrators such as Kubernetes. Container runtimes provide the execution foundation for portable, lightweight, cloud-native workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:resource-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:orchestration ],
        [ a owl:Restriction ;
