ngm:metaverse-classification a owl:Class ;
    rdfs:label "Metaverse Classification"@en ;
    rdfs:comment "A structured taxonomy scheme for categorising metaverse platforms, applications, and components according to defined criteria such as openness, immersion level, economic model, and governance structure, enabling systematic comparison and standardised description within the ETSI metaverse domain model."@en ;
    rdfs:subClassOf ngm:etsi-metaverse-domain-taxonomy,
