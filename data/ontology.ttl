    vc:hasPart ngm:access-control,
        ngm:network-segmentation ;
    vc:isPartOf ngm:cybersecurity,
        ngm:network-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:network-security,
        ngm:vpn ;
