ngm:heuristic-search a owl:Class ;
    rdfs:comment "Heuristic search is a family of search algorithms that use a problem-specific evaluation function to estimate the cost or promise of candidate states, focusing exploration on the most promising regions of a search space. By trading exhaustive coverage for informed guidance, heuristic methods such as A* and best-first search solve large combinatorial problems that are intractable for uninformed search. The quality of the heuristic determines both efficiency and, in admissible cases, optimality."@en ;
    rdfs:label "Heuristic Search"@en ;
    rdfs:subClassOf ngm:search-algorithm ;
    rdfs:subClassOf _:r11639 ;
    rdfs:subClassOf _:r11640 ;
