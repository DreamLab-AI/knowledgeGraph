        ngm:ieee,
        ngm:ietf,
        ngm:iso-iec,
        ngm:iso-standards,
        ngm:w3-c ;
    vc:slug "oasis" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:enterprise-security,
        ngm:virtual-environment-specification ;
    vc:uses ngm:mqtt,
        ngm:rest-api,
        ngm:xml .

ngm:optical-calibration-target a owl:Class ;
    rdfs:label "Optical Calibration Target"@en ;
    rdfs:comment "An optical calibration target is a precision artefact bearing known geometric, radiometric, or colourimetric reference patterns used to characterise, correct, and validate the response of imaging and optical systems. Such targets enable the measurement of lens distortion, modulation transfer function (MTF), chromatic aberration, colour reproduction accuracy, and spatial linearity across a wide range of imaging modalities from visible-light cameras to multispectral and depth sensors. They are fundamental to the metrological traceability chain that links deployed camera systems to national and international measurement standards. In spatial computing and extended-reality applications, calibration targets additionally serve as fiducial references for camera-to-camera alignment, display-sensor registration, and world-space coordinate grounding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fiducial-marker ],
        ngm:calibration-equipment ;
    vc:bridgesTo ngm:neural-radiance-field,
        ngm:simultaneous-localisation-and-mapping ;
    vc:enables ngm:camera-calibration,
        ngm:colour-management,
        ngm:lens-distortion-correction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fiducial-marker ;
    vc:isPartOf ngm:camera-calibration ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:sensor-calibration,
        ngm:transfer-function ;
    vc:requires ngm:controlled-illumination,
        ngm:metrological-traceability ;
    vc:slug "optical-calibration-target" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-12233,
        ngm:iso-17321,
        ngm:nist-measurement-standards ;
    vc:supports ngm:augmented-reality-tracking,
        ngm:computer-vision-pipeline,
        ngm:machine-vision-inspection,
        ngm:photogrammetry ;
    vc:uses ngm:checkerboard-pattern,
        ngm:visual-marker .

ngm:ordinals a owl:Class ;
    rdfs:label "Ordinals"@en ;
    rdfs:comment "A scheme for numbering individual satoshis by order of issuance and transfer, allowing arbitrary data to be inscribed onto specific satoshis on the Bitcoin blockchain via the witness field of Taproot transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inscription ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:taproot ],
        ngm:bitcoin-proof-of-work-protocol ;
    vc:bridgesTo ngm:decentralised-storage,
        ngm:digital-ownership ;
    vc:contrastsWith ngm:fungible-token ;
    vc:dependsOn ngm:bitcoin,
        ngm:seg-wit ;
    vc:enables ngm:brc-20 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:inscription ;
    vc:isPartOf ngm:bitcoin ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-collectible,
        ngm:non-fungible-token,
        ngm:on-chain-storage ;
    vc:requires ngm:bitcoin-script,
        ngm:proof-of-work,
        ngm:taproot,
        ngm:utxo ;
    vc:slug "ordinals" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:content-addressing,
        ngm:witness-data .

ngm:over-collateralisation a owl:Class ;
    rdfs:label "Over Collateralisation"@en ;
    rdfs:comment "Over-collateralisation is a risk-management practice in which the value of assets pledged as collateral exceeds the value of the obligation they secure. In decentralised finance it is the standard requirement for permissionless lending and for backing stablecoins, where borrowers must deposit more value than they draw to absorb price volatility. The surplus margin protects lenders and protocols against default by ensuring that collateral can be liquidated for at least the amount owed even when prices move adversely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:interest-rate ;
    vc:dependsOn ngm:price-oracle ;
    vc:enables ngm:lending-protocol,
        ngm:liquidation-mechanism,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:risk-management ;
    vc:isPartOf ngm:risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:aave,
        ngm:interest-rate,
        ngm:liquidity ;
    vc:requires ngm:price-oracle,
        ngm:smart-contract ;
    vc:slug "over-collateralisation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-exchange,
        ngm:yield-farming ;
    vc:uses ngm:oracle .

ngm:panoptic-segmentation a owl:Class ;
    rdfs:label "Panoptic Segmentation"@en ;
    rdfs:comment "A computer vision task that unifies semantic segmentation and instance segmentation by assigning every image pixel both a class label and an instance identifier, providing holistic scene parsing that distinguishes countable foreground objects (\"things\") from amorphous background regions (\"stuff\"). Architectures such as Panoptic FPN, Panoptic-DeepLab, and MaskFormer formalise this unified representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:instance-segmentation,
        ngm:semantic-segmentation ;
    vc:dependsOn ngm:deep-learning,
        ngm:feature-pyramid-network,
        ngm:transformer-architecture ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robot-perception,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:instance-segmentation,
        ngm:panoptic-quality-metric,
        ngm:semantic-segmentation ;
    vc:isPartOf ngm:computer-vision,
        ngm:image-segmentation ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task,
        ngm:image-recognition ;
    vc:requires ngm:convolutional-neural-network,
        ngm:object-detection,
        ngm:pixel-classification ;
    vc:slug "panoptic-segmentation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cityscapes-dataset,
        ngm:coco-dataset .

ngm:parallel-corpus a owl:Class ;
    rdfs:label "Parallel Corpus"@en ;
    rdfs:comment "A Parallel Corpus is a collection of texts paired with their translations in one or more other languages, aligned at the sentence or segment level. It provides the supervised training signal for statistical and neural machine-translation systems by exemplifying how meaning maps across languages. The size, quality, and domain coverage of a parallel corpus strongly influence the accuracy of trained translation models."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:real-time-translation,
        ngm:translation ;
    vc:slug "parallel-corpus" ;
    vc:sourceDomain "ai" .

ngm:path-tracing a owl:Class ;
    rdfs:label "Path Tracing"@en ;
    rdfs:comment "Path tracing is a physically based rendering algorithm that estimates the rendering equation by stochastically sampling complete light-transport paths from the camera through a scene to light sources. It uses Monte Carlo integration over recursive ray bounces to compute unbiased estimates of global illumination, including soft shadows, indirect lighting, and caustics. Image noise decreases as the square root of the number of samples, making convergence and denoising central practical concerns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:importance-sampling ],
        ngm:physically-based-rendering ;
    vc:bridgesTo ngm:computer-graphics ;
    vc:contrastsWith ngm:rasterization ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:importance-sampling,
        ngm:ray-tracing ;
    vc:implements ngm:global-illumination,
        ngm:monte-carlo-integration ;
    vc:isPartOf ngm:physically-based-rendering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graphics-pipeline,
        ngm:shader,
        ngm:spatial-computing ;
    vc:slug "path-tracing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu .

ngm:payment-processing a owl:Class ;
    rdfs:label "Payment Processing"@en ;
    rdfs:comment "Payment processing is the sequence of operations that authorise, capture, clear and settle a monetary transaction between a payer and a payee. It coordinates merchants, payment gateways, networks and settlement institutions to verify funds, manage risk and move value reliably. Modern payment processing spans card rails, digital wallets and blockchain-based settlement, increasingly emphasising speed, fraud detection and interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clearing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement ],
        ngm:payment-network ;
    vc:bridgesTo ngm:cryptocurrency ;
    vc:dependsOn ngm:settlement ;
    vc:enables ngm:transaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:clearing,
        ngm:payment-gateway,
        ngm:settlement ;
    vc:isPartOf ngm:payment-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:stripe,
        ngm:transaction ;
    vc:requires ngm:authentication,
        ngm:fraud-detection ;
    vc:slug "payment-processing" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-wallet,
        ngm:fintech ;
    vc:uses ngm:payment-rail .

ngm:permissionless-participation a owl:Class ;
    rdfs:label "Permissionless Participation"@en ;
    rdfs:comment "Permissionless participation is the property of a network whereby any actor may join, transact, validate, or contribute without requesting approval from a central authority. It is a defining characteristic of public blockchains, where open access to running nodes and proposing or validating blocks underpins censorship resistance and decentralisation. The property is enforced by economic and cryptographic mechanisms rather than identity vetting."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:consensus-mechanism ;
    vc:slug "permissionless-participation" ;
    vc:sourceDomain "blockchain" .

ngm:pick-and-place a owl:Class ;
    rdfs:label "Pick and Place"@en ;
    rdfs:comment "Pick and place is a canonical robotic manipulation task in which a manipulator grasps an object at a source location and deposits it at a target location. It chains perception to localise the object, motion planning to reach and grasp it, and controlled placement, often repeated at high speed in structured settings. It is the foundational operation of industrial automation in assembly, packaging, and sorting."@en ;
    rdfs:subClassOf ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cylindrical-robot,
        ngm:position-control ;
    vc:slug "pick-and-place" ;
    vc:sourceDomain "robotics" .

ngm:policy-decision-point a owl:Class ;
    rdfs:label "Policy Decision Point"@en ;
    rdfs:comment "A Policy Decision Point (PDP) is the logical component in an attribute-based or policy-based access control architecture that evaluates access requests against a set of authorisation policies and returns a permit, deny, or indeterminate decision. The PDP receives a request context—including subject attributes, resource attributes, action, and environment conditions—from a Policy Enforcement Point (PEP), retrieves applicable policies from a Policy Information Point (PIP) or Policy Administration Point (PAP), and applies the XACML combining algorithms or equivalent logic to reach a binding decision. PDPs are the computational core of fine-grained, dynamic authorisation systems used in zero-trust security architectures, identity federation, API gateways, and cloud IAM platforms."@en ;
    rdfs:subClassOf ngm:access-control-system ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:service-mesh ;
    vc:contrastsWith ngm:network-perimeter-security ;
    vc:dependsOn ngm:authentication,
        ngm:cryptographic-verification,
        ngm:identity-management ;
    vc:enables ngm:authorization,
        ngm:policy-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:attribute-based-access-control,
        ngm:xacml ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:policy-administration-point,
        ngm:policy-enforcement,
        ngm:policy-enforcement-point,
        ngm:policy-engine,
        ngm:policy-information-point ;
    vc:slug "policy-decision-point" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:oasis ;
    vc:supports ngm:api-gateway,
        ngm:identity-federation ;
    vc:uses ngm:json-data-interchange-format-web-token,
        ngm:open-policy-agent,
        ngm:verifiable-credentials .

ngm:polynomial-commitment a owl:Class ;
    rdfs:label "Polynomial Commitment"@en ;
    rdfs:comment "A Polynomial Commitment is a cryptographic scheme that lets a prover commit to a polynomial with a short, binding value and later open the commitment at chosen evaluation points without revealing the whole polynomial. Verification of an opening is succinct and the commitment hides the polynomial until opened. Polynomial commitments are a core building block of modern succinct proof systems such as zk-SNARKs and zk-STARKs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-setup ],
        ngm:cryptographic-commitment ;
    vc:contrastsWith ngm:merkle-tree ;
    vc:dependsOn ngm:finite-field ;
    vc:enables ngm:verifiable-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:cryptographic-commitment ;
    vc:isPartOf ngm:commitment-scheme ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:kzg-commitment,
        ngm:merkle-tree,
        ngm:reed-solomon-codes ;
    vc:requires ngm:trusted-setup ;
    vc:slug "polynomial-commitment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:verifiable-computation,
        ngm:zk-snark ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:finite-field .

ngm:pretrained-model a owl:Class ;
    rdfs:label "Pretrained Model"@en ;
    rdfs:comment "A neural network or machine learning model that has been trained on a large dataset (often a broad corpus) before being adapted to a specific downstream task through fine-tuning or prompting. Pretrained models encode general representations—linguistic, visual, or multimodal—that can be efficiently transferred, dramatically reducing the data and compute required for specialised applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pretrained-weights ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:checkpoints ],
        ngm:ai-technique,
        ngm:model ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:lo-ra-fine-tuning,
        ngm:neural-network-quantisation,
        ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:checkpoints,
        ngm:pretrained-weights ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:large-language-models,
        ngm:transfer-learning ;
    vc:slug "pretrained-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:pre-training .

ngm:privacy-preserving-machine-learning a owl:Class ;
    rdfs:label "Privacy-Preserving Machine Learning"@en ;
    rdfs:comment "Privacy-preserving machine learning is the set of techniques that train, evaluate, and serve machine-learning models while limiting exposure of sensitive training data and model internals. It combines cryptographic protocols, statistical guarantees, and distributed training architectures to bound what an adversary can learn about individual records. The goal is to retain predictive utility while satisfying confidentiality, regulatory, and trust constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:privacy-enhancing-technologies ;
    vc:bridgesTo ngm:security ;
    vc:enables ngm:data-privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning ;
    vc:isPartOf ngm:privacy-enhancing-technologies ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:encryption,
        ngm:model-training,
        ngm:privacy ;
    vc:requires ngm:machine-learning ;
    vc:slug "privacy-preserving-machine-learning" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:edge-computing ;
    vc:uses ngm:cryptography,
        ngm:homomorphic-encryption,
        ngm:trusted-execution-environment .

ngm:propositional-logic a owl:Class ;
    rdfs:label "Propositional Logic"@en ;
    rdfs:comment "Propositional logic, also known as sentential logic or zeroth-order logic, is a formal system in which the basic units are whole propositions that are either true or false, combined using logical connectives such as conjunction, disjunction, negation, implication, and biconditional. It studies the truth-functional behaviour of compound statements and provides the foundation on which richer logics, including predicate logic, are built. Its decidability and clear semantics make it central to circuit design, satisfiability solving, and automated reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logical-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-language ],
        ngm:logic ;
    vc:bridgesTo ngm:knowledge-representation ;
    vc:contrastsWith ngm:predicate-logic ;
    vc:dependsOn ngm:formal-language ;
    vc:enables ngm:automated-reasoning,
        ngm:constraint-satisfaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:logical-inference ;
    vc:implements ngm:logic ;
    vc:isPartOf ngm:logic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction,
        ngm:first-order-logic,
        ngm:reasoning ;
    vc:requires ngm:formal-language ;
    vc:slug "propositional-logic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:formal-verification,
        ngm:theorem-proving ;
    vc:uses ngm:logical-inference .

ngm:protocol a owl:Class ;
    rdfs:label "Protocol"@en ;
    rdfs:comment "A protocol is an agreed set of rules and message formats that govern how two or more parties exchange information or coordinate behaviour. It defines the syntax, semantics, timing and error handling needed for systems to interoperate reliably without prior bespoke arrangement. Protocols underpin networking, distributed systems and many forms of machine-to-machine and human-to-machine interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        ngm:open-standards ;
    vc:bridgesTo ngm:interoperability ;
    vc:enables ngm:communication-protocol,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api,
        ngm:message-format ;
    vc:implements ngm:interoperability-standard ;
    vc:isPartOf ngm:open-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:network-protocol,
        ngm:request-for-comments ;
    vc:requires ngm:interoperability-standard,
        ngm:message-format ;
    vc:slug "protocol" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:internet-engineering-task-force ;
    vc:supports ngm:interoperability,
        ngm:semantic-interoperability ;
    vc:uses ngm:network-protocol .

ngm:pruning a owl:Class ;
    rdfs:label "Pruning"@en ;
    rdfs:comment "Pruning is a model compression technique that removes redundant or low-importance parameters from a neural network to reduce its size and computational cost while preserving accuracy. It ranges from unstructured pruning of individual weights to structured pruning of whole neurons, channels or attention heads. Pruned models are typically fine-tuned to recover any lost accuracy and can be deployed with lower memory and latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-weights ],
        ngm:model-compression ;
    vc:bridgesTo ngm:large-language-model ;
    vc:contrastsWith ngm:knowledge-distillation,
        ngm:model-quantization ;
    vc:enables ngm:model-deployment,
        ngm:tiny-ml ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-weights ;
    vc:isPartOf ngm:model-compression ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-optimisation-and-performance,
        ngm:parameter-efficient-fine-tuning,
        ngm:quantisation ;
    vc:requires ngm:neural-network ;
    vc:slug "pruning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:edge-ai,
        ngm:inference,
        ngm:on-device-ai ;
    vc:uses ngm:gpu-memory .

ngm:rb-0022-robot-dynamics a owl:Class ;
    rdfs:label "rb 0022 robot dynamics"@en ;
    rdfs:comment "Robot dynamics is the study of the relationship between the forces and torques applied to a robot's joints and links and the resulting motion of the robot. It encompasses forward dynamics (computing accelerations from applied torques), inverse dynamics (computing required torques to achieve a desired motion), and the derivation of equations of motion via Newton-Euler or Lagrangian formulations. Dynamic models are essential for model-based controllers such as computed-torque control, optimal control, and trajectory optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0041-inertia ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0043-torque ],
        ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0051-trajectory-planning,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:newton-euler-dynamics,
        ngm:rb-0030-jacobian-matrix,
        ngm:rigid-body-dynamics ;
