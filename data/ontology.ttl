    vc:contrastsWith ngm:predictive-analytics ;
    vc:dependsOn ngm:data-cleaning ;
    vc:enables ngm:feature-engineering,
        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
