    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Domain" .

# Training Method
artificial-intelligence:Trainingmethod rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:MachineLearning ;
    rdfs:label "Training Method"@en ;
    rdfs:comment "Training methods in machine learning are algorithms and techniques used to optimize model parameters by minimizing a loss function through iterative weight updates. The core approach combines backpropagation (computing gradients via the chain rule) with gradient descent optimization (adjusting weights in the direction that reduces loss), with variants including stochastic gradient descent (SGD), Adam, RMSprop, and AdaGrad offering different convergence properties."@en ;
    skos:prefLabel "Training Method"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:training-method" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:training-method> ;
    vcw:contentHash "sha256-12-8b1ddcff541b" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "AI-7005" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-7005" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

