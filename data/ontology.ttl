    vc:slug "privacy-disclosure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accountability .

ngm:privacy-law a skos:Concept ;
    rdfs:label "Privacy Law"@en .

ngm:privacy-requirements a owl:Class ;
    rdfs:label "Privacy Requirements"@en ;
    rdfs:comment "Privacy requirements are the documented obligations and constraints a system must satisfy to protect personal data, derived from law, regulation, contracts, and organisational policy. They specify what data may be collected, how it is processed and retained, and the rights afforded to data subjects. They drive system design, data-flow controls, and privacy impact assessments."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:legal-framework,
        ngm:privacy-impact-assessment-pia ;
    vc:slug "privacy-requirements" ;
    vc:sourceDomain "governance" .

ngm:private-smart-contract a owl:Class ;
    rdfs:label "Private Smart Contract"@en ;
    rdfs:comment "A private smart contract is a smart contract whose inputs, state or logic are concealed from public view while still being verifiably executed and settled on a blockchain. It typically relies on zero-knowledge proofs or confidential computing so that correctness can be checked without revealing the underlying data. Private smart contracts let parties transact programmable agreements with confidentiality comparable to traditional finance while retaining the auditability and finality of public ledgers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-preserving-computation ],
        ngm:smart-contract ;
    vc:contrastsWith ngm:smart-contract ;
    vc:enables ngm:decentralized-finance,
        ngm:transaction-privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:zero-knowledge-rollup ;
    vc:isPartOf ngm:smart-contract ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:privacy,
        ngm:smart-contracts ;
    vc:requires ngm:privacy-preserving-computation ;
    vc:slug "private-smart-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:aztec-protocol ;
    vc:uses ngm:homomorphic-encryption,
        ngm:zero-knowledge-proof .

ngm:probabilistic-roadmap a owl:Class ;
    rdfs:label "Probabilistic Roadmap"@en ;
    rdfs:comment "A probabilistic roadmap (PRM) is a sampling-based motion-planning algorithm that constructs a graph representation of the free configuration space of a robot by randomly sampling collision-free configurations and connecting nearby configurations with local path planners. In a preprocessing phase, many random configurations are sampled and validated against the robot's collision model; valid configurations become nodes and successful local connections become edges. At query time, start and goal configurations are connected to the roadmap and a graph-search algorithm finds a path. PRMs are effective in high-dimensional configuration spaces where deterministic grid-based planners are computationally infeasible."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:contrastsWith ngm:grid-based-planning,
        ngm:potential-field-planning ;
    vc:dependsOn ngm:obstacle-model,
        ngm:random-sampling ;
    vc:enables ngm:autonomous-navigation,
        ngm:multi-query-planning,
        ngm:robot-arm-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:configuration-sample,
        ngm:local-planner,
        ngm:roadmap-graph ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:motion-planning,
        ngm:path-planning,
        ngm:rapidly-exploring-random-tree,
        ngm:robot-kinematics ;
    vc:slug "probabilistic-roadmap" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:high-dimensional-planning,
        ngm:robot-manipulation ;
    vc:uses ngm:collision-detection,
        ngm:configuration-space,
        ngm:graph-search,
        ngm:sampling-based-planning .

