ngm:vision-transformers a owl:Class ;
    rdfs:label "Vision Transformers"@en ;
    rdfs:comment "Transformer-based neural network architectures applied to images by splitting an image into fixed-size patches and treating those patches as a sequence of tokens for self-attention, enabling global context modelling across the full image without relying on local convolutional receptive fields."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:patch-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-scale-pretraining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-head-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:positional-encoding ],
        ngm:vision-transformer ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:convolutional-neural-network ;
    vc:enables ngm:image-classification,
        ngm:image-segmentation,
        ngm:multimodal-ai-architecture-learning,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feed-forward-network,
        ngm:multi-head-attention,
        ngm:patch-embedding ;
    vc:qualityScore "0.72"^^xsd:float ;
