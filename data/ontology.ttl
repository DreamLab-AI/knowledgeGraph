# Performance Benchmarks
mv:PerformanceBenchmarks a owl:Class ;
    rdfs:subClassOf mv:SoftwareTesting ;
    rdfs:label "Performance Benchmarks"@en ;
    rdfs:comment "Standardized tests and metrics used to evaluate and compare software, hardware, or system performance under controlled conditions, measuring factors such as response time, throughput, resource utilization, and error rates."@en ;
    skos:prefLabel "Performance Benchmarks"@en ;
    dcterms:identifier "MV-10002" ;
    dcterms:subject "mv" .

mv:PerformanceBenchmarks rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:PerformanceOptimization
] .

mv:PerformanceBenchmarks rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:PerformanceTesting
] .

mv:PerformanceBenchmarks rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:QualityAssurance
] .

mv:PerformanceBenchmarks rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SystemEvaluation
] .

# Persistent AR Placement
mv:PersistentArPlacement a owl:Class ;
    rdfs:subClassOf mv:AugmentedReality ;
    rdfs:label "Persistent AR Placement"@en ;
    rdfs:comment "The capability to anchor augmented reality content at specific real-world locations that persists across sessions and devices, using cloud-stored spatial anchors and environmental mapping to enable shared, location-based AR experiences."@en ;
    skos:prefLabel "Persistent AR Placement"@en ;
    dcterms:identifier "MV-10003" ;
    dcterms:subject "mv" .

mv:PersistentArPlacement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:SharedARExperiences
] .

mv:PersistentArPlacement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SpatialAnchors
] .

mv:PersistentArPlacement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:CloudComputing
] .

mv:PersistentArPlacement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:LocationBasedServices
] .

# Personalized Virtual Experiences
mv:PersonalizedVirtualExperiences a owl:Class ;
    rdfs:subClassOf mv:VirtualExperience ;
    rdfs:label "Personalized Virtual Experiences"@en ;
    rdfs:comment "AI-driven customization of virtual environments, content, and interactions based on individual user preferences, behaviors, and interests, enabling tailored journeys through metaverse spaces with adaptive storytelling, avatars, and content recommendations."@en ;
    skos:prefLabel "Personalized Virtual Experiences"@en ;
    dcterms:identifier "MV-10004" ;
    dcterms:subject "mv" .

mv:PersonalizedVirtualExperiences rdfs:subClassOf [
    a owl:Restriction ;
