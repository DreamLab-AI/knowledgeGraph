ngm:backpropagation-through-time a owl:Class ;
    rdfs:comment "Backpropagation through time (BPTT) is the extension of the backpropagation algorithm used to train recurrent neural networks, in which the recurrent network is unrolled across time steps into an equivalent feedforward network so that gradients of the loss can be computed and propagated backward through every step of the sequence. Because gradients must flow through many time steps, BPTT is prone to vanishing and exploding gradients on long sequences, which motivated architectures such as LSTM that mitigate the problem through gating. Truncated BPTT, which limits the number of steps backpropagated, is commonly used in practice to control computational cost on long sequences."@en ;
    rdfs:label "Backpropagation Through Time"@en ;
    rdfs:subClassOf ngm:backpropagation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:backpropagation ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:relatedTo ngm:lstm ;
    vc:relatedTo ngm:recurrent-neural-network ;
    vc:slug "backpropagation-through-time" ;
    vc:sourceDomain "machine-learning" .
