ngm:universal-access a owl:Class ;
    rdfs:label "Universal Access"@en ;
    rdfs:comment "Universal access is the design principle and policy goal that products, services and digital experiences be usable by the widest possible range of people regardless of ability, device, connectivity or context. In immersive and metaverse settings it requires accommodating diverse sensory, motor and cognitive capabilities so that no user is excluded from participation. It is the foundation on which accessible experiences and accessibility guidelines are built."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessible-experience,
        ngm:xr-accessibility-guideline ;
    vc:slug "universal-access" ;
    vc:sourceDomain "metaverse" .

ngm:unspent-transaction-output a owl:Class ;
    rdfs:label "Unspent Transaction Output"@en ;
    rdfs:comment "An Unspent Transaction Output (UTXO) is a discrete amount of cryptocurrency that has been received by an address and not yet spent, forming the fundamental accounting unit in UTXO-based blockchains such as Bitcoin. Each transaction consumes one or more existing UTXOs as inputs and creates new UTXOs as outputs, with the global set of all UTXOs representing the current ledger state. Validating a transaction requires confirming that its referenced inputs exist in the UTXO set and have not already been spent, which is central to preventing double spending."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-validation ],
        ngm:blockchain-transaction ;
    vc:contrastsWith ngm:account-model ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:transaction-validation ;
    vc:enables ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-transaction,
        ngm:ledger ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:blockchain,
        ngm:cryptocurrency,
        ngm:double-spending,
        ngm:mining ;
    vc:requires ngm:digital-signature,
        ngm:transaction-validation ;
    vc:slug "unspent-transaction-output" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:transaction-validation ;
    vc:uses ngm:digital-signature,
        ngm:merkle-tree .

ngm:value-transfer a owl:Class ;
    rdfs:label "Value Transfer"@en ;
    rdfs:comment "The mechanism and process by which economic value, rights, or utility are exchanged between parties across physical, digital, and virtual domains, encompassing monetary systems, token-based systems, resource allocation, and rights transfer protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resource-allocation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:barter-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:money ],
