ngm:low-code-platform a owl:Class ;
    rdfs:comment "A low-code platform is a software development environment that lets users build applications primarily through visual, model-driven interfaces such as drag-and-drop component composition, declarative configuration, and pre-built connectors, while still permitting hand-written code for custom logic. It abstracts away much boilerplate of conventional programming, accelerating delivery and broadening who can build software to include semi-technical citizen developers. Modern platforms increasingly embed AI assistance for component suggestion, data-model inference, and automated workflow generation, positioning them as a core layer in enterprise hyperautomation strategies."@en ;
    rdfs:label "Low Code Platform"@en ;
    rdfs:subClassOf ngm:application-development ;
