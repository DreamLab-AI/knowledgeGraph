        ngm:digital-currency .

ngm:monitoring-system a owl:Class ;
    rdfs:label "Monitoring System"@en ;
    rdfs:comment "A monitoring system is an integrated observability platform that continuously collects, aggregates, and evaluates telemetry signals — metrics, logs, traces, and events — from target environments spanning software services, physical infrastructure, AI models, and distributed systems, in order to detect anomalies, assess operational health, and trigger alerts or automated remediation responses. It encompasses data-collection agents, instrumentation SDKs, time-series storage engines, query and alerting pipelines, and visualisation dashboards that together form a closed-loop feedback mechanism for operational reliability. Monitoring systems implement the three pillars of observability (metrics, logs, traces) and serve as the foundational layer for site reliability engineering, incident management, and compliance auditing in modern distributed architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-series-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instrumentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:log-aggregation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:aiops,
        ngm:machine-learning-operations,
        ngm:model-drift-detection ;
    vc:contrastsWith ngm:audit-logging ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:message-broker ;
    vc:enables ngm:ai-monitoring,
        ngm:capacity-planning,
        ngm:compliance-monitoring,
        ngm:incident-management,
        ngm:real-time-monitoring,
        ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting-system,
        ngm:data-pipeline,
        ngm:log-aggregation,
        ngm:monitoring-dashboard,
        ngm:time-series-database ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:chaos-engineering,
        ngm:devops,
        ngm:service-level-objective ;
    vc:requires ngm:distributed-systems,
        ngm:instrumentation,
        ngm:network-infrastructure ;
    vc:slug "monitoring-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-telemetry,
        ngm:prometheus ;
    vc:uses ngm:anomaly-detection,
        ngm:data-analytics,
        ngm:open-telemetry,
        ngm:predictive-analytics,
        ngm:stream-processing .

ngm:mqtt a owl:Class ;
    rdfs:label "MQTT"@en ;
    rdfs:comment "MQTT (Message Queuing Telemetry Transport) is a lightweight publish-subscribe messaging protocol standardised as ISO/IEC 20922 and OASIS MQTT 5.0, designed for constrained devices and low-bandwidth or unreliable networks with minimal protocol overhead. Clients connect to a central broker that routes messages hierarchically by topic string; publishers post payloads to topic endpoints and subscribers receive all messages matching wildcard-capable topic filters. MQTT defines three quality-of-service levels—at most once (QoS 0), at least once (QoS 1), and exactly once (QoS 2)—enabling integrators to balance delivery guarantees against network and compute cost across heterogeneous deployments spanning embedded microcontrollers to cloud-scale brokers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:publish-subscribe-pattern ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:digital-twin,
        ngm:inference,
        ngm:ros-2 ;
    vc:contrastsWith ngm:amqp,
        ngm:co-ap,
        ngm:http ;
    vc:dependsOn ngm:embedded-systems,
        ngm:network-infrastructure ;
    vc:enables ngm:event-driven-architecture,
        ngm:internet-of-things,
        ngm:real-time-streaming,
        ngm:sensor-data,
        ngm:telemetry-and-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:publish-subscribe-pattern ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-serialization,
        ngm:scada ;
    vc:requires ngm:message-broker,
        ngm:publish-subscribe-pattern ;
    vc:slug "mqtt" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:oasis ;
    vc:supports ngm:edge-computing,
        ngm:industrial-io-t,
        ngm:smart-home-automation ;
    vc:uses ngm:communication-protocol,
        ngm:tcp-ip,
        ngm:tls,
        ngm:web-sockets .

ngm:multi-head-attention a owl:Class ;
    rdfs:label "Multi-Head Attention"@en ;
    rdfs:comment "An extension of scaled dot-product attention that runs multiple attention operations in parallel over distinct learned projection subspaces, then concatenates and linearly projects the results. Multi-head attention enables Transformer models to capture diverse dependency patterns across positions and representation subspaces simultaneously, and is foundational to modern large language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:matrix-multiplication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scaled-dot-product-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-key-value ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-head ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-weight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:softmax-function ],
        ngm:attention-mechanism ;
    vc:bridgesTo ngm:attention-mechanism,
        ngm:graph-attention-network ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:recurrent-neural-network ;
    vc:dependsOn ngm:layer-normalisation,
        ngm:positional-encoding ;
    vc:enables ngm:long-range-dependency-modelling,
        ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-head,
        ngm:attention-weight,
        ngm:query-key-value,
        ngm:scaled-dot-product-attention ;
    vc:implements ngm:attention-mechanism ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bert,
        ngm:cross-attention,
        ngm:flash-attention,
        ngm:grouped-query-attention,
        ngm:large-language-model,
        ngm:self-attention,
        ngm:vision-transformer ;
    vc:requires ngm:linear-projection,
        ngm:matrix-multiplication,
        ngm:softmax-function ;
    vc:slug "multi-head-attention" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:feed-forward-network,
        ngm:residual-connection .

ngm:multisignature a owl:Class ;
    rdfs:label "Multisignature"@en ;
    rdfs:comment "Multisignature (multisig) is a cryptographic access-control scheme in which a transaction or operation requires a quorum of M independent signatures drawn from a declared set of N authorised keyholders before it can be validated and executed. Applied to cryptocurrency wallets, smart contracts, and DAO treasuries, the M-of-N threshold eliminates single points of failure in key custody by distributing signing authority across multiple parties, devices, or organisations. More advanced variants — threshold signature schemes (TSS) and multi-party computation (MPC) — achieve the same security guarantee without assembling the full key set on-chain, reducing transaction cost and improving privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum-threshold ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:cryptographic-signature ;
    vc:bridgesTo ngm:decentralised-governance,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:custodial-wallet,
        ngm:single-key-wallet ;
    vc:dependsOn ngm:bitcoin-script,
        ngm:smart-contract ;
    vc:enables ngm:institutional-custody,
        ngm:multi-signature-wallet,
        ngm:self-custody,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:access-control,
        ngm:distributed-trust ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:account-abstraction,
        ngm:hardware-security-module,
        ngm:multi-party-computation,
        ngm:multi-sig-governance,
        ngm:secret-sharing ;
    vc:requires ngm:private-key,
        ngm:public-key-infrastructure,
        ngm:quorum-threshold ;
    vc:slug "multisignature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signatures,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:key-management,
        ngm:schnorr-signature,
        ngm:threshold-cryptography .

ngm:nearest-neighbor-search a owl:Class ;
    rdfs:label "Nearest Neighbor Search"@en ;
    rdfs:comment "Nearest Neighbor Search (NNS) is an algorithmic problem and family of techniques for finding the point(s) in a dataset most similar to a given query point, as measured by a distance or similarity metric such as Euclidean distance, cosine similarity, or inner product. Exact NNS guarantees retrieval of the true closest point but scales poorly in high dimensions, while Approximate Nearest Neighbor (ANN) methods trade a bounded loss in recall for dramatically faster query latency and memory efficiency. Foundational index structures — including KD-Trees, Ball Trees, Locality-Sensitive Hashing, Inverted File Indexes, and Hierarchical Navigable Small World graphs — each make different trade-offs between construction cost, query speed, recall, and support for dynamic updates. NNS is a core primitive of modern machine learning pipelines, powering vector database retrieval, recommendation systems, semantic search, image recognition, and retrieval-augmented generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hnsw-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverted-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distance-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:locality-sensitive-hashing ],
        ngm:search-algorithm ;
    vc:bridgesTo ngm:knowledge-graph-embedding,
        ngm:spatial-index ;
    vc:contrastsWith ngm:keyword-search ;
    vc:dependsOn ngm:embedding-model,
        ngm:vector-database ;
    vc:enables ngm:image-retrieval,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hnsw-index,
        ngm:inverted-index,
        ngm:locality-sensitive-hashing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dimensionality-reduction,
        ngm:faiss,
        ngm:quantisation ;
    vc:requires ngm:distance-metric,
        ngm:vector-embedding ;
    vc:slug "nearest-neighbor-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cosine-similarity,
        ngm:euclidean-distance,
        ngm:kd-tree .

ngm:network-architecture a owl:Class ;
    rdfs:label "Network Architecture"@en ;
    rdfs:comment "The structural design of a neural network, specifying the arrangement of layers, connection patterns, activation functions, skip connections, normalisation methods, and attention mechanisms. Key architectures include feedforward networks, CNNs, RNNs, transformers, and graph neural networks; Neural Architecture Search automates discovery of optimal configurations for accuracy, efficiency, and hardware constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
