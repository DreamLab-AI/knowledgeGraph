ngm:slashing a owl:Class ;
    rdfs:label "Slashing"@en ;
    rdfs:comment "Slashing is an automated penalty mechanism in proof-of-stake and delegated proof-of-stake blockchain networks that permanently destroys or confiscates a portion of a validator's bonded stake when that validator commits a provably attributable protocol violation, such as double-signing conflicting blocks or surround voting. The mechanism converts the cost of Byzantine behaviour into a concrete financial loss, aligning validator incentives with honest participation and securing the network's economic finality. Slashing conditions and penalty magnitudes are encoded in the consensus rules of each network and are adjudicated deterministically by all full nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:game-theory,
        ngm:incentive-alignment,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:inactivity-leak,
        ngm:proof-of-work ;
    vc:dependsOn ngm:cryptographic-proof,
        ngm:smart-contract ;
    vc:enables ngm:byzantine-fault-tolerance,
        ngm:economic-finality,
        ngm:validator-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-security,
        ngm:proof-of-stake ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:attestation,
        ngm:block-production,
        ngm:delegated-proof-of-stake,
        ngm:governance-token,
        ngm:network-security,
        ngm:unbonding-period ;
    vc:requires ngm:bonded-stake,
        ngm:equivocation-detection,
        ngm:staking,
        ngm:validator ;
    vc:slug "slashing" ;
    vc:sourceDomain "blockchain" .

ngm:slot-filling a owl:Class ;
    rdfs:label "Slot Filling"@en ;
    rdfs:comment "Slot filling is a natural language processing task in which a system extracts and populates predefined semantic fields (slots) from user utterances within a task-oriented dialogue context, enabling the system to gather the structured information required to fulfil a user request. It operates alongside intent classification to transform free-form text into actionable structured representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        ngm:information-extraction ;
    vc:enables ngm:conversational-ai,
        ngm:dialogue-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dialogue-state-tracking,
        ngm:natural-language-understanding ;
    vc:requires ngm:intent-classification,
        ngm:named-entity-recognition ;
    vc:slug "slot-filling" ;
    vc:sourceDomain "ai" .

ngm:social-contract a owl:Class ;
    rdfs:label "Social Contract"@en ;
    rdfs:comment "A philosophical and political theory positing that individuals consent, either explicitly or tacitly, to surrender certain freedoms and submit to authority in exchange for protection of their remaining rights and maintenance of social order."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:civil-society,
