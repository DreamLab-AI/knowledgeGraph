ngm:virtual-background a owl:Class ;
    rdfs:comment "A Virtual Background is a real-time image or video composited behind a video-call participant using chroma-key or AI-based background segmentation, replacing the physical environment visible to the camera. It allows remote workers to project a professional or branded appearance regardless of their physical location, protecting privacy and maintaining visual consistency across distributed teams. Virtual backgrounds are natively supported in Zoom, Microsoft Teams, and Google Meet."@en ;
    rdfs:label "Virtual Background"@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
