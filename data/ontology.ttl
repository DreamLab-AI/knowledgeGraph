    vc:slug "storytelling" ;
    vc:sourceDomain "spatial-computing" .

ngm:strategic-planning a owl:Class ;
    rdfs:label "Strategic Planning"@en ;
    rdfs:comment "Strategic Planning is an organisational process for defining long-term direction, priorities, and resource allocation to achieve goals within a given domain. In spatial computing and metaverse contexts, it encompasses technology roadmaps, governance design, and stakeholder alignment for platform development."@en ;
