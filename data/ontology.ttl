    vc:slug "global-inequality" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:sustainable-development-goals ;
    vc:supports ngm:ai-governance,
        ngm:financial-inclusion,
        ngm:just-transition,
        ngm:sustainable-development-goals ;
    vc:uses ngm:human-development-index,
        ngm:world-inequality-database .

ngm:governance-layer a owl:Class ;
    rdfs:label "Governance Layer"@en ;
    rdfs:comment "The Governance Layer is the cross-cutting stratum where human and institutional intent over a system is decided, recorded, and amended. It sits above the Policy Layer, which it parameterises, and draws on identity and economic structures to allocate decision rights. It contains decision processes, voting mechanisms, charters, and the records of who may change what."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-layer ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:compliance-layer,
        ngm:institutional-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:identity-layer,
        ngm:policy-layer ;
    vc:slug "governance-layer" ;
    vc:sourceDomain "governance" .

ngm:governance-proposal a owl:Class ;
    rdfs:label "Governance Proposal"@en ;
    rdfs:comment "A governance proposal is a formally submitted, votable item that requests a change to a decentralised protocol, treasury allocation or organisational parameter, typically within a DAO. It encapsulates a description, an executable payload or off-chain intent, and voting parameters such as quorum and threshold. Token holders or delegates vote on the proposal, and on approval it may be executed automatically by smart contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:on-chain-governance ;
    vc:dependsOn ngm:ethereum,
        ngm:smart-contract ;
    vc:enables ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:quorum,
        ngm:smart-contract ;
    vc:implements ngm:on-chain-governance ;
    vc:isPartOf ngm:dao,
        ngm:on-chain-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance-framework,
        ngm:voting ;
    vc:requires ngm:governance-token,
        ngm:voting ;
    vc:slug "governance-proposal" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:dao ;
    vc:uses ngm:delegation,
        ngm:snapshot .

ngm:gpu-resources a owl:Class ;
    rdfs:label "GPU Resources"@en ;
    rdfs:comment "GPU resources refer to the pool of graphics processing unit capacity — including VRAM, streaming multiprocessors, tensor cores, and associated interconnect bandwidth — that is provisioned, allocated, and managed as a computational resource for parallel workloads such as AI model training and inference, scientific simulation, computer graphics rendering, and high-performance computing. In cloud and data centre contexts, GPU resources are typically accessed through virtualisation or direct hardware passthrough, managed by schedulers that partition capacity across competing workloads and billed on per-hour or per-token consumption models."@en ;
    rdfs:subClassOf ngm:compute-resources ;
    vc:enables ngm:computer-graphics,
        ngm:gpu-computing,
        ngm:large-scale-compute ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:edge-ai-accelerator,
        ngm:gpu-compute,
        ngm:inference-hardware ;
    vc:slug "gpu-resources" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compute-shader,
        ngm:cuda,
        ngm:hardware-acceleration .

ngm:graph-embedding a owl:Class ;
    rdfs:label "Graph Embedding"@en ;
    rdfs:comment "Graph embedding is a family of representation-learning techniques that map the nodes, edges, or whole subgraphs of a graph into a continuous low-dimensional vector space while preserving structural and relational properties. The learned vectors place topologically or semantically similar elements close together, enabling machine-learning models to operate on graph-structured data. Methods range from random-walk approaches to neural graph encoders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding ],
        ngm:representation-learning ;
    vc:contrastsWith ngm:dimensionality-reduction ;
    vc:dependsOn ngm:representation-learning ;
    vc:enables ngm:link-prediction,
        ngm:node-classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding,
        ngm:random-walk ;
    vc:implements ngm:dimensionality-reduction ;
    vc:isPartOf ngm:network-analysis ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:knowledge-graph-embedding,
        ngm:word-embedding ;
    vc:slug "graph-embedding" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:network-analysis ;
    vc:uses ngm:graph-neural-network,
        ngm:random-walk .

ngm:greenwashing a owl:Class ;
    rdfs:label "Greenwashing"@en ;
    rdfs:comment "Greenwashing is the practice of making misleading, exaggerated, or unsubstantiated claims about the environmental or sustainability credentials of a product, service, organisation, or financial instrument in order to gain reputational, commercial, or regulatory advantage. It encompasses both deliberate deception and negligent miscommunication, ranging from vague marketing language ('eco-friendly', 'carbon neutral') to selective disclosure that conceals material environmental harms. Greenwashing undermines the integrity of sustainability frameworks, distorts capital allocation in ESG finance, and erodes public trust in genuine environmental initiatives. Regulatory bodies worldwide are introducing mandatory disclosure regimes, verification standards, and enforcement mechanisms to combat it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-certification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        ngm:sustainability ;
    vc:bridgesTo ngm:data-analytics,
        ngm:natural-language-processing,
        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:carbon-neutrality,
        ngm:esg-reporting,
        ngm:sustainable-development ;
    vc:dependsOn ngm:advertising-and-marketing,
        ngm:information-asymmetry ;
    vc:enables ngm:green-finance,
        ngm:regulatory-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:corporate-social-responsibility,
        ngm:energy-consumption,
        ngm:environmental-disclosure,
        ngm:regulatory-compliance,
        ngm:reputational-risk,
        ngm:sustainability-reporting ;
    vc:requires ngm:audit,
        ngm:third-party-certification ;
    vc:slug "greenwashing" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eu-green-claims-directive,
        ngm:iso .

ngm:gri-standards a owl:Class ;
    rdfs:label "GRI Standards"@en ;
    rdfs:comment "The GRI Standards are a globally adopted framework published by the Global Reporting Initiative for organisations to disclose their economic, environmental, and social impacts. They provide a modular set of universal, sector, and topic standards that standardise sustainability and ESG reporting for comparability across firms. Widely referenced by regulators and investors, they form a backbone of corporate non-financial disclosure."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:ethical-sourcing ;
    vc:slug "gri-standards" ;
    vc:sourceDomain "governance" .

ngm:grid-infrastructure a owl:Class ;
    rdfs:label "Grid Infrastructure"@en ;
    rdfs:comment "Grid infrastructure is the physical and control system of generation, transmission, distribution, and balancing assets that delivers electrical power from sources to consumers. It includes substations, transmission lines, transformers, and increasingly digital control layers for monitoring and demand response. Reliable grid infrastructure is a prerequisite for energy-intensive computing, mining, and data-centre operations."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "grid-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:h-264 a owl:Class ;
    rdfs:label "H.264"@en ;
    rdfs:comment "H.264, also known as AVC (Advanced Video Coding) or MPEG-4 Part 10, is a block-oriented, motion-compensated video compression standard jointly developed by the ITU-T and ISO/IEC and finalised in 2003. It achieves substantially better compression efficiency than its predecessors through advanced intra and inter prediction, variable block-size motion compensation, an in-loop deblocking filter, and context-adaptive entropy coding. For two decades it has been the most widely deployed video codec, used in streaming, broadcast, Blu-ray, video conferencing, and surveillance, with broad hardware acceleration."@en ;
    rdfs:subClassOf ngm:video-codec ;
    vc:enables ngm:video-encoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:technical-standard ;
    vc:slug "h-264" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:video-compression .

ngm:haptic-feedback-telepresence a owl:Class ;
    rdfs:label "Haptic Feedback Telepresence"@en ;
    rdfs:comment "Haptic Feedback Telepresence is the integration of tactile and kinesthetic feedback devices — such as force-feedback gloves, exoskeletons, and haptic controllers — into telepresence systems, enabling bidirectional touch sensation between a remote operator and a distant physical or virtual environment. It closes the sensorimotor loop beyond visual and auditory channels, allowing operators to feel forces, textures, weight, and vibration, which significantly enhances manipulation precision and immersive presence in teleoperation, surgical robotics, and VR collaboration contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:teleoperation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:guaranteed-bandwidth ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:bridgesTo ngm:haptic-feedback ;
    vc:enables ngm:immersive-communication,
        ngm:robotic-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:telecollaboration-and-telepresence,
        ngm:telepresence ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:tele-001-telepresence,
        ngm:virtual-environment ;
    vc:requires ngm:guaranteed-bandwidth,
        ngm:teleoperation ;
    vc:slug "haptic-feedback-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:exoskeleton-robot,
        ngm:haptics,
        ngm:sensor-fusion,
        ngm:tactile-sensor .

ngm:head-related-transfer-function a owl:Class ;
    rdfs:label "Head Related Transfer Function"@en ;
    rdfs:comment "A head-related transfer function (HRTF) describes how sound from a point in space is filtered by the listener's head, torso and outer ears before reaching each eardrum. It captures the frequency-dependent level, time and spectral cues that the auditory system uses to localise sound. Convolving a mono source with the appropriate left and right HRTFs synthesises a convincing three-dimensional position over headphones, making the HRTF the mathematical core of binaural and spatial audio rendering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processor ],
        ngm:spatial-audio ;
    vc:enables ngm:binaural-audio,
        ngm:immersive-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:spatial-audio ;
    vc:isPartOf ngm:spatial-audio ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audio-system,
        ngm:microphone-array ;
    vc:requires ngm:digital-signal-processor ;
    vc:slug "head-related-transfer-function" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ambisonics,
        ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:uses ngm:digital-signal-processing,
        ngm:signal-processing .

ngm:health-monitoring a owl:Class ;
    rdfs:label "Health Monitoring"@en ;
    rdfs:comment "Health monitoring is the continuous observation of a system's components, services, and dependencies to determine whether they are operating correctly and are able to serve requests. It uses signals such as heartbeats, readiness and liveness probes, resource metrics, and synthetic checks to produce a real-time view of system health. Health monitoring underpins high availability by enabling automated detection of failures and triggering recovery, failover, or load redistribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alerting ],
        ngm:observability ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting,
        ngm:metrics,
        ngm:telemetry ;
    vc:isPartOf ngm:monitoring,
        ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
