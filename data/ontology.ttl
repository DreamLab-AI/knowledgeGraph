        ngm:smart-contract .

ngm:site-reliability-engineering a owl:Class ;
    rdfs:label "Site Reliability Engineering"@en ;
    rdfs:comment "Site Reliability Engineering (SRE) is a discipline that applies software engineering principles and practices to operations work, treating infrastructure management and service reliability as software problems to be solved through automation, measurement, and iterative improvement. Originating at Google in the early 2000s, SRE defines explicit reliability targets via Service Level Objectives, manages risk through error budgets, and uses observability tooling to maintain confidence in production systems. SRE practitioners reduce operational toil through systematic automation, implement incident management processes, and balance the competing demands of feature velocity and system stability. The discipline formalises the role of the operations engineer as a software engineer who designs for reliability, scalability, and maintainability from the outset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-level-objective ],
        ngm:reliability-engineering ;
    vc:bridgesTo ngm:aiops,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:devops,
        ngm:itil ;
    vc:dependsOn ngm:distributed-systems,
        ngm:software-engineering ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:service-level-objective ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:kubernetes,
        ngm:platform-engineering,
        ngm:service-mesh ;
    vc:requires ngm:incident-management,
        ngm:monitoring,
        ngm:observability ;
    vc:slug "site-reliability-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:chaos-engineering,
        ngm:continuous-deployment,
        ngm:distributed-tracing,
        ngm:infrastructure-as-code .

ngm:speculative-decoding a owl:Class ;
    rdfs:label "Speculative Decoding"@en ;
    rdfs:comment "Speculative decoding is an inference acceleration technique for autoregressive language models in which a smaller, faster draft model proposes multiple candidate tokens that a larger target model verifies in a single parallel forward pass. Accepted tokens are committed to the output sequence; rejected tokens trigger a corrected sample from the residual distribution, ensuring the final output is statistically identical to sampling from the target model alone. Because modern GPU accelerators are memory-bandwidth-bound during autoregressive generation, batching verification of several candidate tokens substantially increases arithmetic utilisation and can raise effective throughput two to four times without altering the model's output distribution. The technique is now integrated into mainstream inference frameworks and sits at the intersection of model efficiency, hardware utilisation, and production LLM serving."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rejection-sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:edge-ai,
        ngm:real-time-systems ;
    vc:contrastsWith ngm:autoregressive-decoding,
        ngm:beam-search,
        ngm:greedy-decoding ;
    vc:dependsOn ngm:parallel-computing ;
    vc:enables ngm:low-latency-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rejection-sampling ;
    vc:implements ngm:rejection-sampling ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:continuous-batching,
        ngm:knowledge-distillation,
        ngm:model-compression-for-edge,
        ngm:neural-network-quantisation,
        ngm:sampling ;
    vc:requires ngm:inference-hardware ;
    vc:slug "speculative-decoding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:autoregressive-generation,
        ngm:kv-cache,
        ngm:large-language-models,
        ngm:transformer-architecture .

ngm:supervised-fine-tuning a owl:Class ;
    rdfs:label "Supervised Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that uses labelled training data to adapt a pre-trained model to specific tasks, optimising performance through supervised learning on input-output pairs. Supervised fine-tuning (SFT) represents the most direct path from general pre-training to task-specific capability, and serves as the foundational first stage in multi-stage alignment pipelines such as InstructGPT and Constitutional AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
