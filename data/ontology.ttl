ngm:asynchronous-communication a owl:Class ;
    rdfs:label "Asynchronous Communication"@en ;
    rdfs:comment "A communication paradigm in which message senders and receivers do not interact in real-time; messages are queued, buffered, or stored so that the sender continues processing without blocking until the recipient acknowledges or responds, enabling decoupled, resilient distributed systems."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
