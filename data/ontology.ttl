        ngm:immutability,
        ngm:merkle-tree,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:256-bit-digest ;
    vc:isPartOf ngm:sha-2-family ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:hmac,
        ngm:merkle-proof,
        ngm:preimage-resistance,
        ngm:public-key ;
    vc:requires ngm:compression-function ;
    vc:slug "sha-256" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fips-180-4,
        ngm:nist ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:merkle-damgard-construction .

ngm:software-development a owl:Class ;
    rdfs:label "Software Development"@en ;
    rdfs:comment "Software development is the disciplined engineering practice of conceiving, specifying, designing, implementing, testing, deploying, and maintaining software systems through the coordinated application of programming languages, tooling, architectural patterns, and collaborative process frameworks. It encompasses the full software lifecycle — from requirements elicitation and system design through iterative coding, automated testing, continuous integration and delivery, and production operations — governed by methodologies such as Agile, Scrum, DevOps, and lean software development. The discipline has evolved from monolithic waterfall processes into fast-cycle, AI-augmented workflows in which developer tooling, cloud-native infrastructure, and open-source ecosystems are inseparable components of production capability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:code-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:programming-paradigm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:software-engineering ;
