ngm:single-agent-system a owl:Class ;
    rdfs:comment "An architectural pattern in which one autonomous agent, equipped with its own model, memory, and tool access, carries an entire task from goal to completion within a single reasoning loop — with no delegation, inter-agent messaging, or coordination overhead; simpler to build, debug, and evaluate than multi-agent designs, and often the stronger baseline when a capable model with good tools can hold the whole problem in context."@en ;
    rdfs:label "Single-Agent System"@en ;
    rdfs:subClassOf ngm:architecture ;
