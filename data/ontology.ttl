            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-evaluation ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:ai-safety,
        ngm:data-governance ;
    vc:contrastsWith ngm:reinforcement-learning,
        ngm:semi-supervised-learning,
        ngm:unsupervised-learning ;
    vc:enables ngm:computer-vision,
        ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:predictive-modelling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:classification,
        ngm:model-evaluation,
        ngm:regression ;
    vc:implements ngm:decision-tree,
        ngm:neural-network,
        ngm:support-vector-machine ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:overfitting ;
    vc:requires ngm:feature-engineering,
        ngm:labeled-dataset,
        ngm:loss-function,
        ngm:training-data ;
    vc:slug "supervised-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation,
        ngm:cross-validation,
        ngm:gradient-descent,
        ngm:regularisation .

ngm:tokenisation a skos:Concept ;
