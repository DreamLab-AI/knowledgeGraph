ngm:litecoin a owl:Class ;
    rdfs:label "Litecoin"@en ;
    rdfs:comment "Litecoin is a peer-to-peer cryptocurrency created in 2011 by Charlie Lee as an early fork of the Bitcoin codebase. It was designed for faster confirmation, using a target block time of around 2.5 minutes, and it uses the Scrypt hashing algorithm for proof-of-work in place of Bitcoin's SHA-256. It is often described as a lighter complement to Bitcoin and has served as a testing ground for protocol changes such as Segregated Witness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:payment-network ;
    vc:contrastsWith ngm:bitcoin,
        ngm:bitcoin-proof-of-work-protocol-cash,
        ngm:ethereum ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:mining ;
    vc:enables ngm:cross-border-transactions,
        ngm:digital-payments,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fixed-supply-schedule,
        ngm:segregated-witness,
        ngm:utxo-model ;
    vc:isPartOf ngm:cryptocurrency ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency ;
    vc:requires ngm:blockchain-node,
        ngm:peer-to-peer-network,
        ngm:proof-of-work,
        ngm:scrypt ;
    vc:slug "litecoin" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:atomic-swap,
        ngm:lightning-network ;
    vc:uses ngm:digital-signature,
        ngm:merkle-tree,
        ngm:sha-256 .

ngm:llm-application-frameworks a owl:Class ;
    rdfs:label "LLM Application Frameworks"@en ;
    rdfs:comment "General-purpose software frameworks for composing [[Large Language Models]] capabilities into production applications through chains, retrievers, [[Tool Use]], [[Retrieval-Augmented Generation]] pipelines, stateful workflows, and [[Multi-Agent Systems]] orchestration — including LangChain, LangGraph, LlamaIndex, Semantic Kernel, Microsoft Agent Framework, Mastra, Agno, n8n, Dify, Langflow, and Flowise — providing the integration, observability, and deployment infrastructure that connects model inference to real application data, external APIs, and human approval workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:function-calling ],
        [ a owl:Restriction ;
