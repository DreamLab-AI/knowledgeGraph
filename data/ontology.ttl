            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        ngm:infra-security-and-identity ;
