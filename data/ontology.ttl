] .

mv:ProvenanceStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:NFTVerification
] .

mv:ProvenanceStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
