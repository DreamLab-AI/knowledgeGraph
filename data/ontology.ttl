    vc:sourceDomain "artificial-intelligence" .

ngm:ai-safety-research a owl:Class ;
    rdfs:label "AI Safety Research"@en ;
    rdfs:comment "AI Safety Research is an interdisciplinary field that develops theoretical frameworks, empirical methods, and engineering techniques to ensure advanced AI systems behave in ways that are safe, reliable, and aligned with human values across a range of capability levels. The field spans near-term concerns — such as robustness, fairness, and adversarial resistance — and longer-term challenges including scalable oversight, corrigibility, and the avoidance of catastrophic risks from highly capable systems. It draws on machine learning, decision theory, formal verification, and cognitive science to produce both immediately deployable safety interventions and foundational understanding of how intelligent systems can be made reliably beneficial."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robustness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:cognitive-science ;
    vc:contrastsWith ngm:ai-capabilities-research ;
    vc:enables ngm:ai-alignment,
        ngm:corrigibility,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-risk,
        ngm:existential-risk,
        ngm:fairness-in-machine-learning,
        ngm:mechanistic-interpretability,
        ngm:scalable-oversight ;
    vc:requires ngm:decision-theory,
        ngm:machine-learning,
        ngm:robustness ;
    vc:slug "ai-safety-research" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-policy,
        ngm:ai-regulation,
        ngm:model-evaluation ;
    vc:uses ngm:formal-verification,
        ngm:interpretability,
        ngm:red-teaming,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:uncertainty-quantification .

ngm:autonomous-driving a owl:Class ;
    rdfs:label "Autonomous Driving"@en ;
    rdfs:comment "Autonomous driving is the technical capability enabling a vehicle to perceive its environment, predict the behaviour of surrounding agents, plan a safe trajectory, and execute actuator commands without direct human intervention. The system architecture decomposes into perception (camera, Lidar, radar fusion), localisation (HD map matching, SLAM), prediction (probabilistic motion modelling), planning (route, behaviour, and motion planning layers), and control (longitudinal and lateral actuation). Safety assurance draws on formal verification, simulation, and real-world validation mileage, with regulatory oversight governed by frameworks such as SAE J3016, ISO 26262, and UN ECE WP.29. The field bridges robotics, machine learning, embedded systems, and transport infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simultaneous-localisation-and-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:5g-networks,
        ngm:digital-twin,
        ngm:smart-city-infrastructure ;
    vc:contrastsWith ngm:advanced-driver-assistance-systems,
        ngm:teleoperation ;
    vc:dependsOn ngm:edge-computing,
        ngm:gnss,
        ngm:v2x-communication ;
    vc:enables ngm:autonomous-vehicle,
        ngm:last-mile-delivery,
        ngm:robotaxi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:motion-planning,
        ngm:robotics,
        ngm:safety-critical-systems ;
    vc:requires ngm:computer-vision,
        ngm:hd-maps,
        ngm:lidar,
        ngm:object-detection,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "autonomous-driving" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-26262,
        ngm:sae-j3016,
        ngm:un-ece-wp29 ;
    vc:uses ngm:convolutional-neural-network,
