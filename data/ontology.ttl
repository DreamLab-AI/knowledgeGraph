    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Zero Knowledge
spatial-computing:ZeroKnowledge rdf:type owl:Class ;
    rdfs:label "Zero Knowledge"@en ;
    rdfs:comment "Zero-knowledge proofs are cryptographic techniques enabling one party to prove knowledge of information to another without revealing the information itself, establishing mathematical certainty about claim validity through InteractiveProtocol or NIZKProof. ZKProofSystems like zkSNARK and zkSTARK enable privacy-preserving authentication, PrivacyCoin, and ZKRollup that compress on-chain computation whilst maintaining verifiable correctness, critical for balancing transparency requirements against user privacy. Practical applications span BlockchainScalability, VerifiableComputation, and SelectiveDisclosure systems enabling users to prove attributes (age, creditworthiness, citizenship) without revealing underlying personal data."@en ;
    skos:prefLabel "Zero Knowledge"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:zero-knowledge" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:zero-knowledge> ;
    vcw:contentHash "sha256-12-6aacfea07ab6" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3041" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3041" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Virtual Machine
spatial-computing:VirtualMachine rdf:type owl:Class ;
    rdfs:label "Virtual Machine"@en ;
    rdfs:comment "A virtual machine in blockchain contexts is a runtime environment executing SmartContract deterministically, translating high-level contract code into low-level operations whilst enforcing resource limits and preventing unauthorised state modifications. The EVM dominates as the reference implementation, executing Solidity bytecode across thousands of nodes globally, with alternatives including WASM-based SolanaSVM, MoveVM, and CairoVM providing specialised optimisations for specific use cases. Deterministic execution is paramount—identical contract invocations across decentralised networks must produce identical results, enabling consensus formation without relying on centralised authorities."@en ;
    skos:prefLabel "Virtual Machine"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-machine" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-machine> ;
    vcw:contentHash "sha256-12-b68663c1e455" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3042" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3042" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Cross Chain Bridge
spatial-computing:CrossChainBridge rdf:type owl:Class ;
    rdfs:label "Cross Chain Bridge"@en ;
    rdfs:comment "Protocol enabling transfer of assets and messages between separate blockchain networks, converting representations across different consensus mechanisms and ledger formats. These Bridge Protocols facilitate Interoperability, reduce Liquidity Fragmentation, and enable Cross Chain Transactions."@en ;
    skos:prefLabel "Cross Chain Bridge"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:cross-chain-bridge" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:cross-chain-bridge> ;
    vcw:contentHash "sha256-12-80f8852917d0" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3043" ;
