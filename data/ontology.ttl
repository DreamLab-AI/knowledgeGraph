            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-software ],
        ngm:infrastructure-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-platform-connectivity,
        ngm:distributed-computing,
        ngm:low-latency-interaction,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:communication-software,
        ngm:data-transmission-service,
        ngm:network-protocol,
        ngm:routing-infrastructure ;
    vc:isPartOf ngm:infrastructure-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:communication-protocol,
