ngm:ai-risk-assessment a owl:Class ;
    rdfs:label "AI Risk Assessment"@en ;
    rdfs:comment "A structured methodology for identifying, analysing, and evaluating the potential harms, failure modes, and adverse societal impacts arising from the development and deployment of artificial intelligence systems. It applies established risk management frameworks to the distinctive properties of AI—opacity, emergent behaviour, data dependency, and scalability—to produce actionable risk registers and mitigation plans. The process informs governance decisions and regulatory compliance across the full AI system lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-documentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-system ],
        ngm:risk-assessment ;
    vc:bridgesTo ngm:cybersecurity-risk-assessment,
        ngm:enterprise-risk-management ;
    vc:enables ngm:ai-governance-framework,
        ngm:ai-risk-management,
        ngm:regulatory-compliance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:failure-mode-analysis ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:ai-safety,
        ngm:algorithmic-bias ;
    vc:requires ngm:ai-system,
        ngm:model-documentation ;
    vc:slug "ai-risk-assessment" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument,
        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:uses ngm:adversarial-testing,
        ngm:ai-model-card,
        ngm:ai-risk-register,
        ngm:red-teaming,
        ngm:threat-modelling .

ngm:ai-system a owl:Class ;
    rdfs:label "AI System"@en ;
    rdfs:comment "An integrated assembly of software, hardware, data, and processes that employs machine learning or related techniques to perceive inputs, infer patterns or decisions, and produce outputs that affect its environment or users. AI systems range from narrow task-specific classifiers to general-purpose language models and autonomous agents, and they are characterised by behaviour that emerges from learned parameters rather than explicit programming. Regulatory definitions such as that codified in the EU AI Act emphasise the system-level perspective, encompassing the full sociotechnical context of deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
