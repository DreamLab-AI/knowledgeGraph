        ngm:data-catalog,
        ngm:data-integration-service,
        ngm:data-virtualization,
        ngm:governance-framework,
        ngm:metadata-management ;
    vc:isPartOf ngm:data-management,
        ngm:enterprise-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:api-gateway,
        ngm:data-schema,
