    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# security audit guide
spatial-computing:securityauditguide rdf:type owl:Class ;
    rdfs:label "security audit guide"@en ;
    rdfs:comment "A comprehensive procedural guide establishing standards, methodologies, and frameworks for conducting security audits of Blockchain, SmartContract, and Cryptography. This guide enables systematic vulnerability assessment and security control evaluation."@en ;
