ngm:gpu-acceleration a owl:Class ;
    rdfs:label "GPU Acceleration"@en ;
    rdfs:comment "GPU Acceleration is the use of graphics processing units to perform general-purpose computational workloads in a massively parallel fashion, exploiting thousands of shader cores arranged in a single-instruction-multiple-data (SIMD) architecture to achieve throughput orders of magnitude beyond conventional CPUs for data-parallel tasks such as matrix multiplication and tensor contraction. It is the dominant execution paradigm for training and inference in modern deep learning, scientific simulation, and real-time rendering pipelines. The programming model is exposed through vendor APIs such as CUDA and ROCm, as well as cross-platform standards including OpenCL and SYCL. Hierarchical parallelism — threads grouped into warps, warps into thread blocks, blocks into grids dispatched across streaming multiprocessors — enables fine-grained exploitation of data parallelism at every level of the memory hierarchy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:hardware-acceleration ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:cpu-computing,
        ngm:neuromorphic-computing,
        ngm:tensor-processing-unit ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:memory-bandwidth,
        ngm:pcie-interconnect ;
    vc:enables ngm:deep-learning,
        ngm:inference,
        ngm:large-language-model,
        ngm:real-time-ray-tracing,
        ngm:scientific-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:high-bandwidth-memory,
        ngm:streaming-multiprocessor,
        ngm:tensor-core ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:gpu-computing,
        ngm:quantisation ;
    vc:requires ngm:cuda,
        ngm:gpu-driver,
        ngm:parallel-programming-model ;
    vc:slug "gpu-acceleration" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-parallelism,
        ngm:inference-serving,
        ngm:model-parallelism,
        ngm:neural-network-training ;
    vc:uses ngm:compute-shader,
        ngm:cuda,
        ngm:mixed-precision-training,
        ngm:opencl .

ngm:gpu-cluster a owl:Class ;
    rdfs:label "GPU Cluster"@en ;
    rdfs:comment "A GPU cluster is a group of interconnected computers each equipped with graphics processing units, used together for parallel computation. Such clusters are central to training large AI models and high-performance computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
