ngm:icvcm-framework a owl:Class ;
    rdfs:label "ICVCM Framework"@en ;
    rdfs:comment "The ICVCM Framework is the governance framework established by the Integrity Council for the Voluntary Carbon Market to set quality benchmarks for carbon credits. Centred on the Core Carbon Principles and an associated Assessment Framework, it defines criteria for additionality, permanence, robust quantification, and transparent governance. The framework aims to restore trust and comparability across voluntary carbon-credit issuers."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:icvcm-core-carbon-principles ;
    vc:slug "icvcm-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:green-blockchain-initiatives .

ngm:ide-coding-agents a owl:Class ;
    rdfs:label "IDE Coding Agents"@en ;
    rdfs:comment "AI coding agents embedded within integrated development environments as extensions or sidebars, implementing plan-then-act loops with approval gates and cost transparency, enabling autonomous multi-step software development from within the developer's primary workspace — includes Cline, Kilo Code (successor to Roo Code), OpenHands, and claw-code-agent."@en ;
