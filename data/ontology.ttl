        ngm:market-microstructure,
        ngm:price-discovery ;
    vc:requires ngm:liquidity,
        ngm:order-book ;
    vc:slug "bid-ask-spread" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:order-book .

ngm:bip39 a owl:Class ;
    rdfs:label "BIP-39"@en ;
    rdfs:comment "BIP-39 is a Bitcoin Improvement Proposal that defines how to encode wallet entropy as a human-readable mnemonic seed phrase and how to derive a binary seed from it. It maps random entropy plus a checksum onto words drawn from a fixed wordlist, then stretches the phrase and an optional passphrase into a seed via a key derivation function. The resulting seed feeds hierarchical deterministic wallets, making secrets easier to back up and transcribe."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        ngm:seed-phrase ;
    vc:dependsOn ngm:private-key ;
    vc:enables ngm:hierarchical-deterministic-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:key-derivation-function,
        ngm:seed-phrase ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:elliptic-curve-cryptography,
        ngm:wallet ;
    vc:requires ngm:entropy,
        ngm:hash-function ;
    vc:slug "bip39" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cryptocurrency-wallet,
        ngm:hardware-wallet ;
    vc:uses ngm:key-derivation-function .

ngm:bis-innovation-hub a owl:Class ;
