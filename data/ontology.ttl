ngm:digital-payment-system a owl:Class ;
    rdfs:label "Digital Payment System"@en ;
    rdfs:comment "The integrated infrastructure of protocols, platforms, and financial instruments enabling secure monetary transactions, encompassing cryptocurrency payments, stablecoin transfers, fiat gateways, smart contract-based payment automation, and regulated payment rails for both physical and virtual commerce."@en ;
