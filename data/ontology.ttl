ngm:unity a owl:Class ;
    rdfs:label "Unity"@en ;
    rdfs:comment "Unity is a cross-platform real-time 3D engine and editor used to build games, simulations and XR applications across desktop, mobile, console and head-mounted display targets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
