ngm:topological-map a owl:Class ;
    rdfs:label "Topological Map"@en ;
    rdfs:comment "[[Topological Map]] is a graph-structured spatial abstraction used in [[Mobile Robot Navigation]] and [[Autonomous Navigation]], representing environments as discrete nodes (places, waypoints, landmarks) connected by edges (traversable paths, transitions) rather than storing explicit metric coord..."@en ;
    rdfs:subClassOf ngm:cognitive-map,
        ngm:mobile-robot-navigation ;
    vc:enables ngm:human-robot-interaction,
        ngm:lifelong-mapping,
        ngm:long-range-navigation,
        ngm:multi-robot-systems,
        ngm:path-planning,
        ngm:semantic-navigation ;
    vc:hasPart ngm:graph-optimiser,
        ngm:loop-closure-detection,
        ngm:place-node,
        ngm:place-recognition-module,
        ngm:pose-graph,
        ngm:semantic-label,
        ngm:transition-edge ;
    vc:implements ngm:fab-map,
        ngm:pose-graph,
        ngm:rtab-map,
        ngm:spatial-semantic-hierarchy,
        ngm:visual-place-recognition ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:scene-understanding,
        ngm:simultaneous-localisation-and-mapping,
        ngm:spatial-cognition,
        ngm:visual-odometry ;
    vc:requires ngm:feature-extraction,
        ngm:graph-representation,
        ngm:loop-closure-detection,
        ngm:odometry,
        ngm:visual-place-recognition ;
    vc:slug "topological-map" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee-ras,
        ngm:open-slam,
        ngm:ros-navigation-stack ;
    vc:supports ngm:assistive-robotics,
        ngm:autonomous-navigation,
        ngm:search-and-rescue-robotics,
        ngm:service-robots,
        ngm:warehouse-robotics ;
    vc:uses ngm:bag-of-words-model,
        ngm:bundle-adjustment,
        ngm:convolutional-neural-networks,
        ngm:graph-neural-networks,
        ngm:ransac .

