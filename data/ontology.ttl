ngm:iso-iec-9075 a owl:Class ;
    rdfs:label "ISO/IEC 9075 SQL Standard"@en ;
    rdfs:comment "ISO/IEC 9075 is the international standard that defines SQL, the Structured Query Language used to define, query and manipulate data in relational database systems. Published jointly by ISO and IEC and revised across multiple editions, it specifies the language's data model, syntax, semantics and conformance levels through a series of parts covering the core framework, foundation, call-level interface and extensions such as JSON and property-graph queries. It provides the common reference that lets relational databases interoperate and that vendors extend with proprietary dialects."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:enables ngm:database-system,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:sql ;
    vc:isPartOf ngm:data-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:centralised-database,
        ngm:data-layer,
        ngm:data-management,
        ngm:database-systems ;
    vc:slug "iso-iec-9075" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso ;
    vc:supports ngm:data-integrity,
        ngm:database-query,
        ngm:relational-database .

ngm:join-semilattice a owl:Class ;
    rdfs:label "Join-Semilattice"@en ;
    rdfs:comment "A join-semilattice is a partially ordered set in which every pair of elements has a least upper bound (join), making the join operation associative, commutative and idempotent. These algebraic properties guarantee that repeated or reordered merges converge to a unique value. The structure is the mathematical foundation for state-based conflict-free replicated data types."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "join-semilattice" ;
    vc:sourceDomain "data" .

ngm:joint-encoder a owl:Class ;
    rdfs:label "Joint Encoder"@en ;
    rdfs:comment "A joint encoder is a sensor mounted at a robot joint that measures angular or linear position, and often velocity, of that joint. It provides the proprioceptive feedback required for closed-loop position and motion control of articulated mechanisms. Encoders may be optical, magnetic or capacitive and are typically classed as incremental or absolute."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:proprioceptive-sensor ;
    vc:slug "joint-encoder" ;
    vc:sourceDomain "robotics" .

ngm:json-data-interchange-format-ld-context a owl:Class ;
    rdfs:label "JSON-LD Context"@en ;
    rdfs:comment "A JSON-LD Context is the machine-readable document or inline object that maps the shorthand terms and prefixes used in a JSON-LD document to their fully qualified IRIs in a target vocabulary or ontology. It serves as the bridge between the compact, human-readable JSON representation and the globally unambiguous RDF data model, enabling semantic interoperability across disparate systems. Contexts may be embedded inline within a document, referenced by URL, or composed from multiple context documents. The JSON-LD 1.1 specification extends context capabilities with scoped contexts, type-scoped and property-scoped contexts, and protected terms that resist accidental overriding. Correct context design is foundational to knowledge graph compilation and Linked Data publication."@en ;
    rdfs:subClassOf ngm:json-data-interchange-format-ld ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:linked-data,
        ngm:rdf,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "json-ld-context" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ontology,
        ngm:schema-registry ;
    vc:uses ngm:json-data-interchange-format-ld-1-1,
        ngm:sparql .

ngm:jvm-runtime a owl:Class ;
    rdfs:label "JVM Runtime"@en ;
    rdfs:comment "The JVM runtime is the execution environment provided by the Java Virtual Machine, which loads, verifies and runs platform-independent bytecode. It supplies just-in-time compilation, automatic garbage collection, threading and a security model that isolates executing code. The JVM hosts many languages beyond Java, including Kotlin and Scala, and underpins several enterprise blockchain platforms."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kotlin,
        ngm:r3-corda ;
    vc:slug "jvm-runtime" ;
    vc:sourceDomain "infrastructure" .

ngm:k-anonymity-in-datasets a owl:Class ;
    rdfs:label "k-Anonymity in Datasets"@en ;
    rdfs:comment "k-Anonymity is a dataset privacy property that guarantees each record is indistinguishable from at least k-1 other records with respect to quasi-identifier attributes—fields such as age, gender, and postal code that can be combined to re-identify individuals. Anonymization is achieved through generalisation (replacing specific values with broader categories) and suppression (removing highly identifying records), producing equivalence classes where all members share identical quasi-identifier values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-anonymization-pipeline ],
        ngm:ai-technique,
        ngm:privacy-preserving-analytics ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:federated-learning,
        ngm:homomorphic-encryption ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:differential-privacy,
        ngm:privacy-mechanism,
        ngm:privacy-preserving-analytics,
        ngm:synthetic-data ;
    vc:requires ngm:data-anonymization-pipeline,
        ngm:data-governance ;
    vc:slug "k-anonymity-in-datasets" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:synthetic-data-generation .

ngm:kanban-board a owl:Class ;
    rdfs:label "Kanban Board"@en ;
    rdfs:comment "A Kanban Board is a visual project management tool that organises work items into columns representing workflow stages such as To Do, In Progress, and Done. Teams use it to limit work-in-progress, surface bottlenecks, and maintain a shared view of task status across distributed members. It is a core practice in agile and lean distributed workflows."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-whiteboard ;
    vc:slug "kanban-board" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:keccak-256 a owl:Class ;
    rdfs:label "Keccak-256"@en ;
    rdfs:comment "A 256-bit cryptographic hash function based on the Keccak sponge construction, selected as the SHA-3 standard and used natively in Ethereum for address derivation, transaction hashing, and smart contract storage. It differs from NIST SHA-3 in padding and offers strong collision resistance and preimage resistance properties."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-cryptographic-primitive ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:preimage-resistance,
        ngm:sha-256 ;
    vc:slug "keccak-256" ;
    vc:sourceDomain "blockchain" .

ngm:khronos-open-xr a owl:Class ;
    rdfs:label "Khronos OpenXR"@en ;
    rdfs:comment "Khronos OpenXR is an open, royalty-free standard that defines a common application interface for virtual and augmented reality devices, decoupling XR applications from specific runtimes and hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
