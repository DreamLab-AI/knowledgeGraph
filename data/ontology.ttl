ngm:multi-agent-reinforcement-learning a owl:Class ;
    rdfs:label "Multi-Agent Reinforcement Learning"@en ;
    rdfs:comment "Multi-agent reinforcement learning (MARL) extends reinforcement learning to settings where several agents learn concurrently while interacting in a shared environment. Each agent optimises its own policy, but the environment is non-stationary from any single agent's perspective because the others are simultaneously adapting, which raises challenges of coordination, competition, credit assignment and equilibrium selection. MARL draws on game theory to analyse cooperative, competitive and mixed incentive structures and underpins applications from team robotics to automated trading and traffic control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-theory ],
        ngm:reinforcement-learning ;
    vc:bridgesTo ngm:distributed-decision-making,
        ngm:game-theory ;
    vc:dependsOn ngm:ai-model ;
    vc:enables ngm:automation,
        ngm:distributed-decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:multi-agent-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agent,
        ngm:deep-learning,
        ngm:neural-network ;
    vc:requires ngm:game-theory ;
    vc:slug "multi-agent-reinforcement-learning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:task-automation ;
    vc:uses ngm:deep-reinforcement-learning,
        ngm:markov-decision-process,
        ngm:reinforcement-learning .

ngm:multi-objective-optimisation a owl:Class ;
    rdfs:label "Multi Objective Optimisation"@en ;
    rdfs:comment "Multi-objective optimisation is the discipline of optimising two or more conflicting objective functions simultaneously, where improving one objective typically degrades another. Rather than a single optimum it yields a Pareto front of non-dominated trade-off solutions, from which a decision-maker selects according to preferences. It is solved with scalarisation, evolutionary, and gradient-based methods and is pervasive in engineering design, machine learning, and resource allocation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        ngm:optimisation ;
    vc:dependsOn ngm:genetic-algorithm ;
    vc:enables ngm:hyperparameter-optimisation,
        ngm:neural-architecture-search ;
    vc:hasMaturity ngmi:maturity-established ;
