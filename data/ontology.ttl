    vc:relatedTo ngm:api-gateway ;
    vc:relatedTo ngm:presence-indicator ;
    vc:slug "webhook" ;
    vc:sourceDomain "infrastructure" .
ngm:webid-decentralised-identity-uri a owl:Class ;
    rdfs:comment "A WebID is a URI that uniquely identifies an agent (person, organisation, or software) on the web and dereferences to an RDF profile document containing structured data about that agent. It underpins decentralised identity and access control across the Solid ecosystem and linked-data applications, allowing any service to authenticate and authorise users without a central identity provider."@en ;
    rdfs:label "WebID Decentralised Identity URI"@en ;
    rdfs:subClassOf ngm:network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
