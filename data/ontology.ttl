ngm:open-rail a owl:Class ;
    rdfs:comment "OpenRAIL (Responsible AI License) is a family of model licenses that grant broad permission to use and distribute AI models while imposing use-based behavioral restrictions to prevent harmful applications. Unlike traditional open-source licenses, it couples openness with enforceable conditions prohibiting specified misuse such as discrimination or disinformation. OpenRAIL has become a common licensing framework for openly released foundation models and their training artifacts."@en ;
    rdfs:label "OpenRAIL"@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
