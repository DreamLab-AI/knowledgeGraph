    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:W3CRecommendations
] .

mv:StandardizationBodies rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ISOStandards
] .

