ngm:reflexion a owl:Class ;
    rdfs:comment "Reflexion is a framework for language-model agents that converts feedback from failed attempts into reflective verbal self-critiques stored in an episodic memory, which condition subsequent attempts. Rather than updating model weights, it reinforces behaviour through natural-language reflections, enabling rapid trial-and-error learning. It improves agent performance on decision-making, reasoning, and coding benchmarks across repeated episodes."@en ;
    rdfs:label "Reflexion"@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-draft ;
