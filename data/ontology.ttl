ngm:real-time-operating-system a owl:Class ;
    rdfs:label "Real-Time Operating System"@en ;
    rdfs:comment "A Real-Time Operating System (RTOS) is an operating system designed to service computational tasks within guaranteed, bounded time constraints, providing temporal determinism that makes it the foundational software substrate for safety-critical and time-sensitive embedded applications. RTOSes implement priority-based preemptive scheduling, bounded interrupt latency, and synchronisation primitives (semaphores, mutexes, message queues) that ensure predictable worst-case task-switching behaviour irrespective of system load. They are classified as hard real-time — where any deadline miss constitutes a system failure — or soft real-time, where occasional misses cause graceful degradation rather than catastrophic failure. Deployed in medical devices, industrial controllers, automotive electronics, avionics, and robotics, RTOSes underpin every domain in which a missed computational deadline can cause physical harm, financial loss, or mission failure."@en ;
    rdfs:subClassOf ngm:operating-system ;
    vc:bridgesTo ngm:cyber-physical-systems,
        ngm:edge-ai ;
    vc:contrastsWith ngm:general-purpose-operating-system,
        ngm:soft-real-time-system ;
    vc:enables ngm:real-time,
        ngm:real-time-control,
        ngm:real-time-processing,
        ngm:safety-critical-systems,
        ngm:sub-millisecond-latency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interrupt-handler,
        ngm:memory-management-unit,
        ngm:task-scheduler ;
    vc:implements ngm:inter-process-communication,
        ngm:preemptive-scheduling,
        ngm:priority-inversion-prevention ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:freertos,
        ngm:robot-operating-system,
        ngm:zephyr-rtos ;
    vc:requires ngm:deterministic-scheduling,
        ngm:embedded-processor,
        ngm:worst-case-execution-time ;
    vc:slug "real-time-operating-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:industrial-automation,
        ngm:internet-of-things,
        ngm:motor-driver,
        ngm:robotic-system ;
    vc:uses ngm:embedded-ai-frameworks,
        ngm:latency,
        ngm:message-queue,
        ngm:semaphore .

ngm:structure-from-motion a owl:Class ;
    rdfs:label "Structure-from-Motion"@en ;
    rdfs:comment "Structure-from-Motion (SfM) is a photogrammetric pipeline that simultaneously recovers three-dimensional scene geometry and camera motion parameters from an unordered collection of overlapping two-dimensional images. Sparse feature correspondences—detected via descriptors such as SIFT, ORB, or learned alternatives—seed an incremental or global pose-estimation stage that triangulates a sparse point cloud. Bundle adjustment then jointly refines all camera extrinsics, intrinsics, and 3D point coordinates by minimising reprojection error across the full image set. SfM is a foundational technique in computer vision, photogrammetry, autonomous navigation, and spatial computing, serving as the upstream stage for multi-view stereo densification and neural scene representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bundle-adjustment ],
        ngm:photogrammetry ;
    vc:bridgesTo ngm:autonomous-vehicles,
        ngm:digital-twin,
        ngm:robotics ;
    vc:contrastsWith ngm:lidar-scanning,
        ngm:slam,
        ngm:visual-odometry ;
    vc:enables ngm:3d-mapping,
        ngm:augmented-reality,
        ngm:depth-estimation,
        ngm:multi-view-stereo,
        ngm:point-cloud ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:3d-reconstruction,
        ngm:photogrammetry ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:neural-radiance-fields,
        ngm:scene-reconstruction,
        ngm:stereo-vision ;
    vc:requires ngm:bundle-adjustment,
        ngm:camera-calibration,
        ngm:feature-matching ;
    vc:slug "structure-from-motion" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:epipolar-geometry,
        ngm:feature-detection,
        ngm:ransac .

ngm:taproot a owl:Class ;
    rdfs:label "Taproot"@en ;
    rdfs:comment "Taproot is a soft-fork upgrade to the Bitcoin protocol, activated at block 709,632 in November 2021, comprising BIPs 340, 341, and 342. It introduces Schnorr signatures (BIP 340), Pay-to-Taproot (P2TR) outputs with Merkelised Abstract Syntax Tree (MAST) spending-condition commitments (BIP 341), and Tapscript — an updated Bitcoin Script dialect (BIP 342). Together these improvements enhance transaction privacy by making complex multi-condition spends indistinguishable from simple key-path spends, improve efficiency via Schnorr signature aggregation, and expand smart-contract expressiveness on Bitcoin's base layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schnorr-signatures ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ecdsa,
        ngm:pay-to-script-hash,
        ngm:segregated-witness ;
    vc:enables ngm:bitvm,
        ngm:musig2,
        ngm:point-time-locked-contracts,
        ngm:taproot-assets,
        ngm:taproot-channels ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:merkelised-abstract-syntax-tree,
        ngm:pay-to-taproot,
        ngm:schnorr-signatures,
        ngm:tapscript ;
    vc:implements ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-technical-overview ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-governance,
        ngm:bitcoin-proof-of-work-protocol-network,
        ngm:bitcoin-proof-of-work-protocol-script,
        ngm:multi-signature,
        ngm:smart-contracts ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:soft-fork ;
    vc:slug "taproot" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-improvement-proposals ;
    vc:supports ngm:lightning-network,
        ngm:signature-aggregation,
        ngm:transaction-privacy ;
    vc:uses ngm:cryptographic-primitive,
        ngm:cryptographic-signature,
        ngm:hash-function,
        ngm:secp256k1 .

ngm:teleoperation a owl:Class ;
