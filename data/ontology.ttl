ngm:data-inventory a owl:Class ;
    rdfs:comment "A data inventory is a structured, maintained record of the categories, locations, and flows of data - particularly personal data - that an organisation collects, processes, and stores. It underpins compliance with data protection regimes such as CCPA and GDPR by allowing an organisation to demonstrate what data it holds, why it holds it, and where it resides when responding to access, deletion, or portability requests. Maintaining an accurate data inventory is a prerequisite for exercising rights such as the right to be forgotten."@en ;
    rdfs:label "Data Inventory"@en ;
    rdfs:subClassOf ngm:data-catalog ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-inventory" ;
    vc:sourceDomain "governance" .
ngm:data-labelling a owl:Class ;
    rdfs:comment "Data labelling is the process of annotating raw data, such as images, text, audio or sensor readings, with the target outputs or categories a supervised model is expected to predict. It produces the ground-truth signal that links inputs to desired outputs and largely determines the achievable accuracy of trained models. Labelling combines human annotators, guidelines, tooling and quality control, increasingly augmented by model-assisted and active-learning workflows."@en ;
    rdfs:label "Data Labelling"@en ;
    rdfs:subClassOf ngm:data-annotation ;
    rdfs:subClassOf _:r6904 ;
    rdfs:subClassOf _:r6905 ;
    rdfs:subClassOf _:r6906 ;
    rdfs:subClassOf _:r6907 ;
