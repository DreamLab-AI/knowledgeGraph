    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Rule of Law
spatial-computing:RuleofLaw rdf:type owl:Class ;
    rdfs:label "Rule of Law"@en ;
    rdfs:comment "The principle that all persons, institutions and entities, including AI systems and their operators, are accountable to laws that are publicly promulgated, equally enforced, independently adjudicated and consistent with international human rights norms."@en ;
    skos:prefLabel "Rule of Law"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:rule-of-law" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:rule-of-law> ;
    vcw:contentHash "sha256-12-2ddffe4c853b" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0168" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0168" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Environmental Sustainability
spatial-computing:EnvironmentalSustainability rdf:type owl:Class ;
    rdfs:label "Environmental Sustainability"@en ;
    rdfs:comment "The responsible stewardship of natural resources and environmental systems in AI development and deployment, minimising ecological harm whilst potentially leveraging AI to address environmental challenges including climate change, biodiversity loss and resource depletion."@en ;
    skos:prefLabel "Environmental Sustainability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:environmental-sustainability" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:environmental-sustainability> ;
    vcw:contentHash "sha256-12-9a448678de44" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0169" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0169" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Social Impact
spatial-computing:SocialImpact rdf:type owl:Class ;
    rdfs:label "Social Impact"@en ;
    rdfs:comment "The effects—positive and negative, intended and unintended—that AI systems have on individuals, communities, societies and social structures including employment, education, social cohesion, cultural practices and power distributions."@en ;
    skos:prefLabel "Social Impact"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:social-impact" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:social-impact> ;
    vcw:contentHash "sha256-12-39b0e7a798b2" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0170" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0170" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Transformer Architecture
artificial-intelligence:TransformerArchitecture rdf:type owl:Class ;
    rdfs:label "Transformer Architecture"@en ;
    rdfs:comment "A neural network architecture based solely on attention mechanisms, dispensing with recurrence and convolutions entirely, designed for sequence-to-sequence tasks."@en ;
    skos:prefLabel "Transformer Architecture"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:transformer-architecture" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:transformer-architecture> ;
    vcw:contentHash "sha256-12-04ad83ff373e" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0196" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0196" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Self Attention
artificial-intelligence:SelfAttention rdf:type owl:Class ;
    rdfs:label "Self Attention"@en ;
    rdfs:comment "An attention mechanism where every token in a sequence attends to every other token in the same sequence, allowing the model to capture intra-sequence dependencies."@en ;
    skos:prefLabel "Self Attention"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:self-attention" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:self-attention> ;
    vcw:contentHash "sha256-12-c80a6c48129f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0197" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0197" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Scaled Dot Product Attention
artificial-intelligence:ScaledDotProductAttention rdf:type owl:Class ;
    rdfs:label "Scaled Dot Product Attention"@en ;
    rdfs:comment "An attention mechanism that computes attention weights using the dot product of queries and keys, scaled by the square root of the key dimension, followed by a softmax normalisation."@en ;
    skos:prefLabel "Scaled Dot Product Attention"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:scaled-dot-product-attention" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:scaled-dot-product-attention> ;
    vcw:contentHash "sha256-12-91834cc9d8ef" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0199" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0199" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Query Key Value
spatial-computing:QueryKeyValue rdf:type owl:Class ;
    rdfs:label "Query Key Value"@en ;
    rdfs:comment "The three fundamental components in attention mechanisms: queries determine what information to seek, keys determine what information is available, and values contain the actual information to be retrieved."@en ;
    skos:prefLabel "Query Key Value"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:query-key-value" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:query-key-value> ;
    vcw:contentHash "sha256-12-8c1466af1b3f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0200" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0200" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Positional Encoding
spatial-computing:PositionalEncoding rdf:type owl:Class ;
    rdfs:label "Positional Encoding"@en ;
    rdfs:comment "A technique for injecting information about the relative or absolute position of tokens in a sequence, essential for transformers since they lack inherent sequential ordering."@en ;
    skos:prefLabel "Positional Encoding"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:positional-encoding" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:positional-encoding> ;
    vcw:contentHash "sha256-12-155c339334e5" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0201" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0201" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Layer Normalisation
artificial-intelligence:LayerNormalisation rdf:type owl:Class ;
    rdfs:label "Layer Normalisation"@en ;
    rdfs:comment "A normalisation technique that normalises activations across the feature dimension for each example independently, stabilising deep network training."@en ;
    skos:prefLabel "Layer Normalisation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:layer-normalisation" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:layer-normalisation> ;
    vcw:contentHash "sha256-12-46792fe81aa3" ;
