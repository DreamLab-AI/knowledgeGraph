ngm:challenge-response-protocol a owl:Class ;
    rdfs:comment "A challenge-response protocol is an authentication protocol in which a verifier issues an unpredictable challenge and the claimant must return a response computed from a shared secret or private key, proving knowledge of the credential without transmitting it. Because each challenge is fresh, typically a random nonce, a valid response cannot be reused, defeating replay attacks. The pattern underpins many authentication mechanisms including CHAP, HMAC-based schemes, and public-key signature challenges."@en ;
    rdfs:label "Challenge-Response Protocol"@en ;
    rdfs:subClassOf ngm:authentication-protocol ;
    rdfs:subClassOf _:r4218 ;
    rdfs:subClassOf _:r4219 ;
