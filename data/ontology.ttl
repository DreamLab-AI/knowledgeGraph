ngm:behaviour-tree a owl:Class ;
    rdfs:label "Behaviour Tree"@en ;
    rdfs:comment "A Behaviour Tree (BT) is a hierarchical, directed acyclic graph structure used to model the decision-making logic of autonomous agents, non-player characters (NPCs), and robots. Internal nodes represent control-flow composites — Sequence, Selector, Parallel, and Decorator — while leaf nodes represent atomic Actions or Conditions; execution propagates through the tree and each node returns Success, Failure, or Running to its parent. Behaviour Trees superseded Finite State Machines (FSMs) in many game and robotics contexts because they offer superior modularity, reusability, and comprehensibility: sub-trees encapsulate coherent behaviours that can be composed without explicit inter-state transition wiring. First popularised in the game-development community circa 2005 and later formalised in robotics frameworks such as BehaviorTree.CPP, BTs are now a standard control architecture in both real-time interactive media and autonomous robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-planning ],
        ngm:automated-planning ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:finite-state-machine,
        ngm:hierarchical-task-network,
        ngm:state-machine ;
    vc:enables ngm:autonomous-agent,
        ngm:npc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blackboard ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:automated-planning,
