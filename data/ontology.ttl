        <urn:visionflow:linked:dlt-ledger-design>,
        <urn:visionflow:linked:interoperability-protocol>,
        <urn:visionflow:linked:tiered-anonymity>,
        <urn:visionflow:linked:two-tier-distribution-model>,
        vf:privacy-by-design ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:central-bank>,
        <urn:visionflow:linked:financial-regulation>,
        <urn:visionflow:linked:payment-infrastructure>,
        vf:aml-kyc-compliance,
        vf:cryptographic-security,
        vf:digital-identity,
        vf:monetary-sovereignty ;
