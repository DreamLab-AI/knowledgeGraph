ngm:property-rights a owl:Class ;
    rdfs:label "Property Rights"@en ;
    rdfs:comment "Property rights are the legally and institutionally recognised entitlements that determine who may use, transfer, exclude others from, or derive value from a resource — whether physical, digital, or intellectual. They form the foundational incentive structure of market economies, specifying the bundle of rights (usus, fructus, abusus) attached to an asset. In digital and blockchain contexts, property rights extend to on-chain ownership records, smart-contract-enforced exclusivity, NFT-based title deeds, and virtual land parcels, requiring mechanisms for interoperability, provenance tracking, and dispute resolution that operate across jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-generated-content,
        ngm:decentralised-autonomous-organisation,
        ngm:virtual-land ;
    vc:contrastsWith ngm:commons,
        ngm:open-access ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:dispute-resolution ;
    vc:enables ngm:creator-economy,
        ngm:decentralised-finance,
        ngm:digital-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-sovereignty,
        ngm:intellectual-property-rights-framework,
        ngm:land-registry,
        ngm:regulatory-compliance ;
    vc:requires ngm:digital-ownership,
        ngm:identity-management,
        ngm:legal-framework,
        ngm:smart-contract ;
    vc:slug "property-rights" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-proof,
        ngm:nft,
        ngm:tokenization .

ngm:proximal-policy-optimisation a owl:Class ;
    rdfs:label "Proximal Policy Optimisation"@en ;
    rdfs:comment "A reinforcement learning algorithm that updates policies through incremental steps whilst constraining how much the policy can change via a clipped surrogate objective, preventing destabilising updates. PPO is the dominant RL algorithm used in reinforcement learning from human feedback (RLHF) for fine-tuning language models to align with human preferences."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:reinforcement-learning ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:reinforcement-learning-algorithm ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:reinforcement-learning-from-human-feedback ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "proximal-policy-optimisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-feedback,
        ngm:reward-model .

ngm:rb-0056-impedance-control a owl:Class ;
    rdfs:label "rb 0056 impedance control"@en ;
    rdfs:comment "Impedance control is a robot interaction-control strategy that regulates the dynamic relationship between end-effector force and motion by imposing a desired mechanical impedance (mass, damping, stiffness) on the robot's behaviour at the point of contact. Rather than commanding precise positions or forces independently, impedance control allows compliant, safe physical interaction with humans or uncertain environments by shaping the robot's apparent mechanical response. It is fundamental to collaborative robotics, enabling robots to yield to external forces in a controlled manner without requiring an explicit force setpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        ngm:interaction-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0053-force-control,
        ngm:rb-0057-admittance-control ;
    vc:requires ngm:rb-0067-force-torque-sensor,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0056-impedance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0007-collaborative-robot,
        ngm:rb-0094-power-and-force-limiting .

ngm:real-time-analytics a owl:Class ;
    rdfs:label "Real-Time Analytics"@en ;
    rdfs:comment "Real-time analytics is the processing and analysis of data immediately as it is generated, producing insights and triggering actions with sub-second to low-second latency. It relies on stream-processing engines, in-memory computation, and windowed aggregation rather than batch ETL. It enables responsive dashboards, anomaly detection, and adaptive systems that act on fresh data."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adaptive-virtual-experience,
        ngm:edge-computing-node ;
    vc:slug "real-time-analytics" ;
    vc:sourceDomain "data" .

ngm:real-time-gross-settlement a skos:Concept ;
    rdfs:label "Real Time Gross Settlement"@en .

ngm:redundancy a owl:Class ;
    rdfs:label "Redundancy"@en ;
    rdfs:comment "Redundancy is the deliberate duplication of components, data, or pathways in a system so that the failure of any single element does not cause overall failure. It is a foundational technique for fault tolerance, implemented through replicas, standby nodes, mirrored storage, and multiple network routes. By eliminating single points of failure, redundancy raises availability at the cost of additional resources."@en ;
    rdfs:subClassOf ngm:system-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:reliability-engineering ;
    vc:slug "redundancy" ;
    vc:sourceDomain "infrastructure" .

ngm:relational-database a skos:Concept ;
    rdfs:label "Relational Database"@en .

ngm:reliability-engineering a owl:Class ;
    rdfs:label "Reliability Engineering"@en ;
    rdfs:comment "Reliability engineering is the engineering discipline that applies probabilistic and statistical methods to design, analyse, and verify that systems perform their required functions for a specified period under stated operating conditions without failure. It encompasses systematic techniques including fault tree analysis, failure mode and effects analysis, and accelerated life testing to quantify failure probabilities and identify design weaknesses. The discipline establishes dependability metrics such as MTBF, MTTF, and availability, and prescribes design strategies including redundancy, derating, and fault-tolerant architectures to achieve reliability targets. It spans hardware, software, and socio-technical systems and is foundational to safety-critical engineering in aerospace, automotive, medical devices, nuclear, and large-scale cloud infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fmea ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        ngm:systems-engineering ;
    vc:bridgesTo ngm:ai-safety,
        ngm:chaos-engineering,
        ngm:site-reliability-engineering ;
    vc:contrastsWith ngm:quality-engineering,
        ngm:safety-engineering ;
    vc:dependsOn ngm:fault-tolerance,
        ngm:redundancy ;
    vc:enables ngm:predictive-maintenance,
        ngm:risk-assessment,
        ngm:safety-assurance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:accelerated-life-testing,
        ngm:fault-tree-analysis,
        ngm:fmea,
        ngm:reliability-block-diagram ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:availability,
        ngm:maintainability ;
    vc:requires ngm:failure-data-collection,
        ngm:probabilistic-risk-assessment ;
    vc:slug "reliability-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262,
        ngm:mil-hdbk-217 ;
    vc:supports ngm:functional-safety,
        ngm:maintenance-engineering ;
    vc:uses ngm:markov-chains,
        ngm:monte-carlo-simulation,
        ngm:weibull-analysis .

ngm:robot-perception a owl:Class ;
    rdfs:label "Robot Perception"@en ;
    rdfs:comment "Robot perception is the process by which a robot interprets sensor data from cameras, lidar, depth sensors and inertial units to build an actionable understanding of its environment, objects and its own pose."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
