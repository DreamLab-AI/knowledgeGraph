        ngm:texture-authoring,
        ngm:video-editing ;
    vc:isPartOf ngm:content-production-workflow ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:digital-content-layer,
        ngm:open-usd,
        ngm:real-time-rendering ;
    vc:requires ngm:content-delivery-network,
        ngm:digital-asset-management ;
    vc:slug "digital-content-creation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:extended-reality,
