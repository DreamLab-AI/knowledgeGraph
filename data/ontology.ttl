        ngm:technology-adoption ;
    vc:requires ngm:interoperability ;
    vc:slug "network-effects" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:path-dependence .

ngm:nft-minting a owl:Class ;
    rdfs:label "NFT Minting"@en ;
    rdfs:comment "NFT Minting is the on-chain or deferred off-chain process by which a unique, indivisible, and cryptographically authenticated digital token—a non-fungible token—is created and permanently recorded on a distributed ledger, establishing irrevocable provenance, ownership, and transferability for a l..."@en ;
