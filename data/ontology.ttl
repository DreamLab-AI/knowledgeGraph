    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:digital-wallet,
        ngm:token-standard ;
    vc:slug "decentralized-exchange-dex" ;
    vc:sourceDomain "blockchain" .

ngm:deep-neural-network a owl:Class ;
    rdfs:label "Deep Neural Network"@en ;
    rdfs:comment "A deep neural network is an artificial neural network with multiple hidden layers between its input and output, enabling it to learn hierarchical representations of data. Each layer applies a learnable linear transformation followed by a non-linear activation, and the network is trained by gradient descent with backpropagation to minimise a loss function. Depth lets the model compose simple features into increasingly abstract ones, which underlies modern deep learning across vision, language, and audio."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:neural-network ;
    vc:bridgesTo ngm:transformer ;
    vc:contrastsWith ngm:feedforward-neural-network ;
    vc:dependsOn ngm:supervised-learning,
        ngm:training-data ;
    vc:enables ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activation-function ;
    vc:implements ngm:feedforward-neural-network ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convolutional-neural-network,
        ngm:embedding,
        ngm:overfitting,
        ngm:recurrent-neural-network ;
    vc:requires ngm:training-data ;
    vc:slug "deep-neural-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:activation-function,
        ngm:backpropagation,
        ngm:gradient-descent .

ngm:delegate-democracy a owl:Class ;
    rdfs:label "Delegate Democracy"@en ;
    rdfs:comment "Delegate Democracy (also known as liquid democracy, delegative democracy, or proxy democracy) is a hybrid political and organisational governance model — formalised in modern computer-mediated form by Bryan Ford in his 2002 paper Delegative Democracy (Yale, later Swiss EPFL) and intellectuall..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proposal-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:checkpoints ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vote-delegation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
