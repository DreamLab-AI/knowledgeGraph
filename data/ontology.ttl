    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:game-engine .

ngm:digital-fabrication a owl:Class ;
    rdfs:label "Digital Fabrication"@en ;
    rdfs:comment "Digital Fabrication, in the AI context, integrates artificial intelligence with additive manufacturing, CNC machining, and robotic production technologies to optimise fabrication processes. AI enables generative design for novel geometries, predictive maintenance via sensor analytics, real-time quality control through computer vision, and adaptive toolpath planning using reinforcement learning. Machine learning models predict material behaviour, detect defects, and enable mass customisation through digital twin simulation before physical production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-twin ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-robot,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:digital-twin ;
    vc:slug "digital-fabrication" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:digital-asset-management ;
    vc:uses ngm:computer-vision,
        ngm:reinforcement-learning .

ngm:digital-gaming a owl:Class ;
    rdfs:label "Digital Gaming"@en ;
    rdfs:comment "Digital Gaming encompasses interactive software experiences delivered across platforms including PCs, consoles, and mobile devices, encompassing game design, virtual economies, player interaction systems, and increasingly blockchain-based asset ownership. It represents a convergence of entertainment, spatial computing, and digital economy mechanisms within persistent or session-based virtual environments."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:blockchain ;
    vc:enables ngm:digital-ownership,
