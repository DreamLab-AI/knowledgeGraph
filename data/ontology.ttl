        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:cyber-physical-systems,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:teleoperation ;
    vc:dependsOn ngm:robot-operating-system,
        ngm:state-estimation ;
    vc:enables ngm:autonomous-navigation,
