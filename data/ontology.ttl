        ngm:trustworthy-ai ;
    vc:contrastsWith ngm:security-risk-assessment ;
    vc:dependsOn ngm:data-mapping,
        ngm:personal-data-processing ;
    vc:enables ngm:accountability,
        ngm:compliance-framework,
        ngm:privacy-framework,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:necessity-assessment,
        ngm:risk-register ;
    vc:implements ngm:gdpr-article-35,
        ngm:iso-29134 ;
    vc:qualityScore "0.72"^^xsd:float ;
