ngm:lightning-network-layer a owl:Class ;
    rdfs:comment "The Lightning Network Layer is a second-layer stratum that enables fast, low-cost payments off the base settlement ledger through bidirectional payment channels. It sits above the Settlement Layer, on which it anchors and finally settles, and below the application and content strata that use instant payments. It contains payment channels, routing, and channel-state management."@en ;
    rdfs:label "Lightning Network Layer"@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    rdfs:subClassOf ngm:owl-thing ;
