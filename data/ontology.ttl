ngm:trust-mechanism a owl:Class ;
    rdfs:label "Trust Mechanism"@en ;
    rdfs:comment "A trust mechanism is a system, protocol, or institution that allows parties who lack prior knowledge of one another to transact or cooperate with reasonable assurance of honest behaviour. Such mechanisms range from intermediaries and reputation systems to cryptographic and consensus protocols that replace interpersonal trust with verifiable, incentive-aligned guarantees."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barter-system,
        ngm:value-transfer ;
    vc:slug "trust-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:trust-over-ip-stack a owl:Class ;
    rdfs:label "Trust over IP Stack"@en ;
    rdfs:comment "The Trust over IP (ToIP) Stack is a four-layer architecture developed by the Trust Over IP Foundation that provides a complete framework for decentralised digital trust, combining technical protocols (verifiable credentials, DID-based peer-to-peer messaging, verifiable data registries) with governance frameworks at each layer to enable interoperable, privacy-preserving identity and credential exchange across organisational and jurisdictional boundaries. The stack mirrors the TCP/IP model by separating technical interoperability concerns from governance and policy concerns at corresponding layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:w3-c-verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        ngm:trust-framework ;
    vc:enables ngm:credential-verification,
        ngm:decentralised-trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralized-identifiers,
        ngm:verifiable-data-registry,
        ngm:w3-c-verifiable-credentials ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity-framework,
        ngm:trust-over-ip-foundation ;
    vc:slug "trust-over-ip-stack" ;
    vc:sourceDomain "governance" .

