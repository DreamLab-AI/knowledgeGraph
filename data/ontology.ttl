        ngm:zk-snarks,
        ngm:zk-starks ;
    vc:isPartOf ngm:cryptographic-protocol,
        ngm:privacy-enhancing-technologies ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-verification,
        ngm:homomorphic-encryption,
        ngm:merkle-tree,
        ngm:public-key-cryptography ;
    vc:requires ngm:computational-hardness-assumption,
        ngm:interactive-proof-system ;
    vc:slug "zero-knowledge-proof" ;
