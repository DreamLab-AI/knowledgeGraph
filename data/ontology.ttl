    vc:slug "natural-language-processing-domain" ;
    vc:sourceDomain "natural-language-processing" .

ngm:net-zero-targets a owl:Class ;
    rdfs:label "Net Zero Targets"@en ;
    rdfs:comment "Net Zero Targets are formal commitments made by governments, corporations, or other entities to reduce greenhouse gas emissions to the point where residual emissions are balanced by equivalent carbon removals, achieving a net-zero contribution to atmospheric greenhouse gas concentrations by a specified date. These targets typically distinguish between near-term absolute reduction milestones and longer-term residual offset strategies, and are aligned with the IPCC's pathways to limiting global warming to 1.5 °C."@en ;
    rdfs:subClassOf ngm:climate-commitments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:climate-policy,
        ngm:paris-agreement,
        ngm:voluntary-carbon-market ;
    vc:slug "net-zero-targets" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:climate-change-mitigation ;
    vc:uses ngm:carbon-offsetting,
        ngm:net-zero-target-setting .

ngm:network-analysis a owl:Class ;
    rdfs:label "Network Analysis"@en ;
    rdfs:comment "Network Analysis is the study of complex systems represented as graphs of nodes and edges, using mathematical and computational techniques to characterise structure, detect communities, identify influential nodes, and model dynamic processes such as information diffusion. Rooted in graph theory, sociology, and statistical physics, it encompasses metrics including degree distribution, betweenness centrality, clustering coefficients, and path lengths. Applications span social network mapping, cybersecurity threat detection, supply chain vulnerability assessment, and knowledge graph quality evaluation. Machine learning on graphs, through graph neural networks, has substantially extended analytical capabilities."@en ;
    rdfs:subClassOf ngm:knowledge-graph ;
    vc:enables ngm:knowledge-graph-construction,
        ngm:knowledge-graphing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-system,
        ngm:knowledge-management,
        ngm:linked-data,
        ngm:machine-learning ;
    vc:slug "network-analysis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:graph-neural-network,
        ngm:knowledge-representation,
        ngm:social-network-graph .

ngm:network-synchronization a owl:Class ;
    rdfs:label "Network Synchronization"@en ;
    rdfs:comment "Network Synchronization is the process by which blockchain nodes align their local chain state with the canonical ledger through block propagation, header-first sync, and fork resolution protocols. It governs initial block download, peer discovery, and the ongoing receipt of new blocks and transactions via gossip, ensuring all honest participants converge on an identical view of the distributed ledger despite network partitions and latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:distributed-data-structure,
        ngm:eclipse-attack,
        ngm:network-topology,
        ngm:transaction-pool ;
    vc:requires ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "network-synchronization" ;
    vc:sourceDomain "blockchain" .

ngm:networking-infrastructure a owl:Class ;
    rdfs:label "Networking Infrastructure"@en ;
    rdfs:comment "The physical and logical systems—including routers, CDNs, edge nodes, and communication protocols—that underpin connectivity for distributed applications. For spatial computing and metaverse contexts, networking infrastructure must deliver sub-20ms latency, support massive concurrent connections, and enable geographically distributed state synchronisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
