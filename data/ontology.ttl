ngm:rigid-body-dynamics a owl:Class ;
    rdfs:label "Rigid Body Dynamics"@en ;
    rdfs:comment "Rigid Body Dynamics is the branch of classical mechanics that models solid objects as perfectly non-deformable, computing their translational and rotational motion under applied forces and torques using Newton-Euler equations or Lagrangian formulations. It addresses the full six-degree-of-freedom motion state — position, orientation, linear velocity, and angular velocity — and resolves contact constraints through collision detection, impulse resolution, and constraint solvers. The field underpins real-time simulation in game engines, robot motion planning, spacecraft attitude control, and extended-reality environments. Key numerical methods include symplectic Euler integration, Runge-Kutta schemes, and position-based dynamics for stable, interactive-rate simulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quaternion-math ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:numerical-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inertia-tensor ],
        ngm:physics-simulation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:finite-element-analysis,
        ngm:fluid-simulation,
        ngm:soft-body-dynamics ;
    vc:enables ngm:motion-planning,
        ngm:physics-based-animation,
        ngm:physics-engine,
        ngm:vehicle-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:collision-detection,
        ngm:collision-response,
        ngm:constraint-satisfaction,
        ngm:numerical-integration ;
    vc:isPartOf ngm:classical-mechanics,
        ngm:physics-simulation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:spatial-computing ;
    vc:requires ngm:inertia-tensor,
        ngm:linear-algebra,
        ngm:quaternion-math ;
    vc:slug "rigid-body-dynamics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:coordinate-system,
        ngm:real-time-processing .

ngm:secure-enclave a owl:Class ;
    rdfs:label "Secure Enclave"@en ;
    rdfs:comment "A secure enclave is a hardware-isolated execution environment embedded within a processor that maintains confidentiality and integrity guarantees for code and data even when the host operating system, hypervisor, or other privileged software is compromised. Implemented through technologies such as Intel SGX, ARM TrustZone, Apple Secure Enclave Processor, and AMD SEV-SNP, these environments use hardware memory encryption and access-control mechanisms enforced within the CPU package itself. Remote attestation allows a verifier to cryptographically confirm that specific code runs inside a genuine, unmodified enclave before transmitting sensitive data to it, without trusting the surrounding software stack. Secure enclaves are foundational to confidential computing, privacy-preserving machine learning, decentralised identity, and secure multi-party computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:memory-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:remote-attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-root-of-trust ],
        ngm:trusted-execution-environment ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance,
        ngm:federated-learning ;
    vc:contrastsWith ngm:hardware-security-module,
        ngm:hypervisor,
        ngm:virtual-machine ;
    vc:enables ngm:confidential-smart-contract,
        ngm:decentralised-identity,
        ngm:digital-rights-management,
        ngm:privacy-preserving-machine-learning,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:memory-encryption,
        ngm:remote-attestation,
        ngm:sealed-storage ;
    vc:isPartOf ngm:confidential-computing,
        ngm:hardware-root-of-trust ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:amd-sev,
        ngm:arm-trust-zone,
        ngm:intel-sgx,
        ngm:supply-chain-security,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-key-management,
        ngm:hardware-root-of-trust ;
    vc:slug "secure-enclave" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:public-key-cryptography,
        ngm:side-channel-attack,
        ngm:symmetric-encryption .

ngm:sensor-data a owl:Class ;
    rdfs:label "Sensor Data"@en ;
    rdfs:comment "Sensor data comprises the raw or pre-processed digital measurements produced by physical transducers—including cameras, LiDAR scanners, inertial measurement units (IMUs), ultrasonic rangers, and microphones—that encode observable properties of the environment such as geometry, colour, acceleration, and sound. In robotic, autonomous, and spatial computing systems, sensor data forms the primary input to perception pipelines responsible for state estimation, object detection, and scene understanding. Data quality characteristics—including frame rate, resolution, noise floor, and synchronisation latency—directly constrain the capabilities of downstream algorithms such as SLAM, sensor fusion, and learned perception models. Sensor data is collected, timestamped, and transmitted through data acquisition systems before being processed through calibration, fusion, and inference stages to produce actionable world representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
