    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:digital-signature ;
    vc:implements ngm:encryption ;
    vc:implements ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography ;
    vc:relatedTo ngm:schnorr-signature ;
    vc:slug "rsa" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:asymmetric-cryptography ;
    vc:uses ngm:hash-function ;
    vc:uses ngm:key-generation .
ngm:rsa-algorithm a owl:Class ;
    rdfs:comment "The RSA algorithm is a public-key cryptosystem whose security rests on the practical difficulty of factoring the product of two large prime numbers. A public key derived from this product encrypts data or verifies signatures, while the corresponding private key, recoverable only with knowledge of the prime factors, decrypts or signs. RSA was among the first practical asymmetric schemes and remains widely used for key exchange, digital signatures, and certificate-based authentication."@en ;
    rdfs:label "Rsa Algorithm"@en ;
    rdfs:subClassOf ngm:public-key-cryptography ;
    rdfs:subClassOf _:r18587 ;
    rdfs:subClassOf _:r18588 ;
