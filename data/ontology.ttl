    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:rb-0093-speed-limitation ;
    vc:implements ngm:rb-0094-power-and-force-limiting ;
    vc:implements ngm:rb-0103-collaborative-operation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:human-robot-interaction ;
    vc:relatedTo ngm:rb-0056-impedance-control ;
    vc:relatedTo ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0007-collaborative-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:standardizedBy ngm:rb-0087-safety-standard .
ngm:rb-0008-autonomous-robot a owl:Class ;
    rdfs:comment "An autonomous robot is a robotic system capable of performing tasks in unstructured environments without continuous human intervention, relying on onboard sensing, perception, decision-making, and actuation. Autonomy spans a spectrum from simple programmed responses to full cognitive agency; key enabling technologies include SLAM, path planning, machine learning-based perception, and safety-certified control architectures."@en ;
    rdfs:label "rb 0008 autonomous robot"@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    rdfs:subClassOf _:r22913 ;
    rdfs:subClassOf _:r22914 ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation ;
    vc:relatedTo ngm:autonomous-system ;
    vc:relatedTo ngm:rb-0007-collaborative-robot ;
    vc:relatedTo ngm:rb-0012-wheeled-mobile-robot ;
    vc:requires ngm:perception-system ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0008-autonomous-robot" ;
