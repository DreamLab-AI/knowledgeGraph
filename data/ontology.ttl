# Virtual Stage
spatial-computing:VirtualStage rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ProductionFacility ;
    rdfs:label "Virtual Stage"@en ;
    rdfs:comment "A production environment surrounded by LED walls and floors displaying real-time computer-generated imagery, enabling in-camera visual effects for film, television, and broadcast production where digital backgrounds react to camera movement and can be manipulated during live filming."@en ;
    skos:prefLabel "Virtual Stage"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-stage" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-stage> ;
