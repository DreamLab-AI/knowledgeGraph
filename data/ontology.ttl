ngm:sandbox-environment a owl:Class ;
    rdfs:label "Sandbox Environment"@en ;
    rdfs:comment "A sandbox environment is an isolated execution context that constrains a program's access to the host system, filesystem, network, and resources. It allows untrusted or autonomous code, such as AI-generated programs or agent actions, to run with controlled side effects and contained failure. Sandboxes are implemented through containers, virtual machines, OS-level namespaces, or language-level interpreters."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cli-multi-agent-systems,
        ngm:gpt-engineer ;
    vc:slug "sandbox-environment" ;
    vc:sourceDomain "infrastructure" .

ngm:sat-solving a owl:Class ;
    rdfs:label "Sat Solving"@en ;
    rdfs:comment "SAT solving is the algorithmic process of determining whether a propositional logic formula, typically in conjunctive normal form, has a satisfying truth assignment — the Boolean satisfiability problem. Although SAT is the canonical NP-complete problem, modern conflict-driven clause-learning solvers routinely decide instances with millions of variables and clauses, making SAT a practical engine for many computational tasks. SAT solving uses systematic search with unit propagation, clause learning, and intelligent backtracking. It underpins formal verification, automated planning, and constraint solving, and is closely related to satisfiability-modulo-theories reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        ngm:automated-reasoning ;
    vc:enables ngm:automated-planning,
        ngm:formal-verification,
        ngm:model-checking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:constraint-satisfaction-problem,
        ngm:constraint-solver ;
    vc:implements ngm:automated-reasoning ;
    vc:isPartOf ngm:automated-reasoning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:electronic-design-automation,
        ngm:planning ;
    vc:requires ngm:optimization-algorithm ;
    vc:slug "sat-solving" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:theorem-proving,
        ngm:verification ;
    vc:uses ngm:heuristic-search,
        ngm:logic,
        ngm:propositional-logic,
        ngm:search-algorithm .

ngm:satisfiability a owl:Class ;
    rdfs:label "Satisfiability"@en ;
    rdfs:comment "Satisfiability is the problem of determining whether there exists an assignment of values to variables that makes a logical formula true, most prominently the Boolean satisfiability problem (SAT). SAT is the canonical NP-complete problem, and modern SAT solvers can decide formulas with millions of variables despite this worst-case hardness. Satisfiability provides a unifying computational substrate for verification, planning, scheduling and many forms of automated reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:logic ;
    vc:bridgesTo ngm:constraint-satisfaction ;
    vc:contrastsWith ngm:optimisation ;
    vc:enables ngm:formal-verification,
        ngm:planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:reasoning ;
    vc:isPartOf ngm:logic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction,
        ngm:logic ;
    vc:requires ngm:knowledge-representation ;
    vc:slug "satisfiability" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:reasoning,
        ngm:theorem-proving ;
    vc:uses ngm:graph-search,
        ngm:search-algorithm .

ngm:scara-robot a owl:Class ;
    rdfs:label "SCARA Robot"@en ;
    rdfs:comment "Selective Compliance Articulated Robot Arm — a four-axis industrial robot with two rotary joints in the horizontal plane that give high compliance laterally whilst providing rigid vertical stiffness along the Z-axis. SCARA robots excel at high-speed pick-and-place, assembly, and packaging tasks that require precise horizontal positioning but resist vertical forces."@en ;
    rdfs:subClassOf ngm:industrial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-actuation-and-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:delta-robot,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:trajectory-planning ;
    vc:slug "scara-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:encoder,
        ngm:pid-control,
        ngm:servo-motor .

ngm:scene-representation a owl:Class ;
    rdfs:label "Scene Representation"@en ;
    rdfs:comment "Scene Representation is the set of data structures and mathematical models used to encode the geometry, appearance, and spatial relationships of objects within a 3D environment. Representations include polygonal meshes, voxel grids, point clouds, implicit surfaces, and neural radiance fields, each with different trade-offs in accuracy, compactness, and rendering speed. The choice of scene representation directly influences the quality and performance of spatial computing and computer vision systems."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rendering ;
    vc:slug "scene-representation" ;
    vc:sourceDomain "spatial-computing" .

ngm:schema-versioning a owl:Class ;
    rdfs:label "Schema Versioning"@en ;
    rdfs:comment "Schema versioning is the discipline of managing changes to a data schema over time so that producers and consumers can evolve independently without breaking interoperability. It defines policies and mechanisms — version identifiers, compatibility rules, deprecation windows and migration paths — that govern how additions, removals and modifications to fields and types are introduced. Robust schema versioning underpins reliable data interchange in distributed systems, event streams and long-lived APIs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backward-compatibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-versioning ;
    vc:bridgesTo ngm:schema-registry ;
    vc:contrastsWith ngm:api-versioning ;
    vc:dependsOn ngm:data-validation ;
    vc:enables ngm:backward-compatibility,
        ngm:interoperability ;
