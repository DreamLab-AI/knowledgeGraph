            owl:someValuesFrom ngm:training-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:meta-learning ],
        ngm:ai-infrastructure,
        ngm:automated-optimisation-system,
        ngm:machine-learning-pipeline ;
    vc:enables ngm:democratised-ml-development,
        ngm:rapid-model-iteration,
        ngm:reproducible-experiments,
        ngm:resource-efficient-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:algorithm-selection,
        ngm:feature-engineering-automation,
        ngm:hyperparameter-optimisation,
        ngm:meta-learning,
