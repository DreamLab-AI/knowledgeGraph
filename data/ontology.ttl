    vc:supports ngm:accessibility,
        ngm:localisation ;
    vc:uses ngm:adapter-modules,
        ngm:back-translation,
        ngm:bleu-score,
        ngm:comet-metric,
        ngm:data-augmentation .

ngm:transparency-reporting a owl:Class ;
    rdfs:label "Transparency Reporting"@en ;
    rdfs:comment "Transparency reporting is the periodic, structured disclosure by an organisation of metrics about its handling of user data, content moderation actions, government requests and enforcement decisions. It is a core accountability mechanism in platform governance, enabling regulators, researchers and the public to scrutinise how power is exercised over information and users. Reports typically quantify takedowns, account actions, legal demands and appeal outcomes over a defined period."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation ],
        ngm:accountability ;
    vc:contrastsWith ngm:self-regulation ;
    vc:enables ngm:regulatory-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit,
        ngm:compliance ;
    vc:isPartOf ngm:accountability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-services-act,
        ngm:ofcom,
        ngm:uk-online-safety-act ;
    vc:requires ngm:data-governance,
        ngm:regulation ;
    vc:slug "transparency-reporting" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance,
        ngm:platform-governance ;
    vc:uses ngm:content-moderation,
        ngm:data-analysis .

ngm:triangulation a owl:Class ;
    rdfs:label "Triangulation"@en ;
    rdfs:comment "Triangulation is the process of determining the 3D position of a point by intersecting lines of sight from two or more known viewpoints. Given calibrated cameras and corresponding image observations, it recovers depth and structure by solving for the point that best explains the rays. Triangulation is a core operation in stereo vision, photogrammetry, structure-from-motion, and positioning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bundle-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:gps ;
    vc:dependsOn ngm:depth-sensing ;
    vc:enables ngm:3d-mapping,
        ngm:point-cloud ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bundle-adjustment ;
    vc:implements ngm:projective-geometry ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:lidar,
        ngm:spatial-computing,
        ngm:structured-light ;
    vc:requires ngm:camera-calibration ;
    vc:slug "triangulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:photogrammetry,
        ngm:slam,
        ngm:stereo-vision ;
    vc:uses ngm:epipolar-geometry,
        ngm:feature-matching .

ngm:trust-building a owl:Class ;
    rdfs:label "Trust Building"@en ;
    rdfs:comment "Trust building is the deliberate process of establishing confidence among participants in a digital system through transparency, accountability, reliable behaviour, and clear communication. In online communities and AI-mediated platforms it is fostered by practices such as content provenance, disclosure of automated generation, and enforced community standards that make actors and outputs verifiable."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-generated-content-disclosure,
        ngm:community-standards ;
    vc:slug "trust-building" ;
    vc:sourceDomain "governance" .

ngm:trusted-third-party a owl:Class ;
    rdfs:label "Trusted Third Party"@en ;
    rdfs:comment "A trusted third party (TTP) is an intermediary that two or more parties rely upon to facilitate, witness, or settle an interaction without each party having to trust the other directly. Examples include certificate authorities, escrow agents, custodians, and clearing houses. Blockchain systems are largely motivated by the goal of minimising or eliminating trusted third parties, replacing institutional trust with cryptographic verification and decentralised consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        ngm:security ;
    vc:bridgesTo ngm:smart-contract ;
    vc:contrastsWith ngm:decentralized-exchange,
        ngm:self-custody,
        ngm:smart-contract ;
    vc:dependsOn ngm:custody ;
    vc:enables ngm:centralized-exchange,
        ngm:custodial-wallet ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:centralized-exchange,
        ngm:multisig,
        ngm:oracle ;
    vc:requires ngm:custody ;
    vc:slug "trusted-third-party" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:custody ;
    vc:uses ngm:certificate-authority,
        ngm:know-your-customer .

ngm:trustless-settlement a owl:Class ;
    rdfs:label "Trustless Settlement"@en ;
    rdfs:comment "Trustless settlement is a mechanism for finalising financial or asset-transfer transactions in which parties need not extend personal or institutional trust to a counterparty or intermediary because correctness is guaranteed by cryptographic protocols and verifiable distributed consensus. The term reflects the displacement of counterparty trust with algorithmic certainty: smart contracts hold and release assets conditionally on cryptographically verifiable proofs, and immutable ledger state provides objective post-settlement finality. Trustless settlement underpins DeFi protocols, atomic swaps, and cross-chain bridges, enabling transaction finality without custodial banks, clearinghouses, or escrow agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-time-locked-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:atomic-settlement ;
    vc:bridgesTo ngm:correspondent-banking,
        ngm:finance ;
    vc:contrastsWith ngm:central-counterparty-clearing,
        ngm:custodial-settlement ;
    vc:dependsOn ngm:blockchain,
        ngm:consensus ;
    vc:enables ngm:cross-border-payments,
        ngm:decentralized-exchange-dex,
        ngm:permissionless-trading,
        ngm:tokenised-securities ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-proof,
        ngm:hash-time-locked-contract,
        ngm:settlement-finality ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:decentralized-finance-de-fi,
        ngm:securities-settlement,
        ngm:zk-rollup ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:distributed-ledger,
        ngm:public-key-cryptography ;
    vc:slug "trustless-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:instant-value-settlement,
        ngm:programmable-money ;
    vc:uses ngm:automated-market-maker,
        ngm:consensus-mechanism,
        ngm:smart-contract-coordination,
        ngm:zero-knowledge .

ngm:uk-tech-ecosystem a owl:Class ;
    rdfs:label "UK Tech Ecosystem"@en ;
    rdfs:comment "The United Kingdom's technology industry landscape, ranked as Europe's leading tech ecosystem with a combined market valuation of $1.2 trillion and over 17,000 VC-backed startups; the third-largest AI market globally after the US and China, encompassing unicorns, regional clusters (London, Cambridge), venture capital flows, and national policy frameworks for digital innovation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:venture-capital ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-and-development ],
        ngm:infra-computing-and-cloud,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-computing-and-cloud,
        ngm:infra-software-engineering ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:digital-twin,
        ngm:distributed-collaboration,
        ngm:fintech ;
    vc:dependsOn ngm:cloud-computing,
        ngm:intellectual-property-law,
        ngm:regulatory-framework ;
    vc:enables ngm:ai-development,
        ngm:digital-innovation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:venture-capital ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:innovation ;
    vc:requires ngm:digital-infrastructure,
        ngm:research-and-development ;
    vc:slug "uk-tech-ecosystem" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:economic-development,
        ngm:national-ai-strategy,
        ngm:open-source-software .

ngm:unity a owl:Class ;
    rdfs:label "Unity"@en ;
    rdfs:comment "Unity is a cross-platform real-time 3D engine and editor used to build games, simulations and XR applications across desktop, mobile, console and head-mounted display targets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-pipeline ],
