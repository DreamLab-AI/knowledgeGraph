ngm:node-based-diffusion-pipeline-interface-manager a owl:Class ;
    rdfs:label "ComfyUI Manager"@en ;
    rdfs:comment "ComfyUI Manager is a community-developed extension for the ComfyUI node-based image and video generation interface that provides an integrated package management system for discovering, installing, updating, and disabling custom nodes and their Python dependencies. It maintains a curated registry of available custom node repositories and model assets, resolves dependency conflicts, and enables reproducible workflow sharing by exporting workflow snapshots that encode all required node specifications. The extension also integrates model management features for downloading checkpoint, LoRA, VAE, and ControlNet files from external repositories, and performs missing-node detection when importing workflows created on other machines. As the de facto package manager for the ComfyUI ecosystem, it substantially lowers the barrier to extending the platform with community-developed preprocessing, sampling, and post-processing nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:git ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:comfy-ui ],
        ngm:ai-application,
        ngm:package-manager ;
    skos:broader ngm:ai-application ;
    vc:contrastsWith ngm:automatic1111-web-ui,
        ngm:pip ;
    vc:dependsOn ngm:diffusion-models,
        ngm:gpu-compute,
        ngm:hugging-face,
        ngm:py-torch,
        ngm:python ;
    vc:enables ngm:community-extension-ecosystem,
        ngm:reproducible-ml-pipelines,
        ngm:workflow-portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:custom-node-registry,
        ngm:missing-node-detection,
        ngm:model-downloader,
        ngm:snapshot-management ;
    vc:isPartOf ngm:comfy-ui,
        ngm:open-generative-ai-tools ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:comfy-node-registry,
