        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cost-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kalman-filter ],
        ngm:ai-technique,
        ngm:computational-intelligence,
        ngm:dynamical-systems ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-system,
        ngm:energy-management,
        ngm:fault-tolerant-control,
        ngm:force-control,
        ngm:motion-planning,
        ngm:process-automation,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adaptation-law,
        ngm:cost-function,
        ngm:kalman-filter,
        ngm:pid-controller,
        ngm:receding-horizon,
        ngm:reference-model,
        ngm:reward-signal,
        ngm:safety-constraint,
        ngm:state-observer,
        ngm:switching-surface ;
