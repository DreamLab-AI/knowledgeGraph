ngm:crdt a owl:Class ;
    rdfs:label "CRDT"@en ;
    rdfs:comment "Conflict-free Replicated Data Types (CRDTs) are a family of data structures with mathematically proven convergence guarantees that allow multiple distributed replicas to be independently modified without requiring coordination, locks, or a consensus protocol, and which automatically merge to a si..."@en ;
