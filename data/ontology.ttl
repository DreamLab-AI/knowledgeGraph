            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dc-servo-motor ],
        ngm:electric-motor,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:manipulator-arm,
        ngm:robot-joint ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dc-servo-motor,
        ngm:pid-controller,
        ngm:rotary-encoder ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:motion-control,
        ngm:position-control,
        ngm:stepper-motor,
        ngm:torque-control ;
    vc:slug "servo-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:encoder .

ngm:sha-256 a owl:Class ;
    rdfs:label "SHA-256"@en ;
    rdfs:comment "Secure Hash Algorithm producing a deterministic 256-bit digest from arbitrary input, forming the cryptographic foundation of Bitcoin's proof-of-work, Merkle tree construction, block header chaining, and address derivation in most major blockchain systems. Produces avalanche-effect collision resistance with 2^128 preimage security."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:block-header,
        ngm:immutability,
        ngm:merkle-tree,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:merkle-proof,
        ngm:public-key ;
    vc:slug "sha-256" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function .

ngm:supervised-learning a owl:Class ;
    rdfs:label "Supervised Learning"@en ;
    rdfs:comment "Supervised Learning is the machine learning paradigm where models learn from labeled training data to predict outputs for new, unseen inputs. The learning algorithm finds patterns mapping input features to target labels, guided by a loss function measuring prediction errors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:reinforcement-learning,
        ngm:unsupervised-learning ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:loss-function,
        ngm:training-data ;
    vc:slug "supervised-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:system-architecture a owl:Class ;
    rdfs:label "System Architecture"@en ;
    rdfs:comment "System Architecture in AI defines the holistic structure integrating hardware, software, data infrastructure, and operational components to deliver intelligent capabilities at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
