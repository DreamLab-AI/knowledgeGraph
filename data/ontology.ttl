vf:open-generative-ai-tools a owl:Class ;
    rdfs:label "Open Generative AI tools"@en ;
    rdfs:comment "Open Generative AI tools is the ecosystem of openly licensed or openly released generative AI models, fine-tuning pipelines, inference infrastructure, and community-distribution platforms that collectively enable practitioners to download, modify, deploy, and share large-scale foundation models for text, image, video, audio, and multimodal generation without mandatory API intermediation. The domain spans the full production stack: (1) base model weight families including Llama 3/3.1/3.2/3.3 (Meta AI), Mistral 7B/Mixtral 8x7B/Mistral Large 2 (Mistral AI, Paris), Qwen 2.5 and Qwen 3 (Alibaba DAMO Academy), DeepSeek-V3 and DeepSeek-R1 (DeepSeek AI, Hangzhou), Gemma 2/3 (Google DeepMind), Phi-4 and Phi-4-Multimodal (Microsoft Research Cambridge), FLUX.1 dev/schnell (Black Forest Labs), Stable Diffusion 3.5 (Stability AI), AnimateDiff video generation, and ComfyUI orchestration; (2) community model repositories and marketplaces — Hugging Face Hub crossing 1 million public models in October 2024 and Civitai hosting 12M+ image-generation derivatives; (3) inference infrastructure including llama.cpp (CPU/GPU inference in C++), ollama (user-friendly model server), vLLM (production PagedAtte"@en ;
    rdfs:subClassOf <urn:visionflow:linked:ai-ecosystem>,
        <urn:visionflow:linked:open-source-software>,
        vf:foundation-models,
        vf:generative-ai,
        vf:large-language-models,
        vf:machine-learning-infrastructure ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:local-ai-deployment>,
        <urn:visionflow:linked:privacy-preserving-ai>,
        vf:agent-frameworks,
        vf:agents,
        vf:ai-adoption,
        vf:ai-diagram-tools,
        vf:cli-multi-agent-systems,
        vf:comfy-ui-workflows,
        vf:fine-tuning,
        vf:multimodal-ai ;
    vc:hasPart <urn:visionflow:linked:civitai>,
        <urn:visionflow:linked:hugging-face-hub>,
        <urn:visionflow:linked:llm-inference>,
        <urn:visionflow:linked:lo-ra-fine-tuning>,
        <urn:visionflow:linked:quantisation>,
