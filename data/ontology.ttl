ngm:superchain a owl:Class ;
    rdfs:label "Superchain"@en ;
    rdfs:comment "A superchain is a network of independent Layer-2 blockchains that share a common technical standard, security model, and communication layer so they interoperate as a unified system rather than isolated silos. Pioneered by the OP Stack ecosystem around Optimism, superchains let many rollups inherit the same upgrade path, governance, and eventually a shared sequencer, enabling low-latency cross-chain messaging and a consistent developer experience. The model addresses blockchain fragmentation by treating horizontal scaling as a coordinated mesh of homogeneous chains that settle to a common Layer 1."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base ],
        ngm:rollup ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:blockchain-scalability,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:base ;
    vc:isPartOf ngm:op-stack,
        ngm:optimism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:modular-blockchain,
        ngm:rollup ;
    vc:requires ngm:governance ;
    vc:slug "superchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bridge,
        ngm:optimistic-rollup .

ngm:supply-and-demand a skos:Concept ;
    rdfs:label "Supply And Demand"@en .

ngm:supply-chain-decarbonisation a owl:Class ;
    rdfs:label "Supply Chain Decarbonisation"@en ;
    rdfs:comment "Supply chain decarbonisation is the systematic reduction of greenhouse gas emissions arising across an organisation's upstream and downstream value chain, including the indirect Scope 3 emissions that typically dominate a company's total footprint. It combines supplier engagement, low-carbon procurement, logistics optimisation, materials substitution and product redesign with rigorous emissions accounting. Because most value-chain emissions lie outside a firm's direct operational control, decarbonisation depends on data sharing, contractual incentives and collaboration across many tiers of suppliers. It is a core operational lever within broader climate governance and net-zero strategy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:greenhouse-gas-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        ngm:decarbonisation ;
    vc:bridgesTo ngm:climate-governance,
        ngm:supply-chain ;
    vc:dependsOn ngm:esg-reporting ;
    vc:enables ngm:net-zero ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decarbonisation ;
    vc:isPartOf ngm:climate-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:renewable-energy,
        ngm:scope-1-emissions ;
    vc:requires ngm:greenhouse-gas-protocol,
        ngm:scope-3-emissions ;
    vc:slug "supply-chain-decarbonisation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:net-zero,
        ngm:sustainability-reporting ;
    vc:uses ngm:carbon-footprint,
        ngm:life-cycle-assessment .

ngm:supply-chain-finance a owl:Class ;
    rdfs:label "Supply Chain Finance"@en ;
    rdfs:comment "Supply chain finance is a set of financing and risk-mitigation techniques that optimise working capital and liquidity across the parties in a supply chain. It typically allows suppliers to receive early payment on approved invoices while buyers extend their payment terms, using the buyer's stronger credit standing to lower financing costs. Blockchain and distributed-ledger implementations add shared visibility, automated settlement and tamper-evident provenance to these flows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-tokenization ],
        ngm:trade-finance ;
    vc:bridgesTo ngm:supply-chain,
        ngm:trade-finance ;
    vc:dependsOn ngm:payment-settlement,
        ngm:supply-chain-transparency ;
    vc:enables ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:procurement,
        ngm:trade-finance-automation ;
    vc:requires ngm:asset-tokenization ;
    vc:slug "supply-chain-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity-management,
        ngm:supply-chain-visibility ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:smart-contract .

ngm:supply-chain-resilience a owl:Class ;
    rdfs:label "Supply Chain Resilience"@en ;
    rdfs:comment "Supply chain resilience is the capacity of a supply network to anticipate, absorb, adapt to, and recover from disruptions while maintaining the continuity of supply at acceptable cost and service levels. It combines visibility into the network, redundancy and flexibility in sourcing and capacity, and the ability to reconfigure flows when shocks occur. Resilience strategies balance efficiency against the buffers and diversification needed to withstand events such as supplier failure, natural disaster, or demand volatility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        ngm:supply-chain ;
    vc:bridgesTo ngm:business-continuity,
        ngm:logistics ;
    vc:contrastsWith ngm:inventory-management ;
    vc:dependsOn ngm:risk-assessment ;
    vc:enables ngm:business-continuity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:risk-management ;
    vc:isPartOf ngm:supply-chain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:resilience,
        ngm:risk-management ;
    vc:requires ngm:risk-management,
        ngm:traceability ;
    vc:slug "supply-chain-resilience" ;
    vc:sourceDomain "supply-chain" ;
    vc:supports ngm:logistics ;
    vc:uses ngm:inventory-management,
        ngm:redundancy .

ngm:sustainability-framework a owl:Class ;
    rdfs:label "Sustainability Framework"@en ;
    rdfs:comment "A sustainability framework is a structured set of principles, metrics, and reporting standards used to measure and manage the environmental, social, and governance impact of an organisation or system. It defines what to measure, how to compute indicators such as carbon footprint, and how to disclose results so that performance can be compared and audited. Frameworks like GHG Protocol and emerging crypto-specific schemes provide the methodological backbone for sustainability claims."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-token,
        ngm:environmental-impact-metric ;
    vc:slug "sustainability-framework" ;
    vc:sourceDomain "governance" .

ngm:sustainable-technology a owl:Class ;
    rdfs:label "Sustainable Technology"@en ;
    rdfs:comment "Technology designed, deployed, and operated to minimise long-term environmental impact through energy efficiency, use of renewable energy sources, responsible lifecycle management, and reduction of waste and carbon emissions. In IT and spatial computing contexts this encompasses energy-efficient data centres, green cloud computing, virtualisation, sustainable software engineering practices, circular economy principles applied to hardware, and AI-driven optimisation of resource consumption. Sustainable technology sits at the intersection of governance, infrastructure design, and environmental accountability, and is increasingly mandated by corporate ESG commitments and governmental net-zero regulations."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-transformation,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:carbon-neutral-blockchain,
        ngm:circular-economy,
        ngm:governance,
        ngm:renewable-energy-certificates,
        ngm:sustainability ;
    vc:slug "sustainable-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:carbon-accounting,
        ngm:environmental-accounting .

ngm:swarm-robot a owl:Class ;
    rdfs:label "Swarm Robot"@en ;
    rdfs:comment "A Swarm Robot is a member of a multi-agent robotic system in which large numbers of simple, decentralised agents coordinate through local interactions to achieve complex collective behaviours without centralised control. Drawing from biological models such as ant colonies and flocking birds, swarm robotics enables robustness through redundancy, scalability, and emergent task execution across domains including environmental monitoring, logistics, and disaster response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swarm-robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collective-intelligence-system ],
        ngm:autonomous-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:centralized-swarm-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:collective-intelligence-system,
        ngm:swarm-robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robo-navigation-and-planning,
        ngm:robo-safety-and-standards ;
    vc:slug "swarm-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:decentralized-swarm-control,
        ngm:multi-agent-systems .

ngm:symmetric-cryptography a owl:Class ;
    rdfs:label "Symmetric Cryptography"@en ;
    rdfs:comment "Symmetric cryptography is a class of cryptographic techniques in which the same secret key is used for both encryption and decryption. It includes block ciphers and stream ciphers and underpins fast bulk data protection and authenticated encryption. Its security depends on keeping the shared key secret and on secure key distribution, which is often handled by asymmetric methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symmetric-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:aes-gcm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        ngm:cryptography ;
    vc:contrastsWith ngm:asymmetric-cryptography,
        ngm:public-key-cryptography ;
    vc:dependsOn ngm:key-exchange,
        ngm:key-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:aes-gcm,
        ngm:symmetric-key ;
    vc:implements ngm:authenticated-encryption,
        ngm:symmetric-encryption ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-primitive,
        ngm:tls ;
    vc:requires ngm:random-number-generation ;
    vc:slug "symmetric-cryptography" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-confidentiality,
        ngm:encryption ;
    vc:uses ngm:cryptographic-algorithm,
        ngm:cryptographic-key .

ngm:synthetic-data-generator a owl:Class ;
    rdfs:label "Synthetic Data Generator"@en ;
    rdfs:comment "AI-powered system that produces artificial datasets preserving statistical properties and structural characteristics of original data while protecting privacy and enabling testing scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
