ngm:demand-response-mining a owl:Class ;
    rdfs:label "Demand Response Mining"@en ;
    rdfs:comment "Demand response mining is the practice of operating cryptocurrency miners as a flexible, interruptible electrical load that ramps up or down in response to grid conditions and price signals. Miners absorb surplus or stranded generation and shut off during peak demand, helping balance the grid while monetising otherwise curtailed energy. It is studied as both a grid-stabilisation tool and a mitigation for the environmental criticism of proof-of-work mining."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-environmental-issues,
        ngm:stranded-energy-monetisation ;
    vc:slug "demand-response-mining" ;
    vc:sourceDomain "blockchain" .

