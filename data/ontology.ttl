        ngm:runtime-environment ;
    vc:requires ngm:runtime-environment ;
    vc:slug "event-loop" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asynchronous-programming ;
    vc:uses ngm:message-queue .

ngm:exoskeleton-robot a owl:Class ;
    rdfs:label "Exoskeleton Robot"@en ;
    rdfs:comment "Exoskeleton Robot - A wearable robotic framework that augments human strength and endurance by providing motorised Joint Support and force amplification, reducing musculoskeletal strain during heavy lifting, hazardous material handling, or prolonged repetitive tasks."@en ;
