        ngm:prosthetics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:sensor ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:haptics,
        ngm:human-computer-interaction,
        ngm:sensor ;
    vc:requires ngm:classification ;
    vc:slug "electromyography" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-computer-interaction ;
    vc:uses ngm:feature-extraction,
        ngm:signal-processing .

