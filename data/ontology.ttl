        ngm:digital-twin,
        ngm:virtual-reality ;
    vc:contrastsWith ngm:image-recognition,
        ngm:image-segmentation ;
    vc:dependsOn ngm:gpu-computing,
        ngm:latent-space ;
    vc:enables ngm:computer-graphics,
        ngm:data-augmentation,
        ngm:synthetic-data-generation,
        ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:image-inpainting,
        ngm:image-super-resolution,
        ngm:text-to-image-generation ;
    vc:implements ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:variational-autoencoder ;
    vc:isPartOf ngm:computer-vision,
