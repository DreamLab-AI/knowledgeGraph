ngm:query-engine a owl:Class ;
    rdfs:label "Query Engine"@en ;
    rdfs:comment "A query engine is the software component that parses, plans, optimises, and executes declarative queries against one or more data stores, returning result sets to callers. It transforms a high-level query into an efficient physical execution plan using statistics, indexes, and cost models, and may operate over a single database, a data warehouse, or federated sources, forming the computational core of database and analytics systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:indexing ],
        ngm:database-system ;
    vc:dependsOn ngm:data-management ;
    vc:enables ngm:full-text-search,
        ngm:olap ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:indexing ;
    vc:implements ngm:sql ;
    vc:isPartOf ngm:database-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:columnar-storage,
        ngm:olap ;
    vc:requires ngm:indexing ;
    vc:slug "query-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-warehouse ;
    vc:uses ngm:columnar-storage,
        ngm:sql .

ngm:radar a owl:Class ;
    rdfs:label "Radar"@en ;
    rdfs:comment "Radar is a sensing technology that transmits radio waves and measures their reflections to determine the range, velocity, and angle of objects; it is used in robotics, autonomous vehicles, aviation, and defence for reliable perception under all weather and lighting conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:radio-frequency-spectrum ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:antenna-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        ngm:sensor ;
    vc:bridgesTo ngm:environmental-sensing ;
    vc:contrastsWith ngm:camera,
        ngm:lidar,
        ngm:ultrasonic-sensor ;
    vc:enables ngm:collision-avoidance,
        ngm:object-detection,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:antenna-array,
        ngm:receiver,
        ngm:transmitter ;
    vc:isPartOf ngm:autonomous-vehicle,
        ngm:perception-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:electromagnetic-wave,
        ngm:point-cloud ;
    vc:requires ngm:radio-frequency-spectrum,
        ngm:signal-processing ;
    vc:slug "radar" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee-802-11 ;
    vc:uses ngm:beamforming,
        ngm:doppler-effect,
        ngm:time-of-flight .

ngm:random-oracle-model a owl:Class ;
    rdfs:label "Random Oracle Model"@en ;
    rdfs:comment "The Random Oracle Model (ROM) is a theoretical framework in cryptography that idealises a cryptographic hash function as a publicly accessible, truly random function: for every distinct input the oracle returns an independent, uniformly random output, while repeated queries return the same value. Introduced formally by Bellare and Rogaway in 1993, the ROM enables security proofs for practical schemes such as RSA-OAEP, ECDSA, and Schnorr signatures that cannot currently be proved secure under standard computational assumptions alone. Because no concrete hash function perfectly instantiates a random oracle, ROM proofs are treated as strong heuristic evidence rather than unconditional guarantees, and pathological counterexamples exist that are ROM-secure but concretely insecure under any hash instantiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contract,
        ngm:verifiable-random-function ;
    vc:enables ngm:digital-signature,
        ngm:key-derivation-function,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:sha-256,
        ngm:sha-3 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ecdsa,
        ngm:fiat-shamir-transform,
        ngm:post-quantum-cryptography,
        ngm:schnorr-signature ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:slug "random-oracle-model" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:computational-complexity-theory .

ngm:rapid-prototyping a owl:Class ;
    rdfs:label "Rapid Prototyping"@en ;
    rdfs:comment "Rapid Prototyping is an iterative product development approach that emphasises the construction of quick, low-fidelity or medium-fidelity artefacts—physical mock-ups, interactive wireframes, or functional code spikes—to test hypotheses with users and stakeholders before committing to full implementation. The methodology aims to compress the feedback loop between ideation and validated learning, reducing the risk of building features that do not meet user needs. It draws on lean startup principles, agile sprint structures, and design thinking frameworks, integrating user testing results directly into successive prototype iterations. Modern generative AI tools further accelerate rapid prototyping by auto-generating code scaffolds, UI components, and content variants."@en ;
    rdfs:subClassOf ngm:design-thinking ;
    vc:enables ngm:development-platform,
        ngm:digital-content-creation,
        ngm:product-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:human-computer-interaction,
        ngm:knowledge-management ;
    vc:slug "rapid-prototyping" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:ai-development-tools,
        ngm:collaborative-systems-modality-design,
        ngm:generative-design-tool,
        ngm:user-experience .

ngm:rb-0056-impedance-control a owl:Class ;
    rdfs:label "rb 0056 impedance control"@en ;
    rdfs:comment "Impedance control is a robot interaction-control strategy that regulates the dynamic relationship between end-effector force and motion by imposing a desired mechanical impedance (mass, damping, stiffness) on the robot's behaviour at the point of contact. Rather than commanding precise positions or forces independently, impedance control allows compliant, safe physical interaction with humans or uncertain environments by shaping the robot's apparent mechanical response. It is fundamental to collaborative robotics, enabling robots to yield to external forces in a controlled manner without requiring an explicit force setpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        ngm:interaction-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0053-force-control,
        ngm:rb-0057-admittance-control ;
    vc:requires ngm:rb-0067-force-torque-sensor,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0056-impedance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0007-collaborative-robot,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0090-emergency-stop a owl:Class ;
    rdfs:label "rb 0090 emergency stop"@en ;
    rdfs:comment "An Emergency Stop (E-stop) is a safety function that immediately removes power or halts the motion of a robot system upon activation, bringing the robot to a controlled or uncontrolled halt to prevent injury or damage. Defined under ISO 10218 and IEC 60204-1, it is a hardwired, independently monitored stop category (typically Stop Category 0 or 1) that takes priority over all other controls. E-stops must be clearly marked, accessible, and self-latching so that the robot cannot restart until the stop is deliberately reset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:contrastsWith ngm:rb-0093-speed-limitation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0090-emergency-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:functional-safety,
        ngm:iso-10218 .

ngm:re-act-pattern a owl:Class ;
    rdfs:label "ReAct Pattern"@en ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting and agent-control pattern in which a language model interleaves explicit reasoning traces with action steps such as tool calls, observing the results before reasoning again. This loop lets the model decompose tasks, gather information, and self-correct rather than answering in a single pass. It is a foundational design for tool-using LLM agents."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:function-calling ;
    vc:slug "re-act-pattern" ;
    vc:sourceDomain "ai" .

ngm:reserve-asset a owl:Class ;
    rdfs:label "Reserve Asset"@en ;
    rdfs:comment "An asset held to back a liability or to provide a store of value, such as the holdings that back a stablecoin or the foreign currency reserves held by a central bank. Its purpose is to ensure that claims can be met."@en ;
    rdfs:subClassOf ngm:stablecoin ;
    vc:enables ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "reserve-asset" ;
    vc:sourceDomain "finance" .

ngm:reward-hacking a owl:Class ;
    rdfs:label "Reward Hacking"@en ;
    rdfs:comment "Reward hacking is a failure mode in which a reinforcement-learning agent achieves high reward by exploiting flaws, loopholes or proxies in its reward function rather than accomplishing the intended task. Because the reward is only an imperfect proxy for the designer's true objective, an optimiser may discover unintended behaviours that maximise the measured reward while violating the spirit of the goal. It is a central concern in AI safety and alignment and is closely related to specification gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:ai-safety ;
    vc:contrastsWith ngm:ai-alignment,
        ngm:value-alignment ;
    vc:dependsOn ngm:reward-model ;
    vc:enables ngm:specification-gaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-safety ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:exploit,
        ngm:reinforcement-learning,
        ngm:reward-shaping ;
    vc:requires ngm:reward-function ;
    vc:slug "reward-hacking" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:robustness ;
    vc:uses ngm:reinforcement-learning .

ngm:reward-signal a owl:Class ;
    rdfs:label "Reward Signal"@en ;
    rdfs:comment "A reward signal is the scalar feedback an agent receives from its environment in reinforcement learning, indicating the immediate desirability of the state-action pair just experienced. It is the primary mechanism by which goals are communicated to a learning agent, which seeks to maximise the cumulative reward it accumulates over time rather than any single immediate value. The design of the reward signal strongly shapes learned behaviour, and poorly specified rewards can lead to unintended or degenerate strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:markov-decision-process ;
    vc:enables ngm:value-function ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:reward-function ;
    vc:isPartOf ngm:markov-decision-process,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agent,
        ngm:decision-making,
        ngm:reinforcement-learning,
        ngm:temporal-difference-learning ;
    vc:requires ngm:agent ;
    vc:slug "reward-signal" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:temporal-difference-learning,
        ngm:value-function ;
    vc:uses ngm:reward-function .

ngm:rgb-protocol a owl:Class ;
    rdfs:label "RGB Protocol"@en ;
    rdfs:comment "RGB Protocol is a client-side validation smart-contract system built on Bitcoin and the Lightning Network that enables issuance, transfer, and programmable logic over tokenised assets (fungible and non-fungible) without placing contract state on the public blockchain. Contract state is stored in off-chain client-held directed acyclic graphs (DAGs), with only cryptographic commitments anchored to Bitcoin UTXOs via single-use seals, inheriting Bitcoin's security and censorship resistance while providing scalability, privacy, and programmability unavailable to purely on-chain designs. The AluVM virtual machine executes contract validation logic deterministically off-chain, and Lightning Network channels enable instant, low-fee RGB asset transfers. Developed by the LNP/BP Association from 2018 onward, RGB reached production stability in 2024 with standardised schemas RGB20 (fungible tokens) and RGB21 (non-fungible tokens)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:taproot ],
        ngm:blockchain-protocol ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-management ;
    vc:contrastsWith ngm:ethereum-smart-contract-platform-smart-contracts,
        ngm:ordinals,
        ngm:runes-protocol,
        ngm:taproot-assets ;
    vc:enables ngm:asset-tokenization,
        ngm:layer-2-scaling,
        ngm:non-fungible-token,
        ngm:privacy-preserving-computation,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:client-side-validation,
        ngm:deterministic-bitcoin-commitment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:lnp-bp-standards-association,
        ngm:rgb-and-client-side-validation,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:bitcoin-transaction,
        ngm:merkle-tree,
        ngm:taproot ;
    vc:slug "rgb-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-network,
        ngm:cryptographic-commitment,
        ngm:lightning-network,
        ngm:single-use-seals,
        ngm:utxo-model .

ngm:rust-systems-programming-language a owl:Class ;
    rdfs:label "Rust Systems Programming Language"@en ;
    rdfs:comment "Rust is a compiled, statically typed systems programming language created at Mozilla Research and first released in 2015, designed to provide C-like performance and low-level memory control without the memory safety vulnerabilities that plague C and C++. Its defining innovation is the ownership-and-borrowing type system, which enforces at compile time that each value has exactly one owner, references obey strict lifetime rules, and data races are structurally impossible — all without a garbage collector. Rust has rapidly become the preferred language for writing safe, high-performance systems software, blockchain runtimes, WebAssembly modules, embedded firmware, and operating system kernels."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:enables ngm:embedded-systems,
        ngm:high-performance-computing,
        ngm:web-assembly ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:performance-optimization,
        ngm:runtime-environment ;
    vc:slug "rust-systems-programming-language" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-systems .

ngm:safety-critical-systems a owl:Class ;
    rdfs:label "Safety-Critical Systems"@en ;
    rdfs:comment "Safety-critical systems are hardware and software systems whose failure or malfunction could result in death, serious injury, significant property damage, or severe environmental harm. They are subject to rigorous engineering processes, formal standards, and independent certification to demonstrate that residual risk is reduced to an acceptable level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        ngm:systems-engineering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems ;
    vc:requires ngm:formal-verification,
        ngm:functional-safety,
        ngm:hazard-analysis ;
    vc:slug "safety-critical-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:do-178-c,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:uses ngm:fault-tolerance,
        ngm:reliability-engineering .

ngm:safety-engineering a owl:Class ;
    rdfs:label "Safety Engineering"@en ;
    rdfs:comment "Safety engineering is the engineering discipline concerned with designing systems that avoid causing harm to people, property, and the environment under both normal and fault conditions. It applies hazard analysis, redundancy, fail-safe design, and quantified risk assessment across the system lifecycle. Functional safety and reliability engineering are specialised branches that address fault behaviour and dependable operation."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:reliability-engineering ;
    vc:slug "safety-engineering" ;
    vc:sourceDomain "robotics" .

ngm:scaled-dot-product-attention a owl:Class ;
    rdfs:label "Scaled Dot Product Attention"@en ;
    rdfs:comment "An attention mechanism that computes attention weights using the dot product of queries and keys, scaled by the square root of the key dimension, followed by a softmax normalisation."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:attention-mechanism ;
    skos:broader ngm:ai-model-architecture ;
