ngm:ai-safety a owl:Class ;
    rdfs:label "AI Safety"@en ;
    rdfs:comment "AI Safety is the interdisciplinary field of research and engineering practice dedicated to ensuring that artificial intelligence systems behave reliably, predictably, and in accordance with human values and intentions across their full operational lifecycle. It addresses near-term concerns such as robustness, distributional shift, and adversarial vulnerability, as well as longer-horizon concerns about advanced systems whose objectives may diverge from human welfare. Core techniques include formal verification of safety properties, interpretability methods that expose model internals, corrigibility mechanisms that preserve human oversight, and red-teaming to surface failure modes before deployment. AI Safety is increasingly embedded in regulatory frameworks and standard-setting processes governing high-risk AI applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:security,
        ngm:smart-contract ;
    vc:contrastsWith ngm:ai-capabilities-research ;
    vc:enables ngm:human-ai-collaboration,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance ;
