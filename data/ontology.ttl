        ngm:sybil-attack,
        ngm:sybil-resistance ;
    vc:slug "peer-discovery" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bootstrap-node,
        ngm:gossip-protocol .

ngm:photorealistic-rendering a owl:Class ;
    rdfs:label "Photorealistic Rendering"@en ;
    rdfs:comment "Photorealistic Rendering is the computational process of generating images from 3D scene descriptions that are visually indistinguishable from photographs, achieved through physically accurate simulation of light transport, material properties, camera optics, and atmospheric phenomena. Core algorithms include path tracing and bidirectional path tracing, which apply Monte Carlo integration over the rendering equation to compute global illumination, caustics, subsurface scattering, and volumetric effects. Modern implementations leverage GPU hardware ray-tracing acceleration, physically based rendering (PBR) material models such as the Cook-Torrance BRDF, and AI-driven denoising to make high-fidelity output feasible in interactive and real-time contexts. Photorealistic rendering underpins digital twin visualisation, cinematic virtual production, immersive XR experiences, and AI-generated synthetic training data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:global-illumination ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ambient-occlusion ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:generative-ai,
        ngm:machine-learning ;
    vc:dependsOn ngm:3-d-rendering-engine,
        ngm:rendering-equation ;
    vc:enables ngm:3-d-gaussian-splatting,
        ngm:digital-twin,
        ngm:real-time-rendering,
        ngm:synthetic-data-generation,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ambient-occlusion,
        ngm:global-illumination,
        ngm:subsurface-scattering,
        ngm:volumetric-rendering ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:denoising,
        ngm:neural-radiance-field,
        ngm:rasterisation ;
    vc:requires ngm:3-d-geometry,
        ngm:gpu-computing,
        ngm:scene-graph ;
    vc:slug "photorealistic-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:opengl,
        ngm:vulkan ;
    vc:uses ngm:bidirectional-reflectance-distribution-function,
        ngm:monte-carlo-integration,
        ngm:path-tracing,
        ngm:physically-based-rendering,
        ngm:ray-tracing,
        ngm:shader .

ngm:platform-governance a owl:Class ;
    rdfs:label "Platform Governance"@en ;
    rdfs:comment "Platform governance encompasses the formal and informal rules, decision-making processes, and control mechanisms that determine how blockchain and decentralised platforms operate, evolve, and distribute power among stakeholders. It includes on-chain mechanisms such as token-weighted voting and smart contract-executed decisions, as well as off-chain processes including community discussions, improvement proposals, and delegated representation structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:treasury-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        ngm:decentralised-governance ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:centralised-governance,
        ngm:corporate-governance ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptographic-identity,
        ngm:smart-contract ;
    vc:enables ngm:community-coordination,
        ngm:decentralised-decision-making,
        ngm:protocol-upgrade ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-proposal,
        ngm:off-chain-governance,
        ngm:on-chain-governance,
        ngm:treasury-management ;
    vc:implements ngm:delegated-representation,
        ngm:quadratic-voting ;
    vc:isPartOf ngm:decentralised-autonomous-organisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:reputation-system,
        ngm:voter-apathy ;
    vc:requires ngm:quorum-mechanism,
        ngm:stakeholder-participation,
        ngm:token-weighted-voting ;
    vc:slug "platform-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability-mechanism,
        ngm:transparency ;
    vc:uses ngm:governance-token,
