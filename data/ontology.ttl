    vc:sourceDomain "governance" .

ngm:large-scale-datasets a owl:Class ;
    rdfs:label "Large-Scale Datasets"@en ;
    rdfs:comment "Large-scale datasets are very large collections of data, often spanning billions of examples and many terabytes, assembled to train modern machine learning models. They are typically aggregated from web crawls, public corpora and curated sources, then filtered, deduplicated and tokenised. Their scale, diversity and quality are primary determinants of the capabilities of large language and generative models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "large-scale-datasets" ;
    vc:sourceDomain "ai" .

ngm:layer-1 a owl:Class ;
    rdfs:label "Layer 1"@en ;
    rdfs:comment "The base settlement layer of a blockchain network where consensus and final transaction ordering occur, as distinct from protocols built on top of it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        ngm:blockchain-domain ;
    vc:enables ngm:layer-2-networks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:consensus-protocol ;
    vc:slug "layer-1" ;
    vc:sourceDomain "blockchain" .

ngm:layer2-scaling a owl:Class ;
    rdfs:label "Layer2Scaling"@en ;
    rdfs:comment "Off-chain scaling solutions executing transactions on secondary networks ({{Rollups}}, PaymentChannels, {{Sidechains}}) that batch and settle to base layer (ereum mainnet), reducing transaction costs 100-1000x whilst maintaining security through CryptographicProof|cryptographic proofs."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-scalability ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:high-throughput-transaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "layer2-scaling" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof .

ngm:layout-engine a owl:Class ;
    rdfs:label "Layout Engine"@en ;
    rdfs:comment "A layout engine is a software component that applies one or more layout algorithms to a model of visual elements and produces a concrete arrangement ready for rendering. It manages coordinate systems, constraint solving, sizing, and incremental relayout in response to data changes. Layout engines power diagram tools, document renderers, and graphical user interface frameworks."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diagrams-as-code,
        ngm:layout-algorithm ;
    vc:slug "layout-engine" ;
    vc:sourceDomain "infrastructure" .

ngm:legal-entity-identifier a owl:Class ;
    rdfs:label "Legal Entity Identifier"@en ;
    rdfs:comment "A Legal Entity Identifier (LEI) is a 20-character alphanumeric code, standardised as ISO 17442, that uniquely identifies a legally distinct entity participating in financial transactions. It is issued by accredited Local Operating Units under the Global LEI System and carries reference data on the entity's ownership and registration. LEIs enable counterparty transparency and are increasingly required for regulatory and trade reporting."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting,
        ngm:travel-rule ;
    vc:slug "legal-entity-identifier" ;
    vc:sourceDomain "governance" .

ngm:legal-entity-structure a owl:Class ;
    rdfs:label "Legal Entity Structure"@en ;
    rdfs:comment "A legal entity structure is the organisational arrangement of incorporated bodies, subsidiaries, foundations, and operating companies through which an organisation conducts business and holds assets. It determines liability boundaries, tax treatment, governance rights, and regulatory obligations across jurisdictions. In crypto and DAO contexts it often pairs on-chain governance with off-chain foundations or LLCs to obtain legal personality."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-border-compliance,
        ngm:treasury-management ;
    vc:slug "legal-entity-structure" ;
    vc:sourceDomain "governance" .

ngm:legal-expertise a owl:Class ;
    rdfs:label "Legal Expertise"@en ;
    rdfs:comment "Legal expertise is the specialised knowledge and professional judgement required to interpret statutes, regulations, contracts, and case law and to apply them to specific situations. In technology and blockchain settings it spans securities, data-protection, intellectual-property, and cross-border regulatory analysis. It is a prerequisite for designing compliant products and navigating multi-jurisdictional obligations."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-standards,
        ngm:cross-border-compliance ;
    vc:slug "legal-expertise" ;
    vc:sourceDomain "governance" .

ngm:legal-wrapper a owl:Class ;
    rdfs:label "Legal Wrapper"@en ;
    rdfs:comment "A legal wrapper is an off-chain legal entity, such as a foundation, LLC, or association, established to give a DAO or on-chain protocol recognised legal personality. It enables the organisation to enter contracts, hold assets, limit member liability, and interface with regulators while preserving on-chain governance. Jurisdictions like Wyoming (DAO LLC), the Marshall Islands, and the Cayman Islands offer purpose-built wrapper forms."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-tooling,
        ngm:enterprise-token-standards ;
    vc:slug "legal-wrapper" ;
    vc:sourceDomain "governance" .

ngm:liberal-radicalism a owl:Class ;
    rdfs:label "Liberal Radicalism"@en ;
    rdfs:comment "Liberal Radicalism (LR) is a mechanism-design framework, introduced by Buterin, Hitzig, and Weyl, for optimally funding public goods through a matching scheme in which contributions are pooled and the matching amount allocated to each project grows with the square of the sum of the square roots of individual contributions. This mathematical structure rewards the breadth of support — the number of distinct contributors — over the concentration of large donations, aligning funding with collective preference. It is the theoretical basis for quadratic funding as deployed in real-world grants programmes."@en ;
    rdfs:subClassOf ngm:mechanism-design ;
    vc:enables ngm:public-goods-funding,
        ngm:quadratic-funding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:quadratic-voting ;
    vc:slug "liberal-radicalism" ;
    vc:sourceDomain "governance" .

ngm:likelihood-function a owl:Class ;
    rdfs:label "Likelihood Function"@en ;
    rdfs:comment "A likelihood function expresses the probability of observed data as a function of the parameters of a statistical model, treating the data as fixed and the parameters as variable. It is the central object in maximum-likelihood estimation and Bayesian inference, where it weights how well candidate parameter values explain the evidence. In sequential filtering it scores how consistent each hypothesis is with a new measurement."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:particle-filter,
        ngm:probabilistic-model ;
    vc:slug "likelihood-function" ;
    vc:sourceDomain "ai" .

ngm:linux-foundation a owl:Class ;
    rdfs:label "Linux Foundation"@en ;
    rdfs:comment "The Linux Foundation is a non-profit technology consortium established in 2000 that provides governance, infrastructure, legal frameworks, and community support for open-source software projects of global significance. It hosts the Linux kernel project alongside hundreds of collaborative projects spanning cloud-native computing (CNCF, Kubernetes), networking, security, blockchain (Hyperledger), AI (LF AI & Data), automotive, and open standards development. The Linux Foundation operates a neutral shared governance model in which competing commercial organisations collaborate on foundational technology layers, pooling resources to reduce duplicated effort and accelerating adoption of interoperable open standards. Its project portfolio collectively represents some of the most widely deployed software infrastructure in the world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cncf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperledger-foundation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kubernetes ],
        ngm:standards-body ;
    vc:enables ngm:open-source-development,
        ngm:open-standard,
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cncf,
        ngm:hyperledger-foundation,
        ngm:kubernetes ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:open-source-software,
        ngm:standardization-bodies ;
    vc:slug "linux-foundation" ;
    vc:sourceDomain "governance" .

ngm:llama a owl:Class ;
    rdfs:label "Llama"@en ;
    rdfs:comment "Llama is a family of large language models developed by Meta and released, in large part, with open weights for research and commercial use. First introduced in 2023 with LLaMA, followed by Llama 2, Llama 3 and later versions, the models are transformer-based and trained on large text corpora. By releasing model weights under permissive terms, Meta enabled a wide range of independent fine-tuning and deployment, making Llama a common base for open models. The family spans several parameter sizes to suit different compute and latency requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:machine-learning-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:transformer ;
    vc:slug "llama" ;
    vc:sourceDomain "llama" .

ngm:llama-3 a owl:Class ;
    rdfs:label "Llama 3"@en ;
    rdfs:comment "Llama 3 is a family of open-weight large language models developed and released by Meta AI in April 2024, spanning 8 billion and 70 billion parameter base and instruction-tuned variants, with a 405 billion parameter model subsequently released in July 2024. Llama 3 models are trained on approximately 15 trillion tokens from a curated multilingual corpus, use a 128,000-token vocabulary with a custom BPE tokeniser, incorporate grouped-query attention for inference efficiency, and are post-trained with supervised fine-tuning and reinforcement learning from human feedback. The models are released under a custom Meta Llama 3 Community License that permits commercial use for most organisations while imposing restrictions on deployments exceeding 700 million monthly active users."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:enables ngm:fine-tuning,
        ngm:inference-engine,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:benchmarks,
        ngm:meta-ai,
        ngm:model-weights,
        ngm:safety-and-alignment ;
    vc:slug "llama-3" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:instruction-tuning,
        ngm:rlhf,
        ngm:transformer-architecture .

ngm:llm-application-framework a owl:Class ;
    rdfs:label "LLM Application Framework"@en ;
    rdfs:comment "A software library that provides abstractions for building applications on top of large language models, including prompt management, tool integration, retrieval and chaining of model calls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:large-language-models ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:large-language-models ;
    vc:slug "llm-application-framework" ;
    vc:sourceDomain "natural-language-processing" .

ngm:llm-orchestration a owl:Class ;
    rdfs:label "LLM Orchestration"@en ;
    rdfs:comment "The coordination of multiple calls to one or more large language models, together with tools, retrieval and control logic, to accomplish a task that a single prompt cannot reliably handle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:large-language-models ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:tool-use ;
    vc:slug "llm-orchestration" ;
    vc:sourceDomain "natural-language-processing" .

ngm:load-balancer a owl:Class ;
    rdfs:label "Load Balancer"@en ;
    rdfs:comment "A component that distributes incoming network or application traffic across multiple servers to improve throughput, reliability and resource utilisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-architecture ],
        ngm:network-architecture ;
    vc:enables ngm:high-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:network-architecture ;
    vc:slug "load-balancer" ;
    vc:sourceDomain "distributed-systems" .

ngm:logistics a owl:Class ;
    rdfs:label "Logistics"@en ;
    rdfs:comment "Logistics is the planning, execution, and control of the efficient movement and storage of goods, services, and related information between points of origin and consumption. It encompasses transportation, warehousing, inventory management, order fulfilment, and reverse flows, with the objective of meeting demand at the required service level and lowest total cost. Logistics is a constituent function of supply-chain management and is increasingly mediated by sensor data, real-time tracking, and optimisation algorithms that coordinate multimodal networks under uncertainty."@en ;
    rdfs:subClassOf ngm:process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:reverse-logistics ;
    vc:slug "logistics" ;
    vc:sourceDomain "supply-chain" .

ngm:long-horizon-planning a owl:Class ;
    rdfs:label "Long-Horizon Planning"@en ;
    rdfs:comment "Long-horizon planning is the problem of generating and executing sequences of actions over extended time horizons — spanning hundreds to thousands of steps — to achieve high-level goals that cannot be accomplished through simple reactive policies. It requires maintaining coherent goals, managing intermediate subgoal states, and adapting plans in response to environmental changes and unexpected outcomes."@en ;
    rdfs:subClassOf ngm:task-planning ;
    vc:enables ngm:agentic-workflow,
        ngm:llm-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:multi-agent-system,
        ngm:path-planning,
        ngm:reinforcement-learning-for-robotics ;
    vc:slug "long-horizon-planning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:large-language-models,
        ngm:reinforcement-learning .

ngm:loop-closure-detection a owl:Class ;
    rdfs:label "Loop Closure Detection"@en ;
    rdfs:comment "Loop closure detection is the process by which a SLAM or mapping system recognises that it has returned to a previously visited location. By identifying these revisits, it adds constraints that correct accumulated odometry drift and produce globally consistent maps. It is a critical component of robust simultaneous localisation and mapping, typically implemented via appearance-based place recognition or geometric matching."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:long-range-navigation,
        ngm:topological-map ;
    vc:slug "loop-closure-detection" ;
    vc:sourceDomain "robotics" .

ngm:low-rank-adaptation a owl:Class ;
    rdfs:label "Low-Rank Adaptation"@en ;
    rdfs:comment "Low-Rank Adaptation is a parameter-efficient fine-tuning method that adds small trainable low-rank matrices to a frozen pre-trained model. It reduces the cost of adapting large models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:parameter-efficient-fine-tuning ;
    vc:enables ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:neural-network ;
    vc:slug "low-rank-adaptation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:machine-learning-models a owl:Class ;
    rdfs:label "Machine Learning Models"@en ;
    rdfs:comment "Categories and types of machine learning algorithms including classification models, regression models, clustering algorithms, and neural networks, each designed for specific prediction and pattern recognition tasks."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:machine-learning ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:automated-decision-making ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "machine-learning-models" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:macroeconomics a owl:Class ;
    rdfs:label "Macroeconomics"@en ;
    rdfs:comment "Macroeconomics is the branch of economics that studies the behaviour and performance of an economy as a whole, including output, inflation, unemployment and growth. It examines aggregate variables and the effect of monetary and fiscal policy."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:enables ngm:inflation-hedge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "macroeconomics" ;
    vc:sourceDomain "economics" .

ngm:manufacturing-process a owl:Class ;
    rdfs:label "Manufacturing Process"@en ;
    rdfs:comment "A manufacturing process is a structured sequence of physical transformations — including machining, assembly, forming, joining, heat treatment, surface finishing, and inspection — applied to raw materials or sub-components to produce finished goods meeting specified tolerances, material properties, and functional requirements. Manufacturing processes are characterised by their tooling, cycle time, throughput, waste profile, and quality control mechanisms."@en ;
    rdfs:subClassOf ngm:industrial-automation ;
    vc:enables ngm:logistics-automation,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-inspection ;
    vc:slug "manufacturing-process" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:industrial-robot,
        ngm:quality-assurance,
        ngm:sensor .

ngm:market-capitalization a owl:Class ;
    rdfs:label "Market Capitalization"@en ;
    rdfs:comment "Market Capitalization in a blockchain context is the aggregate market value of a cryptocurrency or token, computed as the circulating supply multiplied by the current unit price. It serves as a widely used proxy for the relative size, liquidity, and investor confidence of a crypto-economic network, underpinning index construction, risk categorisation, and portfolio weighting decisions by institutional participants. Critically, market capitalisation is a lagging and manipulable metric: thin order books, wash trading, and locked but counted supply can inflate the figure well beyond the value that could be liquidated in practice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:token-weighted-voting,
        ngm:tokenomics-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:tokenomics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:liquidity-pool,
        ngm:liquidity-provision,
        ngm:token-economics,
        ngm:tokenization ;
    vc:requires ngm:cryptocurrency,
        ngm:token ;
    vc:slug "market-capitalization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptocurrency-token .

ngm:mas a owl:Class ;
    rdfs:label "MAS"@en ;
    rdfs:comment "A Multi-Agent System (MAS) is a computational framework composed of multiple interacting autonomous agents that perceive their environment and act to achieve individual or collective goals. Each agent in the system possesses local knowledge, reasoning capabilities, and the ability to communicate with peers, enabling emergent collective intelligence without centralised control. MAS architectures address problems that are too complex, distributed, or dynamic for monolithic solutions."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:enables ngm:decentralized-swarm-control,
        ngm:participant-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:multi-agent-system,
        ngm:multi-agent-systems,
        ngm:swarm-robotics ;
    vc:slug "mas" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:communication-protocol,
        ngm:consensus-mechanism .

ngm:material-system a owl:Class ;
    rdfs:label "Material System"@en ;
    rdfs:comment "A defined combination of materials and their interfaces engineered to deliver a specific function or set of properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:material-science ],
        ngm:material-science ;
    vc:enables ngm:simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:material-science ;
    vc:slug "material-system" ;
    vc:sourceDomain "general" .

ngm:measurement-methodology a owl:Class ;
    rdfs:label "Measurement Methodology"@en ;
    rdfs:comment "A measurement methodology is a defined, repeatable procedure for quantifying a property or performance characteristic, specifying scope, units, data sources, and calculation rules. It ensures that results are consistent, comparable, and auditable across observers and over time. Rigorous methodology is the precondition for trustworthy indicators, benchmarks, and standards-based reporting."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:benchmark-standard,
        ngm:carbon-footprint-indicator ;
    vc:slug "measurement-methodology" ;
    vc:sourceDomain "governance" .

ngm:mechanical-interface a owl:Class ;
    rdfs:label "Mechanical Interface"@en ;
    rdfs:comment "A mechanical interface is the standardised physical coupling between two components that defines their geometric fit, fastening, and load transfer. In robotics it specifies how an end-effector or tool attaches to a robot wrist or actuator, governing alignment, rigidity, and quick-change capability. Well-defined mechanical interfaces enable modularity and interchangeability of subsystems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:electric-actuator,
        ngm:end-effector ;
    vc:slug "mechanical-interface" ;
    vc:sourceDomain "robotics" .

ngm:mechanical-load a owl:Class ;
    rdfs:label "Mechanical Load"@en ;
    rdfs:comment "A mechanical load is the external force, torque, or resistance that a motor, actuator, or structure must work against during operation. Characterised by inertia, friction, gravity, and process forces, it determines the torque-speed demand placed on a drive system. Accurate load characterisation is essential for sizing motors, selecting gearing, and designing stable control."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dc-servo-motor,
        ngm:electric-motor ;
    vc:slug "mechanical-load" ;
    vc:sourceDomain "robotics" .

ngm:memory-bandwidth a owl:Class ;
    rdfs:label "Memory Bandwidth"@en ;
    rdfs:comment "Memory bandwidth is the rate at which data can be read from or written to memory, typically measured in gigabytes per second. It is a primary performance constraint for data-intensive workloads such as deep-learning inference and real-time rendering, where compute units stall waiting for data. High-bandwidth memory technologies are deployed precisely to relieve this bottleneck on accelerators and edge hardware."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hardware-and-edge,
        ngm:rendering-pipeline ;
    vc:slug "memory-bandwidth" ;
    vc:sourceDomain "infrastructure" .

ngm:memory-hierarchy a owl:Class ;
    rdfs:label "Memory Hierarchy"@en ;
    rdfs:comment "A memory hierarchy organises storage into layers of differing speed, size and cost so that frequently accessed data sits in fast caches close to the processor and bulk data resides in slower, larger memory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-hardware ],
        ngm:computer-hardware ;
    vc:enables ngm:gpu-architecture,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-hardware ;
    vc:slug "memory-hierarchy" ;
    vc:sourceDomain "metaverse" .

ngm:memory-store a owl:Class ;
    rdfs:label "Memory Store"@en ;
    rdfs:comment "A memory store is the persistence layer in an AI agent system that retains information across turns and sessions for later retrieval. It typically holds conversation history, facts, and learned context, often as embeddings in a vector database to enable semantic recall. The memory store is what allows agents to maintain continuity, personalise responses, and accumulate knowledge beyond a single context window."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:context-engineering ;
    vc:slug "memory-store" ;
    vc:sourceDomain "ai" .

ngm:message-format a owl:Class ;
    rdfs:label "Message Format"@en ;
    rdfs:comment "A message format is the agreed structure, encoding, and field schema for data exchanged between systems over a protocol. It specifies headers, payload layout, data types, and serialisation so that senders and receivers can unambiguously parse and validate messages. Standardised message formats are essential to interoperability in communication protocols and transaction standards."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:transaction-standard ;
    vc:slug "message-format" ;
    vc:sourceDomain "infrastructure" .

ngm:message-signing a owl:Class ;
    rdfs:label "Message Signing"@en ;
    rdfs:comment "Message signing is a cryptographic operation whereby a private key is used to generate a digital signature over a message or data payload, enabling any holder of the corresponding public key to verify the authenticity and integrity of the message. It provides non-repudiation guarantees, ensuring that the signer cannot plausibly deny having produced the signature. Message signing is foundational to authentication protocols, blockchain transactions, and secure communication systems."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:public-key-infrastructure,
        ngm:secp256k1 ;
    vc:slug "message-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:ecdsa,
        ngm:private-key,
        ngm:public-key-cryptography .

ngm:metaverse-stack a owl:Class ;
    rdfs:label "Metaverse Stack"@en ;
    rdfs:comment "The comprehensive layered technology framework encompassing hardware, network infrastructure, spatial computing, decentralisation, creator economy, discovery, and experience layers that toger enable the creation and operation of persistent virtual world environments."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:technology-stack ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-world-operation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metaverse-stack" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-technology a owl:Class ;
    rdfs:label "Metaverse Technology"@en ;
    rdfs:comment "The foundational technology domain encompassing persistent, synchronous 3D virtual worlds, augmented reality environments, spatial computing platforms, and immersive internet infrastructure that enable shared experiences with interoperable digital assets, persistent identity systems, and real-time social interaction across physical and virtual boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metaverse-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:extended-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-experience ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-computing ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:augmented-reality,
        ngm:avatar-system,
        ngm:digital-asset,
        ngm:extended-reality,
        ngm:immersive-experience,
        ngm:metaverse-infrastructure,
        ngm:spatial-computing,
        ngm:virtual-economy,
        ngm:virtual-world ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:metaverse,
        ngm:metaverse-platform,
        ngm:virtual-world-traversal ;
    vc:slug "metaverse-technology" ;
    vc:sourceDomain "spatial-computing" .

ngm:microphone a owl:Class ;
    rdfs:label "Microphone"@en ;
    rdfs:comment "A microphone is a transducer that converts acoustic sound waves into an electrical signal, serving as the primary audio sensor in interactive and telepresence systems. Common types include electret, MEMS, condenser, and dynamic, characterised by polar pattern, sensitivity, and signal-to-noise ratio. In robots and voice interfaces, microphone arrays additionally enable beamforming and source localisation."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:tc-0003-telepresence-robot,
        ngm:voice-interaction ;
    vc:slug "microphone" ;
    vc:sourceDomain "robotics" .

ngm:midjourney a owl:Class ;
    rdfs:label "Midjourney"@en ;
    rdfs:comment "Midjourney is a proprietary generative artificial intelligence service that produces images from natural-language text prompts. It is operated by an independent research lab of the same name and is accessed primarily through a Discord bot interface and, later, a dedicated web application. The system is known for a distinctive aesthetic and for iterating rapidly through successive model versions that improve coherence, resolution and prompt adherence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-to-image-generation ],
        ngm:creative-media-domain ;
    vc:enables ngm:concept-art,
        ngm:synthetic-media ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:diffusion-model,
        ngm:text-to-image-generation ;
    vc:slug "midjourney" ;
    vc:sourceDomain "midjourney" .

ngm:mistral-and-mixtral a owl:Class ;
    rdfs:label "Mistral and Mixtral"@en ;
    rdfs:comment "Mistral AI is a French AI company that developed a family of open-weight large language models, including the dense Mistral 7B and the sparse Mixture-of-Experts Mixtral 8x7B and 8x22B architectures. These models are distinguished by their efficient use of grouped-query attention, sliding window attention, and sparse expert routing, achieving performance competitive with much larger models at a fraction of the inference cost. Released under permissive licences, they have become foundational reference models for the open-source AI community."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:contrastsWith ngm:anthropic-claude,
        ngm:gpt ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:inference-engine,
        ngm:instruction-tuning,
        ngm:open-source-ai ;
    vc:slug "mistral-and-mixtral" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:context-window,
        ngm:mixture-of-experts,
        ngm:transformer-architecture .

ngm:mixed-reality-platform a owl:Class ;
    rdfs:label "Mixed Reality Platform"@en ;
    rdfs:comment "A hardware and software ecosystem that overlays and anchors digital content onto the physical environment in real time, enabling simultaneous interaction with both real and virtual objects. Mixed reality platforms combine inside-out tracking, spatial mapping, and pass-through or optical display technologies to support immersive collaborative and industrial workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:enables ngm:extended-reality,
        ngm:immersive-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rendering-engine,
        ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "mixed-reality-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:spatial-computing,
        ngm:xr-device .

ngm:mobile-manipulation a owl:Class ;
    rdfs:label "Mobile Manipulation"@en ;
    rdfs:comment "Mobile manipulation is the field of robotics that combines a mobile base with one or more manipulator arms so a robot can move through an environment and physically interact with objects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mobile-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:manipulator ],
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:manipulator,
        ngm:mobile-robot ;
    vc:slug "mobile-manipulation" ;
    vc:sourceDomain "robotics" .

ngm:model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "In artificial intelligence, a Model is a mathematical or computational structure learned from data that encodes a mapping from inputs to outputs (or latent representations). Models range from classical machine learning models (linear, tree-based) to deep neural networks, generative models, and large language models, and constitute the core artefact produced by training and consumed during inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-capacity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-depth ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:inference,
        ngm:model-performance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-architecture,
        ngm:model-capacity,
        ngm:model-depth ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:large-language-models,
        ngm:machine-learning-model,
        ngm:model-interpretability,
        ngm:pretrained-model ;
    vc:requires ngm:model-training ;
    vc:slug "model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:model-architecture-layer a owl:Class ;
    rdfs:label "Model Architecture Layer"@en ;
    rdfs:comment "The Model Architecture Layer is the stratum that specifies the structural design of a machine learning model: its operators, connectivity, and parameterisation. It sits above the Algorithm Layer, which supplies the primitives it composes, and below the Model Layer, which holds trained instances of these architectures. It contains layer definitions, network topologies, and architectural hyperparameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm-layer ],
        ngm:owl-thing ;
    vc:enables ngm:model-layer,
        ngm:training-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:algorithm-layer ;
    vc:slug "model-architecture-layer" ;
    vc:sourceDomain "model-architecture" .

ngm:model-documentation a owl:Class ;
    rdfs:label "Model Documentation"@en ;
    rdfs:comment "Model documentation is the structured recording of a machine learning model's intended use, training data, performance, limitations, and ethical considerations, typically through artefacts such as model cards and datasheets. It supports transparency, accountability, and informed deployment decisions for downstream users and regulators. It is increasingly required by AI governance frameworks and procurement standards."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-domain,
        ngm:algorithmic-transparency-index ;
    vc:slug "model-documentation" ;
    vc:sourceDomain "ai" .

ngm:moderation-tools a owl:Class ;
    rdfs:label "Moderation Tools"@en ;
    rdfs:comment "Moderation tools are software systems that detect, review, and act on user-generated content or behaviour that violates platform policies, combining automated classifiers, reporting queues, and human-review workflows. They enforce community standards by flagging, filtering, age-gating, or removing content and sanctioning accounts. In immersive and social platforms they increasingly cover real-time voice, spatial, and behavioural moderation."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:community-standards,
        ngm:content-moderation-standards ;
    vc:slug "moderation-tools" ;
    vc:sourceDomain "governance" .

ngm:monetary-policy-transmission a owl:Class ;
    rdfs:label "Monetary Policy Transmission"@en ;
    rdfs:comment "Monetary policy transmission is the process by which changes in a central bank's policy instruments—primarily short-term interest rates or reserve quantities—propagate through financial markets and the broader economy to affect output, employment, and the price level. The transmission operates through multiple channels including the interest rate channel (altering borrowing costs), the credit channel (influencing bank lending and balance-sheet constraints), the exchange rate channel (shifting the relative price of tradeable goods), the asset price channel (changing wealth and Tobin's q), and expectations channels (anchoring or re-anchoring inflation expectations). The strength, speed, and reliability of each channel depends on the institutional structure of the financial system, the degree of market completeness, and the prevailing monetary regime."@en ;
    rdfs:subClassOf ngm:monetary-policy ;
    vc:dependsOn ngm:monetary-system ;
    vc:enables ngm:financial-stability,
        ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:financial-system,
        ngm:inflation,
        ngm:monetary-policy-implementation ;
    vc:slug "monetary-policy-transmission" ;
    vc:sourceDomain "finance" .

ngm:monitoring-infrastructure a owl:Class ;
    rdfs:label "Monitoring Infrastructure"@en ;
    rdfs:comment "Monitoring infrastructure is the collection of systems that gather, store, and analyse metrics, logs, and traces to observe the health, performance, and behaviour of software and physical systems. It underpins alerting, capacity planning, incident response, and, for AI systems, tracking of drift, cost, and environmental impact. Components typically include collectors, time-series databases, dashboards, and alerting engines."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-monitoring,
        ngm:environmental-impact-metric ;
    vc:slug "monitoring-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:monte-carlo-localization a owl:Class ;
    rdfs:label "Monte Carlo Localization"@en ;
    rdfs:comment "A probabilistic localization algorithm that represents the robot's belief about its position using a set of weighted particles (samples), where each particle represents a hypothesis of the robot's pose. It implements a particle filter to recursively estimate the robot's pose distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-measurements ],
        ngm:rb-1013-localization,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:global-localization,
        ngm:kidnapped-robot-problem ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:map,
        ngm:motion-model,
        ngm:sensor-measurements ;
    vc:slug "monte-carlo-localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:importance-sampling,
        ngm:rb-1008-odometry,
        ngm:sensor-fusion .

ngm:motor-controller a owl:Class ;
    rdfs:label "Motor Controller"@en ;
    rdfs:comment "A motor controller is an electronic device that regulates the speed, torque, direction, and position of an electric motor by modulating the power delivered to it, typically via pulse-width modulation and closed-loop feedback. In robotics it interprets high-level velocity or position commands and drives motors accordingly, often integrating current sensing and encoder feedback. It is a core actuation component bridging control software and mechanical motion."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:tc-0003-telepresence-robot ;
    vc:slug "motor-controller" ;
    vc:sourceDomain "robotics" .

ngm:mounting-interface a owl:Class ;
    rdfs:label "Mounting Interface"@en ;
    rdfs:comment "A mounting interface is the standardised mechanical feature set, such as bolt patterns, flanges, and alignment pins, that defines how one component is rigidly attached to another in a mechanical or robotic assembly. It ensures repeatable positioning, load transfer, and interchangeability of links, end-effectors, sensors, and payloads. Standardised interfaces (e.g. ISO tool flanges) enable modular, reconfigurable robots."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component,
        ngm:robot-link ;
    vc:slug "mounting-interface" ;
    vc:sourceDomain "robotics" .

ngm:mu-jo-co a owl:Class ;
    rdfs:label "MuJoCo"@en ;
    rdfs:comment "MuJoCo (Multi-Joint dynamics with Contact) is a high-speed, high-fidelity physics simulation engine designed for modelling articulated rigid-body systems with complex contact dynamics, widely used in robotics research and reinforcement learning. Developed by Emo Todorov at the University of Washington and commercialised by Roboti LLC, it was acquired by Google DeepMind in 2021 and made freely available as open-source software in 2022. MuJoCo excels at simulating musculoskeletal models, legged locomotion, dexterous manipulation, and other contact-rich robotic tasks that require accurate Lagrangian dynamics and constraint solvers. Its adoption as the standard benchmark environment for reinforcement learning algorithms—via OpenAI Gym and later Gymnasium wrappers—has made it the de facto substrate for sim-to-real transfer research in robotics."@en ;
    rdfs:subClassOf ngm:physics-simulation ;
    vc:enables ngm:humanoid-robotics,
        ngm:legged-locomotion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai-simulation,
        ngm:physics-engine,
        ngm:reinforcement-learning,
        ngm:robot-learning ;
    vc:slug "mu-jo-co" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning-algorithm .

ngm:multi-party-computation a owl:Class ;
    rdfs:label "Multi-Party Computation"@en ;
    rdfs:comment "Multi-Party Computation (MPC) is a subfield of cryptography that enables a set of mutually distrusting parties to jointly compute a function over their private inputs without revealing those inputs to any other participant. Correctness is guaranteed even when a bounded subset of participants behave maliciously, making MPC a cornerstone of privacy-preserving collaborative computation. The technique generalises two-party secure computation to arbitrary numbers of participants using secret-sharing or garbled-circuit protocols."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:enables ngm:privacy-preserving-analytics,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:threshold-cryptography,
        ngm:zero-knowledge-proof ;
    vc:slug "multi-party-computation" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-protocol,
        ngm:public-key-cryptography .

ngm:multi-step-reasoning a owl:Class ;
    rdfs:label "Multi-Step Reasoning"@en ;
    rdfs:comment "Multi-step reasoning is the capacity of an AI system to solve problems that require chaining several intermediate inferences, rather than mapping an input directly to an answer in a single step. It encompasses decomposing a problem into sub-problems, maintaining and updating intermediate state, and composing partial results into a final solution. In large language models it is elicited through chain-of-thought prompting, tool use, and search over reasoning paths, and it is a primary differentiator between shallow pattern completion and genuine problem-solving competence."@en ;
    rdfs:subClassOf ngm:reasoning ;
    vc:enables ngm:reasoning-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:llm-agents ;
    vc:slug "multi-step-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:chain-of-thought-prompting .

ngm:multirotor-uav a owl:Class ;
    rdfs:label "Multirotor UAV"@en ;
    rdfs:comment "A Multirotor UAV is an unmanned aerial vehicle that achieves lift and attitude control through three or more independently driven rotors. Differential rotor speed adjustment enables hover, translation, yaw, and agile manoeuvring without mechanical pitch or collective mechanisms, making multirotors highly manoeuvrable platforms suited to inspection, aerial photography, payload delivery, and search-and-rescue operations."@en ;
    rdfs:subClassOf ngm:aerial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:odometry,
        ngm:path-planning,
        ngm:swarm-robotics ;
    vc:slug "multirotor-uav" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:3-d-li-dar,
        ngm:kalman-filter,
        ngm:pid-controller,
        ngm:sensor-fusion,
        ngm:state-space-control .

ngm:music-and-audio a owl:Class ;
    rdfs:label "Music and Audio"@en ;
    rdfs:comment "Music and Audio (AI-driven) is a domain within artificial intelligence encompassing the generation, transformation, classification, and production of musical audio using deep generative models, large language models conditioned on audio, latent diffusion architectures, and audio-language foundati..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-audio-codec ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-audio-codec ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformers ],
        ngm:ai-application,
        ngm:audio-signal-processing,
        ngm:creative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:adaptive-music,
        ngm:ai-mastering,
        ngm:ai-music-production,
        ngm:film-scoring-automation,
        ngm:game-audio-procedural-generation,
        ngm:personalised-soundtracks,
        ngm:podcast-music-generation,
        ngm:royalty-free-music-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-diffusion,
        ngm:audio-watermarking,
        ngm:clap-embeddings,
        ngm:lyric-generation,
        ngm:melodic-generation,
        ngm:music-language-model,
        ngm:neural-audio-codec,
        ngm:stem-separation,
        ngm:text-to-music-synthesis,
        ngm:vocal-synthesis ;
    vc:implements ngm:autoregressive-decoding,
        ngm:classifier-free-guidance,
        ngm:contrastive-language-audio-pre-training,
        ngm:flow-matching,
        ngm:latent-diffusion,
