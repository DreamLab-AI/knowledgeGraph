artificial-intelligence:AIFramework vcw:bridgesTo artificial-intelligence:Blockchain .

# NPU
artificial-intelligence:NPU rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ArtificialIntelligence ;
    rdfs:label "NPU"@en ;
    rdfs:comment "Neural Processing Unit, specialized hardware accelerators designed specifically for artificial neural network computations, optimized for AI inference and training."@en ;
    skos:prefLabel "NPU"@en ;
