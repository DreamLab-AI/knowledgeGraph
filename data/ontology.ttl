ngm:shared-knowledge-base a owl:Class ;
    rdfs:label "Shared Knowledge Base"@en ;
    rdfs:comment "A collaborative knowledge repository enabling multiple agents or users to exchange, integrate, and query structured information using semantic web technologies, providing a common understanding of domain concepts through ontologies and linked data standards."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
