        ngm:human-computer-interaction,
        ngm:user-engagement ;
    vc:requires ngm:interaction-design ;
    vc:slug "gamification" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:immersive-learning ;
    vc:uses ngm:feedback-loop,
        ngm:interaction-design .

ngm:gas-fee-market a owl:Class ;
    rdfs:label "Gas Fee Market"@en ;
    rdfs:comment "The Gas Fee Market is the economic mechanism governing blockchain transaction costs, where users bid gas fees to prioritise transaction processing. Governed by EIP-1559 on Ethereum, it separates a burned base fee from an optional priority tip, creating a market-based congestion control system essential for NFT trades, smart contract execution, and virtual asset transfers in spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract-execution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain-economics ;
    vc:bridgesTo ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-economics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:eip-1559,
        ngm:layer2 ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract-execution ;
    vc:slug "gas-fee-market" ;
    vc:sourceDomain "blockchain" .

ngm:gas-optimization a owl:Class ;
    rdfs:label "Gas Optimization"@en ;
    rdfs:comment "Gas optimization is the systematic reduction of computational resources required for smart contract execution on blockchain networks, achieved through efficient storage patterns, opcode selection, data structure design, and batching strategies to minimise transaction costs and improve economic vi..."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:scalability-solutions ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "gas-optimization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gas .

ngm:gas-price a owl:Class ;
    rdfs:label "Gas Price"@en ;
    rdfs:comment "Gas Price is the amount of cryptocurrency (denominated in gwei on Ethereum) that a transaction sender is willing to pay per unit of gas consumed during execution. It serves as the primary market mechanism for prioritising transactions within a block and compensating validators or miners for computational work. Gas price interacts with the gas limit and base fee to determine total transaction cost, and is subject to dynamic adjustment under fee-market protocols such as EIP-1559."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:priority-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-limit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:blockchain,
        ngm:mempool ;
    vc:enables ngm:fee-market,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee,
        ngm:priority-fee ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:eip-1559,
        ngm:mechanism-design,
        ngm:miner,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:token-economics,
        ngm:transaction-fee ;
    vc:requires ngm:gas,
        ngm:gas-limit,
        ngm:transaction ;
    vc:slug "gas-price" ;
    vc:sourceDomain "blockchain" .

ngm:generative-design a owl:Class ;
    rdfs:label "Generative Design"@en ;
    rdfs:comment "Generative Design is a computational design methodology in which algorithms autonomously explore a defined design space—bounded by performance constraints, manufacturing requirements, and material properties—to generate and evaluate large numbers of design candidates, surfacing options that meet objectives a human designer specifies but did not hand-craft. Implemented through topology optimisation, evolutionary algorithms, and increasingly through deep generative models, it produces geometrically complex structures—often resembling organic forms—that achieve material efficiency or performance targets unattainable through conventional manual design. The output is typically a ranked set of design alternatives that engineers evaluate and refine."@en ;
    rdfs:subClassOf ngm:parametric-design-methodology-modeling ;
    vc:enables ngm:digital-twin,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-design-tool,
        ngm:optimization-algorithm,
        ngm:parametric-design-methodology ;
    vc:slug "generative-design" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-generative-model,
        ngm:physics-simulation,
        ngm:simulation .

ngm:generative-design-tool a owl:Class ;
    rdfs:label "Generative Design Tool"@en ;
    rdfs:comment "AI-assisted software application that produces optimized 3D designs from functional constraints using machine learning and computational algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
