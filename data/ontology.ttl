ngm:hybrid-search a owl:Class ;
    rdfs:comment "Hybrid search is an information retrieval approach that combines sparse lexical retrieval — typically BM25 or TF-IDF — with dense vector search over neural embeddings, fusing their complementary strengths: precise keyword matching and semantic understanding respectively. Score fusion via Reciprocal Rank Fusion or learned weighting combines ranked lists from both systems. The combination consistently outperforms either method alone across diverse query types, and has become the dominant retrieval pattern underpinning Retrieval-Augmented Generation pipelines."@en ;
    rdfs:label "Hybrid Search"@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    rdfs:subClassOf _:r11884 ;
