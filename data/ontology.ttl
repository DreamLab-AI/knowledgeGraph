ngm:erc-20-tokens a owl:Class ;
    rdfs:label "ERC-20 Tokens"@en ;
    rdfs:comment "An Ethereum standard defining a common interface for fungible tokens, including functions for transfers, balances and allowances. It is the widely adopted standard for interchangeable tokens on Ethereum."@en ;
