    vc:slug "service-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-robot,
        ngm:computer-vision .

ngm:sim-to-real-transfer a owl:Class ;
    rdfs:label "Sim-to-Real Transfer"@en ;
    rdfs:comment "Sim-to-real transfer encompasses the techniques and strategies for training robotic policies, perception models, and control algorithms in simulation environments and subsequently deploying them on physical hardware with acceptable performance degradation. The core challenge is the reality gap: discrepancies between simulated and real-world physics, sensor noise characteristics, contact dynamics, and visual appearance cause policies optimised in simulation to fail when deployed. Mitigation strategies include domain randomisation, domain adaptation, system identification, and the use of high-fidelity physics engines to narrow the gap before transfer."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:legged-locomotion,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:synthetic-data ;
    vc:slug "sim-to-real-transfer" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:physics-simulation,
        ngm:reinforcement-learning,
        ngm:simulation .

ngm:stablecoin-regulation a owl:Class ;
    rdfs:label "Stablecoin Regulation"@en ;
    rdfs:comment "Stablecoin regulation is the corpus of statutory, administrative, and supervisory rules that national and supranational authorities apply to Cryptocurrency|cryptocurrency tokens designed to maintain stable value relative to fiat currencies, commodities, or baskets of assets, spanning five con..."@en ;
