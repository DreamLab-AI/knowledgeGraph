            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:context-aware-reasoning,
        ngm:hallucination-reduction,
        ngm:verifiable-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
