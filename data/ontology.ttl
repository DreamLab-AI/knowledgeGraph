ngm:web-of-things a owl:Class ;
    rdfs:comment "A W3C standardisation effort that applies web architecture, protocols, and semantics to the Internet of Things, describing physical devices through machine-readable Thing Descriptions based on JSON-LD so that heterogeneous sensors, actuators, and services can be discovered, composed, and controlled through uniform web interfaces regardless of the underlying transport protocol, providing an interoperability layer that bridges fragmented IoT ecosystems and makes device capabilities legible to software agents."@en ;
    rdfs:label "Web of Things"@en ;
    rdfs:subClassOf ngm:web-standards ;
