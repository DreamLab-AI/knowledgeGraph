ngm:ethereum-smart-contract-platform-smart-contracts a owl:Class ;
    rdfs:label "Ethereum Smart Contracts"@en ;
    rdfs:comment "Programs deployed to the Ethereum blockchain that execute deterministically on the Ethereum Virtual Machine and maintain state enforced by network consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        ngm:smart-contract ;
    vc:enables ngm:erc-20 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:solidity ;
    vc:slug "ethereum-smart-contracts" ;
    vc:sourceDomain "blockchain" .

