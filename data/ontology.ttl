ngm:roc-curve a owl:Class ;
    rdfs:label "ROC Curve"@en ;
    rdfs:comment "A graphical performance evaluation tool for binary classification models that plots the True Positive Rate (Recall/Sensitivity) against the False Positive Rate across all possible classification thresholds, visualising the trade-off between correctly identifying positive instances and incorrectly classifying negative instances as positive, enabling threshold selection, model comparison, and assessment of a classifier's discriminative ability independent of class distribution or threshold choice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:auc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:true-positive-rate ],
        ngm:model-performance ;
    vc:bridgesTo ngm:clinical-decision-support,
        ngm:fraud-detection,
        ngm:medical-diagnostics ;
    vc:contrastsWith ngm:accuracy,
        ngm:precision-recall-curve ;
    vc:dependsOn ngm:classification-threshold,
        ngm:sensitivity,
        ngm:specificity ;
    vc:enables ngm:classifier-evaluation,
        ngm:model-comparison,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:auc,
        ngm:false-positive-rate,
        ngm:true-positive-rate ;
    vc:isPartOf ngm:model-evaluation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:f1-score,
        ngm:model-calibration ;
    vc:requires ngm:binary-classification,
        ngm:confusion-matrix,
        ngm:probabilistic-classifier ;
    vc:slug "roc-curve" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:imbalanced-classification,
        ngm:model-selection ;
    vc:uses ngm:signal-detection-theory,
        ngm:youdens-index .

ngm:safety-standard a owl:Class ;
    rdfs:label "Safety Standard"@en ;
    rdfs:comment "A safety standard is a normative document — published by a standards body, industry consortium, or regulatory authority — that defines requirements, processes, and verification methods for ensuring that a system, product, or environment achieves an acceptable level of risk to human life, health, and property. Safety standards range from generic functional safety frameworks such as IEC 61508 and ISO 26262 to domain-specific codes covering robotics, medical devices, aviation, and industrial machinery, and they typically specify hazard analysis methods, safety integrity levels, design constraints, and evidence of compliance."@en ;
    rdfs:subClassOf ngm:compliance-standards ;
    vc:enables ngm:compliance-framework,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:risk-assessment,
        ngm:robot-safety ;
    vc:slug "safety-standard" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-risk-management ;
    vc:uses ngm:iec-61508,
        ngm:iso-26262 .

ngm:scada a skos:Concept ;
    rdfs:label "Scada"@en .

ngm:sd-jwt a owl:Class ;
    rdfs:label "SD-JWT"@en ;
    rdfs:comment "SD-JWT (Selective Disclosure JSON Web Token) is an IETF-specified extension to the JSON Web Token standard that allows an Issuer to create a signed token containing hashed claim values, from which the Holder can selectively reveal only the specific claims needed for a given presentation — without exposing other claims or enabling correlation across presentations. The mechanism uses SHA-256 salted disclosure objects appended to the base JWT; verifiers can validate revealed disclosures against the issuer signature whilst remaining blind to undisclosed claims. SD-JWT forms the primary credential format for the European Union's eIDAS 2.0 digital identity wallet system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:selective-disclosure ;
    vc:bridgesTo ngm:digital-identity-governance,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:bbs-plus-signatures,
        ngm:iso-mdoc,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:credential-verification,
        ngm:holder-binding,
        ngm:minimal-disclosure,
        ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ietf-rfc,
        ngm:oauth-working-group-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:decentralised-identifier,
        ngm:w3c-verifiable-credential-data-model ;
    vc:requires ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "sd-jwt" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:eidas-2-digital-identity-wallet,
        ngm:open-id4-vci,
        ngm:open-id4-vp ;
    vc:uses ngm:base64url-encoding,
        ngm:cryptographic-proof,
        ngm:jose,
        ngm:json-data-interchange-format-web-token,
        ngm:sha-256,
        ngm:verifiable-credentials .

