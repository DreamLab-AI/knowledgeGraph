    vc:slug "permissioned-blockchain" ;
    vc:sourceDomain "blockchain" .

ngm:policy-enforcement-point a owl:Class ;
    rdfs:label "Policy Enforcement Point"@en ;
    rdfs:comment "A Policy Enforcement Point (PEP) is an architectural component in access control systems that intercepts resource access requests, forwards them to a Policy Decision Point (PDP) for authorisation evaluation, and then enforces the resulting permit or deny decision. The PEP–PDP separation—defined in the XACML standard and central to attribute-based access control (ABAC) architectures—decouples policy logic from enforcement infrastructure, enabling centralised policy management and consistent enforcement across heterogeneous systems. In zero-trust architectures, every network transaction passes through a PEP, which may be implemented as a reverse proxy, API gateway, service mesh sidecar, or network firewall. The model extends naturally to identity-aware proxies, software-defined perimeters, and AI governance enforcement layers."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:enables ngm:privileged-access-management,
        ngm:zero-trust-architecture-zta ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control-system,
        ngm:identity-and-access-management,
        ngm:policy-enforcement,
        ngm:zero-trust-architecture ;
    vc:slug "policy-enforcement-point" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:api-gateway,
        ngm:oauth-2-0 .

ngm:privacy-policy a owl:Class ;
    rdfs:label "Privacy Policy"@en ;
    rdfs:comment "A privacy policy is a formal legal disclosure document through which an organisation communicates to data subjects the categories of personal data it collects, the purposes and legal bases for processing, data retention periods, third-party sharing arrangements, and the rights available to individuals under applicable regulations. Privacy policies are mandated by data protection frameworks such as the EU General Data Protection Regulation (GDPR), the UK Data Protection Act 2018, and the California Consumer Privacy Act (CCPA). They must be written in clear, accessible language, kept up to date, and linked prominently at the point of data collection to constitute valid notice under most regulatory regimes."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:privacy-framework ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection-regulation,
        ngm:gdpr-compliance ;
    vc:slug "privacy-policy" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:consent-management,
        ngm:data-governance .

