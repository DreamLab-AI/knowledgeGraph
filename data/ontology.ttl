        ngm:neural-rendering .

ngm:git-mark a owl:Class ;
    rdfs:label "Git Mark"@en ;
    rdfs:comment "Git Mark is a Block Trails Profile that anchors a Git history to Bitcoin by using each commit hash as the tweak that advances a trail, so the sequence of commits becomes a single-use-seal chain whose ordering and uniqueness are enforced by Bitcoin's UTXO model. The Blocktrails verifier checks a git-mark trail against the chain, confirming that each marked commit was timestamped and is tamper-evident on Bitcoin — it proves the history's immutability and temporal anchoring, not the correctness of the code itself. This gives a Bitcoin-secured provenance log for source repositories without storing any repository data on-chain."@en ;
    rdfs:subClassOf ngm:block-trails ;
    vc:bridgesTo ngm:continuous-integration,
        ngm:version-control ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-network,
        ngm:proof-of-publication ;
    vc:enables ngm:provenance-tracking,
        ngm:supply-chain-security ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:trusted-timestamping ;
    vc:isPartOf ngm:block-trails ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:client-side-validation,
        ngm:content-provenance ;
    vc:slug "git-mark" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:git,
        ngm:sha-256,
        ngm:single-use-seals,
        ngm:taproot .

