    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conflict-resolution,
        ngm:consensus-protocol,
        ngm:delegation-system,
        ngm:voting-mechanism ;
    vc:implements ngm:conviction-voting,
        ngm:liquid-democracy,
        ngm:pbft,
        ngm:quadratic-voting,
        ngm:raft-consensus,
        ngm:tendermint ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-collaboration,
        ngm:collective-action,
        ngm:common-pool-resources,
        ngm:distributed-ledger-technology,
        ngm:multi-agent-reinforcement-learning ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:incentive-compatibility ;
    vc:slug "distributed-decision-making" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:decentralised-identifiers,
