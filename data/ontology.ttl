        ngm:reinforcement-learning .

ngm:dexterous-manipulation a owl:Class ;
    rdfs:label "Dexterous Manipulation"@en ;
    rdfs:comment "Dexterous manipulation is the capability of robotic systems to grasp, reorient, assemble, and interact with objects using multi-fingered hands or compliant end-effectors in ways that require fine motor control, contact-rich reasoning, and real-time adaptation to object geometry and physical properties. It encompasses grasp planning, in-hand manipulation, and tactile feedback integration to replicate or exceed human-hand dexterity in unstructured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:in-hand-manipulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:grasp-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tactile-sensing ],
        ngm:manipulation ;
    vc:bridgesTo ngm:computer-vision,
        ngm:foundation-model ;
    vc:contrastsWith ngm:pick-and-place ;
    vc:dependsOn ngm:contact-mechanics,
        ngm:motion-planning ;
    vc:enables ngm:humanoid-robot,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:grasp-planning,
        ngm:in-hand-manipulation ;
    vc:isPartOf ngm:robot-manipulation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:sim-to-real-transfer,
        ngm:soft-robotics,
        ngm:teleoperation ;
    vc:requires ngm:end-effector,
        ngm:force-torque-sensor,
        ngm:kinematics,
        ngm:tactile-sensing ;
    vc:slug "dexterous-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:domain-randomisation,
        ngm:haptic-feedback,
        ngm:imitation-learning,
        ngm:physics-simulation,
        ngm:reinforcement-learning .

ngm:digital-marketing a owl:Class ;
    rdfs:label "Digital Marketing"@en ;
    rdfs:comment "Digital Marketing is the practice of promoting products, services, and brands through internet-connected and data-driven channels — including search engines, social media platforms, email, content networks, and programmatic advertising systems — to reach and convert target audiences. It encompasses both inbound strategies such as search engine optimisation and content marketing, and outbound strategies such as paid search, display advertising, and email campaigns. Modern digital marketing is distinguished by its measurability, real-time feedback loops, and ability to personalise messages at scale through machine learning, behavioural analytics, and customer data platforms. It intersects with artificial intelligence for predictive targeting, with data infrastructure for audience segmentation and attribution, and with emerging channels such as augmented reality and conversational interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-engine-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:programmatic-advertising ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audience-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-infrastructure ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:augmented-reality,
        ngm:blockchain,
        ngm:natural-language-processing ;
    vc:enables ngm:conversion-rate-optimisation,
        ngm:e-commerce,
        ngm:loyalty-programs,
        ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:programmatic-advertising,
        ngm:search-engine-optimisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:a-b-testing,
        ngm:brand-identity,
        ngm:privacy-regulation,
        ngm:user-experience ;
    vc:requires ngm:audience-segmentation,
        ngm:data-infrastructure ;
    vc:slug "digital-marketing" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:customer-data-platform,
        ngm:data-analytics,
        ngm:digital-content,
        ngm:machine-learning,
        ngm:recommendation-engine .

ngm:direct-preference-optimisation a owl:Class ;
    rdfs:label "Direct Preference Optimisation"@en ;
    rdfs:comment "An alignment method that directly uses preference data to fine-tune language models without training a separate reward model or using reinforcement learning, offering a simpler and more stable alternative to RLHF. DPO reparameterises the reward model objective to optimise the policy directly on preference comparison pairs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-preference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-modelling ;
    vc:dependsOn ngm:neural-network,
        ngm:pairwise-comparison ;
    vc:enables ngm:ai-alignment,
        ngm:fine-tuning,
        ngm:instruction-following,
        ngm:value-alignment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:bradley-terry-model,
        ngm:policy-optimisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai-training-methodology,
        ngm:self-supervised-learning ;
    vc:requires ngm:human-preference,
        ngm:large-language-models,
        ngm:preference-learning,
        ngm:supervised-fine-tuning ;
    vc:slug "direct-preference-optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:human-feedback,
        ngm:responsible-ai ;
    vc:uses ngm:kl-divergence,
        ngm:language-model,
        ngm:reference-policy .

ngm:distributed-tracing a owl:Class ;
    rdfs:label "Distributed Tracing"@en ;
    rdfs:comment "Distributed tracing is an observability technique that follows a single request as it propagates across the many services of a distributed system, recording the timing and causal relationships of each operation. Each unit of work is captured as a span, and spans linked by a shared trace identifier form a trace that reconstructs the request's end-to-end path. It is essential for diagnosing latency, dependencies and failures in microservice architectures where no single component holds the full picture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:microservices ],
        ngm:observability ;
    vc:bridgesTo ngm:service-mesh ;
    vc:dependsOn ngm:monitoring ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:latency ;
    vc:implements ngm:observability ;
    vc:isPartOf ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:microservices-architecture,
        ngm:service-mesh ;
    vc:requires ngm:microservices ;
    vc:slug "distributed-tracing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:performance-optimization,
        ngm:reliability-engineering ;
    vc:uses ngm:monitoring .

ngm:dynamic-programming a owl:Class ;
    rdfs:label "Dynamic Programming"@en ;
    rdfs:comment "Dynamic programming is an algorithmic technique for solving problems by breaking them into overlapping subproblems whose solutions are stored and reused rather than recomputed. It applies to problems exhibiting optimal substructure, combining subproblem solutions to construct an optimal whole. By memoising or tabulating intermediate results it converts exponential brute-force searches into polynomial-time algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        ngm:programming-paradigm ;
    vc:contrastsWith ngm:algorithm ;
    vc:enables ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:optimization-algorithm ;
    vc:isPartOf ngm:programming-paradigm ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:markov-decision-process,
        ngm:reinforcement-learning ;
    vc:requires ngm:optimization-algorithm ;
    vc:slug "dynamic-programming" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:markov-decision-process ;
    vc:uses ngm:algorithm .

ngm:eip-1559 a owl:Class ;
    rdfs:label "EIP-1559"@en ;
    rdfs:comment "EIP-1559 is an Ethereum Improvement Proposal, activated in the London hard fork (August 2021), that replaced Ethereum's original first-price gas auction with a protocol-determined base fee which adjusts algorithmically each block based on whether the prior block consumed more or less than the target gas. The base fee is burned — permanently removed from circulating ether supply — rather than paid to block producers, while an optional priority fee (tip) compensates validators for timely inclusion. This two-tier mechanism improves fee predictability, bounds user overpayment, introduces a deflationary supply dynamic, and partially constrains miner/validator extractable value arising from fee competition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:priority-fee ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:mechanism-design,
        ngm:monetary-policy ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:dependsOn ngm:gas-fee-market,
        ngm:gas-limit ;
    vc:enables ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee,
        ngm:priority-fee ;
    vc:implements ngm:ethereum-improvement-proposal ;
    vc:isPartOf ngm:ethereum ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:decentralised-finance,
        ngm:eip-4844,
        ngm:ethereum,
        ngm:miner-extractable-value,
        ngm:transaction-fee ;
    vc:requires ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:gas ;
    vc:slug "eip-1559" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake ;
    vc:uses ngm:exponential-moving-average,
        ngm:smart-contract .

ngm:emergent-capabilities a owl:Class ;
    rdfs:label "Emergent Capabilities"@en ;
    rdfs:comment "Emergent Capabilities are abilities that appear in large language models at scale but are absent or near-random in smaller models, seemingly arising abruptly as parameters, data, or compute increase. Examples include multi-step reasoning, in-context learning, and instruction following. Their unpredictability complicates capability forecasting and is central to debates about scaling and AI safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-scale-pretraining ],
        ngm:large-language-models ;
    vc:bridgesTo ngm:artificial-general-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:narrow-ai ;
    vc:dependsOn ngm:model-scale,
        ngm:transformer-architecture ;
    vc:enables ngm:chain-of-thought-reasoning,
        ngm:in-context-learning,
        ngm:instruction-following,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:capability-evaluation,
        ngm:frontier-models,
        ngm:grokking,
        ngm:model-training,
        ngm:phase-transition,
        ngm:scaling-laws ;
    vc:requires ngm:compute-resources,
        ngm:large-scale-pretraining,
        ngm:training-data ;
    vc:slug "emergent-capabilities" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:capability-forecasting .

ngm:financial-instruments a owl:Class ;
    rdfs:label "Financial Instruments"@en ;
    rdfs:comment "Financial instruments are contractual agreements or documents that convey a monetary claim, obligation, or ownership right between parties, encompassing equities, debt securities, derivatives, currencies, and commodities. In contemporary digital finance they extend to programmable on-chain instruments encoded as smart contracts, including decentralised lending protocols, synthetic assets, and tokenised representations of traditional financial claims. Their valuation, transferability, and settlement properties are governed by both legal frameworks and, increasingly, algorithmic rules embedded in blockchain protocols. International Accounting Standard 32 defines them as any contract that gives rise to a financial asset of one entity and a financial liability or equity instrument of another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:clearing-and-settlement ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance,
        ngm:smart-contracts,
        ngm:tokenization ;
    vc:dependsOn ngm:liquidity,
        ngm:market-infrastructure,
        ngm:price-discovery ;
    vc:enables ngm:capital-formation,
        ngm:portfolio-management,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:debt-securities,
        ngm:derivatives,
        ngm:equity-securities,
        ngm:foreign-exchange,
        ngm:structured-products ;
    vc:isPartOf ngm:capital-markets,
        ngm:financial-services ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:cryptocurrency,
        ngm:monetary-policy ;
    vc:requires ngm:clearing-and-settlement,
        ngm:financial-regulation,
        ngm:smart-contracts ;
    vc:slug "financial-instruments" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:international-accounting-standards,
        ngm:securities-regulation .

ngm:flash-loan a owl:Class ;
    rdfs:label "Flash Loan"@en ;
    rdfs:comment "A flash loan is an uncollateralised loan mechanism in decentralised finance that exists entirely within a single blockchain transaction: the borrower receives an arbitrary amount of an asset, executes arbitrary on-chain operations with it, and repays the loan plus a fee within the same atomic transaction, with the entire sequence reverting if repayment fails. Because atomicity guarantees that funds never leave the lending pool without being returned, no collateral is needed; default is technically impossible since a failed repayment causes the transaction to revert as if the loan never occurred. Flash loans enable capital-efficient arbitrage, liquidation, collateral swaps, and self-liquidation operations that would otherwise require significant upfront capital."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm-compatible-blockchain ],
        ngm:de-fi ;
    vc:bridgesTo ngm:algorithmic-trading,
        ngm:financial-derivatives ;
    vc:dependsOn ngm:lending-protocol,
        ngm:price-oracle ;
    vc:enables ngm:arbitrage,
        ngm:digital-asset-lending,
        ngm:liquidity-provision,
        ngm:mev,
        ngm:self-liquidation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:decentralised-finance,
        ngm:decentralized-exchange,
        ngm:transaction,
        ngm:twap-oracle ;
    vc:requires ngm:evm-compatible-blockchain ;
    vc:slug "flash-loan" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-settlement,
        ngm:liquidity-pool,
        ngm:smart-contract,
        ngm:smart-contract-execution .

ngm:green-finance a owl:Class ;
    rdfs:label "Green Finance"@en ;
    rdfs:comment "Green finance is the broad domain of financial instruments, investment strategies, market mechanisms, and regulatory frameworks that direct capital towards environmentally sustainable economic activities with the explicit objectives of mitigating climate change, halting biodiversity loss, and accelerating the transition to a low-carbon circular economy. It encompasses green bonds, sustainability-linked loans and bonds, green funds, voluntary and compliance carbon markets, blended finance structures, and impact investment vehicles, all underpinned by taxonomic classification systems such as the EU Taxonomy for Sustainable Activities and the ICMA Green Bond Principles that define and verify environmental eligibility criteria. Green finance sits at the intersection of macroeconomic policy, capital markets, and environmental science, requiring robust ESG disclosure, lifecycle assessment methodologies, and increasingly blockchain-backed registries to prevent greenwashing and ensure traceability of environmental claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eu-taxonomy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:esg-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-markets ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impact-investing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blended-finance ],
        ngm:sustainable-finance ;
    vc:bridgesTo ngm:blockchain-tokenisation,
        ngm:decentralised-finance,
        ngm:regenerative-finance ;
    vc:contrastsWith ngm:conventional-finance,
        ngm:greenwashing ;
    vc:enables ngm:carbon-credit-tracking,
        ngm:environmental-sustainability,
        ngm:net-zero-transition,
        ngm:renewable-energy-investment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blended-finance,
        ngm:carbon-markets,
        ngm:green-bonds,
        ngm:impact-investing ;
    vc:isPartOf ngm:capital-markets,
        ngm:sustainable-finance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:climate-risk,
        ngm:corporate-social-responsibility,
        ngm:sustainable-development-goals ;
    vc:requires ngm:esg-reporting,
        ngm:eu-taxonomy,
        ngm:life-cycle-assessment ;
    vc:slug "green-finance" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:eu-taxonomy,
        ngm:icma-green-bond-principles,
        ngm:tcfd ;
    vc:uses ngm:carbon-credits,
        ngm:esg-investing,
        ngm:financial-instruments,
        ngm:risk-assessment .

ngm:hardware-accelerator a owl:Class ;
    rdfs:label "Hardware Accelerator"@en ;
    rdfs:comment "A hardware accelerator is a specialised electronic device designed to perform a particular class of computation far more efficiently than a general-purpose central processing unit. By dedicating silicon to highly parallel arithmetic such as matrix multiplication, accelerators dramatically increase throughput and energy efficiency for workloads like neural network training and inference. Common forms include graphics processing units, tensor processing units, field-programmable gate arrays and application-specific integrated circuits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-efficiency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fpga ],
        ngm:hardware-acceleration ;
    vc:bridgesTo ngm:parallel-computing ;
    vc:dependsOn ngm:compute-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:asic,
        ngm:fpga,
        ngm:gpu,
        ngm:tpu ;
    vc:implements ngm:hardware-acceleration,
        ngm:parallel-computing ;
    vc:isPartOf ngm:compute-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graphics-processing-unit,
        ngm:inference ;
    vc:requires ngm:energy-efficiency ;
    vc:slug "hardware-accelerator" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:inference-engine,
        ngm:neural-network .

ngm:hardware-component a owl:Class ;
    rdfs:label "Hardware Component"@en ;
    rdfs:comment "A Hardware Component is a discrete physical element — such as a processor, memory module, sensor, display panel, network interface, or power management unit — that constitutes a functional building block within a computing or electronic system. Hardware components are characterised by their electrical specifications, mechanical form factor, thermal envelope, and interface standards, and their selection and integration collectively determine the throughput, latency, energy efficiency, and reliability of the host system. They are manufactured to industry or bespoke specifications and may be field-replaceable or permanently integrated at the board or package level. In the context of embedded, edge, and spatial-computing systems, the choice of hardware components directly constrains the achievable computational workloads, sensor modalities, and communication bandwidths."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:display-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-abstraction-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:ai-accelerator,
        ngm:gpu-compute,
        ngm:neuromorphic-chip ;
    vc:contrastsWith ngm:component,
        ngm:virtual-machine ;
    vc:dependsOn ngm:semiconductor-fabrication,
        ngm:supply-chain-management ;
    vc:enables ngm:edge-inference,
        ngm:haptic-feedback,
        ngm:real-time-processing,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:display-hardware,
        ngm:memory-module,
        ngm:network-interface,
        ngm:power-management,
        ngm:sensor ;
    vc:isPartOf ngm:edge-computing-node,
        ngm:embedded-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:field-programmable-gate-array,
        ngm:system-on-chip ;
    vc:requires ngm:firmware,
