ngm:user-interface a owl:Class ;
    rdfs:label "User Interface"@en ;
    rdfs:comment "A User Interface (UI) is the set of visual, auditory, and interactive components through which a human operates a software system. In spatial and metaverse contexts, UIs extend beyond flat screens to encompass 3D menus, gesture controls, voice interfaces, and haptic feedback, mediated by head-mounted displays, handheld controllers, or bare-hand tracking. Effective UI design balances accessibility, cognitive load, and rendering performance, drawing on human-computer interaction principles and user experience research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-computer-interaction ],
