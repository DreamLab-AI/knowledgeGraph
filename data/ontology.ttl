ngm:protocol-stack a owl:Class ;
    rdfs:label "Protocol Stack"@en ;
    rdfs:comment "A protocol stack is the layered set of network protocols that cooperate to provide communication services, where each layer offers services to the layer above and uses services of the layer below. Canonical examples are the OSI seven-layer model and the TCP/IP suite. Layering isolates concerns such as physical transmission, routing, transport reliability, and application semantics, enabling modular interoperable networking."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:network-communication,
        ngm:network-layer ;
    vc:slug "protocol-stack" ;
    vc:sourceDomain "infrastructure" .

ngm:provenance a owl:Class ;
    rdfs:label "Provenance"@en ;
    rdfs:comment "The documented record of the origin, history and chain of custody of data or assets, used to establish authenticity, trust and accountability."@en ;
