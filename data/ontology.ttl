    vc:slug "semantic-scene-understanding" ;
    vc:sourceDomain "ai" .
ngm:semantic-search a owl:Class ;
    rdfs:comment "Semantic search is a retrieval paradigm that understands the meaning and intent of queries and documents rather than relying solely on lexical keyword overlap, deploying continuous vector representations of text—produced by neural encoder models that compress sentences into dense embedding spaces..."@en ;
    rdfs:label "Semantic Search"@en ;
