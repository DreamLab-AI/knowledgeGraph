ngm:self-driving-car a owl:Class ;
    rdfs:label "Self Driving Car"@en ;
    rdfs:comment "A self-driving car is an autonomous passenger vehicle capable of sensing its environment and operating with minimal or no human input, employing AI-driven perception, decision-making, and control systems to navigate roads, comply with traffic regulations, and transport occupants safely. Self-driving cars represent the consumer application of autonomous vehicle technology, typically targeting SAE Level 3–5 automation in urban and highway environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:autonomous-vehicle ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adas ;
    vc:requires ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "self-driving-car" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:lidar,
        ngm:motion-planning .

ngm:self-presence a owl:Class ;
    rdfs:label "Self Presence"@en ;
    rdfs:comment "The subjective sense that one's virtual or avatar representation in a mediated environment is a genuine extension of the physical self — encompassing body ownership, proprioceptive coherence, and self-location within virtual space. Self presence is a component of overall presence and a prerequisite for authentic immersive collaboration, as it governs how naturally users interact with and move through shared virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-avatar ],
        ngm:dc-telepresence,
        ngm:presence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:embodied-ai,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:immersion,
        ngm:presence ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:emotional-immersion,
        ngm:social-presence,
        ngm:spatial-presence,
        ngm:user-experience,
        ngm:virtual-presence ;
    vc:requires ngm:avatar,
        ngm:digital-avatar ;
    vc:slug "self-presence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-capture .

ngm:separation-of-powers a owl:Class ;
    rdfs:label "Separation Of Powers"@en ;
    rdfs:comment "Governance design patterns in decentralized autonomous organizations that distribute authority across distinct functional roles, preventing concentration of control through checks and balances between proposal creation, voting, execution, and oversight functions."@en ;
    rdfs:subClassOf ngm:dao-governance,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:decentralized-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "separation-of-powers" ;
    vc:sourceDomain "spatial-computing" .

ngm:service-oriented-architecture a owl:Class ;
    rdfs:label "Service Oriented Architecture"@en ;
    rdfs:comment "An architectural style organizing software as loosely coupled, interoperable services that communicate through standardized interfaces, enabling modular composition of metaverse functionality through reusable components and well-defined contracts."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:software-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "service-oriented-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:shared-ar-experiences a owl:Class ;
    rdfs:label "Shared Ar Experiences"@en ;
    rdfs:comment "Collaborative augmented reality interactions enabling multiple users to simultaneously view and interact with digital content overlaid on shared physical environments, supporting real-time synchronization of virtual objects across devices for social connection and joint activities."@en ;
    rdfs:subClassOf ngm:augmented-reality,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:social-ar-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "shared-ar-experiences" ;
    vc:sourceDomain "spatial-computing" .

ngm:sink-mechanism a owl:Class ;
    rdfs:label "Sink Mechanism"@en ;
    rdfs:comment "A Sink Mechanism is an economic design pattern that permanently removes virtual currency, tokens, or items from circulation in order to counterbalance sources of supply and maintain economic equilibrium, preventing hyperinflation in metaverse economies, play-to-earn platforms, and DeFi protocols. Effective sinks are integrated into desirable activities — such as cosmetic purchases, crafting costs, or transaction fees — so that value removal feels voluntary and rewarding to participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economic-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-currency ],
        ngm:bc-defi-and-economics,
        ngm:virtual-economy ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:inflation ;
    vc:enables ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenomics,
        ngm:virtual-economy ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:economic-mechanism,
        ngm:virtual-currency ;
    vc:slug "sink-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:social-impact a owl:Class ;
    rdfs:label "Social Impact"@en ;
    rdfs:comment "Social Impact refers to the full spectrum of effects — positive and negative, intended and unintended — that AI systems and digital technologies exert on individuals, communities, and social structures, encompassing changes to employment patterns, educational access, cultural practices, power distributions, social cohesion, and fundamental rights. Assessing social impact requires both quantitative metrics and qualitative analysis across affected stakeholder groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:social-impact-assessment-sia ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:digital-society-harms ;
    vc:enables ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-society,
        ngm:social-contract,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:ai-impact-assessment,
        ngm:social-impact-assessment-sia ;
    vc:slug "social-impact" ;
    vc:sourceDomain "spatial-computing" .

ngm:social-impact-assessment-sia a owl:Class ;
    rdfs:label "Social Impact Assessment (SIA)"@en ;
    rdfs:comment "Systematic eof potential social consequences of metaverse deployment on communities, stakeholder groups, and societal well-being."@en ;
