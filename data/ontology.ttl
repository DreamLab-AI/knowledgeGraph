ngm:digital-platform a owl:Class ;
    rdfs:label "Digital Platform"@en ;
    rdfs:comment "A Digital Platform is a software-mediated environment that enables interaction, transaction, and value exchange between multiple user groups, often exploiting network effects to grow. In spatial computing and Web3 contexts, digital platforms host virtual experiences, marketplaces, and decentralised applications, frequently integrating blockchain infrastructure for ownership and governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-ecosystem ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-asset-ecosystem ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:computing-platform,
        ngm:digital-content ;
    vc:slug "digital-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:distributed-ai-training a owl:Class ;
    rdfs:label "Distributed AI Training"@en ;
    rdfs:comment "Distributed AI training is the practice of training machine-learning models across many compute nodes in parallel to handle datasets and model sizes that exceed a single machine. It uses strategies such as data parallelism, model and tensor parallelism, and pipeline parallelism, coordinated by collective communication and gradient synchronisation. It is essential for training large neural networks within feasible time and memory budgets."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:di-lo-co,
        ngm:distributed-computing ;
    vc:slug "distributed-ai-training" ;
    vc:sourceDomain "ai" .

ngm:distributed-protocol a owl:Class ;
    rdfs:label "Distributed Protocol"@en ;
    rdfs:comment "A Distributed Protocol is a formally specified set of rules, message formats, and procedures governing communication, coordination, and state synchronization among independent nodes in a distributed network without centralized control."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:blockchain-entity ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "distributed-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:distributed-work a owl:Class ;
    rdfs:label "Distributed Work"@en ;
    rdfs:comment "Organisational models, practices, and enabling technologies that allow geographically dispersed teams to collaborate effectively whilst maintaining productivity, cohesion, and wellbeing. Distributed work encompasses remote, hybrid, and globally distributed team configurations, supported by asynchronous communication norms, shared documentation practices, and virtual presence technologies ranging from video conferencing to XR meeting spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration-platform ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:virtual-collaboration ;
    vc:requires ngm:asynchronous-collaboration,
        ngm:collaboration-platform ;
    vc:slug "distributed-work" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:xr-meeting-space .

ngm:documentation a owl:Class ;
    rdfs:label "Documentation"@en ;
    rdfs:comment "Documentation is the structured body of written, diagrammatic, or interactive material that describes the purpose, design, behaviour, and use of a system, dataset, process, or software artefact. It serves as the primary medium through which knowledge about an artefact is transferred between its creators and its users, maintainers, and auditors. Effective documentation spans reference material, conceptual explanations, tutorials, and procedural guides, and is increasingly treated as a versioned, testable component of the artefact itself rather than an afterthought."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        ngm:data ;
    vc:contrastsWith ngm:tribal-knowledge ;
    vc:dependsOn ngm:data ;
    vc:enables ngm:maintainability,
        ngm:onboarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-reference,
        ngm:tutorial ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:reproducible-research,
        ngm:technical-writing ;
    vc:requires ngm:metadata,
        ngm:version-control ;
    vc:slug "documentation" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:knowledge-management,
        ngm:reproducibility ;
    vc:uses ngm:markdown,
        ngm:static-site-generation .

ngm:e-waste a owl:Class ;
    rdfs:label "E-Waste"@en ;
    rdfs:comment "E-waste is discarded electrical and electronic equipment, including devices that have reached the end of their useful life. Managing it involves recycling, recovery, and safe disposal."@en ;
    rdfs:subClassOf ngm:circular-economy ;
    vc:enables ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "e-waste" ;
    vc:sourceDomain "governance" .

ngm:ecash a owl:Class ;
    rdfs:label "ecash"@en ;
    rdfs:comment "A privacy-preserving digital cash system based on David Chaum's blind-signature cryptography, enabling bearer-token payments in which the issuing mint cannot link individual transactions to users. Modern implementations such as Cashu and Fedimint build Chaumian eCash on top of Bitcoin and the Lightning Network, enabling censorship-resistant micropayments for human and autonomous-agent use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:censorship-resistance ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:payment-system ;
    vc:enables ngm:identity-management,
        ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:cashu,
        ngm:smart-contracts ;
    vc:requires ngm:censorship-resistance ;
    vc:slug "ecash" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:lightning-network .

ngm:eclair a owl:Class ;
    rdfs:label "Eclair"@en ;
    rdfs:comment "Eclair is an open-source, production-grade implementation of the Bitcoin Lightning Network protocol, written in Scala and developed by ACINQ. It implements the full BOLT specification suite, enabling trustless off-chain payment channels, multi-hop routing, and peer-to-peer gossip between Lightning nodes. Eclair serves as the backend engine for ACINQ's Phoenix mobile wallet and is widely deployed as a routing node by businesses and individuals seeking high-throughput, low-latency Bitcoin micropayments. It is interoperable with other conformant Lightning implementations such as LND and Core Lightning through shared adherence to the BOLT standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:htlc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance ;
    vc:contrastsWith ngm:core-lightning,
        ngm:lnd ;
    vc:dependsOn ngm:bitcoin,
        ngm:seg-wit ;
    vc:enables ngm:instant-settlement,
        ngm:micropayment,
        ngm:payment-routing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bolt-specifications,
        ngm:lightning-network ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:acinq,
        ngm:payment-channel-network ;
    vc:requires ngm:bitcoin-node,
        ngm:htlc,
        ngm:payment-channel ;
    vc:slug "eclair" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:payment-network,
        ngm:phoenix-wallet ;
    vc:uses ngm:akka-framework,
        ngm:gossip-protocol,
        ngm:onion-routing,
        ngm:programming-language .

ngm:economic-security a owl:Class ;
    rdfs:label "Economic Security"@en ;
    rdfs:comment "Cost of attack vs reward within blockchain systems, providing essential functionality for distributed ledger technology operations and properties."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics,
