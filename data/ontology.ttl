    rdfs:label "tc 0002 collaborative document editing"@en ;
    rdfs:comment "Collaborative Document Editing - Real-time or asynchronous shared editing technology enabling multiple distributed users to simultaneously create, modify, and comment on digital documents with live synchronization and version control."@en ;
