ngm:validator-node a owl:Class ;
    rdfs:label "Validator Node"@en ;
    rdfs:comment "A network participant in a Proof of Stake or similar blockchain that locks collateral (stake) to earn the right to propose and attest to blocks, and is subject to slashing penalties for equivocation or liveness failures. Validator nodes form the security backbone of staking-based consensus, replacing the hash-rate competition of mining."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bls-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slashing-condition ],
        ngm:blockchain-entity ;
    vc:bridgesTo ngm:distributed-system,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:full-node,
        ngm:mining-node ;
    vc:dependsOn ngm:committee-selection,
        ngm:consensus-mechanism,
        ngm:epoch ;
    vc:enables ngm:block,
        ngm:block-attestation,
        ngm:staking-reward,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:beacon-node,
        ngm:staking-key,
        ngm:validator-client ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:isPartOf ngm:blockchain-network,
        ngm:peer-to-peer-network,
        ngm:proof-of-stake,
        ngm:validator-set ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:finality,
        ngm:sybil-resistance ;
    vc:requires ngm:bls-signature,
        ngm:slashing-condition,
        ngm:stake ;
    vc:slug "validator-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralization,
        ngm:network-security ;
    vc:uses ngm:cryptographic-signature,
        ngm:public-key-infrastructure,
        ngm:schnorr-signature .

ngm:blockchain-transaction a owl:Class ;
    rdfs:label "Blockchain Transaction"@en ;
    rdfs:comment "A Blockchain Transaction is an atomic, cryptographically signed instruction that encodes a state-change on a distributed ledger — such as a transfer of digital assets, invocation of a smart contract function, or mutation of on-chain data. Transactions are broadcast to a peer-to-peer network, validated against protocol rules and the active consensus mechanism, and permanently recorded in an ordered block once accepted. The transaction model differs fundamentally between UTXO-based chains (e.g. Bitcoin) and account-based chains (e.g. Ethereum), affecting parallelism, privacy, and composability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utxo ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-fee ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:digital-identity,
        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:database-transaction,
        ngm:traditional-payment ;
    vc:enables ngm:atomic-swap,
        ngm:decentralised-finance,
        ngm:payment-system,
        ngm:smart-contract,
        ngm:tokenisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:merkle-tree,
        ngm:transaction-input,
        ngm:transaction-nonce,
        ngm:transaction-output,
        ngm:utxo ;
    vc:isPartOf ngm:blockchain,
        ngm:distributed-ledger ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:layer-2-protocol,
        ngm:transaction-throughput ;
    vc:requires ngm:consensus-algorithm,
        ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:public-key-cryptography,
        ngm:transaction-fee ;
    vc:slug "blockchain-transaction" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:mempool,
        ngm:zero-knowledge-proof .

ngm:consensus-protocol a owl:Class ;
    rdfs:label "Consensus Protocol"@en ;
    rdfs:comment "A consensus protocol is a set of rules and algorithms by which distributed network participants reach agreement on a single shared state or value without requiring centralised authority, ensuring liveness, safety, and Byzantine fault tolerance up to a specified threshold of adversarial nodes. Classical families include compute-bound Proof-of-Work, stake-weighted Proof-of-Stake, and message-passing BFT protocols such as PBFT, Tendermint, and HotStuff. Each protocol specifies leader election, block proposal, voting rounds, and finality conditions that together determine throughput, latency, decentralisation, and security trade-offs. Consensus protocols underpin blockchains, distributed databases, and any replicated state machine requiring deterministic agreement across potentially unreliable or malicious peers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finality-gadget ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:federated-learning,
        ngm:multi-agent-coordination ;
    vc:contrastsWith ngm:centralised-database,
        ngm:raft-consensus ;
    vc:dependsOn ngm:network-topology,
        ngm:sybil-resistance ;
    vc:enables ngm:blockchain,
        ngm:decentralised-finance,
        ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:byzantine-fault-tolerance,
        ngm:finality-gadget,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:implements ngm:distributed-agreement,
        ngm:replicated-state-machine ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:block-production,
        ngm:fork-choice-rule,
        ngm:leader-election,
        ngm:paxos,
        ngm:validator-node ;
