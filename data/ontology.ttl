ngm:nft-standard a owl:Class ;
    rdfs:label "NFT Standard"@en ;
    rdfs:comment "An NFT Standard is a formally specified interface and data schema that defines how non-fungible tokens are created, transferred, and queried on a blockchain network, ensuring interoperability across wallets, marketplaces, and decentralised applications. Dominant examples include ERC-721 (Ethereum, unique single tokens), ERC-1155 (multi-token standard combining fungible and non-fungible types in one contract), and EIP-2981 (royalty standard). These specifications are ratified through Ethereum Improvement Proposals or analogous governance processes on other chains, and they collectively establish the canonical interface any compliant smart contract must expose."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eip-2981 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-721 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-1155 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-twin,
        ngm:metaverse-asset,
        ngm:provenance-tracking ;
    vc:contrastsWith ngm:erc-20,
        ngm:fungible-token ;
    vc:dependsOn ngm:ethereum,
        ngm:ipfs,
        ngm:solidity ;
    vc:enables ngm:digital-ownership,
        ngm:nft-marketplace,
        ngm:non-fungible-token,
        ngm:on-chain-royalty ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:eip-2981,
        ngm:erc-1155,
        ngm:erc-721,
        ngm:token-metadata-schema ;
    vc:implements ngm:ethereum-improvement-proposal,
        ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:token-standard,
        ngm:web3 ;
    vc:requires ngm:blockchain,
        ngm:decentralised-storage ;
    vc:slug "nft-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-foundation ;
    vc:supports ngm:digital-art,
        ngm:gaming-asset,
        ngm:tokenised-real-world-asset .

ngm:novel-view-synthesis a owl:Class ;
    rdfs:label "Novel View Synthesis"@en ;
    rdfs:comment "Novel view synthesis (NVS) is a computer vision and computer graphics task that involves generating photorealistic images of a scene from camera viewpoints not present in the original set of captured images, given a collection of reference photographs and their corresponding camera poses. The task requires learning an implicit or explicit representation of the scene's geometry and appearance that supports free-viewpoint rendering with high fidelity. It is a foundational capability for immersive media, telepresence, and spatial computing applications, and has been dramatically advanced by neural scene representations such as Neural Radiance Fields and 3D Gaussian Splatting."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:bridgesTo ngm:autonomous-driving-simulation,
        ngm:extended-reality,
        ngm:generative-ai ;
    vc:contrastsWith ngm:stereo-reconstruction,
        ngm:traditional-3d-modelling ;
    vc:dependsOn ngm:ray-casting,
        ngm:scene-representation ;
    vc:enables ngm:free-viewpoint-video,
        ngm:immersive-media-production,
        ngm:synthetic-training-data-generation,
        ngm:virtual-reality-telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3d-scene-reconstruction,
        ngm:differentiable-rendering,
        ngm:image-based-rendering,
        ngm:neural-radiance-field,
        ngm:photogrammetry ;
    vc:requires ngm:camera-pose-estimation,
        ngm:multi-view-images ;
    vc:slug "novel-view-synthesis" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:camera-calibration,
        ngm:depth-estimation,
        ngm:multi-layer-perceptron,
        ngm:neural-rendering,
        ngm:structure-from-motion,
        ngm:volume-rendering .

ngm:occupancy-grid a owl:Class ;
    rdfs:label "Occupancy Grid"@en ;
    rdfs:comment "An occupancy grid is a probabilistic spatial representation of a robot's environment as a discretised lattice of cells, each storing a probability or log-odds value indicating the likelihood that the corresponding region of space is occupied by an obstacle. It provides a metric map suitable for collision avoidance, path planning, and SLAM by fusing noisy sensor measurements through Bayesian updates."@en ;
    rdfs:subClassOf ngm:environment-mapping ;
    vc:bridgesTo ngm:birds-eye-view-perception,
        ngm:neural-occupancy-prediction ;
    vc:contrastsWith ngm:feature-map,
        ngm:topological-map ;
    vc:enables ngm:autonomous-navigation,
        ngm:collision-avoidance,
        ngm:global-path-planning,
        ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:grid-cell,
        ngm:probability-map ;
    vc:implements ngm:probabilistic-mapping ;
    vc:isPartOf ngm:metric-map ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:costmap,
        ngm:octomap,
        ngm:point-cloud,
        ngm:slam,
        ngm:voxel-grid ;
    vc:requires ngm:range-sensor,
        ngm:robot-pose-estimation ;
    vc:slug "occupancy-grid" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:bayesian-inference,
        ngm:inverse-sensor-model,
        ngm:lidar-sensor,
        ngm:log-odds-representation,
        ngm:sensor-fusion .

ngm:optical-character-recognition a owl:Class ;
    rdfs:label "Optical Character Recognition"@en ;
    rdfs:comment "Optical Character Recognition (OCR) is a technology that converts images of typed, printed, or handwritten text into machine-encoded character sequences, enabling downstream search, editing, and automated processing of scanned documents and photographs. Classical approaches segment character glyphs and classify them against trained feature descriptors; contemporary deep-learning pipelines — typically convolutional neural networks paired with sequence models such as CTC or Transformer decoders — recognise whole text lines end-to-end without explicit segmentation. OCR is a foundational building block of document intelligence, information extraction, and accessibility tooling, and underlies virtually every large-scale digitisation effort from cultural heritage archives to enterprise content management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:language-model ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:digital-twin,
        ngm:robotic-process-automation,
        ngm:supply-chain-visibility ;
    vc:contrastsWith ngm:intelligent-character-recognition,
        ngm:optical-mark-recognition ;
    vc:enables ngm:digital-accessibility,
        ngm:document-intelligence,
        ngm:information-extraction,
        ngm:knowledge-graph,
        ngm:legal-research ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:character-segmentation,
        ngm:language-model,
        ngm:layout-analysis,
        ngm:text-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:named-entity-recognition ;
    vc:requires ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:image-preprocessing ;
    vc:slug "optical-character-recognition" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:pdf-ua,
        ngm:unicode-standard ;
    vc:uses ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:recurrent-neural-network,
        ngm:transformer-architecture .

ngm:owl-class-hierarchy a owl:Class ;
    rdfs:label "OWL Class Hierarchy"@en ;
    rdfs:comment "The OWL Class Hierarchy is the directed acyclic graph (DAG) of named and anonymous classes connected via rdfs:subClassOf axioms within a Web Ontology Language (OWL) ontology, imposing a partial order on the class extension lattice. It provides the primary vehicle for monotonic inheritance of properties and restrictions, enabling description-logic reasoners such as HermiT, Pellet, and FaCT++ to classify individuals, detect unsatisfiable classes, and compute implicit subsumption relationships that are not asserted explicitly. The hierarchy is closed under the OWL semantics of the chosen profile (OWL 2 DL, EL, QL, or RL), constraining the decidability and computational complexity of reasoning tasks performed over it. Well-engineered class hierarchies underpin interoperability across domains including biomedical ontologies (GO, SNOMED CT), geospatial standards, and knowledge-graph schemas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-schema ],
        ngm:ontology-structure ;
    vc:bridgesTo ngm:machine-learning-taxonomy,
        ngm:upper-ontology ;
    vc:contrastsWith ngm:closed-world-assumption,
        ngm:property-hierarchy,
        ngm:rdf-type-hierarchy ;
    vc:dependsOn ngm:formal-semantics,
        ngm:open-world-assumption ;
    vc:enables ngm:automated-reasoning,
        ngm:consistency-checking,
        ngm:knowledge-inference,
        ngm:ontology-classification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:disjoint-classes-axiom,
        ngm:equivalent-class-axiom,
        ngm:owl-class,
        ngm:subclass-axiom ;
    vc:implements ngm:shoiq-description-logic,
        ngm:w3c-owl-standard ;
    vc:isPartOf ngm:owl-ontology ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biomedical-ontology,
        ngm:hermit-reasoner,
        ngm:pellet-reasoner,
        ngm:protege ;
    vc:requires ngm:description-logic,
        ngm:rdf-schema ;
    vc:slug "owl-class-hierarchy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:w3c ;
    vc:supports ngm:knowledge-graph,
        ngm:ontology-alignment,
        ngm:semantic-web ;
    vc:uses ngm:manchester-syntax,
        ngm:rdfs-subclass-of,
        ngm:turtle-syntax .

ngm:panoptic-segmentation a owl:Class ;
    rdfs:label "Panoptic Segmentation"@en ;
    rdfs:comment "A computer vision task that unifies semantic segmentation and instance segmentation by assigning every image pixel both a class label and an instance identifier, providing holistic scene parsing that distinguishes countable foreground objects (\"things\") from amorphous background regions (\"stuff\"). Architectures such as Panoptic FPN, Panoptic-DeepLab, and MaskFormer formalise this unified representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:instance-segmentation,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task ;
    vc:requires ngm:object-detection ;
    vc:slug "panoptic-segmentation" ;
    vc:sourceDomain "spatial-computing" .

ngm:parallel-processing a owl:Class ;
    rdfs:label "Parallel Processing"@en ;
    rdfs:comment "Parallel Processing is a computational paradigm in which multiple calculations or processes are carried out simultaneously by decomposing a problem into sub-tasks that execute concurrently across multiple processor cores, GPUs, or distributed compute nodes. It exploits data parallelism, task parallelism, and pipeline parallelism to reduce wall-clock execution time and increase throughput. Parallel processing is foundational to modern high-performance computing, enabling workloads such as large-scale neural network training, real-time physics simulation, and petabyte-scale data analytics that would be infeasible on sequential hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pipeline-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computing-infrastructure ],
        ngm:computing-infrastructure ;
    vc:bridgesTo ngm:federated-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:sequential-computing ;
    vc:dependsOn ngm:load-balancing,
        ngm:synchronisation ;
    vc:enables ngm:deep-learning,
        ngm:distributed-training,
        ngm:large-language-model,
        ngm:real-time-rendering,
        ngm:scientific-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-parallelism,
        ngm:pipeline-parallelism,
        ngm:simd,
        ngm:task-parallelism ;
    vc:isPartOf ngm:high-performance-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-programming,
        ngm:concurrency,
        ngm:distributed-computing ;
    vc:requires ngm:computing-infrastructure,
        ngm:interconnect,
        ngm:memory-bandwidth ;
    vc:slug "parallel-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cuda,
        ngm:mpi,
        ngm:openmp ;
    vc:uses ngm:gpu-compute,
        ngm:multi-core-processor,
        ngm:thread .

ngm:peer-review a skos:Concept ;
    rdfs:label "Peer Review"@en .

ngm:permissionless-participation a owl:Class ;
    rdfs:label "Permissionless Participation"@en ;
    rdfs:comment "Permissionless participation is the property of a network whereby any actor may join, transact, validate, or contribute without requesting approval from a central authority. It is a defining characteristic of public blockchains, where open access to running nodes and proposing or validating blocks underpins censorship resistance and decentralisation. The property is enforced by economic and cryptographic mechanisms rather than identity vetting."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:consensus-mechanism ;
    vc:slug "permissionless-participation" ;
    vc:sourceDomain "blockchain" .

ngm:platform-engineering a owl:Class ;
    rdfs:label "Platform Engineering"@en ;
    rdfs:comment "Platform Engineering is the discipline of designing, building, and operating internal developer platforms (IDPs) that abstract infrastructure complexity and provide self-service toolchains, automated CI/CD pipelines, and standardised operational workflows for software engineering teams. It treats the IDP as a product, applying product management techniques to improve developer experience and reduce cognitive load. Platform Engineering sits at the intersection of DevOps, site reliability engineering, and cloud-native infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technology-infrastructure-domain-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-transformation,
        ngm:software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-gateway,
        ngm:orchestration,
        ngm:technology-infrastructure-domain-architecture,
        ngm:version-control ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:computing-platform,
        ngm:development-platform,
        ngm:digital-infrastructure,
        ngm:industry-cloud-platforms,
        ngm:service-oriented-architecture ;
    vc:slug "platform-engineering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:cloud-native-applications,
        ngm:microservices-architecture .

ngm:policy-enforcement-point a owl:Class ;
    rdfs:label "Policy Enforcement Point"@en ;
    rdfs:comment "A Policy Enforcement Point (PEP) is a runtime architectural component in access control systems that intercepts every request for a protected resource, forwards a structured authorisation query to a Policy Decision Point (PDP), and enforces the returned permit, deny, or obligation decision at the resource boundary. The PEP–PDP separation, first formalised in the OASIS XACML standard, decouples policy logic from enforcement infrastructure and enables centralised policy management across heterogeneous systems. In zero-trust architectures every network transaction passes through a PEP, which may be realised as a reverse proxy, API gateway, service mesh sidecar, network firewall, or identity-aware proxy. The model extends naturally to software-defined perimeters, ABAC deployments, and AI governance enforcement layers where model prompts and outputs must satisfy content policies before reaching end users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-decision-point ],
        ngm:access-control ;
    vc:bridgesTo ngm:ai-governance,
        ngm:data-mesh ;
    vc:contrastsWith ngm:network-perimeter-security,
        ngm:role-based-access-control ;
    vc:enables ngm:attribute-based-access-control,
        ngm:continuous-verification,
        ngm:least-privilege,
        ngm:privileged-access-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:access-control-policy,
        ngm:authorisation ;
    vc:isPartOf ngm:xacml-architecture,
        ngm:zero-trust-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:identity-and-access-management,
        ngm:policy-administration-point,
        ngm:policy-enforcement,
        ngm:reverse-proxy,
        ngm:software-defined-perimeter ;
    vc:requires ngm:authentication,
        ngm:policy-decision-point,
        ngm:policy-information-point ;
    vc:slug "policy-enforcement-point" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-sp-800-207,
        ngm:xacml ;
    vc:supports ngm:audit-logging,
        ngm:compliance-enforcement,
        ngm:data-governance ;
    vc:uses ngm:api-gateway,
        ngm:mutual-tls,
        ngm:oauth-2-0,
        ngm:service-mesh .

ngm:position-sensor a owl:Class ;
    rdfs:label "Position Sensor"@en ;
    rdfs:comment "A position sensor is a transducer that measures the displacement, angle, or spatial location of an object or joint relative to a reference frame, converting mechanical position into an electrical signal suitable for control system feedback. Position sensors are fundamental to closed-loop robotic and mechatronic systems, enabling precise joint control, end-effector placement, and localisation. They span a wide range of physical measurement principles including optical encoding, magnetic hall-effect sensing, capacitive displacement, and inductive resolver techniques."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:localization,
        ngm:robot-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:imu,
        ngm:linear-encoder,
        ngm:proprioceptive-sensor,
        ngm:rotary-encoder ;
    vc:slug "position-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-kinematics,
        ngm:robotic-control .

ngm:power-electronics a owl:Class ;
    rdfs:label "Power Electronics"@en ;
    rdfs:comment "Power electronics is the engineering discipline concerned with the conversion and control of electrical power using switching semiconductor devices such as MOSFETs, IGBTs and SiC transistors, central to motor drives, power supplies, inverters and energy management systems."@en ;
    rdfs:subClassOf ngm:embedded-systems ;
    vc:bridgesTo ngm:electric-vehicle,
        ngm:robotics,
        ngm:smart-grid ;
    vc:contrastsWith ngm:linear-power-supply ;
    vc:dependsOn ngm:feedback-control,
        ngm:pulse-width-modulation ;
    vc:enables ngm:electric-motor,
        ngm:motor-driver,
        ngm:servo-motor,
        ngm:variable-frequency-drive,
        ngm:wireless-power-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dc-dc-converter,
        ngm:gate-driver,
        ngm:inverter,
        ngm:rectifier ;
    vc:isPartOf ngm:embedded-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-harvesting,
        ngm:microcontroller ;
    vc:requires ngm:electromagnetic-compatibility,
        ngm:switching-semiconductor,
        ngm:thermal-management ;
    vc:slug "power-electronics" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-61800,
        ngm:ieee-standards ;
    vc:supports ngm:battery-management-system,
        ngm:renewable-energy-integration ;
    vc:uses ngm:igbt,
        ngm:mosfet,
        ngm:silicon-carbide .

ngm:priority-fee a owl:Class ;
    rdfs:label "Priority Fee"@en ;
    rdfs:comment "A Priority Fee (also called a miner tip or validator tip) is an optional, user-specified additional payment on top of the base fee in EIP-1559-compatible blockchains, paid directly to the block producer to incentivise preferential inclusion and ordering of a transaction within the next block. By offering a higher tip, users signal urgency and compete for limited block space during periods of network congestion, enabling a market-based transaction prioritisation mechanism. Priority fees are burned alongside the base fee under EIP-1559's fee model only partially — the base fee is burned while the priority fee flows to the validator, aligning incentives for prompt transaction confirmation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:burning-mechanism ;
    vc:dependsOn ngm:base-fee,
        ngm:eip-1559 ;
    vc:enables ngm:gas-optimization,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gas ;
    vc:isPartOf ngm:fee-market,
        ngm:tokenomics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:gas-price,
        ngm:transaction-fee,
        ngm:validator-node ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "priority-fee" ;
    vc:sourceDomain "blockchain" .

ngm:privacy-policy a owl:Class ;
    rdfs:label "Privacy Policy"@en ;
    rdfs:comment "A privacy policy is a formal legal disclosure instrument through which an organisation communicates to data subjects the categories of personal data collected, the purposes and legal bases for processing, retention periods, third-party sharing arrangements, and individual rights available under applicable regulations. Such documents are mandated by data protection frameworks including the EU General Data Protection Regulation (GDPR), the UK Data Protection Act 2018, and the California Consumer Privacy Act (CCPA), each requiring clear, accessible language and prominent placement at the point of data collection to constitute valid notice. Privacy policies function both as a transparency mechanism for individuals and as a compliance artefact evidencing an organisation's accountability obligations. As AI systems introduce novel data flows—inference logging, training on user data, automated decision-making—privacy policies must be continuously updated to reflect these processing activities accurately."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection-regulation ],
        ngm:data-governance ;
    vc:bridgesTo ngm:ai-transparency,
