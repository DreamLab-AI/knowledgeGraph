ngm:xr-testing-infrastructure a owl:Class ;
    rdfs:label "XR Testing Infrastructure"@en ;
    rdfs:comment "The hardware, software, and modological frameworks for validating extended reality applications, including automated testing tools, motion capture systems, user testing labs, performance profiling equipment, and simulation environments for quality assurance of VR, AR, and MR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tracking-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:infra-software-engineering,
        ngm:testing-infrastructure ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:accessibility,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:latency,
        ngm:tracking-technology ;
    vc:slug "xr-testing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:extended-reality,
        ngm:immersive-experience,
        ngm:user-research .

