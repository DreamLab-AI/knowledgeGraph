ngm:fee-market a owl:Class ;
    rdfs:label "Fee Market"@en ;
    rdfs:comment "A Fee Market is the mechanism by which blockchain participants competitively bid transaction fees to have their transactions included in blocks, with miners or validators selecting transactions that maximise their revenue given limited block capacity. Fee markets emerge from the interplay between fixed block-space supply and variable transaction demand, producing dynamic price discovery that signals network congestion. Ethereum's EIP-1559 introduced a protocol-level base fee that adjusts algorithmically each block, partially burning fees to reduce token supply and adding a tip mechanism for priority inclusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-size ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:blockchain ;
    vc:enables ngm:blockchain-transaction,
        ngm:miner ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee,
        ngm:transaction-fee ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:gas-price,
        ngm:proof-of-work,
        ngm:tokenomics ;
    vc:requires ngm:block-size,
        ngm:mempool ;
    vc:slug "fee-market" ;
    vc:sourceDomain "blockchain" .

ngm:filecoin a owl:Class ;
    rdfs:label "Filecoin"@en ;
    rdfs:comment "Filecoin is a decentralised storage network and blockchain protocol developed by Protocol Labs that creates a peer-to-peer marketplace for file storage and retrieval, using cryptographic proofs—Proof of Replication (PoRep) and Proof of Spacetime (PoSt)—to verifiably demonstrate that storage providers are dedicating physical disk space to client data over time. Storage providers earn FIL tokens by fulfilling storage deals and continuously proving their commitments on-chain, while clients pay FIL to store data with economic guarantees backed by the provider's staked collateral. Built on top of IPFS (InterPlanetary File System) for content-addressed data retrieval, Filecoin provides the economic incentive layer designed to make decentralised storage commercially viable, and has since expanded via the Filecoin Virtual Machine (FVM) to support programmable storage deals and decentralised autonomous organisations governing shared datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:decentralized-storage ;
    vc:bridgesTo ngm:machine-learning-discipline-infrastructure ;
    vc:contrastsWith ngm:arweave,
        ngm:cloud-storage,
        ngm:storj ;
    vc:enables ngm:dao,
        ngm:decentralized-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proof-of-work,
        ngm:token-economics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:decentralized-autonomous-organization,
        ngm:distributed-storage,
        ngm:peer-to-peer-network ;
