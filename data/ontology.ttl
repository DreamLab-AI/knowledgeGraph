ngm:ai-audit a owl:Class ;
    rdfs:label "AI Audit"@en ;
    rdfs:comment "A systematic, independent examination and eof an artificial intelligence system's design, development processes, deployment procedures, operational performance, documentation, governance arrangements, and compliance with applicable requirements, conducted by qualified assessors to verify conformi..."@en ;
