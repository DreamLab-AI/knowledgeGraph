ngm:inter-process-communication a owl:Class ;
    rdfs:comment "Inter-process communication (IPC) is the set of mechanisms an operating system provides for separate processes to exchange data and coordinate their actions despite running in isolated address spaces. Common mechanisms include pipes, message queues, shared memory, sockets and remote procedure calls, each trading off speed, structure and scope. IPC is foundational to modular system design, microservices and any architecture composed of cooperating processes."@en ;
    rdfs:label "Inter Process Communication"@en ;
    rdfs:subClassOf ngm:operating-system ;
    rdfs:subClassOf _:r12726 ;
