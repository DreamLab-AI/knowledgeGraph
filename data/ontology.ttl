ngm:erc-3643 a owl:Class ;
    rdfs:label "ERC-3643"@en ;
    rdfs:comment "ERC-3643 is an Ethereum token standard, also known as T-REX (Token for Regulated EXchanges), that enables the issuance and management of permissioned security tokens on public blockchain infrastructure. It embeds on-chain identity verification and compliance rule enforcement into the token transfer logic, ensuring that only verified, eligible investors can hold and transfer regulated digital assets. The standard extends ERC-20 with an identity registry, modular compliance modules, and claim-based permissioning, making it suitable for tokenised securities, real-world assets, and other regulated financial instruments. ERC-3643 was standardised through the Ethereum Improvement Proposal process and has been adopted by multiple institutional asset tokenisation platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:token-standard ;
    vc:bridgesTo ngm:financial-regulation,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:erc-1400,
        ngm:erc-1404,
        ngm:erc-20 ;
    vc:enables ngm:asset-tokenisation,
        ngm:permissioned-transfer,
        ngm:regulatory-compliance,
        ngm:security-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-20,
        ngm:erc-734,
        ngm:erc-735 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:aml-compliance,
        ngm:decentralised-finance,
        ngm:digital-securities,
        ngm:real-world-asset-tokenisation ;
    vc:requires ngm:decentralised-identity,
        ngm:ethereum,
        ngm:kyc,
        ngm:smart-contract ;
    vc:slug "erc-3643" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:claim-issuer,
        ngm:compliance-module,
        ngm:identity-registry,
        ngm:on-chain-identity .

ngm:erc-721-standard a owl:Class ;
    rdfs:label "ERC-721 Standard"@en ;
    rdfs:comment "ERC-721 is an Ethereum token standard defining a minimal interface for non-fungible tokens (NFTs), where each token carries a unique identifier that distinguishes it from every other token in the same contract. It specifies ownership tracking, safe transfer functions, and an optional metadata extension for associating URIs with token properties."@en ;
    rdfs:subClassOf ngm:nft-standard ;
    vc:contrastsWith ngm:erc20-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-1155,
        ngm:ethereum-smart-contract-platform,
        ngm:nft ;
    vc:slug "erc-721-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ipfs .

ngm:erc1400-standard a owl:Class ;
    rdfs:label "ERC1400 Standard"@en ;
    rdfs:comment "Security token standard with compliance controls and transfer restrictions."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc1400-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc20-standard a owl:Class ;
    rdfs:label "ERC20 Standard"@en ;
    rdfs:comment "Technical standard for fungible tokens on ereum, defining required mods and events for token contracts."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc20-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc20-token a owl:Class ;
    rdfs:label "ERC20 Token"@en ;
    rdfs:comment "An ERC20 Token is a fungible token implementing the ERC-20 interface standard on the Ethereum blockchain, which defines a uniform set of six mandatory functions (totalSupply, balanceOf, transfer, transferFrom, approve, allowance) enabling interoperability between token contracts, decentralised exchanges, wallets, and DeFi protocols without bespoke integration. ERC-20 became the dominant token standard following its formalisation in 2015 and is used for utility tokens, governance tokens, stablecoins, and wrapped assets. The standard's fungibility means all token units are identical and mutually interchangeable, contrasting with ERC-721 non-fungible tokens that represent distinct assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset,
        ngm:fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-721,
        ngm:nft ;
    vc:enables ngm:transaction,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:liquidity-pool,
        ngm:payment-token,
        ngm:security-token,
        ngm:stablecoin-token,
        ngm:utility-token ;
    vc:requires ngm:blockchain,
        ngm:smart-contract,
        ngm:token-standard ;
    vc:slug "erc20-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gas,
        ngm:token-economics .

ngm:erc20-votes-standard a owl:Class ;
    rdfs:label "ERC20Votes Standard"@en ;
    rdfs:comment "ERC20Votes is an extension of the ERC-20 fungible-token standard that adds on-chain governance capabilities by tracking historical voting power through checkpointed balances and supporting delegation of votes. It records a snapshot of each account's balance at every block where it changes, so a governance contract can query voting weight at a specific past block, preventing double-voting and flash-loan manipulation. Implemented in widely audited libraries, it is the dominant pattern for token-based voting in decentralised autonomous organisations."@en ;
    rdfs:subClassOf ngm:erc20-standard ;
    vc:enables ngm:dao ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-20-votes,
        ngm:ethereum-smart-contract-platform ;
    vc:slug "erc20-votes-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:erc721 a owl:Class ;
    rdfs:label "ERC721"@en ;
    rdfs:comment "ERC721 is the Ethereum non-fungible token standard enabling unique, individually identified digital assets each with a distinct tokenId and metadata URI. It specifies eight mandatory functions and three events supporting ownership transfer, provenance tracking, and approval management, underpinning NFT markets, digital art, gaming items, and tokenised real-world assets on EVM-compatible blockchains."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc20 ;
    vc:enables ngm:digital-asset-management,
        ngm:digital-ownership,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:smart-contract,
        ngm:token-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc721" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum-smart-contract-platform,
        ngm:provenance-tracking .

ngm:ergonomics a skos:Concept ;
    rdfs:label "Ergonomics"@en .

ngm:error-calculation a owl:Class ;
    rdfs:label "Error Calculation"@en ;
    rdfs:comment "Error calculation is the step in a control system that computes the difference between a desired setpoint and the measured process variable. This error term is the input that drives corrective action in feedback controllers such as PID loops. Accurate, low-latency error calculation is essential for stable and responsive position, velocity, and other regulated control behaviours."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:velocity-control ;
    vc:slug "error-calculation" ;
    vc:sourceDomain "robotics" .

ngm:esma a owl:Class ;
    rdfs:label "ESMA"@en ;
    rdfs:comment "The European Securities and Markets Authority (ESMA) is the European Union's independent financial regulator responsible for safeguarding the stability and integrity of EU securities markets. It develops technical standards, supervises certain market participants such as credit-rating agencies, and coordinates national regulators to ensure consistent application of EU financial law. ESMA plays a central role in regimes such as MiCA for crypto-assets and in securities and regulatory-reporting rules."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting,
        ngm:securities-regulation ;
    vc:slug "esma" ;
    vc:sourceDomain "governance" .

ngm:ethics-and-law a owl:Class ;
    rdfs:label "Ethics and Law"@en ;
    rdfs:comment "Ethics and law is the combined domain concerned with the moral principles and binding legal rules that govern the development and deployment of technology. Ethics addresses what ought to be done, while law codifies enforceable obligations such as liability, privacy, and rights. In AI and data governance the two are treated together because responsible systems must satisfy both normative expectations and statutory requirements."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:governance ;
    vc:slug "ethics-and-law" ;
    vc:sourceDomain "governance" .

ngm:etsi-domain-identity-and-trust a owl:Class ;
    rdfs:label "ETSI Domain Identity and Trust"@en ;
    rdfs:comment "An ETSI governance domain establishing identity management, authentication, and trust infrastructure for virtual environments. It integrates decentralised identity models, verifiable credentials, biometric authentication, zero-trust architecture, and multi-party trust platforms aligned with eIDAS 2.0 and ISO/IEC 24760, enabling secure, privacy-respecting identity assurance across distributed metaverse platforms and consortia."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-trust-architecture ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:digital-identity-framework,
        ngm:digital-identity-wallet ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-security-and-privacy ;
    vc:requires ngm:digital-identity,
        ngm:zero-trust-architecture ;
    vc:slug "etsi-domain-identity-and-trust" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:decentralised-identity,
        ngm:did-nostr-identity,
        ngm:verifiable-credentials .

ngm:etsi-domain-security-and-privacy a owl:Class ;
    rdfs:label "ETSI Domain Security and Privacy"@en ;
    rdfs:comment "The ETSI Domain Security and Privacy is a governance framework protecting metaverse ecosystems through comprehensive controls spanning cryptography, access management, data governance, and compliance measures. It addresses threat surface mapping, post-quantum cryptographic resilience, privacy-enhancing computation, digital evidence chain of custody, and psychological profiling safeguards for users of immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-surface-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-trust-architecture-zta ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-enhancing-computation-pec ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-quantum-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-layer ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:post-quantum-cryptography,
        ngm:privacy-impact-assessment,
        ngm:security-layer,
        ngm:threat-surface-map ;
