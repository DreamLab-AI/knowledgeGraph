ngm:usability a owl:Class ;
    rdfs:label "Usability"@en ;
    rdfs:comment "Usability is the extent to which a product, system, or service can be used by specified users to achieve specified goals with effectiveness, efficiency, and satisfaction in a specified context of use, as defined by ISO 9241-11. It is a core quality attribute in human-computer interaction and user-centred design that encompasses learnability, memorability, error prevention, and user satisfaction. Usability is measured empirically through user testing, heuristic evaluation, and cognitive walkthroughs, and is distinct from—yet prerequisite to—broader user experience concerns. Poor usability results in task failure, user frustration, abandonment, and safety risks in safety-critical systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-analysis ],
        ngm:user-experience ;
    vc:bridgesTo ngm:explainability,
        ngm:human-robot-interaction,
        ngm:spatial-user-interfaces ;
    vc:dependsOn ngm:information-architecture,
        ngm:interaction-design ;
    vc:enables ngm:accessibility,
        ngm:task-completion,
        ngm:user-adoption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:efficiency,
        ngm:user-satisfaction ;
    vc:implements ngm:heuristic-evaluation,
        ngm:user-centred-design ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:user-experience ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:affordance,
