    vc:sourceDomain "robotics" .

ngm:identity-verification a owl:Class ;
    rdfs:label "Identity Verification"@en ;
    rdfs:comment "Identity Verification (IDV, often used interchangeably with identity proofing for the one-time onboarding event) is the trust-establishment process by which a relying party tests an identity claim — that a specific natural person or legal entity is who they purport to be — by collecting evide..."@en ;
