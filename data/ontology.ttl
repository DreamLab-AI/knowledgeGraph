    vc:contrastsWith ngm:turtle ;
    vc:enables ngm:data-integrity ;
    vc:enables ngm:knowledge-graph ;
    vc:enables ngm:ontology ;
    vc:enables ngm:structured-data ;
    vc:enables ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:linked-data ;
    vc:implements ngm:rdf ;
    vc:implements ngm:semantic-web-linked-data-standard ;
