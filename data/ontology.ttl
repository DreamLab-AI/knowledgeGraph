ngm:op-stack a owl:Class ;
    rdfs:comment "The OP Stack is an open-source, modular software framework, originally developed for Optimism, used to deploy and operate Ethereum layer-2 networks built on the optimistic rollup model. It standardises the components of a rollup chain, including the sequencer, derivation pipeline, fault-proof system, and bridge contracts, so that many independent chains can share a common technical foundation. Chains built on it interoperate as a federation often described as a superchain."@en ;
    rdfs:label "Op Stack"@en ;
    rdfs:subClassOf ngm:optimistic-rollup ;
