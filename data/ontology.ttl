    vc:sourceDomain "finance" ;
    vc:uses ngm:behavioral-analytics,
        ngm:predictive-analytics,
        ngm:recommendation-engine .

ngm:aes-gcm a owl:Class ;
    rdfs:label "AES-GCM"@en ;
    rdfs:comment "AES-GCM (Advanced Encryption Standard – Galois/Counter Mode) is an authenticated encryption with associated data (AEAD) cipher mode that combines the AES block cipher operating in Counter Mode with the Galois Message Authentication Code. It provides both confidentiality and data integrity in a single pass, making it the dominant symmetric encryption scheme in modern secure communications."@en ;
    rdfs:subClassOf ngm:symmetric-encryption ;
    vc:enables ngm:end-to-end-encryption,
        ngm:network-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:cryptography ;
    vc:slug "aes-gcm" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:message-authentication-code,
        ngm:nonce .

ngm:agent-to-agent-protocol a owl:Class ;
    rdfs:label "Agent-to-Agent Protocol"@en ;
    rdfs:comment "Agent-to-Agent Protocol is a class of communication specifications that define how autonomous AI agents discover one another, advertise capabilities, delegate tasks, and exchange results directly — without requiring a centralised broker — enabling peer-to-peer coordination between agents built by different organisations or on different frameworks. These protocols treat agents as first-class addressable entities with discoverable skill sets and negotiable service contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifier ],
        ngm:agent-communication-protocol ;
    vc:bridgesTo ngm:microservices-architecture,
        ngm:web-of-things ;
    vc:contrastsWith ngm:centralised-orchestration,
        ngm:remote-procedure-call ;
    vc:dependsOn ngm:autonomous-agent,
        ngm:large-language-model ;
    vc:enables ngm:agentic-workflow,
        ngm:capability-negotiation,
        ngm:decentralised-multi-agent-system,
        ngm:inter-agent-communication,
        ngm:task-delegation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:agent2-agent-protocol-google-2025,
        ngm:fipa-acl ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:model-context-protocol,
        ngm:multi-agent-framework,
        ngm:prompt-injection ;
    vc:requires ngm:authorisation-scope,
        ngm:decentralised-identifier,
        ngm:mutual-authentication ;
    vc:slug "agent-to-agent-protocol" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:foundation-for-intelligent-physical-agents ;
    vc:uses ngm:agent-card,
        ngm:json-ld,
        ngm:message-passing,
        ngm:service-discovery .

ngm:agent2-agent-protocol a owl:Class ;
    rdfs:label "Agent2Agent Protocol"@en ;
    rdfs:comment "Agent2Agent Protocol (A2A) is an open specification developed by Google and partner organisations that enables heterogeneous AI agents to discover, communicate, and collaborate across organisational and platform boundaries. It defines a standardised messaging envelope, capability advertisement mechanism, and task-delegation schema so that agents built on different frameworks — such as LangChain, CrewAI, or custom enterprise systems — can interoperate without bespoke integration code. The protocol operates over HTTPS with JSON-RPC 2.0 and supports both synchronous request-response and asynchronous streaming via Server-Sent Events. Agent capability cards, analogous to service discovery manifests, allow an agent to advertise its skills so that orchestrating agents can route work appropriately."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:bridgesTo ngm:interoperability-protocol ;
    vc:enables ngm:agentic-workflow,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:multi-agent-systems,
        ngm:server-sent-events ;
    vc:slug "agent2-agent-protocol" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:model-context-protocol,
        ngm:rest-api .

ngm:agricultural-robotics a owl:Class ;
    rdfs:label "Agricultural Robotics"@en ;
    rdfs:comment "Agricultural robotics is the engineering discipline concerned with the design, deployment, and operation of autonomous and semi-autonomous robotic systems applied to crop and livestock farming tasks, including soil preparation, precision planting, selective harvesting, agrochemical application, irrigation management, and herd monitoring. These systems integrate computer vision, machine learning, GNSS positioning, and mechatronic manipulation to function reliably in unstructured outdoor environments subject to variable terrain, lighting, weather, and biological variability. The field is a primary enabler of precision agriculture, supporting reductions in agrochemical inputs, labour dependency, and resource waste while maintaining or increasing yields. Commercial deployment spans ground-based field robots, unmanned aerial vehicles, and autonomous underwater and amphibious systems for aquaculture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mobile-robot-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:autonomous-robot ;
    vc:bridgesTo ngm:data-analytics,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:industrial-robotics ;
    vc:dependsOn ngm:deep-learning,
        ngm:edge-computing ;
    vc:enables ngm:crop-monitoring,
        ngm:precision-agriculture,
        ngm:variable-rate-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:end-effector,
        ngm:mobile-robot-platform,
        ngm:vision-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:internet-of-things,
        ngm:remote-sensing,
        ngm:swarm-robotics ;
    vc:requires ngm:autonomous-navigation,
        ngm:object-detection,
        ngm:path-planning,
        ngm:sensor-fusion ;
    vc:slug "agricultural-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:lidar,
        ngm:machine-learning,
        ngm:robotic-arm,
        ngm:rtk-gps,
        ngm:unmanned-aerial-vehicle .

ngm:ai-accelerator a skos:Concept ;
    rdfs:label "AI Accelerator"@en .

ngm:ai-chips a owl:Class ;
    rdfs:label "AI Chips"@en ;
    rdfs:comment "AI Chips are specialized processors optimized for the massively parallel linear-algebra workloads of machine-learning training and inference, including GPUs, TPUs, NPUs, and custom ASICs. They deliver high throughput on matrix and tensor operations through wide SIMD execution, high-bandwidth memory, and reduced-precision arithmetic. Control over advanced AI-chip design and fabrication has become a strategic axis of geopolitical and commercial competition."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:competition-in-ai,
        ngm:hardware ;
    vc:slug "ai-chips" ;
    vc:sourceDomain "infrastructure" .

ngm:ai-generated-content-disclosure a owl:Class ;
    rdfs:label "AI-Generated Content Disclosure"@en ;
    rdfs:comment "Mandatory transparency requirement specifying that content created wholly or partially by AI systems must be explicitly labeled with origin metadata for user awareness and regulatory compliance."@en ;
