ngm:ai-avatars a owl:Class ;
    rdfs:label "AI Avatars"@en ;
    rdfs:comment "\"Virtual representations of human users generated and animated by artificial intelligence systems, employing machine learning models to synthesise photorealistic appearance, facial expressions, body movements, and speech from sensor inputs or user intentions, enabling realistic telepresence witho..."@en ;
