ngm:linked-data-encoder a owl:Class ;
    rdfs:label "Linked Data Encoder"@en ;
    rdfs:comment "A semantic encoding pipeline that transforms agent state, credentials, events, and metadata into JSON-LD 1.1 format using pinned, versioned JSON-LD Context|W3C JSON-LD contexts, enabling standardised Federation Surface|federation surfaces (S1–S11) that are queryable, linkable, and mac..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
