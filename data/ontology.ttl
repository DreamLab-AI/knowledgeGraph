ngm:accountability-framework a owl:Class ;
    rdfs:comment "An accountability framework is a structured set of principles, roles, processes, and controls that together define how responsibility for outcomes is assigned, tracked, and enforced within an organisation or system. It specifies who is answerable for decisions and actions, what evidence of responsible conduct must be maintained, and what redress or corrective measures apply when obligations are unmet. Accountability frameworks appear across governance, AI ethics, financial regulation, and public sector administration."@en ;
    rdfs:label "Accountability Framework"@en ;
    rdfs:subClassOf ngm:governance-framework ;
    rdfs:subClassOf _:r1018 ;
    rdfs:subClassOf _:r1019 ;
    vc:enables ngm:accountability-mechanism ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accountability ;
    vc:relatedTo ngm:regulatory-framework ;
    vc:requires ngm:audit ;
    vc:requires ngm:transparency ;
    vc:slug "accountability-framework" ;
    vc:sourceDomain "governance" .
ngm:accountability-mechanism a owl:Class ;
    rdfs:comment "An accountability mechanism is a specific procedural, technical, or institutional instrument through which an actor can be held answerable for their decisions and conduct—for example, an audit trail, an ombudsman process, an algorithmic impact assessment, or a public reporting obligation. Whereas an accountability framework defines the overall structure of responsibility, an accountability mechanism is the concrete tool that makes accountability operational within or across that framework."@en ;
    rdfs:label "Accountability Mechanism"@en ;
    rdfs:subClassOf ngm:accountability ;
    vc:enables ngm:compliance ;
    vc:enables ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:accountability-framework ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability ;
    vc:relatedTo ngm:regulatory-framework ;
    vc:slug "accountability-mechanism" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit-log ;
    vc:uses ngm:audit-trail .
ngm:accountability-oecd a owl:Class ;
    rdfs:comment "Organisations and individuals developing, deploying or operating AI systems should be accountable for their proper functioning in accordance with OECD AI Principles and applicable legal frameworks, based on their roles, context and ability to act."@en ;
    rdfs:label "Accountability (OECD)"@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    rdfs:subClassOf ngm:policy-framework ;
