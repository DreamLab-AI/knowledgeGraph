ngm:state-machine-replication a owl:Class ;
    rdfs:label "State Machine Replication"@en ;
    rdfs:comment "State Machine Replication (SMR) is a fault-tolerance and consistency technique in which multiple server replicas each maintain an identical deterministic state machine by processing the same totally-ordered sequence of client commands, ensuring that all correct replicas converge to the same state after executing every command. The approach was formalised by Leslie Lamport and later by Fred Schneider, and it provides the theoretical foundation for consensus protocols such as Paxos, Raft, and Viewstamped Replication. SMR simultaneously achieves high availability and strong consistency in the presence of crash or Byzantine failures by decoupling the agreement problem (ordering) from the execution problem (state transition). It is the core architectural abstraction underlying permissioned blockchains, cloud database replication, and coordination services such as Apache ZooKeeper."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:total-order-broadcast ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:log-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deterministic-execution ],
        ngm:distributed-computing ;
    vc:bridgesTo ngm:distributed-ai-training,
        ngm:smart-contract ;
    vc:contrastsWith ngm:eventual-consistency,
        ngm:replication ;
    vc:enables ngm:distributed-ledger,
        ngm:high-availability,
        ngm:linearizability,
        ngm:strong-consistency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:leader-election,
        ngm:log-replication ;
    vc:implements ngm:paxos,
        ngm:pbft,
        ngm:raft-consensus ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:cap-theorem,
        ngm:replication-protocol ;
    vc:requires ngm:consensus-mechanism,
        ngm:deterministic-execution,
        ngm:fault-tolerance,
        ngm:total-order-broadcast ;
    vc:slug "state-machine-replication" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain,
        ngm:coordination-layer,
        ngm:distributed-databases ;
    vc:uses ngm:quorum,
        ngm:state-machine .

ngm:supply-chain-traceability a owl:Class ;
    rdfs:label "Supply Chain Traceability"@en ;
    rdfs:comment "Supply chain traceability employs blockchain and smart contracts to create immutable, transparent records of a product's journey from origin through manufacturing, distribution, and final delivery, enabling verification of authenticity and regulatory compliance at each stage. Implementations track provenance, environmental conditions, and certifications, providing cryptographic proof of authenticity and preventing counterfeiting across food safety, pharmaceuticals, luxury goods, and circular-economy initiatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chain-of-custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance ],
        ngm:blockchain-application ;
