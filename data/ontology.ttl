    vc:relatedTo ngm:data-science,
        ngm:data-visualisation,
        ngm:predictive-analytics ;
    vc:requires ngm:data-cleaning,
        ngm:data-preprocessing ;
    vc:slug "exploratory-data-analysis" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:feature-engineering,
        ngm:unsupervised-learning ;
    vc:uses ngm:data-visualisation,
        ngm:dimensionality-reduction .

