    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:finance,
        ngm:parametric-insurance ;
    vc:requires ngm:risk-management ;
    vc:slug "insurance" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:governance ;
    vc:supports ngm:finance ;
    vc:uses ngm:predictive-analytics .

ngm:inter-blockchain-communication a owl:Class ;
    rdfs:label "Inter-Blockchain Communication"@en ;
    rdfs:comment "Inter-Blockchain Communication (IBC) is a standardised protocol that enables independent, sovereign blockchains to exchange data and transfer tokens trustlessly by verifying each other's consensus state. It defines transport, authentication and ordering semantics in which light clients on each chain verify the counterparty's headers, and relayers carry packets and acknowledgements between them. Originating in the Cosmos ecosystem, IBC provides a general-purpose interoperability layer for token transfers, cross-chain messaging and composable multi-chain applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-client ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:light-client ],
        ngm:cross-chain-interoperability ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:polkadot ;
    vc:enables ngm:atomic-swap,
        ngm:decentralized-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:light-client,
        ngm:message-passing ;
    vc:implements ngm:cross-chain-interoperability ;
    vc:isPartOf ngm:cosmos,
        ngm:interoperability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:on-chain-governance ;
    vc:requires ngm:consensus-mechanism,
        ngm:light-client ;
    vc:slug "inter-blockchain-communication" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:validator-set ;
    vc:uses ngm:cosmos-sdk,
        ngm:tendermint .

ngm:interactive-storytelling a owl:Class ;
    rdfs:label "Interactive Storytelling"@en ;
    rdfs:comment "Interactive Storytelling is a narrative form in which user choices, actions, or presence dynamically shape the progression, branching structure, or emotional arc of a story. In spatial computing contexts, it encompasses XR experiences, virtual worlds, and location-based entertainment where embodied interaction and spatial presence deepen narrative immersion beyond passive media consumption."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:avatar,
