ngm:address a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "A blockchain Address is a compact, human-transmissible identifier derived from a public key via cryptographic hashing (typically SHA-256 followed by RIPEMD-160 for Bitcoin, or Keccak-256 for Ethereum), which designates the recipient or controller of blockchain funds or smart-contract state. Addresses function as pseudonymous identifiers: they reveal nothing about the owner's real identity while allowing cryptographic proof of ownership through digital signature with the corresponding private key. They are encoded in formats such as Base58Check (Bitcoin legacy), Bech32 (Bitcoin native SegWit), or hexadecimal with EIP-55 checksum (Ethereum)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-graph-publication-classifier-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-transaction,
        ngm:digital-identity,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:account-model,
        ngm:digital-wallet,
        ngm:hash-function,
        ngm:secp256k1,
        ngm:utxo-model ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:knowledge-graph-publication-classifier-key-cryptography ;
    vc:slug "address" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature,
        ngm:knowledge-graph-publication-classifier-key,
        ngm:private-key .

ngm:addressing-scheme a owl:Class ;
    rdfs:label "Addressing Scheme"@en ;
    rdfs:comment "An addressing scheme is a systematic convention for assigning, structuring, and resolving identifiers that locate resources, nodes, or content within a namespace. Schemes range from hierarchical and human-readable forms such as IP addresses and URLs to flat cryptographic forms such as content hashes and public-key fingerprints. The defining properties of an addressing scheme are its uniqueness guarantees, its resolution mechanism, and whether addresses are location-based, identity-based, or content-derived. Addressing schemes underpin routing, naming, and reference integrity across networked and decentralised systems."@en ;
    rdfs:subClassOf ngm:technique ;
    vc:enables ngm:content-identifier ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:decentralised-identifier ;
    vc:slug "addressing-scheme" ;
    vc:sourceDomain "infrastructure" .

ngm:ade20-k a owl:Class ;
    rdfs:label "ADE20K"@en ;
    rdfs:comment "ADE20K is a large-scale image segmentation dataset containing over 25,000 images annotated with 150 semantic categories covering both indoor and outdoor scenes, released by MIT's Computer Science and Artificial Intelligence Laboratory (CSAIL) in 2017. It provides pixel-level semantic, instance, and part-level annotations that enable training and benchmarking of scene parsing and semantic segmentation models. ADE20K serves as the foundational benchmark for the ImageNet Scene Parsing Challenge and has driven significant advances in dense prediction architectures."@en ;
    rdfs:subClassOf ngm:benchmarks ;
    vc:enables ngm:instance-segmentation,
        ngm:panoptic-segmentation,
        ngm:semantic-segmentation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:coco-dataset,
        ngm:image-segmentation ;
    vc:slug "ade20-k" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:data-annotation .

