        ngm:natural-language-processing ;
    vc:slug "search-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:large-language-model,
        ngm:machine-learning,
        ngm:pagerank,
        ngm:vector-search .

ngm:security-audit a owl:Class ;
    rdfs:label "Security Audit"@en ;
    rdfs:comment "A security audit is a systematic evaluation of a system's controls, configurations, and code against security requirements and threats. It combines techniques such as code review, configuration assessment, penetration testing, and control verification to identify vulnerabilities and compliance gaps. Audits produce evidence and remediation guidance used to reduce risk and demonstrate assurance."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-data-management-security,
        ngm:threat-surface-map ;
    vc:slug "security-audit" ;
    vc:sourceDomain "security" .

ngm:security-token-offering a owl:Class ;
    rdfs:label "Security Token Offering"@en ;
    rdfs:comment "A Security Token Offering (STO) is a regulated capital-raising mechanism in which blockchain-based digital tokens representing ownership rights, equity interests, debt obligations, revenue participation, or other financial entitlements are issued and sold to investors in compliance with applicable securities law. STOs require issuers to satisfy jurisdictional regulatory frameworks — such as the SEC's Regulation D or Regulation S exemptions in the United States, or MiFID II and EU prospectus rules in Europe — including investor accreditation verification, Know Your Customer and Anti-Money Laundering checks, and mandatory disclosure obligations. Unlike Initial Coin Offerings, which frequently issued utility tokens, STOs embed compliance logic directly into programmable smart contracts on distributed ledger platforms, automating transfer restrictions, cap-table management, and dividend or interest distributions. The STO model bridges traditional capital markets infrastructure with blockchain-based asset tokenisation, enabling fractional ownership of previously illiquid assets such as real estate, private equity, and infrastructure funds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralized-autonomous-organization ;
    vc:contrastsWith ngm:initial-coin-offering,
        ngm:initial-dex-offering,
        ngm:initial-public-offering ;
    vc:enables ngm:asset-tokenization,
        ngm:fractional-ownership,
        ngm:programmable-compliance,
        ngm:secondary-market-trading ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:capital-markets,
        ngm:decentralized-finance,
        ngm:digital-asset,
        ngm:token-offering,
        ngm:tokenomics ;
    vc:requires ngm:anti-money-laundering,
        ngm:financial-regulation,
        ngm:identity-verification,
        ngm:investor-accreditation,
        ngm:know-your-customer,
        ngm:regulatory-compliance ;
    vc:slug "security-token-offering" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:erc-1400,
        ngm:erc-3643 ;
    vc:uses ngm:digital-wallet,
        ngm:distributed-ledger-technology,
        ngm:security-token,
        ngm:smart-contract .

ngm:single-use-seals a owl:Class ;
    rdfs:label "Single Use Seals"@en ;
    rdfs:comment "A single-use seal is a cryptographic primitive, proposed by Peter Todd in 2016, that is a uniquely identifiable object which can be closed over ('sealed to') a message exactly once, producing a publicly verifiable proof that the seal was closed over that specific message and no other. The canonical implementation uses a Bitcoin UTXO as the seal: because the consensus rules permit each UTXO to be spent only once, the transaction that spends it can commit to exactly one message, giving a tamper-evident, non-equivocable 'open once' guarantee. Single-use seals, combined with proof of publication, form the foundation of client-side validation and underpin Bitcoin smart-contract systems such as RGB and primitives such as Block Trails."@en ;
    rdfs:subClassOf ngm:cryptographic-commitment ;
    vc:bridgesTo ngm:schnorr-signature,
        ngm:taproot ;
    vc:contrastsWith ngm:on-chain-validation ;
    vc:dependsOn ngm:double-spending,
        ngm:proof-of-publication ;
    vc:enables ngm:block-trails,
        ngm:client-side-validation,
        ngm:rgb-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:lightning-network,
        ngm:provenance-tracking,
        ngm:rgb-and-client-side-validation,
        ngm:taproot-assets ;
    vc:slug "single-use-seals" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-network,
        ngm:cryptographic-commitment,
        ngm:utxo-model .

ngm:snapshot a owl:Class ;
    rdfs:label "Snapshot"@en ;
    rdfs:comment "Snapshot is an off-chain governance platform that lets token holders and decentralised autonomous organisations vote on proposals without paying on-chain transaction fees. Votes are signed cryptographically with a wallet and weighted according to token holdings recorded at a chosen block height, then aggregated and stored on the InterPlanetary File System. Because voting is gasless and non-binding at the protocol level, results are typically executed separately by multisignature wallets or on-chain modules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ipfs ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20-token-standard ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:distributed-storage ;
    vc:contrastsWith ngm:compound-governance,
        ngm:on-chain-voting ;
    vc:dependsOn ngm:blockchain-wallet,
        ngm:smart-contract ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:on-chain-governance,
        ngm:quadratic-voting,
        ngm:token-weighted-voting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-proposal,
        ngm:voting-strategy ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aragon,
        ngm:tally ;
    vc:requires ngm:cryptographic-signature,
        ngm:erc-20-token-standard,
        ngm:ethereum-smart-contract-platform,
        ngm:ipfs ;
    vc:slug "snapshot" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-governance,
        ngm:token-delegation ;
    vc:uses ngm:blockchain-block,
        ngm:gnosis-safe,
        ngm:multisignature-wallet .

ngm:social-network-analysis a owl:Class ;
    rdfs:label "Social Network Analysis"@en ;
    rdfs:comment "Social network analysis (SNA) is a methodology for studying social structures through graph-theoretic and statistical techniques applied to networks of actors (nodes) and their relationships (edges). It measures structural properties such as centrality, clustering, path length, and community structure to identify influential actors, information bottlenecks, and emergent communities within social systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        ngm:network-analysis ;
    vc:bridgesTo ngm:epidemiological-modelling,
        ngm:graph-neural-network,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:ego-network-analysis,
        ngm:survey-based-social-research ;
    vc:enables ngm:anomaly-detection,
        ngm:community-detection,
        ngm:influence-maximisation,
        ngm:information-diffusion-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:betweenness-centrality,
        ngm:clustering-coefficient,
        ngm:scale-free-network,
        ngm:small-world-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computational-social-science,
        ngm:link-prediction,
        ngm:network-science,
        ngm:social-network-graph ;
    vc:requires ngm:graph-data-structure,
        ngm:network-topology ;
    vc:slug "social-network-analysis" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:adjacency-matrix,
        ngm:centrality-measures,
        ngm:community-detection,
        ngm:graph-theory,
        ngm:statistical-inference .

ngm:stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    rdfs:comment "Any individual, group, organisation, or entity that has an interest in, is affected by, influences, or holds rights regarding an artificial intelligence system throughout its lifecycle, including those who develop, deploy, operate, use, regulate, are impacted by, or hold accountability for AI sys..."@en ;
