        ngm:smart-contract-compliance ;
    vc:contrastsWith ngm:insider-trading,
        ngm:market-manipulation,
        ngm:surveillance-capitalism ;
    vc:dependsOn ngm:blockchain-analytics,
        ngm:regulatory-authority ;
    vc:enables ngm:capital-formation,
        ngm:consumer-protection,
        ngm:financial-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:disclosure-requirements,
        ngm:enforcement-mechanism,
        ngm:trade-surveillance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-market,
