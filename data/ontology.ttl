ngm:decentraland a owl:Class ;
    rdfs:label "Decentraland"@en ;
    rdfs:comment "Decentraland is a blockchain-based virtual world in which users own parcels of virtual land and in-world assets as non-fungible tokens on the Ethereum network, governed by a decentralised autonomous organisation through on-chain voting with governance tokens."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:non-fungible-token ],
        ngm:metaverse-platform ;
    vc:bridgesTo ngm:digital-twin,
        ngm:distributed-governance,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:roblox,
        ngm:the-sandbox ;
    vc:enables ngm:asset-tokenization,
        ngm:play-to-earn,
        ngm:social-vr,
        ngm:user-generated-content,
        ngm:virtual-land-ownership ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decentraland-marketplace,
        ngm:land-nft,
        ngm:mana-token ;
    vc:implements ngm:decentralized-autonomous-organization,
        ngm:erc-721 ;
    vc:isPartOf ngm:open-metaverse,
        ngm:web3-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:virtual-reality ;
    vc:requires ngm:cryptocurrency-wallet,
        ngm:ethereum,
        ngm:non-fungible-token,
        ngm:smart-contract ;
    vc:slug "decentraland" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum-smart-contract-platform,
        ngm:ipfs .

ngm:decentraland-marketplace a skos:Concept ;
    rdfs:label "Decentraland Marketplace"@en .

ngm:decentralisation-analysis a skos:Concept ;
    rdfs:label "Decentralisation Analysis"@en .

ngm:decentralisation-monitoring a skos:Concept ;
    rdfs:label "Decentralisation Monitoring"@en .

ngm:decentralised-access-control a skos:Concept ;
    rdfs:label "Decentralised Access Control"@en .

ngm:decentralised-agent-coordination a skos:Concept ;
    rdfs:label "Decentralised Agent Coordination"@en .

ngm:decentralised-agentic-infrastructure-stack a owl:Class ;
    rdfs:label "Decentralised Agentic Infrastructure Stack"@en ;
    rdfs:comment "A convergent set of nascent and rapidly maturing technologies—including decentralised identity, linked data, nostr key-pair agents, lightning-network micropayments, and knowledge graph tooling—that together enable a new paradigm of interoperable, agent-driven digital infrastructure. The stack combines protocol-level primitives with knowledge management and collaborative AI to support autonomous, verifiable workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identity-did ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linked-data ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:agentic-ai,
        ngm:version-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralized-identity-did,
        ngm:knowledge-graph,
        ngm:linked-data ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:interoperability ;
    vc:slug "decentralised-agentic-infrastructure-stack" ;
    vc:sourceDomain "infrastructure" .

ngm:decentralised-application-ecosystems a skos:Concept ;
