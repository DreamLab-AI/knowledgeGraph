    vc:slug "digital-real-estate" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-twin-technology a owl:Class ;
    rdfs:label "Digital Twin Technology"@en ;
    rdfs:comment "Digital Twin Technology is the discipline of constructing and operating persistent, synchronised virtual replicas of physical objects, systems, or environments that continuously ingest real-time sensor and telemetry data to mirror the state, behaviour, and lifecycle of their physical counterparts. Rooted in model-based engineering, it combines IoT connectivity, physics-based simulation, data analytics, and 3D visualisation to enable predictive maintenance, design optimisation, remote monitoring, and what-if scenario analysis without physical intervention. The technology spans the full asset lifecycle—from design and commissioning through operation and decommissioning—and underpins industrial metaverse platforms, smart-city infrastructure, and autonomous system validation. Standardisation efforts led by ISO/IEC JTC 1 and the Industrial Internet Consortium (IIC) are consolidating reference architectures and interoperability frameworks across vendor ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cyber-physical-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin-ecosystem ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:cyber-physical-systems ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:bim-virtual-model ;
    vc:enables ngm:autonomous-system,
        ngm:industrial-metaverse,
        ngm:metaverse,
        ngm:predictive-maintenance,
        ngm:smart-city ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-twin-ecosystem,
        ngm:digital-twin-framework,
        ngm:physics-simulation,
        ngm:sensor-fusion ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:cloud-computing,
        ngm:cyber-physical-systems,
        ngm:internet-of-things,
        ngm:real-time-streaming ;
    vc:slug "digital-twin-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-iec-jtc-1 ;
    vc:uses ngm:3-d-rendering,
        ngm:computer-vision,
        ngm:data-analytics,
        ngm:machine-learning .

ngm:direct-preference-optimization a owl:Class ;
    rdfs:label "Direct Preference Optimization"@en ;
    rdfs:comment "Direct Preference Optimization (DPO) is a preference-based language model alignment algorithm introduced by Rafael Rafailov, Archit Sharma, Eric Mitchell, Stefano Ermon, Christopher D."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bradley-terry-model ],
        ngm:ai-technique,
        ngm:generative-model,
        ngm:language-model-alignment ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:instruction-following,
        ngm:language-model-alignment,
        ngm:safety-and-alignment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bradley-terry-model,
        ngm:preference-dataset,
        ngm:reference-policy ;
    vc:implements ngm:maximum-likelihood-estimation ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai-training-methodology,
        ngm:kto,
        ngm:rlhf ;
    vc:requires ngm:cross-entropy-loss,
        ngm:gpu-compute,
        ngm:stochastic-gradient-descent ;
    vc:slug "direct-preference-optimization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iclr,
        ngm:icml,
        ngm:neur-ips ;
    vc:supports ngm:constitutional-ai-training-methodology ;
    vc:uses ngm:adam-optimiser,
        ngm:gradient-accumulation,
        ngm:lo-ra,
        ngm:mixed-precision-training .

ngm:disparate-impact a owl:Class ;
    rdfs:label "Disparate Impact"@en ;
    rdfs:comment "Disparate Impact is a legal doctrine and AI fairness concept denoting the condition where a facially neutral policy, practice, or algorithmic decision system produces outcomes that disproportionately disadvantage a legally protected group relative to a comparator group, regardless of discriminatory intent. Measured via the four-fifths rule or statistical significance tests, it is legally actionable in employment (US EEOC guidelines), lending, housing, and insurance, and is the analytical basis for algorithmic bias audits under the EU AI Act and GDPR. Remediation requires either demonstrating business necessity or adopting less discriminatory alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        ngm:ai-fairness,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness-accuracy-tradeoffs,
        ngm:group-vs-individual-fairness ;
    vc:enables ngm:algorithmic-accountability,
        ngm:fairness-auditing-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:harmful-bias,
        ngm:intersectional-fairness,
        ngm:regulatory-compliance ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-metrics ;
    vc:slug "disparate-impact" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:display-calibration a owl:Class ;
    rdfs:label "Display Calibration"@en ;
    rdfs:comment "Display calibration is the process of measuring and adjusting a display device's photometric and colorimetric characteristics—luminance, white point, gamma or EOTF, and colour gamut—to conform to a defined target standard or ICC colour profile. It employs colorimetric measurement instruments (colorimeters, spectrophotometers) to sample the display output and generates correction data (LUTs or ICC profiles) applied by the operating system or display hardware to compensate for manufacturing variation and age-related drift. Calibration is mandatory in colour-critical workflows including digital cinema (DCI-P3), broadcast (Rec. 709, Rec. 2020), medical imaging, and visual effects production."@en ;
    rdfs:subClassOf ngm:calibration ;
    vc:enables ngm:photorealistic-rendering,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:display-hardware,
        ngm:display-technology,
        ngm:physically-based-rendering ;
    vc:slug "display-calibration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:calibration-equipment,
        ngm:calibration-standards,
        ngm:display-metrology,
        ngm:optical-calibration-target .

ngm:distributed-decision-making a owl:Class ;
    rdfs:label "Distributed Decision Making"@en ;
    rdfs:comment "Distributed decision making encompasses the full spectrum of collective and algorithmic processes by which multiple autonomous agents, nodes, organisations, or individuals arrive at binding or coordinating choices without relying on a single central authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conflict-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incentive-compatibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegation-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-mechanism ],
        ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:bridgesTo ngm:collective-intelligence,
