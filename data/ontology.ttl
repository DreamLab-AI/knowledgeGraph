ngm:meta-mask a owl:Class ;
    rdfs:label "MetaMask"@en ;
    rdfs:comment "MetaMask is a self-custodial software cryptocurrency wallet, distributed as a browser extension (Chrome, Firefox, Brave, Edge) and mobile application (iOS and Android), that enables users to manage Ethereum and EVM-compatible blockchain assets directly in the browser without handing custody of private keys to a third party. It implements the EIP-1193 provider standard to expose a JavaScript API that decentralised applications (dApps) use to request signatures and transactions, making it the de facto gateway through which most users access Web3 services. MetaMask stores an encrypted HD wallet (BIP-32/BIP-39) locally in the browser's secure storage and signs all transactions client-side before broadcasting them to the chosen network via JSON-RPC. Developed by ConsenSys and first released in 2016, it is the most widely adopted non-custodial wallet by active monthly users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip39 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-rpc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm-compatible-blockchain ],
        ngm:digital-wallet ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:coinbase-wallet,
        ngm:custodial-wallet ;
    vc:enables ngm:decentralised-application,
        ngm:decentralised-finance,
        ngm:nft-trading,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bip-32 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:gas-fee,
        ngm:smart-contract ;
    vc:requires ngm:bip39,
        ngm:ethereum,
        ngm:evm-compatible-blockchain,
        ngm:json-data-interchange-format-rpc ;
    vc:slug "meta-mask" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:erc-20-token-standard,
        ngm:erc-721-standard,
        ngm:hardware-wallet,
        ngm:self-custody ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:hierarchical-deterministic-wallet,
        ngm:seed-phrase .

