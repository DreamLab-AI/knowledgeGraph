    vc:slug "collective-governance" ;
    vc:sourceDomain "governance" .

ngm:colour-grading a owl:Class ;
    rdfs:label "Colour Grading"@en ;
    rdfs:comment "Colour grading is the post-production process of altering and enhancing the colour, contrast, and tonal qualities of a moving image or rendered frame to establish a consistent look and convey mood. It builds on basic colour correction — which neutralises exposure and white-balance errors — by applying creative adjustments such as curves, lift-gamma-gain controls, and secondary qualifiers that isolate specific hues or regions. In real-time rendering and virtual production the grade is frequently applied as a post-processing pass using look-up tables and tone-mapping operators so interactive scenes match the intended cinematic aesthetic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-rendering ],
        ngm:post-processing ;
    vc:enables ngm:photorealism,
        ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:colour-correction,
        ngm:tone-mapping ;
    vc:isPartOf ngm:film-production,
        ngm:post-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:physically-based-rendering ;
    vc:requires ngm:gpu-rendering,
        ngm:rendering ;
    vc:slug "colour-grading" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:hdr ;
    vc:uses ngm:shader,
        ngm:texture-mapping .

ngm:commercial-bank a owl:Class ;
    rdfs:label "Commercial Bank"@en ;
    rdfs:comment "A commercial bank is a deposit-taking financial institution that accepts deposits from the public, extends loans and provides payment and related financial services. Through lending against a fraction of its deposits it participates in money creation and the transmission of monetary policy. Commercial banks are central to retail and corporate finance and operate under prudential regulation and capital requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:basel-iii ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-coverage-ratio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lending-protocol ],
        ngm:monetary-system ;
    vc:contrastsWith ngm:central-bank,
        ngm:shadow-banking ;
    vc:dependsOn ngm:liquidity,
        ngm:monetary-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:lending-protocol,
        ngm:payment-system ;
    vc:implements ngm:monetary-policy-transmission ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:correspondent-banking,
        ngm:traditional-banking ;
    vc:requires ngm:basel-iii,
        ngm:liquidity-coverage-ratio ;
    vc:slug "commercial-bank" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:liquidity-provision,
        ngm:payment-settlement ;
    vc:uses ngm:digital-payment-system .

ngm:communication-theory a owl:Class ;
    rdfs:label "Communication Theory"@en ;
    rdfs:comment "Communication Theory provides the theoretical foundations for understanding how information, meaning, and social presence are transmitted and perceived in mediated communication contexts. Key frameworks include media richness theory, social presence theory, and theories of computer-mediated communication that directly inform the design of telecollaboration systems and collaborative technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-presence-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:media-richness-theory ],
        ngm:dc-communication,
        ngm:telecollaboration ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:media-richness-theory,
        ngm:social-presence-theory ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:social-presence,
        ngm:video-conferencing ;
    vc:slug "communication-theory" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:collaborative-systems-modality-technology,
        ngm:telecollaboration .

ngm:compliance-management a owl:Class ;
    rdfs:label "Compliance Management"@en ;
    rdfs:comment "Compliance Management is the systematic process by which organisations identify, assess, implement, and monitor adherence to applicable laws, regulations, standards, and internal policies. It encompasses the full lifecycle of obligation tracking, control design, evidence collection, and reporting to demonstrate that operational activities conform to required norms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
