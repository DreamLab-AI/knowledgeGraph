    vc:requires ngm:blockchain,
        ngm:distributed-systems ;
    vc:slug "persistence" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:interoperability,
        ngm:nft-ownership-proof .

ngm:personal-data-store a owl:Class ;
    rdfs:label "Personal Data Store"@en ;
    rdfs:comment "A Personal Data Store (PDS) is a user-controlled software system or vault that aggregates, stores, and selectively discloses an individual's personal data — including identity attributes, health records, behavioural logs, and transaction histories — under the direct control of the data subject. It enforces consent-based access through verifiable credentials and cryptographic authorisation mechanisms, enabling fine-grained, revocable sharing with third-party services. PDSs embody the principles of data sovereignty and privacy-by-design, decoupling data custody from service providers and restoring ownership to individuals. They serve as a foundational layer for interoperable digital identity ecosystems, federated personal AI assistants, and regulatory compliance with frameworks such as GDPR and CCPA."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authorisation ],
        ngm:data-management ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:federated-learning ;
    vc:contrastsWith ngm:centralised-database,
        ngm:data-brokers ;
    vc:enables ngm:data-marketplace,
        ngm:federated-identity,
        ngm:selective-disclosure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:digital-identity,
        ngm:personal-data,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:authentication,
        ngm:authorisation,
        ngm:data-portability ;
    vc:slug "personal-data-store" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:gdpr,
        ngm:solid,
        ngm:w3-c-did-core ;
    vc:supports ngm:consent-management,
        ngm:data-sovereignty,
        ngm:privacy-by-design,
        ngm:self-sovereign-identity ;
    vc:uses ngm:access-control,
        ngm:decentralized-identifiers,
        ngm:end-to-end-encryption,
        ngm:linked-data,
        ngm:verifiable-credentials .

ngm:policy-optimisation a owl:Class ;
    rdfs:label "Policy Optimisation"@en ;
    rdfs:comment "Policy optimisation is the process of searching over a parameterised space of decision-making policies to maximise a scalar objective, typically a cumulative reward signal in a reinforcement learning context. It encompasses both gradient-based methods such as proximal policy optimisation and gradient-free approaches such as evolutionary strategies, applied across discrete and continuous action spaces."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:enables ngm:deep-reinforcement-learning,
        ngm:reinforcement-learning-for-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:proximal-policy-optimisation ;
    vc:slug "policy-optimisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:reinforcement-learning-algorithm,
        ngm:reward-function,
        ngm:value-function .

ngm:polygon a owl:Class ;
    rdfs:label "Polygon"@en ;
    rdfs:comment "Polygon is a set of Ethereum scaling protocols and a development platform, originally launched as Matic Network in 2017 and rebranded to Polygon in 2021. It began as a proof-of-stake sidechain that runs in parallel to Ethereum and has expanded into zero-knowledge rollup technology, notably Polygon zkEVM, which executes Ethereum-compatible transactions with validity proofs. The architecture aims to offer lower fees and higher throughput while keeping compatibility with Ethereum tooling. The network's token, originally MATIC and migrating to POL, is used for staking and fees across Polygon chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-application,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:arbitrum,
        ngm:optimism,
        ngm:zk-sync ;
    vc:enables ngm:blockchain-interoperability,
        ngm:decentralised-finance,
        ngm:layer-2-scaling,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:rollup,
        ngm:zk-rollup ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:gas-fee,
        ngm:sidechain,
        ngm:token-standard ;
    vc:requires ngm:ethereum-smart-contract-platform,
        ngm:proof-of-stake,
        ngm:validator-node,
        ngm:zero-knowledge-proof ;
    vc:slug "polygon" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:staking,
        ngm:validity-proof .

ngm:pre-trained-model a owl:Class ;
    rdfs:label "Pre-Trained Model"@en ;
    rdfs:comment "A pre-trained model is a machine-learning model whose parameters have already been learned on a large, often general-purpose dataset, so that it can be reused as a starting point for downstream tasks. Rather than training from random initialisation, practitioners adapt the pre-trained weights through fine-tuning or use the model directly for inference, transferring learned representations to new problems. Pre-trained models underpin transfer learning and are the practical foundation of modern deep learning across language, vision and multimodal tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:big-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-supervised-learning ],
        ngm:foundation-model ;
    vc:bridgesTo ngm:large-language-model ;
    vc:dependsOn ngm:model-training,
        ngm:representation-learning ;
    vc:enables ngm:few-shot-learning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:machine-learning ;
    vc:requires ngm:big-data,
        ngm:self-supervised-learning ;
    vc:slug "pre-trained-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:fine-tuning,
        ngm:inference ;
    vc:uses ngm:embedding,
        ngm:neural-network .

ngm:prediction-markets a owl:Class ;
    rdfs:label "Prediction Markets"@en ;
    rdfs:comment "Prediction markets are exchanges where participants trade contracts whose payoff depends on the outcome of future events, so the market price reflects an aggregated probability estimate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        ngm:economics ;
    vc:enables ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:order-book ;
    vc:slug "prediction-markets" ;
    vc:sourceDomain "metaverse" .

ngm:predictive-personalization a owl:Class ;
    rdfs:label "Predictive Personalization"@en ;
    rdfs:comment "The use of machine learning models to anticipate individual user preferences and dynamically tailor content, recommendations, interfaces, and experiences before an explicit request is made. Systems combine behavioural analytics, user profiling, and predictive models to deliver contextually relevant personalisation at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
