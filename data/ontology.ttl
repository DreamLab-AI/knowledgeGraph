    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:NFT
] .

mv:PlayToEarnP2e rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GameFi
] .

mv:PlayToEarnP2e rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:Cryptocurrency
] .

# MetaverseOntologySchema
mv:Metaverseontologyschema a owl:Class ;
