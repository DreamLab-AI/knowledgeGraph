        ngm:tool-use .

ngm:python a owl:Class ;
    rdfs:label "Python"@en ;
    rdfs:comment "Python is a high-level, dynamically typed, interpreted programming language with a design philosophy emphasising code readability and the minimisation of syntactic ceremony. Its extensive standard library and the PyPI ecosystem of third-party packages—including NumPy, SciPy, Pandas, PyTorch, TensorFlow, and Scikit-learn—make it the dominant language for machine learning research, data science, and scientific computing. Python's combination of interactive development via Jupyter notebooks, a permissive licence, and first-class support in cloud ML platforms has made it the lingua franca of artificial intelligence development."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:programming-language ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning,
        ngm:machine-learning-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:python-and-py-torch ;
    vc:slug "python" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-framework .

ngm:python-runtime a owl:Class ;
    rdfs:label "Python Runtime"@en ;
    rdfs:comment "The Python runtime is the interpreter process and associated standard library environment responsible for compiling Python source to bytecode, executing that bytecode in a virtual machine, managing heap memory through reference-counting combined with a cyclic garbage collector, and resolving module imports via the package search path. CPython—the canonical C-language reference implementation—uses a Global Interpreter Lock (GIL) that serialises bytecode execution across threads, making multi-processing the preferred concurrency model for CPU-bound workloads. The Python runtime underpins the dominant AI/ML toolchain including PyTorch, TensorFlow, and the Hugging Face ecosystem, making its performance characteristics, extension mechanisms, and packaging conventions central concerns for AI infrastructure engineering."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:runtime-environment ;
    vc:slug "python-runtime" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
        ngm:model-training ;
    vc:uses ngm:machine-learning-framework,
        ngm:python .

ngm:rb-0023-degrees-of-freedom a owl:Class ;
    rdfs:label "rb 0023 degrees of freedom"@en ;
    rdfs:comment "Degrees of Freedom (DOF) in robotics denotes the number of independent parameters required to fully specify the configuration of a robot mechanism. Each revolute or prismatic joint contributes one DOF; a 6-DOF manipulator can achieve arbitrary position and orientation in three-dimensional space. The number of DOF constrains the robot's reachable workspace, its dexterity, and the complexity of its kinematic and dynamic models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0026-robot-joint ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0026-robot-joint ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0021-robot-kinematics,
        ngm:rb-0024-workspace,
        ngm:rb-0031-singularity,
        ngm:rb-0037-dexterity ;
    vc:slug "rb-0023-degrees-of-freedom" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0028-forward-kinematics,
        ngm:rb-0029-inverse-kinematics,
        ngm:rb-0036-resolution .

ngm:rb-0031-singularity a owl:Class ;
    rdfs:label "rb 0031 singularity"@en ;
    rdfs:comment "A kinematic singularity is a robot configuration in which the Jacobian matrix loses rank, causing the manipulator to lose one or more degrees of freedom in Cartesian space. At a singularity, certain end-effector motions become unachievable regardless of joint velocity magnitudes, and inverse kinematics solutions either vanish or require unbounded joint speeds. Singularity avoidance and singularity-robust inverse kinematics (via damped least-squares) are critical for safe, continuous robot motion, particularly near workspace boundaries and for wrist configurations of six-axis arms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0037-dexterity ;
    vc:dependsOn ngm:differential-kinematics,
        ngm:rb-0029-inverse-kinematics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0024-workspace,
        ngm:rb-0032-manipulability,
        ngm:robot-singularity ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:slug "rb-0031-singularity" ;
    vc:sourceDomain "robotics" .

ngm:rb-0041-inertia a owl:Class ;
    rdfs:label "rb 0041 inertia"@en ;
    rdfs:comment "In robotics, inertia refers to the resistance of a robot's links and payload to changes in motion, quantified by the inertia tensor for rotational dynamics and mass for translational dynamics. Accurate inertia modelling is essential for dynamic control, trajectory planning, and compliance with power-and-force-limiting safety requirements, because high inertia directly increases the impact forces during unintended contact."@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0033-payload ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0043-torque,
        ngm:rb-0045-acceleration,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics ;
    vc:slug "rb-0041-inertia" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0064-computed-torque-control,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0043-torque a owl:Class ;
    rdfs:label "rb 0043 torque"@en ;
    rdfs:comment "Torque is the rotational force applied about a joint axis, expressed in Newton-metres (N·m). In robot dynamics, joint torques are the primary control inputs that drive links through desired trajectories; torque limits constrain the feasible workspace and influence payload capacity, and torque sensing enables compliant and force-controlled interaction."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0041-inertia,
        ngm:rb-0044-velocity,
        ngm:rb-0045-acceleration,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0043-torque" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:servo-motor .

ngm:rb-0064-computed-torque-control a owl:Class ;
    rdfs:label "rb 0064 computed torque control"@en ;
    rdfs:comment "Computed torque control (CTC) is a model-based robot control strategy that uses the full inverse dynamics model of a manipulator to compute the joint torques required to follow a desired trajectory. By cancelling the nonlinear dynamics — including Coriolis, centripetal, and gravitational terms — CTC transforms the closed-loop system into a set of independent linear double-integrators, enabling simple PD outer-loop controllers to achieve high-accuracy tracking. Its effectiveness depends on the fidelity of the dynamic model and is sensitive to parameter uncertainty."@en ;
    rdfs:subClassOf ngm:model-based-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0056-impedance-control,
        ngm:rb-0061-nonlinear-control,
        ngm:rb-0062-model-predictive-control ;
    vc:slug "rb-0064-computed-torque-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0043-torque,
        ngm:rb-0048-pid-controller .

ngm:rb-0096-safeguarding a owl:Class ;
    rdfs:label "rb 0096 safeguarding"@en ;
    rdfs:comment "Safeguarding, in the context of collaborative and industrial robotics, refers to the ensemble of physical barriers, electronic devices, and procedural controls deployed to prevent hazardous contact between robots and humans. Safeguarding measures include hard guards, light curtains, safety zones, and monitored-stop functions, and are mandated by standards such as ISO 10218 and ISO/TS 15066. Effective safeguarding is complementary to inherent safe design: it mitigates residual risks that cannot be eliminated through power-and-force limiting or speed reduction alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-curtain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0095-safety-zone ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:light-curtain,
        ngm:rb-0090-emergency-stop,
        ngm:rb-0095-safety-zone ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0096-safeguarding" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:real-time-computation a owl:Class ;
    rdfs:label "Real-Time Computation"@en ;
    rdfs:comment "Real-time computation refers to computational processes that must produce correct outputs within specified, externally imposed time constraints—where the correctness of a result depends not only on its logical accuracy but on its delivery before a deadline. Hard real-time systems guarantee deadline satisfaction under all conditions, soft real-time systems tolerate occasional deadline misses, and firm real-time systems discard late results as worthless. Applications span industrial control, autonomous vehicles, robotics, financial trading, and interactive media. Real-time computation requires deterministic execution paths, bounded memory allocation, and often specialised hardware or operating system schedulers."@en ;
    rdfs:subClassOf ngm:real-time ;
    vc:enables ngm:control-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:latency,
        ngm:real-time-ai ;
    vc:slug "real-time-computation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:autonomous-system,
        ngm:digital-signal-processing ;
    vc:uses ngm:edge-computing,
        ngm:parallel-processing .

ngm:real-world-asset-tokenisation a owl:Class ;
    rdfs:label "Real-World Asset Tokenisation"@en ;
    rdfs:comment "Real-world asset tokenisation (RWA) is the process of issuing blockchain-based digital tokens that represent legally enforceable claims over physical or financial assets such as real estate, government bonds, private credit, or commodities. By encoding ownership rights and transfer rules in smart contracts, RWA tokenisation enables fractional ownership, 24/7 secondary-market liquidity, and automated compliance enforcement. The practice bridges traditional capital markets and decentralised finance, requiring regulatory alignment with securities law and robust oracle infrastructure to reflect off-chain asset valuations on-chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:decentralised-finance,
        ngm:liquidity-provision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:security-token ;
    vc:requires ngm:oracle-network,
        ngm:smart-contract ;
    vc:slug "real-world-asset-tokenisation" ;
    vc:sourceDomain "blockchain" .

ngm:recommendation-systems a owl:Class ;
    rdfs:label "Recommendation Systems"@en ;
    rdfs:comment "Recommendation Systems are information filtering systems that predict a user's preference for items—products, content, services—and surface the most relevant items from a large catalogue. They are categorised into collaborative filtering (leveraging the behaviour of similar users), content-based filtering (matching item attributes to user profiles), and hybrid approaches that combine both. Modern large-scale recommendation systems employ deep learning architectures, embedding models, and two-tower neural networks trained on implicit feedback signals such as clicks, watch-time, and purchases. Recommendation systems are among the highest-impact machine learning applications in commercial technology, driving substantial fractions of revenue at platforms such as Netflix, Amazon, YouTube, and Spotify, while also raising significant concerns about filter bubbles, engagement maximisation harms, and algorithmic amplification of misinformation."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:enables ngm:hyper-personalisation,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:embedding-model,
        ngm:machine-learning-model,
        ngm:recommendation-engine ;
    vc:slug "recommendation-systems" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:graph-neural-network,
        ngm:machine-learning-pipeline .

ngm:recursive-self-improvement a owl:Class ;
    rdfs:label "Recursive Self-Improvement"@en ;
    rdfs:comment "Recursive self-improvement (RSI) is a theoretical AI capability in which a system autonomously identifies and implements modifications to its own architecture, training procedure, or objective function that result in increased performance or capability, such that each improvement cycle enables further improvements in a self-amplifying feedback loop. This process is conjectured to be a pathway to artificial superintelligence if left unconstrained, as successive capability doublings could occur faster than human oversight can track. RSI is a central concern in AI safety research because systems capable of recursive self-improvement may rapidly violate designers' assumptions about capability bounds and alignment properties."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-safety-research ;
    vc:enables ngm:self-improvement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:value-alignment ;
    vc:slug "recursive-self-improvement" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:regulatory-authority a owl:Class ;
    rdfs:label "Regulatory Authority"@en ;
    rdfs:comment "A regulatory authority is a government body, statutory agency, or delegated entity empowered by legislation to create, enforce, and adjudicate rules governing a specific industry, market, or domain of public concern. Such bodies possess the legal power to issue binding standards, licenses, and penalties; conduct inspections and investigations; and compel disclosures, all with the aim of protecting consumers, ensuring market integrity, managing systemic risk, or advancing public policy objectives. Regulatory authorities operate at national, supranational, and sub-national levels and are increasingly engaged with digital markets, artificial intelligence, financial technology, and emerging technology sectors."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:regulatory-reporting,
        ngm:regulatory-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:financial-regulation,
        ngm:regulatory-compliance,
        ngm:regulatory-framework ;
    vc:slug "regulatory-authority" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compliance-monitoring,
        ngm:regulatory-technology .

ngm:residual-connection a owl:Class ;
    rdfs:label "Residual Connection"@en ;
    rdfs:comment "A neural network connection that adds the input of a layer directly to its output, forming a skip connection that enables stable gradient flow during backpropagation in very deep architectures. Residual connections mitigate the vanishing gradient problem and allow networks of hundreds of layers to be trained effectively, forming a foundational component of ResNet and Transformer architectures."@en ;
    rdfs:subClassOf ngm:neural-network-component ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:residual-network,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:activation-function,
        ngm:layer-normalisation ;
    vc:slug "residual-connection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation .

ngm:responsible-ai-principles a owl:Class ;
    rdfs:label "Responsible AI Principles"@en ;
    rdfs:comment "Foundational ethical commitments and normative guidelines governing AI system design, development, deployment, and monitoring to ensure beneficial, fair, and rights-respecting outcomes. Core principles—including fairness, transparency, accountability, privacy, safety, and human oversight—are operationalised through frameworks such as the OECD AI Principles, the EU Ethics Guidelines for Trustworthy AI, and UNESCO's Recommendation on the Ethics of AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-and-explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-fairness ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability,
        ngm:ai-alignment,
        ngm:ai-fairness,
        ngm:ai-safety,
        ngm:human-oversight,
        ngm:transparency-and-explainability ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:differential-privacy,
        ngm:explainability ;
    vc:slug "responsible-ai-principles" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:reward-distribution a owl:Class ;
    rdfs:label "Reward Distribution"@en ;
    rdfs:comment "Tokenomic mechanisms that calculate and allocate staking rewards, validator incentives, and participation benefits within blockchain networks through mathematically designed emission schedules and fee distribution protocols."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:tokenomics ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:network-participation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reward-distribution" ;
    vc:sourceDomain "spatial-computing" .

ngm:scaling-laws a owl:Class ;
    rdfs:label "Scaling Laws"@en ;
    rdfs:comment "Scaling Laws are empirical power-law relationships that describe how the held-out cross-entropy loss of large neural language models varies predictably as a function of three primary axes: the number of model parameters, the volume of training tokens, and the total compute budget measured in floating-point operations. Foundational work established that optimal allocation of a fixed compute budget requires roughly equal scaling of model size and training data, a result later refined by Chinchilla-style analyses. These laws guide architectural decisions, determine when to train versus when to scale, and enable cost projections for future model generations, making them central to modern AI infrastructure planning."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:dependsOn ngm:model-training,
        ngm:training-data ;
    vc:enables ngm:large-language-models,
        ngm:pre-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:parameter-count ;
    vc:slug "scaling-laws" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:scope-2-emissions a owl:Class ;
    rdfs:label "Scope 2 Emissions"@en ;
    rdfs:comment "Scope 2 Emissions are the indirect greenhouse gas emissions attributable to an organisation arising from the generation of purchased or acquired electricity, steam, heat, or cooling consumed in its operations, as defined by the GHG Protocol Corporate Standard. Although the physical emissions occur at the power plant or thermal facility, they are accounted for by the purchasing organisation because its demand drives that generation, making Scope 2 the primary decarbonisation lever for energy-intensive organisations such as data centres and manufacturers."@en ;
    rdfs:subClassOf ngm:environmental-sustainability ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:carbon-neutrality-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:ghg-protocol,
        ngm:scope-1-emissions,
        ngm:scope-3-emissions ;
    vc:slug "scope-2-emissions" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:renewable-energy,
        ngm:renewable-energy-certificates,
        ngm:sustainability-reporting .

ngm:screen-sharing a owl:Class ;
    rdfs:label "Screen Sharing"@en ;
    rdfs:comment "Screen sharing is the real-time capture and transmission of a computing device's visual display output — encompassing full-desktop, application-window, browser-tab, and mobile-device viewports — to one or more remote participants over a network, enabling synchronous visual communication of interf..."@en ;
