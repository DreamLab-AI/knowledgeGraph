ngm:gaze-awareness a owl:Class ;
    rdfs:label "Gaze Awareness"@en ;
    rdfs:comment "Gaze Awareness is the capability of a collaborative system to detect, track, and communicate where participants are directing their visual attention during a shared session. It enables collaborators to perceive mutual attention states — such as who is looking at whom, or what shared artefact is being observed — without explicit verbal indication. Gaze awareness is a foundational non-verbal cue that supports turn-taking, joint attention, and coordinated action in distributed teams."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:eye-contact-correction,
        ngm:immersive-collaboration ;
    vc:slug "gaze-awareness" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:gdpr-article-25 a owl:Class ;
    rdfs:label "GDPR Article 25"@en ;
    rdfs:comment "GDPR Article 25 sets out the obligation of data protection by design and by default, requiring controllers to embed privacy safeguards into processing systems and to minimise data collection from the outset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr ],
        ngm:data-protection ;
    vc:enables ngm:data-minimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gdpr ;
    vc:slug "gdpr-article-25" ;
    vc:sourceDomain "metaverse" .

