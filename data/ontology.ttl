ngm:customer-service-automation a owl:Class ;
    rdfs:label "Customer Service Automation"@en ;
    rdfs:comment "Customer Service Automation (CSA) is the systematic application of artificial intelligence, rule-based logic, and workflow orchestration to resolve customer enquiries, execute transactions, and manage service interactions without requiring continuous human agent involvement. It integrates conversational AI, intent classification, sentiment analysis, and retrieval-augmented generation with CRM platforms, ticketing systems, and enterprise knowledge bases to deliver contextually accurate, personalised responses at scale. Modern CSA pipelines increasingly use large language models as the generation backbone, enabling coherent multi-turn dialogue capable of handling nuanced, composite, or cross-channel queries. Effectiveness is measured by containment rate, first-contact resolution, and customer satisfaction metrics, with human-in-the-loop escalation pathways ensuring quality and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chatbot ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:business-process-automation ;
    vc:contrastsWith ngm:human-agent-assistance,
        ngm:rule-based-automation ;
    vc:dependsOn ngm:customer-relationship-management,
        ngm:dialogue-management,
        ngm:knowledge-base,
        ngm:retrieval-augmented-generation ;
    vc:enables ngm:intelligent-ticket-routing,
        ngm:omnichannel-support,
        ngm:self-service-portal ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chatbot,
        ngm:escalation-management,
        ngm:interactive-voice-response,
        ngm:virtual-agent ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-agent,
        ngm:robotic-process-automation,
        ngm:workflow-automation ;
    vc:slug "customer-service-automation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:conversational-ai,
        ngm:intent-classification,
        ngm:large-language-model,
        ngm:named-entity-recognition,
        ngm:natural-language-processing,
        ngm:sentiment-analysis .

ngm:cvpr a owl:Class ;
    rdfs:label "CVPR"@en ;
    rdfs:comment "CVPR (Conference on Computer Vision and Pattern Recognition) is the premier annual peer-reviewed academic conference for computer vision and pattern recognition research, co-sponsored by IEEE and the Computer Vision Foundation (CVF). It is consistently ranked among the most impactful venues in artificial intelligence, serving as the primary publication channel for breakthroughs in image recognition, object detection, semantic segmentation, generative modelling, video understanding, and 3D vision. The conference has been held annually since 1983 and its open-access proceedings, published through the CVF, represent a foundational evidence base for both academic research and applied AI development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:autonomous-driving,
        ngm:medical-image-analysis,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:arxiv-preprint ;
    vc:enables ngm:benchmark-standard,
        ngm:evaluation-metric,
        ngm:peer-review ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3d-reconstruction,
        ngm:generative-vision,
        ngm:image-classification,
        ngm:object-detection,
        ngm:semantic-segmentation,
        ngm:video-understanding ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aaai,
        ngm:academic-conference,
        ngm:eccv,
        ngm:iccv,
        ngm:iclr,
        ngm:icml,
        ngm:neurips ;
    vc:slug "cvpr" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:computer-vision-foundation,
        ngm:ieee ;
    vc:supports ngm:computer-vision,
        ngm:deep-learning,
        ngm:neural-architecture,
        ngm:pattern-recognition .

ngm:data-catalog a owl:Class ;
    rdfs:label "Data Catalog"@en ;
    rdfs:comment "A data catalog is a centralised, searchable inventory of an organisation's data assets enriched with metadata, descriptions, ownership and usage context. It enables discovery, governance and self-service analytics by indexing datasets, schemas and their relationships, often integrating glossaries and lineage. As a component of metadata management and data fabric architectures it is essential for finding and trusting data at scale."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
