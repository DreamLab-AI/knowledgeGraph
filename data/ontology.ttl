        ngm:display-server,
        ngm:foundation-model,
        ngm:function-calling,
        ngm:human-oversight,
        ngm:inference-compute,
        ngm:operating-system,
        ngm:tool-definition,
        ngm:vision-language-model ;
    vc:slug "computer-use-and-browser-agents" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:agent2-agent-protocol-google-2025,
        ngm:chrome-dev-tools-protocol,
