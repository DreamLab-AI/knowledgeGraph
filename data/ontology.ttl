    vc:isPartOf ngm:robot-perception ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robot-perception ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:requires ngm:feedback-control ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "proprioception" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:humanoid-robotics ;
    vc:supports ngm:robotic-manipulation ;
    vc:uses ngm:sensor-fusion .
ngm:proprioceptive-sensing a owl:Class ;
    rdfs:comment "Proprioceptive sensing is a robot's perception of its own internal state, such as joint angles, motor torques, link velocities, and body orientation, as distinct from exteroceptive sensing of the external environment. It relies on encoders, force/torque sensors, and inertial measurement units. It is essential for balance, whole-body control, and safe interaction, especially in legged and humanoid robots."@en ;
    rdfs:label "Proprioceptive Sensing"@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "proprioceptive-sensing" ;
    vc:sourceDomain "robotics" .
ngm:proprioceptive-sensor a owl:Class ;
    rdfs:comment "ProprioceptiveSensor is a transducer or sensing system that measures a robot's internal physical state — encompassing joint angle, angular velocity, linear and angular acceleration, motor torque, drive current, strain, and contact force — without reference to external landmarks or environmental f..."@en ;
    rdfs:label "Proprioceptive Sensor"@en ;
