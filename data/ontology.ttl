ngm:incident-response a owl:Class ;
    rdfs:label "Incident Response"@en ;
    rdfs:comment "Incident Response is the structured organisational process for detecting, containing, eradicating, and recovering from cybersecurity incidents, followed by post-incident analysis to prevent recurrence and strengthen defensive posture. It is operationalised through lifecycle models such as NIST SP 800-61 and the SANS PICERL framework (Preparation, Identification, Containment, Eradication, Recovery, Lessons Learned), enacted via security operations centre (SOC) playbooks, SIEM-driven detection pipelines, and SOAR-automated response actions. Effective incident response minimises dwell time—the interval between initial compromise and detection—limits lateral movement and data exfiltration, and satisfies regulatory notification obligations under frameworks such as GDPR and NIS2. AI-assisted triage, automated containment orchestration, and threat-intelligence enrichment have become defining characteristics of mature programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-intelligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-forensics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-detection ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:ai-anomaly-detection,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:threat-hunting,
        ngm:vulnerability-management ;
    vc:enables ngm:business-continuity,
        ngm:cyber-resilience,
        ngm:incident-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-forensics,
        ngm:incident-containment,
        ngm:post-incident-review,
        ngm:threat-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-breach,
        ngm:identity-and-access-management,
        ngm:information-security,
        ngm:network-security,
        ngm:vulnerability ;
    vc:requires ngm:security-information-and-event-management,
        ngm:security-operations-centre,
        ngm:threat-intelligence ;
    vc:slug "incident-response" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27035,
        ngm:nist-cybersecurity-framework ;
    vc:supports ngm:cybersecurity-standard,
        ngm:data-security,
        ngm:risk-management ;
    vc:uses ngm:ai-trust-risk-and-security-management,
        ngm:digital-forensics-framework,
        ngm:endpoint-detection-and-response,
        ngm:security-orchestration-automation-and-response,
        ngm:user-and-entity-behaviour-analytics .

ngm:parameter-efficient-fine-tuning a owl:Class ;
    rdfs:label "Parameter-Efficient Fine-Tuning"@en ;
    rdfs:comment "Training techniques that update only a small subset of model parameters during fine-tuning, reducing computational and memory requirements whilst maintaining comparable performance to full fine-tuning. PEFT methods enable adaptation of large models with limited resources by freezing most pre-trained weights and adding or modifying a minimal set of trainable parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prefix-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adapter-modules ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:qlo-ra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lo-ra-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-tuning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
