ngm:infrastructure-architecture a owl:Class ;
    rdfs:label "Infrastructure Architecture"@en ;
    rdfs:comment "The foundational technical framework supporting metaverse platforms, comprising cloud computing, edge networks, distributed systems, and computing power networks that enable scalable, low-latency delivery of immersive virtual experiences."@en ;
