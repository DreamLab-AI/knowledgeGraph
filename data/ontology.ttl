        ngm:vulnerability ;
    vc:slug "third-party-auditor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:blockchain,
        ngm:risk-assessment .

ngm:threat-surface-map a owl:Class ;
    rdfs:label "Threat Surface Map"@en ;
    rdfs:comment "A comprehensive security visualization and inventory framework that identifies, catalogs, and models all potential attack vectors, vulnerability exposure points, and threat entry paths across network, application, data, identity, and infrastructure layers of a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-scanner ],
        ngm:metaverse-and-spatial-risks,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:compliance-verification,
        ngm:incident-response,
        ngm:penetration-testing,
        ngm:risk-assessment,
        ngm:security-audit,
        ngm:security-posture-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:attack-vector-inventory,
        ngm:exposure-point-catalog,
        ngm:risk-assessment-matrix,
        ngm:security-control-mapping,
        ngm:threat-model,
        ngm:vulnerability-surface ;
    vc:isPartOf ngm:risk-management-framework,
        ngm:security-architecture,
        ngm:threat-intelligence-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:asset-inventory,
        ngm:network-topology,
        ngm:penetration-testing-tools,
        ngm:security-monitoring,
        ngm:vulnerability-scanner ;
    vc:slug "threat-surface-map" ;
    vc:sourceDomain "spatial-computing" .

ngm:tpu a owl:Class ;
    rdfs:label "TPU"@en ;
    rdfs:comment "Tensor Processing Unit — Google's custom ASIC optimised for the dense matrix multiplications that dominate neural network training and inference. TPUs use systolic arrays to achieve high throughput on 8-bit and 16-bit arithmetic at significantly lower energy per FLOP than general-purpose GPUs, and are available via Google Cloud as Cloud TPUs for large-scale model training."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:distributed-training,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:hardware-acceleration,
        ngm:npu ;
    vc:slug "tpu" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:model-training .

ngm:trade-finance a owl:Class ;
    rdfs:label "Trade Finance"@en ;
    rdfs:comment "Trade finance encompasses the financial instruments, products, and mechanisms that facilitate domestic and international commercial transactions by managing the payment, credit, and risk gap between exporter shipment and importer receipt. Core instruments include letters of credit, bank guarantees, documentary collections, supply chain financing, factoring, and forfaiting, all structured to give exporters payment certainty and importers time to generate revenue from goods before settling. Trade finance is a foundational segment of global banking, representing approximately $9 trillion in annual transaction volume, and is undergoing significant digitisation through blockchain-based platforms, electronic bills of lading, and smart contract automation."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:dependsOn ngm:compliance-framework,
        ngm:fatf,
        ngm:financial-regulation ;
    vc:enables ngm:customs-trade-facilitation,
        ngm:importer,
        ngm:supply-chain-management,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-border-payments,
        ngm:financial-instruments,
        ngm:payment-system,
        ngm:supply-chain,
        ngm:supply-chain-blockchain ;
    vc:slug "trade-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-asset-standards,
        ngm:logistics-optimization ;
    vc:uses ngm:aml-kyc-compliance,
        ngm:blockchain-application,
        ngm:cryptographic-verification,
        ngm:smart-contract,
        ngm:smart-contracts .

ngm:trajectory-tracking a owl:Class ;
    rdfs:label "Trajectory Tracking"@en ;
    rdfs:comment "Trajectory tracking is the control problem of causing a dynamical system—typically a robot, vehicle, or aerial platform—to follow a prescribed time-parameterised path through configuration space with minimal deviation. It couples a reference trajectory generated by a planner with a feedback controller that corrects errors arising from disturbances, model mismatch, and actuation limits. Trajectory tracking controllers range from classical PID and linear quadratic regulators to model predictive controllers and learning-based approaches. It is a central capability in mobile robotics, autonomous driving, drone flight, and industrial manipulator control."@en ;
    rdfs:subClassOf ngm:trajectory-control ;
    vc:dependsOn ngm:state-estimation,
        ngm:trajectory-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:trajectory-generation ;
    vc:slug "trajectory-tracking" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:model-predictive-control,
        ngm:motion-model,
        ngm:pid-controller .

ngm:transaction-processing a owl:Class ;
    rdfs:label "Transaction Processing"@en ;
    rdfs:comment "Transaction Processing encompasses the end-to-end lifecycle of blockchain transactions — from cryptographic signing and mempool propagation through validation, deterministic state execution, and finality confirmation. It includes parallelisation strategies, layer-2 scaling (state channels, rollups), and cross-chain atomic operations, with MEV mitigation and encrypted mempools addressing ordering fairness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain-transaction,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:decentralised-finance,
        ngm:payment-system,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "transaction-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:stablecoin,
        ngm:transaction-fee,
        ngm:transaction-pool .

ngm:tree-of-thoughts a owl:Class ;
    rdfs:label "Tree of Thoughts"@en ;
    rdfs:comment "Tree of Thoughts (ToT) is a deliberate reasoning framework for large language models that generalises linear chain-of-thought prompting into a tree-structured search over intermediate thought steps. At each node in the tree the model generates multiple candidate next-thoughts, evaluates their promise using an LLM-based heuristic, and selects branches to expand via breadth-first or depth-first search with backtracking. This framework enables systematic exploration of alternative reasoning paths and is particularly effective for tasks requiring combinatorial planning, mathematical proof construction, or multi-step problem-solving where greedy left-to-right decoding is insufficient."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:mathematical-reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought,
        ngm:monte-carlo-tree-search,
        ngm:prompt-engineering ;
    vc:slug "tree-of-thoughts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models .

ngm:trust-anchor a owl:Class ;
    rdfs:label "Trust Anchor"@en ;
    rdfs:comment "A trust anchor is an authoritative entity or cryptographic artifact that serves as the root of a chain of trust, providing the foundational level of trust from which all subsequent trust assertions in a system are derived. In public key infrastructure (PKI), the trust anchor is typically a root certificate authority (CA) whose self-signed certificate is pre-installed in operating systems and browsers as inherently trusted, enabling the validation of all subordinate certificate chains. In decentralised identity systems, trust anchors may be governance-designated issuers, DID-based root entities, or on-chain registries whose cryptographic material is considered authoritative for a particular trust domain. Trust anchors define the scope and boundaries of a trust framework and are the entities that must be trusted by all relying parties in the system."@en ;
    rdfs:subClassOf ngm:trust-framework ;
    vc:enables ngm:decentralized-identity,
        ngm:identity-federation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:cryptographic-verification,
        ngm:digital-certificate,
        ngm:trust-framework-policy ;
    vc:slug "trust-anchor" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-keys,
        ngm:digital-signature .

ngm:uk-online-safety-act a owl:Class ;
    rdfs:label "UK Online Safety Act"@en ;
    rdfs:comment "The UK Online Safety Act 2023 is landmark legislation that places statutory duties of care on platforms hosting user-generated content and search services, requiring them to identify, assess, and mitigate risks of illegal content and content harmful to children. It establishes Ofcom as the UK's internet regulator with powers to issue codes of practice, conduct audits, and levy fines of up to ten per cent of global annual turnover for non-compliance. The Act introduces mandatory age verification obligations, transparency reporting requirements, and provisions — controversially — concerning encrypted communications and client-side scanning."@en ;
    rdfs:subClassOf ngm:digital-regulation ;
    vc:enables ngm:age-verification,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:digital-services-act,
        ngm:online-safety-act-2023 ;
    vc:slug "uk-online-safety-act" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:user-safety ;
    vc:uses ngm:content-moderation-standards,
        ngm:regulatory-reporting .

ngm:uncertainty-quantification a owl:Class ;
    rdfs:label "Uncertainty Quantification"@en ;
    rdfs:comment "Uncertainty Quantification (UQ) is a discipline concerned with characterising, propagating, and communicating the uncertainties inherent in computational models, predictions, and measurements. It distinguishes between aleatoric uncertainty (irreducible randomness in the data or system) and epistemic uncertainty (reducible uncertainty arising from limited knowledge or data), providing principled methods — including Bayesian inference, Monte Carlo sampling, conformal prediction, and ensemble methods — for producing calibrated probability estimates rather than point predictions. UQ is foundational to trustworthy AI, safety-critical systems engineering, and scientific computing."@en ;
    rdfs:subClassOf ngm:probabilistic-model ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:model-robustness,
        ngm:risk-assessment,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:ensemble-methods,
        ngm:monte-carlo-methods,
        ngm:probabilistic-model ;
    vc:slug "uncertainty-quantification" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:interpretability,
        ngm:model-evaluation-results ;
    vc:uses ngm:calibration .

ngm:value-transfer a owl:Class ;
    rdfs:label "Value Transfer"@en ;
    rdfs:comment "The mechanism and process by which economic value, rights, or utility are exchanged between parties across physical, digital, and virtual domains, encompassing monetary systems, token-based systems, resource allocation, and rights transfer protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:barter-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resource-allocation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:money ],
        ngm:bc-defi-and-economics,
        ngm:cryptocurrency ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:commerce,
        ngm:economic-exchange,
        ngm:payment,
        ngm:settlement,
        ngm:trade ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:barter-system,
        ngm:digital-currency,
        ngm:money,
        ngm:resource-allocation,
        ngm:rights-transfer,
        ngm:token ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:transfer-protocol,
        ngm:trust-mechanism,
        ngm:value-representation ;
    vc:slug "value-transfer" ;
    vc:sourceDomain "blockchain" .

ngm:video-codec a owl:Class ;
    rdfs:label "Video Codec"@en ;
    rdfs:comment "A video codec (coder-decoder) is an algorithm or hardware implementation that compresses and decompresses digital video by exploiting spatial redundancy within frames (intra-prediction), temporal redundancy across frames (inter-prediction with motion compensation), and transform coding of residuals, enabling practical storage and transmission of video at bitrates orders of magnitude lower than uncompressed formats whilst maintaining perceptual quality."@en ;
    rdfs:subClassOf ngm:encoder-decoder-architecture ;
    vc:enables ngm:bandwidth-optimization,
        ngm:video-encoding,
        ngm:video-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:cdn ;
    vc:slug "video-codec" ;
    vc:sourceDomain "media" ;
    vc:standardizedBy ngm:compliance-standards ;
    vc:uses ngm:convolution,
        ngm:decoder,
        ngm:encoder .

ngm:video-compression a owl:Class ;
    rdfs:label "Video Compression"@en ;
    rdfs:comment "Video compression is the encoding of video data to reduce its size for storage and transmission while preserving acceptable quality. It exploits spatial, temporal and perceptual redundancy through codecs."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:content-delivery,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "video-compression" ;
    vc:sourceDomain "computing" .

ngm:video-encoding a owl:Class ;
    rdfs:label "Video Encoding"@en ;
    rdfs:comment "Video encoding is the process of compressing raw or lightly-compressed video frames into a deliverable bitstream using a video codec, encompassing decisions about encoding parameters (resolution, frame rate, bitrate mode, keyframe interval, codec profile and level), rate control algorithms, and hardware or software encoder selection to balance output quality, file size, and encoding speed for a given delivery target."@en ;
    rdfs:subClassOf ngm:video-codec ;
    vc:dependsOn ngm:compute-resources ;
    vc:enables ngm:bandwidth-adaptation,
        ngm:bandwidth-optimization,
        ngm:cdn ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:decoder ;
    vc:slug "video-encoding" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:encoder,
        ngm:video-processing .

ngm:virtual-classroom a owl:Class ;
    rdfs:label "Virtual Classroom"@en ;
    rdfs:comment "An online learning environment that replicates a traditional classroom's interactive experience without physical boundaries, leveraging education technology to connect students and instructors through real-time engagement, collaboration tools, and shared learning materials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration-platform ],
        ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:collaborative-learning,
        ngm:immersive-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:education-metaverse,
        ngm:education-technology ;
    vc:requires ngm:collaboration-platform,
        ngm:learning-management-system ;
    vc:slug "virtual-classroom" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-society a owl:Class ;
    rdfs:label "Virtual Society"@en ;
    rdfs:comment "An organised social structure emerging within virtual worlds and metaverse platforms, comprising the norms, governance mechanisms, economic systems, communities, and social interactions of persistent digital environments. Virtual societies exhibit properties analogous to physical societies — ownership, law, culture, and commerce — mediated through digital platforms, avatars, and blockchain-based economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-commerce ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:avatar,
        ngm:community-governance,
        ngm:virtual-economy,
        ngm:virtual-world ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-metaverse-commerce,
        ngm:decentralized-governance,
        ngm:virtual-world-platform ;
    vc:slug "virtual-society" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:community-standards,
        ngm:virtual-currency,
        ngm:virtual-environment .

ngm:warehouse-automation a owl:Class ;
    rdfs:label "Warehouse Automation"@en ;
    rdfs:comment "Warehouse automation is the deployment of robotic systems, autonomous mobile robots (AMRs), automated storage and retrieval systems (AS/RS), and AI-driven software orchestration to perform goods induction, storage, picking, sorting, packing, and despatch with minimal direct human intervention. It integrates perception systems for item identification and navigation, motion planning for collision-free path execution, and warehouse management system (WMS) integration for order orchestration. Modern warehouse automation architectures layer machine learning for demand forecasting and adaptive task scheduling on top of physical robotic fleets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:logistics-optimization,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "warehouse-automation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:mobile-robot .

ngm:wearable-computing-platform a owl:Class ;
    rdfs:label "Wearable Computing Platform"@en ;
    rdfs:comment "Hardware and software ecosystems for body-worn computing devices including smartwatches, smart glasses, fitness trackers, and XR headsets, providing operating systems, development frameworks, and connectivity infrastructure for continuous personal computing and metaverse interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wearable-device-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:xr-headset ],
        ngm:computing-platform,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
