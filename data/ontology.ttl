ngm:augmented-reality-collaboration a owl:Class ;
    rdfs:label "Augmented Reality Collaboration"@en ;
    rdfs:comment "\"Collaborative work where geographically distributed team members share a common augmented reality environment, viewing and manipulating virtual 3D objects overlaid on their respective physical spaces whilst communicating via spatial audio and holographic avatars, enabling hybrid physical-virtual..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-rtc ],
        ngm:dc-telepresence,
        ngm:telecollaboration-domain ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:collaborative-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:web-rtc ;
    vc:slug "augmented-reality-collaboration" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:authentication-system a owl:Class ;
    rdfs:label "Authentication System"@en ;
    rdfs:comment "An authentication system is an infrastructure component responsible for verifying the claimed identity of users, devices, or services before granting access to protected resources. It integrates credential management, identity verification workflows, session management, and integration with downstream access control mechanisms to enforce the principle that only legitimate principals can initiate authenticated sessions. Authentication systems range from simple password databases to federated multi-factor frameworks spanning organisational boundaries."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:decentralised-identity,
        ngm:identity-provider ;
    vc:slug "authentication-system" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-signature,
        ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:open-id-connect .

ngm:autonomous-behavior a owl:Class ;
    rdfs:label "Autonomous Behavior"@en ;
    rdfs:comment "The capacity of an agent, robot, or AI system to select and execute actions in pursuit of goals without continuous human instruction, using internal models of the world, perception of environmental state, and learned or programmed decision policies. Autonomous behaviour spans a continuum from simple reactive reflexes to deliberative planning over extended time horizons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:planning-module ],
        ngm:autonomous-operation ;
    vc:enables ngm:autonomous-agent,
        ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:behavioral-modeling,
        ngm:feedback-loop,
        ngm:goal ;
    vc:requires ngm:perception-system,
        ngm:planning-module ;
    vc:slug "autonomous-behavior" ;
    vc:sourceDomain "ai" .

ngm:avatar-animation a owl:Class ;
    rdfs:label "Avatar Animation"@en ;
    rdfs:comment "Avatar animation is the specialised subset of digital animation concerned with driving the motion and expression of user-controlled or AI-controlled avatar representations in real-time interactive environments. It encompasses full-body locomotion, facial expression synthesis, hand and gaze tracking, and upper-body gesture systems, all coordinated to produce social believability within virtual and extended reality spaces. Avatar animation systems must balance visual fidelity with low-latency responsiveness to maintain user embodiment and presence. Standards such as VRM and glTF define interchange formats that allow avatar animations to transfer across platforms."@en ;
    rdfs:subClassOf ngm:animation ;
    vc:enables ngm:immersive-experience,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:avatar-interoperability,
        ngm:avatar-system,
        ngm:virtual-reality ;
    vc:slug "avatar-animation" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:animation-retargeting,
        ngm:inverse-kinematics,
        ngm:motion-capture,
        ngm:vrm-format .

ngm:backup-and-recovery a owl:Class ;
    rdfs:label "Backup and Recovery"@en ;
    rdfs:comment "Backup and Recovery is the set of processes, technologies, and policies that ensure data and system state can be copied to a secondary store and restored to a known-good condition following data loss, corruption, or infrastructure failure. It encompasses full, incremental, and differential backup strategies alongside recovery time objectives (RTO) and recovery point objectives (RPO) that define acceptable loss and restoration windows."@en ;
    rdfs:subClassOf ngm:disaster-recovery ;
    vc:enables ngm:high-availability,
        ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:fault-tolerance ;
    vc:slug "backup-and-recovery" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-storage,
        ngm:data-replication .

ngm:barter-system a owl:Class ;
    rdfs:label "Barter System"@en ;
    rdfs:comment "A decentralized exchange mechanism enabling peer-to-peer trading of goods, services, or digital assets without monetary intermediaries, enhanced in digital contexts through blockchain-based matching algorithms and smart contracts that solve the traditional \"double coincidence of wants\" problem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-mechanism ],
        ngm:ai-governance-and-ethics,
        ngm:exchange-mechanism ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:asset-exchange,
        ngm:peer-to-peer-trading,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:matching-algorithm,
        ngm:smart-contracts,
        ngm:trust-mechanism ;
    vc:slug "barter-system" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:bim-software a owl:Class ;
    rdfs:label "BIM Software"@en ;
    rdfs:comment "Specialized applications for Building Information Modeling that enable the generation, management, and collaboration on digital representations of physical and functional characteristics of buildings and infrastructure, supporting the entire asset lifecycle from design through construction to ope..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
