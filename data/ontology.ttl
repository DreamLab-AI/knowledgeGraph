ngm:privacy-mechanism a owl:Class ;
    rdfs:label "Privacy Mechanism"@en ;
    rdfs:comment "A Privacy Mechanism is a technical method or protocol designed to preserve individuals' data privacy during data collection, processing, or publication. Examples include differential privacy, federated learning, and homomorphic encryption, each providing mathematically grounded guarantees against disclosure of sensitive information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
