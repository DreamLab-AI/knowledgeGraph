    vc:sourceDomain "metaverse" .

ngm:intelligent-npc a owl:Class ;
    rdfs:label "Intelligent NPC"@en ;
    rdfs:comment "An Intelligent NPC (Non-Player Character) is a virtual agent in a game, simulation, or metaverse environment whose behaviour is driven by AI systems — typically combining perception, reasoning, planning, and natural-language interaction — rather than purely scripted or rule-based finite state machines. Modern intelligent NPCs leverage large language models for open-ended dialogue, reinforcement learning for adaptive combat and movement, and behavioural AI architectures (behaviour trees, goal-oriented action planning) to produce emergent, contextually appropriate responses to player actions and environmental stimuli. They form the interactive population of persistent virtual worlds and are central to immersive narrative experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dialogue-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioral-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioral-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:digital-humans ;
