ngm:adam-optimizer a owl:Class ;
    rdfs:label "Adam Optimizer"@en ;
    rdfs:comment "An optimisation algorithm widely used to train neural networks, combining momentum with per-parameter adaptive learning rates derived from estimates of the first and second moments of the gradients. Its name stands for adaptive moment estimation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:optimization-algorithm ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gradient-descent ;
    vc:slug "adam-optimizer" ;
    vc:sourceDomain "machine-learning" .

