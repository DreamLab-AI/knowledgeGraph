    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-availability-sampling ;
    vc:implements ngm:erasure-coding ;
    vc:qualityScore "0.62"^^xsd:float ;
