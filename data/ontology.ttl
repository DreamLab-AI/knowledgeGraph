ngm:prior-distribution a owl:Class ;
    rdfs:comment "A prior distribution is the probability distribution over unknown quantities that encodes belief before observing data, in Bayesian inference. It is combined with the likelihood via Bayes' theorem to produce the posterior. The choice of prior, ranging from informative to weakly informative or uninformative, encodes assumptions and regularises inference, especially with limited data."@en ;
    rdfs:label "Prior Distribution"@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    rdfs:subClassOf ngm:probability-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
