ngm:gdpr a owl:Class ;
    rdfs:label "GDPR"@en ;
    rdfs:comment "The General Data Protection Regulation (GDPR) is a comprehensive EU legal framework (Regulation 2016/679) that governs the collection, processing, storage, and transfer of personal data belonging to individuals in the European Union and European Economic Area. It establishes six lawful bases for processing, grants data subjects extensive individual rights, and imposes organisational obligations including Data Protection Impact Assessments and appointment of Data Protection Officers. Enforced by national supervisory authorities coordinated by the European Data Protection Board, GDPR carries penalties of up to €20 million or 4% of global annual turnover, making it the most consequential data protection law globally and a template for privacy legislation worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-minimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:data-protection-regulation ;
    vc:bridgesTo ngm:ai-act,
        ngm:differential-privacy,
        ngm:federated-learning ;
    vc:contrastsWith ngm:ai-regulation,
        ngm:ccpa,
        ngm:hipaa ;
    vc:dependsOn ngm:european-data-protection-board,
        ngm:supervisory-authority ;
    vc:enables ngm:accountability,
        ngm:data-subject-rights,
        ngm:privacy-by-design,
        ngm:privacy-impact-assessment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-portability,
        ngm:data-protection-impact-assessment,
        ngm:lawful-basis-for-processing,
        ngm:right-to-erasure ;
    vc:implements ngm:data-protection,
        ngm:information-security,
        ngm:privacy ;
    vc:isPartOf ngm:eu-digital-single-market ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cross-border-data-transfer,
        ngm:data-breach-notification,
        ngm:gdpr-compliance ;
    vc:requires ngm:audit-trail,
        ngm:consent-management,
        ngm:data-minimisation,
        ngm:data-protection-officer,
        ngm:transparency ;
    vc:slug "gdpr" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-parliament,
        ngm:iso-27701 ;
    vc:supports ngm:data-governance,
        ngm:digital-rights,
        ngm:trust .

ngm:loss-function a owl:Class ;
    rdfs:label "Loss Function"@en ;
    rdfs:comment "A Loss Function is a mathematical function that quantifies the discrepancy between a model's predicted outputs and true target values, producing a scalar error measure that serves as the objective for optimisation algorithms during training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mean-absolute-error ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mean-squared-error ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:evaluation-metric,
        ngm:optimisation-theory ;
    vc:contrastsWith ngm:evaluation-metric,
        ngm:overfitting ;
    vc:dependsOn ngm:neural-network,
        ngm:training-data ;
    vc:enables ngm:backpropagation,
        ngm:gradient-descent,
        ngm:model-convergence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cross-entropy-loss,
        ngm:hinge-loss,
        ngm:mean-absolute-error,
        ngm:mean-squared-error ;
    vc:implements ngm:statistical-risk-minimisation ;
    vc:isPartOf ngm:model-training-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:hyperparameter-tuning,
        ngm:regularisation ;
    vc:requires ngm:ground-truth-label,
        ngm:model-prediction ;
    vc:slug "loss-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-22989-2022 ;
