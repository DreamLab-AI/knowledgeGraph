    vc:relatedTo ngm:artificial-intelligence,
        ngm:computer-vision,
        ngm:embedded-systems,
        ngm:internet-of-things,
        ngm:natural-language-processing,
        ngm:neuromorphic-computing ;
    vc:slug "edge-ai-accelerator" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:fpga,
        ngm:neural-network .

ngm:encoder-decoder-architecture a owl:Class ;
    rdfs:label "Encoder Decoder Architecture"@en ;
    rdfs:comment "A neural network design pattern comprising an encoder that compresses an input sequence into a latent representation and a decoder that generates an output sequence from that representation, enabling sequence-to-sequence mappings for tasks such as machine translation, summarisation, and image captioning. The architecture underpins the original Transformer (Vaswani et al., 2017) and models such as T5 and BART."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:model-architecture ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cross-attention,
        ngm:self-attention,
        ngm:token-embedding ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "encoder-decoder-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer .

ngm:erc-20 a owl:Class ;
    rdfs:label "ERC-20"@en ;
    rdfs:comment "ERC-20 is the Ethereum Request for Comment standard that defines a mandatory six-function interface — totalSupply, balanceOf, transfer, transferFrom, approve, and allowance — enabling any conformant fungible token to interoperate seamlessly with wallets, decentralised exchanges, and smart contract protocols without bespoke integration. Proposed by Fabian Vogelsteller and Vitalik Buterin in 2015 and formalised as an Ethereum Improvement Proposal, ERC-20 became the foundational primitive of the DeFi ecosystem and the predominant format for utility tokens, governance tokens, and stablecoins."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token-standard ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-1155,
        ngm:erc-721 ;
    vc:enables ngm:decentralised-finance,
        ngm:fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc-20" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:financial-infrastructure a owl:Class ;
    rdfs:label "Financial Infrastructure"@en ;
    rdfs:comment "Financial Infrastructure comprises the foundational systems, networks, and institutions that enable the creation, exchange, and settlement of financial value. It includes payment clearing networks, custody systems, blockchain settlement layers, lightning-speed payment channels, and the regulatory reporting frameworks that underpin both traditional and decentralised financial ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
