ngm:parametric-design-methodology a owl:Class ;
    rdfs:label "Parametric Design Methodology"@en ;
    rdfs:comment "A design methodology in which objects, environments, or behaviours are specified through adjustable parameters rather than fixed geometry, enabling variant generation and real-time adaptation. In metaverse and spatial computing contexts, parametric approaches underpin voice-and-text-driven CAD primitive creation, procedural content generation, and digital twin model customisation within shared virtual workspaces."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-twin,
        ngm:procedural-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rendering-engine,
        ngm:spatial-computing ;
    vc:slug "parametric-design-methodology" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:parametric-design-methodology-modeling,
        ngm:procedural-content-generation .

