        ngm:iso-14001 ;
    vc:supports ngm:accessibility,
        ngm:carbon-aware-computing,
        ngm:net-zero .

ngm:cryptographic-primitive a owl:Class ;
    rdfs:label "Cryptographic Primitive"@en ;
    rdfs:comment "The fundamental atomic building blocks of all cryptographic systems — including hash functions, symmetric and asymmetric ciphers, digital signatures, and key exchange protocols — each providing specific, well-defined security guarantees. Primitives are insufficient alone and must be combined in higher-level cryptographic protocols to satisfy multiple security requirements such as confidentiality, integrity, authentication, and non-repudiation. Correct selection and composition of primitives is the foundational concern of applied cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symmetric-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-derivation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asymmetric-encryption ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:cryptography ;
    vc:enables ngm:cryptographic-protocol,
        ngm:public-key-infrastructure,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:asymmetric-encryption,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:key-derivation-function,
        ngm:random-number-generation,
        ngm:symmetric-encryption ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:elliptic-curve-cryptography,
        ngm:homomorphic-encryption,
        ngm:key-management,
        ngm:merkle-tree,
        ngm:post-quantum-cryptography,
        ngm:proof-of-work ;
    vc:slug "cryptographic-primitive" ;
    vc:sourceDomain "blockchain" .

ngm:semantic-search a owl:Class ;
    rdfs:label "Semantic Search"@en ;
    rdfs:comment "Semantic search is a retrieval paradigm that understands the meaning and intent of queries and documents rather than relying solely on lexical keyword overlap, deploying continuous vector representations of text—produced by neural encoder models that compress sentences into dense embedding spaces..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverted-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmark-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nearest-neighbor-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reranker ],
        [ a owl:Restriction ;
