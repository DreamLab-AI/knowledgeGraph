    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:user-experience ;
    vc:requires ngm:human-computer-interaction ;
    vc:slug "user-interface" ;
    vc:sourceDomain "infrastructure" .

ngm:zero-trust-architecture a owl:Class ;
    rdfs:label "Zero Trust Architecture"@en ;
    rdfs:comment "Zero Trust Architecture (ZTA) is a cybersecurity paradigm that abandons the notion of a trusted network perimeter and instead requires explicit, continuous verification of every principal (user, device, service) and every request, regardless of its network origin. Grounded in the principle of least-privilege access, ZTA evaluates contextual signals — identity, device health posture, location, and behavioural risk — at each access decision point, enforced by policy engines and micro-segmentation. The model was formalised in NIST SP 800-207 and is increasingly mandated by government and enterprise security frameworks as a response to lateral movement threats and cloud-native architectures that dissolve traditional perimeter boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing ;
    vc:requires ngm:authentication,
        ngm:identity-and-access-management ;
    vc:slug "zero-trust-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:access-control,
        ngm:policy-engine .

ngm:block-reward a owl:Class ;
    rdfs:label "Block Reward"@en ;
    rdfs:comment "A Block Reward is the cryptoeconomic incentive paid to the producer of a valid block—comprising a protocol-specified subsidy (newly minted tokens) plus the aggregate transaction fees included in that block—which compensates validators or miners for expending resources to extend the canonical chain and maintain network security. Block reward schedules are a core parameter of a blockchain's monetary policy, directly governing token inflation, miner revenue, and the long-run security budget of the network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
