    vc:slug "credential-exchange" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:verifiable-credentials ;
    vc:uses ngm:decentralised-identifier,
        ngm:selective-disclosure .

ngm:crm-systems a owl:Class ;
    rdfs:label "CRM Systems"@en ;
    rdfs:comment "CRM systems are software platforms that centralise the management of an organisation's interactions with current and prospective customers across sales, marketing, and service. They store contact records, track pipelines and tickets, automate outreach, and increasingly embed AI for summarisation and recommendation. They are core operational systems for revenue and customer-experience teams."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crm,
        ngm:meeting-ai-assistant ;
    vc:slug "crm-systems" ;
    vc:sourceDomain "infrastructure" .

ngm:cross-border-regulatory-cooperation a owl:Class ;
    rdfs:label "Cross Border Regulatory Cooperation"@en ;
    rdfs:comment "Cross-border regulatory cooperation is the coordination of financial supervision, rule-making and enforcement across national jurisdictions to manage activities and risks that span borders. It operates through memoranda of understanding, supervisory colleges, information-sharing arrangements, mutual recognition and common standards set by international bodies. By aligning approaches to systemic risk, anti-money-laundering and cross-border payments, it reduces regulatory arbitrage and supports consistent oversight of globally active firms and markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:basel-committee ;
    vc:contrastsWith ngm:prudential-regulation ;
    vc:dependsOn ngm:financial-stability ;
    vc:enables ngm:cross-border-payments,
        ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:financial-regulation ;
    vc:isPartOf ngm:financial-regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:compliance,
        ngm:fsb ;
    vc:requires ngm:financial-regulation ;
    vc:slug "cross-border-regulatory-cooperation" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fsb,
        ngm:g20 ;
    vc:supports ngm:anti-money-laundering,
        ngm:regulatory-compliance ;
    vc:uses ngm:standards-organization .

ngm:cross-border-remittances a owl:Class ;
    rdfs:label "Cross-Border Remittances"@en ;
    rdfs:comment "Cross-border remittances are transfers of money by individuals—typically migrant workers—to recipients in another country, often family members. Traditionally routed through banks and money-transfer operators with high fees and slow settlement, they are increasingly served by stablecoins and crypto rails that lower cost and latency. They represent a major global financial flow and a key driver of crypto payment adoption."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stable-coins ;
    vc:slug "cross-border-remittances" ;
    vc:sourceDomain "blockchain" .

ngm:cross-chain-dex a owl:Class ;
    rdfs:label "Cross-Chain DEX"@en ;
    rdfs:comment "A cross-chain DEX is a decentralised exchange that lets users swap assets native to different blockchains without a centralised custodian. It relies on bridges, atomic swaps, or liquidity-network protocols to coordinate settlement across chains while preserving non-custodial trading. It extends decentralised finance beyond single-chain liquidity silos."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "cross-chain-dex" ;
    vc:sourceDomain "blockchain" .

ngm:cross-dao-benchmarking a owl:Class ;
    rdfs:label "Cross-DAO Benchmarking"@en ;
    rdfs:comment "Cross-DAO benchmarking is the comparative analysis of decentralised autonomous organisations against shared metrics such as treasury size, voter participation, proposal throughput, and contributor activity. It aggregates on-chain governance and financial data to rank or contextualise a DAO's performance relative to peers. It informs governance design, delegate accountability, and treasury strategy."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics ;
    vc:slug "cross-dao-benchmarking" ;
    vc:sourceDomain "blockchain" .

ngm:cross-modal-conditioning a owl:Class ;
    rdfs:label "Cross-Modal Conditioning"@en ;
    rdfs:comment "Cross-modal conditioning is a generative modelling technique in which a model producing output in one sensory or representational modality is guided at inference time by a conditioning signal derived from a different modality, typically via cross-attention or adapter mechanisms that inject encoded representations of the conditioning input into the backbone network's intermediate layers. It is the foundational mechanism enabling text-to-image synthesis, text-to-audio generation, audio-driven video synthesis, depth-conditioned inpainting, and other heterogeneous generation tasks where the semantic intent is expressed in one modality and realised in another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classifier-free-guidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:representation-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:contrastive-learning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:self-attention ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:latent-space,
        ngm:transformer-architecture ;
    vc:enables ngm:audio-synthesis,
        ngm:image-generation,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adapter-tuning,
        ngm:classifier-free-guidance,
        ngm:cross-attention,
        ngm:modality-specific-encoder ;
    vc:implements ngm:multimodal-ai-architecture-learning ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:controlnet,
        ngm:diffusion-model,
        ngm:foundation-model,
        ngm:ip-adapter,
        ngm:lora,
        ngm:stable-diffusion-image-model ;
    vc:requires ngm:contrastive-learning,
        ngm:embedding,
        ngm:representation-learning ;
    vc:slug "cross-modal-conditioning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cross-platform-asset-exchange a owl:Class ;
    rdfs:label "Cross-Platform Asset Exchange"@en ;
    rdfs:comment "Cross-platform asset exchange is the capability to move 3D models, textures, and other digital assets between different metaverse platforms, engines, and tools while preserving fidelity and usability. It depends on shared 3D file formats and import/export pipelines that map assets onto each platform's runtime. It is a prerequisite for interoperable virtual worlds and portable user content."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:standard-format-support ;
    vc:slug "cross-platform-asset-exchange" ;
    vc:sourceDomain "metaverse" .

ngm:cross-platform-content a owl:Class ;
    rdfs:label "Cross-Platform Content"@en ;
    rdfs:comment "Cross-platform content is digital media and 3D assets authored once and made usable across multiple platforms, engines, or devices through standardised formats and conversion pipelines. It depends on format parsers and content pipelines that normalise assets to each target's runtime requirements. It enables creators to reach diverse metaverse environments without bespoke re-authoring."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:format-parser,
        ngm:metaverse-content-pipeline ;
    vc:slug "cross-platform-content" ;
    vc:sourceDomain "metaverse" .

