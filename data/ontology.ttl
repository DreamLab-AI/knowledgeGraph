ngm:sim-to-real-transfer a owl:Class ;
    rdfs:label "Sim-to-Real Transfer"@en ;
    rdfs:comment "Sim-to-real transfer is the set of techniques and methodologies for training robotic policies, perception models, and control algorithms inside physics simulators and then deploying the resulting models on physical hardware with acceptable performance degradation. The fundamental barrier is the reality gap: discrepancies in physics fidelity, contact dynamics, sensor noise characteristics, visual appearance, and actuator latency cause policies optimised entirely in simulation to fail on real systems. Mitigation strategies include domain randomisation, domain adaptation, system identification, adaptive dynamics models, and photorealistic rendering to progressively close this gap. The field sits at the intersection of reinforcement learning, robot learning, and transfer learning, and underpins practical large-scale autonomous system deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:transfer-learning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:embodied-ai ;
    vc:contrastsWith ngm:imitation-learning,
        ngm:robot-learning ;
    vc:dependsOn ngm:domain-adaptation,
        ngm:transfer-learning ;
    vc:enables ngm:autonomous-manipulation,
        ngm:autonomous-navigation,
        ngm:legged-locomotion,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-network,
        ngm:model-based-reinforcement-learning,
        ngm:photorealistic-rendering,
        ngm:policy-gradient-methods ;
    vc:requires ngm:physics-engine,
        ngm:robot-simulation ;
    vc:slug "sim-to-real-transfer" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:domain-randomisation,
        ngm:physics-simulation,
        ngm:reinforcement-learning,
        ngm:simulation,
        ngm:synthetic-data,
        ngm:system-identification .

ngm:stakeholder-analysis a owl:Class ;
    rdfs:label "Stakeholder Analysis"@en ;
    rdfs:comment "Stakeholder analysis is a systematic methodology for identifying, mapping, and evaluating the individuals, groups, and organisations that have an interest in—or are affected by—a system, project, or policy, assessing their interests, power, influence, and potential impact on outcomes. It is a foundational practice in requirements engineering, impact assessment, governance design, and change management, enabling decision-makers to anticipate conflicts, prioritise engagement, and design participation mechanisms that are inclusive and legitimate. In AI and technology contexts, stakeholder analysis extends to affected communities who may not self-identify or organise, requiring proactive identification of indirect and diffuse impacts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:requirements-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:impact-assessment ],
        ngm:stakeholder ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:fundamental-rights-impact-assessment ;
    vc:enables ngm:ai-impact-assessment,
        ngm:change-management,
        ngm:privacy-impact-assessment,
        ngm:stakeholder-engagement-in-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment,
        ngm:stakeholder-engagement,
        ngm:stakeholder-theory,
        ngm:stakeholder-trust ;
    vc:requires ngm:impact-assessment,
        ngm:requirements-engineering ;
    vc:slug "stakeholder-analysis" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:participatory-policy-making,
        ngm:regulatory-compliance ;
    vc:uses ngm:social-network-analysis .

ngm:sustainable-finance a owl:Class ;
    rdfs:label "Sustainable Finance"@en ;
    rdfs:comment "Sustainable finance refers to the integration of environmental, social, and governance (ESG) criteria into financial decision-making, product design, and market regulation with the goal of channelling capital flows toward activities that support a sustainable economy. It encompasses green bonds, sustainability-linked loans, ESG investing, climate risk management, and regulatory taxonomies that define what qualifies as environmentally sustainable economic activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:greenwashing-prevention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:esg-reporting ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:climate-science,
        ngm:tokenised-green-bonds ;
    vc:contrastsWith ngm:conventional-finance ;
    vc:dependsOn ngm:paris-agreement,
        ngm:sustainable-development-goals ;
    vc:enables ngm:green-bond-market,
        ngm:impact-investing,
        ngm:sustainability-linked-loan,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:corporate-sustainability-reporting-directive,
        ngm:eu-sustainable-finance-disclosure-regulation ;
    vc:qualityScore "0.82"^^xsd:float ;
    vc:relatedTo ngm:climate-finance ;
    vc:requires ngm:climate-risk-disclosure,
        ngm:esg-reporting,
        ngm:greenwashing-prevention ;
    vc:slug "sustainable-finance" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:icma-green-bond-principles,
        ngm:issb,
        ngm:ngfs ;
    vc:uses ngm:esg,
        ngm:eu-taxonomy,
        ngm:ifrs-s1,
        ngm:tcfd .

ngm:theorem-proving a owl:Class ;
    rdfs:label "Theorem Proving"@en ;
    rdfs:comment "Theorem proving is the activity of establishing the truth of mathematical or logical statements by constructing rigorous, step-by-step deductions from axioms and inference rules. Automated theorem proving uses software to search for or verify such proofs, while interactive theorem proving combines machine checking with human guidance. It underpins formal verification of hardware, software and protocols, as well as the mechanisation of mathematics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mathematical-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        ngm:automated-reasoning ;
    vc:contrastsWith ngm:machine-learning ;
    vc:dependsOn ngm:logic ;
    vc:enables ngm:auditability,
        ngm:formal-methods ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inference,
        ngm:logic ;
    vc:implements ngm:automated-reasoning ;
    vc:isPartOf ngm:automated-reasoning,
        ngm:formal-methods ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-science,
        ngm:knowledge-representation,
        ngm:set-theory ;
    vc:requires ngm:description-logic,
        ngm:mathematical-logic ;
    vc:slug "theorem-proving" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:reliability,
        ngm:software-engineering ;
    vc:uses ngm:inference,
        ngm:reasoning .

ngm:w3-c-verifiable-credentials a owl:Class ;
    rdfs:label "W3C Verifiable Credentials"@en ;
    rdfs:comment "W3C Verifiable Credentials (VCs) are a standardised data model and serialisation format published by the World Wide Web Consortium that enables the cryptographic expression of credentials — such as educational qualifications, identity attributes, and professional licences — in a tamper-evident, machine-verifiable form. The standard defines three roles: issuer (creates and signs the credential), holder (stores and presents it), and verifier (validates the signature and claims), forming a trust triangle that operates without requiring a centralised credential registry. VCs are designed to interoperate with Decentralised Identifiers (DIDs) to enable self-sovereign identity systems in which individuals and organisations control their own digital identity without dependence on a single provider. The VC Data Model 2.0 became a W3C Recommendation in 2024, adding selective disclosure via SD-JWT and BBS+ signatures, JSON Schema validation, and expanded media-type support."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-security ],
        ngm:verifiable-credentials ;
    vc:bridgesTo ngm:ai-agent-identity,
        ngm:decentralized-autonomous-organization,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:saml-assertion,
        ngm:x-509-certificate ;
    vc:enables ngm:credential-verification,
        ngm:digital-identity-wallet,
        ngm:federated-credential-exchange,
        ngm:privacy-preserving-identity,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:open-world-assumption,
        ngm:trust-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:decentralized-identity-did,
        ngm:eidas-regulation,
        ngm:open-badges,
        ngm:verifiable-credential-vc,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-security,
        ngm:decentralized-identifiers,
        ngm:public-key-infrastructure ;
    vc:slug "w3-c-verifiable-credentials" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3c-recommendation,
        ngm:world-wide-web-consortium ;
    vc:uses ngm:cryptographic-proof,
        ngm:did-document,
        ngm:ed25519,
        ngm:json-data-interchange-format-ld,
        ngm:linked-data .

ngm:zigbee a owl:Class ;
    rdfs:label "Zigbee"@en ;
    rdfs:comment "Zigbee is a low-power, low-data-rate wireless mesh networking protocol stack built atop the IEEE 802.15.4 physical and MAC layer standard, designed for battery-operated IoT sensors, actuators, and control devices in home automation, industrial monitoring, and building management. Maintained by the Connectivity Standards Alliance (formerly the Zigbee Alliance), it defines application-layer profiles, mesh routing, and AES-128 security on top of IEEE 802.15.4, supporting coordinator, router, and sleepy end-device roles within self-healing mesh topologies. Operating predominantly at 2.4 GHz (globally) as well as 868 MHz and 915 MHz regional bands, Zigbee targets data rates up to 250 kbps and enables coin-cell battery lifetimes of years, making it a foundational IoT wireless technology that coexists and increasingly converges with Thread and the Matter smart-home standard."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        ngm:ieee-802-15-4 ;
    vc:bridgesTo ngm:cloud-platform ;
    vc:contrastsWith ngm:bluetooth-low-energy,
        ngm:thread-protocol,
        ngm:z-wave ;
    vc:dependsOn ngm:ism-band,
        ngm:mesh-networking ;
    vc:enables ngm:automation,
        ngm:building-automation,
        ngm:io-t-sensor-network,
        ngm:smart-metering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:mesh-routing-software,
        ngm:routing-protocol ;
    vc:isPartOf ngm:protocol-stack ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:industrial-io-t,
        ngm:lpwan,
        ngm:matter-protocol,
        ngm:smart-home ;
    vc:requires ngm:ieee-802-15-4 ;
    vc:slug "zigbee" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee ;
    vc:supports ngm:over-the-air-update,
        ngm:sensor-data ;
    vc:uses ngm:aes-encryption,
        ngm:csma-ca .

ngm:adversarial-attack a owl:Class ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "An Adversarial Attack is a deliberate attempt to manipulate an AI system by crafting malicious inputs or exploiting model vulnerabilities to cause misclassification, extract confidential information, degrade performance, or subvert intended behaviour. Attack classes include evasion, poisoning, model extraction, inversion, and backdoor, across white-box, black-box, and grey-box threat models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-poisoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-inversion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backdoor-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:membership-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-risk-management,
        ngm:cybersecurity ;
    vc:contrastsWith ngm:certified-defense,
        ngm:robustness,
        ngm:safety-fine-tuning ;
    vc:enables ngm:adversarial-robustness,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backdoor-attack,
        ngm:data-poisoning,
        ngm:membership-inference,
        ngm:model-extraction,
        ngm:model-inversion ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-training,
        ngm:ai-safety,
        ngm:computer-vision,
        ngm:differential-privacy ;
    vc:requires ngm:machine-learning-discipline-model,
        ngm:threat-model ;
    vc:slug "adversarial-attack" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:attestation a owl:Class ;
    rdfs:label "Attestation"@en ;
    rdfs:comment "Attestation is the act of producing verifiable, signed evidence that a claim, state, or property is true, allowing a relying party to trust it without re-deriving it. In blockchain proof-of-stake consensus, validators broadcast attestations voting on the head of the chain and on checkpoints, and the aggregate of these signed votes drives finalisation. More broadly, remote attestation lets a trusted execution environment cryptographically prove its identity and integrity to a remote verifier. Attestations are typically cryptographic signatures over structured claims, and they underpin trust, accountability, and slashing-based security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptographic-proof ;
    vc:dependsOn ngm:slashing ;
    vc:enables ngm:economic-finality,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-proof ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus,
        ngm:remote-attestation,
        ngm:validator ;
    vc:requires ngm:cryptography,
        ngm:validator ;
    vc:slug "attestation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake,
        ngm:trusted-execution-environment ;
    vc:uses ngm:cryptographic-proof,
        ngm:cryptography .

ngm:autoencoder a owl:Class ;
    rdfs:label "Autoencoder"@en ;
    rdfs:comment "An Autoencoder is a neural network trained to reconstruct its input by learning a compressed latent representation. The encoder maps input data to a lower-dimensional latent space and the decoder reconstructs the original from this representation, minimising a reconstruction loss. Variants including variational autoencoders (VAEs), denoising autoencoders, and convolutional autoencoders extend this framework to generative modelling, anomaly detection, and feature extraction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-latent-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        ngm:deep-learning ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:signal-processing ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:principal-component-analysis ;
    vc:enables ngm:anomaly-detection,
        ngm:dimensionality-reduction,
        ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decoder-network,
        ngm:encoder,
        ngm:neural-network-latent-space ;
    vc:implements ngm:dimensionality-reduction ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feature-extraction,
        ngm:generative-model,
        ngm:neural-network,
        ngm:transfer-learning,
        ngm:variational-autoencoders ;
    vc:requires ngm:backpropagation ;
    vc:slug "autoencoder" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network-latent-space,
        ngm:unsupervised-learning .

ngm:avatar-interoperability a owl:Class ;
    rdfs:label "Avatar Interoperability"@en ;
    rdfs:comment "Capability enabling an avatar's identity, appearance, and behaviors to function seamlessly across multiple metaverse platforms and virtual environments."@en ;
