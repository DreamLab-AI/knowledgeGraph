    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:network-segmentation,
        ngm:vulnerability-management ;
    vc:requires ngm:security-policy,
        ngm:threat-modelling ;
    vc:slug "defence-in-depth" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-cybersecurity-framework ;
    vc:supports ngm:cloud-security,
        ngm:regulatory-compliance .

ngm:delegated-authorisation a owl:Class ;
    rdfs:label "Delegated Authorisation"@en ;
    rdfs:comment "Delegated authorisation is the pattern in which a resource owner grants a third-party application limited access to their resources without sharing their credentials. An authorisation server issues scoped, often time-limited tokens that the application presents to the resource server, so access can be granted, constrained, and revoked independently of the owner's password. OAuth 2.0 is the dominant framework that implements this pattern across web and API ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:oauth-2-0 ;
    vc:bridgesTo ngm:identity-provider ;
    vc:contrastsWith ngm:authentication ;
    vc:dependsOn ngm:authorization,
        ngm:identity-provider ;
    vc:enables ngm:federated-identity,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:authorization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authorization,
        ngm:oauth,
        ngm:oauth-2-0,
        ngm:token ;
    vc:requires ngm:authentication ;
    vc:slug "delegated-authorisation" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:api ;
    vc:uses ngm:token .

ngm:deployer a owl:Class ;
    rdfs:label "Deployer"@en ;
    rdfs:comment "A Deployer, as defined in EU AI Act Article 3(4), is a natural or legal person, public authority, agency, or other body that uses an AI system under its authority in a professional context. Deployers bear obligations for human oversight, input data monitoring, logging, and fundamental rights impact assessments for high-risk AI systems. They are distinct from providers (who develop or place AI systems on the market) and incur provider-level obligations if they substantially modify an AI system."@en ;
    rdfs:subClassOf ngm:digital-infrastructure,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:ai-governance,
        ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-and-ethics ;
    vc:slug "deployer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-regulation ;
    vc:uses ngm:ai-agent-system,
        ngm:autonomous-robot .

ngm:deposit-return-scheme a owl:Class ;
    rdfs:label "Deposit Return Scheme"@en ;
    rdfs:comment "A deposit return scheme is a circular-economy mechanism in which consumers pay a small refundable deposit on a beverage container at purchase and reclaim it on returning the empty for recycling or reuse. The financial incentive drives high collection rates and clean material streams, reducing litter and supporting closed-loop recycling. It is a recognised instrument of reverse logistics and extended producer responsibility."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:reverse-logistics ;
    vc:slug "deposit-return-scheme" ;
    vc:sourceDomain "supply-chain" .

ngm:deterministic-serialisation a owl:Class ;
    rdfs:label "Deterministic Serialisation"@en ;
    rdfs:comment "Deterministic serialisation is the encoding of structured data into bytes such that semantically identical inputs always yield exactly the same byte sequence. It fixes ambiguities like map-key ordering, number formatting, and whitespace so that the output is canonical and reproducible. This property is essential for hashing, digital signatures, and content addressing, where any byte difference changes the resulting digest."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:uri-canonicaliser ;
    vc:slug "deterministic-serialisation" ;
    vc:sourceDomain "data" .

ngm:dialogue-systems a owl:Class ;
    rdfs:label "Dialogue Systems"@en ;
    rdfs:comment "Dialogue systems are software systems that converse with users in natural language across one or more turns. They include task-oriented assistants, slot-filling pipelines, and open-domain conversational agents, managing intent recognition, dialogue state tracking, response selection and natural language generation."@en ;
