    rdfs:label "Scopedefinition"@en .
ngm:score-based-diffusion a skos:Concept ;
    rdfs:label "Score Based Diffusion"@en .
ngm:score-based-generative-model a owl:Class ;
    rdfs:comment "A score-based generative model is a class of generative model that learns the gradient of the log probability density of data — the score function — and samples by reversing a noising process using that learned score. Training perturbs data with noise at multiple scales and fits a neural network to estimate the score at each scale, after which Langevin-style or reverse stochastic-differential-equation dynamics transform noise into samples. The framework provides a unifying continuous-time view that subsumes denoising diffusion models."@en ;
    rdfs:label "Score-Based Generative Model"@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    rdfs:subClassOf ngm:generative-model ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:flow-matching ;
    vc:bridgesTo ngm:markov-chain-monte-carlo ;
    vc:contrastsWith ngm:generative-adversarial-network ;
    vc:contrastsWith ngm:vae ;
    vc:dependsOn ngm:neural-network ;
    vc:dependsOn ngm:stochastic-differential-equation ;
    vc:enables ngm:classifier-free-guidance ;
    vc:enables ngm:diffusion-policy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:generative-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model ;
    vc:relatedTo ngm:latent-diffusion ;
    vc:slug "score-based-generative-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .
ngm:score-based-generative-modelling a skos:Concept ;
    rdfs:label "Score Based Generative Modelling"@en .
ngm:score-based-model a skos:Concept ;
    rdfs:label "Score Based Model"@en .
ngm:score-distillation-sampling a skos:Concept ;
    rdfs:label "Score Distillation Sampling"@en .
ngm:score-function a owl:Class ;
    rdfs:comment "In score-based generative modelling, the Score Function is the gradient of the log probability density of the data with respect to the input, indicating the direction of increasing data likelihood. Diffusion models learn to estimate this score across noise levels, then use it to iteratively denoise samples drawn from a simple prior. The score function connects diffusion models to Langevin-style sampling and energy-based formulations."@en ;
    rdfs:label "Score Function"@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    rdfs:subClassOf ngm:diffusion-model ;
    rdfs:subClassOf _:r18854 ;
    skos:broader ngm:ai-model-architecture ;
    vc:dependsOn ngm:stochastic-differential-equation ;
    vc:enables ngm:generative-model ;
    vc:enables ngm:sampling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:noise-schedule ;
    vc:isPartOf ngm:diffusion-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence ;
    vc:slug "score-function" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:diffusion-model ;
    vc:uses ngm:maximum-likelihood-estimation ;
    vc:uses ngm:probability-distribution .
ngm:score-matching a owl:Class ;
    rdfs:comment "Score matching is a method for fitting probability models by matching the gradient of the log-density, the score, of the model to that of the data, avoiding the intractable normalising constant. It underpins score-based generative models and diffusion models."@en ;
    rdfs:label "Score Matching"@en ;
    rdfs:subClassOf ngm:ai-technique ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
