    rdfs:subClassOf robotics:Robotics ;
    rdfs:subClassOf robotics:InertialSensor ;
    rdfs:label "Gyroscope"@en ;
    rdfs:comment "**Gyroscope** - An angular velocity sensor that detects rotation rates about three orthogonal axes, enabling Attitude Estimation, Roll/Pitch/Yaw Measurement, and Orientation Tracking for balance control and Inertial Navigation in aerial and mobile robots."@en ;
