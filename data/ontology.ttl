ngm:virtual-labor a owl:Class ;
    rdfs:comment "Work performed in virtual environments that generates economic value, spanning content creation, service provision, virtual construction, platform governance, and social labour. Virtual labour is often platform-dependent, contract-based, and remunerated via virtual currency or revenue-sharing models, raising significant questions around labour rights, taxation of cross-border virtual income, and platform exploitation."@en ;
    rdfs:label "Virtual Labor"@en ;
