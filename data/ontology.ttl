# Token Economics
bc:TokenEconomics a owl:Class ;
    rdfs:subClassOf bc:BlockchainEntity ;
    rdfs:label "Token Economics"@en ;
    rdfs:comment "Token Economics (Tokenomics) is the study and design of economic models and incentive mechanisms surrounding digital tokens on blockchain networks. It encompasses token supply dynamics, distribution mechanisms, staking rewards, governance rights, and the economic incentives that drive participant behaviour within decentralised ecosystems."@en ;
    skos:prefLabel "Token Economics"@en ;
    dcterms:identifier "BC-0601" ;
    dcterms:subject "bc" .

bc:TokenEconomics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:Token
] .

bc:TokenEconomics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:StakingRewards
] .

bc:TokenEconomics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:GovernanceToken
] .

bc:TokenEconomics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom bc:DecentralizedFinance
] .

# Blockchain Scalability
bc:BlockchainScalability a owl:Class ;
    rdfs:subClassOf bc:BlockchainEntity ;
    rdfs:label "Blockchain Scalability"@en ;
    rdfs:comment "Blockchain Scalability encompasses the technical solutions and architectural approaches designed to increase the transaction throughput, reduce latency, and improve the efficiency of blockchain networks while maintaining security and decentralisation. Key approaches include Layer 2 solutions, sharding, rollups, and state channels."@en ;
    skos:prefLabel "Blockchain Scalability"@en ;
    dcterms:identifier "BC-0602" ;
    dcterms:subject "bc" .

bc:BlockchainScalability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:Layer2
] .

bc:BlockchainScalability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:Sharding
] .

bc:BlockchainScalability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:Rollup
] .

bc:BlockchainScalability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:StateChannel
] .

bc:BlockchainScalability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom bc:BlockchainNetwork
] .

# Blockchain Governance
bc:BlockchainGovernance a owl:Class ;
    rdfs:subClassOf bc:BlockchainEntity ;
    rdfs:label "Blockchain Governance"@en ;
    rdfs:comment "Blockchain Governance refers to the mechanisms, processes, and structures through which decisions are made about the development, operation, and evolution of blockchain networks and protocols. This includes on-chain voting systems, decentralised autonomous organisations (DAOs), and community-driven decision-making frameworks."@en ;
    skos:prefLabel "Blockchain Governance"@en ;
    dcterms:identifier "BC-0603" ;
    dcterms:subject "bc" .

bc:BlockchainGovernance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:DAOGovernance
] .

bc:BlockchainGovernance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:OnChainGovernance
] .

bc:BlockchainGovernance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:VotingMechanism
] .

bc:BlockchainGovernance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom bc:TokenEconomics
] .

# Network Component
bc:NetworkComponent a owl:Class ;
    rdfs:subClassOf bc:BlockchainEntity ;
    rdfs:label "Network Component"@en ;
    rdfs:comment "Network Component represents the fundamental infrastructure elements that constitute blockchain networks, including different node types, network protocols, and communication layers. These components work together to enable distributed consensus, data replication, and peer-to-peer communication across the blockchain ecosystem."@en ;
    skos:prefLabel "Network Component"@en ;
    dcterms:identifier "BC-0604" ;
    dcterms:subject "bc" .

bc:NetworkComponent rdfs:subClassOf [
    a owl:Restriction ;
