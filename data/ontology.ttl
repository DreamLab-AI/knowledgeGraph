ngm:gpu-compute a owl:Class ;
    rdfs:label "GPU Compute"@en ;
    rdfs:comment "GPU Compute refers to the use of Graphics Processing Units for general-purpose massively parallel numerical computation (GPGPU), exploiting the GPU's thousands of shader cores to execute data-parallel workloads — principally matrix multiplications and convolutions — at throughputs far exceeding those achievable on CPUs. GPU compute is the dominant hardware substrate for training and inference of deep neural networks, enabled by programming frameworks such as CUDA and ROCm that expose the GPU's parallel execution model to software developers. It underpins the large-scale computation required for training large language models, diffusion models, and other foundation models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:distributed-training,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning-infrastructure,
        ngm:tpu ;
    vc:slug "gpu-compute" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cuda .

ngm:authentication a owl:Class ;
    rdfs:label "Authentication"@en ;
    rdfs:comment "Authentication is the security process of verifying that a claimed identity — of a user, device, application, or service — is genuine before granting access to protected resources. It is distinct from authorisation, which determines what an authenticated principal is permitted to do. Authentication evidence takes the form of knowledge factors (passwords, PINs), possession factors (hardware tokens, mobile devices), inherence factors (biometrics), or cryptographic proofs (digital signatures, TLS client certificates). Modern secure systems require multiple independent factors (multi-factor authentication) to resist credential theft attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:zero-trust-architecture ;
    vc:requires ngm:cryptography,
        ngm:identity-verification ;
    vc:slug "authentication" ;
    vc:sourceDomain "infrastructure" .

ngm:ai-infrastructure a owl:Class ;
    rdfs:label "AI Infrastructure"@en ;
    rdfs:comment "AI Infrastructure refers to the hardware, software, and systems required to develop, train, deploy, and operate artificial intelligence applications. It encompasses GPU compute clusters, cloud platforms, model serving frameworks, data pipelines, and the surrounding toolchains for experiment tracking, versioning, and monitoring. Effective AI Infrastructure is a prerequisite for scaling machine learning workloads from research prototypes to production systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:enables ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:edge-computing,
        ngm:gpu-compute ;
