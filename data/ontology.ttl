    rdfs:label "Z Wave"@en .

ngm:z-wave-js-ui a owl:Class ;
    rdfs:label "Z-Wave JS UI"@en ;
    rdfs:comment "Z-Wave JS UI is an open-source application that wraps the Z-Wave JS driver to manage a Z-Wave mesh network of smart-home devices through a web interface and to bridge it to home-automation platforms via MQTT. It handles device inclusion, configuration, firmware updates, and network healing, exposing Z-Wave nodes as controllable entities. It matters as a primary integration path between Z-Wave hardware and Home Assistant."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "z-wave-js-ui" ;
    vc:sourceDomain "infrastructure" .

ngm:zcash a owl:Class ;
    rdfs:label "Zcash"@en ;
    rdfs:comment "Zcash is a privacy-oriented cryptocurrency launched in 2016 that uses zero-knowledge proofs to allow transactions to be verified without revealing the sender, recipient or amount. It was the first widespread deployment of zk-SNARKs, succinct non-interactive arguments of knowledge, in a public blockchain. Zcash supports both transparent addresses, similar to Bitcoin, and shielded addresses that conceal transaction details, giving users a choice of privacy level. The protocol derives from the Zerocash academic proposal and is developed by the Electric Coin Company."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:regulatory-compliance,
        ngm:zk-rollup,
        ngm:zk-sync ;
    vc:contrastsWith ngm:bitcoin,
        ngm:dash,
        ngm:monero ;
    vc:dependsOn ngm:blockchain,
        ngm:public-key-cryptography ;
    vc:enables ngm:anonymous-payment,
        ngm:selective-disclosure,
        ngm:transaction-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:sapling-protocol,
        ngm:shielded-transaction,
        ngm:zk-snark ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:cryptographic-currency,
        ngm:electric-coin-company ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:proof-of-work,
        ngm:trusted-setup-ceremony,
        ngm:zero-knowledge-proof ;
    vc:slug "zcash" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:equihash,
        ngm:merkle-tree,
        ngm:note-commitment .

ngm:zero-day-exploits a owl:Class ;
    rdfs:label "Zero-Day Exploits"@en ;
    rdfs:comment "A zero-day exploit is an attack technique that targets a software or hardware vulnerability unknown to the vendor and for which no patch yet exists, giving defenders zero days to prepare. Because the flaw is undisclosed, such exploits bypass signature-based defenses and are highly valuable to attackers, state actors, and exploit brokers. They matter as a central concern in cybersecurity, surveillance, and offensive cyber operations."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-security-and-military,
        ngm:digital-society-surveillance ;
    vc:slug "zero-day-exploits" ;
    vc:sourceDomain "security" .

ngm:zero-downtime-deployment a skos:Concept ;
    rdfs:label "Zero Downtime Deployment"@en .

ngm:zigbee2-mqtt a owl:Class ;
    rdfs:label "Zigbee2MQTT"@en ;
    rdfs:comment "Zigbee2MQTT is an open-source bridge that connects Zigbee smart-home devices to MQTT, allowing them to be controlled independently of any proprietary vendor hub or cloud. Using an inexpensive Zigbee coordinator radio, it translates device messages into MQTT topics with a large database of supported devices. It matters as a vendor-neutral, locally controlled integration path for Zigbee hardware into platforms like Home Assistant."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "zigbee2-mqtt" ;
    vc:sourceDomain "infrastructure" .

