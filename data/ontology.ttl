    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash-function,
        ngm:proof-of-stake,
        ngm:smart-contract .

ngm:motion-planning a owl:Class ;
    rdfs:label "Motion Planning"@en ;
    rdfs:comment "Motion Planning extends path planning by incorporating robot dynamics, control constraints, and time-parametrisation to generate dynamically feasible trajectories that account for velocity, acceleration, jerk, and actuator limitations. It produces executable control sequences that guide robots and autonomous vehicles from initial to goal states whilst satisfying kinodynamic constraints and optimising performance metrics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:reactive-control ;
    vc:dependsOn ngm:environment-mapping,
        ngm:robot-kinematics,
        ngm:sensor-fusion ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-vehicle,
        ngm:human-robot-interaction,
        ngm:robotic-manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:collision-avoidance,
        ngm:kinodynamic-planning,
        ngm:trajectory-optimisation ;
    vc:implements ngm:model-predictive-control,
        ngm:potential-field-method,
        ngm:rapidly-exploring-random-tree ;
    vc:isPartOf ngm:autonomous-navigation,
        ngm:robot-autonomy ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:simultaneous-localisation-and-mapping,
        ngm:task-planning ;
    vc:requires ngm:configuration-space,
        ngm:control-theory,
        ngm:obstacle-representation,
        ngm:path-planning ;
    vc:slug "motion-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:optimization-algorithm,
        ngm:sampling-based-planning .

ngm:robo-perception a owl:Class,
