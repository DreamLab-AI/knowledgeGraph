ngm:mobile-robotics a owl:Class ;
    rdfs:label "Mobile Robotics"@en ;
    rdfs:comment "Mobile robotics is the engineering and scientific discipline concerned with the design, construction, and programming of robots capable of autonomous locomotion through unstructured or semi-structured physical environments. It integrates mechanical locomotion systems (wheeled, tracked, legged, aerial, aquatic), onboard sensor suites, simultaneous localisation and mapping (SLAM) for spatial state estimation, motion planning for collision-free trajectory generation, and control systems for execution — all without continuous human tele-operation. The field is fundamentally interdisciplinary, drawing on computer science, control theory, mechanical engineering, and artificial intelligence, and underpins major commercial domains including warehouse automation, autonomous vehicles, agricultural robotics, and planetary exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localisation ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:dependsOn ngm:embedded-systems,
        ngm:robot-operating-system ;
    vc:enables ngm:autonomous-vehicle,
        ngm:logistics-automation,
        ngm:planetary-exploration,
        ngm:precision-agriculture,
        ngm:search-and-rescue-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:drone,
        ngm:humanoid-robot,
        ngm:legged-locomotion,
        ngm:reinforcement-learning-for-robotics ;
    vc:requires ngm:localisation,
        ngm:occupancy-mapping,
        ngm:real-time-computing ;
    vc:slug "mobile-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-3691-4 ;
    vc:uses ngm:computer-vision,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:motion-control,
        ngm:path-planning,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping .

ngm:model-capacity a owl:Class ;
    rdfs:label "Model Capacity"@en ;
    rdfs:comment "The measure of a machine learning model's ability to represent a wide variety of functions, determined by parameter count, architecture depth and width, and representational power. Models with insufficient capacity underfit the data; those with excessive capacity risk overfitting. Capacity is formally bounded by concepts such as the Vapnik–Chervonenkis dimension, and is managed in practice through regularisation, pruning, and architecture search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:overfitting,
        ngm:regularisation,
        ngm:underfitting ;
    vc:requires ngm:neural-network,
        ngm:training-data ;
    vc:slug "model-capacity" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:model-checking a owl:Class ;
    rdfs:label "Model Checking"@en ;
    rdfs:comment "Model checking is an automated formal-verification technique that exhaustively explores the reachable states of a finite-state model of a system to determine whether it satisfies a specification, typically expressed in temporal logic. When the property fails, the model checker returns a concrete counterexample trace, making it valuable for debugging concurrent and reactive systems. Its main challenge is the state-space explosion problem, addressed by symbolic and abstraction techniques."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:temporal-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:temporal-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-space ],
        ngm:formal-verification ;
    vc:contrastsWith ngm:concurrency ;
    vc:dependsOn ngm:formal-methods ;
    vc:enables ngm:formal-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:state-space,
        ngm:temporal-logic ;
    vc:implements ngm:formal-verification ;
    vc:isPartOf ngm:formal-methods,
        ngm:formal-verification ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:formal-methods,
        ngm:logic ;
    vc:requires ngm:state-space,
        ngm:temporal-logic ;
    vc:slug "model-checking" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:concurrency ;
    vc:uses ngm:logic,
        ngm:temporal-logic .

ngm:model-quantization a owl:Class ;
    rdfs:label "Model Quantization"@en ;
    rdfs:comment "Model quantization is a model-compression technique that reduces the numerical precision of a neural network's weights and activations, typically converting 32-bit floating-point values to lower-precision integer or float formats such as INT8, INT4 or FP8. By shrinking the memory footprint and exploiting cheaper integer arithmetic, quantization lowers latency, energy use and storage cost, usually at a small and controllable loss in accuracy. It is applied either after training (post-training quantization) or during training (quantization-aware training) to deploy large models on constrained inference hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:model-compression ;
    vc:contrastsWith ngm:knowledge-distillation ;
    vc:enables ngm:edge-computing,
        ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-optimization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-speed,
        ngm:fine-tuning,
        ngm:model-optimization ;
    vc:requires ngm:gpu,
        ngm:inference-hardware ;
    vc:slug "model-quantization" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:ai-model,
        ngm:large-language-model,
        ngm:model-serving ;
    vc:uses ngm:deep-learning,
        ngm:neural-network .

ngm:monolithic-architecture a owl:Class ;
    rdfs:label "Monolithic Architecture"@en ;
    rdfs:comment "Monolithic architecture is a software design style in which an application is built and deployed as a single, self-contained unit where the user interface, business logic, and data-access layers are tightly coupled within one codebase and process. Components communicate through in-process function calls rather than network protocols, simplifying development, testing, and deployment for small to medium systems. As applications grow, the monolith can become difficult to scale selectively, evolve independently, or deploy without full redeployment, which motivates migration toward modular or microservices architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:business-logic-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:presentation-layer ],
        ngm:system-architecture ;
    vc:bridgesTo ngm:modular-monolith,
        ngm:strangler-fig-pattern ;
    vc:contrastsWith ngm:distributed-architecture,
        ngm:microservices-architecture,
        ngm:service-oriented-architecture ;
    vc:dependsOn ngm:vertical-scaling ;
    vc:enables ngm:atomic-refactoring,
        ngm:simplified-deployment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:business-logic-layer,
        ngm:data-access-layer,
        ngm:presentation-layer ;
    vc:isPartOf ngm:software-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deployment-unit,
        ngm:n-tier-architecture ;
    vc:requires ngm:single-codebase ;
    vc:slug "monolithic-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:rapid-prototyping ;
    vc:uses ngm:in-process-communication,
        ngm:shared-database .

ngm:monte-carlo-simulation a owl:Class ;
    rdfs:label "Monte Carlo Simulation"@en ;
    rdfs:comment "Monte Carlo simulation is a computational technique that estimates the behaviour of a system or the value of a quantity by repeatedly sampling random inputs from probability distributions and aggregating the resulting outcomes. By running many random trials it approximates expectations, distributions and tail risks that are difficult to derive analytically. It is widely used for numerical integration, risk analysis and uncertainty quantification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-sampling ],
        ngm:simulation ;
    vc:bridgesTo ngm:risk-assessment-methodology ;
    vc:contrastsWith ngm:numerical-methods ;
    vc:dependsOn ngm:central-limit-theorem,
        ngm:probability-distribution ;
    vc:enables ngm:risk-assessment-methodology,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:numerical-methods,
        ngm:simulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:sensitivity-analysis,
        ngm:simulation ;
    vc:requires ngm:probability-distribution,
        ngm:random-sampling ;
    vc:slug "monte-carlo-simulation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:financial-modelling,
        ngm:sensitivity-analysis ;
    vc:uses ngm:random-sampling,
        ngm:variance-reduction .

ngm:multi-access-edge-computing a owl:Class ;
    rdfs:label "MultiAccessEdgeComputing"@en ;
    rdfs:comment "Multi-Access Edge Computing (MEC) is an ETSI-standardised architecture that places cloud-like compute and storage resources at the radio access network edge, enabling low-latency application hosting within milliseconds of end-user devices. It decouples latency-sensitive processing from centralised cloud data centres by co-locating compute with base stations and other network nodes."@en ;
    rdfs:subClassOf ngm:edge-computing ;
    vc:enables ngm:edge-ai,
        ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:fog-computing,
        ngm:latency ;
    vc:slug "multi-access-edge-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compute-resources,
        ngm:edge-orchestration .

ngm:multi-stakeholder-governance a owl:Class ;
    rdfs:label "Multi-Stakeholder Governance"@en ;
    rdfs:comment "Multi-stakeholder governance is a model of collective decision-making in which government, private sector, civil society, technical communities, and academia participate jointly and on a relatively equal footing to develop policies, standards, or norms. It emphasises inclusiveness, transparency, and consensus over top-down or purely state-led control, and is the prevailing model for governing shared resources such as the internet. Its legitimacy derives from broad participation rather than hierarchical authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:digital-governance ;
    vc:contrastsWith ngm:risk-management ;
    vc:enables ngm:accountability,
        ngm:decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:digital-governance,
        ngm:transparency,
        ngm:trust ;
    vc:requires ngm:stakeholder-engagement,
        ngm:transparency ;
    vc:slug "multi-stakeholder-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:digital-trust ;
    vc:uses ngm:decision-making .

ngm:multi-view-stereo a owl:Class ;
    rdfs:label "Multi-View Stereo"@en ;
    rdfs:comment "Multi-View Stereo (MVS) is a computer vision technique that reconstructs dense 3D geometry from a set of overlapping 2D images captured from multiple camera positions. It extends traditional stereo matching by leveraging consistency across many viewpoints to estimate depth and surface detail at high resolution. MVS is a foundational component of photogrammetry pipelines, producing point clouds and textured meshes from photograph collections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        ngm:photogrammetry ;
    vc:bridgesTo ngm:photorealistic-rendering,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:3-d-gaussian-splatting,
        ngm:lidar-scanning,
        ngm:neural-radiance-field ;
    vc:dependsOn ngm:structure-from-motion ;
    vc:enables ngm:3-d-scanning,
        ngm:digital-twin,
        ngm:point-cloud-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-estimation ;
    vc:isPartOf ngm:3-d-reconstruction,
        ngm:photogrammetry ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:point-cloud-processing,
        ngm:simultaneous-localisation-and-mapping ;
    vc:requires ngm:camera-calibration,
        ngm:feature-matching ;
    vc:slug "multi-view-stereo" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:reality-capture ;
    vc:uses ngm:depth-estimation,
        ngm:stereo-vision .

ngm:multihash a owl:Class ;
    rdfs:label "Multihash"@en ;
    rdfs:comment "Multihash is a self-describing hash format developed by Protocol Labs in which the hash digest is prefixed with a varint-encoded function code and digest length, enabling consumers to identify the hash algorithm without out-of-band knowledge. It is a foundational component of the IPFS content-addressing stack and the Multiformat suite, providing algorithm agility so that systems can upgrade from SHA-256 to SHA3 or BLAKE3 without breaking existing identifiers. Any hash function can be registered in the Multihash table and the format is codec-neutral."@en ;
    rdfs:subClassOf ngm:cryptographic-hash ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identifier,
        ngm:verifiable-credentials ;
    vc:enables ngm:content-addressed-storage,
        ngm:ipfs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ipld,
        ngm:multiformats ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:content-identifier,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree,
        ngm:multicodec,
        ngm:multiformats ;
    vc:slug "multihash" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-verification,
        ngm:post-quantum-cryptography ;
    vc:uses ngm:binary-encoding,
        ngm:sha-256 .

ngm:multisignature-wallets a owl:Class ;
    rdfs:label "Multisignature Wallets"@en ;
    rdfs:comment "Multisignature wallets are cryptocurrency custody arrangements requiring m-of-n cryptographic signatures before a transaction can be authorised, distributing key control across multiple independent parties or devices. They eliminate single points of failure in private key management, making them a standard security architecture for institutional digital asset custody and shared treasury governance. The underlying cryptographic mechanism uses threshold signing schemes such as ECDSA or Schnorr aggregation."@en ;
    rdfs:subClassOf ngm:blockchain-entity ;
    vc:enables ngm:blockchain-governance,
        ngm:cold-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency-storage ;
    vc:slug "multisignature-wallets" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:bls-signature,
        ngm:cryptographic-key-management .

ngm:mutual-authentication a owl:Class ;
    rdfs:label "Mutual Authentication"@en ;
    rdfs:comment "Mutual authentication is a security process in which both parties to a communication verify each other's identity before exchanging data, rather than only one party authenticating to the other. Each participant presents and validates credentials, such as digital certificates or shared secrets, establishing bidirectional trust. This prevents impersonation in both directions and is a cornerstone of secure machine-to-machine and zero-trust communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:authentication ;
    vc:contrastsWith ngm:single-sign-on ;
    vc:dependsOn ngm:authorization,
        ngm:identity-and-access-management ;
    vc:enables ngm:secure-communication,
        ngm:trust-establishment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:access-control ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:cybersecurity ;
    vc:requires ngm:cryptographic-protocol,
        ngm:digital-certificate ;
    vc:slug "mutual-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:multi-factor-authentication,
        ngm:zero-trust-architecture ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:kerberos .

ngm:nav2 a owl:Class ;
    rdfs:label "Nav2"@en ;
    rdfs:comment "Nav2 (Navigation2) is the production-ready autonomous navigation framework for ROS 2, providing a composable, lifecycle-managed stack of planners, controllers, costmap layers, and behaviour-tree-based task orchestration. It enables mobile robots to safely compute and execute collision-free paths in structured and semi-structured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ros-2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dds-middleware ],
        ngm:navigation-stack ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:contrastsWith ngm:move-base ;
    vc:dependsOn ngm:localization,
        ngm:slam ;
    vc:enables ngm:autonomous-navigation,
        ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-mobile-robots,
        ngm:autonomous-navigation,
        ngm:robot-operating-system ;
    vc:requires ngm:dds-middleware,
        ngm:ros-2 ;
    vc:slug "nav2" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-mobile-robots,
        ngm:service-robotics,
        ngm:warehouse-robotics ;
    vc:uses ngm:behavior-tree,
        ngm:costmap,
        ngm:lidar,
        ngm:occupancy-grid .

ngm:neural-radiance-fields a owl:Class ;
    rdfs:label "Neural Radiance Fields"@en ;
    rdfs:comment "A neural rendering technique that represents 3D scenes as continuous volumetric radiance functions encoded by multilayer perceptrons, mapping 5D inputs (3D spatial position plus 2D viewing direction) to colour and volume density. Novel viewpoints are synthesised by volumetric ray marching through the learned representation, enabling photorealistic view synthesis from sparse photograph sets without explicit 3D geometry. Introduced by Mildenhall et al. (ECCV 2020), NeRF has driven a generation of implicit neural scene representations spanning telepresence, virtual production, and robotics."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:photorealistic-rendering,
        ngm:scene-capture-and-reconstruction,
        ngm:telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:3-d-content-generation,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-reconstruction,
        ngm:computer-vision,
        ngm:neural-rendering,
        ngm:point-cloud ;
    vc:slug "neural-radiance-fields" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning-discipline,
        ngm:ray-marching .

ngm:normalising-flow a owl:Class ;
    rdfs:label "Normalising Flow"@en ;
    rdfs:comment "A normalising flow is a class of deep generative models that learns a bijective mapping between a simple tractable base distribution (typically a standard multivariate Gaussian) and a complex target data distribution through a composition of invertible, differentiable transformations. Because each transformation is invertible, the change-of-variables formula yields an exact closed-form expression for the data log-likelihood, enabling both efficient sampling and precise density estimation. This exact likelihood property distinguishes normalising flows from latent variable models such as variational autoencoders and implicit models such as generative adversarial networks. Architectures are distinguished by how they design transformations whose Jacobian determinants can be computed efficiently, either through triangular Jacobians (autoregressive flows, coupling layers) or via continuous-time dynamics (neural ODEs)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        ngm:generative-model ;
    vc:bridgesTo ngm:computational-fluid-dynamics,
        ngm:scientific-computing ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:variational-autoencoder ;
    vc:enables ngm:anomaly-detection,
        ngm:data-augmentation,
        ngm:density-estimation,
        ngm:variational-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:information-theory,
        ngm:latent-variable-model,
        ngm:maximum-likelihood-estimation ;
    vc:requires ngm:change-of-variables,
        ngm:invertible-neural-network,
        ngm:probabilistic-model ;
    vc:slug "normalising-flow" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:autoregressive-model,
        ngm:jacobian-determinant,
        ngm:neural-ode .

ngm:nosql-database a owl:Class ;
    rdfs:label "NoSQL Database"@en ;
    rdfs:comment "A NoSQL database is a class of data store that departs from the rigid tabular schema and relational model of traditional SQL systems to favour flexible schemas, horizontal scalability, and high write throughput. NoSQL systems are typically organised by data model — document, key-value, wide-column, or graph — and often relax strong consistency in exchange for availability and partition tolerance. They are designed for large-scale, distributed workloads where the relational model is a poor fit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-series-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:replication ],
        ngm:database-management-system ;
    vc:contrastsWith ngm:relational-database ;
    vc:dependsOn ngm:cap-theorem ;
    vc:enables ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:document-database,
        ngm:key-value-store,
        ngm:time-series-database ;
    vc:isPartOf ngm:database-management-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:eventual-consistency ;
    vc:requires ngm:replication ;
    vc:slug "nosql-database" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:high-availability,
        ngm:scalability ;
    vc:uses ngm:eventual-consistency,
        ngm:sharding .

ngm:number-theory a owl:Class ;
    rdfs:label "Number Theory"@en ;
    rdfs:comment "Number Theory is the branch of pure mathematics concerned with the properties of integers and related structures, including divisibility, prime numbers, congruences and Diophantine equations. It ranges from elementary results, such as the fundamental theorem of arithmetic, to deep areas like analytic and algebraic number theory. Beyond its theoretical importance, it underpins much of modern cryptography, where the difficulty of certain number-theoretic problems provides security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:modular-arithmetic ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain,
        ngm:machine-learning,
        ngm:security ;
    vc:contrastsWith ngm:applied-mathematics ;
    vc:enables ngm:cryptography,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:public-key-cryptography ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:modular-arithmetic ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:elliptic-curve-cryptography,
        ngm:group-theory,
        ngm:measure-theory ;
    vc:requires ngm:discrete-mathematics,
        ngm:linear-algebra ;
    vc:slug "number-theory" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:homomorphic-encryption,
        ngm:post-quantum-cryptography,
        ngm:zero-knowledge-proof .

ngm:observation-model a owl:Class ;
    rdfs:label "Observation Model"@en ;
    rdfs:comment "An observation model (or measurement model) is the probabilistic relationship that specifies the likelihood of a sensor measurement given the underlying state of a system. In recursive Bayesian estimation it provides the likelihood term used to correct a predicted state belief against incoming data. Its accuracy, including the noise characteristics it encodes, directly governs the quality of state estimation."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:particle-filter ;
    vc:slug "observation-model" ;
    vc:sourceDomain "robotics" .

ngm:online-learning a owl:Class ;
    rdfs:label "Online Learning"@en ;
    rdfs:comment "Online Learning is a artificial intelligence concept and a type of Machine Learning. that enables Real-Time Learning."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning-discipline ;
    skos:broader ngm:ai-technique ;
