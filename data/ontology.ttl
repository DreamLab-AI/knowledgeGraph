ngm:liquid-network a owl:Class ;
    rdfs:label "Liquid Network"@en ;
    rdfs:comment "The Liquid Network is a Bitcoin sidechain developed by Blockstream that provides faster settlement and confidential transactions for exchanges, traders and institutions. Bitcoin is moved onto the network by locking it on the main chain and issuing an equivalent pegged asset, Liquid Bitcoin, which can later be redeemed. The network is operated by a federation of functionaries who produce blocks and manage the peg, trading some decentralisation for performance and privacy features."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:two-way-peg ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:digital-asset,
        ngm:exchange-infrastructure,
        ngm:institutional-finance ;
    vc:contrastsWith ngm:bitcoin-proof-of-work-protocol-lightning-network,
        ngm:rollup ;
    vc:enables ngm:asset-issuance,
        ngm:confidential-transactions,
        ngm:real-time-settlement,
        ngm:security-token,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:confidential-transactions,
        ngm:sidechain ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-layer-2 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockstream,
        ngm:peg-mechanism,
        ngm:transaction-privacy ;
    vc:requires ngm:bitcoin-proof-of-work-protocol,
        ngm:federation,
        ngm:functionary,
        ngm:two-way-peg ;
    vc:slug "liquid-network" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elements-project,
        ngm:multisig .

ngm:live-streaming a owl:Class ;
    rdfs:label "Live Streaming"@en ;
    rdfs:comment "Live Streaming is the real-time delivery of audio and video over a network as the content is captured, allowing audiences to view events with minimal delay rather than after recording. It relies on continuous encoding, packetisation, and adaptive distribution through content delivery networks to reach large, geographically dispersed audiences. Live streaming trades the buffering headroom of on-demand playback for low end-to-end latency, demanding careful management of bitrate adaptation, jitter, and edge caching."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:low-latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:video-streaming ;
    vc:contrastsWith ngm:video-streaming ;
    vc:dependsOn ngm:bandwidth ;
    vc:enables ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bandwidth,
        ngm:network-protocol ;
    vc:isPartOf ngm:content-delivery,
        ngm:video-streaming ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:content-delivery,
        ngm:network-protocol ;
    vc:requires ngm:content-delivery-network,
        ngm:low-latency ;
    vc:slug "live-streaming" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:real-time-communication ;
    vc:uses ngm:cdn,
        ngm:edge-computing .

ngm:llm-agents a owl:Class ;
    rdfs:label "LLM Agents"@en ;
    rdfs:comment "LLM Agents are autonomous software systems that use large language models as their core reasoning engine to perceive inputs, plan multi-step actions, invoke external tools, and pursue goals over extended horizons with minimal per-step human oversight. They extend base language models with memory, tool use, and feedback loops to accomplish tasks that require sequential decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:function-calling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-memory ],
        ngm:agentic-ai ;
    vc:bridgesTo ngm:enterprise-software-integration,
        ngm:robotic-autonomous-systems ;
    vc:contrastsWith ngm:robotic-process-automation,
        ngm:single-turn-inference ;
    vc:dependsOn ngm:instruction-following,
        ngm:prompt-engineering ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-task-execution,
        ngm:multi-agent-system,
        ngm:process-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:plan-and-execute,
