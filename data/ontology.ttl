ngm:threshold-selection a owl:Class ;
    rdfs:comment "Threshold selection is the process of choosing the decision boundary that converts a classifier's continuous scores or probabilities into discrete class labels. The chosen threshold trades off competing error types, moving along the trade-off captured by the ROC and precision-recall curves. Appropriate selection depends on the relative costs of false positives and false negatives and on class prevalence in the deployment setting."@en ;
    rdfs:label "Threshold Selection"@en ;
    rdfs:subClassOf ngm:ai-technique ;
    rdfs:subClassOf ngm:model-evaluation ;
