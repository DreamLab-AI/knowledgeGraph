ngm:optical-calibration-target a owl:Class ;
    rdfs:label "Optical Calibration Target"@en ;
    rdfs:comment "An optical calibration target is a precision artefact bearing known geometric, radiometric, or colourimetric reference patterns used to characterise, correct, and validate the response of imaging and optical systems. Such targets enable the measurement of lens distortion, modulation transfer function (MTF), chromatic aberration, colour reproduction accuracy, and spatial linearity across a wide range of imaging modalities from visible-light cameras to multispectral and depth sensors. They are fundamental to the metrological traceability chain that links deployed camera systems to national and international measurement standards. In spatial computing and extended-reality applications, calibration targets additionally serve as fiducial references for camera-to-camera alignment, display-sensor registration, and world-space coordinate grounding."@en ;
    rdfs:subClassOf ngm:calibration-equipment ;
    vc:bridgesTo ngm:neural-radiance-field,
        ngm:simultaneous-localisation-and-mapping ;
    vc:contrastsWith ngm:radiometric-calibration-panel ;
    vc:dependsOn ngm:photometric-standards,
        ngm:substrate-material-stability ;
    vc:enables ngm:camera-intrinsic-calibration,
        ngm:colour-management,
        ngm:lens-distortion-correction,
        ngm:optical-system-accuracy,
        ngm:stereo-camera-calibration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:color-reference-chart,
        ngm:fiducial-marker,
        ngm:gray-scale-step-wedge,
        ngm:resolution-target ;
    vc:isPartOf ngm:camera-calibration-workflow ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:depth-sensor-calibration,
        ngm:icc-colour-profile,
        ngm:modulation-transfer-function ;
    vc:requires ngm:controlled-illumination,
        ngm:metrological-traceability ;
    vc:slug "optical-calibration-target" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-12233,
        ngm:iso-17321,
        ngm:nist-measurement-standards ;
    vc:supports ngm:augmented-reality-tracking,
        ngm:computer-vision-pipeline,
        ngm:machine-vision-inspection,
        ngm:photogrammetry ;
    vc:uses ngm:aruco-marker,
        ngm:checkerboard-pattern,
        ngm:sinusoidal-grating .

ngm:optimism-collective a owl:Class ;
    rdfs:label "Optimism Collective"@en ;
    rdfs:comment "The Optimism Collective is a two-house governance body overseeing the Optimism ecosystem — a suite of Ethereum Layer 2 networks built on the OP Stack rollup technology — consisting of the Token House (OP token holders who vote on protocol upgrades and treasury allocations) and the Citizens' House (non-transferable badge holders who allocate Retroactive Public Goods Funding). It represents one of the most sophisticated real-world experiments in bicameral on-chain governance, designed to balance token-weighted economic interests with broader societal value creation and public goods provision."@en ;
    rdfs:subClassOf ngm:dao-governance ;
    vc:enables ngm:dao,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-decision-making,
        ngm:governance-token,
        ngm:layer-2-scaling,
        ngm:on-chain-governance ;
    vc:slug "optimism-collective" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-governance,
        ngm:voting-mechanism .

ngm:orchestration-layer a owl:Class ;
    rdfs:label "Orchestration Layer"@en ;
    rdfs:comment "An Orchestration Layer is a software architectural component that coordinates the execution of heterogeneous services, agents, or microservices — managing task routing, dependency resolution, resource allocation, and fault recovery — to produce coherent outputs from distributed system components. It acts as the control plane above individual execution units, abstracting their composition into unified workflows."@en ;
    rdfs:subClassOf ngm:orchestration ;
    vc:enables ngm:llm-orchestration,
        ngm:multi-agent-orchestration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:service-mesh ;
    vc:slug "orchestration-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:kubernetes,
        ngm:microservices,
        ngm:middleware-layer .

ngm:payment-channel-network a owl:Class ;
    rdfs:label "Payment Channel Network"@en ;
    rdfs:comment "A Payment Channel Network is a layer-2 scaling architecture in which participants open bilateral payment channels and route payments across a graph of connected channels without settling each transaction on the underlying blockchain. Funds are locked in multisignature channels, and balances update off-chain through signed state, with only channel opening and closing recorded on-chain. This enables high-throughput, low-fee, near-instant payments while inheriting base-layer security."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "payment-channel-network" ;
    vc:sourceDomain "blockchain" .

ngm:pbft a owl:Class ;
    rdfs:label "PBFT"@en ;
    rdfs:comment "Practical Byzantine Fault Tolerance (PBFT) is a state-machine replication protocol designed by Castro and Liskov (1999) that achieves consensus in asynchronous distributed systems despite up to f arbitrarily faulty (Byzantine) nodes, requiring a total of at least 3f+1 replicas. It proceeds through pre-prepare, prepare, and commit phases to ensure all correct replicas execute the same sequence of operations, providing both safety and liveness under partial synchrony assumptions. PBFT was the first Byzantine fault-tolerant protocol deemed practical for deployed systems, with latency polynomial rather than exponential in the number of nodes. Its communication complexity of O(n²) limits scalability but makes it highly suitable for small-to-medium permissioned blockchain networks."@en ;
    rdfs:subClassOf ngm:byzantine-fault-tolerance ;
    vc:bridgesTo ngm:enterprise-blockchain,
        ngm:hyperledger-fabric ;
    vc:contrastsWith ngm:crash-fault-tolerance,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-infrastructure,
        ngm:deterministic-finality,
        ngm:distributed-ledger-technology,
        ngm:permissioned-blockchain,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-agreement,
        ngm:total-order-broadcast ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bc-protocol-and-consensus,
        ngm:consensus-mechanism,
        ngm:dynamic-scalable-bft,
        ngm:hotstuff,
        ngm:tendermint ;
    vc:requires ngm:authenticated-communication,
        ngm:partial-synchrony,
        ngm:public-key-infrastructure ;
    vc:slug "pbft" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:bc-cryptographic-primitive,
        ngm:consensus-protocol,
        ngm:distributed-system,
        ngm:message-authentication-code,
        ngm:quorum-system,
        ngm:view-change-protocol .

ngm:pci-dss a skos:Concept ;
