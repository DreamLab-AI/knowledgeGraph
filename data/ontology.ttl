    vc:slug "aisi-frontier-ai-safety-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-regulation,
        ngm:ai-safety ;
    vc:uses ngm:adversarial-testing,
        ngm:model-evaluation,
        ngm:red-teaming .

ngm:allo-protocol a owl:Class ;
