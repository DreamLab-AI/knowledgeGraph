        ngm:peer-discovery ;
    vc:slug "gossip-protocol" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain-network,
        ngm:distributed-hash-table ;
    vc:uses ngm:network-component,
        ngm:probabilistic-broadcast .

ngm:high-performance-computing a owl:Class ;
    rdfs:label "High-Performance Computing"@en ;
    rdfs:comment "High-Performance Computing (HPC) refers to the use of aggregated computational resources — clusters, supercomputers, and massively parallel systems — to solve problems requiring sustained compute throughput, memory bandwidth, or I/O rates far beyond those achievable on commodity servers. HPC systems combine specialised processors (CPUs, GPUs, FPGAs, TPUs), high-speed interconnects (InfiniBand, NVLink), parallel file systems, and workload-management software to execute scientific simulations, large-scale machine learning training, genomics, climate modelling, and computational fluid dynamics at peta- or exascale performance."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:computing-hardware ;
    vc:enables ngm:blockchain-analytics,
        ngm:deep-learning,
        ngm:machine-learning-discipline-infrastructure,
        ngm:neur-ips ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-hardware,
        ngm:ai-infrastructure,
        ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:edge-computing ;
    vc:slug "high-performance-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:batch-processing,
        ngm:cuda,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:parallel-processing,
        ngm:tpu .

ngm:neural-rendering a owl:Class ;
    rdfs:label "Neural Rendering"@en ;
    rdfs:comment "Neural Rendering is a class of computational techniques that train deep neural networks to represent, reconstruct, and synthesise visual appearance of 3D scenes, replacing or augmenting traditional rasterisation and ray-tracing pipelines with learned implicit representations. Methods such as Neural Radiance Fields (NeRF), Gaussian Splatting, and neural texture synthesis encode scene geometry, material properties, and illumination into network weights, enabling photo-realistic novel view synthesis from sparse image sets. Neural Rendering bridges computer vision and computer graphics, enabling real-time rendering of photorealistic avatars, 3D asset generation, scene understanding, and immersive spatial experiences at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gaussian-splatting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:computer-vision,
        ngm:digital-twin,
        ngm:generative-ai ;
    vc:contrastsWith ngm:rasterisation,
        ngm:ray-tracing ;
    vc:dependsOn ngm:gradient-descent,
        ngm:ray-marching ;
    vc:enables ngm:3-d-reconstruction,
        ngm:immersive-environment,
        ngm:novel-view-synthesis,
        ngm:photorealistic-avatar,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gaussian-splatting,
        ngm:neural-scene-representation,
        ngm:neural-texture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:light-field-imaging,
        ngm:point-cloud,
        ngm:scene-understanding ;
    vc:requires ngm:graphics-processing-unit,
        ngm:implicit-neural-representation,
        ngm:multi-view-imaging ;
    vc:slug "neural-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:differentiable-rendering,
        ngm:neural-radiance-field,
        ngm:volume-rendering .

ngm:robot-operating-system a owl:Class ;
