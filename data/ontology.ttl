ngm:metaverse-infrastructure a owl:Class ;
    rdfs:label "Metaverse Infrastructure"@en ;
    rdfs:comment "Technical infrastructure supporting persistent, large-scale metaverse platforms, encompassing the networking, cloud compute, edge nodes, rendering servers, and spatial data systems required to deliver low-latency immersive experiences at scale. It spans connectivity layers (5G, content delivery), server-side rendering and simulation, asset storage, and identity services that together underpin interoperable virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:5-g-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:low-latency-networking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:networking-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-infrastructure,
        ngm:decentralised-storage ;
    vc:dependsOn ngm:cloud-computing,
        ngm:internet-infrastructure ;
    vc:enables ngm:avatar-system,
        ngm:immersive-experience,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cloud-rendering,
        ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:networking-infrastructure,
        ngm:virtual-world-infrastructure ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:metaverse-architecture,
        ngm:remote-rendering,
        ngm:spatial-computing ;
    vc:requires ngm:5-g-network,
        ngm:distributed-computing,
        ngm:low-latency-networking ;
    vc:slug "metaverse-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:supports ngm:extended-reality,
        ngm:metaverse,
        ngm:metaverse-platform,
        ngm:virtual-world ;
    vc:uses ngm:open-xr,
        ngm:web-xr .

ngm:metaverse-standards-forum a owl:Class ;
    rdfs:label "Metaverse Standards Forum"@en ;
    rdfs:comment "The Metaverse Standards Forum (MSF) is an industry consortium hosted by the Khronos Group, founded in June 2022, that coordinates existing standards-development organisations to promote interoperability across metaverse and spatial-computing platforms rather than authoring competing specifications. With several hundred member organisations — including Meta, Microsoft, NVIDIA, Sony, Epic Games, the W3C, and ISO — it operates domain-specific working groups that identify interoperability gaps and produce exploratory prototypes whose outputs feed back into recognised bodies for normative ratification. Its model of pre-competitive alignment distinguishes it from traditional specification-writing bodies: it acts as a coordination layer, convening the standards ecosystem to prevent the fragmentation that would result from proprietary, siloed virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-stakeholder-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-group ],
        ngm:standards-body ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:web3 ;
    vc:contrastsWith ngm:closed-platform,
        ngm:proprietary-ecosystem ;
    vc:dependsOn ngm:khronos-group,
        ngm:w3-c ;
    vc:enables ngm:cross-platform-avatar,
        ngm:digital-twin,
        ngm:interoperability,
        ngm:open-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:interoperability-prototype,
        ngm:working-group ;
    vc:implements ngm:coordination-layer ;
    vc:isPartOf ngm:open-standards ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:3d-asset-interchange,
        ngm:digital-fashion,
        ngm:technical-standard,
        ngm:web-standard ;
    vc:requires ngm:multi-stakeholder-governance,
        ngm:technical-consensus ;
    vc:slug "metaverse-standards-forum" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
        ngm:iso ;
    vc:supports ngm:decentralised-identity,
        ngm:extended-reality,
        ngm:spatial-computing,
        ngm:virtual-world ;
    vc:uses ngm:gltf-standard,
        ngm:open-xr,
        ngm:usd,
        ngm:web-xr .

ngm:monetary-sovereignty a owl:Class ;
    rdfs:label "Monetary Sovereignty"@en ;
    rdfs:comment "A nation's authority to control its monetary policy, currency issuance, and financial systems, increasingly challenged by decentralised digital currencies and defended through initiatives like Central Bank Digital Currencies (CBDCs) that assert state control over the evolving digital economy."@en ;
