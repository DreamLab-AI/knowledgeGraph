ngm:cloud-security a owl:Class ;
    rdfs:comment "Cloud security is the discipline of protecting data, applications, identities and infrastructure hosted in cloud computing environments against unauthorised access, misconfiguration, data loss and service disruption. It applies controls across the shared-responsibility boundary between cloud providers and customers, spanning identity and access management, encryption, network segmentation, configuration governance and continuous monitoring. Cloud security extends established information-security principles to elastic, multi-tenant and API-driven platforms where infrastructure is provisioned programmatically."@en ;
    rdfs:label "Cloud Security"@en ;
    rdfs:subClassOf ngm:security ;
    rdfs:subClassOf _:r4465 ;
