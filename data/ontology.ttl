        ngm:patent,
        ngm:research-and-development ;
    vc:requires ngm:patent,
        ngm:research-and-development ;
    vc:slug "technology-transfer" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:knowledge-transfer ;
    vc:uses ngm:licensing .

ngm:testing a owl:Class ;
    rdfs:label "Testing"@en ;
    rdfs:comment "Testing is the software-engineering practice of verifying that a system behaves as specified and detecting defects by executing it against defined inputs and checking the outputs. It spans levels from unit and integration to system and acceptance testing, and styles from manual to fully automated. Systematic testing is a primary mechanism for establishing software reliability and guarding against regressions."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:reliability,
        ngm:software-engineering ;
    vc:slug "testing" ;
    vc:sourceDomain "infrastructure" .

ngm:time-series-analysis a owl:Class ;
    rdfs:label "Time-Series Analysis"@en ;
    rdfs:comment "Time-series analysis is the statistical and computational study of data sequences indexed by time, encompassing methods for decomposition, modelling, forecasting, and anomaly detection of temporal patterns including trend, seasonality, and autocorrelation structures. Foundational techniques include ARIMA, exponential smoothing, spectral analysis, and state-space models, with deep learning approaches such as transformers and N-BEATS increasingly dominant in practice."@en ;
    rdfs:subClassOf ngm:data-analysis ;
    vc:bridgesTo ngm:signal-processing ;
    vc:enables ngm:anomaly-detection,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:markov-chain-monte-carlo,
        ngm:prediction-markets ;
    vc:slug "time-series-analysis" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bayesian-inference,
        ngm:probabilistic-model .

ngm:token-embedding a owl:Class ;
    rdfs:label "Token Embedding"@en ;
    rdfs:comment "A learnable lookup table that maps each discrete token in a vocabulary to a dense continuous vector, providing the initial semantic encoding fed into transformer model layers. Embeddings are trained end-to-end and combined with positional encodings; they may be tied with the output un-embedding matrix to reduce parameter count and improve training stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:retrieval-augmented-generation,
        ngm:vector-database ;
    vc:contrastsWith ngm:one-hot-encoding,
        ngm:positional-encoding ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:natural-language-processing,
        ngm:semantic-search,
        ngm:text-classification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:vocabulary ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:large-language-model,
        ngm:transformer ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:contextual-embedding,
        ngm:hidden-state,
        ngm:neural-network-layer,
        ngm:self-attention ;
    vc:requires ngm:tokenization,
