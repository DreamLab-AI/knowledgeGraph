    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:horizontal-scalability,
        ngm:zero-downtime-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:health-check ;
    vc:implements ngm:consistent-hashing,
        ngm:round-robin-scheduling ;
    vc:isPartOf ngm:distributed-architecture,
        ngm:service-mesh ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:auto-scaling,
        ngm:traffic-management ;
    vc:requires ngm:health-monitoring,
        ngm:network-infrastructure ;
    vc:slug "load-balancing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:content-delivery-network,
        ngm:microservices-architecture ;
    vc:uses ngm:session-persistence,
        ngm:ssl-termination .

ngm:open-source-software a owl:Class ;
    rdfs:label "Open Source Software"@en ;
    rdfs:comment "Open Source Software (OSS) is software distributed with source code made publicly available under a licence that grants users the rights to inspect, modify, and redistribute the software and its derivatives. OSS development follows collaborative models coordinated through version-controlled repositories, issue trackers, and community governance structures, enabling distributed contribution at global scale. Canonical licence categories range from permissive instruments (MIT, Apache 2.0, BSD) to copyleft instruments (GPL, LGPL, AGPL) that impose viral redistribution obligations. In the AI, spatial-computing, and broader technology infrastructure landscape, OSS underpins foundational frameworks — including deep learning toolkits, container runtimes, distributed databases, and interoperability specifications — reducing vendor lock-in and accelerating innovation through transparent, auditable codebases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-source-licence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-licence-instrument ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning,
        ngm:smart-contract ;
    vc:contrastsWith ngm:closed-source-software,
        ngm:proprietary-software ;
    vc:enables ngm:community-driven-innovation,
        ngm:distributed-collaboration,
        ngm:open-source-ai,
        ngm:reproducible-research,
        ngm:software-supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:community-governance,
        ngm:open-source-licence,
        ngm:software-repository ;
    vc:implements ngm:open-source-definition,
        ngm:open-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:free-software-movement,
        ngm:inner-source,
        ngm:software-commons ;
    vc:requires ngm:intellectual-property-licence-instrument,
        ngm:version-control ;
    vc:slug "open-source-software" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-source-initiative ;
    vc:supports ngm:decentralised-governance,
        ngm:digital-public-goods,
        ngm:open-source-framework ;
    vc:uses ngm:continuous-integration,
        ngm:package-manager,
        ngm:software-library .

ngm:recurrent-neural-network a owl:Class ;
    rdfs:label "Recurrent Neural Network"@en ;
    rdfs:comment "A neural network architecture that processes sequential data by maintaining a hidden state across time steps, allowing information from earlier inputs to influence later outputs. Key variants include Long Short-Term Memory networks and Gated Recurrent Units, which address vanishing gradient problems and underpin sequence modelling tasks such as speech recognition, language modelling, and time-series forecasting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-clipping ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:long-short-term-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder-decoder-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hidden-state ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:neuromorphic-computing,
        ngm:speech-recognition ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:feedforward-neural-network,
        ngm:transformer ;
    vc:dependsOn ngm:gradient-descent,
        ngm:loss-function,
        ngm:sequential-data ;
    vc:enables ngm:automatic-speech-recognition,
        ngm:language-modeling,
        ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cell-state,
        ngm:encoder-decoder-architecture,
        ngm:gated-recurrent-unit,
        ngm:hidden-state,
        ngm:long-short-term-memory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:deep-learning,
        ngm:state-space-model,
        ngm:teacher-forcing,
        ngm:vanishing-gradient-problem ;
    vc:requires ngm:activation-function,
        ngm:backpropagation-through-time,
        ngm:gradient-clipping ;
    vc:slug "recurrent-neural-network" ;
    vc:sourceDomain "machine-learning" .

ngm:regulation a owl:Class ;
    rdfs:label "Regulation"@en ;
    rdfs:comment "Regulation is the systematic use of authoritative rules, standards, and enforcement mechanisms by governments, inter-governmental bodies, or designated agencies to direct, constrain, or oversee the conduct of individuals, organisations, and systems within a defined domain. It encompasses the full lifecycle from rule-making and publication through monitoring, inspection, and sanctioning of non-compliance. Regulation is distinct from voluntary standards in that it carries legal force and can result in penalties, licence revocation, or other coercive consequences for non-conformance. In technical domains such as AI, data systems, and critical infrastructure, regulation increasingly intersects with algorithmic accountability, risk classification, and mandatory transparency obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervisory-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-frameworks ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:data-sovereignty ;
    vc:contrastsWith ngm:deregulation,
        ngm:self-regulation ;
    vc:dependsOn ngm:standards ;
    vc:enables ngm:consumer-protection,
        ngm:market-integrity,
        ngm:systemic-risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:regulatory-frameworks,
        ngm:supervisory-authority ;
    vc:implements ngm:policy ;
    vc:isPartOf ngm:governance,
        ngm:public-policy ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:certification,
        ngm:licensing ;
    vc:requires ngm:accountability,
        ngm:compliance,
        ngm:transparency ;
    vc:slug "regulation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-protection,
        ngm:safety ;
    vc:uses ngm:impact-assessment,
        ngm:risk-assessment .

ngm:ai-governance-framework a owl:Class ;
    rdfs:label "AI Governance Framework"@en ;
    rdfs:comment "Set of policies and procedures ensuring responsible development and operation of AI components in the metaverse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
