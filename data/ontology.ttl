    vc:sourceDomain "blockchain" .

ngm:crypto-legal-from-digi-soc a owl:Class ;
    rdfs:label "Crypto Legal from DigiSoc"@en ;
    rdfs:comment "Crypto Legal from DigiSoc examines the legal, regulatory, and governance landscape surrounding cryptocurrency and digital assets within digital society contexts. It covers UK and EU regulatory positions on crypto-assets as property, stablecoin frameworks, AML/KYC obligations, and the intersection of Web3 economics with metaverse commerce. The field addresses how legacy legal systems must adapt to support low-friction, globally scalable value exchange in virtual social spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
