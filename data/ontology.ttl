ngm:virscapes a owl:Class ;
    rdfs:label "Virscapes"@en ;
    rdfs:comment "Virscapes are AI-generated virtual landscape images produced by training generative adversarial networks (StyleGAN) on a curated dataset of digital game landscapes collected over seven years, exploring latent space to create emotionally resonant synthetic environments. The practice investigates questions of landscape identity, simulacra, and the distinction between human aesthetic curation and algorithmic generation in digital art."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:procedural-generation,
        ngm:virtual-reality ;
    vc:slug "virscapes" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:generative-ai,
        ngm:machine-learning .

ngm:virtual-city-model a owl:Class ;
    rdfs:label "Virtual City Model"@en ;
    rdfs:comment "A digital representation of an urban environment including buildings, infrastructure, terrain, and dynamic elements, used for urban planning, simulation, gaming, and metaverse world-building based on real or imagined cities. Data standards such as CityGML (OGC), 3D Tiles, and BIM/IFC underpin interoperable city model exchange, while capture techniques including LiDAR scanning and photogrammetry feed real-world geometry into the model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:digital-twin,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin-technology,
        ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering ;
    vc:slug "virtual-city-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:uses ngm:lidar,
        ngm:photogrammetry .

ngm:virtual-environment-connectivity a owl:Class ;
    rdfs:label "Virtual Environment Connectivity"@en ;
    rdfs:comment "The networking technologies and protocols that enable seamless communication, data synchronisation, and user interaction across distributed virtual environments, including real-time streaming, peer-to-peer networks, and cross-platform interoperability systems. Achieving sub-20ms latency for VR experiences requires a combination of 5G/6G mobile networks, edge computing, WebRTC for browser-to-browser communication, and software-defined networking for traffic management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:network-infrastructure,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-platform,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:edge-computing,
        ngm:network-infrastructure ;
    vc:slug "virtual-environment-connectivity" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:uses ngm:encryption .

ngm:virtual-group-dynamics a owl:Class ;
    rdfs:label "Virtual Group Dynamics"@en ;
    rdfs:comment "The psychological and behavioural patterns of interaction, role formation, norm development, decision-making, conflict, and cohesion within groups operating in virtual environments, shaped by unique affordances of digital mediation such as anonymity, persistence, and spatial distribution. Key phenomena include the online disinhibition effect, avatar-mediated identity, emergent leadership hierarchies, and scalable broadcast communication structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:proteus-effect,
        ngm:social-presence ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "virtual-group-dynamics" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-interaction-logging a owl:Class ;
    rdfs:label "Virtual Interaction Logging"@en ;
    rdfs:comment "The systematic recording and analysis of user interactions, behaviours, and activities within virtual environments, capturing data on avatar movements, communications, transactions, and engagement patterns for analytics, compliance, and experience optimisation. Logging pipelines must balance comprehensive telemetry collection with data minimisation, user consent, and retention policies required under privacy regulations such as GDPR."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        ngm:data-analytics,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:compliance-framework,
        ngm:data-analytics ;
    vc:hasMaturity ngmi:maturity-emerging ;
