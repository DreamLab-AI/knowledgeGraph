    vc:requires ngm:activity-streams-vocabulary,
        ngm:event-schemas,
        ngm:json-ld-1-1,
        ngm:web-socket-support ;
    vc:slug "agent-event-stream" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-augmented-software-engineering a owl:Class ;
    rdfs:label "AI-Augmented Software Engineering"@en ;
    rdfs:comment "AI-Augmented Software Engineering is the practice of integrating artificial intelligence tools and techniques — including large language models, code generation systems, and agentic AI — into the software development lifecycle to accelerate coding, testing, review, and deployment. It encompasses AI-assisted code completion, automated test generation, intelligent refactoring, and documentation synthesis, transforming how software teams design, build, and maintain systems at scale."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:rapid-ai-deployment,
        ngm:software-development-process,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:software-architecture,
        ngm:software-engineering,
        ngm:software-testing ;
    vc:slug "ai-augmented-software-engineering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agentic-ai,
        ngm:code-generation,
        ngm:large-language-models .

ngm:ai-inference a owl:Class ;
    rdfs:label "AI Inference"@en ;
    rdfs:comment "AI Inference is the operational phase of a machine learning system in which a trained model processes new input data to generate predictions, classifications, embeddings, or generative outputs — as distinct from the training phase in which model parameters are optimised. It is the production-time workload that determines the latency, throughput, cost, and scalability characteristics experienced by end users and downstream systems."@en ;
    rdfs:subClassOf ngm:ai-machine-learning ;
    vc:enables ngm:generative-ai,
        ngm:real-time-ai-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing ;
    vc:slug "ai-inference" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:ai-model,
        ngm:ai-model-architecture,
        ngm:gpu-acceleration .

ngm:ai-monitoring a owl:Class ;
    rdfs:label "AI Monitoring"@en ;
    rdfs:comment "The systematic and ongoing observation, measurement, and analysis of an artificial intelligence system's behaviour, performance, inputs, outputs, and impacts during operational use, employing automated tools and human oversight to detect degradation, anomalies, bias, safety issues, or unintended ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring-infrastructure ],
