# Stewart Platform
rb:StewartPlatform a owl:Class ;
    rdfs:subClassOf rb:ParallelRobot ;
    rdfs:label "Stewart Platform"@en ;
    rdfs:comment "Stewart platform uses six prismatic actuators attached in pairs to baseplate and top plate via universal joints."@en ;
