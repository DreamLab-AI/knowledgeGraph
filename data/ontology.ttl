ngm:mempool a owl:Class ;
    rdfs:label "Mempool"@en ;
    rdfs:comment "The memory pool maintained by each blockchain node holding broadcast but as-yet unconfirmed transactions awaiting inclusion in a block. Miners select transactions from the mempool, typically prioritising by fee rate, while node operators use mempool policies to manage capacity and mitigate spam."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-pool ],
        ngm:distributed-data-structure ;
    vc:bridgesTo ngm:decentralised-exchange,
        ngm:layer-2-protocol ;
    vc:contrastsWith ngm:block,
        ngm:confirmed-transaction ;
    vc:dependsOn ngm:digital-signature,
        ngm:transaction-validation ;
    vc:enables ngm:block-production,
        ngm:fee-estimation,
        ngm:transaction-confirmation,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:transaction,
        ngm:transaction-pool,
        ngm:unconfirmed-transaction ;
    vc:implements ngm:child-pays-for-parent,
        ngm:replace-by-fee ;
    vc:isPartOf ngm:blockchain-node,
        ngm:peer-to-peer-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:blockchain-transaction,
        ngm:double-spend,
