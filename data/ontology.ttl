    vc:slug "ontology-property-definitions" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:robotics .

ngm:open-id4-vci a owl:Class ;
    rdfs:label "OpenID4VCI"@en ;
    rdfs:comment "OpenID for Verifiable Credential Issuance (OpenID4VCI) is an OpenID Foundation protocol specification that defines a standard API by which an Issuer can deliver W3C Verifiable Credentials to a Holder's digital wallet using OAuth 2.0 and OpenID Connect as the underlying authorisation and identity layer. The protocol specifies credential offer flows, authorisation code and pre-authorised code grant types, credential endpoint interactions, and metadata discovery, enabling interoperable credential issuance across identity wallet implementations and issuing authority systems. It is designed to complement OpenID4VP (Verifiable Presentations) to form a complete self-sovereign identity exchange ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer-security ],
        ngm:credential-issuance ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:governance ;
    vc:contrastsWith ngm:didcomm ;
    vc:enables ngm:credential-verification,
        ngm:decentralized-identity,
        ngm:digital-identity-wallet,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:authorization-code-flow,
        ngm:credential-format-standard ;
    vc:isPartOf ngm:self-sovereign-identity ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:open-id4-vp ;
    vc:requires ngm:credential-issuer-metadata,
        ngm:decentralized-identifier,
        ngm:transport-layer-security ;
    vc:slug "open-id4-vci" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:open-id-foundation ;
    vc:supports ngm:e-idas-2-0,
        ngm:eudi-wallet,
        ngm:iso-mdoc ;
    vc:uses ngm:json-data-interchange-format-web-token,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:public-key-infrastructure,
        ngm:sd-jwt,
        ngm:verifiable-credentials .

ngm:open-id4-vp a owl:Class ;
    rdfs:label "OpenID4VP"@en ;
    rdfs:comment "OpenID for Verifiable Presentations (OpenID4VP) is an extension of the OpenID Connect and OAuth 2.0 framework that enables relying parties to request and receive W3C Verifiable Presentations from a holder's digital identity wallet using standard authorisation request-response flows. The specification defines a Presentation Exchange-compatible request syntax, transport bindings for cross-device and same-device wallets, and response encoding options for signed JWT VPs and JSON-LD credential formats. OpenID4VP allows verifiers to specify which credential types and claims are required, enabling selective disclosure and privacy-preserving identity verification without centralised identity providers holding user data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        ngm:open-id-connect ;
    vc:bridgesTo ngm:decentralized-identifier,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:saml ;
    vc:enables ngm:cross-platform-authentication,
        ngm:decentralized-identity,
        ngm:holder-binding,
        ngm:privacy-preserving-authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:self-sovereign-identity,
        ngm:w-3-c-verifiable-credentials-data-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:e-idas-2-0,
        ngm:open-id4-vci,
        ngm:w3-c-verifiable-credentials ;
    vc:requires ngm:cryptographic-signature,
        ngm:public-key-infrastructure ;
    vc:slug "open-id4-vp" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:open-id-foundation ;
    vc:supports ngm:eudi-wallet,
        ngm:iso-iec-18013-5-m-dl,
        ngm:selective-disclosure ;
    vc:uses ngm:digital-identity-wallet,
        ngm:json-data-interchange-format-ld,
        ngm:oauth-2-0,
        ngm:presentation-exchange,
        ngm:sd-jwt,
        ngm:verifiable-credentials .

ngm:open-lineage a owl:Class ;
    rdfs:label "OpenLineage"@en ;
    rdfs:comment "OpenLineage is an open standard and specification for collecting data-lineage metadata from data pipelines as they run. It defines a common event model describing jobs, runs, datasets, and their input/output relationships, emitted by instrumented orchestration and processing tools. This enables consistent tracking of how data is produced and transformed across heterogeneous platforms for governance, debugging, and impact analysis."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "open-lineage" ;
    vc:sourceDomain "data" .

ngm:open-metaverse a owl:Class ;
    rdfs:label "Open Metaverse"@en ;
    rdfs:comment "The open metaverse is a vision of interconnected virtual worlds built on open standards, interoperable formats, and user-owned assets and identity, in contrast to closed, single-vendor platforms. It emphasises portability of avatars, content, and value across experiences, decentralised ownership, and protocols rather than walled gardens. The open metaverse depends on shared standards for 3D assets, identity, and interoperability so that participation is not locked to any one provider."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:metaverse ;
    vc:bridgesTo ngm:blockchain,
        ngm:nft ;
    vc:contrastsWith ngm:proprietary-format,
        ngm:vendor-lock-in ;
    vc:dependsOn ngm:decentralisation ;
    vc:enables ngm:asset-portability,
        ngm:creator-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing,
        ngm:virtual-world ;
    vc:requires ngm:interoperability,
        ngm:open-standard ;
    vc:slug "open-metaverse" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:avatar,
        ngm:digital-asset ;
    vc:uses ngm:open-protocol,
        ngm:usd .

ngm:open-source-framework a owl:Class ;
    rdfs:label "Open Source Framework"@en ;
    rdfs:comment "A publicly licensed software framework whose source code is freely available for inspection, modification, and redistribution under an approved open-source licence. Open source frameworks provide reusable architectural scaffolding—APIs, libraries, conventions, and tooling—that accelerate development whilst enabling community-driven quality assurance, security auditing, and interoperability across vendor boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-source-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-standard ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:interoperability,
        ngm:machine-learning-discipline-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-standard,
        ngm:open-source-software ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:robot-operating-system ;
    vc:slug "open-source-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:open-source-ai .

ngm:open-world a owl:Class ;
    rdfs:label "Open World"@en ;
    rdfs:comment "A game design paradigm featuring large-scale virtual environments with non-linear progression, extensive player freedom, emergent gameplay, and exploratory mechanics that allow users to interact with the world in diverse ways beyond predetermined narrative paths."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:procedural-generation ],
        [ a owl:Restriction ;
