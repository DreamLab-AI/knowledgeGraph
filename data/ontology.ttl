    vc:slug "llm-orchestration" ;
    vc:sourceDomain "ai" .

ngm:lnd a owl:Class ;
    rdfs:label "LND"@en ;
    rdfs:comment "LND (Lightning Network Daemon) is a production-grade, open-source implementation of a Bitcoin Lightning Network node developed by Lightning Labs. It manages the full lifecycle of payment channels — from on-chain funding and cooperative or force-close settlement to off-chain routing of multi-hop payments — exposing a gRPC and REST API that downstream wallets, exchanges, and applications consume. LND implements the BOLT (Basis of Lightning Technology) protocol specifications and employs Hash Time-Locked Contracts (HTLCs) to ensure atomic, trust-minimised payment routing across a peer-to-peer mesh of channels anchored to the Bitcoin base layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:watchtower ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:layer-2-protocol ;
    vc:contrastsWith ngm:core-lightning,
        ngm:eclair ;
    vc:enables ngm:atomic-swap,
        ngm:micropayment,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:watchtower ;
    vc:implements ngm:bolt-specifications,
        ngm:hash-time-locked-contract ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:loop,
        ngm:taproot-assets ;
    vc:requires ngm:bitcoin,
        ngm:lightning-network,
        ngm:payment-channel ;
    vc:slug "lnd" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:g-rpc,
        ngm:gossip-protocol,
        ngm:onion-routing .

ngm:logging a skos:Concept ;
    rdfs:label "Logging"@en .

ngm:loyalty-programs a owl:Class ;
    rdfs:label "Loyalty Programs"@en ;
    rdfs:comment "Loyalty Programs are structured incentive mechanisms that reward repeat customer engagement through points, tiers, or token-based systems. In spatial computing and metaverse contexts, loyalty programmes are increasingly tokenised on blockchain networks using loyalty tokens or NFTs, enabling cross-brand redemption, secondary-market trading, and programmable reward logic embedded in smart contracts."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-marketing,
        ngm:e-commerce ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:nft,
        ngm:token ;
    vc:slug "loyalty-programs" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:loyalty-token,
        ngm:smart-contract .

ngm:lstm a owl:Class ;
    rdfs:label "LSTM"@en ;
    rdfs:comment "Long Short-Term Memory (LSTM) is a specialised recurrent neural network architecture introduced by Hochreiter and Schmidhuber in 1997, designed to learn long-range temporal dependencies in sequential data. It employs a gated cell state mechanism—comprising input, forget, and output gates—that allows gradients to flow across many time steps without vanishing or exploding, overcoming the principal failure mode of vanilla recurrent neural networks. LSTMs encode contextual information in a learnable cell state that persists across sequence steps, making them highly effective for variable-length sequence modelling tasks such as language modelling, machine translation, and time-series forecasting. Although largely superseded by Transformer-based architectures for many NLP tasks, LSTMs remain widely deployed in low-latency, resource-constrained, and streaming scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:recurrent-neural-network ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:edge-inference ;
    vc:contrastsWith ngm:gated-recurrent-unit,
        ngm:transformer ;
    vc:enables ngm:machine-translation,
        ngm:speech-recognition,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cell-state ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:natural-language-processing,
        ngm:vanishing-gradient-problem ;
    vc:requires ngm:backpropagation,
        ngm:backpropagation-through-time,
        ngm:gradient-descent ;
    vc:slug "lstm" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:dropout .

ngm:manufacturing-process a owl:Class ;
    rdfs:label "Manufacturing Process"@en ;
    rdfs:comment "A manufacturing process is a structured sequence of physical transformations — including machining, assembly, forming, joining, heat treatment, surface finishing, and inspection — applied to raw materials or sub-components to produce finished goods meeting specified tolerances, material properties, and functional requirements. Manufacturing processes are characterised by their tooling, cycle time, throughput, waste profile, and quality control mechanisms."@en ;
    rdfs:subClassOf ngm:industrial-automation ;
    vc:enables ngm:logistics-automation,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-inspection ;
    vc:slug "manufacturing-process" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:industrial-robot,
        ngm:quality-assurance,
        ngm:sensor .

ngm:marker-based-tracking a owl:Class ;
    rdfs:label "Marker Based Tracking"@en ;
    rdfs:comment "AR and VR tracking technique that uses predefined visual patterns such as QR codes, April tags, ArUco markers, and fiducial markers to determine device position and orientation for accurate digital content overlay."@en ;
    rdfs:subClassOf ngm:sc-interaction,
        ngm:spatial-tracking-technology ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "marker-based-tracking" ;
    vc:sourceDomain "spatial-computing" .

ngm:market-surveillance-authority a owl:Class ;
    rdfs:label "Market Surveillance Authority"@en ;
    rdfs:comment "National authority responsible for carrying out market surveillance activities on AI systems, including inspections, testing, enforcement, and ensuring compliance with EU AI Act requirements within a Member State."@en ;
