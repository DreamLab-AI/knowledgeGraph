ngm:online-identity a owl:Class ;
    rdfs:label "Online Identity"@en ;
    rdfs:comment "The digital representation and persistent persona that an individual constructs and maintains across online platforms and virtual environments, encompassing usernames, avatars, credentials, reputation data, and linked digital assets. Online identity management raises questions of authentication, portability, privacy, and the mapping between real-world and digital personas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:dependsOn ngm:privacy ;
    vc:enables ngm:reputation-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:decentralised-identity,
        ngm:digital-identity ;
    vc:requires ngm:authentication,
        ngm:identity-management ;
    vc:slug "online-identity" ;
    vc:sourceDomain "infrastructure" .

