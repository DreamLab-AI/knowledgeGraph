        ngm:linked-data ;
    vc:slug "knowledge-organization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:knowledge-sharing a owl:Class ;
    rdfs:label "Knowledge Sharing"@en ;
    rdfs:comment "Collaborative practices and platforms within metaverse environments that facilitate the exchange of information, expertise, and learning experiences among users through immersive virtual spaces, avatars, and AI-enhanced interactions."@en ;
    rdfs:subClassOf ngm:collaborative-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
