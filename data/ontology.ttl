        ngm:robotics ;
    vc:requires ngm:cloud-computing,
        ngm:data-pipeline,
        ngm:edge-computing,
        ngm:sensor-data,
        ngm:signal-processing,
        ngm:time-series-analysis,
        ngm:training-data ;
    vc:slug "predictive-maintenance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iec-61499,
        ngm:ieee-1451,
        ngm:iso-10816,
