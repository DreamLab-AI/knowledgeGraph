            owl:someValuesFrom ngm:audit-mechanism ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-governance ;
    vc:enables ngm:algorithmic-accountability,
        ngm:explainable-ai,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:audit-mechanism,
        ngm:documentation-standards,
        ngm:stakeholder-communication ;
    vc:slug "ai-transparency-framework" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:aiops a owl:Class ;
    rdfs:label "AIOps"@en ;
    rdfs:comment "AIOps (Artificial Intelligence for IT Operations) applies machine learning, natural language processing, and big data analytics to automate and enhance IT operational tasks including event correlation, anomaly detection, root-cause analysis, incident management, and capacity planning. By continuously ingesting telemetry streams — logs, metrics, and traces — from complex distributed systems, AIOps platforms surface actionable insights that would be impossible for human operators to detect at scale, progressively shifting operations from reactive incident response towards predictive and autonomous self-healing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-incident ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:ai-infrastructure ;
    vc:enables ngm:operational-resilience,
        ngm:platform-engineering,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-incident,
        ngm:ai-monitoring,
        ngm:anomaly-detection ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:cloud-native-applications,
        ngm:edge-computing ;
    vc:requires ngm:data-pipeline,
        ngm:machine-learning-discipline,
        ngm:natural-language-processing ;
    vc:slug "aiops" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:microservices-architecture,
        ngm:monitoring-dashboard ;
    vc:uses ngm:deep-learning,
        ngm:event-driven-architecture,
        ngm:predictive-analytics .

ngm:air-gap a skos:Concept ;
    rdfs:label "Air Gap"@en .

ngm:algorithm-layer a owl:Class ;
    rdfs:label "Algorithm Layer"@en ;
    rdfs:comment "The Algorithm Layer is the architectural stratum that defines the computational methods, procedures, and decision logic operating above the data and protocol layers. It encompasses the design, selection, and composition of algorithms — sorting, search, optimisation, consensus, cryptographic, and learning algorithms — that transform inputs into outputs under defined correctness and complexity guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:application-layer,
        ngm:inference-layer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:data-layer ;
    vc:slug "algorithm-layer" ;
    vc:sourceDomain "machine-learning" .

ngm:algorithmic-impact-assessment a skos:Concept ;
    rdfs:label "Algorithmic Impact Assessment"@en .

ngm:analytics-engine a owl:Class ;
    rdfs:label "Analytics Engine"@en ;
    rdfs:comment "A software system or distributed platform that ingests, processes, and analyses large volumes of structured and unstructured data to extract insights, detect patterns, and support decision-making. Analytics engines abstract the complexity of distributed query execution, storage management, and statistical computation behind APIs and query interfaces, enabling analysts and applications to perform exploratory, diagnostic, predictive, and prescriptive analysis at scale. They serve as the computational backbone of business intelligence platforms, ML pipelines, and real-time operational monitoring systems."@en ;
    rdfs:subClassOf ngm:data-analytics ;
    vc:enables ngm:machine-learning-discipline-pipeline,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:emotional-analytics-engine,
        ngm:telemetry-and-analytics ;
    vc:slug "analytics-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-lake,
        ngm:data-pipeline,
        ngm:stream-processing .

ngm:animation-rig a owl:Class ;
    rdfs:label "Animation Rig"@en ;
    rdfs:comment "An animation rig is a hierarchical system of bones, controls, and constraints applied to a 3D character or object to enable articulated movement for animation. It abstracts underlying mesh deformation through a control interface that animators manipulate, translating high-level poses into low-level vertex transformations. Rigs range from simple skeletal setups to complex systems incorporating inverse kinematics, blend shapes, and procedural dynamics."@en ;
    rdfs:subClassOf ngm:skeletal-animation ;
    vc:enables ngm:character-animation,
        ngm:procedural-animation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:mesh-data ;
    vc:slug "animation-rig" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:inverse-kinematics,
        ngm:motion-capture .

ngm:anon-creds a owl:Class ;
    rdfs:label "AnonCreds"@en ;
    rdfs:comment "AnonCreds (Anonymous Credentials) is a verifiable credential format and specification originally developed by the Hyperledger Indy project that enables privacy-preserving identity verification. The scheme allows holders to prove possession of credentials without revealing the credential itself or the issuer's signature, using zero-knowledge proofs. AnonCreds supports selective disclosure, letting a holder share only specific attributes, and predicates that prove a claim (e.g. age over 18) without revealing the underlying value. The specification has been standardised via the AnonCreds Working Group under the Decentralized Identity Foundation."@en ;
    rdfs:subClassOf ngm:credential-format-standard ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:decentralised-identity,
