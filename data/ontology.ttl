ngm:raspberry-pi a owl:Class ;
    rdfs:label "Raspberry Pi"@en ;
    rdfs:comment "Raspberry Pi is a family of low-cost, credit-card-sized single-board computers built around ARM systems-on-chip, designed originally for education and now ubiquitous in hobbyist, prototyping, and edge-computing deployments. It exposes GPIO pins for hardware interfacing and runs full Linux distributions, making it a versatile platform for home automation, robotics controllers, and small servers. Its affordability and large community make it a default choice for edge experimentation."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
