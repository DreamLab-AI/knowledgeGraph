ngm:safety-filter a owl:Class ;
    rdfs:label "Safety Filter"@en ;
    rdfs:comment "A safety filter is a content-moderation component placed around a generative AI model that screens inputs and outputs to block disallowed, harmful, or policy-violating content. It typically combines classifiers, keyword and pattern rules, and policy thresholds to detect unsafe prompts or generations and refuse, redact, or regenerate them. It is a core safeguard in deployed image and conversational AI products."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companions,
        ngm:proprietary-image-generation ;
    vc:slug "safety-filter" ;
    vc:sourceDomain "ai" .

ngm:safety-plc a owl:Class ;
    rdfs:label "Safety PLC"@en ;
    rdfs:comment "A Safety Programmable Logic Controller (Safety PLC) is a specialised industrial controller certified to IEC 61511 or IEC 62061 safety integrity levels, designed to execute safety instrumented functions that bring a process to a safe state upon detecting hazardous conditions. Unlike standard PLCs, Safety PLCs implement redundant processing, self-diagnostics, and rigorous failure-mode analysis to achieve the high diagnostic coverage required for safety-critical robotics and industrial automation."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:cobot-safety-levels,
        ngm:collaborative-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:functional-safety ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:servo-control ;
    vc:slug "safety-plc" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-system,
        ngm:feedback-control .

ngm:sampling-procedure a owl:Class ;
    rdfs:label "Sampling Procedure"@en ;
    rdfs:comment "A sampling procedure is the method by which a generative model draws output samples from its learned probability distribution. It governs how latent or noise variables are mapped to concrete outputs, including techniques such as ancestral sampling, temperature scaling, top-k and nucleus sampling, and iterative denoising in diffusion models. The choice of procedure controls the diversity, fidelity, and computational cost of generation."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-networks,
        ngm:inpainting ;
    vc:slug "sampling-procedure" ;
    vc:sourceDomain "ai" .

ngm:sandbox-environment a owl:Class ;
    rdfs:label "Sandbox Environment"@en ;
    rdfs:comment "A sandbox environment is an isolated execution context that constrains a program's access to the host system, filesystem, network, and resources. It allows untrusted or autonomous code, such as AI-generated programs or agent actions, to run with controlled side effects and contained failure. Sandboxes are implemented through containers, virtual machines, OS-level namespaces, or language-level interpreters."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cli-multi-agent-systems,
        ngm:gpt-engineer ;
    vc:slug "sandbox-environment" ;
    vc:sourceDomain "infrastructure" .

ngm:scalable-architecture a owl:Class ;
    rdfs:label "Scalable Architecture"@en ;
    rdfs:comment "System designs that maintain performance and availability as user demand grows, employing horizontal scaling, load balancing, distributed computing, and cloud-native patterns to support expanding metaverse populations and concurrent interactions."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:system-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "scalable-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:scientific-discovery a owl:Class ;
    rdfs:label "Scientific Discovery"@en ;
    rdfs:comment "Scientific discovery in AI refers to the application of machine learning, knowledge-graph reasoning, and autonomous experimentation systems to accelerate the identification of novel scientific findings, generate and test hypotheses, and interpret complex experimental data at scales beyond human cognitive capacity. It encompasses AI-driven approaches across domains including drug discovery, materials science, genomics, and climate modelling, where the goal is to augment or automate stages of the scientific method from hypothesis generation through experimental design to result interpretation."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:drug-discovery,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:drug-discovery-ai ;
    vc:slug "scientific-discovery" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model,
        ngm:machine-learning .

ngm:scope-definition a owl:Class ;
    rdfs:label "Scope Definition"@en ;
    rdfs:comment "Scope definition is the act of establishing the precise boundaries, entities, and conditions to which an assessment, consent, or measurement applies. In governance and consent systems it specifies which permissions, data, or activities are covered, while in environmental assessment it delineates the system boundary for impact accounting. Clear scope is a prerequisite for auditable and comparable results."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-environmental-impact-assessment,
        ngm:user-consent-token ;
    vc:slug "scope-definition" ;
    vc:sourceDomain "governance" .

ngm:scripting-language a owl:Class ;
    rdfs:label "Scripting Language"@en ;
    rdfs:comment "A scripting language is an interpreted or dynamically compiled programming language used to automate tasks, define interactive behaviours, and extend the capabilities of host applications or game engines without modifying core engine code. In metaverse contexts, scripting languages such as JavaScript, Lua, Python, and C# enable content creators to author custom gameplay mechanics, NPC behaviour, and dynamic environment logic with rapid iteration cycles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:game-development,
        ngm:virtual-world-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:programming-language ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-engineering ;
    vc:slug "scripting-language" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:game-engine .

ngm:search-algorithms a owl:Class ;
    rdfs:label "Search Algorithms"@en ;
    rdfs:comment "Search Algorithms is a artificial intelligence concept and a type of Artificial Intelligence. that enables Pathfinding, Planning and Scheduling."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:pathfinding,
        ngm:planning-and-scheduling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "search-algorithms" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:sec a owl:Class ;
    rdfs:label "SEC"@en ;
    rdfs:comment "The Securities and Exchange Commission (SEC) is the principal US federal regulatory agency responsible for enforcing federal securities laws, overseeing securities markets, and protecting investors. Established by the Securities Exchange Act of 1934 in the wake of the 1929 stock market crash, the SEC requires public companies to disclose material financial information and polices against fraud, insider trading, and market manipulation. In the digital asset domain, the SEC has asserted jurisdiction over many cryptocurrencies and token offerings on the grounds that they constitute investment contracts under the Howey Test, leading to high-profile enforcement actions against exchanges, issuers, and DeFi protocols. The SEC's regulatory posture towards crypto assets is a defining factor in the shape of the US digital asset industry."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:contrastsWith ngm:us-regulatory-framework ;
    vc:enables ngm:compliance-audit-trail,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-risks,
        ngm:mi-ca-regulation,
        ngm:regulatory-framework,
        ngm:securities-regulation ;
    vc:slug "sec" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:regulatory-standards ;
    vc:uses ngm:enforcement-mechanism,
        ngm:regulatory-technology .

ngm:secp256k1-elliptic-curve a owl:Class ;
    rdfs:label "secp256k1 Elliptic Curve"@en ;
    rdfs:comment "secp256k1 is a specific elliptic curve defined over a 256-bit prime field, standardised by the SEC and chosen for its efficient, verifiable parameters. It underpins ECDSA and Schnorr signatures used by Bitcoin, Nostr, and many other systems for key generation and digital signing. Its near-rigid, low-entropy parameters reduce concern about hidden weaknesses."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nostr-protocol,
        ngm:sovereign-keyset ;
    vc:slug "secp256k1-elliptic-curve" ;
    vc:sourceDomain "blockchain" .

ngm:secure-storage a owl:Class ;
    rdfs:label "Secure Storage"@en ;
    rdfs:comment "Secure storage is the persistence of data with protections for confidentiality, integrity, and controlled access throughout its lifecycle. It combines encryption at rest, access control, tamper-evidence, and key management, sometimes anchored in hardware security modules or trusted execution environments. It is essential where stored records must remain trustworthy, such as audit trails and chains of custody."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:digital-evidence-chain-of-custody ;
    vc:slug "secure-storage" ;
    vc:sourceDomain "security" .

ngm:security-module a owl:Class ;
    rdfs:label "Security Module"@en ;
    rdfs:comment "A security module is a dedicated hardware or software component that provides cryptographic and protection services such as key generation, secure storage, signing, and access enforcement. Hardware security modules and secure elements isolate sensitive operations from the general computing environment to resist extraction and tampering. Such modules are required wherever keys and credentials must be safeguarded, as in custody and IoT systems."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:io-t-sensor-network,
        ngm:token-custody-service ;
    vc:slug "security-module" ;
    vc:sourceDomain "security" .

ngm:security-services a owl:Class ;
    rdfs:label "Security Services"@en ;
    rdfs:comment "Security Services are the technical and organisational mechanisms that protect spatial computing platforms from unauthorised access, data breaches, and malicious activity. They encompass authentication, encryption, access control, and identity management components that collectively enforce security policies across metaverse, cloud, and immersive technology deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control,
        ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:encryption ;
    vc:slug "security-services" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:cybersecurity,
        ngm:data-governance .

ngm:segregation-of-duties a owl:Class ;
    rdfs:label "Segregation of Duties"@en ;
    rdfs:comment "Segregation of duties is an internal control principle that divides critical tasks among multiple people so that no single individual can both execute and conceal an error or fraud. It separates responsibilities such as authorisation, custody, recording, and reconciliation. It is a core requirement of financial, security, and compliance control frameworks."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control ;
    vc:slug "segregation-of-duties" ;
    vc:sourceDomain "governance" .

ngm:self-organisation a owl:Class ;
    rdfs:label "Self-Organisation"@en ;
    rdfs:comment "Self-organisation is the spontaneous emergence of order, structure, or pattern in a complex system without external direction, arising purely from local interactions among components. It operates through positive and negative feedback mechanisms that amplify or dampen perturbations, leading to globally coherent behaviour from decentralised, local rules."@en ;
    rdfs:subClassOf ngm:complex-systems ;
    vc:bridgesTo ngm:agent-based-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chaos-theory,
        ngm:emergence,
        ngm:swarm-intelligence ;
    vc:slug "self-organisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:feedback-loop .

ngm:semantic-html a owl:Class ;
    rdfs:label "Semantic HTML"@en ;
    rdfs:comment "Semantic HTML is the practice of using HTML elements according to their intended meaning rather than for presentation alone. Elements such as header, nav, main, article, and button convey document structure and role to browsers and assistive technologies. It is a foundational requirement for accessible, machine-interpretable web content."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility ;
    vc:slug "semantic-html" ;
    vc:sourceDomain "infrastructure" .

ngm:sensitivity-analysis a owl:Class ;
    rdfs:label "Sensitivity Analysis"@en ;
    rdfs:comment "Sensitivity analysis is the study of how variation in the output of a model or calculation can be attributed to variation in its inputs and parameters. It quantifies which factors drive results, identifies fragile assumptions, and supports robustness checks across deterministic and probabilistic models. It is widely used in risk assessment, optimisation, and the calibration of analytics pipelines."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:calculation-parameters,
        ngm:privacy-preserving-analytics ;
    vc:slug "sensitivity-analysis" ;
    vc:sourceDomain "data" .

ngm:sensor-housing a owl:Class ;
    rdfs:label "Sensor Housing"@en ;
    rdfs:comment "A sensor housing is the mechanical enclosure that protects a sensing element from environmental hazards such as moisture, dust, vibration, and electromagnetic interference while maintaining its measurement window. It defines mounting geometry, ingress protection rating, thermal management, and the optical or acoustic path to the sensed medium. It is a structural component of robotic and exteroceptive sensing assemblies."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:exteroceptive-sensor,
        ngm:mechanical-component ;
    vc:slug "sensor-housing" ;
    vc:sourceDomain "robotics" .

ngm:sensor-interface a owl:Class ;
    rdfs:label "Sensor Interface"@en ;
    rdfs:comment "A sensor interface is the hardware and protocol boundary through which a controller acquires data from a sensor, encompassing signal conditioning, analogue-to-digital conversion, and bus protocols such as I2C, SPI, CAN, or analogue voltage lines. It standardises timing, addressing, and electrical levels so that heterogeneous sensors can be integrated into a control loop. It is a core subsystem of embedded and robotic control architectures."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:embedded-systems-domain ;
    vc:slug "sensor-interface" ;
    vc:sourceDomain "robotics" .

ngm:sensor-measurements a owl:Class ;
    rdfs:label "Sensor Measurements"@en ;
    rdfs:comment "Sensor measurements are the time-stamped observations produced by physical or virtual sensors, each carrying a value, a unit, and an associated uncertainty or noise model. In probabilistic robotics they form the observation stream that estimators condition on to infer latent state such as pose or velocity. Their statistical characterisation is essential for filtering, fusion, and localisation."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:monte-carlo-localization ;
    vc:slug "sensor-measurements" ;
    vc:sourceDomain "robotics" .

ngm:sensor-suite a owl:Class ;
    rdfs:label "Sensor Suite"@en ;
    rdfs:comment "A sensor suite is the integrated collection of complementary sensors mounted on a robotic platform, such as cameras, LiDAR, radar, IMUs, and encoders, chosen to provide redundant and complementary perception. The combination supports sensor fusion that compensates for the failure modes and blind spots of any single modality. It is a defining hardware subsystem of autonomous mobile robots."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:robot-hardware ;
    vc:slug "sensor-suite" ;
    vc:sourceDomain "robotics" .

ngm:sensory-feedback a owl:Class ;
    rdfs:label "Sensory Feedback"@en ;
    rdfs:comment "Sensory feedback is the delivery of stimuli to a user's senses, including visual, auditory, haptic, and proprioceptive channels, in response to their actions within a virtual or mixed environment. Timely and coherent feedback closes the perception-action loop and is a precondition for the user's sense of presence and emotional engagement. It is a core mechanism of immersive interaction design."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:emotional-immersion,
        ngm:presence ;
    vc:slug "sensory-feedback" ;
    vc:sourceDomain "metaverse" .

ngm:serialisation-format a owl:Class ;
    rdfs:label "Serialisation Format"@en ;
    rdfs:comment "A serialisation format is a specification for encoding in-memory data structures into a byte or text stream that can be persisted or transmitted and later reconstructed. Formats differ in schema rigidity, compactness, speed, and cross-language support, spanning text formats like JSON and YAML and binary formats like Protocol Buffers, Avro, and Parquet. It is fundamental to checkpointing, messaging, and distributed computation."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:distributed-computing ;
    vc:slug "serialisation-format" ;
    vc:sourceDomain "infrastructure" .

ngm:service-oriented-architecture a owl:Class ;
    rdfs:label "Service Oriented Architecture"@en ;
    rdfs:comment "An architectural style organizing software as loosely coupled, interoperable services that communicate through standardized interfaces, enabling modular composition of metaverse functionality through reusable components and well-defined contracts."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:software-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "service-oriented-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:servo-drive a owl:Class ;
    rdfs:label "Servo Drive"@en ;
    rdfs:comment "A servo drive is the power-electronic controller that regulates the current, velocity, and position of a servomotor by closing feedback loops on encoder or resolver signals. It converts commanded setpoints from a motion controller into precisely modulated motor currents, enabling high-bandwidth, high-accuracy actuation. It is a core component of industrial robot joints and CNC motion systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:motion-control ;
    vc:slug "servo-drive" ;
    vc:sourceDomain "robotics" .

ngm:sheffield-advanced-manufacturing a owl:Class ;
    rdfs:label "Sheffield Advanced Manufacturing"@en ;
    rdfs:comment "Sheffield Advanced Manufacturing denotes the cluster of research institutions, industrial facilities, and technology parks centred on the Advanced Manufacturing Park (AMP) in South Yorkshire, UK, specialising in materials science, aerospace engineering, robotics, and Industry 4.0 technologies. Anchored by the University of Sheffield's Advanced Manufacturing Research Centre (AMRC) and hosting global firms including Boeing and Rolls-Royce, the cluster forms the core of the Advanced Manufacturing Innovation District (AMID) — the UK's largest research-led advanced manufacturing ecosystem. It bridges traditional industrial heritage with digital manufacturing, additive processes, and intelligent automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:north-england-innovation-corridor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-automation ],
        ngm:uk-tech-ecosystem ;
    vc:enables ngm:industrial-io-t,
        ngm:robotics-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:industrial-automation,
        ngm:north-england-innovation-corridor,
        ngm:robotics ;
    vc:isPartOf ngm:uk-tech-ecosystem ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:national-industrial-centre-for-virtual-environments,
        ngm:newcastle-ai-and-health-innovation,
        ngm:sustainable-technology ;
    vc:slug "sheffield-advanced-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:industrial-robot,
        ngm:sensor-fusion .

ngm:siggraph a owl:Class ;
    rdfs:label "SIGGRAPH"@en ;
    rdfs:comment "SIGGRAPH (Special Interest Group on Computer Graphics and Interactive Techniques) is the ACM's premier annual conference on computer graphics and interactive technology, considered the world's most prestigious venue for publishing advances in rendering, animation, simulation, geometry processing, and human-computer interaction. First held in 1974, SIGGRAPH has been the introduction point for transformative techniques including ray tracing, physically based rendering, GPU shading languages, neural rendering, and real-time global illumination. Its technical papers programme is among the most selective in computer science, with acceptance rates typically below 25 per cent."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:enables ngm:differentiable-rendering,
        ngm:physically-based-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-modeling,
        ngm:global-illumination,
        ngm:neural-rendering,
        ngm:ray-tracing,
        ngm:visual-effects ;
    vc:slug "siggraph" ;
    vc:sourceDomain "metaverse" .

ngm:sigma-algebra a owl:Class ;
    rdfs:label "Sigma-Algebra"@en ;
    rdfs:comment "A sigma-algebra is a collection of subsets of a sample space that contains the whole space and is closed under complementation and countable unions. It specifies exactly which sets are measurable, providing the domain on which measures and probability are rigorously defined. It is the structural foundation of measure theory, integration, and the theory of stochastic processes."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:measure-theory,
        ngm:stochastic-process ;
    vc:slug "sigma-algebra" ;
    vc:sourceDomain "data" .

ngm:signal-amplifier a owl:Class ;
    rdfs:label "Signal Amplifier"@en ;
    rdfs:comment "A signal amplifier is an electronic circuit that increases the power, voltage, or current of a weak signal while ideally preserving its waveform. In sensing applications it boosts low-amplitude transducer outputs above the noise floor so they can be digitised, with gain, bandwidth, noise figure, and linearity as key parameters. It is an essential front-end component of sensors and biosignal acquisition systems."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:brain-computer-interfaces,
        ngm:infrared-sensor ;
    vc:slug "signal-amplifier" ;
    vc:sourceDomain "robotics" .

ngm:signal-processing-unit a owl:Class ;
    rdfs:label "Signal Processing Unit"@en ;
    rdfs:comment "A signal processing unit is the hardware or firmware block that filters, transforms, and extracts features from raw sensor or transducer signals, often using DSP cores, FFTs, and digital filtering. In haptic and biosensing devices it converts captured analogue or digital streams into actionable control signals or feature vectors in real time. It is a core processing component of interactive sensing interfaces."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biosensing-interface,
        ngm:haptics ;
    vc:slug "signal-processing-unit" ;
    vc:sourceDomain "robotics" .

ngm:signature-algorithm a owl:Class ;
    rdfs:label "Signature Algorithm"@en ;
    rdfs:comment "A signature algorithm is a cryptographic scheme comprising key generation, signing, and verification procedures that lets a holder of a private key produce a value provably tied to a message, which anyone with the public key can verify. It provides authenticity, integrity, and non-repudiation, with families including RSA, ECDSA, EdDSA, and Schnorr. It is the cryptographic primitive underpinning digital signatures."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-signature-verification,
        ngm:digital-signatures ;
    vc:slug "signature-algorithm" ;
    vc:sourceDomain "security" .

ngm:signature-scheme a owl:Class ;
    rdfs:label "Signature Scheme"@en ;
    rdfs:comment "A Signature Scheme is a cryptographic primitive that provides a triple of algorithms—key generation, signing, and verification—enabling a party holding a private key to produce an unforgeable authentication tag over arbitrary messages that any holder of the corresponding public key can verify. In blockchain systems, signature schemes authenticate transactions, authorise state transitions, and underpin identity and ownership semantics across the distributed ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:authentication,
        ngm:blockchain-transaction,
        ngm:digital-signature-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger-technology,
        ngm:smart-contract ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:hash-function ;
    vc:slug "signature-scheme" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:key-management,
        ngm:public-key-infrastructure .

ngm:signed-distance-function a owl:Class ;
    rdfs:label "Signed Distance Function"@en ;
    rdfs:comment "A signed distance function (SDF) is a scalar field that returns, for any point in space, the distance to the nearest surface of a shape, with the sign indicating whether the point is inside (negative) or outside (positive). The surface itself is the zero level set where the function equals zero. SDFs provide a compact implicit representation of geometry that supports efficient ray marching, smooth shape blending, and analytic normals, and they underpin procedural rendering, collision queries, and learned 3D reconstruction in neural networks."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:rendering-pipeline ;
    vc:slug "signed-distance-function" ;
    vc:sourceDomain "graphics" ;
    vc:supports ngm:neural-rendering,
        ngm:real-time-rendering .

ngm:slashing-condition a owl:Class ;
    rdfs:label "Slashing Condition"@en ;
    rdfs:comment "A slashing condition is a rule in a proof-of-stake protocol that defines provable validator misbehaviour, such as double-signing or equivocation, and triggers the forfeiture of part of the offender's staked collateral. It makes attacks economically costly by penalising actions that threaten consensus safety, aligning validator incentives with honest participation. It is a core economic-security primitive of staking-based consensus."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:sustainable-consensus ;
    vc:slug "slashing-condition" ;
    vc:sourceDomain "blockchain" .

ngm:slot-filling a owl:Class ;
    rdfs:label "Slot Filling"@en ;
    rdfs:comment "Slot filling is a natural language processing task in which a system extracts and populates predefined semantic fields (slots) from user utterances within a task-oriented dialogue context, enabling the system to gather the structured information required to fulfil a user request. It operates alongside intent classification to transform free-form text into actionable structured representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        ngm:information-extraction ;
    vc:enables ngm:conversational-ai,
        ngm:dialogue-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dialogue-state-tracking,
        ngm:natural-language-understanding ;
    vc:requires ngm:intent-classification,
        ngm:named-entity-recognition ;
    vc:slug "slot-filling" ;
    vc:sourceDomain "ai" .

ngm:smart-contract-coordination a owl:Class ;
    rdfs:label "Smart Contract Coordination"@en ;
    rdfs:comment "Smart Contract Coordination is the use of blockchain smart contracts—self-executing programs stored on distributed ledgers—to automate coordination, task allocation, payment distribution, and milestone verification in distributed teams, enabling trustless collaboration through cryptographically enforced agreements that execute deterministically without centralised intermediaries. This approach removes the need for escrow agents and manual approvals by encoding collaboration rules as immutable on-chain logic triggered by verifiable real-world events. It is foundational to decentralised autonomous organisations and cryptocurrency-based remuneration workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptocurrency-remuneration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:payment-system,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:cryptocurrency-remuneration ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-collaboration,
        ngm:dao-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:distributed-collaboration ;
    vc:slug "smart-contract-coordination" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:blockchain-infrastructure,
        ngm:cryptography,
        ngm:distributed-ledger-technology .

ngm:snapshot-hub a owl:Class ;
    rdfs:label "Snapshot Hub"@en ;
    rdfs:comment "Snapshot Hub is the backend service of the Snapshot off-chain governance platform that stores proposals, collects signed votes, and computes results using token balances read at a chosen block height. Votes are signed messages that incur no gas, while the hub indexes and tallies them according to a configurable voting strategy. It lets DAOs run gasless, verifiable governance while final execution remains optional and off-chain."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:snapshot-block,
        ngm:snapshot-voting ;
    vc:slug "snapshot-hub" ;
    vc:sourceDomain "blockchain" .

ngm:social-contract a owl:Class ;
    rdfs:label "Social Contract"@en ;
    rdfs:comment "A philosophical and political theory positing that individuals consent, either explicitly or tacitly, to surrender certain freedoms and submit to authority in exchange for protection of their remaining rights and maintenance of social order."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:civil-society,
        ngm:constitutional-law,
        ngm:democratic-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "social-contract" ;
    vc:sourceDomain "infrastructure" .

ngm:social-impact-assessment-sia a owl:Class ;
    rdfs:label "Social Impact Assessment (SIA)"@en ;
    rdfs:comment "Systematic eof potential social consequences of metaverse deployment on communities, stakeholder groups, and societal well-being."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stakeholder-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impact-metrics ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:community-protection,
        ngm:policy-development,
        ngm:responsible-deployment,
        ngm:stakeholder-alignment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:community-consultation,
        ngm:impact-metrics,
        ngm:risk-assessment,
        ngm:stakeholder-analysis ;
    vc:isPartOf ngm:compliance-management,
        ngm:governance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-collection,
        ngm:impact-indicators,
        ngm:stakeholder-mapping ;
    vc:slug "social-impact-assessment-sia" ;
    vc:sourceDomain "spatial-computing" .

ngm:social-presence-theory a owl:Class ;
    rdfs:label "Social Presence Theory"@en ;
    rdfs:comment "\"A theoretical framework explaining how communication media vary in their capacity to convey social cues (facial expressions, vocal intonation, body language, interpersonal warmth), thereby influencing the degree to which communicators perceive each other as psychologically present, real, and eng..."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:telecollaboration-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:nonverbal-communication ;
    vc:slug "social-presence-theory" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:social-system a owl:Class ;
    rdfs:label "Social System"@en ;
    rdfs:comment "A social system, in the context of virtual worlds, is the combination of features and rules that enable users to find, communicate with, and form relationships with one another, including presence, friend graphs, groups, voice and text chat, and reputation. It provides the connective fabric that turns a rendered space into an inhabited community. The design of these systems shapes safety, belonging, and the network effects that sustain a persistent virtual environment."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:virtual-world ;
    vc:slug "social-system" ;
    vc:sourceDomain "metaverse" .

ngm:societal-and-environmental-wellbeing a owl:Class ;
    rdfs:label "Societal and Environmental Wellbeing"@en ;
    rdfs:comment "Societal and Environmental Wellbeing is a trustworthiness dimension ensuring AI systems consider broader impacts on communities, environments, democratic processes, and human flourishing beyond immediate functional objectives. It promotes sustainable development, social cohesion, and alignment with the UN Sustainable Development Goals across the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:responsible-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-footprint-assessment ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:democratic-participation,
        ngm:digital-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-fairness,
        ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:carbon-neutrality-planning,
        ngm:responsible-ai-principles,
        ngm:transparency ;
    vc:requires ngm:ai-impact-assessment,
        ngm:carbon-footprint-assessment,
        ngm:responsible-ai ;
    vc:slug "societal-and-environmental-wellbeing" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:software-library a owl:Class ;
    rdfs:label "Software Library"@en ;
    rdfs:comment "A Software Library is a collection of pre-compiled, reusable code modules that expose stable APIs, encapsulating common functionality such as rendering, physics simulation, networking, or cryptography. Libraries accelerate development by abstracting complexity, reducing defect rates, and enabling interoperability between components within a software stack."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:software-development-process ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:software-architecture,
        ngm:version-control ;
    vc:slug "software-library" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:machine-learning-framework,
        ngm:rendering-engine ;
    vc:uses ngm:api-standard .

ngm:solana a owl:Class ;
    rdfs:label "Solana"@en ;
    rdfs:comment "Solana is a high-performance layer-1 blockchain designed by Anatoly Yakovenko and launched in 2020, distinguished by its Proof of History consensus innovation that creates a cryptographic clock enabling validators to agree on transaction order without communicating timestamps. Combined with a parallel transaction processing architecture called Sealevel and a pipeline optimisation called the Gulf Stream, Solana achieves sustained throughput of tens of thousands of transactions per second with sub-second finality. It is a major platform for DeFi protocols, NFT marketplaces, and consumer applications requiring low transaction costs."@en ;
    rdfs:subClassOf ngm:smart-contract-platform ;
    vc:contrastsWith ngm:blockchain-gaming ;
    vc:enables ngm:decentralised-finance,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:proof-of-history,
        ngm:smart-contract-platform ;
    vc:slug "solana" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:validator-node .

ngm:sovereign-ai a owl:Class ;
    rdfs:label "Sovereign AI"@en ;
    rdfs:comment "National strategies for building indigenous AI capabilities—foundational models trained on sovereign data using domestically controlled compute infrastructure—to reduce dependence on foreign hyperscaler platforms. Encompasses government investment in national AI compute clusters, local language models, and data governance frameworks."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:competition-in-ai,
        ngm:open-source-ai ;
    vc:slug "sovereign-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:space-robotics a owl:Class ;
    rdfs:label "Space Robotics"@en ;
    rdfs:comment "Space robotics is the engineering discipline concerned with the design, development, and operation of robotic systems that function in the space environment, including planetary rovers, orbital manipulators, free-flying servicer spacecraft, and landers. These systems must contend with extreme thermal cycling, vacuum, radiation, communications latency, and the absence of gravity, requiring high degrees of autonomy, fault tolerance, and dexterous manipulation capability. Space robotics intersects closely with teleoperation research, autonomous navigation, computer vision, and the emerging field of on-orbit servicing and assembly."@en ;
    rdfs:subClassOf ngm:autonomous-robot ;
    vc:enables ngm:autonomous-system,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning ;
    vc:slug "space-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:simultaneous-localisation-and-mapping .

ngm:spatial-anchoring a owl:Class ;
    rdfs:label "Spatial Anchoring"@en ;
    rdfs:comment "A technique for locking virtual objects to specific physical locations using environmental mapping, enabling persistent placement of digital content that maintains consistent position and orientation relative to real-world surfaces across sessions and devices through SLAM-based tracking and cloud..."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:location-based-ar ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-anchoring" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-index a owl:Class ;
    rdfs:label "Spatial Index"@en ;
    rdfs:comment "Data structure optimized for efficient storage, retrieval, and querying of 3D spatial objects within virtual worlds using hierarchical geometric partitioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:sc-display-and-rendering,
        ngm:spatial-data-structure ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:collision-detection,
        ngm:fast-spatial-queries,
        ngm:level-of-detail-selection,
        ngm:proximity-search,
        ngm:view-frustum-culling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bounding-volume-hierarchy,
        ngm:grid-based-index,
        ngm:octree,
        ngm:quadtree,
        ngm:r-tree-structure ;
    vc:isPartOf ngm:spatial-database,
        ngm:virtual-world-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:bounding-box,
        ngm:coordinate-system,
        ngm:distance-metric,
        ngm:geometric-primitives ;
    vc:slug "spatial-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-interaction a owl:Class ;
    rdfs:label "Spatial Interaction"@en ;
    rdfs:comment "The design and implementation of user input mods within extended reality environments that enable natural manipulation of virtual objects through gestures, eye tracking, voice commands, and physical movement in three-dimensional space."@en ;
    rdfs:subClassOf ngm:human-computer-interaction,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-user-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:spherical-harmonics a owl:Class ;
    rdfs:label "Spherical Harmonics"@en ;
    rdfs:comment "Spherical harmonics are a complete set of orthogonal basis functions defined on the surface of a sphere, used to represent functions of direction compactly as a weighted sum of coefficients. Analogous to a Fourier series on the sphere, they allow smooth angular functions — such as incoming light or a directional colour — to be approximated with a small number of low-order coefficients. In computer graphics they underpin precomputed radiance transfer, irradiance environment lighting, and, more recently, view-dependent colour in Gaussian splatting and neural rendering."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:rendering-pipeline ;
    vc:slug "spherical-harmonics" ;
    vc:sourceDomain "graphics" ;
    vc:supports ngm:neural-rendering,
        ngm:real-time-rendering .

ngm:stakeholder-engagement-in-ai a owl:Class ;
    rdfs:label "Stakeholder Engagement in AI"@en ;
    rdfs:comment "Stakeholder Engagement in AI is a participatory process that systematically identifies, involves, and incorporates perspectives from individuals, groups, and communities affected by or having legitimate interests in AI systems, ensuring inclusive design, accountable deployment, and responsive governance. Engagement spans a spectrum from information provision and consultation through to co-design and empowerment mechanisms, and is required by frameworks including the EU AI Act and the OECD AI Principles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-impact-assessment,
        ngm:bias-detection-methods,
        ngm:ethical-review-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:fairness,
        ngm:human-oversight,
        ngm:participation-framework ;
    vc:requires ngm:accountability,
        ngm:ai-governance,
        ngm:transparency ;
    vc:slug "stakeholder-engagement-in-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework,
        ngm:ai-policy .

ngm:standard-contractual-clauses a owl:Class ;
    rdfs:label "Standard Contractual Clauses"@en ;
    rdfs:comment "Standard Contractual Clauses (SCCs) are pre-approved contractual templates issued by the European Commission that enable the lawful transfer of personal data from the European Economic Area to third countries lacking an adequacy decision, by binding data exporters and importers to GDPR-equivalent data protection obligations. The 2021 SCCs replaced older versions and introduced a modular structure covering controller-to-controller, controller-to-processor, processor-to-processor, and processor-to-controller transfers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:cross-border-data-transfer-rule ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection-regulation,
        ngm:gdpr-compliance,
        ngm:uk-gdpr ;
    vc:requires ngm:data-protection,
        ngm:privacy-impact-assessment ;
    vc:slug "standard-contractual-clauses" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:data-privacy .

ngm:standardized-formats a owl:Class ;
    rdfs:label "Standardized Formats"@en ;
    rdfs:comment "Standardized formats are openly specified, consistently structured file and data encodings, such as glTF for 3D assets, USD for scene description, or VRM for avatars, that allow content to be created in one tool and faithfully consumed in another. By fixing geometry, material, animation, and metadata conventions, they decouple content from any single application or platform. They are the precondition for portability, archival longevity, and interoperability across the metaverse content pipeline."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-archive,
        ngm:avatar-portability ;
    vc:slug "standardized-formats" ;
    vc:sourceDomain "metaverse" .

ngm:standards-documentation a owl:Class ;
    rdfs:label "Standards Documentation"@en ;
    rdfs:comment "Established guidelines, rules, and best practices that govern the creation of technical documentation, including structure, formatting conventions, terminology usage, delivery methods, and presentation to ensure consistency, clarity, and accuracy across all content. Standards documentation underpins interoperability, regulatory compliance, and knowledge transfer in technical domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standard ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:standards-conformance,
        ngm:standards-validation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:standards-body ;
    vc:requires ngm:technical-standard ;
    vc:slug "standards-documentation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:interoperability,
        ngm:standards-compliance .

ngm:start-configuration a owl:Class ;
    rdfs:label "Start Configuration"@en ;
    rdfs:comment "A start configuration is the initial pose of a robot or articulated system, expressed as a point in its configuration space, from which a motion or path planner must compute a feasible route to a goal configuration. It encodes the complete set of joint values or positional parameters that fully describe the system's state at the beginning of a planned motion. Together with the goal configuration, it bounds the planning query."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:trajectory-generation ;
    vc:slug "start-configuration" ;
    vc:sourceDomain "robotics" .

ngm:state-space-model a owl:Class ;
    rdfs:label "State Space Model"@en ;
    rdfs:comment "A class of sequence model that represents a system through a latent state evolving over time according to linear dynamics, recently adapted as an efficient alternative to attention for long sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        ngm:neural-network ;
    vc:enables ngm:language-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probabilistic-model ;
    vc:slug "state-space-model" ;
    vc:sourceDomain "deep-learning" .

ngm:state-transition-function a owl:Class ;
    rdfs:label "State Transition Function"@en ;
    rdfs:comment "A state transition function is the deterministic rule of a blockchain protocol that maps a current ledger state and a validated block of transactions to the next state, defining exactly how balances, contract storage, and other state evolve. Because every honest node applies the same function to the same inputs, all nodes converge on identical state, which is the basis of replicated consensus. It is the formal heart of a blockchain understood as a replicated state machine."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:distributed-ledger ;
    vc:slug "state-transition-function" ;
    vc:sourceDomain "blockchain" .

ngm:stdio-transport a owl:Class ;
    rdfs:label "Stdio Transport"@en ;
    rdfs:comment "Stdio transport is a communication mechanism in which a client and server exchange messages over the standard input and standard output streams of a locally spawned process. It is one of the primary transports defined by the Model Context Protocol, where the host launches the server as a subprocess and frames JSON-RPC messages through stdin/stdout. It suits local, single-machine integrations because it requires no network sockets and inherits the operating system's process isolation."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-context-protocol,
        ngm:model-control-protocols-like-mcp ;
    vc:slug "stdio-transport" ;
    vc:sourceDomain "infrastructure" .

ngm:strict-encoding a owl:Class ;
    rdfs:label "Strict Encoding"@en ;
    rdfs:comment "Strict encoding is a deterministic binary serialisation scheme used in the RGB protocol that guarantees a single canonical byte representation for any given data structure. By forbidding ambiguous orderings and optional layout choices, it ensures that independently computed commitments and hashes match exactly, which is essential for client-side validation. It pairs with strict types to give RGB its reproducible, consensus-free verification."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation,
        ngm:strict-types ;
    vc:slug "strict-encoding" ;
    vc:sourceDomain "blockchain" .

ngm:strict-types a owl:Class ;
    rdfs:label "Strict Types"@en ;
    rdfs:comment "Strict types is a type system and schema language used by the RGB protocol to define data structures with a fully deterministic memory layout and a content-addressable type identity. Each type has a unique hash derived from its definition, so schemas can be referenced and verified without ambiguity. It provides the typed foundation that strict encoding serialises during client-side validation."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation,
        ngm:strict-encoding ;
    vc:slug "strict-types" ;
    vc:sourceDomain "blockchain" .

ngm:superintelligence a owl:Class ;
    rdfs:label "Superintelligence"@en ;
    rdfs:comment "Superintelligence refers to a hypothetical form of artificial intelligence that surpasses the cognitive performance of any human across virtually all domains of interest, including scientific reasoning, social manipulation, and strategic planning. Nick Bostrom distinguishes speed superintelligence (same algorithms, faster hardware), collective superintelligence (many coordinated AI agents), and quality superintelligence (genuinely superior algorithms), each presenting distinct safety and control challenges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        ngm:artificial-superintelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:agi-timelines ;
    vc:requires ngm:ai-alignment ;
    vc:slug "superintelligence" ;
    vc:sourceDomain "ai" .

ngm:surgical-navigation a owl:Class ;
    rdfs:label "Surgical Navigation"@en ;
    rdfs:comment "Surgical Navigation is the intraoperative technology and methodology that provides surgeons with real-time spatial guidance by registering preoperative imaging data (CT, MRI) with the patient's anatomy and continuously tracking the position of surgical instruments relative to that registered model. It is analogous to GPS navigation but for the operating room, enabling submillimetre accuracy in procedures where anatomical landmarks are obscured, such as orthopaedic, neurosurgery, and spinal operations."@en ;
    rdfs:subClassOf ngm:navigation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:haptic-feedback,
        ngm:surgical-robot,
        ngm:surgical-robotics ;
    vc:slug "surgical-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:healthcare-ai,
        ngm:precision-medicine ;
    vc:uses ngm:medical-imaging,
        ngm:pose-estimation,
        ngm:sensor-fusion,
        ngm:tracking-system .

ngm:sustainable-consensus a owl:Class ;
    rdfs:label "Sustainable Consensus"@en ;
    rdfs:comment "Sustainable consensus mechanisms are distributed agreement protocols designed for Blockchain Network|blockchain and distributed ledger systems that achieve Byzantine fault-tolerant finality whilst minimising energy consumption, carbon emissions, and physical resource expenditure—contrasting s..."@en ;
