ngm:animation-retargeting a owl:Class ;
    rdfs:label "Animation Retargeting"@en ;
    rdfs:comment "Animation Retargeting is the process of transferring motion capture or animation data from one character skeleton to another with different proportions, joint configurations, or bone structures, enabling reuse of animation assets across diverse character models in games, film, and virtual environ..."@en ;
