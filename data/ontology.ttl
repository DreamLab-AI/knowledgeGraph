ngm:superfluid a owl:Class ;
    rdfs:label "Superfluid"@en ;
    rdfs:comment "A phase of matter that flows without viscosity, exhibiting effects such as frictionless flow and the ability to climb container walls. It arises in certain quantum systems at very low temperatures."@en ;
