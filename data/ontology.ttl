        ngm:teleoperation,
        ngm:virtual-reality .

ngm:trustworthy-ai a owl:Class ;
    rdfs:label "Trustworthy AI"@en ;
    rdfs:comment "Trustworthy AI denotes artificial intelligence systems designed, developed, and operated in accordance with a multi-criteria framework of lawfulness, ethical soundness, technical robustness, fairness, transparency, accountability, and societal wellbeing, ensuring they produce reliable and safe outcomes throughout their full lifecycle. The concept is most concretely codified in the EU High-Level Expert Group on AI's seven requirements for trustworthy AI and operationalised through the EU AI Act's risk-tiered conformity obligations and the NIST AI Risk Management Framework. Achieving trustworthy AI demands convergent technical measures—such as explainability, robustness testing, and bias mitigation—alongside governance instruments including impact assessments, model documentation, algorithmic audits, and meaningful human oversight mechanisms. It functions as an integrating standard that bridges AI safety, AI ethics, and AI regulation into a coherent assurance regime applicable across the full AI system lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-governance,
        ngm:digital-sovereignty ;
    vc:contrastsWith ngm:black-box-ai,
        ngm:unregulated-ai ;
    vc:enables ngm:ai-adoption,
        ngm:ai-certification,
        ngm:public-trust-in-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:eu-ai-act,
        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-ethics,
        ngm:fairness-aware-machine-learning,
        ngm:responsible-ai ;
    vc:requires ngm:algorithmic-accountability,
        ngm:bias-mitigation,
        ngm:explainable-ai,
        ngm:human-oversight,
        ngm:privacy-by-design ;
    vc:slug "trustworthy-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-high-level-expert-group-on-ai,
        ngm:iso-iec-jtc1-sc42,
        ngm:nist ;
    vc:supports ngm:ai-safety,
