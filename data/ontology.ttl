ngm:3-d-development a owl:Class ;
    rdfs:label "3D Development"@en ;
    rdfs:comment "3D Development encompasses the modologies, tools, and workflows for creating, iterating, and deploying three-dimensional digital assets and environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-graphics-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        ngm:sc-platform-and-environment,
        ngm:software-development ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-creation,
        ngm:virtual-environment-design,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-graphics-standard,
        ngm:3-d-rendering-engine ;
    vc:slug "3-d-development" ;
    vc:sourceDomain "spatial-computing" .

ngm:aave-governance a owl:Class ;
    rdfs:label "Aave Governance"@en ;
    rdfs:comment "Aave Governance is the on-chain decision-making system for the Aave decentralised lending protocol, enabling AAVE token holders and protocol delegates to propose, debate, and vote on parameter changes, new asset listings, risk adjustments, and smart contract upgrades. It operates through a tiered proposal mechanism where quorum and voting-power thresholds determine whether a proposal proceeds to execution, with all outcomes enforced autonomously by smart contracts on Ethereum and affiliated networks."@en ;
    rdfs:subClassOf ngm:on-chain-governance ;
    vc:dependsOn ngm:aave,
        ngm:smart-contract ;
    vc:enables ngm:collateral-management,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:token-economics ;
    vc:slug "aave-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:voting-mechanism .

ngm:accessibility-audit-tool a owl:Class ;
    rdfs:label "Accessibility Audit Tool"@en ;
    rdfs:comment "An automated software utility that verifies compliance with accessibility standards (such as WCAG) in XR environments, identifying barriers for users with disabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-dashboard ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:accessibility-reporting,
        ngm:compliance-verification,
        ngm:inclusive-design,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-testing-engine,
        ngm:compliance-dashboard,
        ngm:report-generator,
        ngm:wcag-validator ;
    vc:isPartOf ngm:quality-assurance-toolchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:accessibility-standards,
        ngm:testing-framework,
        ngm:user-interface-analyzer ;
    vc:slug "accessibility-audit-tool" ;
    vc:sourceDomain "spatial-computing" .

ngm:accessibility-captioning a owl:Class ;
    rdfs:label "Accessibility Captioning"@en ;
    rdfs:comment "Accessibility captioning is the practice of producing synchronised textual representations of spoken dialogue, sound effects, and other audio information within video or live media so that deaf, hard-of-hearing, or audio-impaired audiences can fully engage with the content. It encompasses both closed captions (user-selectable, stored separately from the video stream) and open captions (burned into the image), and spans pre-produced transcription and real-time automatic speech recognition pipelines."@en ;
    rdfs:subClassOf ngm:inclusive-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:transparency ;
    vc:slug "accessibility-captioning" ;
    vc:sourceDomain "media" ;
    vc:standardizedBy ngm:wcag-2-2 ;
    vc:supports ngm:assistive-technology-integration ;
    vc:uses ngm:natural-language-processing,
        ngm:speech-recognition .

ngm:accountability-ai-0068 a owl:Class ;
    rdfs:label "Accountability (AI-0068)"@en ;
    rdfs:comment "Accountability (AI-0068) is the principle—as codified in AI governance frameworks bearing that reference identifier—that organisations deploying AI systems must be able to demonstrate responsibility for the systems' decisions, provide redress mechanisms when harm occurs, and maintain identifiable human oversight over automated processes. It imposes obligations on developers, deployers, and operators to document, audit, and accept liability for AI-driven outcomes, distinguishing it from the broader ethical principle of accountability by its grounding in specific regulatory or standards-based obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        ngm:accountability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:responsible-ai ;
    vc:requires ngm:ai-audit,
        ngm:explainable-ai ;
    vc:slug "accountability-ai-0068" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-regulation,
        ngm:transparency .

ngm:accountability-oecd a owl:Class ;
    rdfs:label "Accountability (OECD)"@en ;
    rdfs:comment "Organisations and individuals developing, deploying or operating AI systems should be accountable for their proper functioning in accordance with OECD AI Principles and applicable legal frameworks, based on their roles, context and ability to act."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:policy-framework ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:continuous-improvement,
        ngm:effective-governance,
        ngm:redress ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence ;
    vc:slug "accountability-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:accounts a owl:Class ;
    rdfs:label "Accounts"@en ;
    rdfs:comment "Accounts denotes the financial reporting and filing obligations of a limited company under UK law, encompassing annual accounts preparation, Companies House submission deadlines, confirmation statements, and the penalties regime for late filing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:dependsOn ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:privacy ;
    vc:requires ngm:compliance-framework,
        ngm:governance ;
    vc:slug "accounts" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:compliance-audit-trail .

ngm:across-protocol a owl:Class ;
    rdfs:label "Across Protocol"@en ;
    rdfs:comment "Across Protocol is a decentralised cross-chain bridging protocol that uses an optimistic verification model and a network of liquidity providers—called relayers—to enable fast, capital-efficient transfers of ERC-20 tokens between Ethereum mainnet and Layer 2 networks such as Optimism, Arbitrum, and Polygon. Relayers front user funds immediately on the destination chain and are reimbursed from a liquidity pool on Ethereum after an optimistic challenge period, creating a bridge architecture that prioritises speed and low fees over trustless finality."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:dependsOn ngm:ethereum,
        ngm:layer-2-solutions ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:interoperability-protocol ;
    vc:slug "across-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:liquidity-pool,
        ngm:liquidity-provider .

ngm:action-recognition a owl:Class ;
    rdfs:label "Action Recognition"@en ;
    rdfs:comment "Action Recognition is a computer-vision task that classifies the activity being performed by one or more agents from video or motion-sequence data. Models ingest spatiotemporal features, often built on detected body keypoints or 3D convolutions and transformers, to label actions such as walking, waving, or falling. It underpins applications in surveillance, sports analytics, human-robot interaction, and assistive monitoring."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation ;
    vc:slug "action-recognition" ;
    vc:sourceDomain "ai" .

ngm:adapter-slot a owl:Class ;
    rdfs:label "Adapter Slot"@en ;
    rdfs:comment "A pluggable interface architecture (ADR-005) providing five standardised slots through which a VisionClaw Agentic Container|VisionClaw agent interacts with its environment: Solid Pod Storage|Pod (persistent storage), Agent Memory|Memory (episodic and semantic),"@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:deployment-flexibility,
        ngm:pluggable-memory,
        ngm:pluggable-storage,
        ngm:pluggable-telemetry,
        ngm:pluggable-work-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bead-adapter,
        ngm:event-adapter,
        ngm:memory-adapter,
        ngm:orchestrator-adapter,
        ngm:pod-adapter ;
    vc:implements ngm:adapter-pattern,
        ngm:dependency-injection,
        ngm:strategy-pattern ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:requires ngm:interface-specification,
        ngm:manifest-declaration,
        ngm:runtime-initialization ;
    vc:slug "adapter-slot" ;
    vc:sourceDomain "infrastructure" .

ngm:adaptive-behaviour a owl:Class ;
    rdfs:label "Adaptive Behaviour"@en ;
    rdfs:comment "Adaptive behaviour refers to the capacity of an agent, system, or organism to modify its actions, strategies, or responses in real time based on feedback from its environment, internal state, or prior experience. In computational and robotics contexts, it describes dynamic adjustment of policies or control laws to optimise performance under changing conditions. The concept underpins reinforcement learning, autonomous agents, and self-organising systems."@en ;
    rdfs:subClassOf ngm:agent ;
    vc:enables ngm:adaptive-control,
        ngm:embodied-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-based-models,
        ngm:multi-agent-systems ;
    vc:slug "adaptive-behaviour" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-reinforcement-learning,
        ngm:policy-optimisation .

ngm:adaptive-manipulation a owl:Class ;
    rdfs:label "Adaptive Manipulation"@en ;
    rdfs:comment "Adaptive manipulation is a subfield of robotics concerned with enabling robotic systems to grasp, move, and interact with objects in unstructured environments by continuously adapting grasp strategies, force application, and motion trajectories based on sensory feedback. It combines perception, planning, and control to handle variability in object geometry, material properties, and placement that defeats fixed pre-programmed approaches. Applications span industrial automation, surgical robotics, and service robots operating in human-centred spaces."@en ;
    rdfs:subClassOf ngm:manipulation ;
    vc:enables ngm:compliant-manipulation,
        ngm:dexterous-manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector ;
    vc:slug "adaptive-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:deep-reinforcement-learning,
        ngm:force-control,
        ngm:haptic-feedback .

ngm:adaptive-music a owl:Class ;
    rdfs:label "Adaptive Music"@en ;
    rdfs:comment "Adaptive music is a compositional and audio-engineering approach in which a musical soundtrack modifies its structure, instrumentation, tempo, or emotional register dynamically in response to real-time contextual signals such as player actions, narrative state, or environmental parameters within interactive media. It replaces the static looping of pre-composed tracks with a system that maintains musical coherence while reflecting the moment-to-moment state of an interactive experience. The technique is foundational to game audio design and is increasingly applied in extended reality, therapeutic, and generative AI contexts."@en ;
    rdfs:subClassOf ngm:audio-system ;
    vc:enables ngm:emergent-gameplay,
        ngm:immersive-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:game-ai ;
    vc:slug "adaptive-music" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:audio-engine,
        ngm:game-engine .

ngm:adaptive-virtual-experience a owl:Class ;
    rdfs:label "Adaptive Virtual Experience"@en ;
    rdfs:comment "Adaptive Virtual Experience refers to AI-driven immersive environments that dynamically adjust content, difficulty, pacing, and presentation in real-time based on user behavior, preferences, physiological responses, and interaction patterns to deliver personalized and engaging virtual reality exp..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-analytics ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:dynamic-gaming,
        ngm:personalized-learning,
        ngm:therapeutic-vr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:machine-learning,
        ngm:real-time-analytics,
        ngm:user-behavior-tracking ;
    vc:slug "adaptive-virtual-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:adaptive-virtual-world a owl:Class ;
    rdfs:label "Adaptive Virtual World"@en ;
    rdfs:comment "Adaptive Virtual World describes a metaverse environment that uses procedural generation, AI-driven content creation, and real-time user behavior analysis to dynamically evolve landscapes, structures, weather patterns, NPCs, and game mechanics in response to collective and individual user actions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:procedural-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-ai ],
        ngm:sc-platform-and-environment,
        ngm:virtual-world ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:emergent-gameplay,
        ngm:persistent-world-evolution,
        ngm:personalized-environments ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:generative-ai,
        ngm:neural-network,
        ngm:procedural-generation ;
    vc:slug "adaptive-virtual-world" ;
    vc:sourceDomain "spatial-computing" .

ngm:adas a owl:Class ;
    rdfs:label "ADAS"@en ;
    rdfs:comment "Advanced Driver Assistance Systems (ADAS) are electronic systems that assist vehicle operators with driving and parking functions through automated technologies including adaptive cruise control, lane keeping assist, automatic emergency braking, blind spot detection, and parking assistance. ADAS operates at SAE Level 1–2 automation, augmenting rather than replacing the driver, and relies on sensor fusion across cameras, radar, and ultrasonic systems to perceive the vehicle's environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:autonomous-vehicle,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:risk ;
    vc:requires ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "adas" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:computer-vision,
        ngm:lidar .

ngm:address a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "A blockchain Address is a compact, human-transmissible identifier derived from a public key via cryptographic hashing (typically SHA-256 followed by RIPEMD-160 for Bitcoin, or Keccak-256 for Ethereum), which designates the recipient or controller of blockchain funds or smart-contract state. Addresses function as pseudonymous identifiers: they reveal nothing about the owner's real identity while allowing cryptographic proof of ownership through digital signature with the corresponding private key. They are encoded in formats such as Base58Check (Bitcoin legacy), Bech32 (Bitcoin native SegWit), or hexadecimal with EIP-55 checksum (Ethereum)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-transaction,
        ngm:digital-identity,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:account-model,
        ngm:digital-wallet,
        ngm:hash-function,
        ngm:secp256k1,
        ngm:utxo-model ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography ;
    vc:slug "address" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature,
        ngm:private-key,
        ngm:public-key .

ngm:ade20-k a owl:Class ;
    rdfs:label "ADE20K"@en ;
    rdfs:comment "ADE20K is a large-scale image segmentation dataset containing over 25,000 images annotated with 150 semantic categories covering both indoor and outdoor scenes, released by MIT's Computer Science and Artificial Intelligence Laboratory (CSAIL) in 2017. It provides pixel-level semantic, instance, and part-level annotations that enable training and benchmarking of scene parsing and semantic segmentation models. ADE20K serves as the foundational benchmark for the ImageNet Scene Parsing Challenge and has driven significant advances in dense prediction architectures."@en ;
    rdfs:subClassOf ngm:benchmarks ;
    vc:enables ngm:instance-segmentation,
        ngm:panoptic-segmentation,
        ngm:semantic-segmentation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:coco-dataset,
        ngm:image-segmentation ;
    vc:slug "ade20-k" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:data-annotation .

ngm:affective-computing-system a owl:Class ;
    rdfs:label "Affective Computing System"@en ;
    rdfs:comment "An Affective Computing System is a computational architecture that can recognise, interpret, simulate, or respond to human emotional and affective states through the integration of multimodal physiological and behavioural signals with machine learning models. Such systems aim to make human-computer interaction more natural and context-sensitive by treating emotion as a first-class computational variable."@en ;
    rdfs:subClassOf ngm:affective-computing ;
    vc:enables ngm:adaptive-interfaces,
        ngm:adaptive-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science ;
    vc:slug "affective-computing-system" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:behavioral-modeling,
        ngm:facial-recognition,
        ngm:natural-language-processing .

ngm:agentic-finance a owl:Class ;
    rdfs:label "Agentic Finance"@en ;
    rdfs:comment "Infrastructure enabling autonomous AI agents to hold cryptographic wallets, provision compute resources, negotiate contracts, and transact with other agents or humans without intermediaries. AgentFi bridges decentralised finance protocols with agentic AI systems, creating machine-to-machine economic coordination layers."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:agentic-internet,
        ngm:ai-application ;
    vc:dependsOn ngm:decentralized-finance-de-fi,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:smart-contract ;
    vc:slug "agentic-finance" ;
    vc:sourceDomain "blockchain" .

ngm:agentic-rag a owl:Class ;
    rdfs:label "Agentic RAG"@en ;
    rdfs:comment "Agentic RAG is an architecture that augments retrieval-augmented generation with an autonomous agent loop, letting a language model plan, decide when and what to retrieve, issue multiple queries, and verify results before answering. Unlike single-shot RAG, it can route between sources, reformulate queries, and iterate retrieval and reasoning steps until a confidence threshold is met. This improves accuracy on multi-hop and ambiguous questions at the cost of higher latency and orchestration complexity."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rag-pipeline,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "agentic-rag" ;
    vc:sourceDomain "ai" .

ngm:ai-agent-coordination a owl:Class ;
    rdfs:label "AI Agent Coordination"@en ;
    rdfs:comment "AI Agent Coordination is the set of mechanisms by which multiple autonomous AI agents align their actions, share state, allocate tasks, and resolve conflicts to achieve goals that exceed any single agent's capability. It covers communication protocols, role assignment, consensus, and negotiation, and may be centralized through an orchestrator or fully decentralized. Effective coordination is essential for multi-agent systems operating over shared resources or distributed ledgers."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-coordination,
        ngm:rgb-and-client-side-validation ;
    vc:slug "ai-agent-coordination" ;
    vc:sourceDomain "ai" .

ngm:ai-agent-payments a owl:Class ;
    rdfs:label "AI Agent Payments"@en ;
    rdfs:comment "AI Agent Payments refers to the infrastructure, protocols, and economic mechanisms that enable autonomous AI agents to initiate, authorise, and settle financial transactions on behalf of users or autonomously as principals, spanning micropayment rails for API service consumption, programmatic access to payment networks, and identity-bound wallet abstractions that constrain agent spending to authorised scopes and budgets."@en ;
    rdfs:subClassOf ngm:agentic-finance ;
    vc:enables ngm:agentic-internet,
        ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance ;
    vc:slug "ai-agent-payments" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:digital-currency,
        ngm:lightning-network,
        ngm:micropayments .

ngm:ai-art-categorization a owl:Class ;
    rdfs:label "Ai Art Categorization"@en ;
    rdfs:comment "AI Art Categorization encompasses taxonomies, classification systems, and machine learning mods for organizing, labeling, and evaluating AI-generated and AI-assisted artworks based on creation modology, style, medium, aesthetic properties, and the degree of autonomous system involvement in the cr..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:ai-application,
        ngm:governance ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:art-curation,
        ngm:authenticity-detection,
        ngm:style-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:art-historical-knowledge,
        ngm:computer-vision,
        ngm:deep-learning ;
    vc:slug "ai-art-categorization" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-art-generation a owl:Class ;
    rdfs:label "AI Art Generation"@en ;
    rdfs:comment "AI Art Generation is the production of visual artwork by generative models, most commonly text-to-image diffusion systems that synthesize images from natural-language prompts. Outputs can be steered through prompting, fine-tuning, and lightweight adapters such as LoRA or DreamBooth that teach a model new subjects or styles. It has reshaped creative workflows in illustration, concept art, and design while raising questions about training-data provenance and authorship."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:kohya-dreambooth-and-similar ;
    vc:slug "ai-art-generation" ;
    vc:sourceDomain "ai" .

ngm:ai-concept a owl:Class ;
    rdfs:label "AI Concept"@en ;
    rdfs:comment "The foundational theoretical constructs and abstract principles underlying artificial intelligence systems, encompassing both symbolic approaches (knowledge representation, logic-based reasoning) and subsymbolic methods (connectionist networks, distributed representations). AI Concepts define learning paradigms, reasoning mechanisms, and cognitive architectures that serve as the theoretical basis for designing, evaluating, and advancing intelligent systems across research and application domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:explainability,
        ngm:neural-network ;
    vc:requires ngm:knowledge-representation ;
    vc:slug "ai-concept" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-ecosystem a owl:Class ;
    rdfs:label "AI Ecosystem"@en ;
    rdfs:comment "The AI Ecosystem is the interconnected network of organisations, technologies, standards, talent pipelines, regulatory frameworks, and capital flows that collectively produce, deploy, and govern artificial intelligence systems. It encompasses foundation model providers, cloud infrastructure operators, toolchain vendors, application developers, research institutions, standardisation bodies, and end-user communities, together constituting the supply chain and governance fabric of AI as a general-purpose technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-frameworks ],
        ngm:digital-asset-ecosystem ;
    vc:enables ngm:agentic-ai,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-frameworks,
        ngm:ai-inference,
        ngm:large-language-models ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-policy ;
    vc:slug "ai-ecosystem" ;
    vc:sourceDomain "ai" .

ngm:ai-energy-scarcity a owl:Class ;
    rdfs:label "AI Energy Scarcity"@en ;
    rdfs:comment "Systemic infrastructure bottleneck where exponential growth in AI training and inference compute demand outstrips available energy supply and grid capacity. Drives hyperscaler investment in dedicated power generation including small modular reactors (SMRs) and nuclear recommissioning, while creating geopolitical competition for compute sovereignty."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:bitcoin-mining ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:competition-in-ai,
        ngm:energy-and-power,
        ngm:large-language-models ;
    vc:slug "ai-energy-scarcity" ;
    vc:sourceDomain "infrastructure" .

ngm:ai-evaluation a owl:Class ;
    rdfs:label "AI Evaluation"@en ;
    rdfs:comment "AI Evaluation is the systematic measurement of model capabilities, reliability, safety, and alignment using benchmarks, held-out tasks, human preference judgments, and automated graders. It produces quantitative metrics and qualitative findings that guide model selection, release decisions, and risk assessment. Robust evaluation must guard against benchmark contamination, distribution shift, and over-optimization toward narrow scores."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:evaluation-benchmarks-and-leaderboards,
        ngm:evaluation-metric ;
    vc:slug "ai-evaluation" ;
    vc:sourceDomain "ai" .

ngm:ai-governance-maturity-model a owl:Class ;
    rdfs:label "AI Governance Maturity Model"@en ;
    rdfs:comment "AI Governance Maturity Model is an assessment framework that defines progressive maturity levels for AI governance capabilities across multiple dimensions, enabling organizations to evaluate current practices, identify gaps, benchmark against peers, and guide continuous improvement toward trustwo..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
