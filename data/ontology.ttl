# Accessibility Standards
spatial-computing:AccessibilityStandards rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DesignStandards ;
    rdfs:label "Accessibility Standards"@en ;
    rdfs:comment "Accessibility Standards for the metaverse and extended reality (XR) encompass guidelines, technical specifications, and design principles that ensure virtual environments, interfaces, and interactions are usable by people with diverse disabilities including visual, auditory, physical, cognitive, and neurological impairments."@en ;
    skos:prefLabel "Accessibility Standards"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:accessibility-standards" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:accessibility-standards> ;
    vcw:contentHash "sha256-12-6a433de8034b" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
