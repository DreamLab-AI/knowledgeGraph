ngm:quality-standard a owl:Class ;
    rdfs:label "Quality Standard"@en ;
    rdfs:comment "A Quality Standard is a formally published specification that defines measurable requirements for quality management, process control, testing methodology, and conformance verification in robot manufacturing and deployment contexts. Quality standards provide the normative benchmarks against which robotic systems are assessed for reliability, safety, and fitness for purpose across their operational lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing-process ],
        ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:compliance-framework,
        ngm:compliance-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-control,
        ngm:compliance-standards ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-audit-trail,
        ngm:compliance-dashboard,
        ngm:robotics-systems ;
    vc:requires ngm:compliance-verification,
        ngm:testing-process ;
    vc:slug "quality-standard" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:robotics ;
    vc:uses ngm:iso-standards,
        ngm:testing-infrastructure .

