    vc:slug "zk-rollup" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .
ngm:zk-rollups a skos:Concept ;
    rdfs:label "ZK Rollups"@en .
ngm:zk-snark a owl:Class ;
    rdfs:comment "A ZK-SNARK (Zero-Knowledge Succinct Non-Interactive Argument of Knowledge) is a cryptographic proof system that allows a prover to convince a verifier that a computational statement is true without revealing any information beyond the validity of the statement itself. The proof is succinct — its size and verification time are sub-linear (often constant or logarithmic) relative to the underlying computation — and non-interactive, requiring no back-and-forth messages between prover and verifier. Most constructions rely on bilinear pairings over elliptic curves and require a one-time trusted setup ceremony to generate a structured reference string."@en ;
    rdfs:label "ZK-SNARK"@en ;
    rdfs:subClassOf ngm:zero-knowledge-proof ;
    rdfs:subClassOf _:r22618 ;
    rdfs:subClassOf _:r22619 ;
    rdfs:subClassOf _:r22620 ;
    rdfs:subClassOf _:r22621 ;
    vc:bridgesTo ngm:de-fi ;
    vc:bridgesTo ngm:machine-learning-privacy ;
    vc:bridgesTo ngm:smart-contract ;
    vc:contrastsWith ngm:bulletproof ;
    vc:contrastsWith ngm:interactive-proof ;
    vc:contrastsWith ngm:zk-starks ;
    vc:enables ngm:groth-16 ;
    vc:enables ngm:private-transaction ;
    vc:enables ngm:rollup ;
    vc:enables ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:non-interactive-proof ;
    vc:implements ngm:succinct-argument ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:groth-16 ;
    vc:relatedTo ngm:plonk ;
    vc:relatedTo ngm:zcash ;
    vc:requires ngm:arithmetic-circuit ;
    vc:requires ngm:bilinear-pairing ;
    vc:requires ngm:elliptic-curve-cryptography ;
    vc:requires ngm:trusted-setup ;
    vc:slug "zk-snark" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain ;
    vc:supports ngm:identity-verification ;
    vc:supports ngm:privacy-preserving-computation ;
    vc:uses ngm:fiat-shamir-heuristic ;
    vc:uses ngm:polynomial-commitment ;
    vc:uses ngm:rank-1-constraint-system .
ngm:zk-snarks a owl:Class ;
    rdfs:comment "Zero-Knowledge Succinct Non-Interactive Arguments of Knowledge - a cryptographic proof system enabling one party to prove possession of information without revealing the information itself, characterized by small proof sizes, fast verification, and no interaction required between prover and verif..."@en ;
    rdfs:label "ZK-SNARKs"@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    rdfs:subClassOf ngm:zero-knowledge-proof ;
    rdfs:subClassOf _:r22622 ;
    rdfs:subClassOf _:r22623 ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:enables ngm:confidential-computing ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain ;
    vc:relatedTo ngm:homomorphic-encryption ;
    vc:relatedTo ngm:identity ;
    vc:requires ngm:cryptography ;
    vc:requires ngm:elliptic-curve-cryptography ;
    vc:slug "zk-snarks" ;
    vc:sourceDomain "spatial-computing" .
ngm:zk-starks a owl:Class ;
    rdfs:comment "Zero-Knowledge Scalable Transparent Arguments of Knowledge: a cryptographic proof system enabling verification of computations without revealing underlying data. Unlike ZK-SNARKs, STARKs require no trusted setup, are conjectured to be quantum-resistant, and scale efficiently for large witness sizes, making them foundational for Layer 2 blockchain rollups and privacy-preserving computation."@en ;
    rdfs:label "ZK-STARKs"@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    rdfs:subClassOf ngm:zero-knowledge-proof ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:smart-contracts ;
    vc:enables ngm:blockchain-scalability ;
    vc:enables ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:zero-knowledge-proof ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance ;
    vc:slug "zk-starks" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:elliptic-curve-cryptography .
ngm:zk-sync a owl:Class ;
    rdfs:comment "zkSync is an Ethereum layer-2 scaling network developed by Matter Labs that uses zero-knowledge rollup technology to settle transactions on Ethereum with validity proofs. Its main network, zkSync Era, is a zk-rollup with an EVM-compatible execution environment, allowing many Ethereum smart contracts and tools to be used with minimal changes. By posting succinct proofs that each batch of transactions is valid, the network achieves Ethereum-level settlement security without an optimistic challenge period. zkSync is part of a broader effort to scale Ethereum through zero-knowledge cryptography."@en ;
    rdfs:label "zkSync"@en ;
    rdfs:subClassOf ngm:blockchain-domain ;
    rdfs:subClassOf ngm:network-component ;
    rdfs:subClassOf _:r23123 ;
    rdfs:subClassOf _:r23124 ;
    rdfs:subClassOf _:r23125 ;
    rdfs:subClassOf _:r23126 ;
    rdfs:subClassOf _:r23127 ;
