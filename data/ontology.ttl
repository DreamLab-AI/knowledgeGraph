    vc:slug "network-component" ;
    vc:sourceDomain "blockchain" .

ngm:overfitting a owl:Class ;
    rdfs:label "Overfitting"@en ;
    rdfs:comment "Overfitting is a phenomenon in machine learning where a model learns the training data too precisely—including noise and spurious correlations—resulting in poor generalisation to unseen data. It corresponds to high variance and low bias in the bias-variance tradeoff, and is mitigated through regularisation, dropout, early stopping, and data augmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:underfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:dropout,
        ngm:model-capacity ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "overfitting" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:pid-controller a owl:Class ;
    rdfs:label "Pid Controller"@en ;
    rdfs:comment "A PID Controller (Proportional-Integral-Derivative Controller) is a closed-loop feedback control algorithm that continuously calculates an error value as the difference between a desired setpoint and a measured process variable, then applies corrections based on proportional, integral, and derivative terms. PID controllers are foundational in robotics, autonomous systems, and industrial automation for precisely regulating position, velocity, and force."@en ;
    rdfs:subClassOf ngm:rb-0047-feedback-control,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:control-system,
        ngm:feedback-control ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:actuator,
        ngm:autonomous-system ;
    vc:slug "pid-controller" ;
    vc:sourceDomain "spatial-computing" .

ngm:robot-dynamics a owl:Class ;
    rdfs:label "Robot Dynamics"@en ;
    rdfs:comment "Robot Dynamics is the study of the forces, torques, and inertial properties that govern the motion of robotic systems. It encompasses forward dynamics (computing accelerations from applied forces) and inverse dynamics (computing required torques for a desired motion), underpinning trajectory planning, model-based control, and simulation. Accurate dynamic models are essential for high-speed manipulation, legged locomotion, and compliant human-robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:robot-safety,
        ngm:state-estimation ;
    vc:requires ngm:kinematics,
        ngm:torque ;
    vc:slug "robot-dynamics" ;
    vc:sourceDomain "robotics" .

ngm:smart-contract-execution a owl:Class ;
    rdfs:label "Smart Contract Execution"@en ;
    rdfs:comment "Smart contract execution is the deterministic, on-chain processing of immutable bytecode deployed at a blockchain address, triggered by an inbound transaction and evaluated by every validating node in the network. Execution occurs inside a sandboxed virtual machine—such as the Ethereum Virtual Machine (EVM)—which enforces gas metering to bound computation costs, ensures state isolation, and guarantees identical outputs across all nodes given the same inputs. Because execution is transparent and auditable, smart contracts can automate trustless multi-party agreements including token transfers, DeFi protocol logic, decentralised governance, and RWA settlement without relying on a central intermediary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-mechanism,
        ngm:gas ;
    vc:slug "smart-contract-execution" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:smart-contract .

ngm:software-testing a owl:Class ;
    rdfs:label "Software Testing"@en ;
    rdfs:comment "Software Testing is the systematic process of executing a software system or component under specified conditions, observing its behaviour, and evaluating whether it meets defined requirements. It encompasses unit, integration, system, and acceptance testing, as well as performance, security, and regression testing, forming a quality gate in the development lifecycle."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:simulation,
        ngm:xr-testing-infrastructure ;
    vc:slug "software-testing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:robustness,
        ngm:safety .

ngm:standards a owl:Class ;
    rdfs:label "Standards"@en ;
    rdfs:comment "Established tools, protocols, formats, services, and specifications that support the creation, operation, continuous improvement, and common use of metaverse technologies, enabling interoperability between disparate systems, platforms, and applications."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:metaverse ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:interoperability ;
    vc:slug "standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:text-to-image a owl:Class ;
    rdfs:label "Text-to-Image"@en ;
    rdfs:comment "A generative AI capability that synthesises visual imagery from natural language textual descriptions. Systems such as diffusion models iteratively denoise latent representations conditioned on text embeddings, enabling creation of photorealistic and artistic images from prompts without requiring explicit pixel-level instructions."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:3-d-content-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:generative-ai-engineering ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:image-generation,
        ngm:multimodal-ai,
        ngm:natural-language-processing ;
    vc:slug "text-to-image" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:prompt-engineering,
        ngm:transformer .

ngm:trusted-execution-environment a owl:Class ;
    rdfs:label "Trusted Execution Environment"@en ;
    rdfs:comment "A Trusted Execution Environment (TEE) is a hardware-enforced, isolated processing domain within a processor that guarantees confidentiality and integrity of code and data even if the host operating system or hypervisor is compromised. TEEs are instantiated via technologies such as Intel SGX, AMD SEV, and Arm TrustZone, each providing mechanisms for remote attestation so that a relying party can cryptographically verify the identity and integrity of the enclave before exchanging sensitive material. TEEs underpin confidential computing workloads including private AI inference, secure key management, and privacy-preserving data collaboration."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:cryptographic-key-management,
        ngm:privacy-enhancing-computation-pec ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:secure-enclave ;
    vc:slug "trusted-execution-environment" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hardware-security-module .

ngm:ai-impact-assessment a owl:Class ;
    rdfs:label "AI Impact Assessment"@en ;
    rdfs:comment "A systematic process for identifying, analysing, evaluating, and documenting the potential positive and negative effects of an artificial intelligence system on individuals, groups, organisations, society, and the environment across multiple dimensions including fundamental rights, ical principle..."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:informed-decision-making,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "ai-impact-assessment" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:asset-tokenisation a owl:Class ;
    rdfs:label "Asset Tokenisation"@en ;
    rdfs:comment "Asset tokenisation is the process of creating a blockchain-based digital token that represents a legally binding claim to ownership, revenue rights, or access rights in an underlying real-world or digital asset — such as real estate, private equity, bonds, commodities, or intellectual property. By encoding ownership on a programmable ledger, tokenisation enables fractional ownership at low minimum investment thresholds, continuous secondary trading, automated compliance through smart contract logic, and global settlement without traditional intermediaries. It sits at the convergence of financial regulation, smart contract engineering, and digital asset infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:real-world-asset-tokenisation,
        ngm:token-standard ;
    vc:requires ngm:regulatory-compliance ;
    vc:slug "asset-tokenisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-asset,
        ngm:smart-contracts .

ngm:block a owl:Class ;
    rdfs:label "Block"@en ;
    rdfs:comment "The fundamental unit of a blockchain: a cryptographically linked, immutable data container that batches a set of transactions together with a block header containing the Merkle root of those transactions, a timestamp, the previous block's hash, and consensus-specific fields such as a nonce or validator signature. Sequential blocks form the chain that provides an append-only audit trail."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coinbase-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:blockchain-transaction,
        ngm:coinbase-transaction,
        ngm:merkle-root ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:block-reward,
        ngm:block-size,
        ngm:block-time,
        ngm:genesis-block ;
    vc:slug "block" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:merkle-tree .

ngm:calibration a owl:Class ;
    rdfs:label "Calibration"@en ;
    rdfs:comment "Calibration in robotics and sensing is the systematic process of determining, verifying, and correcting the quantitative relationship between a sensor's or actuator's raw output and the physical quantity it represents, encompassing intrinsic parameters (gain, offset, nonlinearity), extrinsic parameters (pose relative to a reference frame), and inter-sensor spatial relationships. Calibration is prerequisite for metrically accurate perception, closed-loop control, and multi-modal Sensor Fusion in robotic systems. It applies to diverse transducers including cameras, Lidar scanners, IMUs, force-torque sensors, joint encoders, and end-effector tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:camera-calibration,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:imu,
        ngm:robot-sensor ;
    vc:slug "calibration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-control,
        ngm:slam .

ngm:censorship-resistance a owl:Class ;
    rdfs:label "Censorship Resistance"@en ;
    rdfs:comment "Property of blockchain networks guaranteeing that any valid transaction submitted by any participant will eventually be included in the canonical chain, preventing miners, validators, or any coordinated group from systematically excluding transactions. Achieved through decentralised consensus, permissionless participation, and economic incentive alignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:decentralized-governance,
        ngm:immutability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:byzantine-fault-tolerance,
        ngm:double-spending,
        ngm:fork-choice-rule,
        ngm:peer-discovery ;
    vc:requires ngm:consensus-mechanism,
        ngm:peer-to-peer-network,
        ngm:sybil-resistance ;
    vc:slug "censorship-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:dc-protocol-and-infra a owl:Class,
        skos:Concept ;
    rdfs:label "Protocol and Infrastructure"@en ;
    rdfs:comment "Taxonomy hub for the communication protocols, data-interchange formats, and underlying infrastructure that enable distributed collaboration. Encompasses decentralised messaging protocols, identity systems, content-addressed storage, version control, and the networking substrate on which remote collaborative workflows operate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipfs ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nostr-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:crdt ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:communication-protocol,
        ngm:crdt,
        ngm:ipfs,
        ngm:nostr-protocol,
