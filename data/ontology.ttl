    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-communication,
        ngm:asynchronous-video,
        ngm:audio-technology,
        ngm:knowledge-management,
        ngm:remote-collaboration ;
    vc:slug "voice-memo" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:automatic-speech-recognition,
        ngm:natural-language-processing,
        ngm:speech-recognition .

ngm:vp-robotics-project a owl:Class ;
    rdfs:label "VP robotics project"@en ;
    rdfs:comment "The VP Robotics Project (VisionFlow) is a feasibility study investigating the integration of robotic camera control with machine learning and virtual production workflows. It inverts conventional pre-visualisation pipelines by deriving scene-driven camera motion from AI-generated content, combining open-source robotics software with parallax-plates-as-a-service delivery for the film and television industry."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:virtual-production,
