ngm:web-api a owl:Class ;
    rdfs:label "Web Api"@en ;
    rdfs:comment "A web API is an application programming interface exposed over the web using HTTP, allowing programs to request and exchange data with a remote service rather than rendering pages for humans. It defines a contract of endpoints, request and response formats, authentication and error semantics, commonly returning structured data such as JSON. Web APIs are the backbone of integration between applications, mobile clients, microservices and third-party platforms, with REST and GraphQL being two prevailing architectural styles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:client-server-architecture ],
        ngm:api-design ;
    vc:bridgesTo ngm:microservices ;
    vc:dependsOn ngm:web-standards ;
    vc:enables ngm:interoperability,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:http ;
    vc:implements ngm:rest ;
    vc:isPartOf ngm:api-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:client-server-architecture,
        ngm:rest,
        ngm:web-standards ;
    vc:requires ngm:client-server-architecture ;
    vc:slug "web-api" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:interoperability,
        ngm:microservices ;
    vc:uses ngm:http .

ngm:web-browser a skos:Concept ;
    rdfs:label "Web Browser"@en .

ngm:weight-initialisation a owl:Class ;
    rdfs:label "Weight Initialisation"@en ;
    rdfs:comment "Weight initialisation is the procedure of assigning starting values to the trainable parameters of a neural network before training commences. The choice of initialisation scheme affects gradient flow, convergence speed, and the avoidance of vanishing or exploding activations across deep layers. Common schemes such as Xavier (Glorot) and He initialisation scale the variance of initial weights according to layer fan-in and fan-out."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:neural-network-training ;
    vc:bridgesTo ngm:transfer-learning ;
    vc:contrastsWith ngm:batch-normalisation,
        ngm:regularisation ;
    vc:dependsOn ngm:activation-function,
        ngm:backpropagation ;
    vc:enables ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-training,
        ngm:neural-network-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:activation-function,
        ngm:deep-learning,
        ngm:neural-network ;
    vc:requires ngm:gradient-descent ;
    vc:slug "weight-initialisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:convolutional-neural-network,
        ngm:recurrent-neural-network ;
    vc:uses ngm:optimiser .

ngm:wgsl a owl:Class ;
    rdfs:label "WGSL"@en ;
    rdfs:comment "WGSL (WebGPU Shading Language) is the shader programming language of the WebGPU API, used to write vertex, fragment, and compute shaders that run on the GPU from web applications. Designed for safety and portability, it maps cleanly onto native backends (Vulkan, Metal, Direct3D) while avoiding the platform-specific behaviours of older shading languages. WGSL is central to high-performance graphics and GPU compute on the modern web."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "wgsl" ;
    vc:sourceDomain "metaverse" .

ngm:wheeled-mobile-robot a owl:Class ;
    rdfs:label "Wheeled Mobile Robot"@en ;
    rdfs:comment "A mobile robot that uses wheels as its primary locomotion mechanism, enabling efficient navigation on flat or structured surfaces. Wheeled mobile robots span applications from industrial logistics and warehouse automation to outdoor infrastructure maintenance, typically combining SLAM-based navigation, sensor fusion, and modular payloads."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot,
        ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "wheeled-mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:sensor-fusion,
        ngm:slam .

ngm:word-piece a owl:Class ;
    rdfs:label "WordPiece"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges character sequences by maximising the likelihood of the training corpus under a unigram language model, rather than merging the most frequent pairs. WordPiece is the default tokeniser for BERT, DistilBERT, and ELECTRA, producing vocabularies of approximately 30,000 tokens that handle rare and compound words via subword splitting."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:byte-pair-encoding,
        ngm:sentence-piece ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-text-tokenisation,
        ngm:subword-tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "word-piece" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:vocabulary .

ngm:workforce-management a owl:Class ;
    rdfs:label "Workforce Management"@en ;
    rdfs:comment "Workforce Management (WFM) encompasses the integrated set of processes, technologies, and practices that organisations use to optimise employee productivity, schedule labour resources, track attendance and time, manage compliance with labour regulations, and forecast staffing requirements. Modern WFM systems combine real-time data on demand, skill availability, and operational constraints to generate optimised schedules, and increasingly incorporate AI-driven forecasting and adaptive scheduling algorithms. The field is undergoing significant transformation as AI automation shifts skill requirements, gig economy models create more fluid workforce composition, and remote and hybrid working patterns demand new coordination approaches."@en ;
    rdfs:subClassOf ngm:workforce-development ;
    vc:enables ngm:agentic-workflow,
        ngm:customer-service-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-connected-workforce,
        ngm:planning-and-scheduling,
        ngm:workforce-augmentation ;
    vc:slug "workforce-management" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-driven-workforce-displacement-registry ;
    vc:uses ngm:automated-compliance,
        ngm:machine-learning-discipline .

ngm:xacml a owl:Class ;
    rdfs:label "XACML"@en ;
    rdfs:comment "XACML (eXtensible Access Control Markup Language) is an OASIS standard that defines a declarative, XML-based language for expressing access-control policies and the requests and responses used to evaluate them. It specifies a reference architecture separating policy decision, enforcement, administration and information points, enabling fine-grained, attribute-based authorisation across heterogeneous systems. XACML lets organisations externalise authorisation logic from applications into centrally managed policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-decision-point ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-enforcement-point ],
        ngm:attribute-based-access-control ;
    vc:enables ngm:access-control,
        ngm:authorization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:policy-decision-point,
        ngm:policy-enforcement-point ;
    vc:implements ngm:attribute-based-access-control ;
    vc:isPartOf ngm:access-control-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:identity-and-access-management,
        ngm:policy-engine,
        ngm:rbac ;
    vc:slug "xacml" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:oasis ;
    vc:supports ngm:security ;
    vc:uses ngm:xml .

ngm:xr-headset a owl:Class ;
    rdfs:label "XR Headset"@en ;
    rdfs:comment "A head-mounted display device that delivers immersive visual and audio experiences for virtual reality, augmented reality, or mixed reality applications, featuring integrated displays, tracking sensors, audio systems, and processing capabilities for rendering digital content in the user's field of view."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tracking-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:six-degrees-of-freedom ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:micro-oled-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-xr-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:sc-display-and-rendering,
        ngm:xr-hardware ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:artificial-intelligence,
