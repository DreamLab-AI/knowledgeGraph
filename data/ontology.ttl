    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc721" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum-smart-contract-platform,
        ngm:provenance-tracking .

ngm:error-calculation a owl:Class ;
    rdfs:label "Error Calculation"@en ;
    rdfs:comment "Error calculation is the step in a control system that computes the difference between a desired setpoint and the measured process variable. This error term is the input that drives corrective action in feedback controllers such as PID loops. Accurate, low-latency error calculation is essential for stable and responsive position, velocity, and other regulated control behaviours."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:velocity-control ;
    vc:slug "error-calculation" ;
    vc:sourceDomain "robotics" .

ngm:error-recovery a skos:Concept ;
    rdfs:label "Error Recovery"@en .

ngm:ethereum-smart-contract-platform-attestation-service a owl:Class ;
    rdfs:label "Ethereum Attestation Service"@en ;
    rdfs:comment "The Ethereum Attestation Service (EAS) is an open, public infrastructure for making on-chain and off-chain attestations about any subject using registered, reusable schemas. Each attestation is a signed, timestamped claim that can be verified, revoked, and composed by other applications. EAS provides a neutral primitive for building reputation systems, identity credentials, and trust layers without a centralised issuer."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
