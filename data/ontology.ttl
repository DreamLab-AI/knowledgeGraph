    vc:slug "etsi-domain-governance-society" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-human-interface-governance a owl:Class ;
    rdfs:label "ETSI_Domain_Human_Interface___Governance"@en ;
    rdfs:comment "An ETSI subdomain addressing governance mechanisms, policy frameworks, and institutional structures governing human-centric systems in VirtualEnvironment|virtual environments."@en ;
