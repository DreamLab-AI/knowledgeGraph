ngm:analog-to-digital-converter a owl:Class ;
    rdfs:label "Analog To Digital Converter"@en ;
    rdfs:comment "Analog To Digital Converter (ADC) is an electronic component that converts continuous analog signals such as sound, light, or voltage into discrete digital representations through sampling, quantization, and encoding processes, enabling digital processing, storage, and transmission of real-world ..."@en ;
