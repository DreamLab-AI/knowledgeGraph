    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:prompt-engineering ;
    vc:slug "zero-shot-prompting" ;
    vc:sourceDomain "ai" .

ngm:zk-starks a owl:Class ;
    rdfs:label "ZK-STARKs"@en ;
    rdfs:comment "Zero-Knowledge Scalable Transparent Arguments of Knowledge: a cryptographic proof system enabling verification of computations without revealing underlying data. Unlike ZK-SNARKs, STARKs require no trusted setup, are conjectured to be quantum-resistant, and scale efficiently for large witness sizes, making them foundational for Layer 2 blockchain rollups and privacy-preserving computation."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:smart-contracts ;
    vc:enables ngm:blockchain-scalability,
        ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:zero-knowledge-proof ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance ;
    vc:slug "zk-starks" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:elliptic-curve-cryptography .

