ngm:automated-modeling a owl:Class ;
    rdfs:label "Automated Modeling"@en ;
    rdfs:comment "The application of AI and machine learning techniques to automatically generate, refine, or parameterise three-dimensional models and spatial environments, reducing manual content-creation overhead in metaverse, digital-twin, and spatial-computing platforms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:neural-network ;
    vc:enables ngm:generative-ai,
        ngm:metaverse-domain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "automated-modeling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning-model .

