ngm:confidential-computing a owl:Class ;
    rdfs:label "Confidential Computing"@en ;
    rdfs:comment "Confidential Computing is a hardware-based security paradigm protecting data in use by isolating computation within trusted execution environments (TEEs) backed by processor security extensions, ensuring that sensitive data and code remain encrypted and protected even from privileged software, op..."@en ;
