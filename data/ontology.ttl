    vc:sourceDomain "blockchain" .

ngm:lightning-network-specification a owl:Class ;
    rdfs:label "Lightning Network Specification"@en ;
    rdfs:comment "The Lightning Network Specification, known as BOLT (Basis of Lightning Technology), is the set of documents defining the peer-to-peer protocol for Bitcoin's Lightning payment-channel network. It standardises channel establishment, commitment transactions, HTLC-based routing, onion message encryption, and gossip propagation so that independent implementations interoperate. The specification is the canonical reference enabling trust-minimised off-chain Bitcoin payments."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3,
        ngm:taproot-assets ;
    vc:slug "lightning-network-specification" ;
    vc:sourceDomain "blockchain" .

ngm:lightning-service-provider a owl:Class ;
    rdfs:label "Lightning Service Provider"@en ;
    rdfs:comment "A Lightning Service Provider is a business that supplies channel liquidity and connectivity services to Lightning Network users. It helps wallets open channels and receive payments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        ngm:lightning-network ;
    vc:enables ngm:phoenix ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:lightning,
        ngm:payment-channel ;
    vc:slug "lightning-service-provider" ;
    vc:sourceDomain "blockchain" .

ngm:linked-data-consumption a owl:Class ;
    rdfs:label "Linked Data Consumption"@en ;
    rdfs:comment "Linked data consumption is the process by which applications dereference, parse, and integrate RDF resources discovered through URIs and typed links across distributed sources. It involves following links, reconciling vocabularies, and querying federated graphs to assemble a coherent view of decentralised data. Robust consumption underpins the Semantic Web's promise of machine-readable, interoperable information."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:linked-data-encoder ;
    vc:slug "linked-data-consumption" ;
    vc:sourceDomain "data" .

ngm:liquidity a owl:Class ;
    rdfs:label "Liquidity"@en ;
    rdfs:comment "The degree to which an asset can be bought or sold quickly without causing a large change in its price. In decentralised markets liquidity is supplied by participants who deposit assets into pools or order books."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:de-fi ;
    vc:enables ngm:automated-market-maker,
        ngm:decentralized-exchange ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool ;
    vc:slug "liquidity" ;
    vc:sourceDomain "blockchain" .

ngm:lnp-bp-standards-association a owl:Class ;
    rdfs:label "LNP-BP Standards Association"@en ;
    rdfs:comment "The LNP-BP Standards Association is a non-profit body that develops and maintains specifications for Bitcoin and Lightning Network protocols, most notably the RGB smart-contract system and client-side validation. It curates the LNPBP specification series covering layer-2 and layer-3 constructs that extend Bitcoin without altering its base consensus. The association coordinates the engineers and researchers building these client-side-validated protocols."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3,
        ngm:rgb-and-client-side-validation ;
    vc:slug "lnp-bp-standards-association" ;
    vc:sourceDomain "blockchain" .

ngm:lo-ra-alliance a owl:Class ;
    rdfs:label "LoRa Alliance"@en ;
    rdfs:comment "The LoRa Alliance is an open, non-profit association that defines and certifies the LoRaWAN standard for low-power wide-area networking. It maintains the LoRaWAN specification, regional parameters, and a device-certification programme to ensure interoperability across vendors and operators. The alliance governs the ecosystem enabling long-range, low-power IoT connectivity."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:io-t-sensor-network,
        ngm:lo-ra-wan ;
    vc:slug "lo-ra-alliance" ;
    vc:sourceDomain "infrastructure" .

ngm:local-first-software a owl:Class ;
    rdfs:label "Local-First Software"@en ;
    rdfs:comment "Local-first software is a design philosophy in which the primary copy of a user's data lives on their own device, with the network used for optional synchronisation rather than as a dependency. It prioritises offline availability, low latency, data ownership, and longevity while still supporting real-time collaboration via conflict-free merging. The approach typically relies on CRDTs to reconcile concurrent edits across devices without a central authority."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:distributed-systems ;
    vc:slug "local-first-software" ;
    vc:sourceDomain "infrastructure" .

ngm:locality-sensitive-hashing a owl:Class ;
    rdfs:label "Locality-Sensitive Hashing"@en ;
    rdfs:comment "Locality-sensitive hashing (LSH) is a family of hashing techniques that map similar high-dimensional inputs to the same hash bucket with high probability, enabling sub-linear approximate nearest-neighbour search. By trading exactness for speed, LSH makes similarity search and deduplication tractable over very large datasets. It is widely applied to embeddings, document near-duplicate detection, and retrieval pipelines."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:training-data ;
    vc:slug "locality-sensitive-hashing" ;
    vc:sourceDomain "ai" .

ngm:locomotion a owl:Class ;
    rdfs:label "Locomotion"@en ;
    rdfs:comment "Locomotion is the capability of a robot or embodied agent to move its body through an environment by coordinating actuators against ground or fluid reaction forces. It encompasses gait generation, balance control, and trajectory execution across modalities such as legged walking, wheeled rolling, and aerial or aquatic propulsion. Robust locomotion is fundamental to autonomous mobility and physical task execution."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:mobile-robot ;
    vc:slug "locomotion" ;
    vc:sourceDomain "robotics" .

ngm:logistics-management a owl:Class ;
    rdfs:label "Logistics Management"@en ;
    rdfs:comment "Logistics management is the planning, execution, and control of the movement and storage of goods, services, and related information across a supply chain. It coordinates transportation, warehousing, inventory, order fulfilment, and reverse flows to meet demand at minimal cost and time. Effective logistics management directly determines service levels, working-capital efficiency, and resilience."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:reverse-logistics ;
    vc:slug "logistics-management" ;
    vc:sourceDomain "supply-chain" .

ngm:logistics-optimisation a owl:Class ;
    rdfs:label "Logistics Optimisation"@en ;
    rdfs:comment "Logistics optimisation is the application of mathematical optimisation and operations-research techniques to minimise cost or time across logistics operations such as routing, scheduling, and inventory placement. It formulates problems like vehicle routing, network flow, and bin packing, often solved with linear programming, heuristics, or machine learning. The goal is to extract maximal efficiency from constrained transport and storage resources."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation,
        ngm:demand-forecasting ;
    vc:slug "logistics-optimisation" ;
    vc:sourceDomain "supply-chain" .

ngm:long-short-term-memory a owl:Class ;
    rdfs:label "Long Short Term Memory"@en ;
    rdfs:comment "Long Short-Term Memory (LSTM) is a specialised recurrent neural network architecture introduced by Hochreiter and Schmidhuber (1997) that mitigates the vanishing gradient problem through gating mechanisms—input, forget, and output gates—enabling selective retention or forgetting of information across long sequences. LSTMs underpin sequence modelling tasks in natural language processing, time-series forecasting, and speech recognition, though they have largely been superseded by Transformer architectures for large-scale language tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:ai-model-architecture,
        ngm:recurrent-neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:attention,
        ngm:transformer ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-model-architecture,
        ngm:recurrent-neural-network ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:deep-learning ;
    vc:slug "long-short-term-memory" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:low-latency-interaction a owl:Class ;
    rdfs:label "Low-Latency Interaction"@en ;
    rdfs:comment "Low-latency interaction is the design property of a system in which the delay between a user action and the corresponding system response is minimised to preserve a sense of immediacy. In immersive and real-time contexts such as the metaverse, latency below roughly 20 milliseconds is critical to avoid perceptual disconnect and motion sickness. Achieving it requires optimised networking, predictive rendering, and edge computation."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:latency-management-protocol,
        ngm:networking-layer ;
    vc:slug "low-latency-interaction" ;
    vc:sourceDomain "metaverse" .

ngm:lower-limb-exoskeleton a owl:Class ;
    rdfs:label "Lower Limb Exoskeleton"@en ;
    rdfs:comment "A Lower Limb Exoskeleton is a wearable robotic device that attaches externally to the legs and pelvis to assist, augment, or rehabilitate walking and lower-body movements by generating torques at hip, knee, and ankle joints. Devices span fully-active systems driven by electric actuators or hydraulics, passive systems using spring and damping elements to redirect energy, and hybrid configurations combining both. Applications include stroke rehabilitation (restoring gait through repetitive, robot-guided movement therapy), spinal-cord-injury locomotion assistance, load-carrying augmentation for industrial and military tasks, and fall prevention in elderly populations. Control strategies range from finite-state machines triggered by gait-phase detection through inertial measurement units and pressure sensors, to intent-recognition systems integrating electromyography and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:exoskeleton-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:human-robot-interaction,
        ngm:safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:collision-avoidance,
        ngm:embodied-ai,
        ngm:iso-10218 ;
    vc:requires ngm:actuator,
        ngm:imu,
        ngm:sensor,
        ngm:torque ;
    vc:slug "lower-limb-exoskeleton" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:motion-planning,
        ngm:reinforcement-learning,
        ngm:variable-impedance-control .

ngm:lstm a owl:Class ;
    rdfs:label "LSTM"@en ;
    rdfs:comment "Long short-term memory: a recurrent neural network architecture that uses gating mechanisms and a memory cell to learn long-range dependencies and mitigate the vanishing gradient problem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:recurrent-neural-network ;
    vc:enables ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:backpropagation ;
    vc:slug "lstm" ;
    vc:sourceDomain "deep-learning" .

ngm:m-bridge a owl:Class ;
    rdfs:label "M-Bridge"@en ;
    rdfs:comment "mBridge (Project mBridge) is a multi-central-bank digital currency platform built on distributed ledger technology to enable real-time, cross-border, multi-currency payments and foreign-exchange settlement. Developed by the BIS Innovation Hub with central banks including those of China, Hong Kong, Thailand, and the UAE, it lets participating institutions transact wholesale CBDCs on a shared ledger. It aims to reduce cost, latency, and intermediary dependence in correspondent banking."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:hyperledger-iroha ;
    vc:slug "m-bridge" ;
    vc:sourceDomain "blockchain" .

ngm:manufacturing-domain a owl:Class ;
    rdfs:label "Manufacturing Domain"@en ;
    rdfs:comment "The Manufacturing Domain covers the design and operation of systems that produce physical goods at scale. Its scope includes process automation, industrial robotics, quality control and supply chain integration. It is a sub-area of the Robotics Domain concerned with production. The boundary excludes the financial analysis of production economics, which belongs to the Financial Markets Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:predictive-maintenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:process-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robotics-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems-domain ],
        ngm:robotics-domain ;
    vc:enables ngm:automated-production,
        ngm:defect-detection,
        ngm:operational-efficiency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:industrial-robotics,
        ngm:predictive-maintenance,
        ngm:process-automation,
        ngm:quality-control,
        ngm:supply-chain-integration ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-theory-domain,
        ngm:embedded-systems-domain,
        ngm:robotics-domain ;
    vc:slug "manufacturing-domain" ;
    vc:sourceDomain "manufacturing" .

ngm:marine-robot a owl:Class ;
    rdfs:label "Marine Robot"@en ;
    rdfs:comment "A robot designed to operate on or under water surfaces, encompassing unmanned surface vehicles (USVs), autonomous underwater vehicles (AUVs), and remotely operated vehicles (ROVs). Marine robots address unique challenges including buoyancy control, pressure resistance, underwater acoustic communication, and GPS-denied navigation using sonar and pressure sensors."@en ;
    rdfs:subClassOf ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aerial-robot,
        ngm:ground-robot,
        ngm:inspection-robot,
        ngm:remotely-operated-vehicle-rov,
        ngm:underwater-robot ;
    vc:slug "marine-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:pressure-sensor,
        ngm:sensor-fusion,
        ngm:slam .

ngm:market-abuse-detection a owl:Class ;
    rdfs:label "Market Abuse Detection"@en ;
    rdfs:comment "Market abuse detection is the use of surveillance systems and analytics to identify illegal trading behaviours such as insider dealing, spoofing, layering, and price manipulation. It analyses order-book activity, trade patterns, and communications to flag anomalies for compliance review and regulatory reporting. It is a core obligation under regimes such as the EU Market Abuse Regulation and is increasingly powered by machine learning."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:regulatory-reporting ;
    vc:slug "market-abuse-detection" ;
    vc:sourceDomain "governance" .

ngm:market-efficiency a owl:Class ;
    rdfs:label "Market Efficiency"@en ;
    rdfs:comment "Market efficiency is the degree to which asset prices fully and rapidly reflect all available information, leaving no systematic opportunity for risk-adjusted excess returns. The efficient-market hypothesis frames it in weak, semi-strong, and strong forms according to the information set incorporated. Higher efficiency implies accurate price signals, lower transaction costs, and effective capital allocation."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:price-discovery ;
    vc:slug "market-efficiency" ;
    vc:sourceDomain "blockchain" .

ngm:market-expansion a owl:Class ;
    rdfs:label "Market Expansion"@en ;
    rdfs:comment "Market expansion is the growth strategy of extending a product or service into new customer segments, geographies, or use cases to increase the total addressable market. In technology contexts it is often unlocked by removing access barriers such as language, cost, or accessibility limitations. It is a primary commercial outcome of capabilities like real-time translation and inclusive design."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:real-time-translation ;
    vc:slug "market-expansion" ;
    vc:sourceDomain "governance" .

ngm:marketplace-integration a owl:Class ;
    rdfs:label "Marketplace Integration"@en ;
    rdfs:comment "Systems and APIs that connect metaverse platforms with NFT marketplaces, e-commerce platforms, and digital asset trading systems, enabling seamless buying, selling, and trading of virtual goods, real estate, and collectibles."@en ;
    rdfs:subClassOf ngm:digital-commerce,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-commerce ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "marketplace-integration" ;
    vc:sourceDomain "spatial-computing" .

ngm:mass-adoption a owl:Class ;
    rdfs:label "Mass Adoption"@en ;
    rdfs:comment "Mass adoption is the stage at which a technology moves beyond early enthusiasts to be used by a large mainstream population. For blockchain and digital assets it implies usability, scalability, and trust sufficient for everyday consumers and enterprises. Reaching it typically requires solving cost, throughput, and user-experience barriers that gate the transition across the technology adoption lifecycle."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:network-effects ;
    vc:slug "mass-adoption" ;
    vc:sourceDomain "blockchain" .

ngm:mass-customisation a owl:Class ;
    rdfs:label "Mass Customisation"@en ;
    rdfs:comment "Mass customisation is a production strategy that delivers individually tailored goods or services at costs approaching those of mass production. It combines flexible manufacturing, modular design, and digital configuration so customers can specify variants without sacrificing scale economies. Robotics, additive manufacturing, and data-driven personalisation are key enablers across sectors such as fashion and consumer goods."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fashion,
        ngm:industrial-robot ;
    vc:slug "mass-customisation" ;
    vc:sourceDomain "robotics" .

ngm:material-x a owl:Class ;
    rdfs:label "MaterialX"@en ;
    rdfs:comment "MaterialX is an open standard for describing surface and procedural materials, shading networks and look development data in a renderer-independent form for exchange between content creation tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:texture-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        ngm:material-definition ;
    vc:enables ngm:asset-interoperability,
        ngm:physically-based-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:shader,
        ngm:texture-mapping ;
    vc:slug "material-x" ;
    vc:sourceDomain "metaverse" .

ngm:matrix-factorisation a owl:Class ;
    rdfs:label "Matrix Factorisation"@en ;
    rdfs:comment "Matrix factorisation is a family of techniques that decompose a matrix into a product of lower-dimensional factor matrices, revealing latent structure in the data. In machine learning it is widely used for collaborative-filtering recommendation, where a sparse user-item rating matrix is approximated by user and item embedding factors. Variants include singular value decomposition, non-negative matrix factorisation, and low-rank adaptation methods."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyper-personalisation,
        ngm:lo-ra-do-ra-etc ;
    vc:slug "matrix-factorisation" ;
    vc:sourceDomain "ai" .

ngm:mean-absolute-error a owl:Class ;
    rdfs:label "Mean Absolute Error"@en ;
    rdfs:comment "A regression performance metric representing the average magnitude of errors between predicted and actual values, calculated as the arithmetic mean of absolute differences between predictions and ground truth across all instances, providing an intuitive measure of prediction accuracy in the same units as the target variable. MAE treats all errors equally regardless of direction and is less sensitive to outliers than squared error metrics such as RMSE."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:model-performance ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:root-mean-square-error ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:model-performance ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "mean-absolute-error" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness ;
    vc:uses ngm:machine-learning-model .

ngm:mean-squared-error a owl:Class ;
    rdfs:label "Mean Squared Error"@en ;
    rdfs:comment "A measure of the average squared difference between predicted values and observed values, widely used to quantify estimation and prediction error."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:loss-function ;
    vc:enables ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "mean-squared-error" ;
    vc:sourceDomain "mathematics" .

ngm:media-library a owl:Class ;
    rdfs:label "Media Library"@en ;
    rdfs:comment "Centralised digital asset repositories that store, organise, and manage media files including 3D models, textures, audio, video, and immersive content for metaverse applications, with metadata tagging and search capabilities."@en ;
    rdfs:subClassOf ngm:digital-asset-management,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:content-organisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "media-library" ;
    vc:sourceDomain "spatial-computing" .

ngm:media-production a owl:Class ;
    rdfs:label "Media Production"@en ;
    rdfs:comment "Media production is the end-to-end process of creating audiovisual content, spanning pre-production planning, capture, editing, and post-production finishing. It increasingly integrates generative AI, virtual production, and automated voice and speech tools to accelerate and personalise output. As a workflow it coordinates creative, technical, and asset-management activities across a content pipeline."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:speech-and-voice ;
    vc:slug "media-production" ;
    vc:sourceDomain "metaverse" .

ngm:medical-devices a owl:Class ;
    rdfs:label "Medical Devices"@en ;
    rdfs:comment "Medical devices are instruments, machines, implants, or software intended for the diagnosis, prevention, monitoring, or treatment of disease and injury. They are classified by risk and tightly regulated, demanding high reliability, fault tolerance, and often real-time performance where failure can cause patient harm. Embedded and connected medical devices increasingly incorporate sensing, control, and AI under stringent safety regimes."@en ;
    rdfs:subClassOf ngm:system-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:real-time ;
    vc:slug "medical-devices" ;
    vc:sourceDomain "infrastructure" .

ngm:medical-image-synthesis a owl:Class ;
    rdfs:label "Medical Image Synthesis"@en ;
    rdfs:comment "Medical image synthesis is the use of generative models to produce artificial medical images, such as scans, for training data augmentation, modality translation, or privacy-preserving sharing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:medical-imaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-model ],
        ngm:image-synthesis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:generative-model,
        ngm:medical-imaging ;
    vc:slug "medical-image-synthesis" ;
    vc:sourceDomain "machine-learning" .

ngm:medical-segmentation-decathlon a owl:Class ;
    rdfs:label "Medical Segmentation Decathlon"@en ;
    rdfs:comment "The Medical Segmentation Decathlon is a benchmark challenge providing ten diverse medical imaging datasets to evaluate the generalisability of automated segmentation algorithms. Spanning organs and modalities such as brain MRI, liver CT, and cardiac imaging, it tests whether a single method can perform well across heterogeneous anatomical tasks without per-task tuning. It is a widely cited reference for assessing biomedical image-segmentation models."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:segmentation-and-identification ;
    vc:slug "medical-segmentation-decathlon" ;
    vc:sourceDomain "ai" .

ngm:mental-health-monitoring a owl:Class ;
    rdfs:label "Mental Health Monitoring"@en ;
    rdfs:comment "The use of sensors, applications, and data analysis to track indicators related to a person's psychological wellbeing over time. It may use self-reports, physiological signals, and behavioural data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:affective-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:sensor ;
    vc:slug "mental-health-monitoring" ;
    vc:sourceDomain "healthcare" .

ngm:metaverse-content-creation a owl:Class ;
    rdfs:label "Metaverse Content Creation"@en ;
    rdfs:comment "Metaverse content creation is the production of three-dimensional assets, environments, avatars, and interactive experiences for immersive virtual worlds. It spans modelling, texturing, animation, scripting, and increasingly generative AI workflows, and is the supply side that populates persistent shared spaces. Quality, interoperability, and real-time performance constraints distinguish it from conventional digital media production."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:metaverse-application-platform ;
    vc:slug "metaverse-content-creation" ;
    vc:sourceDomain "metaverse" .

ngm:metaverse-liability-model a owl:Class ;
    rdfs:label "Metaverse Liability Model"@en ;
    rdfs:comment "A comprehensive legal responsibility framework for virtual worlds that defines liability attribution, responsibility allocation, and harm redress mechanisms across platforms, users, AI agents, and content creators in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evidence-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dispute-resolution ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:harm-compensation,
        ngm:legal-accountability,
        ngm:platform-protection,
        ngm:risk-management,
        ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ai-agent-liability,
        ngm:content-creator-liability,
        ngm:harm-redress-mechanism,
        ngm:insurance-integration,
        ngm:platform-liability-framework,
        ngm:user-liability-rules ;
    vc:isPartOf ngm:legal-governance-framework,
        ngm:virtual-society-regulations ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:dispute-resolution,
        ngm:evidence-collection,
        ngm:harm-classification-system,
        ngm:jurisdiction-mapping,
        ngm:liability-attribution-engine ;
    vc:slug "metaverse-liability-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-safety-protocol a owl:Class ;
    rdfs:label "Metaverse Safety Protocol"@en ;
    rdfs:comment "Procedures and safeguards ensuring physical and psychological safety of users during immersive metaverse experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:risk-mitigation,
        ngm:safe-immersive-experience,
        ngm:user-well-being ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:incident-response-protocol,
        ngm:risk-assessment-procedure,
        ngm:safety-guideline,
        ngm:user-protection-measure ;
    vc:implements ngm:metaverse-governance-and-safeguarding ;
    vc:isPartOf ngm:governance-framework,
        ngm:safety-standard ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:content-moderation,
        ngm:safety-assessment,
        ngm:user-monitoring ;
    vc:slug "metaverse-safety-protocol" ;
    vc:sourceDomain "spatial-computing" .

ngm:methane-abatement a owl:Class ;
    rdfs:label "Methane Abatement"@en ;
    rdfs:comment "Methane abatement is the set of techniques for capturing, destroying, or preventing the release of methane, a greenhouse gas with roughly 80 times the near-term warming potential of carbon dioxide. Approaches include flaring, combustion in engines or turbines, and conversion of otherwise-vented or flared gas into useful energy. In the Bitcoin context it underpins the use of stranded or waste methane to power mining as an emissions-reduction strategy."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:stranded-energy-monetisation ;
    vc:slug "methane-abatement" ;
    vc:sourceDomain "infrastructure" .

ngm:mi-ca a owl:Class ;
    rdfs:label "MiCA"@en ;
    rdfs:comment "MiCA (Markets in Crypto-Assets Regulation) is a European Union regulation establishing a harmonised legal framework for crypto-assets not already covered by existing financial services law. Adopted in 2023 and applying in phases through 2024, it sets rules for issuers of asset-referenced tokens and e-money tokens, and for crypto-asset service providers such as exchanges and custodians. The regulation covers authorisation, capital and governance requirements, market-abuse provisions and consumer protection, including reserve and redemption rules for stablecoins. It is one of the first comprehensive crypto regulatory regimes among major jurisdictions."@en ;
    rdfs:subClassOf ngm:regulatory-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "mi-ca" ;
    vc:sourceDomain "mica" .

ngm:micro-oled-display a owl:Class ;
    rdfs:label "Micro-OLED Display"@en ;
    rdfs:comment "A micro-OLED display is an organic light-emitting diode panel fabricated directly on a silicon backplane (OLED-on-silicon), yielding pixel pitches of a few micrometres and very high pixel densities. Its compact size, high contrast, fast response, and low power make it the dominant near-eye display technology for AR and VR headsets. The silicon substrate enables integrated drive circuitry impossible on glass."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:mixed-reality ;
    vc:slug "micro-oled-display" ;
    vc:sourceDomain "metaverse" .

ngm:micro-ros a owl:Class ;
    rdfs:label "micro-ROS"@en ;
    rdfs:comment "micro-ROS is a framework that brings the ROS 2 programming model and communication to resource-constrained microcontrollers, allowing embedded devices to participate as first-class nodes in a ROS graph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:robot-operating-system ;
    vc:enables ngm:real-time-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:embedded-systems,
        ngm:real-time-operating-system ;
    vc:slug "micro-ros" ;
    vc:sourceDomain "robotics" .

ngm:microsoft a owl:Class ;
    rdfs:label "Microsoft"@en ;
    rdfs:comment "Microsoft is a multinational technology company that produces operating systems, productivity software, cloud services and mixed reality hardware and platforms."@en ;
    rdfs:subClassOf ngm:standards-organization ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "microsoft" ;
    vc:sourceDomain "general" .

ngm:microsoft-copilot a owl:Class ;
    rdfs:label "Microsoft Copilot"@en ;
    rdfs:comment "Microsoft Copilot is a family of generative AI assistants developed by Microsoft and integrated across its products, including Windows, Microsoft 365 and the Edge browser. Launched from 2023 onwards, it builds on large language models from OpenAI together with Microsoft's own models and data grounding. In Microsoft 365 it can draft documents, summarise meetings, analyse spreadsheets and generate email based on a user's content and context. GitHub Copilot, a related product, provides code completion and chat assistance within software development environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:artificial-intelligence-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:large-language-models ;
    vc:slug "microsoft-copilot" ;
    vc:sourceDomain "microsoft-copilot" .

ngm:mimo-antenna a owl:Class ;
    rdfs:label "MIMO Antenna"@en ;
    rdfs:comment "A MIMO (multiple-input multiple-output) antenna is an array of multiple transmit and receive elements that exploits spatial multiplexing to send several independent data streams over the same frequency channel. By leveraging multipath propagation, it increases spectral efficiency and link reliability without additional bandwidth, and is foundational to Wi-Fi and 4G/5G physical layers. Massive MIMO scales this to dozens or hundreds of elements with beamforming."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "mimo-antenna" ;
    vc:sourceDomain "infrastructure" .

ngm:miro a owl:Class ;
    rdfs:label "Miro"@en ;
    rdfs:comment "Miro is a cloud-based collaborative whiteboard platform that provides an infinite canvas for distributed teams to brainstorm, diagram, map workflows, and run workshops in real time. It offers sticky notes, templates, frameworks, and integrations with tools such as Jira, Slack, and design suites. It is widely adopted for product discovery, agile ceremonies, and remote facilitation."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:product-design ;
    vc:slug "miro" ;
    vc:sourceDomain "infrastructure" .

ngm:mistral a owl:Class ;
    rdfs:label "Mistral"@en ;
    rdfs:comment "Mistral is a family of language models from Mistral AI, several released as open weights. The line includes dense models and mixture-of-experts models for text generation and reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:large-language-models ;
    vc:enables ngm:function-calling,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:attention-mechanism,
        ngm:transformer ;
    vc:slug "mistral" ;
    vc:sourceDomain "natural-language-processing" .

ngm:mitre-atlas a owl:Class ;
    rdfs:label "MITRE ATLAS"@en ;
    rdfs:comment "MITRE ATLAS is a knowledge base of adversary tactics and techniques against machine learning systems. It is modelled on the MITRE ATT&CK framework and curated by MITRE."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-machine-learning ],
        ngm:security-framework ;
    vc:enables ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:adversarial-machine-learning ;
    vc:slug "mitre-atlas" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:mlcommons a owl:Class ;
    rdfs:label "MLCommons"@en ;
    rdfs:comment "MLCommons is an open engineering consortium that builds benchmarks, datasets, and best practices to accelerate machine learning innovation in a fair and reproducible way. It is best known for the MLPerf benchmark suites, which measure training and inference performance across hardware and software stacks. Membership includes major chip vendors, cloud providers, and research institutions."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:evaluation-benchmarks-and-leaderboards ;
    vc:slug "mlcommons" ;
    vc:sourceDomain "ai" .

ngm:mob-programming a owl:Class ;
    rdfs:label "Mob Programming"@en ;
    rdfs:comment "Mob programming is a software development practice in which the whole team works on the same task at the same time, on the same computer, rotating the roles of driver and navigators. It extends pair programming to the full group, concentrating collective knowledge to improve code quality, shorten feedback loops, and spread learning. It trades raw parallelism for higher alignment and fewer hand-offs."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:remote-pair-programming ;
    vc:slug "mob-programming" ;
    vc:sourceDomain "infrastructure" .

ngm:model-collapse a owl:Class ;
    rdfs:label "Model Collapse"@en ;
    rdfs:comment "Model collapse is a degenerative process in which generative models trained recursively on their own (or other models') synthetic outputs progressively lose information about the true data distribution. Tails of the distribution disappear first, leading to reduced diversity, amplified biases, and eventual convergence on degenerate outputs. It is a key risk as AI-generated content increasingly contaminates web-scale training corpora."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:death-of-the-internet,
        ngm:feedback-loop ;
    vc:slug "model-collapse" ;
    vc:sourceDomain "ai" .

ngm:model-context-protocol-anthropic-2024 a owl:Class ;
    rdfs:label "Model Context Protocol Anthropic 2024"@en ;
    rdfs:comment "The Model Context Protocol (MCP) is an open standard introduced by Anthropic in 2024 that defines a uniform JSON-RPC interface for connecting large language model applications to external tools, data sources, and prompts. It standardises how AI agents discover and invoke capabilities exposed by MCP servers, decoupling model hosts from integrations. It has been broadly adopted as a common plug-in layer for agentic systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "model-context-protocol-anthropic-2024" ;
    vc:sourceDomain "ai" .

ngm:model-parallelism a owl:Class ;
    rdfs:label "Model Parallelism"@en ;
    rdfs:comment "Model parallelism is a distributed training strategy that splits a single neural network's parameters and computation across multiple accelerators when the model is too large to fit in one device's memory. Variants include tensor parallelism (splitting within layers) and pipeline parallelism (splitting across layers into stages). It is essential for training large language models and is often combined with data parallelism."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:deep-speed ;
    vc:slug "model-parallelism" ;
    vc:sourceDomain "ai" .

ngm:model-versioning a owl:Class ;
    rdfs:label "Model Versioning"@en ;
    rdfs:comment "Model versioning is the practice of tracking and managing successive versions of machine learning models, recording the code, data, hyperparameters, and checkpoints that produced each one. It enables reproducibility, rollback, lineage tracing, and controlled promotion of models through development and production stages. Model registries and artefact stores implement versioning as a core MLOps capability."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:mlflow ;
    vc:slug "model-versioning" ;
    vc:sourceDomain "ai" .

ngm:module a owl:Class ;
    rdfs:label "Module"@en ;
    rdfs:comment "A Module is a self-contained, reusable unit of software or system design that encapsulates a discrete set of related functions, data structures, or responsibilities behind a well-defined interface, enabling independent development, testing, deployment, and composition within larger systems. Modules promote separation of concerns, reduce coupling between system components, and support both horizontal reuse across different systems and vertical composition within a single system architecture. In AI contexts, a module may refer to a functional unit within a model architecture (e.g., an attention module, an adapter module) or a deployable component in an AI pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interface ],
        ngm:component ;
    vc:contrastsWith ngm:service-layer ;
    vc:enables ngm:microservices-architecture,
        ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:component,
        ngm:interface ;
    vc:isPartOf ngm:architecture,
        ngm:software-engineering ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adapter-modules,
        ngm:attention-mechanism,
        ngm:model-architecture,
        ngm:software-library ;
    vc:requires ngm:configuration,
        ngm:interface ;
    vc:slug "module" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:api-gateway .

ngm:monetary-theory a owl:Class ;
    rdfs:label "Monetary Theory"@en ;
    rdfs:comment "Monetary theory studies the nature of money, how its supply is created and managed, and how monetary conditions affect prices, output and financial stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economics ],
        ngm:economics-domain ;
    vc:enables ngm:central-bank-digital-currency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:economics ;
    vc:slug "monetary-theory" ;
    vc:sourceDomain "metaverse" .

ngm:motion-markers a owl:Class ;
    rdfs:label "Motion Markers"@en ;
    rdfs:comment "Reflective or active tracking points placed on subjects for optical motion capture systems, typically 12-15mm diameter for full-body capture, enabling precise position tracking at frame rates from 120fps to fps for animation, biomechanics, and performance analysis."@en ;
    rdfs:subClassOf ngm:motion-capture-technology,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:3-d-motion-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "motion-markers" ;
    vc:sourceDomain "spatial-computing" .

ngm:motion-solver-software a owl:Class ;
    rdfs:label "Motion Solver Software"@en ;
    rdfs:comment "Specialized software that uses multibody dynamics and physics-based algorithms to calculate reaction forces, torques, velocities, accelerations, and motor behaviors for mechanical systems and animated characters, enabling accurate simulation of rigid and flexible body movements."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:simulation-software ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:real-time-character-animation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "motion-solver-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:move-it-2 a owl:Class ;
    rdfs:label "MoveIt 2"@en ;
    rdfs:comment "MoveIt 2 is the open-source motion-planning framework for ROS 2, providing manipulation capabilities including inverse kinematics, collision-aware path planning, trajectory generation, and execution for robotic arms and mobile manipulators. It integrates planners, perception, and control through a plugin architecture and is the de facto standard for arm motion planning in the ROS ecosystem. The ROS 2 version adds real-time and lifecycle improvements over the original MoveIt."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:robotics-platform ;
    vc:slug "move-it-2" ;
    vc:sourceDomain "robotics" .

ngm:mteb-benchmark a owl:Class ;
    rdfs:label "MTEB Benchmark"@en ;
    rdfs:comment "MTEB (Massive Text Embedding Benchmark) is a standardised evaluation suite that measures text embedding models across many tasks, including retrieval, classification, clustering, reranking, and semantic similarity, over numerous datasets and languages. It provides a public leaderboard that has become the reference for comparing embedding models. Strong MTEB scores are widely used to select embeddings for semantic search and retrieval-augmented generation."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag,
        ngm:semantic-search ;
    vc:slug "mteb-benchmark" ;
    vc:sourceDomain "ai" .

ngm:mu-zero a owl:Class ;
    rdfs:label "MuZero"@en ;
    rdfs:comment "MuZero is a model-based reinforcement learning algorithm from DeepMind that achieves superhuman performance in board games and Atari without being given the rules of the environment. It learns a latent dynamics model predicting reward, value, and policy, then plans with Monte Carlo Tree Search over this learned model. It generalises AlphaZero to domains where the environment dynamics are unknown."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games,
        ngm:learning-algorithm ;
    vc:slug "mu-zero" ;
    vc:sourceDomain "ai" .

ngm:multi-agent-rag-scrapbook a owl:Class ;
    rdfs:label "Multi Agent RAG scrapbook"@en ;
    rdfs:comment "A research and literature collection exploring architectures in which multiple specialised AI agents collaborate through retrieval-augmented generation pipelines, combining knowledge graphs, ontologies, and constrained large language models to model complex social and environmental contexts in immersive environments. Covers formal ontology design, multi-modal data ingestion, and ethical deployment constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-agent-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:natural-language-processing ;
    vc:requires ngm:multi-agent-systems,
        ngm:ontology ;
    vc:slug "multi-agent-rag-scrapbook" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-graph,
        ngm:retrieval-augmented-generation .

ngm:multi-chain-de-fi a owl:Class ;
    rdfs:label "Multi-Chain DeFi"@en ;
    rdfs:comment "Multi-chain DeFi refers to decentralised finance applications and liquidity that operate across multiple independent blockchains rather than being confined to a single network. It relies on cross-chain bridges, messaging protocols, and interoperability standards to move assets and data between chains, letting users access yields and markets wherever they reside. It expands capital efficiency but introduces bridge and composability risks."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "multi-chain-de-fi" ;
    vc:sourceDomain "blockchain" .

ngm:multi-hop-reasoning a owl:Class ;
    rdfs:label "Multi-Hop Reasoning"@en ;
    rdfs:comment "Multi-hop reasoning is the capability to answer a question or draw a conclusion by chaining together several intermediate inferences or retrieved facts, rather than relying on a single piece of evidence. In language models and retrieval systems it requires composing information across multiple documents or knowledge-graph edges. It is central to complex question answering and is a known weak point for shallow retrieval and single-pass models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "multi-hop-reasoning" ;
    vc:sourceDomain "ai" .

ngm:multi-party-royalties a owl:Class ;
    rdfs:label "Multi Party Royalties"@en ;
    rdfs:comment "A blockchain-based distribution mechanism that uses smart contracts to automatically split and distribute royalty payments among multiple stakeholders including creators, collaborators, developers, and brands based on predefined ownership percentages."@en ;
    rdfs:subClassOf ngm:revenue-sharing,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:creator-economy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "multi-party-royalties" ;
    vc:sourceDomain "spatial-computing" .

ngm:multi-robot-coordination a owl:Class ;
    rdfs:label "Multi-Robot Coordination"@en ;
    rdfs:comment "Multi-robot coordination is the set of methods that enable multiple robots to act together coherently toward shared or individual goals, covering task allocation, collision avoidance, formation control, and communication. It addresses centralised and decentralised architectures and trades off optimality against scalability and robustness. Applications include warehouse fleets, drone swarms, and cooperative exploration."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:task-planning ;
    vc:slug "multi-robot-coordination" ;
    vc:sourceDomain "robotics" .

ngm:multi-task-learning a owl:Class ;
    rdfs:label "Multi Task Learning"@en ;
    rdfs:comment "Multi Task Learning is a machine learning paradigm where a single model is trained simultaneously on multiple related tasks, sharing intermediate representations to improve generalisation, sample efficiency, and regularisation relative to independently trained single-task models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:enables ngm:multimodal-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:supervised-learning,
        ngm:transfer-learning ;
    vc:slug "multi-task-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network-architecture .

ngm:multi-turn-dialogue a owl:Class ;
    rdfs:label "Multi-Turn Dialogue"@en ;
    rdfs:comment "Multi-turn dialogue is a conversational interaction spanning several exchanges in which a system must maintain context, track state, and resolve references across turns to produce coherent, relevant responses. It contrasts with single-turn question answering by requiring memory of prior utterances and the evolving goal. It is a core capability and evaluation axis for chatbots and conversational AI."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots ;
    vc:slug "multi-turn-dialogue" ;
    vc:sourceDomain "ai" .

ngm:multimodal-reasoning a owl:Class ;
    rdfs:label "Multimodal Reasoning"@en ;
    rdfs:comment "Multimodal reasoning is the capability of an AI system to integrate and draw inferences across multiple input modalities such as text, images, audio, and video. It requires aligning representations from heterogeneous sources into a shared semantic space so that conclusions depend jointly on all available signals. This underpins tasks like visual question answering, document understanding, and grounded dialogue where no single modality is sufficient."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:vision-language-model ;
    vc:slug "multimodal-reasoning" ;
    vc:sourceDomain "ai" .

ngm:n-triples a owl:Class ;
    rdfs:label "N-Triples"@en ;
    rdfs:comment "N-Triples is a line-based, plain-text serialization format for RDF in which each line encodes a single subject-predicate-object triple terminated by a period. It is deliberately minimal and unambiguous, using full IRIs rather than prefixes, which makes it easy to parse, stream, and compare line by line. The format is a W3C standard and serves as a canonical interchange and testing representation for RDF graphs."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:solid,
        ngm:turtle ;
    vc:slug "n-triples" ;
    vc:sourceDomain "data" .

ngm:namespace-declarations a owl:Class ;
    rdfs:label "Namespace Declarations"@en ;
    rdfs:comment "XML and RDF syntax constructs that associate short prefix identifiers with full namespace URIs, enabling the use of qualified names (QNames) to abbreviate long IRIs into human-readable yet machine-processable references in semantic web documents."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:semantic-web-standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:ontology-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "namespace-declarations" ;
    vc:sourceDomain "spatial-computing" .

ngm:national-competitiveness a owl:Class ;
    rdfs:label "National Competitiveness"@en ;
    rdfs:comment "National competitiveness is the set of policies, institutions, and capabilities that determine a country's level of productivity and its ability to sustain growth in an open global economy. In a technology context it captures how strategic investment in research, talent, and digital infrastructure positions a nation relative to others. Technology adoption is widely treated as a primary driver because it raises productivity and creates spillover advantages."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "national-competitiveness" ;
    vc:sourceDomain "governance" .

ngm:national-industrial-centre-for-virtual-environments a owl:Class ;
    rdfs:label "National Industrial Centre for Virtual Environments"@en ;
    rdfs:comment "A UK academic research centre active in the late 1990s and 2000s, based at the University of Salford, that advanced industrial applications of virtual reality including CAVE systems, immersive workbenches, and telepresence. NICVE succeeded the National Advanced Robotics Research Centre and produced early foundational work in multi-user virtual environments and real-time rendering on SGI hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:simulation ],
