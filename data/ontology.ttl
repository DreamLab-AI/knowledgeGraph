ngm:ghg-protocol a owl:Class ;
    rdfs:label "GHG Protocol"@en ;
    rdfs:comment "The GHG Protocol is the globally dominant greenhouse gas accounting and reporting framework, co-developed by the World Resources Institute (WRI) and the World Business Council for Sustainable Development (WBCSD) and first published as the Corporate Standard in 2001. It establishes methodologies for measuring and categorising greenhouse gas emissions across three scopes: Scope 1 (direct emissions from owned or controlled sources), Scope 2 (indirect emissions from purchased energy), and Scope 3 (all other upstream and downstream value-chain emissions). The framework underpins virtually all major corporate carbon reporting mandates, voluntary disclosure programmes, and science-based target-setting initiatives worldwide, making it the de facto lingua franca of corporate climate accounting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-1-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:greenhouse-gas-inventory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-2-emissions ],
        ngm:environmental-standards ;
    vc:bridgesTo ngm:digital-product-passport,
        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:iso-14067,
        ngm:pas-2060 ;
    vc:enables ngm:carbon-offsetting,
        ngm:esg-reporting,
        ngm:science-based-targets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:scope-1-emissions,
        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:implements ngm:corporate-sustainability-reporting ;
    vc:isPartOf ngm:carbon-accounting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:net-zero-transition,
        ngm:tcfd ;
    vc:requires ngm:greenhouse-gas-inventory ;
    vc:slug "ghg-protocol" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-14064 ;
    vc:uses ngm:carbon-footprint-measurement,
        ngm:life-cycle-assessment .

ngm:immersive-technology a owl:Class ;
    rdfs:label "Immersive Technology"@en ;
    rdfs:comment "The collective technologies comprising virtual reality (VR), augmented reality (AR), mixed reality (MR), and extended reality (XR) that create digital experiences blending physical and virtual environments, enabling user presence and interaction within computer-generated or enhanced spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
