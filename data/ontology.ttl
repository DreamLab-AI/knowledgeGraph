vf:hyperledger-indy a owl:Class ;
    rdfs:label "Hyperledger Indy"@en ;
    rdfs:comment "**Hyperledger Indy** is the purpose-built, permissioned, Byzantine-fault-tolerant distributed-ledger project hosted by the [[Linux Foundation]]-resident [[Hyperledger Foundation]] (now consolidated under the **LF Decentralized Trust** umbrella since June 2024) that provides the canonical reference implementation of a **verifiable data registry** (VDR) for **[[Self-Sovereign Identity]]** (SSI) infrastructure, originally seeded in September 2017 by a code contribution from the **[[Sovrin Foundation]]** (a Utah-incorporated non-profit established in 2016 by Phil Windley, Jason Law and Drummond Reed to operationalise the Sovrin Trust Framework and the public-permissioned Sovrin Network), implementing a four-node-minimum ordering quorum of **stewards** running the **[[Plenum]]** consensus protocol (a Python-based [[Practical Byzantine Fault Tolerance|PBFT]] derivative incorporating the **RBFT** (Redundant BFT, Aublin-Mokhtar-Quéma 2013) and **Aardvark** (Clement-Wong-Alvisi-Dahlin 2009) view-change resilience improvements ensuring liveness under faulty primary replicas), where the on-ledger state is deliberately constrained to four object types — public **DIDs** under the `did:sov` lega"@en ;
    rdfs:subClassOf <urn:visionflow:linked:byzantine-fault-tolerant-system>,
        <urn:visionflow:linked:decentralized-identifier-method>,
        <urn:visionflow:linked:hyperledger-project>,
        <urn:visionflow:linked:permissioned-distributed-ledger>,
        vf:verifiable-data-registry ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:issuer-holder-verifier-triangle>,
        <urn:visionflow:linked:multi-tenant-identity-ledger>,
        <urn:visionflow:linked:offline-credential-verification>,
        <urn:visionflow:linked:predicate-proof>,
        <urn:visionflow:linked:revocation-without-correlation>,
        <urn:visionflow:linked:selective-disclosure>,
        <urn:visionflow:linked:unlinkable-credential-presentation> ;
    vc:hasPart <urn:visionflow:linked:anon-creds>,
        <urn:visionflow:linked:aries-askar>,
        <urn:visionflow:linked:credential-definition>,
        <urn:visionflow:linked:credential-schema>,
        <urn:visionflow:linked:genesis-transaction-file>,
        <urn:visionflow:linked:indy-credx>,
        <urn:visionflow:linked:indy-node>,
        <urn:visionflow:linked:indy-vdr>,
        <urn:visionflow:linked:plenum>,
        <urn:visionflow:linked:revocation-registry>,
        <urn:visionflow:linked:steward-node> ;
    vc:implements <urn:visionflow:linked:sovrin-trust-framework>,
        <urn:visionflow:linked:trust-over-ip-stack>,
        <urn:visionflow:linked:w3-c-decentralized-identifier-specification>,
        <urn:visionflow:linked:w3-c-verifiable-credentials-data-model>,
        <urn:visionflow:linked:zkp-based-anonymous-credentials>,
        vf:self-sovereign-identity ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:cryptographic-accumulator>,
        <urn:visionflow:linked:genesis-pool-configuration>,
        <urn:visionflow:linked:hyperledger-aries>,
        <urn:visionflow:linked:secure-wallet-storage>,
        <urn:visionflow:linked:steward-network>,
        vf:public-key-infrastructure ;
    vc:slug "hyperledger-indy" ;
    vc:sourceDomain "blockchain" .

vf:hyperledger-iroha a owl:Class ;
    rdfs:label "Hyperledger Iroha"@en ;
    rdfs:comment "**Hyperledger Iroha** is a general-purpose permissioned Byzantine-fault-tolerant [[Distributed Ledger]] framework originally designed by Soramitsu (Tokyo, Japan) in collaboration with Hitachi, NTT Data and Colu, contributed to the [[Hyperledger]] Foundation (now Linux Foundation Decentralised Trust) on 17 October 2017 as the third top-level Hyperledger project after [[Hyperledger Fabric]] and Sawtooth, distinguished from its sibling frameworks by a radical commitment to operational simplicity, a built-in domain model of accounts/assets/permissions/signatories/peers rather than general-purpose smart contracts, and an explicit optimisation for mobile, IoT and bank-grade transaction processing — currently maintained in two production lineages: **Iroha 1.x** (C++17 implementation, YAC \"Yet Another Consensus\" voting BFT, command-query separation with pre-defined commands such as `CreateAccount`, `TransferAsset`, `AddAssetQuantity`, `AppendRole`, `GrantPermission`, PostgreSQL-backed world-state, gRPC + WebSocket Torii API, multi-signature transactions and atomic batches as first-class primitives, client SDKs for Java/Kotlin, Python, JavaScript/TypeScript, iOS Swift, Android, C++ and .NET"@en ;
    rdfs:subClassOf <urn:visionflow:linked:byzantine-fault-tolerant-system>,
        <urn:visionflow:linked:enterprise-blockchain-framework>,
        <urn:visionflow:linked:hyperledger-project>,
        vf:distributed-ledger,
        vf:permissioned-blockchain ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:asset-tokenisation>,
        <urn:visionflow:linked:atomic-multi-asset-transfer>,
        <urn:visionflow:linked:cross-border-retail-payment>,
        <urn:visionflow:linked:national-payment-system>,
        <urn:visionflow:linked:permissioned-smart-contracts>,
        vf:central-bank-digital-currency,
        vf:digital-identity ;
    vc:hasPart <urn:visionflow:linked:iroha-executor>,
        <urn:visionflow:linked:iroha-special-instructions>,
        <urn:visionflow:linked:iroha-trigger>,
        <urn:visionflow:linked:iroha-wasm-runtime>,
        <urn:visionflow:linked:kura-block-store>,
        <urn:visionflow:linked:sumeragi-block-producer>,
        <urn:visionflow:linked:sumeragi-consensus>,
        <urn:visionflow:linked:torii-api>,
        <urn:visionflow:linked:yac-consensus> ;
    vc:implements <urn:visionflow:linked:atomic-batch-transactions>,
        <urn:visionflow:linked:command-query-separation>,
        <urn:visionflow:linked:multi-signature-transactions>,
        <urn:visionflow:linked:role-based-access-control>,
        <urn:visionflow:linked:sumeragi-bft>,
        <urn:visionflow:linked:web-assembly-smart-contracts>,
        <urn:visionflow:linked:yet-another-consensus> ;
