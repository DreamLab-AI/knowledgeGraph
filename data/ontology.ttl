ngm:probabilistic-inference a owl:Class ;
    rdfs:label "Probabilistic Inference"@en ;
    rdfs:comment "Probabilistic inference is the computation of the probability of unknown quantities given observed evidence within a probabilistic model. It produces posterior distributions used for prediction and decision making under uncertainty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
