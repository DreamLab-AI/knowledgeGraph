        ngm:eventual-consistency,
        ngm:flp-impossibility,
        ngm:linearisability,
        ngm:site-reliability-engineering ;
    vc:requires ngm:failure-model,
        ngm:idempotency,
        ngm:monitoring-system,
        ngm:network-layer,
        ngm:storage-infrastructure,
        ngm:time-synchronisation ;
