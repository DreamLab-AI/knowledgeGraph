ngm:stack-machine a owl:Class ;
    rdfs:comment "A stack machine is an execution model in which operands and intermediate results are held on a last-in-first-out stack rather than in named registers, with instructions implicitly consuming their inputs from the top of the stack and pushing their outputs back onto it. The model yields compact, position-independent bytecode and a simple deterministic evaluator, which is why it underpins many scripting languages and blockchain virtual machines such as Bitcoin Script and the Ethereum Virtual Machine."@en ;
    rdfs:label "Stack Machine"@en ;
    rdfs:subClassOf ngm:execution-model ;
    rdfs:subClassOf _:r19887 ;
