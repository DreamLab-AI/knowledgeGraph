ngm:chapman-kolmogorov-equation a owl:Class ;
    rdfs:label "Chapman-Kolmogorov Equation"@en ;
    rdfs:comment "The Chapman-Kolmogorov Equation is a fundamental identity in probability theory and stochastic processes that expresses the consistency condition for transition probabilities of a Markov chain or continuous stochastic process. It states that the probability of moving from state i to state j in n+m steps equals the sum over all intermediate states k of the product of the n-step and m-step transition probabilities. This equation is the cornerstone of Markov chain analysis and underlies key algorithms in machine learning, Bayesian inference, and diffusion modelling."@en ;
    rdfs:subClassOf ngm:stochastic-process ;
    vc:enables ngm:bayesian-inference,
        ngm:markov-chain-monte-carlo ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:stochastic-differential-equation,
        ngm:time-series-analysis ;
    vc:slug "chapman-kolmogorov-equation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:probability-theory .

ngm:character-relationship-graph a owl:Class ;
    rdfs:label "Character Relationship Graph"@en ;
    rdfs:comment "A network data structure representing narrative characters as vertices and their interactions or relationships as edges, used to model social dynamics, drive procedural story generation, and analyze narrative structure through graph theory and social network analysis."@en ;
