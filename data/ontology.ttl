ngm:issb a owl:Class ;
    rdfs:comment "The International Sustainability Standards Board (ISSB) is a standard-setting body established under the IFRS Foundation to develop a global baseline of sustainability-related financial disclosure standards. Its inaugural standards, IFRS S1 and IFRS S2, set out general sustainability and climate-specific disclosure requirements for capital markets. The ISSB consolidated earlier voluntary frameworks to reduce fragmentation and improve the comparability of corporate sustainability information."@en ;
    rdfs:label "Issb"@en ;
    rdfs:subClassOf ngm:sustainability-reporting ;
    rdfs:subClassOf _:r12923 ;
    rdfs:subClassOf _:r12924 ;
