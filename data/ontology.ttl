ngm:jax a owl:Class ;
    rdfs:label "JAX"@en ;
    rdfs:comment "A Python library from Google for high-performance numerical computing and machine learning research, combining NumPy-style array operations with automatic differentiation and just-in-time compilation targeting CPUs, GPUs, and TPUs via the XLA compiler."@en ;
