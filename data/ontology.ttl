ngm:provenance-standard a owl:Class ;
    rdfs:label "Provenance Standard"@en ;
    rdfs:comment "Technical specifications and protocols for recording immutable ownership history and authenticity verification of digital assets through blockchain-based token IDs, contract addresses, and metadata that establish chain of custody from creation to present ownership."@en ;
    rdfs:subClassOf ngm:digital-asset-standards,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-authenticity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "provenance-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:provenance-tracker a skos:Concept ;
    rdfs:label "Provenance Tracker"@en .

ngm:provisioning-engine a skos:Concept ;
    rdfs:label "Provisioning Engine"@en .

