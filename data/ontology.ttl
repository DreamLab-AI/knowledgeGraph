        ngm:transformer-architecture .

ngm:email-search a owl:Class ;
    rdfs:label "email search"@en ;
    rdfs:comment "Email search refers to the set of techniques, architectures, and tooling used to index, query, and retrieve relevant messages from large email corpora. Modern self-hosted email search stacks combine traditional full-text indexing (BM25-based engines such as Tantivy or Xapian) with dense vector embeddings and hybrid retrieval strategies to support semantic and keyword queries at scale. LLM-based reranking and optional graph-database layers for entity-relationship queries extend precision and recall beyond keyword matching, enabling systems to handle corpora of hundreds of thousands of messages with sub-second latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-index ],
        ngm:search-engine ;
    vc:dependsOn ngm:data-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:information-retrieval,
        ngm:search-index ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:knowledge-base,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "email-search" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedding-model,
        ngm:semantic-search,
        ngm:vector-database .

ngm:emc-standard a owl:Class ;
    rdfs:label "EMC Standard"@en ;
    rdfs:comment "EMC standard ensures robots neither emit electromagnetic interference that disrupts other equipment nor experience susceptibility to external electromagnetic noise that degrades performance."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:electrical-safety,
        ngm:industrial-deployment,
        ngm:regulatory-compliance,
        ngm:reliable-operation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-criteria,
        ngm:emissions-limit,
        ngm:immunity-requirement,
        ngm:test-procedure ;
    vc:implements ngm:electromagnetic-compatibility ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:filter-implementation,
        ngm:grounding-practice,
        ngm:shielding-design,
        ngm:test-facility ;
    vc:slug "emc-standard" ;
    vc:sourceDomain "robotics" .

ngm:enterprise-software-domain a owl:Class ;
    rdfs:label "Enterprise Software Domain"@en ;
    rdfs:comment "The Enterprise Software Domain classifies concepts for applications and platforms that support the operations of organisations at scale, including resource planning, customer management, and integration middleware. It covers architecture patterns, data management, and the governance that large deployments require. As a top-level subject classification, it scopes business-grade software systems rather than the underlying infrastructure or the networks they run on."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:master-data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:owl-thing ;
    vc:enables ngm:business-process-automation,
        ngm:data-integration,
        ngm:operational-reporting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:enterprise-resource-planning,
        ngm:identity-and-access-management,
        ngm:integration-middleware,
        ngm:master-data-management,
        ngm:workflow-engine ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-management,
