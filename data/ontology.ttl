ngm:annotated-dataset a owl:Class ;
    rdfs:comment "A dataset in which each example carries human- or machine-assigned labels — class names, bounding boxes, segmentation masks, transcripts, action-unit codes, or relevance judgements — produced under a documented annotation scheme with quality controls such as inter-annotator agreement; annotated datasets are the primary fuel of supervised learning, and their coverage, label accuracy, and demographic balance bound the accuracy and fairness of every model trained on them."@en ;
    rdfs:label "Annotated Dataset"@en ;
    rdfs:subClassOf ngm:dataset ;
