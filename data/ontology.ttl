ngm:sovereign-keyset a owl:Class ;
    rdfs:label "Sovereign Keyset"@en ;
    rdfs:comment "The cryptographic key material (BIP-340 Schnorr Keypair|BIP-340 Schnorr keypair) held securely by each VisionClaw Agentic Container|VisionClaw agent, used to prove identity via DID Nostr Identity|did:nostr DIDs, sign Verifiable Credential Surface|verifiable credentials, authentica..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bip-340-schnorr-keypair ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secp256k1-elliptic-curve ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        ngm:bc-cryptographic-primitive,
        ngm:public-key-infrastructure ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:credential-issuance,
        ngm:decentralised-trust,
        ngm:message-signing,
        ngm:peer-authentication,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bip-340-schnorr-keypair,
        ngm:key-rotation-policy,
        ngm:private-key,
        ngm:public-key ;
    vc:implements ngm:bip-340,
        ngm:secp256k1,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.86"^^xsd:float ;
    vc:requires ngm:hardware-security-module-optional,
        ngm:key-storage,
        ngm:secp256k1-elliptic-curve,
        ngm:secure-random-number-generator ;
    vc:slug "sovereign-keyset" ;
    vc:sourceDomain "blockchain" .

