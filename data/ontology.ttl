ngm:security-architecture a owl:Class ;
    rdfs:label "Security Architecture"@en ;
    rdfs:comment "A comprehensive framework defining security controls, policies, and technologies protecting metaverse infrastructure, user data, and digital assets through defence-in-depth strategies including authentication, encryption, access control, and threat monitoring."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety,
