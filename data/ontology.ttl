ngm:credential-schema a owl:Class ;
    rdfs:label "Credential Schema"@en ;
    rdfs:comment "A Credential Schema is a machine-readable, versioned specification — typically expressed in JSON Schema or a JSON-LD vocabulary — that defines the mandatory and optional claims, data types, cardinality constraints, and value ranges permissible within a Verifiable Credential. Schemas function as a binding contract between credential issuers, holders, and verifiers: the issuer populates claims in conformance with a declared schema, the holder's identity wallet stores schema metadata alongside the credential, and the verifier resolves and validates the credential's structure against the schema before applying trust policy decisions. Schemas are published at stable, resolvable URIs and are referenced from the credentialSchema property defined in the W3C Verifiable Credentials Data Model; in AnonCreds ecosystems they are written to a Verifiable Data Registry, making them tamper-evident and globally discoverable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-definition ],
        ngm:decentralised-identity ;
    vc:bridgesTo ngm:data-governance,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:access-control-policy,
        ngm:credential-format-standard ;
    vc:enables ngm:interoperability,
        ngm:selective-disclosure,
        ngm:verifiable-credential-vc,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:claim-mapping,
        ngm:credential-definition ;
    vc:implements ngm:anoncreds,
        ngm:mdoc,
        ngm:sd-jwt-vc ;
    vc:isPartOf ngm:self-sovereign-identity,
        ngm:trust-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:credential-governance,
        ngm:metadata-schema,
        ngm:ontology,
        ngm:schema-registry ;
    vc:requires ngm:decentralised-identifier,
        ngm:verifiable-data-registry ;
    vc:slug "credential-schema" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:hyperledger-aries,
        ngm:openid-foundation,
        ngm:w3c ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:json-data-interchange-format-ld,
        ngm:json-data-interchange-format-schema,
        ngm:semantic-web .

ngm:data-compression a owl:Class ;
    rdfs:label "Data Compression"@en ;
    rdfs:comment "Data Compression in AI encompasses techniques for reducing the size of datasets, models, and computational representations while preserving essential information and predictive performance. Key methods include model quantisation (reducing numerical precision of weights), pruning (removing redundant parameters), knowledge distillation (training compact student models from large teachers), and neural compression via autoencoders. These techniques are critical for deploying AI on resource-constrained edge devices and for reducing storage, bandwidth, and energy costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:network-bandwidth-management,
        ngm:storage-optimisation ;
    vc:contrastsWith ngm:full-precision-model ;
    vc:dependsOn ngm:information-theory ;
    vc:enables ngm:bandwidth-efficient-communication,
        ngm:federated-learning,
        ngm:model-compression-for-edge,
        ngm:on-device-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:entropy-coding,
        ngm:lossless-compression,
        ngm:lossy-compression ;
    vc:implements ngm:rate-distortion-theory ;
    vc:isPartOf ngm:model-optimisation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-pruning-for-edge-deployment,
        ngm:neural-architecture-search,
        ngm:weight-sharing ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "data-compression" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:edge-ai,
        ngm:efficient-inference,
        ngm:tinyml ;
    vc:uses ngm:autoencoder,
        ngm:huffman-coding,
        ngm:knowledge-distillation,
        ngm:quantisation,
        ngm:sparse-representation .

ngm:data-processing a owl:Class ;
    rdfs:label "Data Processing"@en ;
    rdfs:comment "Data Processing is the systematic application of operations — collection, validation, transformation, aggregation, enrichment, and storage — that convert raw, unstructured, or heterogeneous input data into organised, queryable, and semantically coherent representations suitable for analysis, machine learning, or real-time decision-making. It encompasses both batch and streaming paradigms, spanning ETL/ELT pipelines, in-memory computation frameworks, and edge preprocessing workflows that must balance throughput, latency, fault-tolerance, and data quality. Architecturally, data processing sits between raw data ingestion and higher-order analytical or AI workloads, acting as the foundational substrate for knowledge extraction, model training, and operational intelligence. Mature implementations employ declarative query languages, distributed execution engines, schema registries, and lineage tracking to ensure reproducibility and governance across the full data lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        ngm:data-management ;
    vc:bridgesTo ngm:feature-engineering,
        ngm:sensor-fusion ;
    vc:contrastsWith ngm:raw-data ;
    vc:dependsOn ngm:data-governance,
        ngm:distributed-computing ;
    vc:enables ngm:business-intelligence,
        ngm:computer-vision,
        ngm:data-analytics,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:batch-processing,
        ngm:data-pipeline,
        ngm:etl,
        ngm:stream-processing ;
    vc:isPartOf ngm:data-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:data-quality,
        ngm:data-warehouse ;
    vc:requires ngm:data-ingestion,
        ngm:data-storage,
        ngm:schema-management ;
    vc:slug "data-processing" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:sql-standard ;
    vc:supports ngm:data-lineage,
        ngm:real-time-analytics ;
    vc:uses ngm:apache-kafka,
        ngm:apache-spark,
        ngm:edge-computing,
        ngm:sql .

ngm:data-warehouse a owl:Class ;
    rdfs:label "Data Warehouse"@en ;
    rdfs:comment "A data warehouse is a centralised analytical repository that integrates cleansed, structured data from multiple operational sources into a subject-oriented, historical model optimised for querying and reporting. It supports business intelligence through schemas such as star and snowflake and columnar storage for fast aggregation. It is a core data-engineering asset enabling consistent enterprise analytics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
