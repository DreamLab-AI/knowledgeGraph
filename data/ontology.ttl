        ngm:networking-infrastructure ;
    vc:slug "infrastructure-component" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:edge-computing .

ngm:technology-infrastructure-domain-inspection a owl:Class ;
    rdfs:label "Infrastructure Inspection"@en ;
    rdfs:comment "Infrastructure inspection is the robotic application of surveying and assessing physical assets such as power lines, pipelines, bridges, wind turbines, and buildings to detect defects, corrosion, and structural risk. Robots equipped with cameras, thermal and LiDAR sensors capture data in environments that are hazardous, remote, or costly for human crews. It improves safety and inspection frequency while generating quantitative condition records for predictive maintenance."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aerial-robot,
        ngm:ground-robot ;
    vc:slug "infrastructure-inspection" ;
    vc:sourceDomain "robotics" .

ngm:technology-policy a skos:Concept ;
    rdfs:label "Technology Policy"@en .

ngm:tele-050-neuralrenderingtelepresence a owl:Class ;
    rdfs:label "TELE 050 neuralrenderingtelepresence"@en ;
    rdfs:comment "Neural Rendering Telepresence (TELE 050) is a class of telepresence systems that replace conventional rasterisation pipelines with neural rendering techniques — including neural radiance fields, Gaussian splatting, and differentiable rendering — to reconstruct and transmit photorealistic volumetric representations of remote participants in real time. These approaches substantially reduce capture hardware requirements while improving perceptual fidelity and supporting free-viewpoint synthesis."@en ;
    rdfs:subClassOf ngm:dc-telepresence,
        ngm:tele-001-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:real-time-rendering,
        ngm:tele020virtualrealitytelepresence ;
    vc:slug "tele-050-neuralrenderingtelepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:gaussian-splatting,
        ngm:neural-radiance-field,
        ngm:neural-rendering .

ngm:tele-060-instant-ngp a owl:Class ;
    rdfs:label "TELE-060-instant-ngp"@en ;
    rdfs:comment "Instant-NGP (Instant Neural Graphics Primitives) is a method that uses a multi-resolution hash encoding to train and evaluate neural graphics representations such as neural radiance fields far faster than earlier approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-radiance-fields ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        ngm:neural-rendering ;
    vc:enables ngm:novel-view-synthesis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:differentiable-rendering,
        ngm:neural-radiance-fields ;
    vc:slug "tele-060-instant-ngp" ;
    vc:sourceDomain "metaverse" .

ngm:tele-110-spatial-audio-processing a owl:Class ;
    rdfs:label "TELE-110-spatial-audio-processing"@en ;
    rdfs:comment "Spatial audio processing is the set of signal-processing techniques that position sound sources in three-dimensional space for a listener, using cues such as direction, distance and room acoustics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
