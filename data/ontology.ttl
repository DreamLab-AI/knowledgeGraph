    vc:relatedTo ngm:explainable-ai,
        ngm:healthcare-ai ;
    vc:slug "medical-diagnosis-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:knowledge-graph .

ngm:meta-ai a owl:Class ;
    rdfs:label "Meta AI"@en ;
    rdfs:comment "Meta AI is the artificial intelligence research and applied AI division of Meta Platforms, conducting foundational research in machine learning and releasing notable open-weight artefacts including the LLaMA series of large language models and the multimodal embedding model ImageBind. The division operates FAIR (Fundamental AI Research) for long-horizon research and applied AI teams that integrate models into Meta products such as Facebook, Instagram, and WhatsApp. Meta AI's open-weight release strategy has materially shaped the open-source AI ecosystem by enabling fine-tuning and deployment without proprietary API dependency."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:multimodal-ai,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:responsible-ai ;
    vc:slug "meta-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:instruction-tuning,
        ngm:large-language-models .

ngm:metaverse-architecture-stack a owl:Class ;
    rdfs:label "Metaverse Architecture Stack"@en ;
    rdfs:comment "Layered framework defining functional components and interfaces for metaverse systems to interoperate at network, data, and application levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
