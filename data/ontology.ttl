ngm:coin a owl:Class ;
    rdfs:label "Coin"@en ;
    rdfs:comment "A Coin is a native cryptographic asset issued and governed by a blockchain protocol itself, distinct from tokens created by smart contracts on top of an existing chain. Coins function as the primary medium of exchange for transaction fees, validator rewards, and network participation incentives within their respective distributed ledger ecosystems, and may also serve as stores of value, monetary reserves, or collateral in decentralised finance applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monetary-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:cryptocurrency-token ;
    vc:enables ngm:digital-asset-market,
        ngm:mining-reward,
        ngm:stablecoin-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:monetary-system,
        ngm:payment-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:cryptocurrency,
        ngm:digital-currency,
        ngm:economic-layer,
        ngm:monetary-sovereignty ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism ;
    vc:slug "coin" ;
    vc:sourceDomain "blockchain" .

