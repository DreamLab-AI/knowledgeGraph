    vc:enables ngm:automated-design,
        ngm:constraint-based-design,
        ngm:design-optimization,
        ngm:parametric-design-methodology-modeling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-generator,
