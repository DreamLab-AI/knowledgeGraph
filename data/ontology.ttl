ngm:webauthn a skos:Concept ;
    rdfs:label "Webauthn"@en .

ngm:webgl a skos:Concept ;
    rdfs:label "Webgl"@en .

ngm:webhook a owl:Class ;
    rdfs:label "Webhook"@en ;
    rdfs:comment "A webhook is an event-driven integration mechanism in which a server sends an HTTP request to a pre-registered URL when a specified event occurs, pushing data to consumers instead of requiring them to poll. It enables loosely coupled, near-real-time communication between web services and is a standard pattern for notifications, CI triggers, and payment events. Reliability concerns are addressed through retries, idempotency keys, and signature verification."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:presence-indicator ;
    vc:slug "webhook" ;
    vc:sourceDomain "infrastructure" .

ngm:workforce-management a owl:Class ;
    rdfs:label "Workforce Management"@en ;
    rdfs:comment "Workforce Management (WFM) encompasses the integrated set of processes, technologies, and practices that organisations use to optimise employee productivity, schedule labour resources, track attendance and time, manage compliance with labour regulations, and forecast staffing requirements. Modern WFM systems combine real-time data on demand, skill availability, and operational constraints to generate optimised schedules, and increasingly incorporate AI-driven forecasting and adaptive scheduling algorithms. The field is undergoing significant transformation as AI automation shifts skill requirements, gig economy models create more fluid workforce composition, and remote and hybrid working patterns demand new coordination approaches."@en ;
    rdfs:subClassOf ngm:workforce-development ;
    vc:enables ngm:agentic-workflow,
        ngm:customer-service-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-connected-workforce,
        ngm:planning-and-scheduling,
        ngm:workforce-augmentation ;
    vc:slug "workforce-management" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-driven-workforce-displacement-registry ;
    vc:uses ngm:automated-compliance,
        ngm:machine-learning-discipline .

ngm:xr-applications a owl:Class ;
    rdfs:label "XR Applications"@en ;
    rdfs:comment "XR Applications are software systems designed to run on extended reality platforms — encompassing augmented reality (AR), virtual reality (VR), and mixed reality (MR) — that blend real and virtual environments to deliver spatially aware, immersive user experiences. They span consumer entertainment, enterprise training, industrial maintenance, medical simulation, and remote collaboration domains."@en ;
    rdfs:subClassOf ngm:extended-reality ;
    vc:enables ngm:augmented-reality-collaboration,
        ngm:immersive-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:extended-reality-xr ;
    vc:slug "xr-applications" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:gpu-acceleration,
        ngm:head-mounted-display .

ngm:xr-headset a owl:Class ;
    rdfs:label "XR Headset"@en ;
    rdfs:comment "A head-mounted display device that delivers immersive visual and audio experiences for virtual reality, augmented reality, or mixed reality applications, featuring integrated displays, tracking sensors, audio systems, and processing capabilities for rendering digital content in the user's field of view."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
