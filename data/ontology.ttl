ngm:decentralised-governance a owl:Class ;
    rdfs:label "Decentralised Governance"@en ;
    rdfs:comment "A model of collective decision-making in which authority is distributed across participants rather than concentrated in a central body, often implemented through on-chain voting and smart contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:governance-framework ;
    vc:enables ngm:decentralised-autonomous-organisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract,
        ngm:transparency ;
    vc:slug "decentralised-governance" ;
    vc:sourceDomain "governance" .

