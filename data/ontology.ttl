ngm:vanishing-gradient-problem a owl:Class ;
    rdfs:label "Vanishing Gradient Problem"@en ;
    rdfs:comment "The vanishing gradient problem is a difficulty in training deep or recurrent neural networks in which error gradients shrink exponentially as they are propagated backwards through many layers or time steps, leaving early parameters with negligible updates. It arises because repeated multiplication by small derivative terms, characteristic of saturating activation functions, drives the gradient towards zero. The effect severely impedes learning of long-range dependencies and was a central obstacle to deep learning before mitigations emerged. Remedies include non-saturating activations, careful weight initialisation, normalisation, residual connections and gated recurrent architectures such as the LSTM."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:batch-normalisation,
        ngm:lstm ;
    vc:contrastsWith ngm:residual-connection ;
    vc:dependsOn ngm:backpropagation ;
    vc:enables ngm:residual-connection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:weight-initialisation ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:deep-learning,
        ngm:recurrent-neural-network ;
    vc:requires ngm:activation-function ;
    vc:slug "vanishing-gradient-problem" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:lstm ;
    vc:uses ngm:gradient-descent .

ngm:variance a skos:Concept ;
