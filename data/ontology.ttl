ngm:infrastructure-as-code a owl:Class ;
    rdfs:comment "Infrastructure as Code (IaC) is the practice of defining and provisioning computing infrastructure through machine-readable definition files rather than manual configuration. Declarative or imperative specifications describe the desired state of servers, networks, and services, which tooling then realises idempotently and reproducibly. Treating infrastructure like software allows version control, peer review, automated testing, and consistent deployment across environments, eliminating configuration drift."@en ;
    rdfs:label "Infrastructure as Code"@en ;
    rdfs:subClassOf ngm:automation ;
    rdfs:subClassOf _:r12590 ;
