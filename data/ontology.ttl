ngm:omnichain-application a owl:Class ;
    rdfs:comment "An omnichain application is a decentralised application designed to operate across multiple blockchain networks simultaneously, maintaining unified state, liquidity, and user identity without requiring users to bridge assets manually between chains. Unlike multi-chain applications that deploy isolated instances on separate chains, omnichain applications treat all supported networks as a single logical execution environment connected by cross-chain messaging protocols. LayerZero is the most widely adopted infrastructure enabling omnichain application patterns."@en ;
    rdfs:label "Omnichain Application"@en ;
    rdfs:subClassOf ngm:decentralized-application ;
    vc:enables ngm:cross-chain-asset-transfer ;
    vc:enables ngm:de-fi ;
