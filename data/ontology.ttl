    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-token,
        ngm:treasury-management ;
    vc:slug "lido-dao" ;
    vc:sourceDomain "blockchain" .

ngm:lifecycle-management a owl:Class ;
    rdfs:label "Lifecycle Management"@en ;
    rdfs:comment "Lifecycle management is the disciplined coordination of an asset, product, or system across all phases of its existence, from creation and deployment through operation, maintenance, and decommissioning. It defines processes, versioning, and governance that keep the entity consistent and accountable over time. For digital twins it ensures the virtual model stays synchronised with the physical asset throughout its operational life."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:construction-digital-twin,
        ngm:digital-twin-creation ;
    vc:slug "lifecycle-management" ;
    vc:sourceDomain "infrastructure" .

ngm:light-field a owl:Class ;
    rdfs:label "Light field"@en ;
    rdfs:comment "Light field is a foundational concept in computational optics and computer graphics describing the complete distribution of light rays travelling through free space in all directions at all points, formalised by Adelson and Bergen (1991) as the 7-dimensional plenoptic function P(Vx, Vy, Vz, θ, φ,..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lens-and-camera-calibration ],
