    vc:requires ngm:computer-vision ;
    vc:slug "optical-character-recognition" ;
    vc:sourceDomain "metaverse" .

ngm:optical-sensors a owl:Class ;
    rdfs:label "Optical Sensors"@en ;
    rdfs:comment "Optical Sensors are devices that detect and convert light, across visible, infrared, or other wavelengths, into electrical signals for measurement or imaging. They include cameras, photodiodes, depth sensors, and structured-light or time-of-flight units used to capture scene geometry and motion. In capture and recognition systems they provide the primary visual input from which 3D structure, pose, and identity are inferred."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-performance-capture,
        ngm:human-capture-and-recognition ;
    vc:slug "optical-sensors" ;
    vc:sourceDomain "robotics" .

ngm:optical-systems a owl:Class ;
    rdfs:label "Optical Systems"@en ;
    rdfs:comment "Optical Systems are arrangements of lenses, mirrors, waveguides, and combiners that direct and form light to project or relay images. In display hardware they govern how rendered content is delivered to the eye, including focus, field of view, and image clarity. Augmented- and virtual-reality headsets depend on compact optical systems such as pancake lenses and waveguide combiners to merge virtual imagery with the real world."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-display-device,
        ngm:display-hardware ;
    vc:slug "optical-systems" ;
    vc:sourceDomain "metaverse" .

ngm:ownership-record a owl:Class ;
    rdfs:label "Ownership Record"@en ;
    rdfs:comment "An Ownership Record is a persistent entry that attests who holds title to an asset at a given time. On a blockchain it is an immutable, timestamped ledger entry binding an asset identifier to a controlling address, providing tamper-evident provenance and transfer history. Such records underpin tokenized assets like certificates and royalty instruments where verifiable, auditable ownership is essential."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:creator-royalty-token,
        ngm:renewable-energy-certificates ;
    vc:slug "ownership-record" ;
    vc:sourceDomain "blockchain" .

ngm:ownership-token a owl:Class ;
    rdfs:label "Ownership Token"@en ;
    rdfs:comment "An Ownership Token is a blockchain token that represents and confers title to an underlying asset, whether digital or real-world. Typically implemented as a non-fungible or semi-fungible token, holding it in a wallet constitutes provable control of the represented item, and transferring it transfers ownership. Ownership tokens enable trading, collateralization, and programmable rights over digital goods and tokenized property."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-goods,
        ngm:digital-real-estate ;
    vc:slug "ownership-token" ;
    vc:sourceDomain "blockchain" .

ngm:parallel-corpus a owl:Class ;
    rdfs:label "Parallel Corpus"@en ;
    rdfs:comment "A Parallel Corpus is a collection of texts paired with their translations in one or more other languages, aligned at the sentence or segment level. It provides the supervised training signal for statistical and neural machine-translation systems by exemplifying how meaning maps across languages. The size, quality, and domain coverage of a parallel corpus strongly influence the accuracy of trained translation models."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:real-time-translation,
        ngm:translation ;
    vc:slug "parallel-corpus" ;
    vc:sourceDomain "ai" .

ngm:paris-agreement a owl:Class ;
    rdfs:label "Paris Agreement"@en ;
    rdfs:comment "An international treaty on climate change adopted in 2015 under which parties commit to limiting global temperature rise and to reporting on their emissions reduction efforts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainability ],
