# ZK-SNARKs
spatial-computing:ZKSNARKs rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ZeroKnowledgeProof ;
    rdfs:label "ZK-SNARKs"@en ;
    rdfs:comment "Zero-Knowledge Succinct Non-Interactive Arguments of Knowledge - a cryptographic proof system enabling one party to prove possession of information without revealing the information itself, characterized by small proof sizes, fast verification, and no interaction required between prover and verifier, though requiring a trusted setup ceremony."@en ;
    skos:prefLabel "ZK-SNARKs"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:zk-snarks" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:zk-snarks> ;
