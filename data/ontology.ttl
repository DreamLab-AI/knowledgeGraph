ngm:ambient-occlusion a owl:Class ;
    rdfs:label "Ambient Occlusion"@en ;
    rdfs:comment "A shading and rendering technique that approximates the degree to which each point on a surface is occluded from ambient environmental light by surrounding geometry, producing soft shadows in crevices, corners, and contact areas that significantly enhance the perception of three-dimensional form and material grounding. Unlike direct illumination algorithms, ambient occlusion is view-independent and operates on the assumption that ambient light arrives uniformly from all directions, making it computationally tractable as either a pre-baked texture or a real-time screen-space approximation. It is a foundational element of physically plausible rendering pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-geometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:surface-normal ],
        ngm:rendering-technique ;
    vc:bridgesTo ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:direct-illumination,
        ngm:shadow-mapping ;
    vc:enables ngm:perception,
        ngm:photorealistic-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:global-illumination,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ar-occlusion,
        ngm:dynamic-lighting,
        ngm:neural-rendering,
        ngm:occlusion-culling ;
    vc:requires ngm:scene-geometry,
        ngm:surface-normal ;
    vc:slug "ambient-occlusion" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-buffer,
        ngm:gpu-shader,
        ngm:physically-based-rendering,
        ngm:ray-tracing,
        ngm:sampling .

ngm:block-storage a owl:Class ;
    rdfs:label "Block Storage"@en ;
    rdfs:comment "Block Storage is an infrastructure storage paradigm that presents raw fixed-size blocks of data to a host operating system or hypervisor, which then manages formatting, file system placement, and I/O scheduling directly. Unlike object storage or file storage, block storage exposes a low-level disk abstraction enabling high-performance, low-latency random read/write operations suitable for databases, virtual machine boot disks, and transactional workloads. Cloud providers implement block storage as network-attached volumes (e.g., AWS EBS, GCP Persistent Disk) that can be dynamically provisioned and attached to compute instances."@en ;
    rdfs:subClassOf ngm:storage-systems ;
    vc:contrastsWith ngm:distributed-storage,
        ngm:object-storage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-storage-layer ;
    vc:slug "block-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-system,
        ngm:persistent-storage ;
    vc:uses ngm:file-system .

ngm:bounding-volume-hierarchy a owl:Class ;
    rdfs:label "Bounding Volume Hierarchy"@en ;
    rdfs:comment "A tree-structured acceleration data structure that recursively organizes geometric objects within nested bounding volumes, enabling efficient spatial queries, collision detection, and ray-scene intersection testing by rapidly culling large portions of geometry that cannot intersect with a query."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bounding-volume ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotics,
        ngm:spatial-data-structure ;
    vc:contrastsWith ngm:kd-tree,
        ngm:octree-spatial-index,
        ngm:uniform-grid ;
    vc:dependsOn ngm:geometric-primitive,
        ngm:scene-graph ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:global-illumination,
        ngm:occlusion-culling,
        ngm:ray-tracing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume,
        ngm:internal-node,
        ngm:leaf-node ;
    vc:implements ngm:spatial-partitioning ;
    vc:isPartOf ngm:rendering-pipeline,
        ngm:spatial-data-structure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gpu-acceleration,
        ngm:neural-radiance-field ;
    vc:requires ngm:bounding-volume,
        ngm:traversal-algorithm ;
    vc:slug "bounding-volume-hierarchy" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:physics-simulation,
        ngm:real-time-rendering,
        ngm:virtual-reality ;
    vc:uses ngm:depth-first-search,
        ngm:surface-area-heuristic .

ngm:c2-pa a owl:Class ;
    rdfs:label "C2PA"@en ;
    rdfs:comment "C2PA (Coalition for Content Provenance and Authenticity) is a cross-industry open technical standards body and specification that cryptographically binds signed provenance metadata — covering capture origin, editing history, and AI generation disclosure — to digital media assets including images, video, audio, and documents. Founded by Adobe, Arm, BBC, Intel, Microsoft, and Truepic under the Joint Development Foundation, the C2PA specification defines the manifest container format (JUMBF/ISO 19566-5), assertion vocabularies, COSE-based signing mechanism, X.509 PKI trust model, and the resulting Content Credentials artefact. C2PA consolidates two prior initiatives — Adobe's Content Authenticity Initiative (CAI) and the BBC-led Project Origin — into a single interoperable standard for end-to-end media provenance across capture, editing, distribution, and verification stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:c2-pa-content-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:provenance-ontology-prov-o,
        ngm:watermarking-service ;
    vc:contrastsWith ngm:deepfakes,
        ngm:synthetic-media ;
    vc:enables ngm:ai-generated-content-disclosure,
        ngm:media-authentication,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:c2-pa-content-credentials ;
    vc:implements ngm:content-authenticity ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:joint-development-foundation,
        ngm:open-media-alliance,
        ngm:w3-c-verifiable-credentials ;
    vc:requires ngm:certificate-authority,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "c2-pa" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:disinformation-countermeasures,
        ngm:supply-chain-transparency ;
    vc:uses ngm:cose,
        ngm:provenance-tracking,
        ngm:x-509-certificate .

ngm:certificate-transparency a owl:Class ;
    rdfs:label "Certificate Transparency"@en ;
    rdfs:comment "Certificate Transparency (CT) is an open framework and internet standard (RFC 6962 and RFC 9162) that creates a publicly auditable, append-only log of all TLS certificates issued by certificate authorities, enabling domain owners, browser vendors, and security researchers to detect misissued or fraudulent certificates rapidly. CT logs use Merkle hash trees to provide cryptographic proofs of inclusion and consistency, guaranteeing that any certificate added to a log cannot be subsequently removed or altered. Major browsers enforce CT by requiring certificates to carry signed certificate timestamps (SCTs) from recognised logs, making unauthorised certificate issuance immediately detectable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:append-only-log ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:public-key-infrastructure ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:supply-chain-security ;
    vc:contrastsWith ngm:ocsp ;
    vc:dependsOn ngm:domain-name-system ;
    vc:enables ngm:audit-trail,
        ngm:certificate-authority,
        ngm:security-monitoring,
        ngm:threat-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography,
        ngm:tls-1-3 ;
    vc:requires ngm:append-only-log,
        ngm:public-key-infrastructure ;
    vc:slug "certificate-transparency" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ca-browser-forum,
        ngm:ietf ;
    vc:uses ngm:audit-log,
        ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:merkle-tree,
        ngm:tls,
        ngm:x-509-certificate .

ngm:clearing-house a owl:Class ;
    rdfs:label "Clearing House"@en ;
    rdfs:comment "A clearing house is a financial market intermediary that stands between the buyers and sellers of a trade to guarantee its completion, most often acting as a central counterparty that legally interposes itself through novation. By collecting margin, mutualising risk across a default fund, and netting offsetting obligations, it reduces counterparty credit risk and systemic contagion in securities, derivatives, and payment markets. Clearing houses are critical financial market infrastructure, subject to stringent prudential supervision because their failure could propagate across the financial system."@en ;
    rdfs:subClassOf ngm:financial-market-infrastructure ;
    vc:enables ngm:financial-stability,
        ngm:settlement-finality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:central-counterparty,
        ngm:default-management,
        ngm:margin,
        ngm:netting ;
    vc:implements ngm:clearing,
        ngm:settlement ;
    vc:isPartOf ngm:financial-market-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:institutional-trust ;
    vc:slug "clearing-house" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:derivatives ;
    vc:uses ngm:collateral,
        ngm:risk-management .

ngm:compound-governor-bravo a owl:Class ;
    rdfs:label "Compound Governor Bravo"@en ;
    rdfs:comment "Compound Governor Bravo is the second-generation on-chain governance smart contract deployed by the Compound protocol, superseding Governor Alpha with configurable parameters and a clean separation between governance voting logic and the Timelock executor contract. It enables COMP token holders to create, vote on, and enqueue governance proposals that modify protocol parameters — including interest rate models, collateral factors, reserve factors, and supported asset listings — without requiring contract redeployment to adjust governance thresholds. Governor Bravo introduced an abstraction layer allowing the proposal threshold, voting delay, voting period, and quorum to be updated through the same governance process they govern, substantially reducing upgrade friction. The contract has become a widely forked reference implementation across decentralised finance, with derivatives adopted by Uniswap, Indexed Finance, and many other protocols seeking battle-tested on-chain governance infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-delegation ],
        ngm:on-chain-governance ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract-security ;
    vc:contrastsWith ngm:open-zeppelin-governor,
        ngm:snapshot-governance ;
    vc:dependsOn ngm:ethereum,
        ngm:governance-token ;
    vc:enables ngm:dao,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proposal-lifecycle,
        ngm:quorum-mechanism,
        ngm:token-weighted-voting ;
    vc:isPartOf ngm:compound,
        ngm:governance-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics,
        ngm:defi-protocol,
        ngm:governance-attack ;
    vc:requires ngm:ethereum-smart-contract-platform-smart-contracts,
        ngm:timelock,
        ngm:vote-delegation ;
    vc:slug "compound-governor-bravo" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:dao-governance ;
    vc:uses ngm:proposal-system,
        ngm:voting-mechanism .

ngm:computational-geometry a owl:Class ;
    rdfs:label "Computational Geometry"@en ;
    rdfs:comment "Computational geometry is the study of algorithms for solving geometric problems, such as finding convex hulls, intersections, and nearest points. It provides foundational techniques for computer graphics, robotics motion planning, geographic information systems, and computer-aided design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:numerical-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voronoi-diagram ],
        ngm:algorithm ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:dependsOn ngm:algorithm,
        ngm:graph-theory ;
    vc:enables ngm:3-d-engine,
        ngm:collision-detection,
        ngm:computer-aided-design,
        ngm:geographic-information-system,
        ngm:pathfinding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:voronoi-diagram ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:point-cloud-processing ;
    vc:requires ngm:data-structure,
        ngm:linear-algebra,
        ngm:numerical-methods ;
    vc:slug "computational-geometry" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:computer-vision,
        ngm:robotics ;
    vc:uses ngm:bounding-volume-hierarchy,
        ngm:spatial-index .

ngm:computational-hardness-assumption a owl:Class ;
    rdfs:label "Computational Hardness Assumption"@en ;
    rdfs:comment "A computational hardness assumption is a conjecture that a particular mathematical problem cannot be solved efficiently by any probabilistic polynomial-time algorithm. Such assumptions, including integer factorisation, the discrete logarithm, and learning-with-errors, are the foundations on which provable security of cryptographic schemes is reduced. If an assumption is broken, every construction whose security reduces to it is compromised."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:digital-signature ;
    vc:slug "computational-hardness-assumption" ;
    vc:sourceDomain "security" .

ngm:computer-hardware a owl:Class ;
    rdfs:label "Computer Hardware"@en ;
    rdfs:comment "Physical computing components optimised for artificial intelligence and spatial computing workloads, encompassing GPUs, TPUs, FPGAs, ASICs, and neuromorphic chips. Modern AI hardware emphasises parallel matrix processing, high-bandwidth memory, mixed-precision arithmetic, and energy-efficient inference at scale, enabling both large-model training and real-time rendering in immersive applications."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:gpu-compute ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:training ;
    vc:slug "computer-hardware" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:uses ngm:hardware-acceleration .

ngm:content-authenticity a owl:Class ;
    rdfs:label "Content Authenticity"@en ;
    rdfs:comment "Content authenticity is the property of a digital asset whereby its origin, creation history, and any subsequent modifications can be cryptographically verified and traced back to an identifiable source. It encompasses technical mechanisms — including cryptographic signatures, tamper-evident manifests, and provenance metadata — that allow consumers of media to assess whether content has been created or manipulated by humans or AI systems and whether it has been altered since its stated point of capture or creation. Content authenticity is increasingly codified through standards such as C2PA (Coalition for Content Provenance and Authenticity)."@en ;
    rdfs:subClassOf ngm:content-authentication ;
    vc:contrastsWith ngm:deepfakes-and-fraudulent-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:deepfakes,
        ngm:digital-signature,
        ngm:metadata-standard ;
    vc:slug "content-authenticity" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:c2-pa,
        ngm:cryptographic-signature,
        ngm:provenance-tracking .

ngm:content-identifier a owl:Class ;
    rdfs:label "Content Identifier"@en ;
    rdfs:comment "A Content Identifier (CID) is a self-describing, cryptographically derived label used in the InterPlanetary File System and IPLD ecosystem to uniquely identify and verify content through its hash, encoding the hash function used, the hash digest, and a multicodec descriptor for the serialised data format into a compact, version-aware multihash structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:content-addressing ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:content-addressing ;
    vc:enables ngm:deduplication,
        ngm:tamper-detection,
        ngm:verifiable-data-registry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:content-addressing ;
    vc:isPartOf ngm:ipfs,
        ngm:ipld ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:filecoin,
        ngm:ipfs-content-addressing,
        ngm:nft-metadata ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "content-identifier" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-integrity,
        ngm:distributed-storage,
        ngm:peer-to-peer-network ;
    vc:uses ngm:ipld,
        ngm:merkle-dag,
        ngm:multibase,
        ngm:multicodec,
        ngm:multihash .

ngm:custodial-wallet a owl:Class ;
    rdfs:label "Custodial Wallet"@en ;
    rdfs:comment "A custodial wallet is a cryptocurrency wallet in which a third party — typically an exchange or custodian — holds and controls the private keys on behalf of the user, who accesses funds through an account rather than direct on-chain key ownership. This model trades the self-sovereignty of non-custodial wallets for convenience, account recovery, and integrated services, while introducing counterparty risk and reliance on the custodian's security and solvency. Custodial arrangements are common at centralised exchanges and increasingly subject to regulatory requirements for asset segregation and proof of reserves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:digital-wallet ;
    vc:bridgesTo ngm:mpc-wallet ;
    vc:contrastsWith ngm:multi-signature-wallet,
        ngm:non-custodial-wallet,
        ngm:self-custody ;
    vc:dependsOn ngm:key-management,
        ngm:trusted-third-party ;
    vc:enables ngm:account-recovery,
        ngm:fiat-on-ramp ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:account-balance-ledger,
        ngm:omnibus-account ;
    vc:implements ngm:proof-of-reserves ;
    vc:isPartOf ngm:centralised-exchange ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:counterparty-risk,
        ngm:cryptocurrency-custody ;
    vc:requires ngm:know-your-customer ;
    vc:slug "custodial-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:exchange-custody,
        ngm:institutional-custody ;
    vc:uses ngm:cold-storage,
        ngm:hot-wallet .

ngm:data-architecture a owl:Class ;
    rdfs:label "Data Architecture"@en ;
    rdfs:comment "Data architecture is the discipline of designing the structures, standards, models and integration patterns that govern how an organisation collects, stores, transforms, moves and consumes data. It defines logical and physical data models, storage technologies, data flows, master data strategies and the policies that ensure consistency, quality and security across systems. As a component of enterprise architecture, it provides the blueprint that aligns data assets with business and analytical requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-warehouse ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:master-data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-standards ],
        ngm:enterprise-architecture ;
    vc:bridgesTo ngm:data-management ;
    vc:contrastsWith ngm:information-architecture ;
    vc:dependsOn ngm:data-governance,
        ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-lake,
        ngm:data-pipeline,
        ngm:data-warehouse,
        ngm:master-data-management ;
    vc:isPartOf ngm:enterprise-architecture,
        ngm:information-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:enterprise-architecture ;
    vc:requires ngm:data-quality,
        ngm:data-standards ;
    vc:slug "data-architecture" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-management ;
    vc:uses ngm:microservices .

ngm:data-ingestion a owl:Class ;
    rdfs:label "Data Ingestion"@en ;
    rdfs:comment "Data ingestion is the process of acquiring data from heterogeneous sources and moving it into a target store or processing system for downstream use. It covers batch and streaming acquisition, format normalisation, validation and routing, and forms the entry stage of data pipelines. In spatial-computing contexts ingestion handles sensor streams and captured geometry before reconstruction and analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        ngm:data-pipeline ;
    vc:dependsOn ngm:data-integrity ;
    vc:enables ngm:feature-engineering,
        ngm:training-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-collection,
        ngm:sensor-fusion ;
    vc:isPartOf ngm:data-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:observability,
        ngm:scalability ;
    vc:requires ngm:data-quality,
        ngm:schema ;
    vc:slug "data-ingestion" ;
