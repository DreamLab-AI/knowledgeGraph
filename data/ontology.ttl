    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:bounding-volume,
        ngm:traversal-algorithm,
        ngm:tree-construction ;
    vc:slug "bounding-volume-hierarchy" ;
    vc:sourceDomain "spatial-computing" .

ngm:business-intelligence a owl:Class ;
    rdfs:label "Business Intelligence"@en ;
    rdfs:comment "Business intelligence is the set of technologies, processes, and practices for collecting, integrating, analysing, and presenting business data to support managerial decision-making. It encompasses data warehousing, reporting, dashboards, online analytical processing (OLAP), and ad-hoc querying that turn raw operational records into actionable insight. BI matters because it converts dispersed enterprise data into a coherent, queryable foundation for performance monitoring and strategic planning."@en ;
