ngm:data-collection a owl:Class ;
    rdfs:label "Data Collection"@en ;
    rdfs:comment "Data collection is the systematic process of gathering raw observations, measurements, or records from primary sources — including sensors, user interactions, instruments, surveys, and web scraping — in a form suitable for storage, processing, and analysis. As a foundational stage of the data lifecycle, it determines the completeness, representativeness, and quality of all downstream analytical products. In machine learning contexts, data collection encompasses sourcing, labelling, and curating training datasets that govern model capability and bias characteristics."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:enables ngm:data-pipeline,
        ngm:data-processing,
        ngm:training-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:data-privacy,
        ngm:data-provenance,
        ngm:synthetic-data ;
    vc:slug "data-collection" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:data-annotation,
        ngm:io-t-sensor-network .

ngm:data-management-domain a owl:Class ;
    rdfs:label "Data Management Domain"@en ;
    rdfs:comment "The Data Management Domain classifies concepts concerning the storage, organisation, retrieval and lifecycle of data within systems. It covers data models, storage architectures, integration and the operations that maintain availability and integrity. As a top-level subject axis it provides the technical foundation on which analytics, governance and applications operate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
