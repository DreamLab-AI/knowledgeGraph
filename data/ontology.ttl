ngm:clinical-decision-support a owl:Class ;
    rdfs:label "Clinical Decision Support"@en ;
    rdfs:comment "Clinical Decision Support (CDS) refers to AI systems that provide healthcare professionals with patient-specific assessments, recommendations, and information to support clinical decision-making at the point of care."@en ;
