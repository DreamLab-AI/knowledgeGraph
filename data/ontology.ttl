ngm:imf-crypto-asset-classification-framework a owl:Class ;
    rdfs:label "IMF Crypto Asset Classification Framework"@en ;
    rdfs:comment "The IMF Crypto Asset Classification Framework is the International Monetary Fund's taxonomy and policy guidance for categorising crypto assets by their economic function and legal characteristics, such as whether they serve as means of payment, investment instruments, or stablecoins. It informs consistent statistical treatment, regulation, and macro-financial risk monitoring across jurisdictions. The framework supports coherent global oversight of the crypto-asset sector."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
