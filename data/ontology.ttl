ngm:high-bandwidth-interconnect a owl:Class ;
    rdfs:comment "A high-bandwidth interconnect is a communication link or fabric engineered to move very large volumes of data between processors, accelerators, or nodes with minimal latency, enabling tightly-coupled parallel computation. In machine learning it is the substrate over which gradients, activations, and parameters are exchanged during distributed training, directly bounding how efficiently models scale across many devices. Technologies such as NVLink, InfiniBand, and RDMA fabrics provide the throughput that large-scale training demands."@en ;
    rdfs:label "High Bandwidth Interconnect"@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    rdfs:subClassOf _:r11662 ;
    rdfs:subClassOf _:r11663 ;
