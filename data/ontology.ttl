ngm:fashion a owl:Class ;
    rdfs:label "Fashion"@en ;
    rdfs:comment "Fashion, as an AI-application domain, encompasses the convergence of machine learning, computer vision, generative models, and blockchain supply-chain infrastructure with the global apparel, luxury, and textile industries, valued at approximately 1.7 and forecast to reach 2.1 by 2030 ."@en ;
    rdfs:subClassOf ngm:creative-industries,
        ngm:retail-technology ;
    vc:enables ngm:carbon-credit-tracking,
        ngm:carbon-footprint-measurement,
        ngm:circular-economy,
        ngm:digital-ownership,
        ngm:mass-customisation,
        ngm:personalised-retail,
        ngm:sustainable-production ;
    vc:hasPart ngm:ai-styling,
        ngm:aura-blockchain,
        ngm:digital-fashion,
        ngm:generative-design,
        ngm:on-demand-manufacturing,
        ngm:product-passport,
        ngm:supply-chain-traceability,
        ngm:sustainability-metrics,
        ngm:trend-forecasting,
        ngm:virtual-try-on ;
    vc:implements ngm:blockchain-as-a-service,
        ngm:carbon-neutral-blockchain,
        ngm:collaborative-filtering,
        ngm:neural-garment-warping,
        ngm:nft,
        ngm:stable-diffusion,
        ngm:supply-chain-traceability ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agentic-internet,
        ngm:ai-adoption,
        ngm:ai-companies,
        ngm:ai-diagram-tools,
        ngm:animate-diff,
        ngm:brain-computer-interfaces,
        ngm:comfy-ui-client,
        ngm:comfy-ui-workflows ;
    vc:requires ngm:ar-frame,
        ngm:blockchain-network,
        ngm:body-estimation-networks,
        ngm:computer-vision,
        ngm:diffusion-models,
        ngm:nft,
        ngm:recommendation-systems ;
    vc:slug "fashion" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:eu-digital-product-passport,
        ngm:gots-organic-textile-standard,
