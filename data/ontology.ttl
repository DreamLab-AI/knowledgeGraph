        ngm:digital-twin,
        ngm:perception-system ;
    vc:dependsOn ngm:geospatial-information,
        ngm:sensor-fusion ;
    vc:enables ngm:classification,
        ngm:disaster-response,
        ngm:environmental-assessment,
        ngm:mapping,
        ngm:object-recognition,
        ngm:precision-agriculture ;
