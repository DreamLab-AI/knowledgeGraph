    vc:sourceDomain "distributed-collaboration" .

ngm:data-analysis a owl:Class ;
    rdfs:label "Data Analysis"@en ;
    rdfs:comment "Data analysis is the systematic process of inspecting, cleaning, transforming, and modelling data to extract useful information, support decision-making, and test hypotheses. It encompasses descriptive summarisation, exploratory analysis to surface structure and anomalies, inferential statistics to generalise from samples, and predictive modelling. Data analysis spans manual statistical work through to automated analytics pipelines, and it is the disciplinary core from which data science, business intelligence, and machine-learning workflows draw. Rigorous analysis attends to data quality, sampling bias, and the validity of inferential assumptions."@en ;
    rdfs:subClassOf ngm:process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:predictive-analytics,
        ngm:time-series-analysis ;
    vc:slug "data-analysis" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:data-analytics,
        ngm:statistics .

ngm:data-centre a owl:Class ;
    rdfs:label "Data Centre"@en ;
    rdfs:comment "A data centre is a dedicated facility that houses computing, storage and networking infrastructure together with the power, cooling and physical security needed to operate them reliably. It provides the consolidated environment for hosting servers, cloud services and high-performance workloads such as AI training. Its energy and power demands make efficiency, measured through metrics like PUE, a central operational and sustainability concern."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "data-centre" ;
    vc:sourceDomain "infrastructure" .

ngm:data-contracts a owl:Class ;
    rdfs:label "Data Contracts"@en ;
    rdfs:comment "A data contract is a formal, versioned agreement between data producers and consumers that specifies the schema, semantics, quality guarantees and service-level expectations of a dataset or stream. It makes data interfaces explicit and enforceable, enabling automated validation and breaking-change detection in data pipelines. Data contracts are a metadata-management practice that improves reliability and trust across decentralised data ownership."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "data-contracts" ;
    vc:sourceDomain "data" .

ngm:data-deduplication a owl:Class ;
    rdfs:label "Data Deduplication"@en ;
    rdfs:comment "Data deduplication is the process of detecting and eliminating redundant copies of data so that only unique instances are retained or referenced. In storage it reduces capacity and bandwidth needs through chunk- or block-level matching, while in data preparation it removes duplicate records to improve quality. It is foundational for clean training data and for identity resolution where records must be matched and merged."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-resolution,
        ngm:training-data ;
    vc:slug "data-deduplication" ;
    vc:sourceDomain "data" .

ngm:data-efficient-learning a owl:Class ;
    rdfs:label "Data Efficient Learning"@en ;
    rdfs:comment "Data Efficient Learning encompasses machine learning techniques that achieve strong generalisation from limited labelled training examples, including transfer learning, few-shot learning, semi-supervised learning, data augmentation, and self-supervised pretraining. These methods address real-world constraints where large annotated datasets are impractical to obtain, making AI deployable in specialised or resource-constrained domains."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:active-learning,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:curriculum-learning ;
    vc:slug "data-efficient-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:synthetic-data,
        ngm:transfer-learning .

ngm:data-integration-interface a owl:Class ;
    rdfs:label "Data Integration Interface"@en ;
    rdfs:comment "A standardized set of protocols, rules, and formats for unifying and mediating data flows across heterogeneous platforms, enabling seamless data exchange and interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-management,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:cross-platform-data-exchange,
        ngm:data-federation,
        ngm:real-time-synchronization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-adapter,
        ngm:message-broker,
        ngm:protocol-translator,
        ngm:schema-mapper ;
    vc:isPartOf ngm:data-management,
        ngm:interoperability-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:api-gateway,
        ngm:communication-protocol,
        ngm:data-schema ;
    vc:slug "data-integration-interface" ;
    vc:sourceDomain "infrastructure" .

ngm:data-loss-prevention a owl:Class ;
    rdfs:label "Data Loss Prevention"@en ;
    rdfs:comment "Data loss prevention (DLP) is a set of security controls and technologies that detect and block the unauthorised exfiltration, leakage or misuse of sensitive data. DLP systems classify content, monitor data in use, in motion and at rest, and enforce policies at endpoints, networks and cloud services. It is a core data-protection capability supporting compliance with privacy and confidentiality requirements."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:data-protection ;
    vc:slug "data-loss-prevention" ;
    vc:sourceDomain "security" .

ngm:data-observability a owl:Class ;
    rdfs:label "Data Observability"@en ;
    rdfs:comment "Data observability is the practice of continuously monitoring the health and reliability of data and data pipelines to detect, diagnose and resolve issues before they affect consumers. It tracks pillars such as freshness, volume, schema, distribution and lineage, often using automated anomaly detection. As an extension of metadata management it brings software-style monitoring discipline to data systems."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "data-observability" ;
    vc:sourceDomain "data" .

ngm:data-sharing a owl:Class ;
    rdfs:label "Data Sharing"@en ;
    rdfs:comment "The controlled exchange of datasets, data streams, or derived information between organisations, systems, or individuals under agreed governance, access control, and privacy constraints. Data sharing in distributed infrastructure contexts relies on interoperability standards, consent management frameworks, and data governance policies to balance openness with security and sovereignty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-interoperability,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-sovereignty,
        ngm:privacy ;
    vc:requires ngm:access-control,
        ngm:data-governance ;
    vc:slug "data-sharing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-standards,
        ngm:interoperability .

ngm:data-virtualization a owl:Class ;
    rdfs:label "Data Virtualization"@en ;
    rdfs:comment "A data integration approach that creates a virtual abstraction layer enabling users and applications to access, query, and integrate data from multiple disparate sources as a single unified system without physically moving or replicating the underlying data, supporting real-time access and reduci..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        ngm:data-integration,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-federation,
        ngm:real-time-data-access,
        ngm:unified-data-view ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:data-connectors,
        ngm:metadata-management,
        ngm:query-engine ;
    vc:slug "data-virtualization" ;
    vc:sourceDomain "infrastructure" .

ngm:dbpedia a owl:Class ;
    rdfs:label "DBpedia"@en ;
    rdfs:comment "DBpedia is a community project that extracts structured information from Wikipedia and publishes it as an interlinked, openly licensed knowledge graph in RDF. It exposes millions of entities through a SPARQL endpoint and dereferenceable URIs, forming a central hub of the Linked Open Data cloud. It is widely used as background knowledge for knowledge-graph construction, entity linking and semantic search."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing ;
    vc:slug "dbpedia" ;
    vc:sourceDomain "data" .

ngm:dds a owl:Class ;
    rdfs:label "DDS"@en ;
    rdfs:comment "DDS, the Data Distribution Service, is an Object Management Group standard for a publish-subscribe middleware that distributes real-time data between distributed system components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:middleware ;
    vc:enables ngm:robot-operating-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:network-protocol ;
    vc:slug "dds" ;
    vc:sourceDomain "software-engineering" .

ngm:decentralised-identifier a owl:Class ;
    rdfs:label "Decentralised Identifier"@en ;
    rdfs:comment "A type of globally unique identifier, defined by a W3C standard, that is controlled by its subject and resolves to a document without depending on a central registry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:digital-identity ;
    vc:enables ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:public-key-cryptography ;
    vc:slug "decentralised-identifier" ;
    vc:sourceDomain "cryptographic" .

ngm:decentralized-identifier a owl:Class ;
    rdfs:label "Decentralized Identifier"@en ;
    rdfs:comment "A decentralised identifier is a globally unique identifier that a subject can create and control without a central registry, defined by a W3C standard. It resolves to a document describing keys and service endpoints for verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolution ],
        ngm:digital-identity ;
    vc:enables ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:did-resolution ;
    vc:slug "decentralized-identifier" ;
    vc:sourceDomain "identity" .

ngm:decentralized-swarm-control a owl:Class ;
    rdfs:label "Decentralized Swarm Control"@en ;
    rdfs:comment "Decentralised swarm control distributes decision-making across all robot agents, where each robot computes commands based solely on local sensor information and direct communication with neighbouring agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asynchronous-coordination ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inter-agent-communication ],
        ngm:robo-robot-type,
        ngm:swarm-robotics ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:adaptive-swarm-behaviour,
        ngm:emergent-task-performance,
        ngm:fault-tolerance,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent-autonomy,
        ngm:emergent-behaviour,
        ngm:local-decision-logic,
        ngm:neighbourhood-communication ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:asynchronous-coordination,
        ngm:distributed-algorithm,
        ngm:inter-agent-communication,
        ngm:local-sensing ;
    vc:slug "decentralized-swarm-control" ;
    vc:sourceDomain "robotics" .

ngm:decision-making a owl:Class ;
    rdfs:label "Decision Making"@en ;
    rdfs:comment "Decision making is the cognitive and computational process of selecting a course of action from a set of alternatives based on available information and objectives."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "decision-making" ;
    vc:sourceDomain "cognitive-science" .

ngm:decision-rights a owl:Class ;
    rdfs:label "Decision Rights"@en ;
    rdfs:comment "Decision rights are the formally allocated authorities that determine who may make, approve, or veto a given class of decisions within an organisation or governance system. They specify the mapping between roles or stakeholders and the scope of choices they control, forming the backbone of accountability. Clear decision rights reduce ambiguity, prevent conflicting actions, and enable auditable governance."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:governance-domain,
        ngm:governance-framework ;
    vc:slug "decision-rights" ;
    vc:sourceDomain "governance" .

ngm:delivery-versus-payment a owl:Class ;
    rdfs:label "Delivery-Versus-Payment"@en ;
    rdfs:comment "Delivery-Versus-Payment (DvP) is a securities settlement mechanism that links the transfer of a financial instrument to the simultaneous transfer of payment, ensuring that delivery occurs if and only if payment occurs, thereby eliminating principal risk in securities transactions. It is the standard settlement model mandated or strongly encouraged by financial market infrastructures globally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-infrastructure ],
        ngm:payment-system ;
    vc:enables ngm:custody-infrastructure,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-market ;
    vc:requires ngm:financial-infrastructure ;
    vc:slug "delivery-versus-payment" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:atomic-swap,
        ngm:digital-asset .

ngm:demand-response-mining a owl:Class ;
    rdfs:label "Demand Response Mining"@en ;
    rdfs:comment "Demand response mining is the practice of operating cryptocurrency miners as a flexible, interruptible electrical load that ramps up or down in response to grid conditions and price signals. Miners absorb surplus or stranded generation and shut off during peak demand, helping balance the grid while monetising otherwise curtailed energy. It is studied as both a grid-stabilisation tool and a mitigation for the environmental criticism of proof-of-work mining."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:stranded-energy-monetisation ;
    vc:slug "demand-response-mining" ;
    vc:sourceDomain "blockchain" .

ngm:democratic-values a owl:Class ;
    rdfs:label "Democratic Values"@en ;
    rdfs:comment "Principles and practices of democratic governance—including pluralism, participatory decision-making, transparent governance, electoral integrity, free formation of political will, and protection of civic space—which AI systems and digital platforms should respect and strengthen rather than undermine. As codified in the OECD AI Principles 2024 and the EU AI Act, these values impose specific constraints on AI deployment in electoral, civic, and public-interest contexts."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:policy-enforcement ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:democratic-governance,
        ngm:eu-ai-act,
        ngm:privacy ;
    vc:slug "democratic-values" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:accountability,
        ngm:governance,
        ngm:transparency .

ngm:denavit-hartenberg-parameters a owl:Class ;
    rdfs:label "Denavit-Hartenberg Parameters"@en ;
    rdfs:comment "Denavit-Hartenberg (DH) parameters are a standardised four-parameter convention for describing the relative geometry between consecutive links of a robotic manipulator. Each joint is characterised by link length, link twist, link offset, and joint angle, yielding a homogeneous transformation matrix per joint. Chaining these matrices gives a compact, systematic model of the arm's kinematics."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:kinematics-model ;
    vc:slug "denavit-hartenberg-parameters" ;
    vc:sourceDomain "robotics" .

ngm:deployer a owl:Class ;
    rdfs:label "Deployer"@en ;
    rdfs:comment "A Deployer, as defined in EU AI Act Article 3(4), is a natural or legal person, public authority, agency, or other body that uses an AI system under its authority in a professional context. Deployers bear obligations for human oversight, input data monitoring, logging, and fundamental rights impact assessments for high-risk AI systems. They are distinct from providers (who develop or place AI systems on the market) and incur provider-level obligations if they substantially modify an AI system."@en ;
    rdfs:subClassOf ngm:digital-infrastructure,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:ai-governance,
        ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-and-ethics ;
    vc:slug "deployer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-regulation ;
    vc:uses ngm:ai-agent-system,
        ngm:autonomous-robot .

ngm:deposit-return-scheme a owl:Class ;
    rdfs:label "Deposit Return Scheme"@en ;
    rdfs:comment "A deposit return scheme is a circular-economy mechanism in which consumers pay a small refundable deposit on a beverage container at purchase and reclaim it on returning the empty for recycling or reuse. The financial incentive drives high collection rates and clean material streams, reducing litter and supporting closed-loop recycling. It is a recognised instrument of reverse logistics and extended producer responsibility."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:reverse-logistics ;
    vc:slug "deposit-return-scheme" ;
    vc:sourceDomain "supply-chain" .

ngm:deterministic-serialisation a owl:Class ;
    rdfs:label "Deterministic Serialisation"@en ;
    rdfs:comment "Deterministic serialisation is the encoding of structured data into bytes such that semantically identical inputs always yield exactly the same byte sequence. It fixes ambiguities like map-key ordering, number formatting, and whitespace so that the output is canonical and reproducible. This property is essential for hashing, digital signatures, and content addressing, where any byte difference changes the resulting digest."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:uri-canonicaliser ;
    vc:slug "deterministic-serialisation" ;
    vc:sourceDomain "data" .

ngm:dialogue-state-tracking a owl:Class ;
    rdfs:label "Dialogue State Tracking"@en ;
    rdfs:comment "A component of conversational systems that maintains a structured representation of the user's goals and the context of a conversation across turns. It updates the dialogue state as new utterances are processed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:dialogue-system ;
    vc:enables ngm:conversational-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:natural-language-processing ;
    vc:slug "dialogue-state-tracking" ;
    vc:sourceDomain "natural-language-processing" .

ngm:differential-drive-robot a owl:Class ;
    rdfs:label "Differential Drive Robot"@en ;
    rdfs:comment "Differential drive robot uses two independently controlled wheels on opposite sides to enable both forward/backward locomotion and in-place rotation, forming the most widely deployed Mobile Robot architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motor-driver ],
        ngm:robo-robot-type,
        ngm:wheeled-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:arc-trajectory-following,
        ngm:forward-locomotion,
        ngm:in-place-rotation,
        ngm:point-turning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:caster-wheel,
        ngm:differential-drive-controller,
        ngm:left-drive-motor,
        ngm:right-drive-motor,
        ngm:wheel ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:independent-wheel-motors,
        ngm:motor-driver,
        ngm:odometry-sensors,
        ngm:power-battery ;
    vc:slug "differential-drive-robot" ;
    vc:sourceDomain "robotics" .

ngm:difficulty a owl:Class ;
    rdfs:label "Difficulty"@en ;
    rdfs:comment "Difficulty is a dynamic parameter in proof-of-work blockchain systems that expresses the computational effort required to find a valid block hash—specifically, the number of leading zeros (or equivalent target threshold) that a candidate block hash must satisfy for the block to be accepted by the network. The difficulty value is adjusted periodically by the protocol based on the observed rate of block production relative to the target interval, ensuring that new blocks are produced at a predictable rate regardless of fluctuations in aggregate network hash rate. Difficulty is the primary mechanism by which proof-of-work blockchains self-regulate their monetary policy and security budget."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:dependsOn ngm:blockchain-network ;
    vc:enables ngm:consensus-protocol,
        ngm:mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment,
        ngm:nonce ;
    vc:isPartOf ngm:blockchain-protocol,
        ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-time,
        ngm:blockchain-energy-consumption,
        ngm:mining-reward ;
    vc:requires ngm:hash-function,
        ngm:proof-of-work ;
    vc:slug "difficulty" ;
    vc:sourceDomain "blockchain" .

ngm:diffusion-policy a owl:Class ;
    rdfs:label "Diffusion Policy"@en ;
    rdfs:comment "Diffusion Policy is a class of robot learning algorithms that represent robot action sequences as the output of a conditional denoising diffusion process, treating action prediction as iterative noise removal conditioned on sensor observations rather than as direct regression or classification. By leveraging the expressiveness of diffusion models to capture multi-modal action distributions, Diffusion Policy can represent one-to-many mappings from observation to action — a critical capability for dexterous manipulation tasks where multiple valid action trajectories exist. The approach, introduced by Chi et al. (2023), achieves state-of-the-art performance on imitation learning benchmarks and generalises across diverse manipulation settings."@en ;
    rdfs:subClassOf ngm:robot-learning ;
    vc:enables ngm:embodied-ai,
        ngm:robot-manipulation,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:reinforcement-learning ;
    vc:slug "diffusion-policy" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:diffusion-model,
        ngm:flow-matching,
        ngm:imitation-learning .

ngm:digital-art-application a owl:Class ;
    rdfs:label "Digital Art Application"@en ;
    rdfs:comment "Software platforms and tools enabling artists to create, manipulate, and distribute visual art using digital technologies, including generative AI systems, 3D modeling software, and NFT minting platforms that facilitate artistic expression and commerce in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-systems ],
        ngm:creative-software,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-art-creation,
        ngm:nft-minting,
        ngm:virtual-exhibitions ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:graphics-processing,
        ngm:storage-systems,
        ngm:user-interface ;
    vc:slug "digital-art-application" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-asset-risks a owl:Class ;
    rdfs:label "Digital Asset Risks"@en ;
    rdfs:comment "Comprehensive analysis of risks associated with digital assets, particularly Bitcoin, encompassing technical vulnerabilities, regulatory challenges, geopolitical concerns, financial stability threats, and systemic implications for global monetary systems. Covers attack vectors such as 51% attacks, selfish mining, network partitioning, exchange failures, and regulatory suppression, alongside macro-level risks including volatility, liquidity crises, and stablecoin depegging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
