ngm:virtual-reality-vr a owl:Class ;
    rdfs:label "Virtual Reality (VR)"@en ;
    rdfs:comment "Immersive technology system that combines physical head-mounted display hardware with virtual computer-generated 3D environments to create fully encompassing sensory experiences that replace user perception of the physical world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:6-do-f-tracking ],
        [ a owl:Restriction ;
