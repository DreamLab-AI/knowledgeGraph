ngm:deepfakes-and-fraudulent-content a owl:Class ;
    rdfs:label "Deepfakes and fraudulent content"@en ;
    rdfs:comment "Deepfakes and fraudulent content denote synthetic audio, image, video and text artefacts produced by deep generative models (notably GAN-based face-swap pipelines DeepFaceLab/Faceswap/StyleGAN3, diffusion-based face-conditioning ReActor/Roop/InstantID/PhotoMaker/IP-Adapter-Face, lip-sync video ge..."@en ;
