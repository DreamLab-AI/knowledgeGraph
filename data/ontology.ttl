ngm:large-language-model-training a owl:Class ;
    rdfs:label "Large Language Model Training"@en ;
    rdfs:comment "Large Language Model Training is the computational process of optimising the parameters of a transformer-based neural network with billions to trillions of weights on web-scale text corpora using autoregressive next-token prediction objectives, followed by instruction tuning and reinforcement learning from human feedback (RLHF) alignment stages. The process requires distributed training across thousands of GPU or TPU accelerators coordinated through data, tensor, and pipeline parallelism, consuming petabytes of training data and megawatt-hours of electrical energy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mixed-precision-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-training ],
        ngm:pre-training ;
    vc:bridgesTo ngm:data-centre-infrastructure,
        ngm:high-performance-computing ;
    vc:contrastsWith ngm:parameter-efficient-fine-tuning ;
    vc:dependsOn ngm:reward-model,
        ngm:scaling-law,
        ngm:tokenisation ;
    vc:enables ngm:emergent-capability,
        ngm:fine-tuning,
        ngm:foundation-model,
        ngm:in-context-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alignment-stage,
        ngm:pre-training,
        ngm:supervised-fine-tuning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mixture-of-experts,
        ngm:synthetic-data-generation ;
    vc:requires ngm:distributed-training,
        ngm:gpu-cluster,
        ngm:mixed-precision-training,
        ngm:training-data-corpus ;
    vc:slug "large-language-model-training" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:data-parallelism,
        ngm:direct-preference-optimisation,
        ngm:gradient-checkpointing,
        ngm:instruction-tuning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:stochastic-gradient-descent,
        ngm:transformer .

ngm:latency-aware-edge-ai a owl:Class ;
    rdfs:label "Latency-Aware Edge AI"@en ;
    rdfs:comment "Latency-Aware Edge AI is a design paradigm for machine learning systems deployed at the network edge that dynamically adapts inference strategies, model selection, and compute offloading decisions to satisfy hard or soft real-time response-time deadlines. Such systems continuously monitor available time budgets, device load, and network conditions, trading accuracy for speed when necessary to maintain service-level objectives. Applications span autonomous vehicles, mobile augmented reality, and industrial robotics, where missed deadlines carry safety or quality consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:gpu-compute ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:computer-vision,
        ngm:edge-ai-system ;
    vc:requires ngm:edge-computing,
        ngm:inference-hardware ;
    vc:slug "latency-aware-edge-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:edge-ai-accelerators,
        ngm:inference .

ngm:latency-management-protocol a owl:Class ;
    rdfs:label "Latency Management Protocol"@en ;
    rdfs:comment "A systematic process for monitoring, measuring, and minimizing network delay in interactive metaverse sessions through adaptive techniques including traffic prioritization, predictive buffering, and dynamic routing optimization."@en ;
