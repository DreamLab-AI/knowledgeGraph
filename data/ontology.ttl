        ngm:routing-protocol ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:distributed-coordination-protocol,
        ngm:network-connectivity,
        ngm:service-discovery ;
    vc:slug "edge-mesh-network" ;
    vc:sourceDomain "spatial-computing" .

ngm:edge-network a owl:Class ;
    rdfs:label "Edge Network"@en ;
    rdfs:comment "Distributed set of computing nodes providing local processing close to users to improve performance, reduce latency, and optimize bandwidth for immersive applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordination-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:orchestration-layer ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:bandwidth-optimization,
        ngm:distributed-processing,
        ngm:latency-reduction,
        ngm:regional-compute ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:edge-computing-node,
        ngm:load-distribution-service,
        ngm:network-management-system,
        ngm:orchestration-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:connectivity-fabric,
        ngm:coordination-protocol,
        ngm:network-infrastructure ;
    vc:slug "edge-network" ;
    vc:sourceDomain "spatial-computing" .

ngm:education a owl:Class ;
    rdfs:label "Education"@en ;
    rdfs:comment "Education is the structured process of facilitating learning, knowledge and skills through teaching, study and training. It occurs in formal institutions and through informal and online means."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:assistive-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "education" ;
    vc:sourceDomain "education" .

ngm:educational-credentials a owl:Class ;
    rdfs:label "Educational Credentials"@en ;
    rdfs:comment "Educational Credentials are formal attestations of learning achievement, such as diplomas, degrees, certificates, and micro-credentials, issued by an educational authority. When expressed as verifiable credentials they can be cryptographically signed and held by the learner, allowing tamper-evident, privacy-preserving verification without contacting the issuer. They are a primary use case for decentralised, self-sovereign identity systems."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-identity,
        ngm:self-sovereign-identity ;
    vc:slug "educational-credentials" ;
    vc:sourceDomain "security" .

ngm:educational-narrative a owl:Class ;
    rdfs:label "Educational Narrative"@en ;
    rdfs:comment "Immersive storytelling techniques employed in metaverse learning environments that place learners within engaging storylines, utilising narrative transportation to make complex concepts more approachable and significantly improve learning outcomes through active participation."@en ;
    rdfs:subClassOf ngm:immersive-learning,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "educational-narrative" ;
    vc:sourceDomain "spatial-computing" .

ngm:eip-7702 a owl:Class ;
    rdfs:label "EIP-7702"@en ;
    rdfs:comment "EIP-7702 is an Ethereum Improvement Proposal that lets externally owned accounts temporarily act with smart contract code to support account abstraction features."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum ;
    vc:slug "eip-7702" ;
    vc:sourceDomain "standards" .

ngm:eip-process a owl:Class ;
    rdfs:label "EIP Process"@en ;
    rdfs:comment "The EIP Process is the governance workflow by which Ethereum Improvement Proposals are submitted, reviewed, and standardised. It defines proposal types (Core, Networking, Interface, ERC, Meta), status stages from Draft through Final, and the role of editors and community review in reaching rough consensus. It is the mechanism through which protocol changes and token standards such as ERC-20 are coordinated across the Ethereum ecosystem."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:smart-contract ;
    vc:slug "eip-process" ;
    vc:sourceDomain "blockchain" .

ngm:eleven-labs a owl:Class ;
    rdfs:label "ElevenLabs"@en ;
    rdfs:comment "ElevenLabs is a company that develops artificial intelligence software for speech synthesis and voice generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:generative-ai ;
    vc:enables ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:deep-learning ;
    vc:slug "eleven-labs" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:embodied-presence a owl:Class ;
    rdfs:label "Embodied Presence"@en ;
    rdfs:comment "Embodied presence is the sense of being physically located within a virtual or remote environment, often through an avatar or robotic proxy. It is studied in virtual reality and telepresence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:telepresence ;
    vc:enables ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:avatar ;
    vc:slug "embodied-presence" ;
    vc:sourceDomain "metaverse" .

ngm:emergent-behavior a owl:Class ;
    rdfs:label "Emergent Behavior"@en ;
    rdfs:comment "Emergent Behavior is complex, system-level behaviour that arises from the interactions of many simpler components or agents and is not explicitly programmed into any individual part. In AI-driven game agents and open-world simulations it produces lifelike, unscripted dynamics from local rules and agent decisions. Emergence is valued for richness and replayability but can be hard to predict, test, and control."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:open-world ;
    vc:slug "emergent-behavior" ;
    vc:sourceDomain "ai" .

ngm:emergent-capabilities a owl:Class ;
    rdfs:label "Emergent Capabilities"@en ;
    rdfs:comment "Emergent Capabilities are abilities that appear in large language models at scale but are absent or near-random in smaller models, seemingly arising abruptly as parameters, data, or compute increase. Examples include multi-step reasoning, in-context learning, and instruction following. Their unpredictability complicates capability forecasting and is central to debates about scaling and AI safety."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:frontier-models,
        ngm:model-training ;
    vc:slug "emergent-capabilities" ;
    vc:sourceDomain "ai" .

ngm:empathetic-ai a owl:Class ;
    rdfs:label "Empathetic AI"@en ;
    rdfs:comment "Empathetic AI is a subfield of Affective Computing and Human-Computer Interaction concerned with computational systems that perceive, model, and respond to human affective states — including emotions, sentiment, stress, mood, and social cues — to produce contextually appropriate, emotiona..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:facial-action-coding-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sentiment-analysis ],
        ngm:affective-computing,
        ngm:ai-application,
        ngm:cognitive-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:companion-ai,
        ngm:emotionally-aware-customer-service,
        ngm:mental-health-support,
        ngm:personalised-education,
