        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:verifiable-computation,
        ngm:zk-rollup ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:commitment-scheme,
        ngm:interactive-proof-system,
        ngm:non-interactive-proof,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:consensus-mechanism,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:public-key-cryptography ;
    vc:slug "cryptographic-proof" ;
    vc:sourceDomain "security" ;
