        ngm:lidar .

ngm:git a owl:Class ;
    rdfs:label "Git"@en ;
    rdfs:comment "Git is a distributed version control system that tracks changes to files and coordinates work across multiple contributors. It was created by Linus Torvalds for Linux kernel development."@en ;
