ngm:federated-credential-exchange a owl:Class ;
    rdfs:label "Federated Credential Exchange"@en ;
    rdfs:comment "A cross-platform workflow process that enables secure sharing and translation of identity credentials between different identity providers using standardized protocols, attribute mapping, and user consent mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federation-protocol ],
        [ a owl:Restriction ;
