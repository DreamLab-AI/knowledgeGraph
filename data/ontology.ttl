    vc:uses ngm:algorithmic-trading,
        ngm:high-frequency-trading .

ngm:forensic-investigation a owl:Class ;
    rdfs:label "Forensic Investigation"@en ;
    rdfs:comment "Forensic investigation is the systematic collection, preservation, examination, and analysis of evidence — digital, physical, or financial — using scientifically validated methods that maintain legal admissibility and chain of custody, with the purpose of reconstructing events, attributing responsibility, and supporting judicial or regulatory proceedings. In digital contexts it encompasses disk imaging, memory acquisition, network traffic analysis, and log correlation."@en ;
    rdfs:subClassOf ngm:digital-forensics ;
