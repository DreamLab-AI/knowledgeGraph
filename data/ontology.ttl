ngm:state-synchronisation a owl:Class ;
    rdfs:label "State Synchronisation"@en ;
    rdfs:comment "State synchronisation is the process of ensuring that multiple distributed nodes or replicas of a system maintain consistent views of shared mutable state despite network partitions, concurrent updates, and node failures. It encompasses techniques including leader-based replication, consensus protocols, conflict-free replicated data types (CRDTs), and operational transformation to reconcile divergent states. State synchronisation defines the trade-off between consistency, availability, and partition tolerance as described by the CAP theorem, choosing different points on that spectrum depending on application requirements. It is fundamental to distributed databases, real-time collaboration tools, multiplayer games, and blockchain networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        ngm:distributed-system-protocol ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:strong-consistency ;
    vc:enables ngm:distributed-databases,
        ngm:fault-tolerance,
        ngm:realtime-collaboration,
        ngm:replication-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:paxos,
        ngm:raft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:conflict-resolution,
        ngm:distributed-consensus,
        ngm:eventual-consistency,
        ngm:real-time-synchronization,
        ngm:state-synchronization ;
    vc:requires ngm:distributed-system,
        ngm:network-communication ;
    vc:slug "state-synchronisation" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:high-availability ;
    vc:uses ngm:consensus-protocol,
        ngm:crdt,
        ngm:data-replication,
        ngm:operational-transformation,
        ngm:state-machine-replication,
        ngm:vector-clock .

ngm:stereo-camera a owl:Class ;
    rdfs:label "Stereo Camera"@en ;
    rdfs:comment "A dual-lens imaging system that captures two horizontally offset images of a scene to compute disparity maps and recover metric 3D depth information. Stereo cameras are widely used in robotic navigation, obstacle avoidance, and spatial mapping because they provide passive depth sensing without emitting light."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-sensor ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:camera,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:lidar,
        ngm:time-of-flight-sensor ;
    vc:dependsOn ngm:disparity-map,
        ngm:epipolar-geometry ;
    vc:enables ngm:depth-estimation,
        ngm:object-detection,
        ngm:obstacle-avoidance,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:image-sensor,
        ngm:lens ;
    vc:implements ngm:stereo-vision,
        ngm:triangulation ;
    vc:isPartOf ngm:robot-perception ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:monocular-camera,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:visual-odometry ;
    vc:requires ngm:camera-calibration,
        ngm:image-synchronisation,
        ngm:stereo-rectification ;
    vc:slug "stereo-camera" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera-parameters .

ngm:store-of-value a owl:Class ;
    rdfs:label "Store of Value"@en ;
    rdfs:comment "A store of value is any asset that retains purchasing power over time, enabling the owner to defer consumption and retrieve real wealth in the future with minimal loss to inflation, confiscation, or degradation. Classical monetary theory identifies store-of-value function alongside medium-of-exchange and unit-of-account as the three primary functions of money, though assets can serve one function without the others."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scarcity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scarcity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:portability ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:asset-tokenisation,
        ngm:bitcoin-protocol,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:fiat-currency,
        ngm:medium-of-exchange,
        ngm:unit-of-account ;
    vc:dependsOn ngm:market-confidence,
        ngm:property-rights ;
    vc:enables ngm:capital-preservation,
        ngm:intertemporal-exchange,
        ngm:portfolio-hedging ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:durability,
        ngm:portability,
        ngm:scarcity ;
    vc:isPartOf ngm:functions-of-money ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:currency-debasement,
        ngm:gold-standard,
        ngm:hard-money,
        ngm:inflation-hedge,
        ngm:monetary-function,
        ngm:monetary-policy,
        ngm:purchasing-power ;
    vc:requires ngm:asset-liquidity,
        ngm:scarcity ;
    vc:slug "store-of-value" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:austrian-hard-money-theory,
        ngm:fixed-supply-monetary-policy ;
    vc:uses ngm:commodity-money,
        ngm:inflation-linked-bonds .

ngm:surgical-robot a owl:Class ;
    rdfs:label "Surgical Robot"@en ;
    rdfs:comment "A Surgical Robot is a teleoperated or semi-autonomous robotic system designed to assist surgeons in performing minimally invasive procedures with enhanced precision, dexterity, and haptic feedback. Systems such as the da Vinci platform translate the surgeon's hand movements—filtered for tremor—into sub-millimetre instrument motions within the patient's body, enabling laparoscopic, urological, and cardiac procedures through small incisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotic-arm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:robo-robot-type,
        ngm:service-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:contrastsWith ngm:autonomous-robot,
        ngm:industrial-robot ;
    vc:dependsOn ngm:human-robot-interaction ;
    vc:enables ngm:minimally-invasive-surgery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:end-effector,
        ngm:robotic-arm ;
    vc:isPartOf ngm:medical-robotics,
        ngm:robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:medical-imaging ;
    vc:requires ngm:computer-vision,
        ngm:control-system,
        ngm:real-time-computing,
        ngm:robot-kinematics,
        ngm:sensor-fusion ;
    vc:slug "surgical-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-8373 ;
    vc:uses ngm:haptic-feedback,
        ngm:motion-planning,
        ngm:stereo-vision .

ngm:tactile-sensor a owl:Class ;
    rdfs:label "Tactile Sensor"@en ;
    rdfs:comment "A sensor embedded in a robot's end-effector or body surface that measures contact forces, pressure distributions, vibrations, and slip, enabling dexterous manipulation and safe physical interaction. Tactile sensing complements proprioception and vision to provide robots with fingertip-level awareness analogous to the human sense of touch."@en ;
    rdfs:subClassOf ngm:exteroceptive-sensor,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-perception ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:haptics,
        ngm:pressure-sensor,
        ngm:proprioceptive-sensor,
        ngm:proximity-sensor ;
    vc:slug "tactile-sensor" ;
    vc:sourceDomain "robotics" .

ngm:time-of-flight-sensor a owl:Class ;
    rdfs:label "Time-of-Flight Sensor"@en ;
    rdfs:comment "A time-of-flight (ToF) sensor measures distance by emitting a light signal, typically infrared, and timing how long it takes to reflect back from a surface, yielding a per-pixel depth map. Because it directly measures travel time, it produces depth in real time without the baseline geometry needed by stereo cameras. ToF sensors are widely used for hand and gesture tracking, scene reconstruction, and mixed-reality depth sensing."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hand-tracking,
        ngm:mixed-reality ;
    vc:slug "time-of-flight-sensor" ;
    vc:sourceDomain "robotics" .

ngm:tokenised-securities a owl:Class ;
    rdfs:label "Tokenised Securities"@en ;
    rdfs:comment "Tokenised securities are regulated financial instruments such as equities, bonds, or fund units issued and transferred as blockchain tokens that carry the same legal rights as their traditional counterparts. They embed compliance logic, including transfer restrictions and investor accreditation checks, directly into smart contracts so that securities laws are enforced programmatically at the point of transaction."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:securities-regulation ;
    vc:slug "tokenised-securities" ;
    vc:sourceDomain "blockchain" .

ngm:tokeniser a owl:Class ;
    rdfs:label "Tokeniser"@en ;
    rdfs:comment "A tokeniser is a preprocessing component that segments raw text into a sequence of discrete tokens — sub-words, words, or characters — and maps each token to an integer identifier in a fixed vocabulary, forming the numerical input representation consumed by language model architectures. Modern sub-word tokenisers such as Byte Pair Encoding (BPE), WordPiece, and SentencePiece balance vocabulary coverage with sequence length efficiency, enabling models to handle arbitrary Unicode text including rare words, multilingual content, and specialised domains without out-of-vocabulary failures. The tokeniser vocabulary and its associated embedding matrix are co-trained with the model and constitute a foundational design decision that governs sequence length, memory footprint, and cross-lingual fairness. Multimodal extensions of tokenisation discretise images, audio, and video frames into token sequences analogous to text tokens, enabling unified cross-modal architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:word-piece ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sentence-piece ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byte-pair-encoding ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:computer-vision,
        ngm:speech-recognition ;
    vc:contrastsWith ngm:character-level-model,
        ngm:word-level-tokenisation ;
    vc:enables ngm:language-modeling,
        ngm:large-language-models,
        ngm:machine-translation,
        ngm:multimodal-ai-architecture-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:byte-pair-encoding,
        ngm:sentence-piece,
        ngm:word-piece ;
    vc:isPartOf ngm:natural-language-processing,
        ngm:pre-training ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:context-window,
        ngm:embedding-model,
        ngm:tokeniser-fertility ;
    vc:requires ngm:text-preprocessing,
        ngm:unicode-normalisation,
        ngm:vocabulary ;
    vc:slug "tokeniser" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:code-generation,
        ngm:multilingual-models,
        ngm:transformer-architecture ;
    vc:uses ngm:subword-tokenisation,
        ngm:token-embedding .

ngm:transmission-control-protocol a owl:Class ;
    rdfs:label "Transmission Control Protocol"@en ;
    rdfs:comment "The Transmission Control Protocol (TCP) is a connection-oriented transport-layer protocol that provides reliable, ordered, and error-checked delivery of byte streams between applications over an IP network. It establishes connections through a handshake and uses acknowledgements, retransmission, and flow and congestion control to ensure data arrives intact. TCP is the dominant reliable transport underlying most internet applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-protocol ],
        ngm:transport-layer ;
    vc:bridgesTo ngm:osi-model ;
    vc:contrastsWith ngm:network-protocol ;
    vc:dependsOn ngm:internet-protocol ;
    vc:enables ngm:http ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:reliable-data-transfer ;
    vc:isPartOf ngm:transport-layer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-protocol,
        ngm:packet-switching ;
    vc:requires ngm:internet-protocol ;
    vc:slug "transmission-control-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:application-layer ;
    vc:uses ngm:congestion-control,
        ngm:flow-control .

ngm:true-positive a owl:Class ;
    rdfs:label "True Positive"@en ;
    rdfs:comment "A True Positive is an outcome in binary classification where the model correctly predicts the positive class for an instance that genuinely belongs to that class. It is one of the four cells of the confusion matrix, alongside false positives, true negatives and false negatives. Counts of true positives are central to evaluation metrics such as precision, recall and the F1 score."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        ngm:confusion-matrix ;
    vc:bridgesTo ngm:model-evaluation ;
    vc:contrastsWith ngm:false-negative,
        ngm:false-positive,
        ngm:true-negative ;
    vc:enables ngm:f1-score,
        ngm:precision,
        ngm:recall ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:confusion-matrix ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accuracy,
        ngm:roc-curve,
        ngm:specificity ;
    vc:requires ngm:classification ;
    vc:slug "true-positive" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-evaluation,
        ngm:sensitivity ;
    vc:uses ngm:classifier .

ngm:trust-establishment a owl:Class ;
    rdfs:label "Trust Establishment"@en ;
    rdfs:comment "Trust Establishment is the process by which parties in a digital or physical system form justified confidence in each other's identities, capabilities, intentions, and assertions prior to exchanging sensitive information or delegating authority. It encompasses cryptographic mechanisms such as certificate chain validation, attestation, and verifiable credential presentation, as well as organisational mechanisms including trust frameworks, legal agreements, and reputation systems. In decentralised and multi-stakeholder environments, trust establishment must operate without relying on a single trusted authority, requiring distributed protocols such as web-of-trust models, blockchain-anchored attestations, and federated identity systems. Trust establishment is a foundational prerequisite for secure communication, authorisation, and coordination across organisational and jurisdictional boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:trust-architecture ;
    vc:bridgesTo ngm:ai-governance,
        ngm:federated-identity ;
    vc:contrastsWith ngm:perimeter-security ;
    vc:dependsOn ngm:certificate-authority,
        ngm:reputation-system ;
    vc:enables ngm:authentication,
        ngm:authorisation,
        ngm:secure-communication,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:web-of-trust,
        ngm:zero-trust-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attestation,
        ngm:certificate-transparency ;
    vc:requires ngm:cryptographic-verification,
        ngm:identity-verification,
        ngm:public-key-infrastructure ;
    vc:slug "trust-establishment" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:e-idas-2-0,
        ngm:trust-framework ;
    vc:uses ngm:decentralised-identifier,
        ngm:digital-signature-verification,
        ngm:humanity-attestation,
        ngm:verifiable-credential-vc .

ngm:trusted-platform-module a owl:Class ;
    rdfs:label "Trusted Platform Module"@en ;
    rdfs:comment "A Trusted Platform Module (TPM) is a dedicated, tamper-resistant hardware component that provides cryptographic functions and secure storage of keys and platform measurements. It generates and protects keys that never leave the chip in plaintext, records integrity measurements in platform configuration registers, and supports operations such as secure boot and remote attestation. Defined by an open Trusted Computing Group specification, the TPM acts as a hardware root of trust on personal computers, servers and embedded devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-volatile-memory ],
        ngm:hardware-security-module ;
    vc:bridgesTo ngm:confidential-computing,
        ngm:key-management ;
    vc:contrastsWith ngm:trusted-execution-environment ;
    vc:enables ngm:remote-attestation,
        ngm:secure-boot ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cryptographic-key,
        ngm:non-volatile-memory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fido-alliance,
        ngm:hardware-security-module,
        ngm:secure-enclave ;
    vc:requires ngm:tamper-resistance ;
    vc:slug "trusted-platform-module" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication,
        ngm:root-of-trust ;
    vc:uses ngm:digital-signature,
        ngm:public-key-cryptography .

ngm:user-generated-content a owl:Class ;
    rdfs:label "User-Generated Content"@en ;
    rdfs:comment "User-generated content (UGC) is media and information created and published by the users of a platform rather than by its operators or professional producers. It encompasses text, images, video, 3D assets, reviews, and virtual-world artefacts contributed by a community. UGC drives engagement and network effects on social and metaverse platforms while creating moderation, rights, and quality-control obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-content ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        ngm:digital-content ;
    vc:contrastsWith ngm:content-creation ;
    vc:dependsOn ngm:community,
        ngm:content-creation ;
    vc:enables ngm:metaverse,
        ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:digital-content ;
    vc:isPartOf ngm:platform-economy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-content,
        ngm:platform-economy,
        ngm:spatial-computing ;
    vc:requires ngm:content-moderation ;
    vc:slug "user-generated-content" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:user-experience .

ngm:user-safety a owl:Class ;
    rdfs:label "User Safety"@en ;
    rdfs:comment "User Safety encompasses the technical, design, policy, and governance measures deployed by platforms and application developers to protect users from harm across digital and immersive environments, including harassment, predatory behaviour, unwanted exposure to harmful content, physical discomfort from extended use, and violations of privacy or consent. In spatially embodied contexts such as extended reality and the metaverse, abusive interactions carry heightened psychological impact because spatial audio, avatar proximity, and embodied presence amplify the subjective experience of harm beyond that typical of text-based social media. Effective user safety frameworks integrate proactive content moderation, privacy-preserving reporting, age-appropriate design, graduated enforcement mechanisms, and platform governance structures accountable to regulators and communities alike. The discipline draws on human factors research, risk management, digital rights law, and AI-driven trust-and-safety tooling to balance protection against harm with preservation of free expression and user autonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:age-verification ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:censorship,
        ngm:surveillance-capitalism ;
    vc:dependsOn ngm:access-control,
        ngm:identity-verification,
        ngm:reputation-system ;
    vc:enables ngm:inclusive-design,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:child-online-protection,
        ngm:digital-rights,
        ngm:human-factors,
        ngm:risk-management ;
    vc:requires ngm:age-verification,
        ngm:consent-management,
        ngm:content-moderation,
        ngm:privacy ;
    vc:slug "user-safety" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:governance-framework,
        ngm:metaverse-safety-protocol,
        ngm:platform-accountability ;
    vc:uses ngm:privacy-preserving-computation,
        ngm:zero-knowledge-proof .

ngm:utility-theory a owl:Class ;
    rdfs:label "Utility Theory"@en ;
    rdfs:comment "Utility Theory is the formal framework for representing an agent's preferences over outcomes as a numerical utility function, such that the agent's rational behaviour can be modelled as the maximisation of expected utility. It provides the axiomatic foundation — completeness, transitivity, continuity, and independence — under which preferences admit a utility representation. In artificial intelligence it grounds rational-agent design, decision-making under uncertainty, and the objective functions of planning and reinforcement-learning systems. It is closely tied to decision theory, game theory, and economic models of choice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decision-theory ],
        ngm:decision-theory ;
    vc:bridgesTo ngm:social-choice-theory,
        ngm:welfare-economics ;
    vc:contrastsWith ngm:behavioural-economics ;
    vc:enables ngm:decision-making,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:decision-theory,
        ngm:probability-theory ;
    vc:isPartOf ngm:decision-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:microeconomics ;
    vc:requires ngm:probability-theory,
        ngm:rational-agent ;
    vc:slug "utility-theory" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:game-theory,
        ngm:multi-agent-system ;
    vc:uses ngm:bayesian-inference,
        ngm:markov-decision-process .

ngm:vector-clock a owl:Class ;
    rdfs:label "Vector Clock"@en ;
    rdfs:comment "A vector clock is a data structure used in distributed systems to capture causal relationships between events across multiple nodes without relying on synchronised physical time. Each node maintains a counter for every other node in the system, incrementing its own counter on each local event and merging received counters on communication. By comparing vector timestamps, systems can determine whether events are causally related, concurrent, or ordered, which is fundamental for conflict detection and resolution in collaborative editing."@en ;
    rdfs:subClassOf ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:crdt,
        ngm:operational-transformation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:real-time-synchronisation ;
    vc:slug "vector-clock" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:venture-capital a owl:Class ;
    rdfs:label "Venture Capital"@en ;
    rdfs:comment "Venture capital is a form of private financing in which investors provide funding to early-stage, high-growth companies in exchange for equity or, in crypto markets, for token allocations. It accepts elevated risk in pursuit of outsized returns, typically deploying capital in staged rounds with active governance and mentorship. In the blockchain sector, venture capital frequently coexists with and contrasts against token-sale mechanisms as a route to capitalising protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:finance ;
    vc:bridgesTo ngm:finance ;
    vc:contrastsWith ngm:ico,
        ngm:initial-coin-offering ;
    vc:dependsOn ngm:liquidity ;
    vc:enables ngm:blockchain,
        ngm:decentralized-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:risk-management ;
    vc:isPartOf ngm:finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:token-distribution,
        ngm:web3 ;
    vc:requires ngm:risk-management ;
    vc:slug "venture-capital" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:token .

ngm:virtual-event a owl:Class ;
    rdfs:label "Virtual Event"@en ;
    rdfs:comment "A Virtual Event is a digitally mediated gathering in which geographically distributed participants convene within a shared virtual environment — rendered through web browsers, desktop clients, or immersive XR headsets — to engage in social, educational, commercial, or cultural activities in real or near-real time. The class encompasses a spectrum from simple webinar-style presentations and live-streamed concerts, through avatar-populated social spaces, to fully embodied multi-user XR experiences featuring spatial audio, persistent virtual objects, and interactive exhibits. Virtual Events differ from asynchronous digital content by requiring simultaneous presence and bidirectional communication channels, and they differ from purely textual virtual spaces by incorporating rich media and, optionally, three-dimensional spatial representation. Their design draws on principles from event management, human-computer interaction, streaming media infrastructure, and spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:live-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:breakout-room ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:digital-economy,
        ngm:metaverse,
        ngm:non-fungible-token ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:identity-management,
        ngm:web-rtc ;
    vc:enables ngm:remote-collaboration,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:breakout-room,
        ngm:live-streaming,
        ngm:spatial-audio ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:immersive-experience,
        ngm:presence,
        ngm:virtual-event-platform ;
    vc:requires ngm:avatar,
        ngm:content-delivery-network,
        ngm:real-time-communication ;
    vc:slug "virtual-event" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:digital-twin ;
    vc:uses ngm:augmented-reality,
        ngm:video-conferencing,
        ngm:virtual-reality .

