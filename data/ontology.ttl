ngm:multibase a owl:Class ;
    rdfs:comment "Multibase is a self-describing encoding format specification that prefixes a binary value with a single character identifying which base encoding, such as base58btc, base32 or base64url, was used, so the encoded string can be decoded without external context. It is part of the Multiformats family of self-describing protocol specifications. It is used wherever content identifiers or decentralised-identifier material must be represented as text unambiguously across systems, such as Content Identifiers."@en ;
    rdfs:label "Multibase"@en ;
    rdfs:subClassOf ngm:multiformats ;
    vc:hasMaturity ngmi:maturity-draft ;
