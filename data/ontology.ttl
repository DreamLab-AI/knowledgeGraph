        ngm:machine-learning-discipline-model,
        ngm:neural-network,
        ngm:user-profiling .

ngm:process-automation a owl:Class ;
    rdfs:label "Process Automation"@en ;
    rdfs:comment "Process automation is the use of technology to perform repetitive business, operational, or industrial tasks with minimal human intervention, replacing manual steps in workflows with software execution, robotic systems, or rule-based logic engines. It spans a spectrum from simple macro-based automation of individual tasks through robotic process automation (RPA) that mimics user interface interactions, to intelligent automation that integrates machine learning models for decision-making in unstructured data contexts. The goal is to increase throughput, reduce errors, lower labour costs, and free human workers for higher-value activities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:workflow-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:business-process-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intelligent-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-driven-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotic-process-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-integration ],
        ngm:workflow-automation ;
    vc:bridgesTo ngm:agentic-workflow,
        ngm:autonomous-agent ;
    vc:dependsOn ngm:business-rules-engine,
        ngm:low-code-platform,
        ngm:process-mining ;
    vc:enables ngm:customer-service-automation,
        ngm:digital-transformation,
        ngm:hyperautomation,
        ngm:industrial-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:business-process-management,
        ngm:intelligent-automation,
        ngm:robotic-process-automation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:enterprise-resource-planning,
        ngm:manufacturing-automation,
        ngm:trade-finance-automation ;
    vc:requires ngm:api-integration,
        ngm:event-driven-architecture,
        ngm:workflow-engine ;
    vc:slug "process-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:audit-trail,
        ngm:regulatory-compliance,
        ngm:supply-chain-management ;
    vc:uses ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:software-development-process .

ngm:python-runtime a owl:Class ;
    rdfs:label "Python Runtime"@en ;
    rdfs:comment "The Python runtime is the interpreter process and associated standard library environment responsible for compiling Python source to bytecode, executing that bytecode in a virtual machine, managing heap memory through reference-counting combined with a cyclic garbage collector, and resolving module imports via the package search path. CPython—the canonical C-language reference implementation—uses a Global Interpreter Lock (GIL) that serialises bytecode execution across threads, making multi-processing the preferred concurrency model for CPU-bound workloads. The Python runtime underpins the dominant AI/ML toolchain including PyTorch, TensorFlow, and the Hugging Face ecosystem, making its performance characteristics, extension mechanisms, and packaging conventions central concerns for AI infrastructure engineering."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:runtime-environment ;
    vc:slug "python-runtime" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
        ngm:model-training ;
    vc:uses ngm:machine-learning-discipline-framework,
        ngm:python .

ngm:rb-0047-feedback-control a owl:Class ;
    rdfs:label "rb 0047 feedback control"@en ;
    rdfs:comment "A closed-loop control strategy in which sensor measurements of a system's output are continuously compared to a reference setpoint, and the resulting error signal drives corrective actuator commands. Feedback control is the foundational mechanism for stable, accurate robotic motion, enabling autonomous robots and telerobotic systems to compensate for disturbances, model uncertainty, and environmental variation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:closed-loop-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:adaptive-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robotics-control,
        ngm:teleoperation ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "rb-0047-feedback-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:pid-control,
        ngm:robot-sensor .

ngm:rb-0051-trajectory-planning a owl:Class ;
    rdfs:label "rb 0051 trajectory planning"@en ;
    rdfs:comment "Trajectory planning is the process of computing a time-parametrised path — specifying position, velocity, and acceleration profiles — that moves a robot from a start configuration to a goal while satisfying kinematic and dynamic constraints, joint limits, and task requirements. It extends path planning by assigning timing to waypoints, enabling smooth, jerk-limited motions suitable for real-time execution by a robot controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0022-robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0049-motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0044-velocity,
        ngm:rb-0045-acceleration,
        ngm:rb-0052-collision-avoidance ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics,
        ngm:rb-0049-motion-planning ;
    vc:slug "rb-0051-trajectory-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:optimal-control,
        ngm:rb-0048-pid-controller .

ngm:rb-0105-speed-and-separation-monitoring a owl:Class ;
    rdfs:label "rb 0105 speed and separation monitoring"@en ;
    rdfs:comment "Speed and Separation Monitoring (SSM) is a collaborative robot safety function in which the speed of the robot is continuously regulated based on the measured distance between the robot and any human operator in the shared workspace. When the separation distance decreases below defined thresholds the robot slows or stops, and it resumes normal speed once sufficient separation is restored. SSM is standardised under ISO/TS 15066 as one of the four permitted collaborative operation modes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0095-safety-zone ],
        ngm:light-curtain,
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:rb-0069-lidar,
        ngm:rb-0093-speed-limitation ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0089-risk-assessment,
        ngm:rb-0092-protective-stop,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0066-robot-sensor,
        ngm:rb-0095-safety-zone ;
    vc:slug "rb-0105-speed-and-separation-monitoring" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .

ngm:re-act a owl:Class ;
    rdfs:label "ReAct"@en ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting paradigm for large language models that interleaves free-form reasoning traces (Thought steps) with structured external action calls in a single output sequence, enabling models to dynamically plan multi-step tasks, observe the results of tool invocations, and revise their reasoning accordingly. The framework produces an alternating Thought–Action–Observation loop that grounds model inference in real-world feedback, contrasting with pure chain-of-thought prompting (reasoning without action) and pure action-only agents (action without transparent reasoning). Originally demonstrated by Yao et al. (2022) on knowledge-intensive QA and interactive decision benchmarks, ReAct has become the foundational interaction primitive underpinning modern agentic AI systems, tool-augmented LLMs, and multi-agent orchestration frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:act-only-agent,
        ngm:chain-of-thought,
        ngm:reflexion,
        ngm:tree-of-thoughts ;
    vc:dependsOn ngm:external-knowledge-retrieval,
        ngm:function-calling ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-agent,
        ngm:human-in-the-loop,
        ngm:interpretable-ai,
        ngm:tool-augmented-language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:agent-loop,
        ngm:grounded-reasoning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:multi-agent-system,
        ngm:planning-and-scheduling,
        ngm:prompting-technique,
        ngm:reasoning,
        ngm:reinforcement-learning ;
    vc:requires ngm:chain-of-thought,
        ngm:large-language-model,
        ngm:prompt-engineering,
        ngm:tool-use ;
    vc:slug "re-act" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:in-context-learning,
        ngm:retrieval-augmented-generation,
        ngm:scratchpad-reasoning .

ngm:real-time-transcription a owl:Class ;
    rdfs:label "Real-time Transcription"@en ;
    rdfs:comment "Real-time transcription is the automated conversion of streaming audio to text with latency sufficiently low (typically below 500 ms word latency) to support synchronous human use cases such as live captioning, voice-controlled interfaces, meeting assistance, and broadcast subtitling. It requires streaming automatic speech recognition (ASR) architectures that produce partial and final hypotheses incrementally as audio frames arrive, rather than processing complete utterances offline. Modern systems combine acoustic models (typically based on conformer or whisper-encoder architectures), language models for hypothesis rescoring, and punctuation/formatting post-processors to produce readable output in real time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-speech-recognition ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:accessibility,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:requires ngm:automatic-speech-recognition,
        ngm:real-time-processing ;
    vc:slug "real-time-transcription" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:reasoning-engine a owl:Class ;
    rdfs:label "Reasoning Engine"@en ;
    rdfs:comment "A reasoning engine is a software component that derives new conclusions from a body of knowledge by applying logical inference rules, probabilistic methods, or learned heuristics. Classical reasoning engines operate over symbolic knowledge bases using forward or backward chaining, description-logic subsumption, or constraint solving, while modern neuro-symbolic and LLM-based engines combine learned language representations with structured tool use and search. Reasoning engines power expert systems, semantic-web query answering, automated planning, and multi-step problem solving in agentic AI systems."@en ;
    rdfs:subClassOf ngm:reasoning ;
    vc:enables ngm:chain-of-thought,
        ngm:multi-step-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:llm-agents,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "reasoning-engine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:knowledge-graph .

ngm:recommendation-engine a owl:Class ;
    rdfs:label "Recommendation Engine"@en ;
    rdfs:comment "A recommendation engine is a system that filters, ranks, and surfaces content or items most relevant to an individual user by analysing preferences, behaviour history, and contextual signals. It employs collaborative filtering, content-based filtering, or hybrid deep-learning approaches to personalise discovery at scale across e-commerce, media, and metaverse platforms."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:data-pipeline,
        ngm:deep-learning ;
    vc:enables ngm:information-retrieval,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:search-technology ;
    vc:slug "recommendation-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedding-model,
        ngm:machine-learning-discipline .

ngm:reed-solomon-codes a owl:Class ;
    rdfs:label "Reed-Solomon Codes"@en ;
    rdfs:comment "Reed-Solomon codes are a class of non-binary, cyclic, block error-correcting codes defined over finite fields (Galois fields), capable of correcting both erasures and symbol errors with provably optimal efficiency at the Singleton bound. Introduced by Irving Reed and Gustave Solomon in 1960, they treat data blocks as polynomials over a finite field and encode them by evaluating the polynomial at multiple distinct points, allowing the original polynomial to be reconstructed from any sufficient subset of evaluation points. Reed-Solomon codes underpin data reliability in storage media (CDs, DVDs, RAID), satellite communications, QR codes, and are foundational to erasure-coded distributed storage and modern polynomial commitment schemes used in zero-knowledge proofs."@en ;
    rdfs:subClassOf ngm:error-correction ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:enables ngm:data-availability-sampling,
        ngm:data-integrity,
        ngm:fault-tolerance,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:coding-theory,
        ngm:data-availability,
        ngm:distributed-storage,
        ngm:erasure-coding,
        ngm:finite-field-arithmetic ;
    vc:requires ngm:polynomial-interpolation ;
    vc:slug "reed-solomon-codes" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:blockchain,
        ngm:cryptographic-proof,
        ngm:polynomial-commitment,
        ngm:stark .

ngm:reference-implementation a owl:Class ;
    rdfs:label "Reference Implementation"@en ;
    rdfs:comment "A reference implementation is an authoritative, openly available realisation of a specification or standard that demonstrates how it is meant to be built and used. It serves as a concrete benchmark against which other implementations can be compared for correctness and conformance. By turning a written specification into working software, it reduces ambiguity and accelerates adoption of the standard."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api ],
        ngm:open-standards ;
    vc:bridgesTo ngm:interoperability ;
    vc:contrastsWith ngm:reference-architecture ;
    vc:enables ngm:interoperability,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api ;
    vc:implements ngm:interoperability-standard,
        ngm:open-standards ;
    vc:isPartOf ngm:interoperability-standard,
        ngm:open-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:governance ;
    vc:requires ngm:interoperability-standard ;
    vc:slug "reference-implementation" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:interoperability,
        ngm:open-standards ;
    vc:uses ngm:reference-architecture .

ngm:regular-expression a owl:Class ;
    rdfs:label "Regular Expression"@en ;
    rdfs:comment "A regular expression is a formal notation for describing sets of strings using a concise pattern language built from literals, character classes, quantifiers, and grouping. Regular expressions describe exactly the class of regular languages and are typically implemented by compiling the pattern into a finite-state machine for efficient matching. They are a foundational tool for searching, validating, and transforming text."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:finite-state-machine ],
        ngm:formal-language ;
    vc:contrastsWith ngm:compiler ;
    vc:dependsOn ngm:automata-theory ;
    vc:enables ngm:compiler,
        ngm:data-validation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:formal-language ;
    vc:isPartOf ngm:formal-language ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithm,
        ngm:data-validation,
        ngm:finite-state-machine,
        ngm:programming-language ;
    vc:requires ngm:finite-state-machine ;
    vc:slug "regular-expression" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:posix ;
    vc:supports ngm:compiler,
        ngm:natural-language-processing ;
    vc:uses ngm:automata-theory,
        ngm:finite-state-machine .

ngm:relation-extraction a owl:Class ;
    rdfs:label "Relation Extraction"@en ;
    rdfs:comment "Relation extraction is the natural-language-processing task of identifying semantic relationships between entities mentioned in text and classifying them into predefined or open relation types. It typically operates on the output of named-entity recognition, determining whether and how two entities are connected, for example employer-of, located-in or part-of. Relation extraction is foundational to knowledge-graph construction, supplying the typed edges that link extracted entities into structured assertions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
