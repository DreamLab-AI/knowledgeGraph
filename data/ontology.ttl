    vc:slug "consensus" ;
    vc:sourceDomain "distributed-systems" .

ngm:content-authenticity a owl:Class ;
    rdfs:label "Content Authenticity"@en ;
    rdfs:comment "Content authenticity is the property of a digital asset whereby its origin, creation history, and any subsequent modifications can be cryptographically verified and traced back to an identifiable source. It encompasses technical mechanisms — including cryptographic signatures, tamper-evident manifests, and provenance metadata — that allow consumers of media to assess whether content has been created or manipulated by humans or AI systems and whether it has been altered since its stated point of capture or creation. Content authenticity is increasingly codified through standards such as C2PA (Coalition for Content Provenance and Authenticity)."@en ;
    rdfs:subClassOf ngm:content-authentication ;
    vc:contrastsWith ngm:deepfakes-and-fraudulent-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:deepfakes,
        ngm:digital-signature,
        ngm:metadata-standard ;
    vc:slug "content-authenticity" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:c2-pa,
        ngm:cryptographic-signature,
        ngm:provenance-tracking .

ngm:context-aware-computing a owl:Class ;
    rdfs:label "Context Aware Computing"@en ;
    rdfs:comment "Context Aware Computing is a paradigm in which systems automatically adapt their behaviour based on contextual signals such as the user's location, activity, device state, social environment, and temporal cues. In spatial computing and XR applications, context awareness allows virtual overlays and services to respond intelligently to physical surroundings, enabling location-sensitive AR, adaptive user interfaces, and personalised immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:computer-vision,
        ngm:scene-understanding ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:internet-of-things,
        ngm:sensor-fusion ;
    vc:slug "context-aware-computing" ;
    vc:sourceDomain "spatial-computing" .

ngm:continuous-deployment a skos:Concept ;
    rdfs:label "Continuous Deployment"@en .

ngm:continuous-improvement a owl:Class ;
    rdfs:label "continuous improvement"@en ;
    rdfs:comment "Continuous improvement is an iterative organisational and engineering philosophy in which processes, products, and systems are systematically and incrementally refined over time through structured cycles of measurement, analysis, experimentation, and implementation, rather than through large-scale periodic overhauls. Rooted in Japanese manufacturing philosophy (kaizen), it was formalised in quality management frameworks including the Plan-Do-Check-Act cycle, ISO 9001, and Lean methodologies, and has since been adopted throughout software engineering via DevOps, agile retrospectives, and MLOps pipelines. The practice relies on feedback loops that surface inefficiencies, defects, or opportunities close to their point of origin, enabling rapid corrective action and cumulative quality gains."@en ;
    rdfs:subClassOf ngm:software-development-process ;
    vc:enables ngm:mlops,
        ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:monitoring-system,
        ngm:performance-metrics,
        ngm:quality-assurance ;
    vc:slug "continuous-improvement" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-deployment ;
    vc:uses ngm:real-time-monitoring .

ngm:control-law a owl:Class ;
    rdfs:label "Control Law"@en ;
    rdfs:comment "A control law is the mathematical rule that maps measured system state and reference signals to the control inputs applied to a plant. It is the algorithmic core of a feedback controller, expressed as functions such as PID, state feedback, or impedance laws. The choice of control law determines stability, tracking accuracy, and disturbance rejection of the closed-loop system."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:position-control ;
    vc:slug "control-law" ;
    vc:sourceDomain "robotics" .

ngm:controlnet a skos:Concept ;
    rdfs:label "Controlnet"@en .

ngm:convex-optimisation a owl:Class ;
    rdfs:label "Convex Optimisation"@en ;
    rdfs:comment "Convex optimisation is the mathematical discipline concerned with minimising convex objective functions over convex feasible sets, exploiting the fundamental property that every local minimum is also a global minimum. This structural guarantee enables the design of polynomial-time algorithms — such as interior-point methods, subgradient descent, and proximal methods — that reliably find exact or near-exact solutions. The field is grounded in convex analysis and duality theory (Lagrangian and Fenchel duality), and underpins a vast range of applications spanning machine learning, signal processing, control systems, finance, and operations research. Canonical problem classes include linear programming, quadratic programming, second-order cone programming, and semidefinite programming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-programming ],
        ngm:optimisation ;
    vc:bridgesTo ngm:deep-learning,
        ngm:reinforcement-learning,
        ngm:signal-processing ;
    vc:contrastsWith ngm:combinatorial-optimisation,
        ngm:non-convex-optimisation ;
    vc:dependsOn ngm:duality-theory,
        ngm:numerical-methods ;
    vc:enables ngm:compressed-sensing,
        ngm:lasso-regression,
        ngm:optimal-control,
        ngm:portfolio-optimisation,
        ngm:support-vector-machine ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:linear-programming,
        ngm:quadratic-programming,
        ngm:second-order-cone-programming,
        ngm:semidefinite-programming ;
    vc:implements ngm:gradient-descent,
        ngm:interior-point-method,
        ngm:proximal-gradient-method ;
    vc:isPartOf ngm:mathematical-optimisation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:functional-analysis,
        ngm:operations-research,
        ngm:stochastic-optimisation ;
    vc:requires ngm:calculus,
        ngm:convex-analysis,
        ngm:linear-algebra ;
    vc:slug "convex-optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:kkt-conditions,
        ngm:lagrange-multipliers .

ngm:coreference-resolution a skos:Concept ;
    rdfs:label "Coreference Resolution"@en .

ngm:cqrs a owl:Class ;
    rdfs:label "CQRS"@en ;
    rdfs:comment "Command Query Responsibility Segregation (CQRS) is a software architecture pattern that separates the model used to update state (commands) from the model used to read state (queries). By using distinct write and read paths, systems can independently optimise, scale, and secure each side, often pairing the write model with event sourcing. It is commonly applied in high-throughput, complex-domain systems where read and write workloads diverge."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:data-layer ;
    vc:slug "cqrs" ;
    vc:sourceDomain "infrastructure" .

ngm:crash-fault-tolerance a skos:Concept ;
    rdfs:label "Crash Fault Tolerance"@en .

ngm:creative-commons a owl:Class ;
    rdfs:label "Creative Commons"@en ;
    rdfs:comment "Creative Commons is a family of standardised public copyright licences that let creators grant defined reuse, attribution, and sharing permissions to the public. The licences (e.g. CC BY, CC BY-SA, CC0) provide machine-readable and human-readable terms that promote legal reuse of content. They are widely used to license training data, open educational resources, and open media corpora."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:training-data ;
    vc:slug "creative-commons" ;
    vc:sourceDomain "infrastructure" .

ngm:creator-monetization a owl:Class ;
    rdfs:label "Creator Monetization"@en ;
    rdfs:comment "Creator Monetization refers to the suite of mechanisms, platforms, and economic models through which independent content creators convert their creative output and audience relationships into sustainable revenue streams. These mechanisms span advertising revenue sharing, subscription and membership tiers, merchandise and physical goods, live events, licensing, and on-chain token-based models including NFTs and creator coins. The field has been shaped by the shift from broadcast media to participatory digital platforms, enabling individuals rather than corporations to capture value from cultural production. Web3 infrastructure is expanding the design space by enabling programmable royalties and direct fan-ownership of creative works."@en ;
    rdfs:subClassOf ngm:creator-economy ;
    vc:enables ngm:digital-marketplace,
        ngm:multi-party-royalties,
        ngm:non-fungible-token-nft ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:nft-marketplace,
        ngm:platform-economy ;
    vc:slug "creator-monetization" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:creator-royalty-token,
        ngm:royalty-distribution,
        ngm:smart-royalty-contract .

ngm:creator-royalties a owl:Class ;
    rdfs:label "Creator Royalties"@en ;
    rdfs:comment "Creator royalties are automatic, programmable payments directed to the original creator of a digital asset — typically an NFT — each time that asset is resold on a secondary market. Encoded in smart contract logic or enforced through marketplace policy, royalties provide creators with a fraction of every subsequent transaction price, extending their economic participation beyond the initial sale. The mechanism is foundational to sustainable creator economies on blockchain platforms, though enforcement remains contested between on-chain protocol enforcement and off-chain marketplace compliance. Debate centres on whether royalty obligations can be made non-bypassable at the token-transfer level or rely on voluntary marketplace co-operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nft ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:digital-rights-management ;
    vc:bridgesTo ngm:creator-monetisation,
        ngm:digital-ownership ;
    vc:contrastsWith ngm:traditional-copyright,
        ngm:zero-royalty-marketplace ;
    vc:dependsOn ngm:nft-marketplace,
        ngm:on-chain-governance,
        ngm:token-transfer ;
    vc:enables ngm:creator-economy,
        ngm:decentralised-marketplace,
        ngm:programmable-revenue ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:intellectual-property,
        ngm:royalty-splitting,
        ngm:secondary-market ;
    vc:requires ngm:blockchain,
        ngm:nft,
        ngm:smart-contract ;
    vc:slug "creator-royalties" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:eip-2981,
        ngm:operator-filter-registry,
        ngm:token-standard .

ngm:cross-border-data-transfer a owl:Class ;
    rdfs:label "Cross-Border Data Transfer"@en ;
    rdfs:comment "Cross-border data transfer is the movement of personal or regulated data across national jurisdictions, governed by data-protection laws that restrict where and how such data may be processed. Compliance mechanisms include adequacy decisions, standard contractual clauses, binding corporate rules, and localisation requirements. It is a central concern of privacy regimes such as GDPR and various Asia-Pacific frameworks."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asia-pacific-regulation ;
    vc:slug "cross-border-data-transfer" ;
    vc:sourceDomain "governance" .

ngm:cross-chain-communication a owl:Class ;
    rdfs:label "Cross-Chain Communication"@en ;
    rdfs:comment "Cross-chain communication is the exchange of messages, data, and asset-transfer instructions between distinct blockchain networks that do not natively share state. It is implemented through protocols, relays, and light-client verification that let one chain trust and act on events from another. It is the foundation of blockchain interoperability and multi-chain applications."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cosmos-ibc ;
    vc:slug "cross-chain-communication" ;
    vc:sourceDomain "blockchain" .

ngm:cross-encoder-reranking a owl:Class ;
    rdfs:label "Cross-Encoder Reranking"@en ;
    rdfs:comment "Cross-Encoder Reranking is a two-stage information retrieval technique in which a cross-encoder transformer model receives a query and a candidate document concatenated as a single input sequence, performs full bidirectional self-attention across both, and outputs a relevance score used to re-order an initial candidate set retrieved by a faster but less accurate first-stage retriever. It typically yields substantially higher ranking quality than bi-encoder first-stage retrieval at the cost of higher computational latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-search ],
        ngm:information-retrieval ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cosine-similarity ;
    vc:requires ngm:semantic-search ;
    vc:slug "cross-encoder-reranking" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:rag-pipeline ;
    vc:uses ngm:embedding-model .

ngm:cross-metaverse-commerce a owl:Class ;
    rdfs:label "Cross Metaverse Commerce"@en ;
    rdfs:comment "Economic activities and transactions that span multiple metaverse platforms and virtual worlds, enabled by interoperability standards, blockchain-based digital assets, and unified digital identity systems that allow users to buy, sell, trade, and transfer value seamlessly across different virtual..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
