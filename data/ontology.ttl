ngm:digital-humans a owl:Class ;
    rdfs:label "Digital Humans"@en ;
    rdfs:comment "Digital humans are photorealistic, AI-driven virtual beings that replicate human appearance, movement, voice, and conversational behaviour, rendered in 3D and designed for real-time interaction within immersive and spatial computing environments. They integrate natural language processing, motion capture, generative AI, and real-time rendering to simulate lifelike presence, serving roles in customer service, education, healthcare, and entertainment. As an emerging category they represent the convergence of embodied AI with avatar systems and synthetic media."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-animation,
        ngm:avatar-system ;
    vc:isPartOf ngm:immersive-technology,
        ngm:spatial-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-avatar,
        ngm:embodied-ai,
        ngm:synthetic-media ;
    vc:slug "digital-humans" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:conversational-ai,
        ngm:motion-capture,
        ngm:natural-language-processing,
        ngm:real-time-rendering,
        ngm:text-to-speech .

ngm:digital-identity-standards a owl:Class ;
    rdfs:label "Digital Identity Standards"@en ;
    rdfs:comment "The technical specifications, protocols, and frameworks established by standards bodies such as W3C and ISO that define interoperable formats for digital identifiers, verifiable credentials, and authentication mechanisms enabling secure identity management across metaverse platforms and decentral..."@en ;
