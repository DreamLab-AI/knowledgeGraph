ngm:broadcasting a owl:Class ;
    rdfs:comment "The one-to-many distribution of a signal or message from a single source to all receivers within reach, in contrast to unicast (one-to-one) and multicast (one-to-selected-group) delivery. In telecommunications it denotes terrestrial and satellite radio and television transmission over allocated spectrum, and by extension the broadcast primitives of computer networks, where a frame or packet is addressed to every node on a segment. The same word names a distinct but analogous mechanism in array computing, where NumPy-style broadcasting stretches arrays of differing shapes to a common shape so that element-wise operations apply one value across many without copying data."@en ;
    rdfs:label "Broadcasting"@en ;
    rdfs:subClassOf ngm:telecommunications ;
    vc:dependsOn ngm:spectrum-allocation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:numpy ;
    vc:relatedTo ngm:satellite-communication ;
    vc:slug "broadcasting" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:wireless-communication .
