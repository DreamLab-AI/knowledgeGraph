    vc:enables ngm:open-world-streaming,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:continuous-lod,
        ngm:discrete-lod,
        ngm:hierarchical-lod,
        ngm:mipmapping ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
