ngm:iso-20022 a owl:Class ;
    rdfs:label "ISO 20022"@en ;
    rdfs:comment "ISO 20022 is the international standard for financial messaging that provides a common platform for the development of messages in the financial services industry, using a methodology that decouples business concepts from syntax through a central repository of business components, message definitions, and XML/ASN.1/JSON encoding rules. Published by the International Organisation for Standardisation, the standard covers payments (credit transfers, direct debits), securities (settlement, clearing), trade finance, and foreign exchange, replacing legacy formats such as SWIFT MT and CHIPS. Its rich data model carries structured remittance information, legal entity identifiers, and purpose codes that older formats cannot accommodate, enabling straight-through processing, improved fraud detection, and regulatory reporting automation. Major financial market infrastructures worldwide — TARGET2, CHAPS, the US Fedwire and CHIPS — are migrating to ISO 20022 between 2023 and 2025."@en ;
    rdfs:subClassOf ngm:interoperability-standard ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-standards,
        ngm:financial-system,
        ngm:payment-system ;
    vc:slug "iso-20022" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso ;
    vc:supports ngm:digital-payment-system,
        ngm:financial-infrastructure .

ngm:iso-9283 a owl:Class ;
    rdfs:label "ISO 9283"@en ;
    rdfs:comment "ISO 9283 is an international standard that defines performance criteria and test methods for manipulating industrial robots, specifying how to measure and report pose accuracy, pose repeatability, path accuracy, and path velocity characteristics under controlled conditions. The standard provides a common vocabulary and methodology enabling manufacturers, integrators, and end users to make meaningful, reproducible comparisons of robot performance across different systems and vendors. It covers both Cartesian-space and joint-space metrics and prescribes the environmental and loading conditions under which measurements are to be taken. ISO 9283 is maintained by ISO/TC 299 and is complemented by related standards covering safety, collaborative operation, and application-specific performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmarks ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
