        ngm:resampling-method,
        ngm:sample-complexity,
        ngm:training-distribution ;
    vc:slug "algorithmic-bias-and-variance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:hastie-tibshirani-friedman-esl,
        ngm:py-torch,
