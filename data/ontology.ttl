    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:functional-safety ;
    vc:relatedTo ngm:rb-0090-emergency-stop ;
    vc:relatedTo ngm:rb-0095-safety-zone ;
    vc:relatedTo ngm:rb-0100-safety-integrity-level ;
    vc:relatedTo ngm:risk-assessment ;
