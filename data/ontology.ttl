    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:position-encoder ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:feedback-sensor,
        ngm:mechanical-load,
        ngm:power-supply,
        ngm:servo-amplifier ;
    vc:slug "dc-servo-motor" ;
    vc:sourceDomain "robotics" .

ngm:decoder-network a owl:Class ;
    rdfs:label "Decoder Network"@en ;
    rdfs:comment "A decoder network is the component of an encoder-decoder architecture that maps a compact latent representation back to a target output such as a reconstructed input, an image or a sequence of tokens. It learns to invert the compression performed by the encoder, reconstructing high-dimensional structure from low-dimensional codes. Decoders are central to autoencoders, variational autoencoders, sequence-to-sequence models and generative systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:representation-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:encoder-decoder-architecture,
        ngm:neural-network ;
    vc:contrastsWith ngm:encoder ;
    vc:enables ngm:audio-synthesis,
        ngm:drug-discovery,
        ngm:generative-model,
        ngm:image-generation,
        ngm:image-segmentation,
        ngm:machine-translation,
        ngm:text-generation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:loss-function,
        ngm:skip-connection,
        ngm:transposed-convolution,
        ngm:upsampling ;
    vc:implements ngm:deep-generative-model,
        ngm:generative-model ;
    vc:isPartOf ngm:autoencoder,
        ngm:encoder-decoder-architecture,
        ngm:sequence-to-sequence-model,
        ngm:variational-autoencoder ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:autoregressive-model,
        ngm:deep-learning,
        ngm:diffusion-model,
        ngm:foundation-model,
        ngm:generative-adversarial-network,
        ngm:large-language-model,
        ngm:normalising-flow,
        ngm:u-net ;
    vc:requires ngm:backpropagation,
        ngm:latent-space,
        ngm:representation-learning ;
    vc:slug "decoder-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:cross-attention,
        ngm:kv-cache,
        ngm:pixel-shuffle,
        ngm:recurrent-neural-network,
        ngm:transformer .

ngm:dense-passage-retrieval a owl:Class ;
    rdfs:label "Dense Passage Retrieval"@en ;
    rdfs:comment "Dense Passage Retrieval (DPR) is an information retrieval approach in which both queries and document passages are encoded into dense continuous vector representations using dual-encoder neural networks, enabling similarity search via dot-product or cosine distance rather than sparse lexical matching. It substantially outperforms traditional BM25 retrieval on semantic matching tasks and forms the retriever component of open-domain question-answering and retrieval-augmented generation systems."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
