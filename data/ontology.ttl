            owl:someValuesFrom ngm:python-programming-language ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:jax,
        ngm:tensor-flow ;
    vc:dependsOn ngm:high-performance-computing,
        ngm:open-source-software ;
    vc:enables ngm:computer-vision,
        ngm:deep-learning,
        ngm:model-training,
        ngm:natural-language-processing,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
