    vc:enables ngm:procedural-generation,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "node-based-editor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:3-d-asset,
        ngm:rendering-engine ;
    vc:uses ngm:game-engine,
        ngm:shader .

ngm:node-js a owl:Class ;
    rdfs:label "Node Js"@en ;
    rdfs:comment "Node.js is a cross-platform, open-source JavaScript runtime built on the V8 engine that executes JavaScript outside the browser, enabling server-side and command-line applications. It provides a single-threaded, event-driven, non-blocking I/O model that scales to many concurrent connections, together with a module system and the npm package ecosystem. Node.js is a foundational runtime for web back-ends, build tooling and blockchain development environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:runtime-environment ;
    vc:bridgesTo ngm:low-latency ;
    vc:dependsOn ngm:authentication ;
    vc:enables ngm:distributed-systems,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:api ;
    vc:isPartOf ngm:runtime-environment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:infrastructure ;
    vc:requires ngm:network-protocol ;
    vc:slug "node-js" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-collaboration,
        ngm:web3 ;
    vc:uses ngm:api,
        ngm:microservices .

ngm:notified-body a owl:Class ;
    rdfs:label "Notified Body"@en ;
    rdfs:comment "An independent third-party conformity assessment organisation formally designated by a national notifying authority under the EU AI Act (Articles 29–39) to audit and certify high-risk AI systems — particularly biometric identification and product-safety-component systems — against technical documentation, quality management, and harmonised standards requirements."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:regulatory-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:dependsOn ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:conformity-assessment ;
    vc:isPartOf ngm:regulatory-framework ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "notified-body" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:national-competent-authority .

ngm:on-chain-data-indexing a owl:Class ;
    rdfs:label "On-Chain Data Indexing"@en ;
    rdfs:comment "On-chain data indexing is the process of extracting, transforming, and organising raw blockchain events and state into queryable structures suited to application access patterns. Because base-layer data is optimised for consensus rather than retrieval, indexers ingest blocks and logs, decode them, and serve them through APIs such as GraphQL. It is the data backbone for analytics dashboards and decentralised applications."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics ;
    vc:slug "on-chain-data-indexing" ;
    vc:sourceDomain "blockchain" .

ngm:on-device-ai a owl:Class ;
    rdfs:label "On Device Ai"@en ;
    rdfs:comment "On-device AI is the execution of machine-learning inference, and increasingly some training, directly on an end-user device such as a phone, wearable or embedded sensor, rather than sending data to remote servers. Keeping computation local reduces latency, removes network dependence and improves privacy because raw data need not leave the device. It relies on model compression, quantisation and hardware acceleration to fit capable models within tight power, memory and compute budgets, and it is a cornerstone of edge AI and privacy-preserving machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        ngm:edge-ai ;
    vc:bridgesTo ngm:federated-learning ;
    vc:contrastsWith ngm:cloud-computing ;
    vc:dependsOn ngm:hardware-acceleration ;
    vc:enables ngm:inference,
        ngm:privacy-preserving-machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:edge-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-ai,
        ngm:latency ;
    vc:requires ngm:embedded-systems,
        ngm:hardware-acceleration,
        ngm:model-compression ;
    vc:slug "on-device-ai" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-privacy,
        ngm:mobile-computing ;
    vc:uses ngm:model-optimization,
        ngm:neural-network,
        ngm:tiny-ml .

ngm:online-certificate-status-protocol a owl:Class ;
    rdfs:label "Online Certificate Status Protocol"@en ;
    rdfs:comment "The Online Certificate Status Protocol (OCSP) is an internet protocol for obtaining the real-time revocation status of an X.509 digital certificate. A client queries an OCSP responder, which returns a signed good, revoked or unknown status, avoiding the need to download large certificate revocation lists. OCSP stapling allows a server to present a recent signed status during the TLS handshake to improve privacy and performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tls-handshake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:x-509-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-certificate ],
        ngm:public-key-infrastructure ;
    vc:contrastsWith ngm:trust-anchor ;
    vc:dependsOn ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:enables ngm:authentication,
        ngm:certificate-revocation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-certificate,
        ngm:tls-handshake ;
    vc:implements ngm:certificate-revocation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:certificate-revocation,
        ngm:ocsp,
        ngm:x-509-certificate ;
    vc:requires ngm:certificate-authority,
        ngm:x-509-certificate ;
    vc:slug "online-certificate-status-protocol" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:tls-handshake ;
    vc:uses ngm:tls .

ngm:op-stack a owl:Class ;
    rdfs:label "Op Stack"@en ;
    rdfs:comment "The OP Stack is an open-source, modular software framework, originally developed for Optimism, used to deploy and operate Ethereum layer-2 networks built on the optimistic rollup model. It standardises the components of a rollup chain, including the sequencer, derivation pipeline, fault-proof system, and bridge contracts, so that many independent chains can share a common technical foundation. Chains built on it interoperate as a federation often described as a superchain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sequencer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rollup ],
        [ a owl:Restriction ;
