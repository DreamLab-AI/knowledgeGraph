ngm:did-document a owl:Class ;
    rdfs:label "DID Document"@en ;
    rdfs:comment "A DID Document is a JSON-LD resource resolved from a Decentralised Identifier (DID) that expresses the DID subject's cryptographic public keys, authentication methods, assertion methods, key agreement protocols, capability delegation mechanisms, and service endpoints. Defined by the W3C DID Core specification, a DID Document is the machine-readable artefact that enables any verifier to discover how to authenticate with or communicate securely to a DID subject without relying on a centralised identity authority. DID Documents are anchored to a Verifiable Data Registry — such as a distributed ledger, blockchain, or peer-to-peer network — via a DID method-specific read operation, making them a foundational component of self-sovereign identity and verifiable credential ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verification-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-endpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        ngm:decentralised-identifier ;
    vc:bridgesTo ngm:agent-identity,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:x-509-certificate ;
    vc:enables ngm:decentralised-authentication,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:service-endpoint,
        ngm:verification-method ;
    vc:isPartOf ngm:decentralised-identifier,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:did-resolution,
        ngm:did-url,
        ngm:digital-identity,
        ngm:identity-verification ;
    vc:requires ngm:did-method,
        ngm:did-resolver,
        ngm:verifiable-data-registry ;
    vc:slug "did-document" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:w3-c,
        ngm:w3-c-did-core ;
    vc:uses ngm:digital-signature,
        ngm:json-data-interchange-format-ld,
        ngm:linked-data,
        ngm:public-key-cryptography .

ngm:message-broker a owl:Class ;
    rdfs:label "Message Broker"@en ;
    rdfs:comment "A message broker is an intermediary software component that translates messages between disparate messaging protocols and routes them between producers and consumers, decoupling the two sides of a communication so that neither needs direct knowledge of the other. It typically provides guaranteed delivery, message queuing, routing rules, protocol translation, and persistence semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistent-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:middleware ;
    vc:bridgesTo ngm:iot-platform,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:enterprise-service-bus,
        ngm:remote-procedure-call ;
    vc:enables ngm:asynchronous-messaging,
        ngm:event-streaming,
