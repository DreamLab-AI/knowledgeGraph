ngm:normal-mapping a owl:Class ;
    rdfs:comment "A real-time rendering technique that fakes fine surface detail by storing perturbed surface normals in a texture and using them, rather than the interpolated geometric normals, during per-pixel lighting. Detail sculpted on a high-polygon model is baked into a tangent-space normal map applied to a low-polygon mesh, so bumps, scratches, and seams respond correctly to moving lights without adding geometry — a cornerstone of the game-asset pipeline and physically based rendering."@en ;
    rdfs:label "Normal Mapping"@en ;
    rdfs:subClassOf ngm:texture-mapping ;
    rdfs:subClassOf _:r15525 ;
    rdfs:subClassOf _:r15526 ;
