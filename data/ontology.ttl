        ngm:open-data,
        ngm:sensor-networks .

ngm:synthetic-media a owl:Class ;
    rdfs:label "Synthetic Media"@en ;
    rdfs:comment "Synthetic Media refers to audio, video, image, and text content that is wholly generated or substantially manipulated by computational systems — primarily AI models — rather than captured directly from reality. It encompasses outputs from generative adversarial networks, diffusion models, large language models, neural text-to-speech systems, and neural rendering pipelines, including deepfakes, AI-generated images, cloned voices, and fully synthetic video sequences. The concept spans both creative and malicious applications, from cinematic visual effects and interactive media to disinformation campaigns and identity fraud, making detection, provenance tracking, and regulatory disclosure central concerns. Synthetic media sits at the convergence of generative AI capability, content authenticity infrastructure, and digital governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-to-speech ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:ai-governance,
        ngm:digital-identity ;
    vc:contrastsWith ngm:deepfake-detection,
        ngm:media-authenticity ;
    vc:enables ngm:avatar-synthesis,
        ngm:deepfakes,
        ngm:text-to-image,
        ngm:voice-cloning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:text-to-speech ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:content-provenance,
        ngm:digital-watermarking,
        ngm:disinformation ;
    vc:requires ngm:foundation-model,
        ngm:training-data ;
    vc:slug "synthetic-media" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:ai-generated-content-disclosure,
        ngm:c2-pa ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:image-generation,
        ngm:large-language-model,
        ngm:neural-text-to-speech,
        ngm:video-generation .

ngm:systemic-risk a owl:Class ;
    rdfs:label "Systemic Risk"@en ;
    rdfs:comment "Risk specific to high-impact capabilities of general-purpose AI models with significant impact on the Union market due to reach, or actual or foreseeable negative effects on public health, safety, fundamental rights, environment, democracy, or rule of law. Under EU AI Act Article 51, models exceeding 10^25 FLOPs training compute or matching the most advanced GPAI capabilities are presumed to carry systemic risk and face enhanced obligations including adversarial testing, incident reporting, and cybersecurity protection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:limited-risk-ai,
        ngm:minimal-risk-ai ;
    vc:dependsOn ngm:compute-threshold,
        ngm:foundation-model ;
    vc:enables ngm:capability-evaluation,
        ngm:conformity-assessment,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:energy-efficiency-reporting,
        ngm:incident-reporting ;
    vc:implements ngm:ai-safety-framework,
        ngm:eu-ai-act-regulatory-instrument ;
    vc:isPartOf ngm:ai-regulation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-regulation,
        ngm:cybersecurity,
        ngm:emergent-capabilities,
        ngm:human-oversight ;
    vc:requires ngm:adversarial-testing,
        ngm:incident-response,
        ngm:model-evaluation,
        ngm:risk-assessment ;
    vc:slug "systemic-risk" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-office ;
    vc:uses ngm:benchmark-evaluation .

ngm:tcp-ip a owl:Class ;
    rdfs:label "TCP/IP"@en ;
    rdfs:comment "TCP/IP is the layered suite of communication protocols that underpins the Internet, named after its two core members: the Transmission Control Protocol and the Internet Protocol. It organises networking into link, internet, transport, and application layers, providing addressing, routing, and reliable end-to-end byte streams over heterogeneous physical networks. Its packet-switched, best-effort design with end-to-end reliability above the network layer enabled global interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:application-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bandwidth ],
        ngm:network-protocol ;
    vc:contrastsWith ngm:osi-model ;
    vc:dependsOn ngm:network-layer ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:application-layer,
        ngm:network-layer,
        ngm:transport-layer ;
    vc:implements ngm:network-protocol ;
    vc:isPartOf ngm:network-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:latency ;
    vc:requires ngm:bandwidth ;
    vc:slug "tcp-ip" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:dns,
        ngm:http,
        ngm:rest-api ;
    vc:uses ngm:application-layer .

ngm:vertex-shader a owl:Class ;
    rdfs:label "Vertex Shader"@en ;
    rdfs:comment "A mandatory, programmable GPU stage that processes individual vertices within the graphics pipeline, transforming 3D coordinates through model, view, and projection matrices into clip space whilst computing per-vertex attributes such as normals, texture coordinates, and lighting terms that are subsequently interpolated across primitives for the fragment shader."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vertex-buffer ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:compute-shader,
        ngm:geometry-shader,
        ngm:tessellation-shader ;
    vc:dependsOn ngm:vertex-attribute ;
    vc:enables ngm:displacement-mapping,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:skeletal-animation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:graphics-pipeline,
        ngm:rendering-pipeline,
        ngm:shader ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail,
        ngm:real-time-rendering,
        ngm:visual-effects ;
    vc:requires ngm:graphics-processing-unit,
        ngm:vertex-buffer ;
    vc:slug "vertex-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:glsl,
        ngm:gpu-programming,
        ngm:hlsl .

ngm:zk-snark a owl:Class ;
    rdfs:label "ZK-SNARK"@en ;
    rdfs:comment "A ZK-SNARK (Zero-Knowledge Succinct Non-Interactive Argument of Knowledge) is a cryptographic proof system that allows a prover to convince a verifier that a computational statement is true without revealing any information beyond the validity of the statement itself. The proof is succinct — its size and verification time are sub-linear (often constant or logarithmic) relative to the underlying computation — and non-interactive, requiring no back-and-forth messages between prover and verifier. Most constructions rely on bilinear pairings over elliptic curves and require a one-time trusted setup ceremony to generate a structured reference string."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-setup ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:arithmetic-circuit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bilinear-pairing ],
        ngm:zero-knowledge-proof ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:contrastsWith ngm:interactive-proof,
        ngm:zk-starks ;
    vc:enables ngm:groth-16,
        ngm:private-transaction,
        ngm:rollup,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:non-interactive-proof,
        ngm:succinct-argument ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:groth-16,
        ngm:plonk,
        ngm:zcash ;
    vc:requires ngm:arithmetic-circuit,
        ngm:bilinear-pairing,
        ngm:elliptic-curve-cryptography,
        ngm:trusted-setup ;
    vc:slug "zk-snark" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain,
        ngm:identity-verification,
        ngm:privacy-preserving-computation ;
    vc:uses ngm:fiat-shamir-heuristic,
        ngm:polynomial-commitment .

ngm:ai-audit a owl:Class ;
    rdfs:label "AI Audit"@en ;
    rdfs:comment "A systematic, independent examination and evaluation of an artificial intelligence system's design, development processes, deployment procedures, operational performance, documentation, governance arrangements, and compliance with applicable requirements, conducted by qualified assessors to verify conformity with specified standards, regulations, ethical principles, or organisational policies, and to identify deficiencies, risks, or opportunities for improvement, producing documented findings and recommendations that support accountability, transparency, and continuous enhancement of AI system trustworthiness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-documentation-standards ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:eu-ai-act-regulatory-instrument ;
    vc:contrastsWith ngm:internal-audit ;
    vc:enables ngm:accountability,
        ngm:conformity-assessment,
        ngm:third-party-certification,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:compliance-audit ;
    vc:implements ngm:iso-iec-42001-2023 ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability ;
    vc:requires ngm:ai-documentation-standards ;
    vc:slug "ai-audit" ;
    vc:sourceDomain "artificial-intelligence" ;
