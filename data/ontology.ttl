ngm:z-wave-js-ui a owl:Class ;
    rdfs:label "Z-Wave JS UI"@en ;
    rdfs:comment "Z-Wave JS UI is an open-source application that wraps the Z-Wave JS driver to manage a Z-Wave mesh network of smart-home devices through a web interface and to bridge it to home-automation platforms via MQTT. It handles device inclusion, configuration, firmware updates, and network healing, exposing Z-Wave nodes as controllable entities. It matters as a primary integration path between Z-Wave hardware and Home Assistant."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "z-wave-js-ui" ;
    vc:sourceDomain "infrastructure" .

ngm:zero-downtime-deployment a owl:Class ;
    rdfs:label "Zero Downtime Deployment"@en ;
    rdfs:comment "Zero Downtime Deployment is a release strategy that updates a running service without interrupting user-facing availability. It relies on patterns such as rolling updates, blue-green switchovers, or canary releases combined with health checks and load-balancer draining so that traffic only reaches instances ready to serve it. Achieving it requires backward-compatible changes, graceful connection shutdown, and idempotent operations across the transition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:idempotency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:auto-scaling ],
        ngm:continuous-deployment ;
    vc:bridgesTo ngm:orchestration ;
    vc:dependsOn ngm:container,
        ngm:kubernetes ;
    vc:enables ngm:continuous-deployment,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:continuous-deployment ;
    vc:isPartOf ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ci-cd,
        ngm:fault-tolerance,
        ngm:scalability ;
    vc:requires ngm:auto-scaling,
        ngm:idempotency ;
    vc:slug "zero-downtime-deployment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:resilience ;
    vc:uses ngm:load-balancing,
        ngm:orchestration .

