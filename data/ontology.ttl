vf:content-addressing a owl:Class ;
    rdfs:label "Content Addressing"@en ;
    rdfs:comment "The fundamental principle (R1 in ADR-013) that derives a resource's URI deterministically from its [[Content Hash|cryptographic content hash]] (SHA-256), ensuring immutability, tamper-detection, and deduplication, enabling [[VisionClaw Agentic Container|VisionClaw]] artefacts (credentials, receipts, events, pods, activities) to be referenced by their content rather than by location or opaque identifiers."@en ;
    rdfs:subClassOf vf:data-layer ;
    vc:authorityScore "0.96"^^xsd:float ;
    vc:enables <urn:visionflow:linked:decentralised-storage>,
        <urn:visionflow:linked:deduplication>,
        <urn:visionflow:linked:permanent-referenceability>,
        <urn:visionflow:linked:tamper-detection>,
        vf:immutability ;
    vc:hasPart <urn:visionflow:linked:content-hash>,
        <urn:visionflow:linked:deterministic-serialisation>,
        <urn:visionflow:linked:hash-minting>,
        <urn:visionflow:linked:sha-256-hashing> ;
    vc:implements <urn:visionflow:linked:content-addressed-storage-principles>,
        <urn:visionflow:linked:git-object-addressing>,
        <urn:visionflow:linked:ipfs-content-addressing> ;
    vc:maturity "established" ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:requires <urn:visionflow:linked:canonical-json>,
        <urn:visionflow:linked:cryptographic-hash-function>,
        <urn:visionflow:linked:deterministic-encoding> ;
    vc:slug "content-addressing" ;
    vc:sourceDomain "blockchain" .

