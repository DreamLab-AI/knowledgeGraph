ngm:control-framework a owl:Class ;
    rdfs:comment "A control framework is a structured set of governance, risk, and compliance controls that an organisation adopts to manage risk and demonstrate conformance to regulatory or industry requirements. Examples include NIST CSF, COBIT, ISO 27001, and SOC 2, each mapping objectives to specific control activities and evidence. It provides a common reference for designing, operating, and auditing controls consistently."@en ;
    rdfs:label "Control Framework"@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance ;
    vc:relatedTo ngm:regulatory-compliance ;
    vc:slug "control-framework" ;
    vc:sourceDomain "governance" .
ngm:control-groups a skos:Concept ;
    rdfs:label "Control Groups"@en .
ngm:control-inputs a skos:Concept ;
    rdfs:label "Control Inputs"@en .
ngm:control-interface a owl:Class ;
    rdfs:comment "A control interface is the defined boundary through which commands and feedback are exchanged between a controller and a controlled device such as an actuator, end-effector, or robot subsystem. It specifies the signals, protocols, data rates, and timing required for deterministic command of the hardware. A well-defined control interface is what allows higher-level planners and digital twins to actuate physical systems reliably."@en ;
    rdfs:label "Control Interface"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin ;
    vc:relatedTo ngm:end-effector ;
    vc:slug "control-interface" ;
    vc:sourceDomain "robotics" .
ngm:control-law a owl:Class ;
    rdfs:comment "A control law is the mathematical rule that maps measured system state and reference signals to the control inputs applied to a plant. It is the algorithmic core of a feedback controller, expressed as functions such as PID, state feedback, or impedance laws. The choice of control law determines stability, tracking accuracy, and disturbance rejection of the closed-loop system."@en ;
    rdfs:label "Control Law"@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control ;
    vc:relatedTo ngm:position-control ;
    vc:slug "control-law" ;
    vc:sourceDomain "robotics" .
ngm:control-layer a owl:Class ;
    rdfs:comment "The Control Layer is the stratum that issues commands to actuators or subsystems to drive a system toward desired states. It sits above the Perception Layer, on whose estimates it acts, and below planning and agent strata that set goals. It contains controllers, feedback loops, set-point logic, and the actuation interfaces that effect change."@en ;
    rdfs:label "Control Layer"@en ;
    rdfs:subClassOf ngm:owl-thing ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r5698 ;
