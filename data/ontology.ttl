# Media Richness Theory
distributed-collaboration:MediaRichnessTheory rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:OrganisationalTheory ;
    rdfs:label "Media Richness Theory"@en ;
    rdfs:comment "\"A theoretical framework positing that communication media vary in their capacity to convey rich information through multiple cues, immediate feedback, language variety, and personal focus, predicting that richer media enable more effective communication of complex, ambiguous information whilst leaner media suffice for routine, unambiguous messages.\""@en ;
    skos:prefLabel "Media Richness Theory"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:media-richness-theory" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:media-richness-theory> ;
    vcw:contentHash "sha256-12-6544114c6f3a" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0004" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0004" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

distributed-collaboration:MediaRichnessTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:CommunicationEffectiveness
] .

# Presence
distributed-collaboration:Presence rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:PsychologicalPhenomenon ;
    rdfs:label "Presence"@en ;
    rdfs:comment "\"The subjective psychological phenomenon of perceiving oneself as located within a mediated environment rather than one's actual physical location, characterised by a sense of 'being there' that emerges from immersive sensory stimulation and reduced awareness of the mediating technology, foundational to effective telepresence experiences.\""@en ;
    skos:prefLabel "Presence"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:presence-tc-0006" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:presence-tc-0006> ;
    vcw:contentHash "sha256-12-7b53c39f32d5" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0006" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0006" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

distributed-collaboration:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:SuspensionOfDisbelief
] .

distributed-collaboration:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:TELE001telepresence
] .

