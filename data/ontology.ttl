ngm:polycentric-governance a owl:Class ;
    rdfs:label "Polycentric Governance"@en ;
    rdfs:comment "Polycentric governance is a theory and practice of institutional arrangement in which authority over a shared domain is distributed across multiple overlapping, semi-autonomous decision-making centres rather than concentrated in a single hierarchy. Developed by Vincent and Elinor Ostrom through empirical study of common-pool resource management, the framework holds that complex social-ecological and sociotechnical systems benefit from diverse, redundant governance layers that can adapt, experiment, and mutually check one another. Each governance unit retains meaningful autonomy while engaging with others through negotiation, conflict-resolution mechanisms, and shared rules. Polycentric governance is increasingly applied to internet regulation, AI governance, and decentralised protocol design."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:contrastsWith ngm:governance-architecture ;
    vc:enables ngm:dao-governance,
        ngm:participatory-policy-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:community-governance,
        ngm:decentralized-governance,
        ngm:democratic-governance ;
    vc:slug "polycentric-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:data-governance .

ngm:polygon a owl:Class ;
    rdfs:label "Polygon"@en ;
    rdfs:comment "Polygon is a set of Ethereum scaling protocols and a development platform, originally launched as Matic Network in 2017 and rebranded to Polygon in 2021. It began as a proof-of-stake sidechain that runs in parallel to Ethereum and has expanded into zero-knowledge rollup technology, notably Polygon zkEVM, which executes Ethereum-compatible transactions with validity proofs. The architecture aims to offer lower fees and higher throughput while keeping compatibility with Ethereum tooling. The network's token, originally MATIC and migrating to POL, is used for staking and fees across Polygon chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-application,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:arbitrum,
        ngm:optimism,
        ngm:zk-sync ;
    vc:enables ngm:blockchain-interoperability,
        ngm:decentralised-finance,
        ngm:layer-2-scaling,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ethereum-virtual-machine,
        ngm:rollup,
        ngm:zk-rollup ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:gas-fee,
        ngm:sidechain,
        ngm:token-standard ;
    vc:requires ngm:ethereum-smart-contract-platform,
        ngm:proof-of-stake,
        ngm:validator-node,
        ngm:zero-knowledge-proof ;
    vc:slug "polygon" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:staking,
        ngm:validity-proof,
        ngm:zk-evm .

