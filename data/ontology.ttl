ngm:adam-optimizer a owl:Class ;
    rdfs:label "Adam Optimizer"@en ;
    rdfs:comment "US-spelling alias for the Adam Optimiser (Adaptive Moment Estimation). A first-order stochastic gradient-based optimisation algorithm that computes per-parameter adaptive learning rates by maintaining exponentially decaying moving averages of past gradients (first moment) and past squared gradients (second moment), with bias correction applied in early iterations. Introduced by Kingma and Ba (2014), it has become the de-facto standard training algorithm for large language models, diffusion models, and deep neural networks. The canonical ontology entry is at urn:ngm:class:adam-optimiser."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:exponential-moving-average ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:gradient-descent,
        ngm:optimization-algorithm ;
    vc:bridgesTo ngm:distributed-training,
        ngm:federated-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:adagrad,
        ngm:lion-optimiser,
        ngm:muon-optimiser,
        ngm:rmsprop,
        ngm:sgd-with-momentum ;
    vc:enables ngm:convergence,
        ngm:deep-learning,
        ngm:fine-tuning,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:exponential-moving-average,
        ngm:learning-rate-schedule ;
    vc:implements ngm:adaptive-learning-rate ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:adafactor,
        ngm:adamw,
        ngm:amsgrad,
        ngm:gradient-clipping,
        ngm:large-language-model,
        ngm:transformer-architecture,
        ngm:weight-decay ;
    vc:requires ngm:backpropagation,
        ngm:loss-function,
        ngm:stochastic-gradient-descent ;
    vc:slug "adam-optimizer" ;
    vc:sourceDomain "machine-learning" .

