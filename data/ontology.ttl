        <urn:visionflow:linked:social-control>,
        <urn:visionflow:linked:targeted-advertising> ;
    vc:hasPart <urn:visionflow:linked:alpr-networks>,
        <urn:visionflow:linked:biometric-tracking>,
        <urn:visionflow:linked:bossware>,
        <urn:visionflow:linked:commercial-spyware>,
