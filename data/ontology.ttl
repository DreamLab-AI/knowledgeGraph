ngm:time-synchronisation a owl:Class ;
    rdfs:label "Time Synchronisation"@en ;
    rdfs:comment "Time synchronisation is the process of coordinating the clocks of networked devices to a shared reference time so that distributed computations, transactions, events, and audit logs share a consistent and ordered temporal frame. It is realised through layered protocols including the Network Time Protocol (NTP / RFC 5905), which delivers millisecond-level accuracy over wide-area networks via a stratum hierarchy anchored to atomic or GPS reference clocks, and the Precision Time Protocol (PTP / IEEE 1588-2019), which exploits hardware timestamping in network interface cards and PTP-aware switches to achieve sub-microsecond accuracy on local and carrier-grade networks. Accurate time synchronisation is foundational to distributed consensus algorithms, cryptographic certificate validation, financial transaction sequencing, telecommunications frequency synchronisation, and industrial real-time control; conversely, clock skew and drift are root causes of ordering anomalies, replay attacks, split-brain conditions, and regulatory non-compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:cryptographic-protocol,
        ngm:iot-device-management ;
    vc:contrastsWith ngm:logical-clock,
        ngm:vector-clock ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:timestamp ;
    vc:enables ngm:audit-logging,
        ngm:consensus-protocol,
        ngm:digital-certificate,
        ngm:distributed-system,
        ngm:event-ordering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:clock-drift,
        ngm:network-time-protocol,
        ngm:precision-time-protocol,
        ngm:stratum-hierarchy ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clock-skew,
        ngm:distributed-ledger,
        ngm:edge-computing,
        ngm:latency,
        ngm:network-synchronization ;
    vc:requires ngm:atomic-clock,
        ngm:gps-receiver,
        ngm:network-protocol,
        ngm:reference-clock ;
    vc:slug "time-synchronisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:itu-t ;
    vc:supports ngm:blockchain,
        ngm:financial-trading-infrastructure,
        ngm:industrial-automation,
        ngm:real-time-system .

ngm:token-embedding a owl:Class ;
    rdfs:label "Token Embedding"@en ;
    rdfs:comment "A learnable lookup table that maps each discrete token in a vocabulary to a dense continuous vector, providing the initial semantic encoding fed into transformer model layers. Embeddings are trained end-to-end and combined with positional encodings; they may be tied with the output un-embedding matrix to reduce parameter count and improve training stability."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:neural-network-layer,
        ngm:self-attention ;
    vc:slug "token-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:tool-schema a owl:Class ;
    rdfs:label "Tool Schema"@en ;
    rdfs:comment "A tool schema is a structured, machine-readable specification — typically expressed in JSON Schema format — that formally defines a function or external capability that an AI agent may invoke at inference time, encoding its name, natural-language description, parameter names and types, constraints, and required versus optional fields. Tool schemas are injected into an AI model's context window as part of the system prompt or capability manifest, enabling the model to reason about available operations and emit syntactically correct, structured function-call outputs that an orchestration layer can dispatch. They constitute the primary interface contract between large language models and the external systems, services, or data sources they interact with, determining both tool-selection accuracy and invocation correctness. The tool schema construct is foundational to agentic AI architectures and underpins modern function-calling APIs, the Model Context Protocol, and multi-agent orchestration frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:structured-output ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:microservices-architecture,
        ngm:restful-api ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:prompt-engineering ;
    vc:dependsOn ngm:inference-time-compute,
        ngm:schema-registry ;
    vc:enables ngm:agentic-ai,
        ngm:ai-agent,
        ngm:function-calling,
        ngm:tool-selection,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:model-context-protocol,
        ngm:openapi-specification ;
    vc:isPartOf ngm:agent-orchestration,
        ngm:capability-manifest ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:requires ngm:json-schema,
        ngm:large-language-model,
        ngm:structured-output ;
    vc:slug "tool-schema" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:multi-agent-system,
        ngm:retrieval-augmented-generation ;
    vc:uses ngm:natural-language-description,
        ngm:parameter-validation,
        ngm:type-system .

ngm:traditional-finance a owl:Class ;
    rdfs:label "Traditional Finance"@en ;
    rdfs:comment "Traditional Finance (TradFi) denotes the incumbent financial system comprising central banks, commercial and investment banks, securities exchanges, clearing houses, custodians, and regulated intermediaries that operate under sovereign legal frameworks. It relies on trusted third parties to record ownership, settle transactions, and extend credit, in contrast to decentralised or blockchain-native alternatives. Its architecture encompasses fractional-reserve banking, fiat currency issuance, and multilateral settlement rails such as SWIFT and RTGS systems. TradFi institutions are subject to prudential regulation, capital adequacy requirements (Basel III/IV), and conduct oversight by bodies such as the SEC, FCA, and ECB."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiat-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:blockchain-interoperability,
        ngm:central-bank-digital-currency,
        ngm:real-world-assets,
        ngm:tokenisation ;
    vc:contrastsWith ngm:cryptocurrency,
        ngm:de-fi,
        ngm:decentralised-finance ;
    vc:dependsOn ngm:central-banking,
        ngm:financial-infrastructure ;
    vc:enables ngm:capital-markets,
        ngm:institutional-adoption,
        ngm:payment-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:central-banking,
