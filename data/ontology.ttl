        <urn:visionflow:linked:monte-carlo-methods>,
        <urn:visionflow:linked:numerical-linear-algebra>,
        <urn:visionflow:linked:probability-theory> ;
    vc:slug "probabilistic-model" ;
    vc:sourceDomain "artificial-intelligence" .

