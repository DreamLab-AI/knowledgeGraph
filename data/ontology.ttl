ngm:credential-verification a owl:Class ;
    rdfs:label "Credential Verification"@en ;
    rdfs:comment "Credential verification is the process of cryptographically or institutionally confirming the authenticity, integrity, and current validity of a credential — such as a digital certificate, verifiable credential, or identity assertion — issued by a trusted authority about a subject, so that a relying party can grant access or trust without real-time contact with the original issuer. In decentralised identity systems it relies on public-key cryptography, digital signatures, and optionally distributed ledgers to enable privacy-preserving, tamper-evident verification. The process must also resolve issuer keys and query revocation registries (via CRL, OCSP, or on-chain status) to ensure invalidated credentials cannot be fraudulently reused. Selective-disclosure techniques, including zero-knowledge proofs and SD-JWTs, allow subjects to prove specific attributes without exposing unnecessary personal data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:revocation-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        ngm:authentication ;
    vc:bridgesTo ngm:distributed-ledger-technology,
        ngm:smart-contract ;
    vc:contrastsWith ngm:credential-issuance,
        ngm:password-authentication ;
    vc:dependsOn ngm:certificate-authority,
        ngm:credential-schema,
        ngm:decentralized-identifier ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management,
        ngm:selective-disclosure,
        ngm:trust-establishment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:revocation-check,
        ngm:schema-validation,
        ngm:signature-verification ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity,
        ngm:know-your-customer,
        ngm:mobile-driving-licence,
        ngm:self-sovereign-identity ;
    vc:requires ngm:cryptographic-signature,
        ngm:public-key-infrastructure,
        ngm:revocation-registry,
        ngm:trust-anchor ;
    vc:slug "credential-verification" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:openid4vc,
        ngm:w3c-verifiable-credentials,
        ngm:x509-certificate ;
    vc:uses ngm:cryptographic-verification,
        ngm:decentralized-identity-did,
        ngm:digital-signature,
        ngm:zero-knowledge-proof .

ngm:data-annotation a owl:Class ;
    rdfs:label "Data Annotation"@en ;
    rdfs:comment "Data Annotation is the process of labeling or tagging raw data (images, text, audio, video) with structured, meaningful labels that provide ground truth for supervised machine learning models, enabling algorithms to learn from human-validated examples."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
