ngm:neural-network-quantisation a owl:Class ;
    rdfs:label "Neural Network Quantisation"@en ;
    rdfs:comment "A model compression technique that reduces the numerical precision of neural network weights and activations from floating-point (FP32, FP16) to lower-bit integer representations (INT8, INT4, binary), decreasing memory footprint and improving inference speed on hardware with integer arithmetic units. Approaches include post-training quantisation and quantisation-aware training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-precision-training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:inference-hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mixed-precision-training,
        ngm:quantisation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:slug "neural-network-quantisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-discipline-model,
        ngm:pretrained-model .

ngm:neural-radiance-fields a owl:Class ;
    rdfs:label "Neural Radiance Fields"@en ;
    rdfs:comment "A neural rendering technique that represents 3D scenes as continuous volumetric radiance functions encoded by multilayer perceptrons, mapping 5D inputs (3D spatial position plus 2D viewing direction) to colour and volume density. Novel viewpoints are synthesised by volumetric ray marching through the learned representation, enabling photorealistic view synthesis from sparse photograph sets without explicit 3D geometry. Introduced by Mildenhall et al. (ECCV 2020), NeRF has driven a generation of implicit neural scene representations spanning telepresence, virtual production, and robotics."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:photorealistic-rendering,
        ngm:scene-capture-and-reconstruction,
        ngm:telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:3-d-content-generation,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-reconstruction,
        ngm:computer-vision,
        ngm:neural-rendering,
        ngm:point-cloud ;
    vc:slug "neural-radiance-fields" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning-discipline,
        ngm:ray-marching .

ngm:notary-service a owl:Class ;
    rdfs:label "Notary Service"@en ;
    rdfs:comment "A notary service is a trusted third-party function that attests to the authenticity, integrity, and existence of a document or digital artefact at a specific point in time, producing a tamper-evident record legally admissible as proof. In digital contexts, notary services hash document content and anchor that hash to a verifiable ledger — blockchain or traditional timestamping authority — binding the evidence to a precise timestamp without revealing the document contents. They bridge traditional legal document authentication with cryptographic proof mechanisms, enabling use cases ranging from intellectual property protection to supply chain provenance. Blockchain-anchored notary services eliminate single-point-of-failure trust assumptions present in classical certificate-authority-based approaches."@en ;
    rdfs:subClassOf ngm:security-services ;
    vc:enables ngm:credential-verification,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-verification,
        ngm:formal-verification,
        ngm:virtual-notary-service ;
    vc:slug "notary-service" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-certificate,
        ngm:digital-signature-verification .

ngm:object-recognition a owl:Class ;
    rdfs:label "Object Recognition"@en ;
    rdfs:comment "Object recognition is a computer vision task that involves identifying and localising instances of predefined object categories within images or video streams, producing class labels, bounding boxes, segmentation masks, or pose estimates depending on the task variant. It subsumes tasks including image classification, object detection, semantic segmentation, and instance segmentation, and has become a core capability of autonomous systems, augmented reality, and content understanding pipelines. Modern approaches are dominated by deep convolutional and transformer-based architectures trained on large annotated datasets."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection,
        ngm:pattern-recognition ;
    vc:slug "object-recognition" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:feature-extraction .

ngm:open-id-foundation a owl:Class ;
    rdfs:label "OpenID Foundation"@en ;
    rdfs:comment "The OpenID Foundation (OIDF) is an international, member-driven, non-profit standards organisation that stewards the OpenID family of identity specifications, including OpenID Connect, FAPI (Financial-grade API), MODRNA, and Digital Credentials. It coordinates working groups composed of identity providers, relying parties, and government bodies to develop, test interoperability of, and maintain open specifications for federated authentication and authorisation. The Foundation operates certification programmes to verify implementation conformance to published profiles, reducing interoperability barriers across global digital identity ecosystems. Founded in 2007, the OIDF operates under a royalty-free intellectual property policy, ensuring open access to its specifications without patent encumbrance."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:bridgesTo ngm:digital-wallet,
        ngm:eidas ;
    vc:contrastsWith ngm:saml,
        ngm:w3c-did ;
    vc:enables ngm:conformance-certification,
        ngm:federated-identity,
        ngm:open-banking,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-credentials-working-group,
        ngm:fapi-working-group,
        ngm:modrna-working-group,
        ngm:openid-connect-working-group ;
    vc:implements ngm:json-web-token,
        ngm:oauth-2 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:decentralised-identity,
        ngm:identity-federation,
        ngm:self-sovereign-identity ;
    vc:slug "open-id-foundation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-identity-standards,
        ngm:financial-grade-api,
        ngm:open-id-connect,
        ngm:verifiable-credentials .

ngm:open-usd a owl:Class ;
    rdfs:label "OpenUSD"@en ;
    rdfs:comment "OpenUSD (Universal Scene Description) is an open-source framework, scene-graph data model, and file format developed by Pixar Animation Studios for composing, simulating, collaborating on, and exchanging richly structured 3D scenes across digital content creation tools and real-time rendering pipelines. Its layered composition engine allows multiple teams or tools to contribute non-destructive overrides to a shared hierarchical scene graph with full time-sampled animation support, making it the de facto interchange format for large-scale visual effects, game engine, and industrial simulation pipelines. Governed since 2023 by the Alliance for OpenUSD (AOUSD) and progressing toward ISO/IEC 22886 standardisation, OpenUSD underpins NVIDIA Omniverse, Apple visionOS/RealityKit, and major digital twin platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
