    rdfs:label "Telecollaboration Domain"@en ;
    rdfs:comment "\"The domain of knowledge encompassing technology-mediated collaboration, distributed teamwork, remote presence systems, and virtual cooperation platforms enabling humans to work together effectively across geographical and temporal boundaries.\""@en ;
