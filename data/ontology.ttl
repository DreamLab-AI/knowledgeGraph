ngm:just-transition a owl:Class ;
    rdfs:label "Just Transition"@en ;
    rdfs:comment "A just transition is a framework for shifting economies toward low-carbon and sustainable production while ensuring that the burdens and benefits of that shift are distributed fairly. It seeks to protect workers, communities and developing regions dependent on carbon-intensive industries through retraining, social support and inclusive planning. The concept links climate policy with social equity and labour rights."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing,
        ngm:global-inequality ;
    vc:slug "just-transition" ;
    vc:sourceDomain "governance" .

ngm:key-aggregation a owl:Class ;
    rdfs:label "Key Aggregation"@en ;
    rdfs:comment "Key Aggregation is a cryptographic technique that combines multiple individual public keys into a single aggregate public key, against which a combined signature can be verified as though produced by one signer. It is central to modern multi-signature schemes such as MuSig2, where several parties jointly produce one compact signature indistinguishable from a single-key signature. Key aggregation improves privacy, reduces on-chain footprint and lowers verification cost in distributed signing protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:multi-signature ;
    vc:contrastsWith ngm:key-management ;
    vc:dependsOn ngm:public-key-cryptography ;
    vc:enables ngm:multi-signature,
        ngm:schnorr-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:cryptographic-protocol ;
    vc:isPartOf ngm:cryptographic-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:digital-signature,
        ngm:key-management ;
    vc:requires ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:slug "key-aggregation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:bitcoin,
        ngm:multi-signature ;
    vc:uses ngm:cryptography,
        ngm:schnorr-signature .

ngm:keyword-search a owl:Class ;
    rdfs:label "Keyword Search"@en ;
    rdfs:comment "Keyword search is an information retrieval approach that matches documents to a query based on the presence and statistics of literal terms, typically using inverted indexes and term-weighting schemes. It ranks results by lexical relevance signals such as term frequency and inverse document frequency rather than semantic meaning. Fast, interpretable, and exact for known vocabulary, it is frequently combined with semantic methods in hybrid retrieval to balance precision and recall."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-processing ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:hybrid-search ;
    vc:contrastsWith ngm:semantic-search,
        ngm:vector-search ;
    vc:enables ngm:relevance-ranking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:full-text-search ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:full-text-search,
        ngm:relevance-ranking,
        ngm:search-engine ;
    vc:requires ngm:query-processing ;
    vc:slug "keyword-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:document-retrieval,
        ngm:search-engine ;
    vc:uses ngm:bm25,
        ngm:inverted-index,
        ngm:tf-idf .

ngm:kl-divergence a owl:Class ;
    rdfs:label "Kl Divergence"@en ;
    rdfs:comment "Kullback-Leibler (KL) divergence is a measure from information theory that quantifies how one probability distribution differs from a second reference distribution, expressed as the expected excess surprise from using the wrong distribution. It is non-negative and zero only when the two distributions coincide, but it is asymmetric and does not satisfy the triangle inequality, so it is not a true metric. KL divergence is central to maximum-likelihood estimation, variational inference and many machine-learning objectives, where minimising it aligns a model distribution with a target. In reinforcement learning from human feedback it acts as a regulariser that keeps a fine-tuned policy close to its reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        ngm:information-theory ;
    vc:bridgesTo ngm:variational-inference ;
    vc:contrastsWith ngm:entropy ;
    vc:enables ngm:direct-preference-optimisation,
        ngm:variational-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:loss-function ;
    vc:isPartOf ngm:information-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:entropy,
        ngm:generative-model ;
    vc:requires ngm:probability-distribution ;
    vc:slug "kl-divergence" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:loss-function,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:uses ngm:entropy,
        ngm:probability-distribution .

ngm:knowledge-graphs a owl:Class ;
    rdfs:label "Knowledge Graphs"@en ;
    rdfs:comment "Structured representations of knowledge as entities and the typed relationships between them, expressed as a graph of nodes and labelled edges grounded in an ontology, enabling querying, reasoning, and inference over heterogeneous data."@en ;
