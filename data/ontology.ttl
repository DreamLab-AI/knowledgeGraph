    vc:requires ngm:audit-trail ;
    vc:slug "compliance-management" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:policy-enforcement .

ngm:computer-vision-task a owl:Class ;
    rdfs:label "Computer Vision Task"@en ;
    rdfs:comment "A Computer Vision Task is a specific computational problem solved using visual input data, encompassing image classification, object detection, semantic segmentation, instance segmentation, and pose estimation. These tasks form the building blocks of downstream vision applications such as scene understanding, autonomous navigation, and visual question answering, typically implemented via convolutional or transformer-based neural architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:autonomous-navigation,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:image-classification,
        ngm:instance-segmentation,
        ngm:object-detection,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:isPartOf ngm:computer-vision ;
