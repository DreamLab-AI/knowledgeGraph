ngm:provenance-tracking a owl:Class ;
    rdfs:label "Provenance Tracking"@en ;
    rdfs:comment "Systems employing immutable distributed ledgers, IoT sensors, and smart contracts to create comprehensive audit trails tracking entities (products, data, AI model outputs) from origin to consumer or end-use, enabling rapid traceability, counterfeit prevention, regulatory compliance, and ethical sourcing verification across food safety, pharmaceuticals, luxury goods, and AI governance contexts."@en ;
