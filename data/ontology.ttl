        ngm:microservices-architecture ;
    vc:slug "cloud-native" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:kubernetes,
        ngm:microservices,
        ngm:service-mesh .

ngm:clustering a skos:Concept ;
    rdfs:label "Clustering"@en .

ngm:collaborative-systems-modality-filtering a owl:Class ;
    rdfs:label "Collaborative Filtering"@en ;
    rdfs:comment "Collaborative filtering is a machine learning technique for building recommendation systems that generates predictions about user preferences by aggregating the behaviour or ratings of many users, without requiring explicit knowledge of item content. Memory-based approaches compute similarity between users (user-based) or items (item-based) using rating vectors; model-based approaches such as matrix factorisation decompose the user-item interaction matrix into latent factor spaces. The method operates on the assumption that users who agreed in the past will agree in the future, and is the foundational algorithm behind recommendation engines at Netflix, Spotify, and Amazon."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:enables ngm:hyper-personalisation,
        ngm:recommendation-engine,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:privacy-preserving-data-mining,
        ngm:recommendation-systems ;
    vc:slug "collaborative-filtering" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embeddings,
        ngm:machine-learning-discipline .

ngm:collaborative-systems-modality-operation a owl:Class ;
    rdfs:label "Collaborative Operation"@en ;
    rdfs:comment "Collaborative Operation - Coordinated execution of tasks between Human Operators and Robotic Systems within the same workspace, governed by safety protocols, task allocation mechanisms, and real-time communication to achieve shared objectives."@en ;
