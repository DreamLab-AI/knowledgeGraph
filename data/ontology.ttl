ngm:nist-privacy-framework a owl:Class ;
    rdfs:label "NIST Privacy Framework"@en ;
    rdfs:comment "A NIST framework providing voluntary guidance to help organisations manage privacy risks arising from data processing. It is structured around core functions to support privacy risk management."@en ;
