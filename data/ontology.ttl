        ngm:neurips,
        ngm:reinforcement-learning ;
    vc:slug "icml" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:international-machine-learning-society ;
    vc:uses ngm:double-blind-review,
        ngm:machine-learning-model,
        ngm:optimization-algorithm .

ngm:identity-resolution a owl:Class ;
    rdfs:label "Identity Resolution"@en ;
    rdfs:comment "Identity resolution is the process of determining that multiple data records, identifiers, or signals across different systems refer to the same real-world entity — whether a person, organisation, or device — and consolidating them into a unified, persistent representation. It combines probabilistic and deterministic matching algorithms, data enrichment, and graph-linking to resolve fragmented identities across first-party, second-party, and third-party data sources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-deduplication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-graph ],
        ngm:entity-resolution ;
    vc:bridgesTo ngm:self-sovereign-identity,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:anonymous-credential,
        ngm:decentralized-identity ;
    vc:dependsOn ngm:graph-database,
        ngm:hashing-function ;
    vc:enables ngm:cross-device-tracking,
        ngm:fraud-detection,
        ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:deterministic-matching,
        ngm:identity-graph,
        ngm:probabilistic-matching ;
    vc:isPartOf ngm:customer-data-platform,
        ngm:master-data-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:data-clean-room,
        ngm:privacy-preserving-analytics ;
    vc:requires ngm:data-deduplication,
        ngm:record-linkage ;
    vc:slug "identity-resolution" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3c-did ;
    vc:supports ngm:audience-segmentation,
        ngm:patient-matching ;
    vc:uses ngm:data-enrichment,
        ngm:machine-learning,
        ngm:universal-id .

ngm:identity-systems a owl:Class ;
    rdfs:label "Identity Systems"@en ;
    rdfs:comment "Identity Systems are the technical and organisational frameworks that establish, manage, verify, and revoke digital identities for users, devices, and services. They encompass authentication mechanisms, credential issuance, public-key infrastructure, and decentralised identity models (self-sovereign identity, DIDs) that enable secure, interoperable identification across platforms and jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-sovereign-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
