    vc:relatedTo ngm:oauth-2-0,
        ngm:open-id-connect ;
    vc:requires ngm:digital-certificate,
        ngm:public-key-cryptography ;
    vc:slug "authentication-standards" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance,
        ngm:w3-c ;
    vc:supports ngm:decentralized-identity,
        ngm:single-sign-on ;
    vc:uses ngm:biometric-verification,
        ngm:challenge-response-protocol .

ngm:automata-theory a owl:Class ;
    rdfs:label "Automata Theory"@en ;
    rdfs:comment "Automata theory is the branch of theoretical computer science that studies abstract computing machines (automata) and the classes of formal languages they can recognise. It classifies machines such as finite-state automata, pushdown automata, and Turing machines by their computational power, establishing a hierarchy that defines what problems are decidable. The theory provides the formal foundations for compiler design, regular expressions, protocol verification, and model checking."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-research-area,
        ngm:state-machine ;
    vc:slug "automata-theory" ;
    vc:sourceDomain "infrastructure" .

ngm:behavioural-analytics a owl:Class ;
    rdfs:label "Behavioural Analytics"@en ;
    rdfs:comment "Behavioural analytics is the security and analytics discipline that establishes baseline patterns of user, device and entity activity and detects meaningful deviations that may indicate threats, fraud or compromise. It applies statistical modelling and machine learning to telemetry such as login times, access sequences and transaction behaviour to surface anomalies that signature-based controls miss. The approach underpins user and entity behaviour analytics (UEBA) within modern security operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        ngm:security ;
    vc:contrastsWith ngm:threat-detection ;
    vc:dependsOn ngm:siem ;
    vc:enables ngm:fraud-detection,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
        ngm:threat-detection ;
    vc:isPartOf ngm:cybersecurity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:intrusion-detection-system ;
    vc:requires ngm:data-collection,
        ngm:monitoring ;
    vc:slug "behavioural-analytics" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:risk-assessment ;
    vc:uses ngm:data-analytics,
        ngm:machine-learning .

ngm:behavioural-economics a owl:Class ;
    rdfs:label "Behavioural Economics"@en ;
    rdfs:comment "Behavioural economics is an interdisciplinary field that integrates insights from cognitive psychology and social science into economic modelling, documenting systematic ways in which human decision-making deviates from the predictions of classical rational-choice theory. It explains phenomena such as loss aversion, anchoring, present bias, and herd behaviour that standard utility maximisation models cannot account for."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cognitive-psychology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounded-rationality ],
        ngm:economics ;
    vc:bridgesTo ngm:algorithmic-recommendation,
        ngm:reinforcement-learning,
        ngm:reward-modelling ;
    vc:contrastsWith ngm:expected-utility-theory,
        ngm:rational-choice-theory ;
    vc:enables ngm:choice-architecture,
        ngm:incentive-alignment,
        ngm:mechanism-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bounded-rationality,
        ngm:loss-aversion,
        ngm:nudge-theory,
        ngm:present-bias,
        ngm:prospect-theory ;
    vc:isPartOf ngm:decision-science ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:behavioral-analytics,
        ngm:contract-theory,
        ngm:development-economics,
        ngm:game-theory,
        ngm:incentive-compatibility ;
    vc:requires ngm:cognitive-psychology,
        ngm:experimental-economics ;
    vc:slug "behavioural-economics" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:behavioral-modeling,
        ngm:heuristic-methods,
        ngm:randomised-controlled-trial .

ngm:benchmark-evaluation a owl:Class ;
    rdfs:label "Benchmark Evaluation"@en ;
    rdfs:comment "Benchmark evaluation is the systematic measurement of a model or system against a standardised dataset and scoring protocol so that results are comparable across systems and over time. A benchmark specifies the task, the data splits, the permitted inputs, and the metrics used to rank performance. In machine learning, benchmark evaluation drives the field's empirical progress, but it is subject to well-known failure modes including train-test contamination, overfitting to leaderboards, and construct validity gaps between the benchmark and the real-world capability it purports to measure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmark-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ground-truth-labels ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evaluation-metric ],
        ngm:model-evaluation ;
    vc:contrastsWith ngm:heuristic-evaluation,
        ngm:human-evaluation ;
    vc:enables ngm:capability-evaluation,
        ngm:leaderboard,
        ngm:model-evaluation-results,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:ai-benchmark-epistemological-critique,
        ngm:benchmark-standard,
        ngm:continuous-integration,
        ngm:evaluation-harness,
        ngm:frontier-model-evaluation ;
    vc:requires ngm:benchmark-dataset,
        ngm:evaluation-metric,
        ngm:ground-truth-labels ;
    vc:slug "benchmark-evaluation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:benchmark-dataset,
        ngm:cross-validation,
        ngm:evaluation-harness,
        ngm:evaluation-metric,
        ngm:performance-benchmarks,
        ngm:statistical-hypothesis-testing .

ngm:carbon-neutral-blockchain a owl:Class ;
    rdfs:label "Carbon Neutral Blockchain"@en ;
    rdfs:comment "Carbon Neutral Blockchain is any distributed ledger infrastructure that achieves net-zero or carbon-negative lifecycle greenhouse gas emissions through one or more of three principal mechanisms: (1) Consensus mechanism transition: Adoption of low-energy Consensus Mechanisms — pre-eminently"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-1-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:renewable-energy-certificates ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:renewable-energy-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:renewable-energy-certificates ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sustainability-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credits ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-offset-programme ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-2-emissions ],
