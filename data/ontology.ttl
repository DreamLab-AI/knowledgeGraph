ngm:sink-mechanism a owl:Class ;
    rdfs:label "Sink Mechanism"@en ;
    rdfs:comment "A Sink Mechanism is an economic design pattern that permanently removes virtual currency, tokens, or items from circulation in order to counterbalance sources of supply and maintain economic equilibrium, preventing hyperinflation in metaverse economies, play-to-earn platforms, and DeFi protocols. Effective sinks are integrated into desirable activities — such as cosmetic purchases, crafting costs, or transaction fees — so that value removal feels voluntary and rewarding to participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economic-mechanism ],
        ngm:bc-defi-and-economics,
        ngm:virtual-economy ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:inflation ;
    vc:enables ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenomics,
        ngm:virtual-economy ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:economic-mechanism,
        ngm:virtual-currency ;
    vc:slug "sink-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:siopv2 a owl:Class ;
    rdfs:label "SIOPv2"@en ;
    rdfs:comment "SIOPv2 (Self-Issued OpenID Provider v2) is an OpenID Foundation specification that extends OpenID Connect so a user's own wallet acts as the identity provider, authenticating with self-issued and decentralised identifiers rather than a third-party server. It lets relying parties verify a subject controls a DID and, paired with OpenID for Verifiable Presentations, accept verifiable credentials. It is a key protocol for decentralised, wallet-centric digital identity."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:distributed-identity ;
    vc:slug "siopv2" ;
    vc:sourceDomain "security" .

