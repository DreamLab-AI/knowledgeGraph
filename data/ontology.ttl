ngm:in-context-learning a owl:Class ;
    rdfs:label "In-Context Learning"@en ;
    rdfs:comment "In-Context Learning (ICL) is a capability of large language models whereby the model adapts its behaviour to a new task at inference time by conditioning on a small number of input-output demonstrations supplied within the prompt, without any gradient-based weight updates. The model implicitly extracts task structure from the provided examples and applies it to unseen queries, enabling rapid task generalisation without retraining."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model-training ],
        ngm:meta-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:few-shot-learning,
        ngm:few-shot-prompting,
        ngm:zero-shot-prompting ;
    vc:requires ngm:large-language-model-training ;
    vc:slug "in-context-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism .

ngm:json-ld-1-1 a owl:Class ;
    rdfs:label "JSON-LD 1.1"@en ;
    rdfs:comment "JSON-LD 1.1 is a W3C Recommendation that extends JSON-LD 1.0 with features including scoped contexts, type-scoped contexts, and propagation control, enabling richer mapping of JSON document terms to IRIs within RDF-based knowledge systems. It provides a framing algorithm for reshaping a flat graph into a tree, and supports compaction and expansion algorithms that allow any conformant document to be normalised to a canonical form. JSON-LD 1.1 underpins interoperable semantic data exchange on the Web and is the serialisation format used by the Verifiable Credentials and Activity Streams standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:ai-technique,
        ngm:semantic-web-standards ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:semantic-web,
        ngm:sparql ;
    vc:requires ngm:rdf ;
    vc:slug "json-ld-1-1" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:json-ld .

ngm:kinematic-model a owl:Class ;
    rdfs:label "KinematicModel"@en ;
    rdfs:comment "A kinematic model is a mathematical abstraction that describes the geometry of a robot's motion by relating joint-space variables (angles and displacements) to the position and orientation of the end-effector in Cartesian space, without accounting for the forces or torques that produce that motion. Forward kinematics maps joint configurations to end-effector poses using homogeneous transformation matrices or Denavit-Hartenberg parameters, whereas inverse kinematics solves the reverse problem of finding joint configurations that achieve a desired pose. Kinematic models are foundational to trajectory generation, motion planning, and simulation in robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:sensor-fusion ;
    vc:requires ngm:forward-kinematics,
        ngm:inverse-kinematics ;
    vc:slug "kinematic-model" ;
    vc:sourceDomain "robotics" .

ngm:know-your-customer a owl:Class ;
    rdfs:label "Know Your Customer"@en ;
    rdfs:comment "Know Your Customer (KYC) is a regulatory and compliance process by which financial institutions and other regulated entities verify the identity of their clients, assess their risk profiles, and understand the nature of their financial activities to prevent money laundering, terrorist financing, and other financial crimes. KYC encompasses identity document verification, biometric checks, beneficial ownership disclosure, and ongoing transaction monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-verification ],
        ngm:compliance ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:anti-money-laundering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:digital-identity,
        ngm:financial-regulation ;
    vc:requires ngm:biometric-verification,
        ngm:digital-identity-verification ;
    vc:slug "know-your-customer" ;
    vc:sourceDomain "finance" .

ngm:latency-aware-edge-ai a owl:Class ;
    rdfs:label "Latency-Aware Edge AI"@en ;
    rdfs:comment "Latency-Aware Edge AI is a design paradigm for machine learning systems deployed at the network edge that dynamically adapts inference strategies, model selection, and compute offloading decisions to satisfy hard or soft real-time response-time deadlines. Such systems continuously monitor available time budgets, device load, and network conditions, trading accuracy for speed when necessary to maintain service-level objectives. Applications span autonomous vehicles, mobile augmented reality, and industrial robotics, where missed deadlines carry safety or quality consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:gpu-compute ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:computer-vision,
        ngm:edge-ai-system ;
    vc:requires ngm:edge-computing,
        ngm:inference-hardware ;
    vc:slug "latency-aware-edge-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:edge-ai-accelerators,
        ngm:inference .

ngm:latency-management-protocol a owl:Class ;
    rdfs:label "Latency Management Protocol"@en ;
    rdfs:comment "A systematic process for monitoring, measuring, and minimizing network delay in interactive metaverse sessions through adaptive techniques including traffic prioritization, predictive buffering, and dynamic routing optimization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-performance-metrics ],
