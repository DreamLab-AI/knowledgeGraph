        ngm:perception-system ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:robotics-perception,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:object-recognition ;
    vc:enables ngm:augmented-reality,
