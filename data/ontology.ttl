    vc:sourceDomain "standards" .

ngm:jax a owl:Class ;
    rdfs:label "JAX"@en ;
    rdfs:comment "A Python library from Google for high-performance numerical computing and machine learning research, combining NumPy-style array operations with automatic differentiation and just-in-time compilation targeting CPUs, GPUs, and TPUs via the XLA compiler."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        ngm:deep-learning ;
    vc:bridgesTo ngm:high-performance-computing ;
    vc:contrastsWith ngm:py-torch,
        ngm:tensorflow ;
    vc:enables ngm:backpropagation,
        ngm:functional-programming,
        ngm:just-in-time-compilation,
        ngm:large-scale-model-training,
        ngm:vectorised-computation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:flax,
        ngm:haiku ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:numerical-computing ;
    vc:requires ngm:automatic-differentiation,
