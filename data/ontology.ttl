ngm:service-layer a owl:Class ;
    rdfs:label "Service Layer"@en ;
    rdfs:comment "Collection of reusable services exposed via APIs for identity, assets, physics, and analytics that enable application functionality and interoperability in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:sc-platform-and-environment,
        ngm:spatial-computing ;
    skos:broader ngm:sc-platform-and-environment,
        ngm:spatial-computing ;
    vc:enables ngm:api-integration,
        ngm:microservices-architecture,
        ngm:service-composition,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analytics-service,
        ngm:api-gateway,
        ngm:asset-service,
        ngm:identity-service,
        ngm:physics-service ;
    vc:isPartOf ngm:data-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:api-management,
        ngm:data-models,
        ngm:service-orchestration ;
    vc:slug "service-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:service-robot a owl:Class ;
    rdfs:label "Service Robot"@en ;
    rdfs:comment "A Service Robot is an autonomous or semi-autonomous robotic system designed to perform tasks for humans in non-industrial settings such as healthcare, logistics, hospitality, and domestic environments. Unlike fixed industrial robots, service robots operate in dynamic, unstructured spaces and must navigate safely around people, relying on sensor fusion, motion planning, and human-robot interaction capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:robot-control ;
    vc:requires ngm:motion-planning,
        ngm:sensor-fusion ;
    vc:slug "service-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-robot,
        ngm:computer-vision .

ngm:session-key a owl:Class ;
    rdfs:label "Session Key"@en ;
    rdfs:comment "A session key is a temporary symmetric cryptographic key generated for the duration of a single communication session, used to encrypt the data exchanged between parties after an initial key exchange handshake. Session keys have bounded lifetimes and are discarded at the end of the session, limiting the window of vulnerability if the key is compromised. Ephemeral session keys derived from asymmetric key exchanges (such as Diffie-Hellman) provide forward secrecy, ensuring past sessions remain private even if long-term private keys are later exposed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:cryptography ;
    vc:bridgesTo ngm:externally-owned-account ;
    vc:contrastsWith ngm:biometric-data ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:access-control,
        ngm:session-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:encryption,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-identity,
        ngm:distributed-ledger ;
    vc:requires ngm:digital-identity,
        ngm:encryption ;
    vc:slug "session-key" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:policy-information-point,
        ngm:privacy ;
    vc:uses ngm:public-key-cryptography,
        ngm:security .

ngm:shap a owl:Class ;
    rdfs:label "SHAP"@en ;
    rdfs:comment "SHAP, short for SHapley Additive exPlanations, is a method for explaining the output of machine-learning models by attributing each prediction to its input features. It is grounded in Shapley values from cooperative game theory, which fairly distribute a payoff among contributors, treating each feature as a player and the prediction as the payoff. SHAP provides locally accurate, consistent feature attributions and unifies several earlier explanation techniques under a common framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cooperative-game-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:explainable-ai ;
    vc:bridgesTo ngm:data-governance,
        ngm:fairness-in-machine-learning ;
    vc:contrastsWith ngm:feature-importance,
        ngm:integrated-gradients,
        ngm:lime ;
    vc:enables ngm:algorithmic-auditing,
        ngm:feature-attribution,
        ngm:feature-importance,
        ngm:model-debugging,
        ngm:model-interpretability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:feature-attribution ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feature-importance,
        ngm:gradient-boosted-trees ;
    vc:requires ngm:cooperative-game-theory,
        ngm:machine-learning-discipline-model,
        ngm:shapley-value ;
    vc:slug "shap" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:human-in-the-loop,
        ngm:regulatory-compliance,
        ngm:responsible-ai ;
    vc:uses ngm:deep-neural-network .

ngm:spatial-tracking a owl:Class ;
    rdfs:label "Spatial Tracking"@en ;
    rdfs:comment "Technology that determines the position and orientation of objects in three-dimensional space using six degrees of freedom (6DoF), enabling precise tracking of headsets, controllers, and body movements through inside-out or outside-in sensor configurations."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-tracking" ;
    vc:sourceDomain "spatial-computing" .

ngm:stakeholder-trust a owl:Class ;
    rdfs:label "Stakeholder Trust"@en ;
    rdfs:comment "Stakeholder trust is the confident reliance that individuals, groups, or organisations — including users, operators, regulators, and affected communities — place in a system, institution, or technology to behave reliably, safely, and in accordance with stated values. In the context of AI and automated systems, stakeholder trust encompasses both calculative assessments of technical competence and affective judgements about integrity and ethical alignment, and is recognised as a prerequisite for adoption, legitimate deployment, and effective governance. It must be earned through demonstrated performance, transparency, and accountability rather than assumed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:auditability ],
        ngm:trust ;
    vc:bridgesTo ngm:decentralised-governance,
        ngm:digital-identity ;
    vc:contrastsWith ngm:algorithmic-bias,
        ngm:automation-bias ;
    vc:dependsOn ngm:algorithmic-accountability ;
    vc:enables ngm:ai-governance,
        ngm:human-ai-collaboration,
        ngm:technology-adoption,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:legitimacy,
        ngm:reputational-risk,
        ngm:stakeholder,
        ngm:stakeholder-engagement,
        ngm:trust-framework ;
    vc:requires ngm:auditability,
        ngm:explainability,
        ngm:fairness,
        ngm:transparency ;
    vc:slug "stakeholder-trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:ai-ethics,
        ngm:regulatory-compliance,
        ngm:trust-and-safety .

ngm:standards-compliance a owl:Class ;
    rdfs:label "Standards Compliance"@en ;
    rdfs:comment "The process of ensuring that systems, processes, products, or services meet the requirements of established technical standards, industry specifications, regulatory frameworks, and governance policies applicable to metaverse and virtual world technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:standards ;
    vc:enables ngm:audit-trail,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compliance-framework,
        ngm:regulatory-framework ;
    vc:slug "standards-compliance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compliance-monitoring,
        ngm:compliance-verification .

ngm:standards-documentation a owl:Class ;
    rdfs:label "Standards Documentation"@en ;
    rdfs:comment "Established guidelines, rules, and best practices that govern the creation of technical documentation, including structure, formatting conventions, terminology usage, delivery methods, and presentation to ensure consistency, clarity, and accuracy across all content. Standards documentation underpins interoperability, regulatory compliance, and knowledge transfer in technical domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standard ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:standards-conformance,
        ngm:standards-validation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:standards-body ;
    vc:requires ngm:technical-standard ;
    vc:slug "standards-documentation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:interoperability,
        ngm:standards-compliance .

ngm:stochastic-processes a owl:Class ;
    rdfs:label "Stochastic Processes"@en ;
    rdfs:comment "A stochastic process is a collection of random variables indexed by time or another parameter, used to model systems that evolve with randomness. Examples include random walks, Markov chains, Poisson processes and Brownian motion, each characterised by how its future behaviour depends on its present and past states. Stochastic processes are foundational in probability theory and are applied across physics, biology, queueing theory and quantitative finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        ngm:probability-theory ;
    vc:bridgesTo ngm:diffusion-models,
        ngm:machine-learning,
        ngm:statistical-mechanics ;
    vc:contrastsWith ngm:chaos-theory ;
    vc:dependsOn ngm:filtration,
        ngm:sigma-algebra ;
    vc:enables ngm:bayesian-inference,
        ngm:quantitative-finance,
        ngm:queueing-theory,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:brownian-motion,
        ngm:markov-chain,
        ngm:martingale,
        ngm:poisson-process,
        ngm:random-walk ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ergodic-theory,
        ngm:gaussian-process ;
    vc:requires ngm:measure-theory,
        ngm:probability-theory ;
    vc:slug "stochastic-processes" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:markov-decision-process,
        ngm:monte-carlo-methods,
        ngm:time-series-analysis .

ngm:streaming-payments a owl:Class ;
    rdfs:label "Streaming Payments"@en ;
    rdfs:comment "Streaming payments are a payment model in which value flows continuously from payer to payee in real time, accruing per second or per block rather than in discrete lump sums. On programmable ledgers and payment channels this is implemented by smart contracts or channel updates that let a recipient withdraw the proportion earned at any moment. The model suits salaries, subscriptions, rentals, and machine-to-machine billing where settlement should track elapsed time or usage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:programmable-money ;
    vc:bridgesTo ngm:payment-channel ;
    vc:dependsOn ngm:smart-contract ;
    vc:enables ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:programmable-money ;
    vc:isPartOf ngm:programmable-money ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:lightning-network,
        ngm:sablier,
        ngm:superfluid ;
    vc:requires ngm:payment-channel,
        ngm:smart-contract ;
    vc:slug "streaming-payments" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:micropayment ;
    vc:uses ngm:payment-channel,
        ngm:smart-contract,
        ngm:stablecoin .

ngm:surrogate-model a owl:Class ;
    rdfs:label "Surrogate Model"@en ;
    rdfs:comment "A surrogate model (or metamodel) is an inexpensive, data-driven approximation of an expensive-to-evaluate function, simulation or experiment, used to predict outcomes without running the full computation. It is fitted to a sample of evaluations and then queried cheaply to explore the design space, drive optimisation or quantify uncertainty. Surrogate models are central to Bayesian optimisation, where a Gaussian process guides where to evaluate next."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:machine-learning ;
    vc:contrastsWith ngm:simulation ;
    vc:enables ngm:optimisation,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:regression ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gaussian-process,
        ngm:hyperparameter-optimisation ;
    vc:requires ngm:feature-engineering ;
    vc:slug "surrogate-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:bayesian-optimisation,
        ngm:hyperparameter-optimisation ;
    vc:uses ngm:gaussian-process,
        ngm:regression,
        ngm:supervised-learning .

ngm:systems-theory a owl:Class ;
    rdfs:label "Systems Theory"@en ;
    rdfs:comment "Systems theory is an interdisciplinary study of systems as sets of interrelated components, focusing on the relationships, feedback, and emergent behaviour that arise from interaction."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "systems-theory" ;
    vc:sourceDomain "infrastructure" .

ngm:task-automation a owl:Class ;
    rdfs:label "Task Automation"@en ;
    rdfs:comment "The automation of individual, often repetitive tasks so that they run without manual effort. It addresses discrete actions rather than coordinating entire business processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automation ],
        ngm:automation ;
    vc:enables ngm:business-process-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automation ;
    vc:slug "task-automation" ;
    vc:sourceDomain "robotics" .

ngm:tcp a owl:Class ;
    rdfs:label "TCP"@en ;
    rdfs:comment "The Transmission Control Protocol (TCP) is a connection-oriented transport-layer protocol that provides reliable, ordered, and error-checked delivery of a byte stream between applications over an IP network. It establishes connections via a three-way handshake, segments data, acknowledges receipt, retransmits lost segments, and applies flow and congestion control to share network capacity fairly. TCP is one of the core protocols of the Internet protocol suite, underlying most application protocols that demand reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-protocol ],
        ngm:network-transport ;
    vc:contrastsWith ngm:udp ;
    vc:enables ngm:client-server-architecture,
        ngm:http,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:reliability ;
    vc:isPartOf ngm:osi-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-layer,
        ngm:network-protocol ;
    vc:requires ngm:internet-protocol,
        ngm:network-transport ;
    vc:slug "tcp" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:tls ;
    vc:uses ngm:congestion-control,
        ngm:packet-switching .

ngm:technology-infrastructure-domain-architecture a owl:Class ;
    rdfs:label "Infrastructure Architecture"@en ;
    rdfs:comment "The foundational technical framework supporting metaverse platforms, comprising cloud computing, edge networks, distributed systems, and computing power networks that enable scalable, low-latency delivery of immersive virtual experiences."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:technical-architecture ;
    vc:enables ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrastructure-architecture" ;
    vc:sourceDomain "infrastructure" .

ngm:temporal-logic a owl:Class ;
    rdfs:label "Temporal Logic"@en ;
    rdfs:comment "Temporal logic is a formal system of logic that extends classical propositional or predicate logic with operators for reasoning about propositions whose truth changes over time. Operators such as 'eventually', 'always', 'next' and 'until' allow the specification of orderings and timing of events without explicit reference to clock values. It is the standard language for stating correctness properties of reactive and concurrent systems in formal verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-space ],
        ngm:logic ;
    vc:contrastsWith ngm:state-space ;
    vc:dependsOn ngm:logic ;
    vc:enables ngm:formal-verification,
        ngm:model-checking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:state-space ;
    vc:implements ngm:formal-methods ;
    vc:isPartOf ngm:formal-methods,
        ngm:logic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:formal-methods,
        ngm:formal-verification ;
    vc:requires ngm:logic ;
    vc:slug "temporal-logic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:concurrency,
        ngm:model-checking ;
    vc:uses ngm:logic,
        ngm:state-space .

ngm:test-driven-development a owl:Class ;
    rdfs:label "Test-Driven Development"@en ;
    rdfs:comment "Test-driven development is a software practice in which developers write an automated test that defines a desired behaviour before writing the code to satisfy it, then refactor once the test passes. This red-green-refactor cycle drives design from the perspective of usage and ensures that every feature is covered by tests as it is built. The discipline tends to produce modular, well-specified code and a comprehensive regression suite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-assurance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:software-testing ;
    vc:contrastsWith ngm:software-architecture ;
    vc:dependsOn ngm:agile-software-development ;
    vc:enables ngm:continuous-delivery,
        ngm:software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:extreme-programming ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:quality-assurance,
        ngm:software-engineering ;
    vc:requires ngm:quality-assurance,
        ngm:software-testing ;
    vc:slug "test-driven-development" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:devops,
        ngm:software-development ;
    vc:uses ngm:code-review,
        ngm:continuous-integration .

ngm:threat-actor a owl:Class ;
    rdfs:label "Threat Actor"@en ;
    rdfs:comment "A Threat Actor is an individual, organised group, or nation-state entity that possesses the intent, capability, and opportunity to exploit vulnerabilities in digital systems. Actors are classified by motivation (financial, ideological, strategic, personal) and sophistication tier (opportunistic script-kiddies through state-sponsored APTs), with attribution performed via TTPs, infrastructure patterns, and targeting behaviour."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:resilience,
        ngm:security ;
    vc:enables ngm:security-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:risk ;
    vc:slug "threat-actor" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:attack-vector,
        ngm:vulnerability .

