    vc:qualityScore "0.95"^^xsd:float ;
    vc:relatedTo ngm:beam-search-decoding,
        ngm:constrained-decoding,
        ngm:exposure-bias,
        ngm:inference-time-compute,
        ngm:process-reward-model,
        ngm:speculative-decoding,
        ngm:viterbi-algorithm ;
    vc:requires ngm:autoregressive-model,
        ngm:probability-distribution,
        ngm:sequence-model ;
    vc:slug "beam-search" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:encoder-decoder-architecture,
        ngm:heuristic-methods,
