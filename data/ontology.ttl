ngm:servo-control a owl:Class ;
    rdfs:label "Servo Control"@en ;
    rdfs:comment "Servo Control is a closed-loop control methodology that uses feedback signals — typically from encoders or resolvers — to precisely regulate the position, velocity, or torque of an actuator. A servo controller computes the error between a desired setpoint and the measured output, then drives a servo motor or hydraulic actuator to minimise that error, making servo control foundational to high-precision robotic joint control, CNC machining, and collaborative robot safety systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:closed-loop-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:safety-plc ;
    vc:requires ngm:actuator,
        ngm:closed-loop-control ;
    vc:slug "servo-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller,
        ngm:servo-motor .

ngm:session-manager a owl:Class ;
    rdfs:label "Session Manager"@en ;
    rdfs:comment "A Session Manager is a software component responsible for creating, maintaining, tracking, and terminating user or application sessions within a computing system, ensuring that stateful context is preserved across multiple interactions or network requests. It issues session tokens or identifiers, enforces timeout and expiry policies, replicates session state for high-availability scenarios, and integrates with authentication services to verify that sessions remain bound to authenticated principals. Session managers are critical security components: misconfigurations can lead to session fixation, hijacking, or replay attacks. In distributed architectures they must handle session affinity, cross-node replication, and graceful failover without exposing stale state."@en ;
    rdfs:subClassOf ngm:middleware ;
    vc:enables ngm:api-gateway,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:data-persistence,
        ngm:distributed-system,
        ngm:middleware-layer,
        ngm:state-machine ;
    vc:slug "session-manager" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:authentication-service,
        ngm:state-management,
        ngm:web-socket-protocol .

ngm:settlement-layer a owl:Class ;
    rdfs:label "Settlement Layer"@en ;
    rdfs:comment "The Settlement Layer is the stratum that achieves final, irreversible transfer of value or state between parties. In layered ledger systems it sits beneath faster execution and netting strata and above the Consensus Layer that secures finality. It contains the records, accounts, and finality conditions under which obligations are discharged."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-layer ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:lightning-network-layer,
        ngm:smart-contract-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:consensus-layer ;
    vc:slug "settlement-layer" ;
    vc:sourceDomain "blockchain" .

ngm:social-choice-theory a owl:Class ;
    rdfs:label "Social Choice Theory"@en ;
    rdfs:comment "Social choice theory is the formal study of how individual preferences can be aggregated into a collective decision, examining the properties, fairness, and impossibility constraints of voting rules and welfare functions. Foundational results such as Arrow's impossibility theorem show that no rank-aggregation rule can simultaneously satisfy a small set of seemingly reasonable fairness axioms. It provides the theoretical underpinning for voting mechanism design in both political and digital governance systems."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:governance ;
    vc:slug "social-choice-theory" ;
    vc:sourceDomain "governance" .

ngm:sparql-endpoint a owl:Class ;
    rdfs:label "SPARQL Endpoint"@en ;
    rdfs:comment "A SPARQL Endpoint is a network-accessible service that accepts SPARQL Protocol and RDF Query Language queries and returns structured results over HTTP, enabling federated access to RDF knowledge graphs and linked data stores. It acts as the primary interface between client applications and triple stores, supporting SELECT, CONSTRUCT, ASK, and UPDATE operations. SPARQL Endpoints are foundational to the Semantic Web stack and to provenance-aware knowledge graph systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparql-query-engine ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:data-access-interface ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data,
        ngm:provenance-ontology-prov-o ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:query-processor,
        ngm:sparql-query-engine ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:database-query,
        ngm:graph-database,
        ngm:knowledge-representation,
        ngm:semantic-web-linked-data-standard,
        ngm:sparql-examples ;
    vc:slug "sparql-endpoint" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:rdf,
        ngm:sparql .

ngm:spatial-index a owl:Class ;
    rdfs:label "Spatial Index"@en ;
    rdfs:comment "Data structure optimized for efficient storage, retrieval, and querying of 3D spatial objects within virtual worlds using hierarchical geometric partitioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:spatial-data-structure ;
    vc:enables ngm:collision-detection,
        ngm:fast-spatial-queries,
        ngm:level-of-detail-selection,
