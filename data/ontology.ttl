    vc:relatedTo ngm:federated-learning,
        ngm:transfer-learning ;
    vc:slug "unsupervised-learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:variational-autoencoders a owl:Class ;
    rdfs:label "Variational Autoencoders"@en ;
    rdfs:comment "Generative neural network architecture combining autoencoders with variational inference, learning a probabilistic latent space via an encoder that outputs distribution parameters and a decoder that reconstructs data by sampling from that distribution. Trained by maximising the Evidence Lower BOund (ELBO), which balances reconstruction fidelity and KL-divergence regularisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        ngm:ai-model-architecture,
        ngm:generative-model ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:embedding-model,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder,
        ngm:encoder ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autoencoder,
        ngm:deep-generative-model,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:latent-diffusion,
        ngm:vae ;
    vc:slug "variational-autoencoders" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bayesian-inference,
        ngm:neural-network,
        ngm:variational-inference .

ngm:virtual-production-workflow a owl:Class ;
    rdfs:label "Virtual Production Workflow"@en ;
    rdfs:comment "The end-to-end process for creating film and television content using virtual production techniques, integrating pre-visualisation, virtual art department asset creation, real-time game engine rendering, LED volume shooting, and post-production refinement in a non-linear pipeline where VFX work begins in pre-production rather than post-production. This approach captures composited digital environments in-camera, enabling creative decisions about lighting and framing to be made on set."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:production-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:film-production,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse ;
    vc:requires ngm:3-d-asset,
        ngm:3-d-rendering-engine,
        ngm:game-engine ;
    vc:slug "virtual-production-workflow" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-production-workflow,
        ngm:design-software .

ngm:whole-body-control a owl:Class ;
    rdfs:label "Whole Body Control"@en ;
    rdfs:comment "Whole Body Control (WBC) is a control framework for legged and humanoid robots that simultaneously optimises motion tasks, contact forces, and balance constraints across all degrees of freedom by solving a hierarchical quadratic programme or weighted task-space objective at each control cycle. By treating locomotion, manipulation, and postural balance as a unified optimisation problem, WBC avoids the sub-optimality of treating these objectives separately. It typically relies on a rigid-body dynamics model and is often combined with model predictive control or reinforcement learning policies for online adaptation to uneven terrain and external disturbances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-identification ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:humanoid-robot,
        ngm:legged-locomotion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-predictive-control,
        ngm:reinforcement-learning ;
    vc:requires ngm:inverse-kinematics,
        ngm:system-identification ;
    vc:slug "whole-body-control" ;
    vc:sourceDomain "robotics" .

ngmi:gemini a owl:NamedIndividual,
        ngm:multimodal-ai ;
    rdfs:label "Gemini"@en ;
    rdfs:comment "Gemini is Google DeepMind's family of natively multimodal large language models, announced in December 2023 as the successor to PaLM 2, designed from the ground up to reason across text, images, audio, video, and code within a single unified architecture. The Gemini family spans Ultra, Pro, Flash, and Nano capability tiers, enabling deployment from data-centre scale to on-device inference. It directly competes with OpenAI's GPT-4 family and Anthropic Claude as one of the three dominant frontier model lineages."@en ;
    vc:contrastsWith ngmi:anthropic-claude,
        ngmi:chat-gpt ;
    vc:dependsOn ngm:cloud-platform,
        ngm:high-performance-computing ;
    vc:enables ngm:agentic-workflow,
        ngm:generative-ai,
        ngm:multimodal-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngmi:anthropic-claude,
        ngmi:chat-gpt ;
    vc:slug "gemini" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:evaluation-metric ;
    vc:uses ngm:fine-tuning,
        ngm:multimodal-understanding,
        ngm:transformer .

ngm:adam-optimiser a owl:Class ;
    rdfs:label "Adam Optimiser"@en ;
    rdfs:comment "The Adam optimiser (Adaptive Moment Estimation) is a first-order gradient-based optimisation algorithm that maintains exponentially decaying moving averages of both past gradients (first moment) and past squared gradients (second moment) to compute per-parameter adaptive learning rates. It combines the advantages of momentum-based optimisation and the RMSProp algorithm, making it robust to sparse gradients and non-stationary objectives. Adam is the de-facto default optimiser for training transformer-based large language models and deep neural networks across most domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:loss-function ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent ;
    vc:slug "adam-optimiser" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An autonomous computational or physical entity that perceives its environment, reasons about its perceptions using internal beliefs and goals, and acts to achieve specified objectives—exhibiting autonomy, reactivity, proactivity, and social ability across AI, blockchain, robotics, and metaverse domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
