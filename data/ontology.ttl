ngm:user-experience-layer a owl:Class ;
    rdfs:comment "The User Experience Layer is the topmost human-facing stratum concerned with how effective, accessible, and satisfying interaction with a system is. It sits above the Presentation Layer that renders the interface and has no technical layer above it. It contains interaction design, usability criteria, accessibility requirements, and user research findings."@en ;
    rdfs:label "User Experience Layer"@en ;
    rdfs:subClassOf ngm:owl-thing ;
