    vc:enables ngm:incident-response,
        ngm:security-governance,
        ngm:supply-chain-risk-management,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cybersecurity-framework-core,
        ngm:cybersecurity-framework-govern-function,
        ngm:cybersecurity-framework-profile,
        ngm:cybersecurity-framework-tiers ;
    vc:implements ngm:cybersecurity-risk-management ;
    vc:isPartOf ngm:nist-special-publications ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:critical-infrastructure-protection,
        ngm:nist,
        ngm:zero-trust-architecture ;
