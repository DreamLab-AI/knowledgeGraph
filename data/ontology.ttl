ngm:weight-decay a owl:Class ;
    rdfs:comment "A regularisation technique that adds a penalty proportional to the L2 norm of model weights to the loss function, discouraging large weight magnitudes and thereby limiting model complexity. Weight decay prevents overfitting, promotes simpler generalisable solutions, and in optimisers such as AdamW is implemented directly in the weight update step rather than via loss augmentation."@en ;
    rdfs:label "Weight Decay"@en ;
    rdfs:subClassOf ngm:ai-technique ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    skos:broader ngm:ai-technique ;
