        ngm:variance-component ;
    vc:implements ngm:bootstrap,
        ngm:cross-validation,
        ngm:holdout-method,
        ngm:k-fold,
        ngm:loocv,
        ngm:stratified-sampling ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:benign-overfitting,
