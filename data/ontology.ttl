# Sovereign Keyset
blockchain:SovereignKeyset rdf:type owl:Class ;
    rdfs:label "Sovereign Keyset"@en ;
    rdfs:comment "The cryptographic key material (BIP-340 Schnorr Keypair) held securely by each VisionClaw Agentic Container, used to prove identity via DID Nostr Identity DIDs, sign Verifiable Credential Surface, authenticate Nostr Relay messages, and establish Trustless Peer Communication without delegating key management to a central authority."@en ;
