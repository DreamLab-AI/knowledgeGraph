ngm:self-improvement a owl:Class ;
    rdfs:label "Self Improvement"@en ;
    rdfs:comment "The capacity of an AI system to autonomously modify its own architecture, weights, or learning algorithms to improve performance, generality, or efficiency without direct human intervention. Central to recursive self-improvement scenarios and AI safety research, raising fundamental questions about capability control, value alignment, and the conditions under which iterative self-modification remains aligned with intended objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:curriculum-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:ai-safety-research,
        ngm:artificial-general-intelligence,
        ngm:recursive-self-improvement,
        ngm:reinforcement-learning,
        ngm:value-alignment ;
    vc:requires ngm:machine-learning-discipline ;
    vc:slug "self-improvement" ;
    vc:sourceDomain "artificial-intelligence" .

