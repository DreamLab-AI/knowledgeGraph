    rdfs:label "Rigid Body Mechanics"@en .

ngm:risk-analysis a skos:Concept ;
    rdfs:label "Risk Analysis"@en .

ngm:risk-assessment-engine a owl:Class ;
    rdfs:label "Risk Assessment Engine"@en ;
    rdfs:comment "A risk assessment engine is a software component that automatically evaluates the risk associated with transactions, shipments, or entities by applying rules, statistical models, or machine learning to available data. In customs and trade systems it scores consignments to prioritise inspection while expediting low-risk flows. It enables consistent, scalable, and auditable risk-based decision making."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
