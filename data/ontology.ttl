    vc:uses ngm:code-generation,
        ngm:large-language-models,
        ngm:text-generation,
        ngm:transformer .

ngm:ed25519 a owl:Class ;
    rdfs:label "Ed25519"@en ;
    rdfs:comment "Ed25519 is a high-performance elliptic-curve digital signature scheme instantiated on the Twisted Edwards curve over the prime field GF(2^255-19), offering approximately 128 bits of security with deterministic signing and compact 64-byte signatures. Designed by Bernstein et al., it is engineered to resist side-channel attacks through constant-time implementation properties and avoids the weak-nonce vulnerabilities that affect ECDSA. Ed25519 is standardised in RFC 8032 and is widely deployed across blockchain networks, SSH authentication (OpenSSH), and decentralised identity systems."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:private-key ;
    vc:slug "ed25519" ;
    vc:sourceDomain "blockchain" .

ngm:edge-ai a owl:Class ;
    rdfs:label "Edge AI"@en ;
    rdfs:comment "Edge AI is the deployment and execution of artificial intelligence inference workloads directly on edge devices—such as smartphones, IoT sensors, cameras, and embedded systems—close to the data source, rather than in centralised cloud data centres. It reduces latency, preserves data privacy, enables offline operation, and cuts bandwidth and cloud compute costs by processing data locally using optimised neural network models and dedicated hardware accelerators."@en ;
    rdfs:subClassOf ngm:edge-computing ;
    vc:enables ngm:io-t-ai-integration,
        ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-emerging ;
