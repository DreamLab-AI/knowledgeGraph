    vc:sourceDomain "artificial-intelligence" .

ngm:the-secret-cyborg-problem a owl:Class ;
    rdfs:label "The Secret Cyborg Problem"@en ;
    rdfs:comment "The Secret Cyborg Problem describes the widespread but concealed practice of workers integrating AI tools into professional workflows without disclosure to employers or colleagues, creating risks around data governance, accountability, and skills assessment. Research indicates approximately 78% of AI-using knowledge workers employ tools covertly, undermining organisational AI adoption strategies and responsible-use frameworks."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:ai-governance,
        ngm:trust-in-automation ;
    vc:enables ngm:workforce-augmentation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-adoption,
        ngm:ai-ethics,
        ngm:generative-ai ;
    vc:slug "the-secret-cyborg-problem" ;
    vc:sourceDomain "infrastructure" .

ngm:third-party-vulnerability a owl:Class ;
    rdfs:label "Third-Party Vulnerability"@en ;
    rdfs:comment "A Third-Party Vulnerability is a security weakness originating in externally sourced software components, libraries, APIs, or services that are integrated into an AI system, creating risk vectors outside the direct control of the system developer or operator. Exploitation of these vulnerabilities can compromise model integrity, data confidentiality, or system availability."@en ;
