ngm:aleo a owl:Class ;
    rdfs:label "Aleo"@en ;
    rdfs:comment "Aleo is a blockchain platform designed for private applications using zero-knowledge proofs to keep transaction data confidential while remaining verifiable. Programs are written in its Leo language."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:zero-knowledge-proof ;
    vc:enables ngm:privacy,
        ngm:pseudonymity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography,
        ngm:zero-knowledge-proof ;
    vc:slug "aleo" ;
    vc:sourceDomain "blockchain" .

