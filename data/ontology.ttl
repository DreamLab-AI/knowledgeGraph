        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-resources ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experiences,
        ngm:user-interface-rendering,
        ngm:visual-output ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:display-manager,
        ngm:graphics-pipeline,
        ngm:rendering-engine,
        ngm:shader-system ;
    vc:isPartOf ngm:presentation-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:display-hardware,
        ngm:gpu-resources,
        ngm:graphics-api ;
    vc:slug "visualization-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:vocabulary-services a owl:Class ;
    rdfs:label "Vocabulary Services"@en ;
    rdfs:comment "Technical infrastructure and APIs that provide programmatic access to controlled vocabularies, taxonomies, and ontologies, enabling applications to retrieve concept definitions, navigate broader/narrower hierarchies, validate terminology, and perform cross-vocabulary mapping for consistent semantic interpretation across platforms. Common interfaces include SPARQL endpoints, SKOS APIs, and REST services backed by platforms such as PoolParty or Metaphactory."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:knowledge-management ;
