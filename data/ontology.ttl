    owl:someValuesFrom mv:UserEngagement
] .

mv:PersonalizedVirtualExperiences rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:AIPersonalization
] .

mv:PersonalizedVirtualExperiences rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:AvatarCustomization
] .

mv:PersonalizedVirtualExperiences rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ContentRecommendation
] .

# Physical Hardware
mv:PhysicalHardware a owl:Class ;
    rdfs:subClassOf mv:Hardware ;
    rdfs:label "Physical Hardware"@en ;
    rdfs:comment "The tangible computing devices and peripherals required for metaverse and XR experiences, including VR headsets, AR glasses, haptic devices, motion controllers, and supporting infrastructure like GPUs and networking equipment."@en ;
    skos:prefLabel "Physical Hardware"@en ;
    dcterms:identifier "MV-10005" ;
    dcterms:subject "mv" .

mv:PhysicalHardware rdfs:subClassOf [
