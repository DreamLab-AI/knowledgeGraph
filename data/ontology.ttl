ngm:security-framework a owl:Class ;
    rdfs:label "Security Framework"@en ;
    rdfs:comment "A Security Framework is a structured, normative system of policies, controls, standards, and procedural guidelines that an organisation applies to protect digital assets, information systems, and users from adversarial threats and accidental harm. It integrates risk management principles with technical controls across identity, access, cryptography, monitoring, and incident response to establish a cohesive defence posture. Widely adopted frameworks such as NIST CSF, ISO/IEC 27001, and CIS Controls provide systematic vocabularies for assessing security maturity and aligning investment with threat landscape. In emergent domains such as spatial computing, decentralised infrastructure, and AI-mediated platforms, security frameworks extend to cover smart-contract auditing, decentralised identity, privacy-preserving computation, and supply-chain integrity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:ai-safety,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:perimeter-security ;
    vc:enables ngm:data-governance,
        ngm:regulatory-compliance,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:access-control,
        ngm:audit-logging,
        ngm:incident-response,
        ngm:risk-management ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cyber-resilience,
        ngm:penetration-testing,
        ngm:security-operations-centre ;
    vc:requires ngm:authentication,
        ngm:cryptography,
        ngm:threat-modelling,
        ngm:vulnerability-management ;
    vc:slug "security-framework" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:cis-controls,
        ngm:iso-iec-27001,
        ngm:nist-cybersecurity-framework ;
    vc:supports ngm:digital-identity,
        ngm:privacy-preserving-technology,
        ngm:supply-chain-security .

ngm:spatial-data-structure a owl:Class ;
    rdfs:label "Spatial Data Structure"@en ;
    rdfs:comment "A Spatial Data Structure is a data organisation scheme that partitions, indexes, or hierarchically organises geometric, geographic, or positional information to enable efficient queries over proximity, containment, intersection, and visibility. Classical families include space-partitioning trees (k-d trees, octrees, BSP trees, quadtrees), bounding-volume hierarchies (BVH), and spatial hash grids, each offering distinct trade-offs between construction cost, query throughput, memory footprint, and support for dynamic updates. These structures underpin performance-critical systems including real-time 3-D rendering, physics simulation, geographic information systems (GIS), robotics path planning, and spatial databases. The choice of structure is governed by data dimensionality, scene dynamism, query distribution, and hardware parallelism constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:octree-spatial-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:data-structure ;
    vc:bridgesTo ngm:spatial-ai ;
    vc:contrastsWith ngm:uniform-grid ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:nearest-neighbor-search,
        ngm:path-planning,
        ngm:ray-tracing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy,
        ngm:bsp-tree,
        ngm:octree-spatial-index,
        ngm:quadtree ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computational-geometry,
        ngm:level-of-detail,
        ngm:spatial-mapping ;
    vc:requires ngm:spatial-index ;
    vc:slug "spatial-data-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:geographic-information-system,
        ngm:physics-simulation,
        ngm:point-cloud-processing,
        ngm:spatial-database ;
    vc:uses ngm:bounding-volume,
        ngm:scene-graph .

ngm:statistical-inference a owl:Class ;
    rdfs:label "Statistical Inference"@en ;
    rdfs:comment "Statistical inference is the process of drawing conclusions about a population or data-generating process from a finite sample, while quantifying the uncertainty of those conclusions. It encompasses estimation of parameters, hypothesis testing and prediction, grounded in probability theory. Both frequentist and Bayesian frameworks provide formal machinery for reasoning under sampling variability, underpinning model evaluation in machine learning."@en ;
    rdfs:subClassOf ngm:statistics ;
    vc:bridgesTo ngm:bayesian-inference,
        ngm:machine-learning ;
    vc:dependsOn ngm:sampling ;
    vc:enables ngm:data-analysis,
        ngm:inference,
        ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:statistics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:evaluation-metric,
        ngm:statistical-modelling,
        ngm:supervised-learning ;
    vc:slug "statistical-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-training ;
    vc:uses ngm:probability-theory,
        ngm:regression,
        ngm:sampling .

ngm:sustainable-development a owl:Class ;
    rdfs:label "Sustainable Development"@en ;
    rdfs:comment "AI should contribute to the United Nations Sustainable Development Goals by addressing global challenges including climate change, resource depletion, biodiversity loss, and environmental degradation whilst ensuring development meets present needs without compromising future generations' ability to meet their own needs. Grounded in the Brundtland Commission (1987) definition and operationalised through the 17 SDGs adopted in 2015, it encompasses economic, social, and environmental pillars requiring coordinated policy, governance, and technological action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inclusive-growth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environmental-sustainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sustainable-development-goals ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-framework ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:infrastructure,
        ngm:supply-chain ;
    vc:enables ngm:circular-economy,
        ngm:climate-action,
        ngm:green-ai,
        ngm:renewable-energy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:environmental-sustainability,
        ngm:inclusive-growth,
        ngm:sustainable-development-goals ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:well-being ;
    vc:requires ngm:policy-framework,
        ngm:stakeholder-engagement ;
    vc:slug "sustainable-development" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-14001,
        ngm:oecd-ai-principles ;
    vc:supports ngm:biodiversity-conservation,
        ngm:carbon-footprint-reduction .

ngm:tactile-sensing a owl:Class ;
    rdfs:label "Tactile Sensing"@en ;
    rdfs:comment "Tactile sensing is the ability of a robotic or prosthetic system to detect and interpret physical contact information — including contact force magnitude, direction, distribution, texture, slip, and temperature — through sensors embedded in or on the surface of an end effector or robotic skin. It is the mechanical analogue of the human sense of touch and provides information that visual sensing alone cannot supply, such as the internal stress distribution of a grasped object or the onset of slippage. Tactile sensing is fundamental to dexterous manipulation, safe human-robot interaction, and feedback-controlled assembly, and has become a defining capability differentiating next-generation robotic systems from conventional industrial manipulators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:perception-system ;
    vc:bridgesTo ngm:machine-learning,
        ngm:neuromorphic-computing ;
    vc:contrastsWith ngm:proximity-sensing,
        ngm:visual-perception ;
    vc:dependsOn ngm:end-effector,
        ngm:soft-robotics ;
    vc:enables ngm:dexterous-grasping,
        ngm:force-control,
        ngm:haptic-feedback,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotic-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:grasp-planning ;
    vc:requires ngm:sensor-fusion,
        ngm:signal-processing ;
    vc:slug "tactile-sensing" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:prosthetics,
        ngm:teleoperation ;
    vc:uses ngm:capacitive-sensor,
        ngm:force-torque-sensor,
        ngm:piezoresistive-sensor,
        ngm:pressure-sensor,
        ngm:tactile-sensor .

ngm:technical-documentation a owl:Class ;
    rdfs:label "Technical Documentation"@en ;
    rdfs:comment "Technical documentation is the body of written material that explains how to use, operate, maintain, or build a product or system, spanning API references, user guides, architecture documents, runbooks, and specifications. Good technical documentation reduces onboarding time, encodes institutional knowledge, supports interoperability, and is increasingly treated as a versioned, tested artefact within the docs-as-code discipline. It is essential to the adoption and maintainability of software, hardware, and standards, and serves as a primary source for both human understanding and machine consumption."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:standards-body ;
    vc:slug "technical-documentation" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:interoperability,
        ngm:open-standard .

ngm:telemedicine a owl:Class ;
    rdfs:label "Telemedicine"@en ;
    rdfs:comment "Telemedicine is the delivery of clinical healthcare services — including diagnosis, consultation, monitoring, and treatment guidance — at a distance using telecommunications technology such as video conferencing, secure messaging, and remote sensing devices. It encompasses synchronous consultations (live video visits), asynchronous store-and-forward exchanges (images, test results), and remote patient monitoring (RPM) using wearable sensors and IoT devices. Telemedicine dramatically expands access to specialist care for patients in rural, underserved, or mobility-constrained situations."@en ;
    rdfs:subClassOf ngm:healthcare-technology ;
    vc:enables ngm:clinical-decision-support,
        ngm:precision-medicine,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:healthcare-records,
        ngm:medical-ai,
        ngm:wearable-device-integration ;
    vc:slug "telemedicine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:healthcare-ai,
        ngm:io-t-sensor-network,
        ngm:video-conferencing .

ngm:text-classification a owl:Class ;
    rdfs:label "Text Classification"@en ;
    rdfs:comment "Text classification is the supervised natural-language-processing task of assigning one or more predefined categorical labels to a span of text such as a document, sentence, or query. It maps variable-length text inputs to a fixed label space using learned representations and a decision function. Common formulations include binary, multi-class, and multi-label classification over topics, sentiment, intent, or content policy categories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenization ],
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:named-entity-recognition ;
    vc:enables ngm:content-moderation,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feature-engineering,
        ngm:tokenization ;
    vc:implements ngm:classification ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:information-retrieval,
        ngm:large-language-model ;
    vc:requires ngm:model-training,
        ngm:supervised-learning ;
    vc:slug "text-classification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:foundation-model ;
    vc:uses ngm:neural-network,
        ngm:transformer-architecture .

ngm:tool-registry a owl:Class ;
    rdfs:label "Tool Registry"@en ;
    rdfs:comment "A tool registry is a catalogue that stores the definitions, schemas, permissions, and metadata of the external tools and functions an AI agent can invoke. It enables agents to discover, validate, and route calls to available capabilities at runtime, providing a governed and extensible interface between language models and the systems they act upon."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-internet ;
    vc:slug "tool-registry" ;
    vc:sourceDomain "ai" .

ngm:tool-schema a owl:Class ;
    rdfs:label "Tool Schema"@en ;
    rdfs:comment "A tool schema is a structured, machine-readable specification — typically expressed in JSON Schema format — that formally defines a function or external capability that an AI agent may invoke at inference time, encoding its name, natural-language description, parameter names and types, constraints, and required versus optional fields. Tool schemas are injected into an AI model's context window as part of the system prompt or capability manifest, enabling the model to reason about available operations and emit syntactically correct, structured function-call outputs that an orchestration layer can dispatch. They constitute the primary interface contract between large language models and the external systems, services, or data sources they interact with, determining both tool-selection accuracy and invocation correctness. The tool schema construct is foundational to agentic AI architectures and underpins modern function-calling APIs, the Model Context Protocol, and multi-agent orchestration frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:structured-output ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:microservices-architecture,
        ngm:restful-api ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:prompt-engineering ;
    vc:dependsOn ngm:inference-compute,
        ngm:schema-registry ;
    vc:enables ngm:agentic-ai,
        ngm:ai-agent,
        ngm:function-calling,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:model-context-protocol,
        ngm:open-api-specification ;
    vc:isPartOf ngm:multi-agent-orchestration ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:requires ngm:json-data-interchange-format-schema,
        ngm:large-language-model,
        ngm:structured-output ;
    vc:slug "tool-schema" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:multi-agent-system,
        ngm:retrieval-augmented-generation ;
    vc:uses ngm:type-system .

ngm:uri a owl:Class ;
    rdfs:label "URI"@en ;
    rdfs:comment "A URI (Uniform Resource Identifier) is a compact sequence of characters that uniquely identifies an abstract or physical resource on a network or within a namespace. It generalises both locators, which describe how to access a resource, and names, which identify a resource independently of access, under a single syntactic framework of scheme, authority, path, query and fragment. URIs are foundational to the architecture of the World Wide Web and the Semantic Web, where they serve as globally unique identifiers for documents, data and entities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:web-standard ;
    vc:bridgesTo ngm:ontology ;
    vc:enables ngm:interoperability,
        ngm:linked-data,
        ngm:rest-api ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:persistent-identifier ;
    vc:isPartOf ngm:web-standard ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:did,
        ngm:solid ;
    vc:requires ngm:network-protocol ;
    vc:slug "uri" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:digital-identity,
        ngm:rdf ;
    vc:uses ngm:http .

ngm:vector-embedding a owl:Class ;
    rdfs:label "Vector Embedding"@en ;
    rdfs:comment "A vector embedding is a dense, fixed-length numerical representation of a discrete object — a word, sentence, image, or user — in a continuous high-dimensional space, learned such that semantically similar objects map to nearby points. Embeddings convert unstructured data into a form amenable to mathematical operations like distance and dot product, enabling similarity search, clustering, recommendation, and retrieval. They are produced by neural encoders and are the representational substrate beneath modern search, retrieval-augmented generation, and multimodal AI."@en ;
    rdfs:subClassOf ngm:embedding ;
    vc:enables ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "vector-embedding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding-model .

ngm:voice-cloning a owl:Class ;
    rdfs:label "Voice Cloning"@en ;
    rdfs:comment "Voice cloning is a speech synthesis technique that uses a short reference audio recording of a target speaker to condition or fine-tune a neural text-to-speech model so that it reproduces that speaker's vocal characteristics — including timbre, prosody, accent, and speaking rhythm — when given arbitrary text input. Modern systems employ a speaker encoder network that extracts a fixed-dimensional speaker embedding from reference audio, which conditions a sequence-to-sequence acoustic model and vocoder to produce personalised synthetic speech. Zero-shot voice cloning generalises this capability to entirely unseen speakers without fine-tuning by leveraging large pre-trained generative models. The technology underpins both beneficial applications such as accessibility aids and audiobook narration, and adversarial uses including audio deepfakes and voice fraud."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:speech-synthesis ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:content-provenance,
        ngm:digital-watermarking ;
    vc:contrastsWith ngm:speech-synthesis,
        ngm:voice-conversion ;
    vc:enables ngm:accessibility,
        ngm:voice-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biometric-authentication,
        ngm:deepfakes,
        ngm:generative-ai,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:synthetic-media ;
    vc:requires ngm:speech-corpus,
        ngm:transfer-learning ;
    vc:slug "voice-cloning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:neural-network,
        ngm:speaker-embedding,
        ngm:text-to-speech,
        ngm:transformer .

ngm:web-of-trust a owl:Class ;
    rdfs:label "Web of Trust"@en ;
    rdfs:comment "A web of trust is a decentralised trust model in which participants vouch for the authenticity of one another's public keys by signing them, building confidence through chains of peer endorsements rather than a central authority. Trust is transitive and weighted: a key gains credibility as more trusted parties attest to it. Originating with PGP, the model contrasts with the hierarchical certificate-authority approach of public-key infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key ],
        ngm:trust-establishment ;
    vc:bridgesTo ngm:decentralised-identifiers,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:certificate-authority ;
    vc:enables ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:reputation-system,
        ngm:security,
        ngm:trust-establishment ;
    vc:requires ngm:cryptographic-key,
        ngm:key-management ;
    vc:slug "web-of-trust" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:decentralised-identity ;
    vc:uses ngm:trust-anchor .

ngm:working-group a owl:Class ;
    rdfs:label "Working Group"@en ;
    rdfs:comment "A working group is a chartered subgroup of a standards organisation or collaborative body tasked with developing, reviewing and reaching consensus on a specific technical topic or deliverable. It brings together domain experts who draft specifications, resolve issues and progress documents through review and approval stages. Working groups are the principal unit of work through which formal standards and specifications are produced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technical-committee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:standards-body ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:interoperability,
        ngm:standards ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:consensus,
        ngm:technical-committee ;
    vc:isPartOf ngm:standards-body,
        ngm:technical-committee ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:governance ;
    vc:requires ngm:collaboration,
        ngm:consensus ;
    vc:slug "working-group" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:standards-body ;
    vc:supports ngm:ietf,
        ngm:iso,
        ngm:standards ;
    vc:uses ngm:collaboration .

ngm:zk-starks a owl:Class ;
    rdfs:label "ZK-STARKs"@en ;
    rdfs:comment "Zero-Knowledge Scalable Transparent Arguments of Knowledge: a cryptographic proof system enabling verification of computations without revealing underlying data. Unlike ZK-SNARKs, STARKs require no trusted setup, are conjectured to be quantum-resistant, and scale efficiently for large witness sizes, making them foundational for Layer 2 blockchain rollups and privacy-preserving computation."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:smart-contracts ;
    vc:enables ngm:blockchain-scalability,
        ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:zero-knowledge-proof ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance ;
    vc:slug "zk-starks" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:elliptic-curve-cryptography .

ngm:age-verification a owl:Class ;
    rdfs:label "Age Verification"@en ;
    rdfs:comment "Age verification is a set of technical and procedural mechanisms used to confirm that a user meets a minimum age threshold before accessing restricted digital content or services. It encompasses document-based checks, biometric estimation, and privacy-preserving cryptographic proofs. Regulatory frameworks such as the UK Online Safety Act mandate age verification for platforms hosting harmful content. The field balances effective enforcement against privacy risks and the potential exclusion of legitimate users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:compliance-verification ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:enables ngm:access-control,
        ngm:content-moderation,
        ngm:parental-controls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:data-protection,
        ngm:digital-identity,
        ngm:gdpr,
        ngm:identity-proofing,
        ngm:regulatory-compliance ;
    vc:requires ngm:consent-management,
        ngm:identity-verification ;
    vc:slug "age-verification" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso,
        ngm:w3-c-verifiable-credentials ;
    vc:supports ngm:data-minimisation,
        ngm:online-safety-act-2023,
        ngm:uk-online-safety-act ;
    vc:uses ngm:verifiable-credentials,
        ngm:zero-knowledge-proof .

ngm:agent-memory a owl:Class ;
    rdfs:label "Agent Memory"@en ;
    rdfs:comment "Agent memory is the structured ensemble of mechanisms by which an autonomous AI agent stores, indexes, consolidates, retrieves, and forgets information across steps, sessions, and lifetimes — enabling coherent, personalised, and long-horizon behaviour that transcends the hard limit of any single context window. It encompasses four functionally distinct tiers: working memory (active context window); episodic memory (timestamped records of prior observations, actions, and outcomes); semantic memory (declarative facts, entity relationships, and world knowledge); and procedural memory (skill programs, tool-use patterns, and reusable plan templates)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:ai-agent,
        ngm:cognitive-architecture ;
    vc:enables ngm:agentic-workflow,
        ngm:continual-learning,
        ngm:long-horizon-task-execution,
        ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:requires ngm:context-window,
        ngm:embeddings,
        ngm:retrieval-augmented-generation,
        ngm:vector-database ;
    vc:slug "agent-memory" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-deployment a owl:Class ;
    rdfs:label "AI Deployment"@en ;
    rdfs:comment "The phase of the AI lifecycle in which a developed and validated artificial intelligence system is integrated into operational environments, made available to end users, and transitioned from development to production use, encompassing activities such as system integration, infrastructure provisioning, release management, user training, documentation delivery, and the establishment of operational support structures to ensure reliable, safe, and effective system functioning in real-world conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-performance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:canary-deployment ],
        ngm:ai-lifecycle ;
    vc:bridgesTo ngm:governance,
        ngm:security ;
    vc:contrastsWith ngm:ai-development ;
    vc:dependsOn ngm:ai-development,
        ngm:human-oversight ;
    vc:enables ngm:ai-monitoring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:canary-deployment,
        ngm:infrastructure-provisioning,
        ngm:release-management ;
    vc:implements ngm:mlops ;
    vc:isPartOf ngm:ai-lifecycle ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fda-software-as-medical-device,
        ngm:iso-iec-25010 ;
    vc:requires ngm:model-performance,
        ngm:operational-procedures,
        ngm:risk-management ;
    vc:slug "ai-deployment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument,
        ngm:iso-iec-42001-2023,
        ngm:iso-iec-5338-2023,
        ngm:nist-ai-risk-management-framework ;
    vc:uses ngm:ai-agent-system,
        ngm:ai-operator,
        ngm:ai-provider,
        ngm:ai-user .

ngm:ai-liability a owl:Class ;
    rdfs:label "AI Liability"@en ;
    rdfs:comment "AI Liability is the body of legal doctrine, statutory regime, regulatory practice and emerging case law that allocates civil responsibility for personal injury, property damage, economic loss, discrimination, privacy invasion and consequential harm caused by artificial intelligence systems—encomp..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:regulatory-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conformity-assessment,
        ngm:duty-of-care ;
    vc:implements ngm:eu-ai-act-regulatory-instrument,
        ngm:product-liability,
        ngm:product-liability-directive,
        ngm:strict-liability ;
    vc:qualityScore "0.52"^^xsd:float ;
