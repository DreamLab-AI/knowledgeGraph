ngm:rollup a owl:Class ;
    rdfs:label "Rollup"@en ;
    rdfs:comment "A Rollup is a blockchain scaling technique that executes transactions off a base layer such as Ethereum while posting compressed transaction data and state commitments back to it for settlement and data availability. By batching many transactions and proving or asserting their validity on the main chain, rollups increase throughput and reduce fees while inheriting much of the base layer's security. Two main types exist: optimistic rollups, which assume validity and rely on fraud proofs during a challenge window, and zero-knowledge rollups, which post validity proofs verifying each batch. Rollups are central to Ethereum's layer-2 scaling strategy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sequencer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:layer-2-scaling ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:plasma,
        ngm:sidechain,
        ngm:state-channel ;
    vc:dependsOn ngm:cryptographic-proof,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:enables ngm:arbitrum,
        ngm:decentralised-application,
        ngm:optimism,
        ngm:polygon,
        ngm:zk-sync ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fraud-proof,
        ngm:sequencer,
        ngm:zero-knowledge-proof ;
    vc:isPartOf ngm:layer-2-scaling ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:danksharding,
        ngm:proto-danksharding ;
    vc:requires ngm:data-availability,
        ngm:ethereum-smart-contract-platform,
        ngm:smart-contract ;
    vc:slug "rollup" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:calldata,
        ngm:merkle-tree .

ngm:virtual-economy a owl:Class ;
    rdfs:label "Virtual Economy"@en ;
    rdfs:comment "A virtual economy is a system of economic activity that takes place within a simulated or digital environment, encompassing the production, exchange, and consumption of virtual goods, services, and currencies. These economies exhibit emergent market dynamics — including supply-demand equilibria, price discovery, and capital accumulation — that parallel real-world economic phenomena while remaining governed by platform rules rather than national jurisdictions. Virtual economies range from closed in-game markets with proprietary currencies to open metaverse ecosystems where blockchain-backed assets and decentralised finance protocols enable interoperable, user-owned value. Their study bridges game theory, monetary economics, and digital rights, making them a critical lens through which to understand the financialisation of participatory digital spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:play-to-earn-p2-e ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-marketplace ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        ngm:bc-defi-and-economics ;
