ngm:canonical-json a owl:Class ;
    rdfs:comment "Canonical JSON is a normalised serialisation form of JSON that specifies a unique, deterministic byte-level representation for any given JSON value, enabling reliable hashing, digital signatures, and binary equality comparisons over JSON documents. Because RFC 8259 JSON permits equivalent representations that differ in whitespace, key ordering, and number formatting, canonical forms such as JCS (JSON Canonicalization Scheme, RFC 8785) and earlier proposals impose rules including lexicographic key sorting, no insignificant whitespace, and IEEE 754 double-precision serialisation for numbers. This determinism is essential in cryptographic contexts where the same logical object must produce the same digest regardless of which implementation serialised it."@en ;
    rdfs:label "Canonical JSON"@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
