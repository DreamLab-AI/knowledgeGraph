ngm:text-to-image-generation a owl:Class ;
    rdfs:label "Text-to-Image Generation"@en ;
    rdfs:comment "Text-to-image generation is a class of generative AI techniques that synthesise photorealistic or stylised images from natural-language textual descriptions, typically employing diffusion models, autoregressive transformers, or hybrid architectures trained on large paired datasets of images and captions. The synthesis process encodes a text prompt into a conditioning latent representation, then iteratively denoises random noise into structured visual output guided by that signal through cross-attention mechanisms. Leading systems such as DALL-E 3, Stable Diffusion XL, Midjourney, Imagen, and Flux exemplify the paradigm across proprietary and open-weight deployment modes. The field intersects creative tooling, computer vision, multimodal AI, and contested questions of copyright, consent, and synthetic media provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-scale-pretraining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-encoder ],
        ngm:image-generation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:c2-pa,
        ngm:intellectual-property-rights-framework,
        ngm:synthetic-media ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:image-recognition ;
    vc:enables ngm:image-editing,
        ngm:multimodal-ai-architecture-ai,
        ngm:prompt-engineering,
        ngm:synthetic-data-generation,
        ngm:text-to-video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:denoising-network,
        ngm:text-encoder ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:fine-tuning,
        ngm:generative-ai,
        ngm:kohya-dreambooth-and-similar,
        ngm:lora,
        ngm:stable-diffusion-image-model ;
    vc:requires ngm:gpu-compute,
        ngm:large-scale-pretraining ;
    vc:slug "text-to-image-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:clip,
        ngm:contrastive-learning,
        ngm:cross-attention,
        ngm:diffusion-model,
        ngm:latent-diffusion,
        ngm:transformer-architecture,
        ngm:variational-autoencoder .

ngm:timestamp-authority a owl:Class ;
    rdfs:label "Timestamp Authority"@en ;
    rdfs:comment "A Timestamp Authority (TSA) is a trusted third party that issues cryptographically signed timestamps attesting that a particular piece of data existed at or before a specified point in time, in accordance with the RFC 3161 Internet X.509 Public Key Infrastructure Time-Stamp Protocol. The TSA receives a hash of the document or data, signs it together with the current time using its private key, and returns a TimeStampToken that can be independently verified by any party holding the TSA's public key certificate. Timestamp tokens are widely used in digital signature workflows to prove long-term validity—establishing that signatures were made before certificate revocation or expiry. Under eIDAS regulation in Europe, qualified TSAs form part of trust service infrastructure with legal standing equivalent to notarisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-service-provider ],
        ngm:certificate-authority ;
    vc:bridgesTo ngm:blockchain,
        ngm:governance ;
    vc:enables ngm:audit-trail,
        ngm:compliance-audit-trail,
        ngm:long-term-archival,
        ngm:virtual-notary-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eidas-regulation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-certificate,
        ngm:digital-signature,
        ngm:non-repudiation,
        ngm:public-key-infrastructure,
        ngm:timestamp ;
    vc:requires ngm:trust-service-provider ;
    vc:slug "timestamp-authority" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:etsi,
        ngm:ietf ;
    vc:supports ngm:archival-standards,
        ngm:digital-signature-verification ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:cryptographic-signature,
        ngm:x-509-certificate .

ngm:token-distribution a owl:Class ;
    rdfs:label "Token Distribution"@en ;
    rdfs:comment "Token distribution is the process and schema by which a blockchain project allocates its native tokens across stakeholders such as founders, investors, the community, and a treasury. It specifies how many tokens each group receives, when they unlock through vesting, and through which mechanisms they are released, all of which shape decentralisation, incentive alignment, and market liquidity. A distribution design is a central lever of a project's tokenomics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vesting-schedule ],
        ngm:tokenomics ;
    vc:bridgesTo ngm:initial-coin-offering ;
    vc:contrastsWith ngm:ico ;
