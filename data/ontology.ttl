ngm:quadratic-programming a owl:Class ;
    rdfs:comment "Quadratic programming (QP) is a class of mathematical optimisation problems in which a quadratic objective function is minimised subject to linear equality and inequality constraints. It is a convex optimisation problem when the quadratic term is positive semidefinite, admitting efficient and globally optimal solvers. QP is foundational to model-based control, trajectory optimisation, and constrained robotic motion generation."@en ;
    rdfs:label "Quadratic Programming"@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control ;
    vc:relatedTo ngm:model-based-control ;
    vc:slug "quadratic-programming" ;
    vc:sourceDomain "robotics" .
ngm:quadratic-voting a owl:Class ;
    rdfs:comment "Collective decision-making mechanism where the cost of casting n votes on any single proposal equals n² voice credits, formalising preference-intensity revelation whilst resisting plutocratic capture — developed by Steven Lalley and E."@en ;
    rdfs:label "Quadratic Voting"@en ;
