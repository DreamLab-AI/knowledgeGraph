ngm:hash-function a owl:Class ;
    rdfs:label "Hash Function"@en ;
    rdfs:comment "A Hash Function is a deterministic computational mapping H: {0,1}* → {0,1}^n from arbitrary-length input strings (preimages, messages) to fixed-length output strings (digests, hashes, fingerprints) of n bits (typically n ∈ {128, 160, 224, 256, 384, 512}), whose security and utility derive fro..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:determinism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compression-function ],
        ngm:bc-cryptographic-primitive,
        ngm:compression-function ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:cryptographic-algorithm ;
    vc:enables ngm:blockchain-immutability,
        ngm:commitment-scheme,
        ngm:content-addressing,
        ngm:data-integrity,
        ngm:deduplication,
        ngm:digital-signature,
        ngm:key-derivation,
        ngm:merkle-tree,
        ngm:message-authentication-code,
        ngm:password-storage,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compression-function,
        ngm:initialization-vector,
        ngm:internal-state,
        ngm:output-truncation,
        ngm:padding-scheme,
        ngm:round-function ;
    vc:implements ngm:collision-resistance,
        ngm:indistinguishability,
        ngm:preimage-resistance,
        ngm:random-oracle-model,
        ngm:second-pre-image-resistance ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:birthday-attack,
        ngm:bloom-filter,
        ngm:cryptanalysis,
        ngm:length-extension-attack,
        ngm:quantum-computation-paradigm,
        ngm:side-channel-attack ;
    vc:requires ngm:avalanche-effect,
        ngm:computational-security,
        ngm:cryptography,
        ngm:determinism,
        ngm:pseudo-randomness ;
