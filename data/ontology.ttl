ngm:analogue-to-digital-conversion a owl:Class ;
    rdfs:label "Analogue To Digital Conversion"@en ;
    rdfs:comment "Analogue-to-digital conversion is the process of transforming a continuous physical signal, such as voltage from a sensor, into a discrete sequence of numerical values that a digital system can store and process. It proceeds by sampling the signal at regular intervals and quantising each sample to a finite set of levels, with the sampling rate and bit depth determining how faithfully the original is represented. In robotics and embedded systems it is the essential bridge between the analogue physical world and digital control and perception pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        [ a owl:Restriction ;
