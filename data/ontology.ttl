ngm:solo-mining a owl:Class ;
    rdfs:label "Solo Mining"@en ;
    rdfs:comment "Solo Mining is a blockchain participation strategy in which an individual miner independently operates hashing hardware and attempts to discover valid blocks without joining a mining pool, retaining the full block reward upon success but accepting high variance in earnings proportional to the miner's share of total network hash rate. It contrasts with pool mining by preserving full decentralisation of block production but is economically viable only when a miner controls a significant fraction of total hash power."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:mining-pool,
        ngm:selfish-mining ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:block-reward,
        ngm:blockchain-network,
        ngm:nakamoto-consensus ;
    vc:requires ngm:consensus-algorithm,
        ngm:proof-of-work ;
    vc:slug "solo-mining" ;
    vc:sourceDomain "blockchain" .

