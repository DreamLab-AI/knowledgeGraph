ngm:hyperparameter-tuning a owl:Class ;
    rdfs:label "Hyperparameter Tuning"@en ;
    rdfs:comment "Hyperparameter tuning is the systematic process of searching over the configuration space of parameters that govern the training process of a machine learning model — distinct from the learnable parameters updated during training itself. Common hyperparameters include learning rate, batch size, network depth and width, regularisation coefficients, dropout rate, optimiser choice, and architectural decisions such as kernel size or number of attention heads. The tuning process employs search strategies — including grid search, random search, Bayesian optimisation, population-based methods, and evolutionary algorithms — to identify configurations that maximise model performance on a held-out validation set while controlling for overfitting. Efficient hyperparameter optimisation is critical to practical machine learning deployment because model generalisation is often highly sensitive to these configuration choices, and naive exhaustive search is computationally intractable in high-dimensional spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-validation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:mlops ;
    vc:contrastsWith ngm:manual-feature-engineering,
        ngm:overfitting ;
    vc:dependsOn ngm:early-stopping,
        ngm:objective-function,
        ngm:regularisation ;
    vc:enables ngm:deep-learning,
        ngm:model-generalisation,
        ngm:neural-architecture-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:auto-ml,
        ngm:machine-learning-pipeline ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:experiment-tracking,
        ngm:machine-learning-optimisation,
        ngm:meta-learning,
        ngm:transfer-learning ;
    vc:requires ngm:cross-validation,
        ngm:model-evaluation,
        ngm:validation-set ;
    vc:slug "hyperparameter-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bayesian-optimisation,
        ngm:evolutionary-algorithm,
        ngm:gaussian-process,
        ngm:grid-search,
        ngm:random-search .

ngm:mobile-robot a owl:Class ;
    rdfs:label "Mobile Robot"@en ;
    rdfs:comment "A mobile robot is an autonomous or semi-autonomous electromechanical system equipped with a locomotion mechanism — wheels, tracks, legs, rotors, or thrusters — that enables it to navigate within or across physical environments without being fixed to a stationary base. Mobile robots integrate sensing, actuation, and computation to perceive their surroundings, plan feasible paths, and execute goal-directed motion, distinguishing them from fixed industrial manipulators. They span a wide spectrum of embodiments including ground vehicles (UGVs), aerial vehicles (UAVs/drones), underwater vehicles (AUVs), and legged walkers, unified by the capability to self-relocate in service of a task. Defined formally by ISO 8373:2021 as a robot able to travel under its own control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simultaneous-localisation-and-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robot ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:fixed-base-robot,
        ngm:industrial-manipulator ;
    vc:dependsOn ngm:embedded-systems,
        ngm:localisation ;
    vc:enables ngm:autonomous-navigation,
        ngm:last-mile-delivery,
        ngm:search-and-rescue-robotics,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:locomotion-system,
        ngm:onboard-computer,
        ngm:power-supply,
        ngm:robot-sensor-suite ;
    vc:isPartOf ngm:multi-robot-system,
        ngm:robotics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:autonomous-underwater-vehicle,
        ngm:legged-robot,
        ngm:swarm-robotics,
        ngm:unmanned-aerial-vehicle ;
    vc:requires ngm:motion-planning,
        ngm:obstacle-avoidance,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ansi-ria-r15-08,
        ngm:iso-8373-2021 ;
    vc:uses ngm:computer-vision,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:robot-operating-system .

ngm:model-predictive-control a owl:Class ;
    rdfs:label "Model Predictive Control"@en ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced control strategy in which an explicit mathematical model of the controlled process is used to predict future system outputs over a receding finite-horizon window, and a constrained optimisation problem is solved at each control step to compute the optimal input sequence. Only the first element of the computed sequence is applied, after which the horizon shifts forward and the optimisation repeats with an updated state estimate, creating an implicit closed-loop feedback mechanism. MPC handles multi-input multi-output (MIMO) systems, hard inequality constraints on both states and inputs, and competing cost objectives within a single unified formulation, making it applicable across process control, autonomous vehicles, robotics, and energy management. Its ability to anticipate constraint violations before they occur distinguishes it fundamentally from classical reactive controllers such as PID."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cost-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-identification ],
        ngm:optimal-control ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-network ;
    vc:contrastsWith ngm:lqr-control,
        ngm:pid-control ;
    vc:dependsOn ngm:feedback-control,
        ngm:linear-algebra,
        ngm:quadratic-programming ;
    vc:enables ngm:autonomous-driving,
        ngm:energy-management,
        ngm:robot-control,
        ngm:trajectory-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:control-horizon,
        ngm:cost-function,
        ngm:prediction-horizon,
        ngm:receding-horizon ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-planning,
        ngm:reinforcement-learning,
        ngm:whole-body-control ;
    vc:requires ngm:dynamic-model,
        ngm:mathematical-optimisation,
        ngm:state-estimation,
        ngm:system-identification ;
    vc:slug "model-predictive-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:nonlinear-programming,
        ngm:state-space-model .

ngm:named-entity-recognition a owl:Class ;
    rdfs:label "Named Entity Recognition"@en ;
    rdfs:comment "Named Entity Recognition (NER) is the NLP task of identifying and classifying named entities (persons, organisations, locations, dates, quantities) within unstructured text into predefined categories. NER systems employ transformer-based models (BERT, RoBERTa) with sequence labelling architectures (CRF, BiLSTM-CRF) to extract structured information from documents."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:bridgesTo ngm:knowledge-graph ;
