ngm:lifecycle-assessment a owl:Class ;
    rdfs:label "Lifecycle Assessment"@en ;
    rdfs:comment "Lifecycle assessment is a systematic method for evaluating the environmental impacts of a product, process or service across its entire life, from raw-material extraction through manufacture, distribution, use and end-of-life disposal or recycling. By accounting for inputs and outputs such as energy, materials, emissions and waste at every stage, it identifies where the greatest impacts occur and prevents burden-shifting between life-cycle phases. It underpins eco-design, carbon accounting and credible sustainability claims, and is governed by international standards to ensure comparability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-footprint ],
        ngm:environmental-sustainability ;
