    vc:slug "motion-tracking" ;
    vc:sourceDomain "robotics" .

ngm:neural-rendering a owl:Class ;
    rdfs:label "Neural Rendering"@en ;
    rdfs:comment "Neural Rendering combines deep neural networks with classical rendering pipelines to synthesise photorealistic images of 3D scenes from novel viewpoints. Techniques such as Neural Radiance Fields (NeRF) represent scenes as continuous volumetric functions enabling high-fidelity view synthesis from sparse image collections. Neural rendering underpins photorealistic telepresence, 3D asset generation, and immersive environment reconstruction for spatial computing applications."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:3-d-reconstruction,
