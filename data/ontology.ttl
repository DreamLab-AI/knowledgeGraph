ngm:conformal-prediction a owl:Class ;
    rdfs:label "Conformal Prediction"@en ;
    rdfs:comment "Conformal prediction is a distribution-free, model-agnostic framework for producing statistically valid prediction sets or intervals that are guaranteed to contain the true outcome with a user-specified probability, using only the mild assumption of exchangeability over the data. A held-out calibration set and a nonconformity score function are sufficient to construct finite-sample marginal coverage guarantees for any base predictor — ranging from linear models and neural networks to Gaussian processes and large language models. The framework unifies classification (prediction sets), regression (prediction intervals), and sequence generation (conformal risk control), and has become a cornerstone method for trustworthy AI deployment in safety-critical and regulated domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:machine-learning-discipline-technique,
        ngm:uncertainty-quantification ;
    vc:contrastsWith ngm:bayesian-inference,
        ngm:gaussian-process ;
    vc:enables ngm:anomaly-detection,
        ngm:risk-assessment,
        ngm:selective-prediction,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:calibration-set,
        ngm:coverage-guarantee,
        ngm:nonconformity-score,
        ngm:prediction-interval ;
    vc:implements ngm:frequentist-statistics,
        ngm:hypothesis-testing ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:bayesian-deep-learning,
        ngm:bayesian-inference,
        ngm:ensemble-methods,
        ngm:model-calibration,
        ngm:probabilistic-model ;
    vc:requires ngm:calibration,
        ngm:exchangeability,
        ngm:probability-theory ;
    vc:slug "conformal-prediction" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:autonomous-systems,
        ngm:drug-discovery,
        ngm:medical-imaging,
        ngm:natural-language-processing .

