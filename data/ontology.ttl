ngm:packet-switching a owl:Class ;
    rdfs:comment "Packet switching is a method of data transmission in which messages are divided into discrete packets that are routed independently across a shared network and reassembled at the destination. Each packet carries addressing information allowing intermediate nodes to forward it along varying paths, making efficient use of shared links. It is the foundational technique of the internet, contrasting with circuit switching that dedicates a fixed path for a session."@en ;
    rdfs:label "Packet Switching"@en ;
    rdfs:subClassOf ngm:network-communication ;
