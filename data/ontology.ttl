    vc:uses ngm:computer-graphics,
        ngm:game-engine .

ngm:industrial-inspection a owl:Class ;
    rdfs:label "Industrial Inspection"@en ;
    rdfs:comment "Industrial inspection is the systematic examination of manufactured parts, assemblies, infrastructure, and production processes to verify conformance with quality specifications, detect defects, and identify safety or structural hazards before product deployment or during operational service. It encompasses both non-destructive testing methods (ultrasonic, eddy-current, X-ray, thermographic) and machine vision approaches that use computer vision algorithms to automate defect classification at production speeds. AI-driven industrial inspection replaces or augments human visual inspectors with deep learning models trained on labelled defect images, enabling consistent sub-millimetre defect detection at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:labelled-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        ngm:quality-assurance ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:infrastructure,
        ngm:robotics ;
    vc:dependsOn ngm:deep-learning,
        ngm:industrial-io-t ;
    vc:enables ngm:defect-detection,
        ngm:manufacturing-automation,
        ngm:predictive-maintenance,
        ngm:quality-control,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:precision-manufacturing,
        ngm:runtime-inspection,
        ngm:statistical-process-control ;
    vc:requires ngm:image-processing,
        ngm:labelled-dataset ;
    vc:slug "industrial-inspection" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:digital-twin,
        ngm:regulatory-compliance ;
    vc:uses ngm:anomaly-detection,
        ngm:computer-vision,
        ngm:computer-vision-system,
        ngm:convolutional-neural-network,
        ngm:inspection-robot,
        ngm:machine-vision .

ngm:infrared-sensor a owl:Class ;
    rdfs:label "InfraredSensor"@en ;
    rdfs:comment "An optoelectronic sensor device that detects electromagnetic radiation in the infrared spectrum (wavelengths approximately 700 nanometers to 1 millimeter) to measure heat emission, enable proximity detection, support autonomous navigation, or facilitate object recognition in robotic systems, empl..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-amplifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
