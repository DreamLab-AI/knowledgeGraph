            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience,
        ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3-d-modeling,
        ngm:game-engine ;
    vc:slug "virtual-environment-creation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-content-generation,
        ngm:physics-simulation,
        ngm:real-time-rendering .

ngm:virtual-event-platform a owl:Class ;
    rdfs:label "Virtual Event Platform"@en ;
    rdfs:comment "Software platforms that enable hosting digital events in metaverse environments, supporting conferences, exhibitions, concerts, and networking through immersive 3D spaces with avatar-based attendance, interactive features, and real-time collaboration tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
