        ngm:onnx,
        ngm:throughput ;
    vc:slug "inference" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-22989-2022 ;
    vc:supports ngm:mlops,
        ngm:model-serving ;
    vc:uses ngm:hardware-acceleration,
        ngm:inference-hardware,
        ngm:quantisation,
        ngm:runtime-environment .

