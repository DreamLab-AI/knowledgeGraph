        ngm:transfer-function .

ngm:graph-neural-network a owl:Class ;
    rdfs:label "Graph Neural Network"@en ;
    rdfs:comment "A Graph Neural Network (GNN) is a deep learning architecture that operates directly on graph-structured data by iteratively propagating and aggregating feature information across node neighbourhoods. GNNs generalise convolutional and attention mechanisms to non-Euclidean domains, learning node, edge, and graph-level representations suitable for tasks including node classification, link prediction, and graph classification across domains such as knowledge graphs, social networks, molecular modelling, and recommendation systems."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:anomaly-detection,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:semantic-web,
        ngm:transformer ;
    vc:slug "graph-neural-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:knowledge-graph .

ngm:iec-61508 a owl:Class ;
    rdfs:label "IEC 61508"@en ;
    rdfs:comment "IEC 61508 is a foundational international functional safety standard published by the International Electrotechnical Commission that specifies requirements for the design, development, validation, and lifecycle management of electrical, electronic, and programmable electronic (E/E/PE) safety-related systems across all application domains. It defines Safety Integrity Levels (SIL 1–4) as quantitative risk-reduction targets and prescribes the development methods—fault trees, FMEAs, formal methods, and software design constraints—appropriate to each SIL. Sector-specific derivative standards including ISO 26262 (automotive) and EN 50128 (rail) inherit its SIL framework and lifecycle requirements."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:functional-safety,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:cybersecurity-standard,
        ngm:embedded-systems ;
    vc:slug "iec-61508" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:robo-safety-and-standards .

ngm:immersive-learning a owl:Class ;
    rdfs:label "Immersive Learning"@en ;
    rdfs:comment "Educational approaches utilising VR, AR, and metaverse technologies to create engaging, interactive learning environments that enable experiential skill development, realistic scenario simulation, and enhanced knowledge retention through presence-based educational experiences."@en ;
