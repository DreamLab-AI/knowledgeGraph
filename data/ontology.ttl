ngm:collective-action a owl:Class ;
    rdfs:label "Collective Action"@en ;
    rdfs:comment "Coordinated behaviour by a group of individuals or organisations toward a shared goal that no single actor could achieve unilaterally. It is characterised by interdependence, the risk of free-riding, and the need for mechanisms — such as incentives, norms, or contracts — to align individual contributions with the group objective."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incentive-mechanism ],
        ngm:coordination-mechanisms ;
    vc:bridgesTo ngm:decentralized-autonomous-organization,
        ngm:distributed-collaboration,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:individual-rationality,
        ngm:tragedy-of-the-commons ;
    vc:enables ngm:collective-governance,
        ngm:institutional-design,
        ngm:public-goods,
        ngm:public-goods-funding,
        ngm:social-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:free-rider-problem ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence,
        ngm:common-pool-resources,
        ngm:community-governance,
        ngm:game-theory,
        ngm:prisoners-dilemma,
        ngm:social-contract ;
    vc:requires ngm:incentive-mechanism,
        ngm:monitoring,
        ngm:trust ;
    vc:slug "collective-action" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:coordination-protocol,
        ngm:smart-contract,
        ngm:voting-mechanism .

ngm:collective-communication a owl:Class ;
    rdfs:label "Collective Communication"@en ;
    rdfs:comment "Collective communication is the class of synchronised, multi-party data-exchange operations in which a group of processes jointly participate, such as broadcast, scatter, gather, all-gather, reduce, and all-reduce. It provides the communication primitives that coordinate state across the nodes of a parallel or distributed system, and it is the backbone of distributed machine-learning training, where gradients and parameters are aggregated and synchronised across many accelerators. Implementations are optimised over high-speed interconnects to minimise the communication overhead that otherwise bottlenecks scaling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interconnect ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        ngm:distributed-training ;
    vc:dependsOn ngm:message-passing,
        ngm:rdma ;
    vc:enables ngm:data-parallelism,
        ngm:model-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:gradient-aggregation ;
    vc:isPartOf ngm:distributed-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu-cluster,
        ngm:gradient-aggregation,
        ngm:message-passing ;
    vc:requires ngm:gpu-cluster,
        ngm:interconnect ;
    vc:slug "collective-communication" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:parameter-server ;
    vc:uses ngm:infiniband,
        ngm:mpi .

ngm:collective-intelligence a owl:Class ;
    rdfs:label "Collective Intelligence"@en ;
    rdfs:comment "Collective intelligence is the shared or group intelligence that emerges from the collaboration, competition, and collective decision-making of many individuals or agents, producing cognitive capacities — prediction accuracy, problem-solving breadth, creative output — that exceed what any individual participant could achieve alone. It manifests in biological systems such as ant colonies and immune networks, human social institutions, and engineered multi-agent systems, and is characterised by distributed information processing, diversity of perspective, and aggregation mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stigmergy ],
        ngm:collective-intelligence-system ;
    vc:bridgesTo ngm:ant-colony-optimisation,
        ngm:decentralised-autonomous-organisation ;
    vc:enables ngm:collective-decision-making,
        ngm:decentralised-coordination,
        ngm:emergence,
        ngm:open-source-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:stigmergy,
        ngm:wisdom-of-crowds ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-based-models,
        ngm:ensemble-methods,
        ngm:governance,
        ngm:multi-agent-systems ;
    vc:slug "collective-intelligence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:knowledge-management,
        ngm:multi-agent-system,
        ngm:prediction-markets,
        ngm:swarm-intelligence .

