ngm:inflation-hedging a owl:Class ;
    rdfs:label "Inflation Hedging"@en ;
    rdfs:comment "Inflation hedging is an investment strategy that protects the real value of capital against the erosion of purchasing power caused by rising consumer prices. It allocates wealth to assets whose nominal value tends to rise with or outpace inflation, such as commodities, real estate, inflation-linked bonds, and scarce stores of value. Both gold and Bitcoin are frequently cited as inflation hedges because their supply is constrained relative to fiat currency issuance."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
