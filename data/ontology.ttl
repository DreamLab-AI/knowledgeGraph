ngm:network-infrastructure a owl:Class ;
    rdfs:label "Network Infrastructure"@en ;
    rdfs:comment "Network Infrastructure comprises the physical and logical communication systems — fibre, wireless, routing, and switching equipment, alongside software-defined networking layers — that enable data transmission for real-time collaboration and distributed computing. Modern network infrastructure integrates 5G/6G wireless, SD-WAN, content delivery networks, and multi-access edge computing to support low-latency, high-bandwidth applications such as immersive XR experiences and autonomous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
