ngm:practical-byzantine-fault-tolerance a owl:Class ;
    rdfs:label "Practical Byzantine Fault Tolerance"@en ;
    rdfs:comment "A consensus algorithm providing high-performance Byzantine state machine replication for asynchronous distributed systems, tolerating up to f faulty nodes in a system of 3f+1 total nodes. PBFT achieves deterministic finality through a three-phase protocol (pre-prepare, prepare, commit) and processes thousands of requests per second with sub-millisecond latency overhead, making it suitable for permissioned blockchain networks requiring strong consistency guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-machine-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-authentication-code ],
        ngm:byzantine-fault-tolerance ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:fault-tolerant-computing ;
    vc:contrastsWith ngm:nakamoto-consensus,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-governance,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:permissioned-blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:commit-phase,
        ngm:pre-prepare-phase,
        ngm:prepare-phase ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:federated-byzantine-fault-tolerance,
        ngm:hot-stuff-consensus,
        ngm:leader-based-protocol,
        ngm:total-order-broadcast ;
    vc:requires ngm:message-authentication-code,
        ngm:quorum-certificate,
        ngm:state-machine-replication ;
    vc:slug "practical-byzantine-fault-tolerance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:hyperledger-fabric ;
    vc:uses ngm:digital-signature,
        ngm:public-key-cryptography,
        ngm:validator-node .

