ngm:luma-ai a owl:Class ;
    rdfs:comment "Luma AI is a company developing generative tools for 3D capture and video generation. Its products include neural reconstruction of scenes from photographs and a text-to-video model."@en ;
    rdfs:label "Luma AI"@en ;
    rdfs:subClassOf ngm:generative-ai ;
