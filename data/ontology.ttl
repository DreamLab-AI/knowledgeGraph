        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:web-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:digital-economy,
        ngm:interoperability,
        ngm:web-technology ;
    vc:requires ngm:web-standard ;
    vc:slug "progressive-web-app" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:web-standard ;
    vc:supports ngm:interoperability ;
    vc:uses ngm:caching,
        ngm:web-standard .

ngm:project-agora a owl:Class ;
    rdfs:label "Project Agora"@en ;
    rdfs:comment "Project Agora is a cross-border wholesale payments initiative led by the Bank for International Settlements with several central banks and private financial institutions. It explores integrating tokenised commercial-bank deposits with tokenised central-bank money on a unified programmable ledger to improve cross-border settlement. It is a flagship experiment in the tokenisation of the monetary and financial system."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
