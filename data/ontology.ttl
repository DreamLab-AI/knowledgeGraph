    vc:uses ngm:algorithmic-impact-assessment,
        ngm:bias-mitigation-techniques,
        ngm:value-sensitive-design .

ngm:simulation a owl:Class ;
    rdfs:label "Simulation"@en ;
    rdfs:comment "Simulation is the computational reproduction of real-world systems, physical phenomena, or abstract processes through mathematical models that evolve over time, enabling experimentation, training, and prediction without risk to personnel or infrastructure. Simulations span a fidelity spectrum from simplified discrete-event models to high-fidelity continuous-physics environments powered by physics engines, rendering pipelines, and stochastic solvers. In spatial computing and metaverse contexts, real-time simulation underpins immersive training, digital twin synchronisation, and AI agent incubation. Simulation outputs are validated against empirical data and uncertainty quantified to ensure transferability of findings to the real world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
        [ a owl:Restriction ;
