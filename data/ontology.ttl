ngm:spatial-tracking-system a owl:Class ;
    rdfs:label "Spatial Tracking System"@en ;
    rdfs:comment "Technology for determining the six-degrees-of-freedom (6DOF) position and orientation of devices, controllers, or body parts in three-dimensional space, using visual-inertial SLAM, stereo cameras, and IMU sensors for precise real-time tracking in VR, AR, and mixed reality applications."@en ;
    rdfs:subClassOf ngm:motion-tracking,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:precise-spatial-positioning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-tracking-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:speculative-decoding a owl:Class ;
    rdfs:label "Speculative Decoding"@en ;
    rdfs:comment "Speculative decoding is an LLM inference acceleration technique that exploits the observation that a smaller, faster draft model can propose plausible multi-token continuations which a larger, higher-quality target model verifies in a single parallel forward pass. Accepted tokens are committed; rejected tokens are discarded, and generation resumes from the rejection point. Because the target model evaluates multiple candidate tokens simultaneously rather than autoregressively one at a time, the effective throughput in tokens per second increases substantially—often two to four times—while the output distribution remains statistically identical to that of the target model running alone. Speculative decoding is particularly effective when the draft and target models share a vocabulary and the task distribution is predictable."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:inference-hardware ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:model-compression-for-edge ;
    vc:slug "speculative-decoding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference,
        ngm:large-language-models .

ngm:spot-bitcoin-etf a owl:Class ;
    rdfs:label "Spot Bitcoin ETF"@en ;
    rdfs:comment "A spot Bitcoin ETF is an exchange-traded fund that holds actual bitcoin and tracks its price directly, allowing investors to gain exposure through ordinary brokerage accounts without holding the asset or managing private keys. Approved by the US SEC in January 2024 after years of rejection, spot Bitcoin ETFs differ from earlier futures-based products by holding the underlying coin in regulated custody. They have channelled substantial institutional and retail capital into bitcoin and are widely regarded as a milestone in the asset's mainstream financial integration."@en ;
    rdfs:subClassOf ngm:exchange-traded-fund ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:financial-regulation,
        ngm:securities-regulation ;
    vc:slug "spot-bitcoin-etf" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:institutional-investment .

ngm:stacks a owl:Class ;
    rdfs:label "Stacks"@en ;
    rdfs:comment "A Bitcoin Layer that enables smart contracts and applications whose state is anchored to the Bitcoin blockchain through its proof-of-transfer consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:bitcoin ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin,
        ngm:consensus-protocol ;
    vc:slug "stacks" ;
    vc:sourceDomain "blockchain" .

ngm:standards-conformance a owl:Class ;
    rdfs:label "Standards Conformance"@en ;
    rdfs:comment "The state or process of meeting the requirements specified in a technical standard, specification, or guideline, ensuring that a product, process, or system aligns with internal or industry-specific standards for interoperability, quality, and compatibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:interoperability,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:standards-conformance-testing ;
    vc:requires ngm:technical-standards ;
    vc:slug "standards-conformance" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards-body .

ngm:standards-organization a owl:Class ;
    rdfs:label "Standards Organization"@en ;
    rdfs:comment "Standards Organization is an artificial intelligence concept."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:artificial-intelligence ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "standards-organization" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:state-observer a owl:Class ;
    rdfs:label "State Observer"@en ;
    rdfs:comment "A state observer is a dynamical system that estimates the internal state of a controlled plant from its measured inputs and outputs when the full state cannot be directly sensed. By running a model of the plant in parallel and correcting it with the measurement error, an observer reconstructs unmeasured variables for use in feedback control. Classical examples include the Luenberger observer for deterministic systems and the Kalman filter for stochastic systems, making observers essential to state-feedback control of partially observable processes."@en ;
    rdfs:subClassOf ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-theory ;
    vc:slug "state-observer" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:control-system,
        ngm:optimal-control ;
    vc:uses ngm:kalman-filter .

ngm:state-space a owl:Class ;
    rdfs:label "State Space"@en ;
    rdfs:comment "A state space is the mathematical set of all possible configurations (states) of a dynamical system, together with the transition rules that govern how the system evolves from one state to another over time. In control theory it is represented by first-order differential or difference equations relating state variables, inputs, and outputs; in artificial intelligence it denotes the complete set of system configurations that a search or planning algorithm may explore."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:enables ngm:optimal-control,
        ngm:reinforcement-learning,
        ngm:system-identification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:recurrent-neural-network,
        ngm:time-series-analysis ;
    vc:slug "state-space" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:state-observer ;
    vc:uses ngm:hidden-state,
        ngm:kalman-filter,
        ngm:state-estimation .

ngm:subword-tokenisation a owl:Class ;
    rdfs:label "Subword Tokenisation"@en ;
    rdfs:comment "A tokenisation strategy that segments text into sub-word units (via algorithms such as Byte-Pair Encoding, WordPiece, or SentencePiece), balancing vocabulary size against the ability to represent rare, morphologically complex, and out-of-vocabulary words. Subword tokenisation is the de facto standard preprocessing step for large language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:natural-language-understanding ;
    vc:requires ngm:language-modeling ;
    vc:slug "subword-tokenisation" ;
    vc:sourceDomain "spatial-computing" .

ngm:supply-cap a owl:Class ;
    rdfs:label "Supply Cap"@en ;
    rdfs:comment "A Supply Cap is a hard-coded or governance-determined upper bound on the total number of tokens or coins that will ever be issued by a blockchain protocol, creating a form of programmatic scarcity that underpins deflationary monetary policy. Bitcoin's 21 million coin cap is the canonical example, encoded in the protocol's halvening schedule and providing a predictable issuance curve. Supply caps differentiate blockchain-native assets from fiat currencies and influence long-run security models, since block rewards approach zero as the cap is neared and transaction fees must compensate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:fee-market ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:bitcoin-standard,
        ngm:bitcoin-value-proposition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circulating-supply,
        ngm:cryptocurrency,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:requires ngm:block-reward,
        ngm:consensus-algorithm ;
    vc:slug "supply-cap" ;
    vc:sourceDomain "blockchain" .

ngm:target-tracking a owl:Class ;
    rdfs:label "Target Tracking"@en ;
    rdfs:comment "Target tracking is a computational and signal-processing discipline concerned with estimating the state — typically position, velocity, and orientation — of one or more moving objects over time from sequences of noisy sensor observations. It encompasses algorithms such as Kalman filters, particle filters, and multi-hypothesis trackers, applied across radar, sonar, computer vision, and LiDAR modalities. Applications span aerospace surveillance, autonomous vehicle perception, robotic manipulation, sports analytics, and augmented reality. Modern deep-learning-based trackers jointly perform detection and tracking, achieving robust performance in complex, cluttered environments."@en ;
    rdfs:subClassOf ngm:object-detection-and-tracking ;
    vc:enables ngm:anomaly-detection,
        ngm:human-tracking-and-slam-capture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:motion-tracking,
        ngm:object-detection,
        ngm:sensor-fusion ;
    vc:slug "target-tracking" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:spatial-tracking-system,
        ngm:trajectory-tracking .

ngm:technical-documentation a owl:Class ;
    rdfs:label "Technical Documentation"@en ;
    rdfs:comment "Technical documentation is the body of written material that explains how to use, operate, maintain, or build a product or system, spanning API references, user guides, architecture documents, runbooks, and specifications. Good technical documentation reduces onboarding time, encodes institutional knowledge, supports interoperability, and is increasingly treated as a versioned, tested artefact within the docs-as-code discipline. It is essential to the adoption and maintainability of software, hardware, and standards, and serves as a primary source for both human understanding and machine consumption."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:standards-body ;
    vc:slug "technical-documentation" ;
    vc:sourceDomain "knowledge" ;
    vc:supports ngm:interoperability,
        ngm:open-standard .

ngm:technology-ecosystem a owl:Class ;
    rdfs:label "Technology Ecosystem"@en ;
    rdfs:comment "A Technology Ecosystem is the interconnected network of platforms, developer tools, standards bodies, runtime environments, and community participants that collectively sustain a technology domain. In the metaverse context it encompasses rendering engines, spatial-computing SDKs, open standards (OpenXR, USD, WebXR), cloud infrastructure, hardware manufacturers, and application developers whose interdependencies determine adoption trajectories and competitive dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technology-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:adoption-of-convergent-technologies,
        ngm:convergence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:open-standard,
        ngm:technology-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-domain,
        ngm:spatial-computing ;
    vc:slug "technology-ecosystem" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-system .

ngm:telemetry-and-analytics a owl:Class ;
    rdfs:label "Telemetry & Analytics"@en ;
    rdfs:comment "Systematic collection and analysis of usage and performance data from metaverse applications and platforms to enable monitoring, optimization, and decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usage-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:performance-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analytics-engine ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:capacity-planning,
        ngm:performance-optimization,
        ngm:quality-assurance,
        ngm:user-behavior-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-collection-pipeline,
        ngm:monitoring-dashboard,
        ngm:performance-metrics,
        ngm:usage-analytics ;
    vc:isPartOf ngm:data-management ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:analytics-engine,
        ngm:data-storage,
        ngm:event-logging ;
    vc:slug "telemetry-and-analytics" ;
    vc:sourceDomain "spatial-computing" .

ngm:tensor-processing-unit a owl:Class ;
    rdfs:label "Tensor Processing Unit"@en ;
    rdfs:comment "Tensor Processing Unit is a artificial intelligence concept and a type of Inference Hardware. that enables Large Language Models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:inference-hardware ;
    vc:enables ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "tensor-processing-unit" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:testing-infrastructure a owl:Class ;
    rdfs:label "Testing Infrastructure"@en ;
    rdfs:comment "The ensemble of tools, environments, frameworks, and automated pipelines used to validate software correctness, performance, and reliability across development and deployment stages. Testing infrastructure encompasses unit, integration, and end-to-end test runners, continuous integration services, containerised test environments, and monitoring dashboards that together ensure software meets quality standards before release."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:infra-software-engineering,
        ngm:quality-assurance ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:testing-process ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:monitoring-dashboard,
        ngm:software-testing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-security ;
    vc:slug "testing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:quality-assurance .

ngm:thread-protocol a owl:Class ;
    rdfs:label "Thread Protocol"@en ;
    rdfs:comment "Thread is an IPv6-based, low-power wireless mesh networking protocol designed for IoT devices in home and commercial environments, using IEEE 802.15.4 as its radio layer and providing self-healing, self-configuring mesh topology with native IP routing, secure device commissioning, and no single point of failure. Thread is managed by the Thread Group and forms the network and transport foundation for the Matter smart-home application protocol."@en ;
    rdfs:subClassOf ngm:ieee-802-15-4 ;
    vc:contrastsWith ngm:zigbee ;
    vc:enables ngm:matter-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:mesh-routing-software,
        ngm:wireless-radio ;
    vc:slug "thread-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:network-layer .

ngm:threat-actor a owl:Class ;
    rdfs:label "Threat Actor"@en ;
    rdfs:comment "A Threat Actor is an individual, organised group, or nation-state entity that possesses the intent, capability, and opportunity to exploit vulnerabilities in digital systems. Actors are classified by motivation (financial, ideological, strategic, personal) and sophistication tier (opportunistic script-kiddies through state-sponsored APTs), with attribution performed via TTPs, infrastructure patterns, and targeting behaviour."@en ;
    rdfs:subClassOf ngm:attack-vector,
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:resilience,
        ngm:security ;
    vc:enables ngm:security-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:risk ;
    vc:slug "threat-actor" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:attack-vector,
        ngm:vulnerability .

ngm:threat-detection a owl:Class ;
    rdfs:label "Threat Detection"@en ;
    rdfs:comment "Threat detection is the cybersecurity discipline concerned with identifying malicious or anomalous activity within a system or network in time to enable an effective defensive response, distinguishing genuine threats from benign anomalies across high-volume, noisy telemetry. It encompasses signature-based detection of known attack patterns, behavioural analytics for novel threats, and machine learning models that model normal system baselines and flag statistical deviations. Effective threat detection must balance sensitivity (catching real attacks) against specificity (avoiding alert fatigue from false positives)."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:enables ngm:incident-response,
        ngm:threat-surface-map ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:attack-vector,
        ngm:threat-actor,
        ngm:threat-model ;
    vc:slug "threat-detection" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:information-security,
        ngm:network-security ;
    vc:uses ngm:ai-security .

ngm:timelock-controller a owl:Class ;
    rdfs:label "Timelock Controller"@en ;
    rdfs:comment "A timelock controller is a smart contract governance primitive that enforces a mandatory waiting period — the timelock delay — between the scheduling of an on-chain operation (such as a protocol upgrade, parameter change, or treasury disbursement) and its execution, giving token holders, security researchers, and affected parties an opportunity to review, object to, or exit before the change takes effect. Operations must be queued with their full parameters, remain in the queue for the configured delay, and then be explicitly executed; they may also be cancelled by authorised roles during the waiting period. Timelock controllers are a fundamental safety mechanism in DeFi and DAO governance, protecting against malicious or erroneous governance proposals."@en ;
    rdfs:subClassOf ngm:on-chain-governance ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:hash-time-locked-contract,
        ngm:open-zeppelin-governor,
        ngm:smart-contract ;
    vc:slug "timelock-controller" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:proposal-system,
        ngm:voting-mechanism .

ngm:timestamp-service a owl:Class ;
    rdfs:label "Timestamp Service"@en ;
    rdfs:comment "A timestamp service issues verifiable evidence that a particular piece of data existed at or before a specific point in time, without revealing the data's contents. It accepts the hash of a document, binds it to a trusted time reference, and returns a signed timestamp token that anyone can later verify. Timestamp services support non-repudiation, intellectual-property priority, regulatory record-keeping, and long-term signature validation, and may be anchored in a trusted timestamp authority or in a public blockchain for trust-minimised proof of existence."@en ;
    rdfs:subClassOf ngm:timestamping-service ;
    vc:enables ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:trusted-timestamping ;
    vc:slug "timestamp-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hash-function,
        ngm:timestamp-authority .

ngm:tls-1-3 a owl:Class ;
    rdfs:label "TLS 1.3"@en ;
    rdfs:comment "TLS 1.3 (Transport Layer Security version 1.3, standardised in RFC 8446, August 2018) is the current major version of the TLS protocol, redesigned to eliminate legacy cryptographic weaknesses, reduce handshake round-trips from two to one (zero for session resumption), mandate forward secrecy on every connection, and restrict the cipher suite to a small set of authenticated encryption algorithms. It replaces TLS 1.2 as the baseline secure transport for HTTPS, QUIC, and virtually all authenticated internet communications."@en ;
    rdfs:subClassOf ngm:encryption-protocol,
        ngm:transport-layer-security ;
    vc:enables ngm:network-security,
        ngm:quic ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-transparency ;
    vc:slug "tls-1-3" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf ;
    vc:uses ngm:cryptography,
        ngm:key-exchange .

ngm:tokenizer a owl:Class ;
    rdfs:label "Tokenizer"@en ;
    rdfs:comment "A tokenizer is the component that converts raw text into the discrete units (tokens) a language model processes, and back again. Modern tokenizers use subword algorithms such as byte-pair encoding, WordPiece, or unigram language models to balance vocabulary size against sequence length, representing common words as single tokens and rare words as compositions of smaller pieces. The tokenizer defines the model's vocabulary and directly affects context-window usage, multilingual fairness, handling of code and numbers, and ultimately the cost and capability of the system."@en ;
    rdfs:subClassOf ngm:tokenization ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning ;
    vc:slug "tokenizer" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:transformer .

ngm:total-supply a owl:Class ;
    rdfs:label "Total Supply"@en ;
    rdfs:comment "Total Supply is the count of all tokens that have ever been created on a blockchain network, encompassing circulating tokens, locked or vested tokens, tokens held in treasury reserves, and any tokens that have been minted but not yet distributed—but excluding permanently destroyed (burned) tokens. It differs from the maximum supply (the hard cap set by the protocol) and from circulating supply (tokens freely tradeable on secondary markets). Total supply is a fundamental parameter in tokenomics analysis used to assess inflation, dilution, and long-term value dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circulating-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-cap ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:circulating-supply ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deflationary-token,
        ngm:halving,
        ngm:inflation,
        ngm:inflationary-token,
        ngm:market-capitalization,
        ngm:tokenomics,
        ngm:treasury-management ;
    vc:requires ngm:emission-schedule,
        ngm:supply-cap ;
    vc:slug "total-supply" ;
    vc:sourceDomain "blockchain" .

ngm:trade-finance-automation a owl:Class ;
    rdfs:label "Trade Finance Automation"@en ;
    rdfs:comment "Trade Finance Automation is the application of digital technologies—including blockchain-based smart contracts, AI-driven document processing, and electronic data interchange—to streamline and accelerate the complex financial instruments and workflows that facilitate international commerce. Traditional trade finance relies on paper-intensive instruments such as letters of credit, bills of lading, and documentary collections, which are slow, error-prone, and costly to process. Automation replaces manual document verification with machine-readable structured data, triggers payment obligations automatically upon verified delivery conditions, and reduces counterparty risk through distributed ledger transparency. The result is faster settlement, lower operational costs, and improved access to working capital for exporters and importers globally."@en ;
    rdfs:subClassOf ngm:trade-finance ;
    vc:enables ngm:cross-border-payments,
        ngm:logistics-optimization,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:customs-trade-facilitation,
        ngm:financial-instruments,
        ngm:supply-chain-blockchain ;
    vc:slug "trade-finance-automation" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:blockchain,
        ngm:enterprise-smart-contracts,
        ngm:smart-contract,
        ngm:supply-chain-traceability .

ngm:training-layer a owl:Class ;
    rdfs:label "Training Layer"@en ;
    rdfs:comment "The Training Layer is the stratum that fits model parameters from data using optimisation procedures. It sits above the Compute and Data strata it consumes and below the Model and Foundation Model strata that hold its results. It contains training loops, optimisers, loss functions, and the orchestration of large-scale learning runs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-layer ],
        ngm:owl-thing ;
    vc:enables ngm:foundation-model-layer,
        ngm:model-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:data-layer ;
    vc:slug "training-layer" ;
    vc:sourceDomain "training" .

ngm:transaction-history a owl:Class ;
    rdfs:label "Transaction History"@en ;
    rdfs:comment "Transaction history is the ordered, append-only record of all value transfers, state changes, or operations executed within a financial or data system, providing a tamper-evident chronological account of who transacted what, with whom, and when. In blockchain systems, transaction history is the fundamental data structure underpinning the distributed ledger — every confirmed block links to its predecessor through cryptographic hashing, making retroactive alteration of any transaction computationally prohibitive. Transaction history serves audit, compliance, forensic, tax, and portfolio analytics functions across both traditional and decentralised financial systems."@en ;
    rdfs:subClassOf ngm:blockchain-transaction ;
    vc:enables ngm:blockchain-analytics,
        ngm:blockchain-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:financial-transactions,
        ngm:on-chain-governance ;
    vc:slug "transaction-history" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:audit-trail,
        ngm:blockchain,
        ngm:distributed-ledger .

ngm:urdf a owl:Class ;
    rdfs:label "URDF"@en ;
    rdfs:comment "Unified Robot Description Format (URDF) is an XML-based schema used within the Robot Operating System (ROS) ecosystem to fully specify a robot's physical structure, including its kinematic chain of links and joints, collision geometries, inertial properties, and sensor placements. URDF files serve as the authoritative model consumed by simulation environments such as Gazebo, motion planners, and visualisation tools like RViz, enabling consistent robot representation across software components. Each joint element declares its type (fixed, revolute, prismatic, continuous) along with axis, limits, and damping parameters, while link elements reference mesh geometry and material definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:gazebo-simulator,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint,
        ngm:robot-link ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "urdf" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-kinematics,
        ngm:robot-operating-system .

ngm:usd a owl:Class ;
    rdfs:label "USD"@en ;
    rdfs:comment "The United States dollar, the fiat currency issued by the United States and the dominant unit against which most digital assets and stablecoins are quoted and redeemed."@en ;
    rdfs:subClassOf ngm:money ;
    vc:enables ngm:usdc,
        ngm:usdt ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "usd" ;
    vc:sourceDomain "blockchain" .

ngm:user-authentication a owl:Class ;
    rdfs:label "User Authentication"@en ;
    rdfs:comment "User authentication is the process of verifying that a person claiming a digital identity is who they assert to be, by validating one or more authentication factors: something they know (password, PIN), something they have (hardware token, mobile device), or something they are (biometric). It is the gateway control between unauthenticated network access and authorised use of a system or resource, and its assurance level — defined by standards such as NIST SP 800-63 — must be calibrated to the sensitivity of protected resources. Modern implementations favour phishing-resistant factors (passkeys, hardware security keys) over knowledge-based authentication."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:identity-and-access-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:passwordless-authentication ;
    vc:slug "user-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:fido2,
        ngm:oauth-2-0,
        ngm:web-authn .

ngm:validator-economics a owl:Class ;
    rdfs:label "Validator Economics"@en ;
    rdfs:comment "Validator economics describes the incentive structures, cost-reward equilibria, and rational behaviour models governing participants who operate validator nodes in proof-of-stake and delegated consensus blockchain networks. It encompasses staking rewards (block rewards, transaction fees, MEV capture), slashing penalties for Byzantine behaviour (double-signing, downtime), the competitive market for delegated stake, operational costs (hardware, bandwidth, maintenance), and the resulting equilibrium between security budget, validator profitability, and network decentralisation. Well-designed validator economics align individual rational self-interest with network security and liveness."@en ;
    rdfs:subClassOf ngm:blockchain-economics ;
    vc:enables ngm:decentralized-governance,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:delegated-proof-of-stake,
        ngm:incentive-alignment,
        ngm:token-economics,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "validator-economics" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-reward,
        ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:tokenomics .

ngm:value-function a owl:Class ;
    rdfs:label "Value Function"@en ;
    rdfs:comment "A value function in reinforcement learning estimates the expected cumulative future reward obtainable from a given state (state-value) or state-action pair (action-value) under a particular policy. It captures the long-term desirability of situations rather than immediate reward, and satisfies the recursive Bellman equation that relates the value of a state to the values of its successors. Value functions are central to dynamic programming, temporal-difference learning, and actor-critic methods, providing the signal that guides an agent toward reward-maximising behaviour."@en ;
    rdfs:subClassOf ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:machine-learning ;
    vc:slug "value-function" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:optimal-control ;
    vc:uses ngm:markov-decision-process .

ngm:vector-embedding a owl:Class ;
    rdfs:label "Vector Embedding"@en ;
    rdfs:comment "A vector embedding is a dense, fixed-length numerical representation of a discrete object — a word, sentence, image, or user — in a continuous high-dimensional space, learned such that semantically similar objects map to nearby points. Embeddings convert unstructured data into a form amenable to mathematical operations like distance and dot product, enabling similarity search, clustering, recommendation, and retrieval. They are produced by neural encoders and are the representational substrate beneath modern search, retrieval-augmented generation, and multimodal AI."@en ;
    rdfs:subClassOf ngm:embedding ;
    vc:enables ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "vector-embedding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding-model .

ngm:verifiable-credential-standard a owl:Class ;
    rdfs:label "Verifiable Credential Standard"@en ;
    rdfs:comment "The W3C Verifiable Credentials Data Model specification defines a structured, cryptographically verifiable format for expressing claims about subjects. Credentials are issued by a trusted issuer, held by a subject, and verified by relying parties using digital signatures and Decentralized Identifiers (DIDs), enabling portable, privacy-preserving identity across metaverse and web platforms without centralised databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:digital-identity,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:interoperability-standard ;
    vc:requires ngm:cryptography,
        ngm:decentralized-identifiers ;
    vc:slug "verifiable-credential-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards .

ngm:verifiable-credential-vc a owl:Class ;
    rdfs:label "Verifiable Credential (VC)"@en ;
    rdfs:comment "A W3C standard for tamper-evident credentials that can be cryptographically verified, containing claims made by an issuer about a subject, enabling trustable digital attestations without requiring direct communication with the issuer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identity-did ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:privacy-preserving-verification,
        ngm:selective-disclosure,
        ngm:trustable-attestations,
        ngm:verifiable-presentations ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:claim,
        ngm:credential-metadata,
        ngm:credential-schema,
        ngm:cryptographic-proof,
        ngm:issuer-signature ;
    vc:isPartOf ngm:self-sovereign-identity-ssi,
        ngm:trust-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:decentralized-identity-did,
        ngm:digital-signature,
        ngm:identity-wallet,
        ngm:public-key-infrastructure ;
    vc:slug "verifiable-credential-vc" ;
    vc:sourceDomain "spatial-computing" .

ngm:vesting-schedule a owl:Class ;
    rdfs:label "Vesting Schedule"@en ;
    rdfs:comment "A predefined timetable that releases allocated tokens to recipients gradually over time, often after an initial cliff period, rather than all at once."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract ;
    vc:slug "vesting-schedule" ;
    vc:sourceDomain "blockchain" .

ngm:video-processing a owl:Class ;
    rdfs:label "Video Processing"@en ;
    rdfs:comment "The computational analysis, understanding, and manipulation of video data using machine learning and computer vision techniques. Core tasks include object detection and tracking, semantic segmentation, action recognition, temporal modelling, and scene understanding. Modern approaches employ 3D convolutional networks, vision transformers, and self-supervised learning on large-scale video datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:instance-segmentation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "video-processing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:transformer .

ngm:virtual-camera a owl:Class ;
    rdfs:label "Virtual Camera"@en ;
    rdfs:comment "A simulated camera system in virtual production environments that captures real-time virtual scenes, enabling filmmakers to visualise and shoot CG environments as though using a physical camera with real-world lens characteristics — including focal length, aperture, and depth-of-field — and six-DoF movement tracking. It integrates with motion capture rigs, LED volume stages, and game engines to deliver live compositing preview and Genlock-synchronised output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:sc-display-and-rendering,
        ngm:virtual-production ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:virtual-production-pipeline,
        ngm:virtual-scouting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-stage ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:motion-capture,
        ngm:real-time-rendering ;
    vc:slug "virtual-camera" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:virtual-production-volume .

ngm:virtual-commerce a owl:Class ;
    rdfs:label "Virtual Commerce"@en ;
    rdfs:comment "An emerging form of e-commerce (V-commerce) that enables buying and selling of goods and services within virtual reality environments, including virtual storefronts, enhanced product visualization, social shopping experiences, and immersive customer-product interactions in metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-platform-and-environment,
        ngm:virtual-economy ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:e-commerce ;
    vc:enables ngm:digital-marketplace,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:digital-currency,
        ngm:smart-contract ;
    vc:slug "virtual-commerce" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-community-platform a owl:Class ;
    rdfs:label "Virtual Community Platform"@en ;
    rdfs:comment "Spatial computing platforms that enable users to create and interact within immersive 3D virtual environments as digital avatars, supporting social interaction, community building, collaborative activities, and shared experiences across geographic boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-world-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:social-vr,
        ngm:virtual-concerts ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-platform,
        ngm:virtual-community-practice ;
    vc:requires ngm:avatar-system,
        ngm:virtual-world-infrastructure ;
    vc:slug "virtual-community-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-moderation,
        ngm:virtual-identity .

ngm:virtual-economy-infrastructure a owl:Class ;
    rdfs:label "Virtual Economy Infrastructure"@en ;
    rdfs:comment "The collection of technologies, platforms, and systems essential for creating, managing, and sustaining economic activities within metaverse environments, including blockchain networks, payment systems, marketplaces, and decentralized finance protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft-marketplace ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-finance-de-fi ],
        ngm:infra-computing-and-cloud,
        ngm:virtual-economy ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-asset-trading,
        ngm:virtual-currency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:blockchain,
        ngm:decentralized-finance-de-fi,
        ngm:nft-marketplace ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance ;
    vc:slug "virtual-economy-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:virtual-identity a owl:Class ;
    rdfs:label "Virtual Identity"@en ;
    rdfs:comment "A digital representation encompassing behaviours, preferences, movements, actions, and decisions made in digital spaces, extending beyond 3D avatars to include representation, data, and identification across AR, VR, MR, and web platforms using decentralized identity technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:personal-data-store ],
        ngm:digital-identity,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-management,
        ngm:privacy ;
    vc:requires ngm:authentication,
        ngm:personal-data-store ;
    vc:slug "virtual-identity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:avatar-portability,
        ngm:avatar-system,
        ngm:decentralized-identifiers .

ngm:virtual-stage a owl:Class ;
    rdfs:label "Virtual Stage"@en ;
    rdfs:comment "A production environment surrounded by curved LED walls and floors displaying real-time computer-generated imagery, enabling in-camera visual effects (ICVFX) for film, television, and broadcast production. Digital backgrounds rendered by a game engine react dynamically to tracked camera movement, capturing realistic lighting and reflections directly on-sensor. Epic Games' StageCraft system and Unreal Engine power the majority of commercial installations, with facilities now exceeding 1,700 m² of LED surface area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-volume ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vr-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-camera ],
        ngm:production-facility,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-production,
        ngm:virtual-production-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:virtual-camera,
        ngm:virtual-production-volume ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering,
        ngm:vr-rendering-engine ;
    vc:slug "virtual-stage" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:motion-capture .

ngm:virtual-workspace a owl:Class ;
    rdfs:label "Virtual Workspace"@en ;
    rdfs:comment "A Virtual Workspace is a spatially organised digital environment — typically experienced through XR headsets or desktop 3D interfaces — that replicates or enhances the collaborative and cognitive functions of a physical office. It supports remote collaboration, persistent shared artefacts, spatial audio, and embodied presence, addressing the limitations of flat video-conferencing for complex knowledge work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:knowledge-management,
        ngm:remote-collaboration,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:social-vr,
        ngm:virtual-world ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "virtual-workspace" ;
    vc:sourceDomain "spatial-computing" .

ngm:volume-rendering a owl:Class ;
    rdfs:label "Volume Rendering"@en ;
    rdfs:comment "Volume rendering produces images directly from three-dimensional scalar or density fields by integrating colour and opacity along view rays, rather than rendering explicit surfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        ngm:computer-graphics ;
    vc:enables ngm:neural-radiance-fields ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:graphics-pipeline ;
    vc:slug "volume-rendering" ;
    vc:sourceDomain "metaverse" .

ngm:vote-escrow-model a owl:Class ;
    rdfs:label "Vote-Escrow Model"@en ;
    rdfs:comment "The vote-escrow model is a DeFi tokenomics mechanism in which holders of a governance token lock their tokens for a chosen duration — typically up to four years — in exchange for a non-transferable vote-escrow token (such as veCRV in Curve Finance) that grants proportional governance voting power and fee-sharing rights, with voting weight decaying linearly as the lock approaches expiry, aligning token holder incentives with long-term protocol health by penalising short-term speculation. The model was pioneered by Curve Finance and subsequently adopted across dozens of DeFi protocols, spawning meta-governance layers such as Convex Finance that aggregate and direct veToken voting power."@en ;
    rdfs:subClassOf ngm:tokenomics ;
    vc:enables ngm:liquidity-mining,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:convex-finance,
        ngm:token-economics,
        ngm:tokenomics-governance ;
    vc:slug "vote-escrow-model" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:governance-token,
        ngm:on-chain-governance .

ngm:vr-controllers a owl:Class ;
    rdfs:label "VR Controllers"@en ;
    rdfs:comment "Handheld input devices designed for virtual reality systems that enable users to interact with virtual environments through motion tracking, buttons, triggers, and haptic feedback, providing intuitive manipulation of virtual objects and navigation through immersive spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-tracking ],
        ngm:sc-interaction,
        ngm:xr-hardware ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:hand-tracking,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:haptic-feedback,
        ngm:motion-tracking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction ;
    vc:slug "vr-controllers" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:virtual-reality-vr .

ngm:vulnerability-scanner a owl:Class ;
    rdfs:label "Vulnerability Scanner"@en ;
    rdfs:comment "A vulnerability scanner is a tool that inspects systems, networks or applications to identify known security weaknesses. It compares discovered software and configurations against databases of disclosed vulnerabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:vulnerability ;
    vc:enables ngm:penetration-testing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:vulnerability ;
    vc:slug "vulnerability-scanner" ;
    vc:sourceDomain "security" .

ngm:web-technology a owl:Class ;
    rdfs:label "Web Technology"@en ;
    rdfs:comment "The distributed infrastructure, protocols, and frameworks underpinning the World Wide Web and decentralised Web3 applications, including content-addressed storage (IPFS), blockchain naming systems (ENS), decentralised identity (DIDs), and smart-contract-governed application hosting that shifts data ownership from centralised providers to users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web3 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipfs ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ens ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:content-addressing,
        ngm:decentralised-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ens,
        ngm:ipfs,
        ngm:web3 ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "web-technology" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:decentralized-storage,
        ngm:smart-contract .

ngm:wheeled-mobile-robot a owl:Class ;
    rdfs:label "Wheeled Mobile Robot"@en ;
    rdfs:comment "A mobile robot that uses wheels as its primary locomotion mechanism, enabling efficient navigation on flat or structured surfaces. Wheeled mobile robots span applications from industrial logistics and warehouse automation to outdoor infrastructure maintenance, typically combining SLAM-based navigation, sensor fusion, and modular payloads."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot,
        ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "wheeled-mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:sensor-fusion,
        ngm:slam .

ngm:wheeled-robot a owl:Class ;
    rdfs:label "Wheeled Robot"@en ;
    rdfs:comment "A Wheeled Robot is a mobile robot platform that uses wheels as its primary locomotion mechanism. Wheeled robots offer high energy efficiency and speed on flat terrain, making them dominant in warehouse automation, last-mile delivery, and research platforms. Differential drive, omnidirectional, and car-like Ackermann steering configurations each present distinct kinematic constraints that influence navigation algorithm design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:odometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:navigation,
        ngm:odometry ;
    vc:slug "wheeled-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:slam .

ngm:wrapped-token a owl:Class ;
    rdfs:label "Wrapped Token"@en ;
    rdfs:comment "A Wrapped Token is a digital asset on one blockchain that represents, at a 1:1 peg, an asset from a different blockchain or currency system, created by locking the original asset in a custody mechanism (custodian, bridge smart contract, or MPC wallet) and minting an equivalent representation on the target chain. Wrapped tokens enable cross-chain liquidity by making assets from non-smart-contract blockchains (such as Bitcoin) or from other chains available within DeFi ecosystems. WBTC (Wrapped Bitcoin on Ethereum, ERC-20) is the canonical example, allowing Bitcoin to participate in Ethereum-based lending, trading, and yield protocols. Wrapped tokens introduce custodial or bridge risk as the peg relies on the integrity of the locking and minting mechanism."@en ;
    rdfs:subClassOf ngm:cryptocurrency-token ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:decentralized-exchange,
        ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:cross-chain-bridge ;
    vc:slug "wrapped-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-20,
        ngm:smart-contract .

ngm:xr-headset a owl:Class ;
    rdfs:label "XR Headset"@en ;
    rdfs:comment "A head-mounted display device that delivers immersive visual and audio experiences for virtual reality, augmented reality, or mixed reality applications, featuring integrated displays, tracking sensors, audio systems, and processing capabilities for rendering digital content in the user's field of view."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-xr-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-display-and-rendering,
        ngm:xr-hardware ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:wearable-computing-platform ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:web-xr-api ;
    vc:slug "xr-headset" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-li-dar a owl:Class ;
    rdfs:label "3D LiDAR"@en ;
    rdfs:comment "3D LiDAR is a active ranging sensor that emits pulsed laser light across multiple vertical channels to capture dense three-dimensional point clouds of the surrounding environment. Spinning or solid-state variants measure range and intensity for hundreds of thousands of points per second, enabling robots and autonomous vehicles to perform obstacle detection, SLAM, and high-fidelity scene reconstruction in real time."@en ;
    rdfs:subClassOf ngm:lidar,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:simultaneous-localisation-and-mapping,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:2-d-li-dar,
        ngm:lidar-scanning,
        ngm:multirotor-uav,
        ngm:stereo-camera ;
    vc:slug "3-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:perception-system,
        ngm:sensor-fusion .

ngm:5-g-connectivity a owl:Class ;
    rdfs:label "5G Connectivity"@en ;
    rdfs:comment "5G Connectivity is the set of radio access and core network capabilities delivered by a 5G NR network that provides devices and applications with wireless communication services characterised by high throughput, ultra-low latency, and high device density. It encompasses the radio link between user equipment and the gNB base station, quality-of-service mechanisms, network slicing for application-specific service guarantees, and the APIs through which applications access network capabilities. 5G Connectivity is a critical enabler for cloud XR, autonomous systems, and real-time industrial applications."@en ;
    rdfs:subClassOf ngm:5-g ;
    vc:enables ngm:io-t-infrastructure,
        ngm:low-latency,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-gpp,
        ngm:guaranteed-bandwidth,
        ngm:latency ;
    vc:slug "5-g-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization .

ngm:MaturityLevel a owl:Class ;
    rdfs:label "Maturity Level"@en .

ngm:adaptive-learning a owl:Class ;
    rdfs:label "Adaptive Learning"@en ;
    rdfs:comment "Adaptive learning is an educational methodology and technology paradigm in which instructional content, pacing, and assessment are dynamically tailored to each learner's demonstrated knowledge, learning style, and progress in real time. Computational systems analyse performance data to identify gaps and misconceptions, then serve personalised learning paths that optimise for mastery and engagement. The approach draws on psychometric theory, knowledge tracing algorithms, and machine learning to individualise instruction at scale."@en ;
    rdfs:subClassOf ngm:education-technology ;
    vc:enables ngm:learning-analytics,
        ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:curriculum-learning ;
    vc:slug "adaptive-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:intelligent-tutoring-system,
        ngm:learning-management-system .

ngm:addressing-scheme a owl:Class ;
    rdfs:label "Addressing Scheme"@en ;
    rdfs:comment "An addressing scheme is a systematic convention for assigning, structuring, and resolving identifiers that locate resources, nodes, or content within a namespace. Schemes range from hierarchical and human-readable forms such as IP addresses and URLs to flat cryptographic forms such as content hashes and public-key fingerprints. The defining properties of an addressing scheme are its uniqueness guarantees, its resolution mechanism, and whether addresses are location-based, identity-based, or content-derived. Addressing schemes underpin routing, naming, and reference integrity across networked and decentralised systems."@en ;
    rdfs:subClassOf ngm:technique ;
    vc:enables ngm:content-identifier ;
    vc:hasMaturity ngmi:maturity-established ;
