        ngm:indexing,
        ngm:storage-architecture ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-systems-domain ;
    vc:slug "data-management-domain" ;
    vc:sourceDomain "data-management" .

ngm:dc-servo-motor a owl:Class ;
    rdfs:label "DC Servo Motor"@en ;
    rdfs:comment "DC servo motor combines a direct-current electric motor with integrated or external feedback control electronics to enable precise position, velocity, or torque regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-sensor ],
        [ a owl:Restriction ;
