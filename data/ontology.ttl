# Open-Loop Control
rb:OpenLoopControl a owl:Class ;
    rdfs:subClassOf rb:ControlSystem ;
    rdfs:label "Open-Loop Control"@en ;
    rdfs:comment "A control system where the control action is independent of the output. The system executes pre-programmed commands without feedback from sensors to verify if the desired state was achieved."@en ;
    skos:prefLabel "Open-Loop Control"@en ;
    dcterms:identifier "RB-1001" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.95"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:OpenLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:contrastsWith ;
    owl:someValuesFrom rb:RB1002closedloopcontrol
] .

rb:OpenLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:Actuator
] .

rb:OpenLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:StepperMotorControl
] .

rb:OpenLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:ServoControl
] .

# Closed-Loop Control
rb:ClosedLoopControl a owl:Class ;
    rdfs:subClassOf rb:ControlSystem ;
    rdfs:label "Closed-Loop Control"@en ;
    rdfs:comment "A control system that uses feedback from sensors to compare the actual output with the desired output and adjusts the control action to minimize error. The system continuously monitors and corrects its behavior."@en ;
    skos:prefLabel "Closed-Loop Control"@en ;
    dcterms:identifier "RB-1002" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.98"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RB1013localization
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RB1007trajectorygeneration
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:contrastsWith ;
    owl:someValuesFrom rb:RB1001openloopcontrol
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:SensorSystem
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:Controller
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:Actuator
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:implements ;
    owl:someValuesFrom rb:PIDControl
] .

rb:ClosedLoopControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:implements ;
    owl:someValuesFrom rb:RB1004adaptivecontrol
] .

# Optimal Control
rb:OptimalControl a owl:Class ;
    rdfs:subClassOf rb:RB1002closedloopcontrol ;
    rdfs:label "Optimal Control"@en ;
    rdfs:comment "A control strategy that determines control inputs to minimize or maximize a performance criterion (cost function) while satisfying system constraints. It seeks the best possible control policy according to specified objectives."@en ;
    skos:prefLabel "Optimal Control"@en ;
    dcterms:identifier "RB-1003" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.96"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:OptimalControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RB1007trajectorygeneration
] .

rb:OptimalControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:LinearQuadraticRegulator
] .

rb:OptimalControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:ModelPredictiveControl
] .

rb:OptimalControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:AutonomousVehicles
] .

rb:OptimalControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:SpacecraftControl
] .

# Adaptive Control
rb:AdaptiveControl a owl:Class ;
    rdfs:subClassOf rb:RB1002closedloopcontrol ;
    rdfs:label "Adaptive Control"@en ;
    rdfs:comment "A control strategy that automatically adjusts its parameters in real-time to maintain desired performance as system dynamics change or uncertainties are encountered. The controller learns and adapts to variations in the system or environment."@en ;
    skos:prefLabel "Adaptive Control"@en ;
    dcterms:identifier "RB-1004" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.95"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:AdaptiveControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RobustControl
] .

rb:AdaptiveControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:SelfTuningSystems
] .

rb:AdaptiveControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:SystemIdentification
] .

rb:AdaptiveControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:ParameterEstimation
] .

rb:AdaptiveControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:RB1011cobotsafetylevels
] .

rb:AdaptiveControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:AutonomousSystems
] .

# Forward Kinematics
rb:ForwardKinematics a owl:Class ;
    rdfs:subClassOf rb:Kinematics ;
    rdfs:label "Forward Kinematics"@en ;
    rdfs:comment "The process of determining the position and orientation of a robot's end-effector in Cartesian space given the joint parameters (angles or displacements). It maps from joint space to task space using geometric and trigonometric relationships."@en ;
    skos:prefLabel "Forward Kinematics"@en ;
    dcterms:identifier "RB-1005" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.98"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:ForwardKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RobotSimulation
] .

rb:ForwardKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:MotionVisualization
] .

rb:ForwardKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:inverseOf ;
    owl:someValuesFrom rb:RB1006inversekinematics
] .

rb:ForwardKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:TransformationMatrix
] .

rb:ForwardKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:HomogeneousCoordinates
] .

# Inverse Kinematics
rb:InverseKinematics a owl:Class ;
    rdfs:subClassOf rb:Kinematics ;
    rdfs:label "Inverse Kinematics"@en ;
    rdfs:comment "The process of determining the joint parameters (angles or displacements) required to place a robot's end-effector at a desired position and orientation in Cartesian space. It maps from task space to joint space."@en ;
    skos:prefLabel "Inverse Kinematics"@en ;
    dcterms:identifier "RB-1006" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.97"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RB1016pathplanning
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RobotControl
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:inverseOf ;
    owl:someValuesFrom rb:RB1005forwardkinematics
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:NumericalMethods
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:AnalyticalMethods
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:JacobianMatrix
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:challenges ;
    owl:someValuesFrom rb:Singularities
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:challenges ;
    owl:someValuesFrom rb:JointLimits
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedTo ;
    owl:someValuesFrom rb:RB0003manipulator
] .

rb:InverseKinematics rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedTo ;
    owl:someValuesFrom rb:RB0004humanoidrobot
] .

# Trajectory Generation
rb:TrajectoryGeneration a owl:Class ;
    rdfs:subClassOf rb:MotionPlanning ;
    rdfs:label "Trajectory Generation"@en ;
    rdfs:comment "The process of computing a time-parameterized path that specifies the position, velocity, and acceleration of a robot's joints or end-effector as functions of time, enabling smooth motion from start to goal configurations while respecting kinematic and dynamic constraints."@en ;
    skos:prefLabel "Trajectory Generation"@en ;
    dcterms:identifier "RB-1007" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.96"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom rb:RB1016pathplanning
] .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RobotMotion
] .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:TaskExecution
] .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1005forwardkinematics
] .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1006inversekinematics
] .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:IndustrialAutomation
] .

rb:TrajectoryGeneration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:AutonomousVehicles
] .

# Odometry
rb:Odometry a owl:Class ;
    rdfs:subClassOf rb:StateEstimation ;
    rdfs:label "Odometry"@en ;
    rdfs:comment "The estimation of a mobile robot's position and orientation (pose) over time by integrating motion measurements from wheel encoders, IMUs, or visual sensors. It provides relative position estimates based on incremental motion."@en ;
    skos:prefLabel "Odometry"@en ;
    dcterms:identifier "RB-1008" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.94"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
