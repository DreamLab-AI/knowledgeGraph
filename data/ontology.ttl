ngm:monte-carlo-integration a owl:Class ;
    rdfs:label "Monte Carlo Integration"@en ;
    rdfs:comment "Monte Carlo integration estimates the value of an integral by averaging the integrand over randomly sampled points, with error that decreases with the square root of the sample count regardless of dimension."@en ;
