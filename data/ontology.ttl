ngm:credential-schema a owl:Class ;
    rdfs:label "Credential Schema"@en ;
    rdfs:comment "A Credential Schema is a machine-readable, versioned specification — typically expressed in JSON Schema or JSON-LD vocabulary — that defines the mandatory and optional claims, data types, cardinality constraints, and value ranges within a Verifiable Credential. Schemas serve as a shared contract between issuers, holders, and verifiers: an issuer populates claims according to a declared schema, a holder's wallet stores it with schema metadata, and a verifier validates the credential's structure against the schema before applying trust decisions. Schemas are published at stable, resolvable URIs and referenced from the `credentialSchema` property defined in the W3C Verifiable Credentials Data Model."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:verifiable-credential-vc,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:decentralised-identity ;
    vc:slug "credential-schema" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:json-ld,
        ngm:json-schema .

ngm:data-processing a owl:Class ;
    rdfs:label "Data Processing"@en ;
    rdfs:comment "Data Processing encompasses the collection, transformation, validation, and storage of raw data into structured, queryable forms suitable for downstream analysis and machine learning. In spatial computing and metaverse contexts it spans real-time sensor fusion, streaming ETL pipelines, and batch workloads that convert high-throughput telemetry—such as motion capture, point clouds, and user interaction events—into persistent knowledge stores. Effective data processing architectures balance latency, throughput, and fault-tolerance to underpin interactive 3D applications and AI inference pipelines."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:computer-vision,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing ;
    vc:slug "data-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-pipeline,
        ngm:edge-computing .

ngm:data-protection-regulation a owl:Class ;
    rdfs:label "Data Protection Regulation"@en ;
    rdfs:comment "Data Protection Regulation refers to the legal and policy frameworks—such as the EU General Data Protection Regulation (GDPR) and the UK Data Protection Act 2018—that govern how personal data may be collected, processed, stored, and shared by organisations. These regulations impose obligations around lawful basis for processing, data subject rights, cross-border transfer restrictions, and mandatory breach notification, creating compliance requirements for AI systems that handle personal data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-preserving-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:regulatory-technology ;
    vc:requires ngm:data-governance,
        ngm:privacy-preserving-technology ;
    vc:slug "data-protection-regulation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:compliance-framework .

ngm:decentralized-autonomous-organization a owl:Class ;
    rdfs:label "Decentralized Autonomous Organization"@en ;
    rdfs:comment "An organisational entity operating through Smart Contracts, Distributed Governance, and community voting mechanisms without centralised authority or hierarchical control."@en ;
