ngm:causal-attention a owl:Class ;
    rdfs:label "Causal Attention"@en ;
    rdfs:comment "Causal Attention (also called masked self-attention) is an attention mechanism where each token position attends only to itself and earlier positions in the sequence, enforced via an upper-triangular mask applied before softmax. This unidirectional constraint is essential for autoregressive language model training and inference, ensuring predictions at position i depend only on positions less than i."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-attention ],
        ngm:ai-model-architecture,
        ngm:attention-mechanism ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:transformer-architecture ;
    vc:enables ngm:gpt,
        ngm:language-modeling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:decoder,
        ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:self-attention ;
    vc:slug "causal-attention" ;
    vc:sourceDomain "artificial-intelligence" .

