    vc:slug "emotion-aware-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:enhanced-due-diligence a owl:Class ;
    rdfs:label "Enhanced Due Diligence"@en ;
    rdfs:comment "Enhanced due diligence (EDD) is a heightened level of customer scrutiny applied by regulated institutions to relationships and transactions that present elevated money-laundering, terrorist-financing, or sanctions risk. Going beyond standard customer due diligence, it requires deeper verification of identity and beneficial ownership, investigation of source of funds and wealth, and ongoing intensified monitoring. EDD is mandated for higher-risk categories such as politically exposed persons, customers in high-risk jurisdictions, and complex or unusually large transactions. It is a cornerstone of the risk-based approach embedded in anti-money-laundering and know-your-customer regulatory regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sanctions-screening ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:customer-due-diligence ;
    vc:contrastsWith ngm:customer-due-diligence ;
    vc:dependsOn ngm:risk-based-approach ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:identity-verification,
        ngm:risk-assessment ;
    vc:implements ngm:regulatory-compliance ;
    vc:isPartOf ngm:compliance ;
