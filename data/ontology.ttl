] .

# Standards Documentation
mv:StandardsDocumentation a owl:Class ;
    rdfs:subClassOf mv:Standards ;
    rdfs:label "Standards Documentation"@en ;
    rdfs:comment "Established guidelines, rules, and best practices that govern the creation of technical documentation, including structure, formatting conventions, terminology usage, delivery methods, and presentation to ensure consistency, clarity, and accuracy across all content."@en ;
    skos:prefLabel "Standards Documentation"@en ;
    dcterms:identifier "MV-10074" ;
