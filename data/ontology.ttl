        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:inference,
        ngm:overfitting ;
    vc:dependsOn ngm:neural-network-architecture,
        ngm:optimiser ;
    vc:enables ngm:fine-tuning,
        ngm:inference,
        ngm:machine-learning-discipline-model,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backward-pass,
        ngm:forward-pass,
        ngm:hyperparameter-tuning,
        ngm:validation-process ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:requires ngm:compute-resources,
        ngm:gradient-descent,
        ngm:labelled-dataset,
        ngm:loss-function,
        ngm:training-data ;
    vc:slug "training" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-22989-2022,
        ngm:nist-ai-rmf ;
    vc:uses ngm:backpropagation,
        ngm:batch-normalisation,
        ngm:dropout,
        ngm:regularisation,
        ngm:stochastic-gradient-descent .

ngm:unsupervised-learning a owl:Class ;
    rdfs:label "Unsupervised Learning"@en ;
    rdfs:comment "Unsupervised Learning discovers hidden patterns, structures, and representations in unlabeled data without explicit supervision. Key techniques include clustering, dimensionality reduction, density estimation, anomaly detection, and generative modelling, enabling exploratory data analysis and latent feature extraction."@en ;
