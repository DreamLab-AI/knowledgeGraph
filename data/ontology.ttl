ngm:global-trade a owl:Class ;
    rdfs:comment "Global trade is the world-wide system of exchange of goods, services, and intangibles across national borders, viewed as an aggregate: the sum of all international trade flows together with the networks of shipping, finance, standards, and agreements that carry them. Worth roughly one third of world GDP, it is organised increasingly through global value chains in which production stages are distributed across many countries, and it depends on shared technical standards, interoperable logistics, and multilateral rules to keep transaction costs low."@en ;
    rdfs:label "Global Trade"@en ;
    rdfs:subClassOf ngm:international-trade ;
