ngm:kernel-function a owl:Class ;
    rdfs:comment "A kernel function is a similarity measure between two data points that implicitly computes an inner product in a high-dimensional feature space without explicitly constructing that space. It underlies kernel methods such as support vector machines and Gaussian processes, enabling non-linear pattern recognition through the kernel trick. Common examples include the radial basis function, polynomial, and linear kernels, each encoding different assumptions about data similarity."@en ;
    rdfs:label "Kernel Function"@en ;
    rdfs:subClassOf ngm:kernel-methods ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
