    vc:maturity "draft" ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires <urn:visionflow:linked:encryption-scheme>,
        vf:digital-signature,
        vf:hash-function ;
    vc:slug "cryptographic-protocol" ;
    vc:sourceDomain "infrastructure" .

