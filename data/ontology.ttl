ngm:virtual-land-rights a owl:Class ;
    rdfs:label "Virtual Land Rights"@en ;
    rdfs:comment "Blockchain-based ownership and property rights for digital land parcels in metaverse platforms, represented as NFTs that serve as digital deeds providing proof of ownership, development rights, and transferability of virtual real estate assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
