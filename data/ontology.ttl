ngm:validator a owl:Class ;
    rdfs:label "Validator"@en ;
    rdfs:comment "A validator is a network participant in a proof-of-stake blockchain that is responsible for proposing new blocks, attesting to the validity of blocks proposed by others, and participating in the finality mechanism of the network. Validators commit a quantity of cryptocurrency as collateral (stake), which is subject to slashing — partial or total confiscation — if the validator behaves dishonestly or fails liveness requirements. Through their collective attestations and proposals, validators form the active set that drives consensus and maintains the canonical chain history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-proposal ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key ],
        ngm:consensus-protocol ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:fault-tolerance,
        ngm:game-theory ;
    vc:contrastsWith ngm:light-client,
        ngm:miner,
        ngm:proof-of-work ;
    vc:dependsOn ngm:block,
        ngm:peer-to-peer-network,
        ngm:slashing ;
    vc:enables ngm:consensus-mechanism,
        ngm:decentralised-network,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attestation,
        ngm:block-proposal ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:governance,
        ngm:smart-contract,
        ngm:tokenomics ;
    vc:requires ngm:cryptographic-key,
        ngm:digital-signature,
        ngm:proof-of-stake,
        ngm:staking ;
    vc:slug "validator" ;
    vc:sourceDomain "blockchain" .

ngm:virtual-machine a owl:Class ;
    rdfs:label "Virtual Machine"@en ;
    rdfs:comment "A sandboxed runtime environment that executes smart contract bytecode deterministically across distributed nodes, translating high-level contract code into low-level operations whilst metering computational resource consumption and enforcing state-transition rules. The Ethereum Virtual Machine is the canonical reference implementation, with alternatives including WebAssembly-based runtimes for improved performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-metering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deterministic-execution ],
        ngm:computing-infrastructure ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:container-runtime,
        ngm:hypervisor ;
    vc:enables ngm:blockchain,
        ngm:decentralised-application,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:architecture,
        ngm:state-transition-function ;
    vc:isPartOf ngm:blockchain-node ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:smart-contract-execution,
        ngm:web-assembly ;
    vc:requires ngm:deterministic-execution,
        ngm:gas-metering,
        ngm:sandboxed-execution ;
    vc:slug "virtual-machine" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:consensus-mechanism,
        ngm:distributed-system ;
    vc:uses ngm:blockchain,
        ngm:bytecode,
        ngm:cryptography,
        ngm:opcodes .

ngm:web-rtc a owl:Class ;
    rdfs:label "WebRTC"@en ;
    rdfs:comment "WebRTC (Web Real-Time Communication) is a W3C and IETF co-standardised open framework that enables peer-to-peer exchange of audio, video, and arbitrary data between web browsers and native applications using a JavaScript API (getUserMedia, RTCPeerConnection, RTCDataChannel), combining"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ice-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stun-and-turn ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ice-protocol ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:bridgesTo ngm:infra-network-and-comms ;
    vc:enables ngm:collaborative-systems-modality,
        ngm:screen-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
