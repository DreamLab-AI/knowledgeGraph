    vc:slug "eclair" ;
    vc:sourceDomain "blockchain" .

ngm:edge-layer a owl:Class ;
    rdfs:label "Edge Layer"@en ;
    rdfs:comment "The Edge Layer is the cross-cutting stratum at the periphery of a system, where it meets external devices, users, and data sources. It sits above local hardware and network resources and below the application workloads it serves close to origin. It contains edge gateways, local caches, and the boundary logic that mediates between core and periphery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:edge-computing-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware-layer,
        ngm:network-layer ;
    vc:slug "edge-layer" ;
    vc:sourceDomain "edge" .

ngm:electra a owl:Class ;
    rdfs:label "ELECTRA"@en ;
    rdfs:comment "ELECTRA (Efficiently Learning an Encoder that Classifies Token Replacements Accurately) is a transformer pre-training method that trains a discriminator to detect replaced tokens rather than reconstructing masked inputs, using a generator-discriminator architecture. This replaced token detection task utilises all positions in a sequence, yielding substantially greater sample efficiency than masked language modelling with less than one quarter of the compute required by comparable models."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:albert,
        ngm:ro-berta ;
    vc:enables ngm:machine-learning-model,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
