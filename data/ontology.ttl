ngm:anti-money-laundering a owl:Class ;
    rdfs:label "Anti-Money Laundering"@en ;
    rdfs:comment "Anti-Money Laundering (AML) encompasses the legislative frameworks, regulatory obligations, and operational procedures that financial institutions and other regulated entities must implement to detect, prevent, and report the layering and integration of proceeds from criminal activity. AML programmes typically include customer due diligence (CDD), enhanced due diligence (EDD) for high-risk customers, transaction monitoring, suspicious activity reporting (SAR), and sanctions screening. International standards are set by the Financial Action Task Force (FATF) and transposed into national law by member jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance ;
    vc:requires ngm:fraud-detection,
        ngm:regulatory-compliance ;
    vc:slug "anti-money-laundering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:aml-kyc-compliance,
        ngm:anomaly-detection .

ngm:certificate-authority a owl:Class ;
    rdfs:label "Certificate Authority"@en ;
    rdfs:comment "A Certificate Authority (CA) is a trusted third-party organisation that issues, signs, and manages the lifecycle of X.509 digital certificates, cryptographically binding a public key to an entity's verified identity. CAs operate within a hierarchical Public Key Infrastructure (PKI) where root CAs sign intermediate CAs, which in turn issue end-entity certificates for servers, users, or devices. The CA's signing operations underpin the TLS handshake, code-signing pipelines, S/MIME email encryption, and document signing workflows across the internet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:digital-certificate,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:cryptography,
        ngm:digital-signature ;
    vc:slug "certificate-authority" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:authentication,
        ngm:identity-management .

ngm:constitutional-ai a owl:Class ;
    rdfs:label "Constitutional AI"@en ;
    rdfs:comment "A mod for training AI assistants to be harmless through self-improvement, using a set of principles or \"constitution\" to guide behaviour without human labels for harmful outputs. Constitutional AI combines supervised learning for self-critiques and revisions with RL from AI Feedback (RLAIF)."@en ;
