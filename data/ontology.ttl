        vf:compliance-standards,
        vf:risk-management,
        vf:trust-framework-policy,
        vf:voting-systems ;
    vc:implements <urn:visionflow:linked:cobit-framework>,
        <urn:visionflow:linked:iso-42001>,
        <urn:visionflow:linked:itil-framework>,
        <urn:visionflow:linked:nist-ai-rmf>,
        <urn:visionflow:linked:oecd-corporate-governance-principles>,
        <urn:visionflow:linked:uk-corporate-governance-code> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
