ngm:policy-administration-point a owl:Class ;
    rdfs:comment "A Policy Administration Point (PAP) is the component within an attribute-based or policy-based access control architecture responsible for authoring, storing, and distributing access control policies to Policy Decision Points. The PAP provides the administrative interface through which security administrators define rules governing which subjects may access which resources under what conditions. It is distinct from policy enforcement and evaluation components, focusing solely on policy lifecycle management."@en ;
    rdfs:label "Policy Administration Point"@en ;
    rdfs:subClassOf ngm:access-control ;
