ngm:profile-management a owl:Class ;
    rdfs:label "Profile Management"@en ;
    rdfs:comment "Profile Management encompasses the systems and services for creating, storing, updating, and securing user profiles within metaverse and digital platforms. It covers avatar customisation preferences, personal data storage, authentication credentials, and preference settings, enabling persistent personalised experiences across sessions and across interoperable environments."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:dependsOn ngm:digital-identity,
        ngm:personal-data-store ;
    vc:enables ngm:avatar-customization,
        ngm:avatar-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "profile-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:identity-management .

ngm:progressive-download a owl:Class ;
    rdfs:label "Progressive Download"@en ;
    rdfs:comment "Progressive Download is a content delivery technique in which assets—3D models, textures, audio, or video—are streamed and partially consumed before the full file is retrieved. It enables early playback or rendering from incomplete data, reduces perceived loading latency in metaverse environments, and underpins level-of-detail streaming and lazy asset loading strategies."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:3-d-asset,
        ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:web-assembly ;
    vc:slug "progressive-download" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-delivery-network,
        ngm:level-of-detail .

ngm:projection-mapping a owl:Class ;
    rdfs:label "Projection Mapping"@en ;
    rdfs:comment "Projection Mapping is a spatial AR display technique that aligns projected imagery precisely onto three-dimensional physical surfaces, transforming arbitrary geometry into dynamic visual canvases. It requires real-time rendering of geometry-corrected frames, spatial calibration, and surface modelling, enabling immersive installations, virtual production environments, and location-based XR experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-entertainment,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ar-technology,
        ngm:spatial-computing ;
    vc:slug "projection-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:real-time-rendering .

ngm:property-registry a owl:Class ;
    rdfs:label "Property Registry"@en ;
    rdfs:comment "Blockchain-based land title recording systems employing immutable distributed ledgers, cryptographic signatures, and timestamp verification to create tamper-proof property ownership records, reduce fraud, and accelerate transaction processing from 30–90 days to 72 hours. Dubai processed 188,000+ transactions worth AED 625 billion in 2024; Georgia was the first country to adopt blockchain land administration at national scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:bc-token-and-asset,
        ngm:real-estate-tokenization ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-registry,
        ngm:asset-tokenization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:digital-identity ;
    vc:requires ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:slug "property-registry" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-domain,
        ngm:cryptography .

ngm:property-system a owl:Class ;
    rdfs:label "Property System"@en ;
    rdfs:comment "A Property System is a software architecture pattern for attaching typed key-value attributes to entities within a metaverse or game engine context, enabling data binding, runtime configuration, and dynamic object behaviour without hard-coded class inheritance. It underpins avatar customisation, world-object state management, and reactive UI data flows in spatial computing platforms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:avatar-customization,
        ngm:avatar-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:digital-asset ;
    vc:slug "property-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:game-engine .

ngm:proportional-control a owl:Class ;
    rdfs:label "Proportional Control"@en ;
    rdfs:comment "Proportional Control is a feedback control strategy in which the corrective output applied to an actuator is directly proportional to the current error—the difference between the desired setpoint and the measured process variable. It is the foundational component of PID controllers, providing immediate, scaled response to deviations but typically leaving a steady-state offset that requires integral or derivative terms to eliminate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:feedback-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:adaptive-control,
        ngm:derivative-control ;
    vc:enables ngm:motion-control,
        ngm:position-control,
        ngm:velocity-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-algorithm ;
    vc:isPartOf ngm:closed-loop-control,
        ngm:pid-controller ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:control-theory ;
    vc:requires ngm:actuator,
        ngm:feedback-control ;
    vc:slug "proportional-control" ;
    vc:sourceDomain "robotics" .

ngm:pseudonymisation a owl:Class ;
    rdfs:label "Pseudonymisation"@en ;
    rdfs:comment "Pseudonymisation is a data de-identification technique, defined in GDPR Article 4(5), that processes personal data such that it can no longer be attributed to a specific data subject without additional information held separately under technical and organisational safeguards. It replaces direct identifiers—names, national identification numbers, email addresses—with pseudonyms such as tokens, encrypted identifiers, or keyed hashes, preserving data utility for analytics and machine learning while reducing but not eliminating re-identification risk. Unlike full anonymisation, pseudonymisation is reversible by an authorised party holding the supplementary mapping or key material."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-minimisation,
        ngm:privacy-preserving-data-mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:k-anonymity-in-datasets,
        ngm:privacy-by-design ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:cryptographic-key-management ;
    vc:slug "pseudonymisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-fairness,
        ngm:ai-governance-and-ethics .

ngm:psychological-phenomenon a owl:Class ;
    rdfs:label "Psychological Phenomenon"@en ;
    rdfs:comment "A Psychological Phenomenon, in the context of spatial computing, denotes any observable, reproducible effect on cognition, emotion, or behaviour that arises from interaction with immersive virtual environments. Established examples include the Proteus Effect (avatar-driven behavioural conformity), simulator sickness (sensorimotor conflict), flow states, social presence, and embodiment illusions. Understanding these phenomena is foundational to ethical metaverse design, therapeutic XR applications, and the study of human-computer interaction at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vr-psychology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proteus-effect ],
        ngm:humans-avatars-character,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:behavioral-modeling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:proteus-effect,
        ngm:social-presence,
        ngm:vr-psychology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:embodied-ai,
        ngm:emotional-immersion,
        ngm:immersive-experience ;
    vc:slug "psychological-phenomenon" ;
    vc:sourceDomain "spatial-computing" .

ngm:public a owl:Class ;
    rdfs:label "Public"@en ;
    rdfs:comment "Public, as a Logseq property tag (`public:: true`), marks a knowledge-graph page as intended for external publication. In the NarrativeGoldmine ontology it acts as an access-control classifier: pages bearing this annotation are included in export pipelines targeting the open WebVOWL visualisation and the public-facing OWL2 dataset. It is a metadata concept rather than a domain-level class, functioning analogously to an access-control label within the data-governance layer."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:linked-data,
        ngm:metadata-standard ;
    vc:slug "public" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-governance,
        ngm:knowledge-graph .

ngm:push-to-local-rag a owl:Class ;
    rdfs:label "Push To Local RAG"@en ;
    rdfs:comment "Push To Local RAG is a data-pipeline operation that extracts, cleans, and concatenates Logseq markdown pages—filtering out short or low-quality documents—then writes the result to a single corpus file consumed by a local Retrieval-Augmented Generation system. The process involves URL stripping, special-character normalisation, whitespace normalisation, and a minimum byte-length threshold, producing a curated text corpus that improves retrieval precision for local LLM inference without sending data to external services."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:embedding-model,
        ngm:vector-database ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "push-to-local-rag" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:knowledge-graph,
        ngm:tokenization .

ngm:python-sample1 a owl:Class ;
    rdfs:label "Python Sample1"@en ;
    rdfs:comment "Python Sample1 is a Logseq Python code block that demonstrates the Logseq Plugin API via Pyodide: it defines helper utilities for inspecting JavaScript objects, appending timestamped entries to a named Logseq page, and searching all pages for a given term using the Logseq search API. The sample illustrates the pattern of bridging Python scripting with the Logseq knowledge-graph API for automated page discovery and log management."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:code-generation,
        ngm:information-retrieval,
        ngm:semantic-search ;
    vc:slug "python-sample1" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-graph,
        ngm:knowledge-management .

ngm:python-sample2 a owl:Class ;
    rdfs:label "Python Sample2"@en ;
    rdfs:comment "Python Sample2 is a minimal Logseq JavaScript/Pyodide evaluation block used as a stub execution test. It demonstrates the evalblock mechanism that allows inline code execution within the Logseq knowledge graph, serving as a baseline template for more complex Python integrations that interact with the Logseq Plugin API."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:code-generation,
        ngm:knowledge-management ;
    vc:slug "python-sample2" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-graph .

ngm:python-to-build-rag-data-page a owl:Class ;
    rdfs:label "Python to build RAG data page"@en ;
    rdfs:comment "Python to build RAG data page is a Logseq Pyodide script that enumerates all pages with the `public:: true` property, loads their block content, applies text-cleaning routines (URL removal, bracket stripping, special-character normalisation), and appends the cleaned content to a dedicated FULLRAG page. This page then serves as the consolidated corpus for local Retrieval-Augmented Generation pipelines, enabling semantic search over the entire public knowledge graph without external data transfer."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:embedding-model,
        ngm:vector-database ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management ;
    vc:slug "python-to-build-rag-data-page" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:knowledge-graph,
        ngm:tokenization .

ngm:python-to-list-nodes a owl:Class ;
    rdfs:label "Python to list nodes"@en ;
    rdfs:comment "Python to list nodes is a Logseq Pyodide script that iterates over all pages in the knowledge graph, filters those with the `public:: true` metadata property, and returns a comma-separated list of public page names. It demonstrates direct integration of Python scripting with the Logseq Plugin API for programmatic knowledge-graph introspection and inventory generation."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:semantic-search ;
    vc:slug "python-to-list-nodes" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-graph,
        ngm:knowledge-management .

ngm:quantexa a owl:Class ;
    rdfs:label "Quantexa"@en ;
    rdfs:comment "Quantexa is a company that provides data analytics software for connecting and analysing data to support decision intelligence, including fraud and financial crime detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-analytics ],
        ngm:data-analytics ;
    vc:enables ngm:fraud-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-analytics ;
    vc:slug "quantexa" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:quantum-ai a owl:Class ;
    rdfs:label "Quantum AI"@en ;
    rdfs:comment "Quantum AI is a research area at the intersection of quantum computing and artificial intelligence, applying quantum mechanical phenomena — superposition, entanglement, and interference — to accelerate or qualitatively improve machine learning algorithms, combinatorial optimisation, and probabilistic inference. Quantum circuits can in principle represent exponentially large state spaces with polynomial resources, offering potential speed-ups for specific learning and search tasks beyond classical limits. The field encompasses variational quantum algorithms, quantum neural networks, quantum-enhanced sampling, and the use of quantum hardware as accelerators within classical AI pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-computing ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:deep-learning,
        ngm:optimization-algorithm ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:compute-infrastructure,
        ngm:cryptography,
        ngm:neural-network,
        ngm:post-quantum-cryptography,
        ngm:quantum-network-node ;
    vc:requires ngm:algorithm,
        ngm:machine-learning,
        ngm:quantum-computing ;
    vc:slug "quantum-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:quantum-threat-to-cryptography a owl:Class ;
    rdfs:label "Quantum Threat to Cryptography"@en ;
    rdfs:comment "Existential risk to public-key cryptographic systems (ECDSA, RSA) from sufficiently powerful quantum computers capable of running Shor's algorithm. Q-Day—the point at which quantum advantage breaks deployed cryptography—threatens the security foundations of blockchain networks, TLS, and digital identity systems."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:contrastsWith ngm:post-quantum-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:quantum-computing ;
    vc:slug "quantum-threat-to-cryptography" ;
    vc:sourceDomain "blockchain" .

ngm:radicle a owl:Class ;
    rdfs:label "Radicle"@en ;
    rdfs:comment "Radicle is a decentralised, peer-to-peer code collaboration platform built on Git that eliminates dependence on centralised forges such as GitHub or GitLab. It uses a content-addressed, cryptographically signed data model where repositories are identified by public keys rather than server-hosted URLs, enabling sovereign code hosting, offline collaboration, and censorship-resistant software development. Radicle integrates with Ethereum-based smart contracts for governance and funding, positioning it at the intersection of blockchain infrastructure and open-source software tooling."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralized-governance,
        ngm:open-source-software ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:distributed-system,
        ngm:smart-contract ;
    vc:slug "radicle" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-signature,
        ngm:peer-to-peer-network,
        ngm:version-control .

ngm:raycast-system a owl:Class ;
    rdfs:label "Raycast System"@en ;
    rdfs:comment "A Raycast System is the interaction subsystem in a spatial computing or XR engine that casts geometric rays from a controller, gaze direction, or cursor into the 3D scene to detect intersections with scene objects, enabling selection, pointing, UI interaction, and collision queries. It forms the primary input-resolution layer in VR/AR user interfaces, translating physical or tracked user intent into object picks within the scene graph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:gaze-control,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:collision-detection,
        ngm:physics-engine,
        ngm:scene-graph ;
    vc:slug "raycast-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:vr-controllers .

ngm:rb-0019-exoskeleton-robot a owl:Class ;
    rdfs:label "rb 0019 exoskeleton robot"@en ;
    rdfs:comment "An exoskeleton robot is a wearable robotic device that attaches to the human body and augments, supports, or replaces the wearer's physical capabilities. Exoskeletons may be powered (actuated) or passive (spring-and-damper based), and are used for physical rehabilitation after stroke or spinal cord injury, industrial worker fatigue reduction, and military load-carrying augmentation. Safety is paramount because the robot shares the mechanical structure with a human; ISO 13482 governs safety requirements for personal care robots including exoskeletons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0088-iso-13482-compliance ],
        ngm:exoskeleton-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:human-robot-interaction,
        ngm:rb-0007-collaborative-robot,
        ngm:service-robot,
        ngm:wearable-computing-platform ;
    vc:requires ngm:rb-0088-iso-13482-compliance,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0019-exoskeleton-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:uses ngm:rb-0056-impedance-control,
        ngm:rb-0067-force-torque-sensor .

ngm:rb-1002-closedloopcontrol a owl:Class ;
    rdfs:label "RB 1002 closedloopcontrol"@en ;
    rdfs:comment "RB 1002 Closed-Loop Control is an ontology term in the NarrativeGoldmine robotics hierarchy denoting the general class of feedback-based control architectures in which sensor measurements of a system's output are continuously fed back to the controller to correct deviations from a desired set-point. As a superclass it subsumes specific strategies including PID control, model-predictive control, adaptive control, and state-estimation-driven controllers used in robotic actuation and manipulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adaptive-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-predictive-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:trajectory-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:adaptive-control,
        ngm:model-predictive-control,
        ngm:pid-control ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:feedback-control,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:slug "rb-1002-closedloopcontrol" ;
    vc:sourceDomain "robotics" .

ngm:rb-1016-pathplanning a owl:Class ;
    rdfs:label "RB 1016 pathplanning"@en ;
    rdfs:comment "RB 1016 Path Planning is an ontology term in the NarrativeGoldmine robotics hierarchy representing the superclass of algorithms that compute collision-free trajectories from a start configuration to a goal configuration in a robot's configuration space. It encompasses graph-search methods (A*, Dijkstra), sampling-based planners (RRT, PRM), and reactive local-planning strategies (DWA, potential fields), all of which underpin autonomous navigation in structured and unstructured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dijkstra-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rrt-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
