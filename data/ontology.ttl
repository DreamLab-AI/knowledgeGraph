ngm:gan a owl:Class ;
    rdfs:label "GAN"@en ;
    rdfs:comment "A Generative Adversarial Network (GAN) is a deep-learning framework in which two neural networks — a generator and a discriminator — are trained simultaneously in a minimax game: the generator maps random latent vectors to synthetic data samples, while the discriminator learns to distinguish real training samples from generated ones. Through adversarial feedback propagated via backpropagation, the generator progressively improves at synthesising realistic outputs while the discriminator improves at detection. GANs have achieved state-of-the-art results in image synthesis, style transfer, super-resolution, and conditional generation, but are prone to training instabilities such as mode collapse and vanishing gradients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generator-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:discriminator-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-latent-space ],
        ngm:generative-model ;
    vc:bridgesTo ngm:deepfakes,
        ngm:procedural-content-generation,
        ngm:synthetic-data ;
    vc:contrastsWith ngm:autoregressive-model,
        ngm:diffusion-model,
        ngm:variational-autoencoder ;
    vc:enables ngm:data-augmentation,
        ngm:image-generation,
        ngm:image-to-image-translation,
        ngm:super-resolution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:discriminator-network,
        ngm:generator-network,
        ngm:neural-network-latent-space ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:model-collapse,
        ngm:unsupervised-learning ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent,
        ngm:neural-network ;
    vc:slug "gan" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:adversarial-training,
        ngm:batch-normalisation,
        ngm:convolutional-neural-network .

ngm:gaussian-mixture-model a owl:Class ;
    rdfs:label "Gaussian Mixture Model"@en ;
    rdfs:comment "A Gaussian mixture model is a probabilistic model that represents a population as a weighted combination of several Gaussian distributions, each describing a latent subpopulation or cluster. Its parameters — the mixing weights, means, and covariance matrices — are typically estimated by the expectation-maximisation algorithm, which iteratively assigns soft responsibilities to data points and updates the component parameters. As a generative latent-variable model, it supports soft clustering, density estimation, and probabilistic classification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gaussian-distribution ],
        ngm:latent-variable-model ;
    vc:contrastsWith ngm:clustering ;
    vc:enables ngm:clustering,
        ngm:density-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gaussian-distribution ;
    vc:implements ngm:clustering,
        ngm:density-estimation ;
    vc:isPartOf ngm:latent-variable-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model,
        ngm:statistics ;
    vc:slug "gaussian-mixture-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:unsupervised-learning ;
    vc:uses ngm:gaussian-distribution,
        ngm:probability-distribution .

ngm:general-purpose-ai-model a owl:Class ;
    rdfs:label "General Purpose AI Model"@en ;
    rdfs:comment "An AI model that displays significant generality and is capable of competently performing a wide range of distinct tasks regardless of the way the model is placed on the market, as defined by EU AI Act Article 3(63). GPAI models face specific transparency and documentation obligations, with enhanced requirements for those meeting systemic risk thresholds based on training compute or high-impact capability benchmarks."@en ;
