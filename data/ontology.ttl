ngm:consortium-governance a owl:Class ;
    rdfs:comment "Consortium governance is the model by which a defined group of organisations jointly operates and controls a permissioned blockchain or shared infrastructure. Membership, validator rights, and decision-making authority are restricted to vetted participants who agree to a governing charter. It balances the decentralisation benefits of distributed ledgers with the accountability and access control enterprises require."@en ;
    rdfs:label "Consortium Governance"@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
