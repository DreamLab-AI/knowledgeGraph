ngm:ark-protocol a owl:Class ;
    rdfs:label "Ark Protocol"@en ;
    rdfs:comment "Ark is a layer-two protocol for Bitcoin that uses shared, periodically refreshed off-chain outputs to let users transact cheaply and privately while retaining the ability to settle on the base chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        ngm:bitcoin-proof-of-work-protocol ;
    vc:enables ngm:cross-border-payments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin-proof-of-work-protocol ;
    vc:slug "ark-protocol" ;
    vc:sourceDomain "metaverse" .

