    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:integration-testing,
        ngm:performance-testing,
        ngm:security-testing,
        ngm:unit-testing ;
    vc:isPartOf ngm:quality-assurance ;
