    rdfs:label "Machine Learning Conferences"@en .
ngm:machine-learning-discipline a owl:Class ;
    rdfs:comment "Machine Learning is the branch of artificial intelligence in which systems learn predictive or generative models directly from data, without being explicitly programmed with domain rules. It encompasses supervised, unsupervised, and reinforcement learning paradigms, and forms the foundation for deep learning, natural language processing, and computer vision applications. Practical machine learning involves data preparation, feature engineering, model selection, training, evaluation, and deployment within a production pipeline."@en ;
    rdfs:label "Machine Learning Discipline"@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    rdfs:subClassOf ngm:artificial-intelligence-core ;
