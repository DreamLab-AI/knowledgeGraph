ngm:transmission-network a owl:Class ;
    rdfs:label "Transmission Network"@en ;
    rdfs:comment "A transmission network is the high-voltage infrastructure that carries bulk electrical power over long distances from generation sites to distribution substations near consumers. Comprising transmission lines, transformers, and switching stations, it minimises resistive losses through high voltages and is operated as a synchronised grid balancing supply and demand in real time."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "transmission-network" ;
    vc:sourceDomain "infrastructure" .

ngm:transparency-and-explainability a owl:Class ;
    rdfs:label "Transparency and Explainability"@en ;
    rdfs:comment "Transparency and Explainability is a core AI trustworthiness dimension requiring that AI systems disclose sufficient information about their operation, decision logic, data provenance, and limitations to enable appropriate understanding and oversight by developers, deployers, and affected users. It encompasses traceability (audit trails, dataset documentation), explainability (global and local model explanations, counterfactuals), and communication transparency (disclosing AI involvement and system boundaries). Regulatory frameworks such as the EU AI Act Article 13 mandate transparency obligations for high-risk AI systems, driving demand for methods such as SHAP, LIME, and AI model cards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-model-card ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interpretability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-model-card,
        ngm:audit-trail,
        ngm:explainability,
        ngm:interpretability ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-regulation,
        ngm:decision-transparency,
        ngm:feature-importance,
        ngm:post-hoc-explanation ;
    vc:requires ngm:ai-audit,
        ngm:explainable-ai ;
    vc:slug "transparency-and-explainability" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transparency-obligation a owl:Class ;
    rdfs:label "Transparency Obligation"@en ;
    rdfs:comment "A transparency obligation is a regulatory duty to disclose how a system works or that it is in use, such as informing people when they interact with an AI system or with generated content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:regulatory-compliance ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ai-regulation ;
    vc:slug "transparency-obligation" ;
    vc:sourceDomain "metaverse" .

ngm:transparent-decision-making a owl:Class ;
    rdfs:label "Transparent Decision Making"@en ;
    rdfs:comment "Governance processes where decisions, their rationale, and the factors influencing outcomes are openly visible and accessible to stakeholders, often implemented through on-chain voting, public proposals, and documented deliberations in DAOs and digital platforms."@en ;
    rdfs:subClassOf ngm:governance,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:dependsOn ngm:blockchain-governance ;
    vc:enables ngm:accountability,
        ngm:distributed-decision-making ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-framework ;
    vc:slug "transparent-decision-making" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:community-governance,
        ngm:dao-governance .

ngm:transport-layer-security a owl:Class ;
    rdfs:label "Transport Layer Security"@en ;
    rdfs:comment "A cryptographic protocol that provides authentication, confidentiality and integrity for communications over a computer network, succeeding the earlier Secure Sockets Layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:cryptographic-protocol ;
    vc:enables ngm:authentication,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:slug "transport-layer-security" ;
    vc:sourceDomain "cryptographic" .

ngm:transport-protocol a owl:Class ;
    rdfs:label "Transport Protocol"@en ;
    rdfs:comment "A transport protocol is a network-layer specification that governs end-to-end delivery of data between processes, handling concerns such as multiplexing, reliability, ordering, and flow and congestion control. Examples including TCP, UDP, and QUIC sit above the network layer and provide the communication substrate over which higher-level application and agent protocols operate."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-control-protocols-like-mcp,
        ngm:networking-domain ;
    vc:slug "transport-protocol" ;
    vc:sourceDomain "infrastructure" .

ngm:treasury-analytics a owl:Class ;
    rdfs:label "Treasury Analytics"@en ;
    rdfs:comment "Treasury analytics is the analysis of an organisation's or DAO's financial holdings, cash flows, and asset allocation to inform liquidity, runway, and risk-management decisions. In the on-chain context it aggregates wallet balances, token positions, and protocol revenues into dashboards and metrics that support transparent, data-driven treasury governance."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics,
        ngm:treasury-management ;
    vc:slug "treasury-analytics" ;
    vc:sourceDomain "blockchain" .

ngm:triple-store a owl:Class ;
    rdfs:label "Triple Store"@en ;
    rdfs:comment "A triple store is a database purpose-built to store and query RDF data as subject-predicate-object triples, forming the storage layer for semantic-web and knowledge-graph applications. It supports the SPARQL query language and often provides reasoning and inference over ontologies, enabling expressive graph traversal and entailment beyond what relational stores offer."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:knowledge-graphing ;
    vc:slug "triple-store" ;
    vc:sourceDomain "data" .

ngm:trust-framework-policy a owl:Class ;
    rdfs:label "Trust Framework Policy"@en ;
    rdfs:comment "Set of rules and requirements governing participant behavior, accountability, and interoperability in federated digital identity ecosystems within metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trust-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:cross-platform-identity,
        ngm:interoperable-authentication,
        ngm:regulatory-compliance,
        ngm:trust-federation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability-framework,
        ngm:certification-criteria,
        ngm:policy-rule-set,
        ngm:trust-anchor ;
    vc:isPartOf ngm:federated-identity-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:digital-identity-standards,
        ngm:governance-structure,
        ngm:legal-framework ;
    vc:slug "trust-framework-policy" ;
    vc:sourceDomain "spatial-computing" .

ngm:trust-mechanism a owl:Class ;
    rdfs:label "Trust Mechanism"@en ;
    rdfs:comment "A trust mechanism is a system, protocol, or institution that allows parties who lack prior knowledge of one another to transact or cooperate with reasonable assurance of honest behaviour. Such mechanisms range from intermediaries and reputation systems to cryptographic and consensus protocols that replace interpersonal trust with verifiable, incentive-aligned guarantees."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barter-system,
        ngm:value-transfer ;
    vc:slug "trust-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:trust-over-ip-stack a owl:Class ;
    rdfs:label "Trust over IP Stack"@en ;
    rdfs:comment "The Trust over IP (ToIP) Stack is a four-layer architecture developed by the Trust Over IP Foundation that provides a complete framework for decentralised digital trust, combining technical protocols (verifiable credentials, DID-based peer-to-peer messaging, verifiable data registries) with governance frameworks at each layer to enable interoperable, privacy-preserving identity and credential exchange across organisational and jurisdictional boundaries. The stack mirrors the TCP/IP model by separating technical interoperability concerns from governance and policy concerns at corresponding layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:w3-c-verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        ngm:trust-framework ;
    vc:enables ngm:credential-verification,
        ngm:decentralised-trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralized-identifiers,
        ngm:verifiable-data-registry,
        ngm:w3-c-verifiable-credentials ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity-framework,
        ngm:trust-over-ip-foundation ;
    vc:slug "trust-over-ip-stack" ;
    vc:sourceDomain "governance" .

ngm:uk-ai-safety-institute a owl:Class ;
    rdfs:label "UK AI Safety Institute"@en ;
    rdfs:comment "The UK AI Safety Institute (AISI) is a UK government body established to evaluate the safety properties of frontier AI models before and after deployment, conduct research into emergent AI risks including deceptive alignment and capability elicitation, and coordinate with international counterparts—notably the US AI Safety Institute—on shared evaluation methodologies. It operates Inspect, an open-source AI evaluation framework, and publishes model evaluation results to inform regulatory and procurement decisions. The AISI sits within the Department for Science, Innovation and Technology and maintains close links with the Frontier Model Forum."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:model-evaluation-results ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:frontier-model-forum,
        ngm:red-teaming,
        ngm:responsible-ai ;
    vc:slug "uk-ai-safety-institute" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:ai-safety-research .

ngm:underfitting a owl:Class ;
    rdfs:label "Underfitting"@en ;
    rdfs:comment "Underfitting occurs when a machine learning model is insufficiently complex or inadequately trained to capture the underlying structure of its training data, resulting in high bias, low variance, and poor predictive performance on both training and unseen datasets. It is the converse of overfitting and arises from under-parameterisation, insufficient training duration, or excessive regularisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-capacity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:loss-function,
        ngm:regularisation ;
    vc:requires ngm:model-capacity,
        ngm:training ;
    vc:slug "underfitting" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:unreal-engine a owl:Class ;
    rdfs:label "Unreal Engine"@en ;
    rdfs:comment "Unreal Engine is a real-time three-dimensional creation tool and game engine developed by Epic Games. It provides rendering, physics, animation, audio and scripting systems used to build games, virtual production environments, architectural visualisations and simulations. The engine is widely adopted for its high-fidelity rendering, its visual scripting system Blueprints, and its use in film and television virtual production with LED volume stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lumen ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-rendering ],
        ngm:creative-media-domain ;
    vc:enables ngm:digital-twin,
        ngm:metaverse-domain,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lumen,
        ngm:nanite ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu-rendering ;
    vc:slug "unreal-engine" ;
    vc:sourceDomain "unreal-engine" .

ngm:urdf-robot-model a owl:Class ;
    rdfs:label "URDF Robot Model"@en ;
    rdfs:comment "A URDF (Unified Robot Description Format) robot model is an XML specification that describes a robot's kinematic and dynamic properties, including links, joints, inertial parameters, visual meshes and collision geometry. It is the canonical model format in the ROS ecosystem, consumed by simulators, motion planners and visualisation tools to reason about a robot's physical structure. URDF files enable consistent representation of articulated robots across simulation and control software."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gazebo-simulator,
        ngm:robot-operating-system ;
    vc:slug "urdf-robot-model" ;
    vc:sourceDomain "robotics" .

ngm:usage-analytics a owl:Class ;
    rdfs:label "Usage Analytics"@en ;
    rdfs:comment "Usage analytics is the collection, measurement and interpretation of data describing how users interact with a product, service or platform, including session frequency, feature adoption, retention and engagement patterns. It transforms raw event telemetry into actionable insight for product, design and governance decisions. When applied responsibly it can inform well-being metrics while raising privacy considerations about behavioural tracking."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-well-being-index,
        ngm:telemetry-and-analytics ;
    vc:slug "usage-analytics" ;
    vc:sourceDomain "data" .

ngm:user-directory a owl:Class ;
    rdfs:label "User Directory"@en ;
    rdfs:comment "A user directory is a centralised repository that stores and organises identity records, attributes and credentials for the principals of a system, supporting authentication and authorisation queries. Common implementations include LDAP directories, Active Directory and cloud identity stores, which identity providers consume to validate and describe users. It is a core component of identity and access management infrastructure."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-provider,
        ngm:identity-provider-id-p ;
    vc:slug "user-directory" ;
    vc:sourceDomain "security" .

ngm:user-engagement a owl:Class ;
    rdfs:label "User Engagement"@en ;
    rdfs:comment "User Engagement is the set of qualitative and quantitative dimensions that characterise the depth, frequency, and quality of a person's interaction with a digital product, service, or community. High engagement reflects meaningful value exchange: users return voluntarily, invest attention and effort, and develop lasting behaviours around the product. Engagement metrics—session duration, interaction depth, return rate, and social sharing—serve as proxies for value delivered and are key inputs to product development prioritisation and business model viability. Ethical engagement design balances compelling interaction patterns against the risk of exploiting psychological vulnerabilities through addictive mechanics or manipulative nudging."@en ;
    rdfs:subClassOf ngm:user-experience ;
    vc:enables ngm:hyper-personalisation,
        ngm:loyalty-programs,
        ngm:recommendation-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-creation,
        ngm:creator-economy,
        ngm:social-platform,
        ngm:user-interface ;
    vc:slug "user-engagement" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:digital-content,
        ngm:natural-interaction,
        ngm:reward-function .

ngm:user-monitoring a owl:Class ;
    rdfs:label "User Monitoring"@en ;
    rdfs:comment "User monitoring is the observation and logging of user behaviour and interactions within a platform to detect policy violations, abuse, safety risks or anomalous activity. In metaverse and online environments it supports trust-and-safety enforcement and agreement compliance, balancing protective oversight against privacy and consent. It typically feeds moderation, incident response and compliance reporting workflows."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-safety-protocol,
        ngm:user-agreement-compliance ;
    vc:slug "user-monitoring" ;
    vc:sourceDomain "governance" .

ngm:user-protection a owl:Class ;
    rdfs:label "User Protection"@en ;
    rdfs:comment "User Protection encompasses the legal frameworks, platform policies, and technical mechanisms designed to safeguard individuals from harm when using digital services and online platforms. It spans data protection rights, content moderation obligations, anti-manipulation requirements, and consumer protection rules applicable to platform operators. Regulation such as the UK Online Safety Act and the EU Digital Services Act impose positive duties on platforms to assess and mitigate risks to users, particularly minors and vulnerable populations. Technical controls include content filtering, safety settings, transparency mechanisms, and redress systems that give users agency over their online experience."@en ;
    rdfs:subClassOf ngm:consumer-protection ;
    vc:enables ngm:gdpr-compliance,
        ngm:user-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation-standards,
        ngm:data-protection,
        ngm:digital-well-being-index,
        ngm:online-safety-act-2023,
        ngm:uk-online-safety-act ;
    vc:slug "user-protection" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:consent-management,
        ngm:content-moderation,
        ngm:digital-rights .

ngm:validation-constraints a owl:Class ;
    rdfs:label "Validation Constraints"@en ;
    rdfs:comment "Validation constraints are the formally specified rules that data or metadata must satisfy to be considered valid against a schema, covering datatypes, cardinality, value ranges, required fields and structural relationships. Expressed through languages such as SHACL, JSON Schema or XSD, they let systems automatically verify conformance and reject malformed input. They are an integral part of metadata standards and ontology schemas."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-standard,
        ngm:metaverse-ontology-schema ;
    vc:slug "validation-constraints" ;
    vc:sourceDomain "data" .

ngm:validation-process a owl:Class ;
    rdfs:label "Validation Process"@en ;
    rdfs:comment "Activity of systematically checking wher systems, components, or implementations satisfy specified requirements, standards, and compliance criteria through verification testing and quality assurance procedures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-testing ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-verification,
        ngm:quality-certification,
        ngm:regulatory-approval,
        ngm:standards-conformance,
        ngm:system-acceptance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-testing,
        ngm:quality-assurance-workflows,
        ngm:requirement-verification,
        ngm:results-analysis,
        ngm:standards-validation,
        ngm:test-execution ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compliance-standards,
        ngm:quality-metrics,
        ngm:test-framework,
        ngm:testing-tools,
        ngm:validation-criteria ;
    vc:slug "validation-process" ;
    vc:sourceDomain "spatial-computing" .

ngm:validation-rules a owl:Class ;
    rdfs:label "Validation Rules"@en ;
    rdfs:comment "Defined constraints that data or input must satisfy to be accepted, used to enforce correctness, consistency and integrity before processing or storage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint ],
        ngm:data-management ;
    vc:enables ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:constraint ;
    vc:slug "validation-rules" ;
    vc:sourceDomain "general" .

ngm:validation-tools a owl:Class ;
    rdfs:label "Validation Tools"@en ;
    rdfs:comment "Validation tools are software utilities that verify whether data, documents or implementations conform to a defined specification, schema or interoperability profile. They automate conformance checking, report violations, and support certification and compatibility testing across standards-based ecosystems. By catching errors early they reduce integration risk and ensure data and formats interoperate as intended."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compatibility-process,
        ngm:data-format-standard ;
    vc:slug "validation-tools" ;
    vc:sourceDomain "infrastructure" .

ngm:vector-index a owl:Class ;
    rdfs:label "Vector Index"@en ;
    rdfs:comment "A vector index is a data structure that organises high-dimensional embedding vectors to enable fast approximate nearest-neighbour search over large collections. Using methods such as HNSW graphs, IVF partitioning or product quantisation, it trades a small amount of recall for large gains in query latency and scalability. Vector indexes are the retrieval engine behind semantic search and retrieval-augmented generation."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag,
        ngm:semantic-search ;
    vc:slug "vector-index" ;
    vc:sourceDomain "ai" .

ngm:vector-store a owl:Class ;
    rdfs:label "Vector Store"@en ;
    rdfs:comment "A storage system optimised for holding high-dimensional vector embeddings and retrieving them by similarity. It supports nearest-neighbour search used in semantic retrieval and machine learning applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:vector-database ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:vector-database ;
    vc:slug "vector-store" ;
    vc:sourceDomain "data-management" .

ngm:verifiable-credential-surface a owl:Class ;
    rdfs:label "Verifiable Credential Surface"@en ;
    rdfs:comment "A standardised JSON-LD 1.1 surface (S3) for issuing and storing W3C Verifiable Credentials 2.0|W3C VC 2.0 credentials signed by agents' DID Nostr Identity|did:nostr DIDs using Schnorr Signature|Schnorr signatures over JCS Canonicalisation|JCS-canonicalised payloads, enabling v..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-ld-1-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256-hashing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-issuance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signature ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-verification,
        ngm:capability-attestation,
        ngm:decentralised-trust,
        ngm:verifiable-claims,
        ngm:work-completion-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-indexing,
        ngm:credential-issuance,
        ngm:credential-verification,
        ngm:jcs-canonicalisation,
        ngm:schnorr-proof ;
    vc:implements ngm:rfc-8785-canonical-json,
        ngm:w-3-c-verifiable-credentials-2-0,
        ngm:w3-c-proof-types ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:requires ngm:did-resolution,
        ngm:json-ld-1-1,
        ngm:schnorr-signature,
        ngm:sha-256-hashing,
        ngm:w3-c-vc-2-0-standard ;
    vc:slug "verifiable-credential-surface" ;
    vc:sourceDomain "blockchain" .

ngm:verification-process a owl:Class ;
    rdfs:label "Verification Process"@en ;
    rdfs:comment "A verification process is the structured procedure by which claims or records are independently checked against evidence and methodology before being accepted as valid. In carbon markets it confirms that emission reductions or removals are real, additional, measurable and permanent prior to credit issuance and registry entry. Verification provides the assurance and integrity on which accounting and trading systems depend."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-accounting,
        ngm:carbon-registry ;
    vc:slug "verification-process" ;
    vc:sourceDomain "governance" .

ngm:versioning-system a owl:Class ;
    rdfs:label "Versioning System"@en ;
    rdfs:comment "A versioning system is a mechanism that tracks, identifies and manages successive states of an artefact such as code, data, documents or taxonomy entries over time. It records changes, supports retrieval of historical versions, and resolves concurrent edits, enabling reproducibility, auditability and rollback. In curation and registry contexts it ensures controlled evolution of records while preserving provenance."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-curation-platform,
        ngm:digital-taxonomy-registry ;
    vc:slug "versioning-system" ;
    vc:sourceDomain "infrastructure" .

ngm:vfx-tools a owl:Class ;
    rdfs:label "VFX Tools"@en ;
    rdfs:comment "VFX Tools are software applications and pipelines used to create, composite, and render visual effects for film, television, real-time engines, and immersive media. They encompass particle simulation, fluid and cloth dynamics, compositing, colour grading, and procedural generation capabilities, and increasingly interface with real-time rendering engines for deployment in spatial computing contexts."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:visual-effects ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:animation-software,
        ngm:rendering-engine ;
    vc:slug "vfx-tools" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:particle-system,
        ngm:rendering-pipeline .

ngm:virtual-destination a owl:Class ;
    rdfs:label "Virtual Destination"@en ;
    rdfs:comment "A digital location or space within a virtual environment that serves as a point of interest or travel objective, encompassing photogrammetry-reconstructed heritage sites, procedurally generated fantasy worlds, brand experience spaces, and interactive event venues accessible through metaverse platforms. Virtual destinations underpin virtual tourism, educational field trips, and social gathering use-cases, and are created using real-time rendering engines together with photogrammetry and 3D modelling pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-world-platform ],
        ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-field-trip,
        ngm:virtual-tourism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-tour ;
    vc:requires ngm:real-time-rendering,
        ngm:virtual-world-platform ;
    vc:slug "virtual-destination" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersive-experience,
        ngm:photogrammetry .

ngm:virtual-environment-creation a owl:Class ;
    rdfs:label "Virtual Environment Creation"@en ;
    rdfs:comment "The process of designing, building, and deploying immersive 3D virtual worlds using game engines, modelling software, and AI-powered tools, encompassing static and dynamic assets, physics simulation, and interactive experiences for metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience,
        ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3-d-modeling,
        ngm:game-engine ;
    vc:slug "virtual-environment-creation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-content-generation,
        ngm:physics-simulation,
        ngm:real-time-rendering .

ngm:virtual-event-platform a owl:Class ;
    rdfs:label "Virtual Event Platform"@en ;
    rdfs:comment "Software platforms that enable hosting digital events in metaverse environments, supporting conferences, exhibitions, concerts, and networking through immersive 3D spaces with avatar-based attendance, interactive features, and real-time collaboration tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
