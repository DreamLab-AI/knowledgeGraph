        ngm:photogrammetry ;
    vc:slug "volumetric-video" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:digital-twin,
        ngm:extended-reality,
        ngm:virtual-production ;
    vc:uses ngm:3-d-reconstruction,
        ngm:neural-radiance-field,
        ngm:video-compression .

ngm:webhook a owl:Class ;
    rdfs:label "Webhook"@en ;
    rdfs:comment "A webhook is an event-driven integration mechanism in which a server sends an HTTP request to a pre-registered URL when a specified event occurs, pushing data to consumers instead of requiring them to poll. It enables loosely coupled, near-real-time communication between web services and is a standard pattern for notifications, CI triggers, and payment events. Reliability concerns are addressed through retries, idempotency keys, and signature verification."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:presence-indicator ;
    vc:slug "webhook" ;
    vc:sourceDomain "infrastructure" .

ngm:wi-fi a owl:Class ;
    rdfs:label "Wi-Fi"@en ;
    rdfs:comment "Wi-Fi is a family of wireless networking technologies based on the IEEE 802.11 standards that allow devices to connect to a local area network and the internet without physical cabling. It is governed and certified by the Wi-Fi Alliance and operates primarily in the 2.4 GHz, 5 GHz, and 6 GHz radio bands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:radio-frequency-spectrum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-interface-card ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wireless-connectivity ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:5-g,
        ngm:bluetooth,
        ngm:ethernet ;
    vc:enables ngm:internet-of-things,
        ngm:mobile-broadband,
        ngm:network-communication,
        ngm:wireless-connectivity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:communication-protocol,
        ngm:ieee-802-11,
        ngm:wpa3 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mesh-network,
        ngm:network-security ;
    vc:requires ngm:network-interface-card,
        ngm:radio-frequency-spectrum,
        ngm:wireless-connectivity ;
    vc:slug "wi-fi" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:wi-fi-alliance ;
    vc:supports ngm:cloud-computing,
        ngm:edge-computing,
        ngm:smart-home ;
    vc:uses ngm:orthogonal-frequency-division-multiplexing,
        ngm:transport-layer-security .

ngm:word-embedding a owl:Class ;
    rdfs:label "Word Embedding"@en ;
    rdfs:comment "A Word Embedding is a dense, continuous vector representation of a word learned such that semantically or syntactically similar words occupy nearby positions in the vector space. Trained from large text corpora using distributional statistics, embeddings capture relationships through geometric structure, enabling analogical reasoning and similarity computation. They transformed natural language processing by replacing sparse one-hot encodings with low-dimensional features that generalise across vocabulary and feed downstream neural models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dimensionality-reduction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:embedding ;
    vc:enables ngm:information-retrieval,
        ngm:machine-translation,
        ngm:named-entity-recognition,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dimensionality-reduction ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:embedding,
        ngm:language-model ;
    vc:requires ngm:feature-engineering,
        ngm:neural-network ;
    vc:slug "word-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-understanding ;
    vc:uses ngm:cosine-similarity .

ngm:workflow-engine a owl:Class ;
    rdfs:label "Workflow Engine"@en ;
    rdfs:comment "A workflow engine is a software system that executes, coordinates, and monitors multi-step processes defined as a sequence or graph of tasks, managing state transitions, branching, retries, and human or system handoffs. It separates process definition from execution, enabling durable, observable orchestration of long-running business or computational workflows. Workflow engines underpin enterprise process automation and increasingly the orchestration of AI agent pipelines."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:workflow-orchestration ;
    vc:slug "workflow-engine" ;
    vc:sourceDomain "infrastructure" .

ngm:zero-shot-prompting a owl:Class ;
    rdfs:label "Zero-Shot Prompting"@en ;
    rdfs:comment "Zero-shot prompting is the technique of instructing a language model to perform a task using only a description, without providing worked examples. It relies on knowledge the model acquired during pretraining."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        ngm:prompt-engineering ;
