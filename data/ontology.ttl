    vc:relatedTo ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:human-computer-interaction,
        ngm:motion-tracking,
        ngm:pose-estimation ;
    vc:slug "gesture-recognition" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:accessibility,
