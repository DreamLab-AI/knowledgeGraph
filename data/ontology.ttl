ngm:virtual-office-spaces a owl:Class ;
    rdfs:label "Virtual Office Spaces"@en ;
    rdfs:comment "Virtual office spaces are persistent 3D environments hosted on VR or metaverse platforms where distributed teams gather as avatars to collaborate, attend meetings, use shared whiteboards, and navigate spatial office layouts, replicating physical workplace social dynamics whilst enabling global remote participation through immersive telepresence. Unlike transient video calls, these environments preserve spatial context across sessions — desks remain assigned, whiteboards retain content, and colleagues can be discovered by proximity cues. Leading implementations include Microsoft Mesh, Meta Horizon Workrooms, and Spatial."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        ngm:dc-workspace-tools,
        ngm:virtual-environment ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:telecollaboration ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:mixed-reality,
        ngm:remote-collaboration,
        ngm:social-vr ;
    vc:requires ngm:extended-reality ;
    vc:slug "virtual-office-spaces" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:avatar-system,
        ngm:presence,
        ngm:spatial-audio,
        ngm:virtual-reality .

ngm:virtual-replica a owl:Class ;
    rdfs:label "Virtual Replica"@en ;
    rdfs:comment "A digital representation of a physical object, system, or environment created through 3D modelling, photogrammetry, or LiDAR scanning, serving as a static or dynamic copy for visualisation, simulation, analysis, and testing without the real-time bidirectional data connectivity that distinguishes a full digital twin. Virtual replicas are typically point-in-time snapshots; they support heritage preservation, product safety testing, urban planning, and manufacturing visualisation workflows."@en ;
    rdfs:subClassOf ngm:digital-model,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:digital-twin ;
    vc:enables ngm:virtual-factory,
        ngm:virtual-museum-tour ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-modeling,
        ngm:simulation-software ;
    vc:slug "virtual-replica" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-modeling,
        ngm:photogrammetry,
        ngm:simulation .

ngm:virtual-world-creation a owl:Class ;
    rdfs:label "Virtual World Creation"@en ;
    rdfs:comment "The comprehensive process of designing, developing, and deploying immersive 3D virtual environments using game engines, procedural generation algorithms, and specialized terrain tools, encompassing everything from initial concept to fully realized interactive digital worlds for games, metaverse p..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-content-creation ],
        ngm:digital-content-creation,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:physics-engine ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:digital-content-creation ;
    vc:slug "virtual-world-creation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:procedural-generation,
        ngm:rendering-engine .

ngm:vision-language-action-models a owl:Class ;
    rdfs:label "Vision-Language-Action Models"@en ;
    rdfs:comment "Vision-language-action (VLA) models are foundation models that jointly process visual observations and natural-language instructions to produce executable action sequences for embodied agents such as robots. Extending vision-language models with an action-generation head, VLAs are trained on large datasets pairing perception and instructions with demonstrated behaviour, enabling generalisation across tasks, objects, and embodiments. They represent a convergence of multimodal learning and robotics, aiming for generalist policies that follow open-ended commands rather than executing narrowly scripted skills."@en ;
    rdfs:subClassOf ngm:vision-language-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai,
        ngm:robot-learning ;
    vc:slug "vision-language-action-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:imitation-learning,
        ngm:multimodal-learning .

ngm:visual-perception a owl:Class ;
    rdfs:label "Visual Perception"@en ;
    rdfs:comment "Visual perception is a robot or agent's capability to interpret its environment from camera and visual sensor data, extracting the objects, surfaces, motion and spatial structure needed to act. It transforms raw imagery into actionable scene understanding that drives behaviours such as gaze control, manipulation and navigation. Visual perception is a core perceptual modality for embodied robotic systems."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:camera,
        ngm:gaze-control ;
    vc:slug "visual-perception" ;
    vc:sourceDomain "robotics" .

ngm:visual-servoing a owl:Class ;
    rdfs:label "VisualServoing"@en ;
    rdfs:comment "Visual servoing is a robot control paradigm in which camera-derived visual measurements are used as feedback signals within a closed-loop control system to guide the motion of a robotic manipulator or mobile platform towards a goal configuration defined in visual terms. Rather than relying on pre-computed geometric trajectories, visual servoing continuously computes control signals from current image features or image-space error signals, making it inherently adaptive to object pose uncertainty and disturbances. The two primary architectures are image-based visual servoing (IBVS), which minimises error in image feature space, and position-based visual servoing (PBVS), which reconstructs 3D pose and minimises Cartesian error. Visual servoing enables tasks such as precise grasping, assembly alignment, and autonomous navigation without requiring exact geometric calibration."@en ;
    rdfs:subClassOf ngm:robot-control ;
    vc:enables ngm:manipulation,
        ngm:motion-control,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:end-effector,
        ngm:feedback-control ;
    vc:slug "visual-servoing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:closed-loop-control,
        ngm:computer-vision .

ngm:visual-slam a owl:Class ;
    rdfs:label "Visual SLAM"@en ;
    rdfs:comment "Visual simultaneous localisation and mapping (Visual SLAM) is the process of concurrently estimating a camera's trajectory and reconstructing a map of an unknown environment using image data alone or fused with inertial measurements. It combines feature tracking or direct photometric alignment with pose-graph or bundle-adjustment optimisation and loop closure. Visual SLAM is foundational to AR headsets, drones, and mobile robots that lack external positioning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:visual-place-recognition ;
    vc:slug "visual-slam" ;
    vc:sourceDomain "robotics" .

ngm:voice-assistant a owl:Class ;
    rdfs:label "Voice Assistant"@en ;
    rdfs:comment "A voice assistant is a software agent that responds to spoken commands and questions using speech recognition and natural language processing. Examples include assistants built into phones and smart speakers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:conversational-ai ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:slug "voice-assistant" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:vote-delegation a owl:Class ;
    rdfs:label "Vote Delegation"@en ;
    rdfs:comment "Vote delegation is a governance mechanism by which a token holder assigns their voting power to another address that votes on their behalf, without transferring ownership of the underlying assets. It is central to on-chain DAO governance, enabling passive holders to entrust active, informed delegates and improving participation rates. Delegation can be revoked or reassigned, and may be liquid, allowing chained or topic-specific delegation."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delegate-democracy,
        ngm:governance-token ;
    vc:slug "vote-delegation" ;
    vc:sourceDomain "blockchain" .

ngm:vulnerability-analysis a owl:Class ;
    rdfs:label "Vulnerability Analysis"@en ;
    rdfs:comment "Vulnerability analysis is the systematic process of discovering, characterising, and prioritising weaknesses in software, systems, or networks that could be exploited to compromise confidentiality, integrity, or availability. It combines static and dynamic code inspection, configuration review, and exploitability assessment to feed remediation and risk decisions. Unlike threat modelling, which is attacker-centric and design-stage, vulnerability analysis focuses on concrete flaws in deployed or candidate artefacts."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment,
        ngm:threat-modelling ;
    vc:slug "vulnerability-analysis" ;
    vc:sourceDomain "security" .

ngm:vulnerability-assessment a owl:Class ;
    rdfs:label "Vulnerability Assessment"@en ;
    rdfs:comment "Vulnerability assessment is the structured evaluation of an organisation's systems against known weaknesses, producing a prioritised inventory of exposures and recommended mitigations. It is typically scope-bounded and recurring, using automated scanners and authenticated checks to map findings to severity and asset criticality. Mandated by many cybersecurity standards, it provides the baseline evidence for compliance and continuous risk reduction."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:threat-modelling ;
    vc:slug "vulnerability-assessment" ;
    vc:sourceDomain "security" .

ngm:w3-c-did-specification a owl:Class ;
    rdfs:label "W3C DID Specification"@en ;
    rdfs:comment "The W3C Decentralized Identifiers (DIDs) specification is a World Wide Web Consortium recommendation that defines a new type of globally unique, persistent, cryptographically verifiable identifier that does not require a centralised registration authority. A DID resolves to a DID Document containing cryptographic material, service endpoints, and verification methods, enabling the subject to authenticate and authorise interactions without reliance on any single identity provider. The specification defines a generic DID syntax and data model that is method-agnostic, with specific DID methods implementing the create/read/update/deactivate operations on different verifiable data registries including blockchains, distributed ledgers, and peer-to-peer networks. It became a W3C Recommendation in July 2022."@en ;
    rdfs:subClassOf ngm:w3-c-did ;
    vc:enables ngm:decentralized-identity-did,
        ngm:didcomm,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:did-document,
        ngm:w3-c ;
    vc:slug "w3-c-did-specification" ;
    vc:sourceDomain "web" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:digital-identity-standards .

ngm:waveguide-optics a owl:Class ;
    rdfs:label "Waveguide Optics"@en ;
    rdfs:comment "Waveguide optics is the optical-engineering approach used in augmented- and mixed-reality displays to channel projected light from a microdisplay into the user's eye via total internal reflection in a thin transparent substrate. Diffractive, reflective, or holographic gratings couple light in and out, enabling compact, see-through eyewear with a wide eyebox. It is the dominant optical architecture for consumer AR glasses, trading manufacturing complexity for form factor and transparency."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:mixed-reality ;
    vc:slug "waveguide-optics" ;
    vc:sourceDomain "metaverse" .

ngm:wcag-2-2 a owl:Class ;
    rdfs:label "WCAG 2.2"@en ;
    rdfs:comment "WCAG 2.2 is the October 2023 release of the Web Content Accessibility Guidelines published by the W3C Web Accessibility Initiative, introducing nine new success criteria that extend the 2.1 standard with stronger provisions for keyboard navigation, focus appearance, and accessible authentication. It remains structured around four principles — Perceivable, Operable, Understandable, and Robust — with conformance levels A, AA, and AAA. The release removes the Parsing criterion (4.1.1) while tightening requirements for pointer gestures, dragging movements, and redundant input."@en ;
    rdfs:subClassOf ngm:accessibility-standard ;
    vc:enables ngm:accessibility,
        ngm:standards-conformance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility-audit-tool,
        ngm:accessibility-standards,
        ngm:user-interface-standard ;
    vc:slug "wcag-2-2" ;
    vc:sourceDomain "web" ;
    vc:standardizedBy ngm:standards-body .

ngm:wd14-tagger a owl:Class ;
    rdfs:label "WD14 Tagger"@en ;
    rdfs:comment "WD14 Tagger is an automatic image-tagging model and tool that predicts Danbooru-style descriptive tags for images, widely used to caption training datasets for diffusion-model fine-tuning. Built on convolutional or transformer backbones trained on large tagged anime/illustration corpora, it outputs ranked tag confidences that captioning pipelines threshold and assemble into prompts. It is a standard preprocessing step in DreamBooth and LoRA training workflows."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:kohya-dreambooth-and-similar ;
    vc:slug "wd14-tagger" ;
    vc:sourceDomain "ai" .

ngm:weak-to-strong-generalisation a owl:Class ;
    rdfs:label "Weak-to-Strong Generalisation"@en ;
    rdfs:comment "Weak-to-strong generalisation is an AI-alignment research paradigm investigating whether a more capable model can be reliably supervised and improved using labels or feedback from a weaker supervisor. It serves as an empirical analogue for the superalignment problem, in which humans must oversee superhuman systems they cannot fully evaluate. Findings explore how strong students recover latent capabilities beyond the noisy weak teacher's own performance."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:safety-and-alignment ;
    vc:slug "weak-to-strong-generalisation" ;
    vc:sourceDomain "ai" .

ngm:wearable-device-integration a owl:Class ;
    rdfs:label "Wearable Device Integration"@en ;
    rdfs:comment "The technical processes and protocols for connecting wearable computing devices with metaverse platforms, enterprise systems, and cloud services, enabling seamless data exchange, cross-device synchronisation, and coordinated multi-device experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:sc-interaction,
        ngm:system-integration ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:augmented-reality,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:wearable-computing-platform ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:sensor-fusion ;
    vc:slug "wearable-device-integration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:interoperability .

ngm:web-3-infrastructure a owl:Class ;
    rdfs:label "Web3 Infrastructure"@en ;
    rdfs:comment "Web3 infrastructure is the set of protocols, nodes, storage and tooling that supports decentralised applications built on blockchain networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:enables ngm:decentralised-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-ledger-technology ;
    vc:slug "web-3-infrastructure" ;
    vc:sourceDomain "distributed-systems" .

ngm:web-access-control a owl:Class ;
    rdfs:label "Web Access Control"@en ;
    rdfs:comment "Web Access Control (WAC) is a decentralised authorisation system for web resources that uses RDF-based access control lists to specify which agents may read, write, append, or control linked-data resources identified by URIs. It is a core mechanism in the Solid ecosystem, letting individuals govern access to their personal data pods using WebID-based identity. WAC decouples authorisation from any central server, aligning with self-sovereign data principles."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:solid ;
    vc:slug "web-access-control" ;
    vc:sourceDomain "security" .

ngm:web-gl a owl:Class ;
    rdfs:label "WebGL"@en ;
    rdfs:comment "WebGL is a JavaScript API for rendering interactive 2D and 3D graphics in web browsers without plug-ins, based on OpenGL ES. It executes on the GPU through the HTML canvas element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:graphics-api ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu ;
    vc:slug "web-gl" ;
    vc:sourceDomain "computer-graphics" .

ngm:whistleblower-protection a owl:Class ;
    rdfs:label "Whistleblower Protection"@en ;
    rdfs:comment "Whistleblower protection comprises legal and procedural safeguards that shield individuals who report wrongdoing, safety risks, or legal violations from retaliation such as dismissal, demotion, or harassment. In the AI-governance context, it empowers employees of AI developers to disclose information about unmitigated risks from frontier models to regulators or the public. Such provisions appear in legislation like California's frontier-AI safety bills, creating accountability channels beyond internal controls."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:california-ai-bill,
        ngm:regulatory-compliance ;
    vc:slug "whistleblower-protection" ;
    vc:sourceDomain "governance" .

ngm:wiener-process a owl:Class ;
    rdfs:label "Wiener Process"@en ;
    rdfs:comment "The Wiener process, also called standard Brownian motion, is a continuous-time stochastic process characterised by independent, stationary, normally distributed increments starting at zero, with continuous but nowhere-differentiable sample paths. It is the canonical mathematical model of random continuous motion and the foundational driver of stochastic calculus and diffusion equations. The Wiener process underpins models in finance, physics, and the noise schedules of diffusion generative models."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:stochastic-process ;
    vc:slug "wiener-process" ;
    vc:sourceDomain "data" .

ngm:wireless-telemetry-module a owl:Class ;
    rdfs:label "Wireless Telemetry Module"@en ;
    rdfs:comment "A wireless telemetry module is an embedded hardware subsystem that acquires sensor measurements and transmits them over a radio link to a remote receiver without a wired connection. It combines signal conditioning, analogue-to-digital conversion, a microcontroller, and a low-power radio, and is used where wired tethering is impractical, such as implanted devices or remote field sensors. Power efficiency, antenna design, and link reliability are its central engineering constraints."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:brain-computer-interfaces,
        ngm:environmental-monitoring ;
    vc:slug "wireless-telemetry-module" ;
    vc:sourceDomain "infrastructure" .

ngm:word-piece a owl:Class ;
    rdfs:label "WordPiece"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges character sequences by maximising the likelihood of the training corpus under a unigram language model, rather than merging the most frequent pairs. WordPiece is the default tokeniser for BERT, DistilBERT, and ELECTRA, producing vocabularies of approximately 30,000 tokens that handle rare and compound words via subword splitting."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:byte-pair-encoding,
        ngm:sentence-piece ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:subword-tokenisation,
        ngm:tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "word-piece" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:vocabulary .

ngm:workflow-engine a owl:Class ;
    rdfs:label "Workflow Engine"@en ;
    rdfs:comment "A workflow engine is a software system that executes, coordinates, and monitors multi-step processes defined as a sequence or graph of tasks, managing state transitions, branching, retries, and human or system handoffs. It separates process definition from execution, enabling durable, observable orchestration of long-running business or computational workflows. Workflow engines underpin enterprise process automation and increasingly the orchestration of AI agent pipelines."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:workflow-orchestration ;
    vc:slug "workflow-engine" ;
    vc:sourceDomain "infrastructure" .

ngm:workflow-orchestration a owl:Class ;
    rdfs:label "Workflow Orchestration"@en ;
    rdfs:comment "Workflow orchestration is the coordination of multiple interdependent tasks, services, or agents into a coherent end-to-end process, managing ordering, data flow, conditional branching, error handling, and resource allocation. It centralises control logic so that distributed components execute in the correct sequence with the right inputs. In agentic AI systems, orchestration governs how tool calls, sub-agents, and model invocations are sequenced to accomplish complex goals."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agentic-systems-domain,
        ngm:function-calling ;
    vc:slug "workflow-orchestration" ;
    vc:sourceDomain "ai" .

ngm:workforce-augmentation a owl:Class ;
    rdfs:label "Workforce Augmentation"@en ;
    rdfs:comment "Workforce Augmentation refers to the use of AI tools, agentic systems, and intelligent automation to extend the cognitive and physical capabilities of human workers rather than replacing them. By offloading repetitive tasks to AI assistants and copilots, organisations can redeploy human attention to higher-value judgement and creative work, improving both productivity and job quality."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ai-augmented-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-application ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-agents,
        ngm:collaborative-robot,
        ngm:human-robot-interaction,
        ngm:meeting-ai-assistant ;
    vc:slug "workforce-augmentation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agentic-ai,
        ngm:human-in-the-loop,
        ngm:workflow-automation .

ngm:world-inequality-database a owl:Class ;
    rdfs:label "World Inequality Database"@en ;
    rdfs:comment "The World Inequality Database (WID.world) is an open, collaboratively maintained data resource that compiles harmonised series on the distribution of income and wealth within and between countries over long historical periods. It combines national accounts, tax records, surveys, and estimation methods to produce comparable inequality statistics, and underpins the World Inequality Report. It is a primary reference for empirical research on global inequality."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:global-inequality ;
    vc:slug "world-inequality-database" ;
    vc:sourceDomain "data" .

ngm:wormhole a owl:Class ;
    rdfs:label "Wormhole"@en ;
    rdfs:comment "Wormhole is a decentralised cross-chain messaging and asset-transfer protocol that enables the movement of tokens, NFTs, and arbitrary messages between heterogeneous blockchain networks by relying on a network of off-chain guardian validators who attest to events on one chain, producing signed VAA (Verified Action Approval) messages that unlock corresponding assets or trigger logic on the destination chain. Originally launched as a wrapped-asset bridge between Solana and Ethereum in 2020, Wormhole has evolved into a generic interoperability layer supporting over 30 ecosystems. A significant exploit in February 2022 resulted in the theft of approximately 120,000 wETH, subsequently made whole by Jump Crypto."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-interoperability ;
    vc:slug "wormhole" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bridge-contract,
        ngm:smart-contract .

ngm:wyoming-protocol a owl:Class ;
    rdfs:label "Wyoming Protocol"@en ;
    rdfs:comment "The Wyoming Protocol is an open, peer-to-peer communication protocol used in the Home Assistant ecosystem to connect voice and audio services such as wake-word detection, speech-to-text, and text-to-speech. It defines a simple JSON-over-socket event framing that lets independent voice components run as networked services and interoperate locally without cloud dependencies. It matters as the backbone of Home Assistant's privacy-preserving local voice assistant pipeline."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "wyoming-protocol" ;
    vc:sourceDomain "infrastructure" .

ngm:xbrl a owl:Class ;
    rdfs:label "XBRL"@en ;
    rdfs:comment "XBRL (eXtensible Business Reporting Language) is an open XML-based standard for tagging and exchanging business and financial reporting data in a machine-readable form. It uses taxonomies of defined concepts to attach semantic meaning, units, and context to each reported fact, enabling automated validation, comparison, and analysis. It matters because regulators worldwide mandate it for filings, making financial disclosures consistently structured and computable."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting ;
    vc:slug "xbrl" ;
    vc:sourceDomain "governance" .

ngm:xr-accessibility-guideline a owl:Class ;
    rdfs:label "XR Accessibility Guideline"@en ;
    rdfs:comment "Design recommendations and best practices ensuring XR applications and immersive experiences are usable by people with diverse abilities and disabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:implementation-examples ],
        ngm:accessibility-standard,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:assistive-technology-integration,
        ngm:inclusive-xr-design,
        ngm:universal-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:best-practice,
        ngm:design-recommendation,
        ngm:implementation-examples ;
    vc:isPartOf ngm:accessibility-standard ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:accessibility-testing,
        ngm:user-research ;
    vc:slug "xr-accessibility-guideline" ;
    vc:sourceDomain "spatial-computing" .

ngm:xr-testing-infrastructure a owl:Class ;
    rdfs:label "XR Testing Infrastructure"@en ;
    rdfs:comment "The hardware, software, and modological frameworks for validating extended reality applications, including automated testing tools, motion capture systems, user testing labs, performance profiling equipment, and simulation environments for quality assurance of VR, AR, and MR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tracking-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:infra-software-engineering,
        ngm:testing-infrastructure ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:accessibility,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:latency,
        ngm:tracking-technology ;
    vc:slug "xr-testing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:extended-reality,
        ngm:immersive-experience,
        ngm:user-research .

ngm:z-wave-js-ui a owl:Class ;
    rdfs:label "Z-Wave JS UI"@en ;
    rdfs:comment "Z-Wave JS UI is an open-source application that wraps the Z-Wave JS driver to manage a Z-Wave mesh network of smart-home devices through a web interface and to bridge it to home-automation platforms via MQTT. It handles device inclusion, configuration, firmware updates, and network healing, exposing Z-Wave nodes as controllable entities. It matters as a primary integration path between Z-Wave hardware and Home Assistant."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "z-wave-js-ui" ;
    vc:sourceDomain "infrastructure" .

ngm:zero-day-exploits a owl:Class ;
    rdfs:label "Zero-Day Exploits"@en ;
    rdfs:comment "A zero-day exploit is an attack technique that targets a software or hardware vulnerability unknown to the vendor and for which no patch yet exists, giving defenders zero days to prepare. Because the flaw is undisclosed, such exploits bypass signature-based defenses and are highly valuable to attackers, state actors, and exploit brokers. They matter as a central concern in cybersecurity, surveillance, and offensive cyber operations."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-security-and-military,
        ngm:digital-society-surveillance ;
    vc:slug "zero-day-exploits" ;
    vc:sourceDomain "security" .

ngm:zero-trust-architecture-zta a owl:Class ;
    rdfs:label "Zero-Trust Architecture (ZTA)"@en ;
    rdfs:comment "Security model requiring continuous verification of all entities and transactions with least-privilege access enforcement, eliminating implicit trust within metaverse network boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-enforcement-point ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-decision-point ],
        ngm:sc-governance-and-safety,
        ngm:security-architecture ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:breach-containment,
        ngm:dynamic-access-control,
        ngm:insider-threat-mitigation,
        ngm:microsegmentation,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:continuous-verification,
        ngm:least-privilege-access-control,
        ngm:policy-decision-point,
        ngm:policy-enforcement-point,
        ngm:policy-engine ;
    vc:isPartOf ngm:cybersecurity-framework,
        ngm:security-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:device-authentication,
        ngm:encryption,
        ngm:identity-verification,
        ngm:logging-and-monitoring,
        ngm:network-segmentation ;
    vc:slug "zero-trust-architecture-zta" ;
    vc:sourceDomain "spatial-computing" .

ngm:zigbee2-mqtt a owl:Class ;
    rdfs:label "Zigbee2MQTT"@en ;
    rdfs:comment "Zigbee2MQTT is an open-source bridge that connects Zigbee smart-home devices to MQTT, allowing them to be controlled independently of any proprietary vendor hub or cloud. Using an inexpensive Zigbee coordinator radio, it translates device messages into MQTT topics with a large database of supported devices. It matters as a vendor-neutral, locally controlled integration path for Zigbee hardware into platforms like Home Assistant."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "zigbee2-mqtt" ;
    vc:sourceDomain "infrastructure" .

vc:utilises a owl:ObjectProperty ;
    rdfs:label "utilises"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ngm:3-d-generation a owl:Class ;
    rdfs:label "3D Generation"@en ;
    rdfs:comment "3D Generation refers to the automated or semi-automated creation of three-dimensional geometry, appearance, and scene representations using machine learning models, procedural algorithms, or hybrid approaches. Techniques include text-to-3D, image-to-3D, and scene-level generation via neural radiance fields, Gaussian splatting, diffusion models, and large multi-modal networks. The field aims to dramatically reduce the time and skill threshold required to produce photorealistic or stylised 3D content."@en ;
    rdfs:subClassOf ngm:3-d-content-generation ;
    vc:enables ngm:3-d-content-creation,
        ngm:digital-twin-generation,
        ngm:game-asset-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-reconstruction,
        ngm:neural-3-d-generation,
        ngm:text-to-3-d ;
    vc:slug "3-d-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-model,
        ngm:gaussian-splatting,
        ngm:ne-rf .

ngm:3-d-graphics-standard a owl:Class ;
    rdfs:label "3D Graphics Standard"@en ;
    rdfs:comment "3D Graphics Standards are technical specifications and conventions governing the representation, rendering, and interchange of three-dimensional visual data, including APIs like OpenGL, DirectX, and Vulkan, shader languages, and coordinate system conventions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-content-and-assets,
        ngm:sc-display-and-rendering ;
    vc:enables ngm:cross-platform-compatibility,
        ngm:hardware-acceleration,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:technical-specification ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:driver-implementation,
        ngm:gpu-support ;
    vc:slug "3-d-graphics-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:acceleration-structure a owl:Class ;
    rdfs:label "Acceleration Structure"@en ;
    rdfs:comment "An acceleration structure is a spatial data structure that organises geometric primitives in a scene to allow rapid culling of irrelevant geometry during ray intersection or visibility queries, dramatically reducing the computational complexity of rendering algorithms from O(n) per-ray to approximately O(log n). Common forms include bounding volume hierarchies, k-d trees, and octrees, each making different trade-offs between construction time, memory footprint, and query efficiency."@en ;
    rdfs:subClassOf ngm:spatial-index ;
    vc:enables ngm:ray-tracing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:scene-graph ;
    vc:slug "acceleration-structure" ;
    vc:sourceDomain "spatial" ;
    vc:supports ngm:collision-detection,
        ngm:rendering-pipeline ;
    vc:uses ngm:bounding-volume-hierarchy,
        ngm:gpu-acceleration .

ngm:acl a owl:Class ;
    rdfs:label "ACL"@en ;
    rdfs:comment "An Access Control List (ACL) is a data structure attached to a resource — such as a file, directory, or network interface — that enumerates which subjects (users, groups, or processes) are permitted to perform which operations on that resource. Each entry in the list is called an Access Control Entry (ACE) and specifies a principal, a set of permissions (read, write, execute, delete), and whether those permissions are granted or denied. ACLs originated in file-system security (POSIX, NTFS) and were subsequently extended to networking, where routers and firewalls use IP-level ACLs to filter packets by source address, destination port, and protocol. In distributed and cloud environments ACLs underpin fine-grained authorisation that complements role-based and attribute-based access-control models."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:contrastsWith ngm:policy-enforcement-point ;
    vc:enables ngm:policy-enforcement,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control-system,
        ngm:digital-identity,
        ngm:identity-and-access-management ;
    vc:slug "acl" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:authentication,
        ngm:encryption .

ngm:activity-data a owl:Class ;
    rdfs:label "Activity Data"@en ;
    rdfs:comment "Activity data is the structured or semi-structured record of actions, interactions, and events performed by users, devices, or systems over time, capturing what was done, when, by whom, and in what context. It encompasses clickstreams, application usage logs, sensor readings, transaction histories, and learning interaction records, and serves as the raw material for analytics, personalisation, compliance auditing, and behavioural modelling."@en ;
    rdfs:subClassOf ngm:data-collection ;
    vc:enables ngm:analytics-engine,
        ngm:audit-log ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:transparency ;
    vc:slug "activity-data" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:reinforcement-learning-from-human-feedback ;
    vc:uses ngm:telemetry-and-analytics,
        ngm:tracking-system .

ngm:activity-pub a owl:Class ;
    rdfs:label "ActivityPub"@en ;
    rdfs:comment "ActivityPub is a W3C-standardised decentralised social networking protocol that defines two layers: a server-to-server federation protocol enabling independent server instances to share content with one another, and a client-to-server protocol allowing applications to interact with a user's social data. Based on the ActivityStreams 2.0 vocabulary and JSON-LD serialisation, it enables interoperable federated social networks where users on different server instances can follow, reply to, and interact with each other across instance boundaries."@en ;
    rdfs:subClassOf ngm:distributed-protocol ;
    vc:enables ngm:decentralised-web,
        ngm:federated-social-networks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:interoperability-protocol,
        ngm:semantic-web ;
    vc:slug "activity-pub" ;
    vc:sourceDomain "web" ;
    vc:standardizedBy ngm:web-standard ;
    vc:uses ngm:json-ld,
        ngm:linked-data .

ngm:adobe-firefly a owl:Class ;
    rdfs:label "Adobe Firefly"@en ;
    rdfs:comment "Adobe Firefly is Adobe's family of proprietary generative AI models designed for commercial creative applications, offering text-to-image generation, generative fill, vector recolouring, and text-effect capabilities trained exclusively on licensed Adobe Stock imagery, openly licensed content, and public domain material. Launched in March 2023, Firefly is embedded across Adobe Creative Cloud applications and is positioned as an enterprise-safe generative AI tool that provides intellectual property indemnification for commercial outputs. It represents Adobe's strategy to integrate generative AI natively into professional creative workflows."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:enables ngm:image-editing,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adobe-creative-cloud,
        ngm:content-licensing,
        ngm:watermarks ;
    vc:slug "adobe-firefly" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:diffusion-model,
        ngm:text-to-image .

ngm:adversarial-machine-learning a owl:Class ;
    rdfs:label "Adversarial Machine Learning"@en ;
    rdfs:comment "Adversarial machine learning is the study of attacks that exploit vulnerabilities in machine learning models and the development of defences against them, encompassing threats across the model lifecycle including training-time data poisoning, evasion attacks at inference time, model inversion, and membership inference. Attackers craft carefully perturbed inputs or manipulate training data to cause misclassification, extract sensitive information, or degrade model performance, whilst defenders develop robust training procedures, certified defences, and detection mechanisms. The field spans both offensive security research and the development of trustworthy AI systems."@en ;
    rdfs:subClassOf ngm:ai-security ;
    vc:enables ngm:adversarial-robustness,
        ngm:model-robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adversarial-testing,
        ngm:differential-privacy,
        ngm:model-inversion ;
    vc:slug "adversarial-machine-learning" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:adversarial-attacks,
        ngm:data-poisoning .

ngm:advertising a owl:Class ;
    rdfs:label "Advertising"@en ;
    rdfs:comment "Advertising is the practice of communicating persuasive messages about products, services, ideas, or brands to targeted audiences through paid media channels with the intent to influence awareness, attitudes, or purchasing behaviour. It encompasses the creative development of messages and the strategic planning and buying of media placements across channels including broadcast, print, digital, out-of-home, and emerging immersive formats. Modern advertising increasingly relies on data-driven audience targeting, algorithmic media buying, and AI-generated creative to maximise return on investment at scale."@en ;
    rdfs:subClassOf ngm:advertising-and-marketing ;
    vc:enables ngm:programmatic-advertising ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:gdpr,
        ngm:social-media ;
    vc:slug "advertising" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:digital-marketing,
        ngm:predictive-analytics .

ngm:agent-based-models a owl:Class ;
    rdfs:label "Agent-Based Models"@en ;
    rdfs:comment "Agent-Based Models (ABMs) are computational simulation frameworks that represent systems as collections of autonomous, heterogeneous agents that interact with one another and their environment according to local rules, allowing complex global behaviours and emergent phenomena to arise from the bottom up without being explicitly programmed at the system level. They are a primary tool in complexity science for studying social, biological, economic, and technical systems."@en ;
    rdfs:subClassOf ngm:computational-intelligence ;
    vc:enables ngm:collective-intelligence,
        ngm:emergence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop ;
    vc:slug "agent-based-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:autonomous-agent,
        ngm:behavioral-modeling,
        ngm:scientific-computing .

ngm:agent-memory a owl:Class ;
    rdfs:label "Agent Memory"@en ;
    rdfs:comment "Agent memory is the mechanism by which an autonomous agent stores and retrieves information across steps and sessions. It allows an agent to recall past observations, decisions and facts beyond the immediate context window."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:ai-agent ;
    vc:enables ngm:agentic-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:embeddings,
        ngm:vector-database ;
    vc:slug "agent-memory" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:agi-timelines a owl:Class ;
    rdfs:label "AGI Timelines"@en ;
    rdfs:comment "AGI timelines are structured forecasts estimating when artificial general intelligence — AI matching or exceeding human cognitive ability across most economically valuable tasks — might be achieved. Such forecasts aggregate expert surveys, compute-scaling extrapolations, benchmark-progress curves, and Bayesian models of research milestones to produce probability distributions over future dates. Timelines are inherently uncertain and contested, and they materially influence research prioritisation, safety investment, and public policy. They are a distinct object of study within AI forecasting rather than a single predicted date."@en ;
    rdfs:subClassOf ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:gartner-prediction ;
    vc:slug "agi-timelines" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:performance-benchmarks .

ngm:agile-software-development a owl:Class ;
    rdfs:label "Agile Software Development"@en ;
    rdfs:comment "Agile software development is a set of iterative, incremental methods that prioritise working software, close collaboration and adaptation to change over fixed up-front planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-development ],
        ngm:software-engineering-domain ;
    vc:enables ngm:software-engineering-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:software-development ;
    vc:slug "agile-software-development" ;
    vc:sourceDomain "metaverse" .

ngm:ai-development a owl:Class ;
    rdfs:label "AI Development"@en ;
    rdfs:comment "The phase of the AI lifecycle encompassing the design, creation, training, and validation of artificial intelligence systems, including activities such as algorithm selection, data preparation, model architecture design, training process execution, hyperparameter optimisation, performance eand do..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-expertise ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:computational-resources,
        ngm:technical-expertise,
        ngm:training-data ;
    vc:slug "ai-development" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-ethics-board a owl:Class ;
    rdfs:label "AI Ethics Board"@en ;
    rdfs:comment "An AI Ethics Board is a formally constituted, multidisciplinary oversight committee responsible for reviewing AI systems and deployments against ethical principles, organisational values, and applicable regulatory requirements. Comprising technical experts, ethicists, legal and compliance professionals, domain specialists, and stakeholder representatives, the board conducts structured ethical impact assessments, provides binding or advisory guidance on AI deployment decisions, and monitors deployed systems for ongoing compliance. It serves as a key institutional mechanism for operationalising responsible AI principles and maintaining human oversight of consequential automated decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-ethics-checklist ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:compliance-framework,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-ethics-checklist,
        ngm:audit-trail,
        ngm:risk-assessment ;
    vc:implements ngm:ai-policy,
        ngm:ethical-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-governance-principle,
        ngm:governance-board,
        ngm:responsible-ai-principles,
        ngm:stakeholder-engagement-in-ai ;
    vc:requires ngm:governance-structure,
        ngm:human-oversight,
        ngm:stakeholder ;
    vc:slug "ai-ethics-board" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness-constraints,
        ngm:transparency .

ngm:ai-governance-domain a owl:Class ;
    rdfs:label "AI Governance Domain"@en ;
    rdfs:comment "The AI Governance Domain covers the policies, processes and controls that direct the responsible development and deployment of artificial intelligence. Its scope includes risk management, accountability, transparency, fairness assessment and regulatory alignment. It is a sub-area of the Artificial Intelligence Domain concerned with oversight rather than technique. The boundary excludes the technical mitigation of failure modes, which is treated under the AI Safety Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-documentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:regulatory-conformance,
        ngm:responsible-deployment,
        ngm:stakeholder-trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:algorithmic-accountability,
        ngm:audit-trail,
        ngm:fairness-assessment,
        ngm:model-documentation,
        ngm:risk-management ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ai-safety-domain,
        ngm:compliance-domain,
        ngm:regulation-domain ;
    vc:slug "ai-governance-domain" ;
    vc:sourceDomain "ai-governance" .

ngm:ai-incident a owl:Class ;
    rdfs:label "AI Incident"@en ;
    rdfs:comment "An event in which an AI system causes or has the potential to cause harm to individuals, property, the environment, or fundamental rights, encompassing technical failures, security breaches, bias-driven discrimination, privacy violations, and unintended consequences. Under the EU AI Act Article 72, serious incidents must be reported to national competent authorities within 15 days; structured incident taxonomies and response protocols (detection, containment, investigation, remediation) are codified in ISO/IEC 23894:2023."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-management ],
        ngm:ai-governance-and-ethics,
        ngm:ai-risk ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:bias,
        ngm:eu-ai-act ;
    vc:requires ngm:accountability,
        ngm:ai-risk-management ;
    vc:slug "ai-incident" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-operator a owl:Class ;
    rdfs:label "AI Operator"@en ;
    rdfs:comment "An individual or organisational entity responsible for the operational management, monitoring, and control of an artificial intelligence system during its deployment and use, including activities such as configuring system parameters, overseeing system performance, responding to incidents, coordi..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-deployment,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:competence-development,
        ngm:ongoing-support,
        ngm:training ;
    vc:slug "ai-operator" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-provider a owl:Class ;
    rdfs:label "AI Provider"@en ;
    rdfs:comment "An individual, organisation, or legal entity that develops, produces, or supplies an AI system, assuming primary accountability for design decisions, training processes, capabilities, documentation, and regulatory compliance. Under the EU AI Act a provider places a system on the market under their own name, substantially modifies an existing system, or makes it available for use, thereby triggering obligations including conformity assessment, technical documentation, quality management, human oversight design, and post-market monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-lifecycle ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ai-governance-framework,
        ngm:eu-ai-act ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-operator,
        ngm:ai-user,
        ngm:risk-management ;
    vc:requires ngm:ai-impact-assessment,
        ngm:ai-lifecycle ;
    vc:slug "ai-provider" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-trust-risk-and-security-management a owl:Class ;
    rdfs:label "AI Trust Risk and Security Management"@en ;
    rdfs:comment "A comprehensive governance framework — popularised by Gartner and aligned with the NIST AI Risk Management Framework — for managing the trustworthiness, security, and ethical risks of AI systems throughout their lifecycle. It operationalises three pillars: Trust (transparent, auditable, reliable AI behaviour), Risk (proactive identification and mitigation of algorithmic bias, data quality issues, and regulatory non-compliance), and Security (protection against adversarial attacks, data poisoning, and model integrity threats)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-robustness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-trustworthiness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-security ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:ai-risk-management,
        ngm:ai-security,
        ngm:ai-trustworthiness ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-lifecycle,
        ngm:ai-safety,
        ngm:red-teaming ;
    vc:requires ngm:algorithmic-bias,
        ngm:explainable-ai,
        ngm:model-robustness ;
    vc:slug "ai-trust-risk-and-security-management" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-regulation .

ngm:ai-upscaling-and-super-resolution a owl:Class ;
    rdfs:label "AI Upscaling and Super-Resolution"@en ;
    rdfs:comment "AI Upscaling and Super-Resolution is a family of deep learning techniques that synthesise plausible high-frequency detail when enlarging images or video frames beyond their native resolution. Methods range from convolutional neural network regressors (SRCNN, ESRGAN) and generative adversarial approaches to diffusion-based reconstruction, enabling applications from consumer photography enhancement to real-time game upscaling (DLSS, FSR) and medical imaging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:super-resolution ],
        ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:image-processing-software,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:super-resolution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:latent-diffusion,
        ngm:neural-rendering,
        ngm:sc-display-and-rendering ;
    vc:slug "ai-upscaling-and-super-resolution" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-adversarial-network .

ngm:aiethics a owl:Class ;
    rdfs:label "AIEthics"@en ;
    rdfs:comment "A framework of ethical principles and governance structures ensuring responsible development, deployment, and oversight of artificial intelligence systems in compliance with societal values. Addresses fairness, accountability, transparency, bias mitigation, privacy preservation, and alignment with human rights norms across the AI lifecycle from design through decommissioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance-and-ethics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:artificial-superintelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risk,
        ngm:governance ;
    vc:requires ngm:accountability,
        ngm:ai-governance-and-ethics ;
    vc:slug "aiethics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:regulatory-compliance,
        ngm:transparency-notice .

ngm:algorithmic-transparency a owl:Class ;
    rdfs:label "Algorithmic Transparency"@en ;
    rdfs:comment "The principle and practice of making the logic, data inputs, decision criteria, and outputs of algorithmic systems sufficiently accessible and comprehensible to affected stakeholders, oversight bodies, and the general public. It encompasses both technical disclosure—publishing model architectures, training data provenance, and evaluation results—and process-level disclosure of how algorithms are developed, audited, and governed. Algorithmic transparency is recognised as a foundational requirement for accountability and trust in automated decision-making systems."@en ;
    rdfs:subClassOf ngm:explainability ;
    vc:enables ngm:ai-governance-framework,
        ngm:algorithmic-auditing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-transparency-index,
        ngm:algorithmic-transparency-reports,
        ngm:decision-transparency ;
    vc:slug "algorithmic-transparency" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:ai-model-card,
        ngm:explainable-ai .

ngm:alu-vm a owl:Class ;
    rdfs:label "AluVM"@en ;
    rdfs:comment "A purely functional, register-based virtual machine designed for deterministic execution of smart-contract validation logic within client-side validated Bitcoin protocol layers, notably the RGB Protocol. AluVM operates without mutable global state, using a RISC-like instruction set that guarantees bounded execution time and reproducible results across heterogeneous computing environments. Its architecture is specifically optimised for the constraints of client-side validation, where contract logic must execute identically across all validating parties without access to a shared blockchain state machine."@en ;
    rdfs:subClassOf ngm:virtual-machine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:rgb-protocol ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:layer-2-solutions,
        ngm:rgb-and-client-side-validation ;
    vc:slug "alu-vm" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-script,
        ngm:taproot .

ngm:ambient-occlusion a owl:Class ;
    rdfs:label "Ambient Occlusion"@en ;
    rdfs:comment "A shading and rendering technique that approximates the degree to which each point on a surface is occluded from ambient environmental light by surrounding geometry, producing soft shadows in crevices, corners, and contact areas that significantly enhance the perception of three-dimensional form and material grounding. Unlike direct illumination algorithms, ambient occlusion is view-independent and operates on the assumption that ambient light arrives uniformly from all directions, making it computationally tractable as either a pre-baked texture or a real-time screen-space approximation. It is a foundational element of physically plausible rendering pipelines."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:enables ngm:photorealistic-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ar-occlusion,
        ngm:dynamic-lighting,
        ngm:occlusion-culling ;
    vc:slug "ambient-occlusion" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:physically-based-rendering,
        ngm:ray-tracing .

ngm:apilayer a owl:Class ;
    rdfs:label "APILayer"@en ;
    rdfs:comment "The API Layer is the stratum that exposes a system's capabilities as callable, contractually defined endpoints. It sits above the application logic it fronts and below integration and interface strata that connect consumers. It contains endpoint definitions, request and response schemas, authentication hooks, and versioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:application-layer ],
        ngm:owl-thing ;
    vc:enables ngm:integration-layer,
        ngm:interface-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:application-layer ;
    vc:slug "apilayer" ;
    vc:sourceDomain "apilayer" .

ngm:ar-occlusion a owl:Class ;
    rdfs:label "AR Occlusion"@en ;
    rdfs:comment "AR occlusion is the computational technique by which virtual objects rendered in an augmented reality scene are correctly hidden or partially hidden by real-world geometry that physically lies in front of them from the viewer's perspective. Achieving occlusion requires real-time estimation of the depth structure of the physical scene, typically via depth sensors or monocular depth estimation neural networks, so that the rendering pipeline can apply correct depth ordering between real and virtual content. Without occlusion, virtual objects appear to float unconvincingly in front of all physical surfaces regardless of their spatial relationship."@en ;
    rdfs:subClassOf ngm:augmented-reality ;
    vc:enables ngm:real-time-rendering,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:mixed-reality,
        ngm:occlusion-rendering ;
    vc:slug "ar-occlusion" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:computer-vision,
        ngm:depth-estimation,
        ngm:scene-understanding .

ngm:arbitrum a owl:Class ;
    rdfs:label "Arbitrum"@en ;
    rdfs:comment "Arbitrum is a family of Ethereum layer-2 scaling solutions developed by Offchain Labs that use optimistic rollup technology to increase transaction throughput and reduce fees. Its flagship network, Arbitrum One, launched on mainnet in 2021 and executes transactions in a custom virtual machine while posting transaction data and state commitments to Ethereum. Arbitrum's interactive multi-round fraud-proof protocol distinguishes it from other optimistic rollups by narrowing disputes to a single instruction before on-chain resolution. The ARB token governs the network through the Arbitrum DAO, and Arbitrum Nitro and Orbit extend the technology to custom chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:blockchain-domain ;
    vc:enables ngm:decentralised-finance-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:fraud-proof,
        ngm:rollup ;
    vc:slug "arbitrum" ;
    vc:sourceDomain "arbitrum" .

ngm:architectural-visualisation a owl:Class ;
    rdfs:label "Architectural Visualisation"@en ;
    rdfs:comment "Architectural visualisation is the discipline of producing photorealistic or stylised two- and three-dimensional representations of proposed buildings, interiors, and urban environments to communicate design intent to clients, planners, and the public before construction. It combines techniques from 3D modelling, physically based rendering, and real-time graphics to produce still images, animations, and interactive walkthroughs. Advances in real-time rendering engines and spatial computing have extended the discipline to include immersive virtual reality experiences and augmented reality overlays on physical construction sites."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:bim-virtual-model ;
    vc:slug "architectural-visualisation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-model,
        ngm:real-time-rendering .

ngm:artificial-superintelligence a owl:Class ;
    rdfs:label "artificial superintelligence"@en ;
    rdfs:comment "A hypothetical form of artificial intelligence that surpasses human cognitive performance across all domains, capable of recursive self-improvement leading to an intelligence explosion. Distinguished from artificial general intelligence by the degree of capability surplus; considered an existential risk scenario requiring robust safety and alignment research before any attempt at development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artificial-general-intelligence ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:ai-safety,
        ngm:singularity ;
    vc:requires ngm:artificial-general-intelligence,
        ngm:machine-learning ;
    vc:slug "artificial-superintelligence" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:aiethics .

ngm:asic-hardware a owl:Class ;
    rdfs:label "ASIC Hardware"@en ;
    rdfs:comment "Application-Specific Integrated Circuits (ASICs) are custom silicon chips designed and manufactured to perform a fixed, narrowly defined computational task with maximum efficiency. Unlike general-purpose processors, ASIC hardware sacrifices programmability for dramatically superior performance-per-watt ratios in its target workload, making it the dominant substrate for high-throughput, power-sensitive deployments."@en ;
    rdfs:subClassOf ngm:computer-hardware ;
    vc:contrastsWith ngm:fpga ;
    vc:enables ngm:digital-signal-processing,
        ngm:neural-processing-unit,
        ngm:parallel-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems ;
    vc:slug "asic-hardware" ;
    vc:sourceDomain "infrastructure" .

ngm:asset-database a owl:Class ;
    rdfs:label "Asset Database"@en ;
    rdfs:comment "An Asset Database is a structured, queryable repository that stores descriptive records, binary references, version histories, and relational metadata for digital assets within a production or distribution system. It provides the persistent backbone enabling discovery, retrieval, provenance tracking, and lifecycle management of assets across teams and pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:database-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metadata ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph ;
    vc:slug "asset-database" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asset-management-system,
        ngm:digital-asset-management ;
    vc:uses ngm:metadata-schema,
        ngm:search-engine .

ngm:asset-liquidity a owl:Class ;
    rdfs:label "Asset Liquidity"@en ;
    rdfs:comment "Asset Liquidity is the degree to which a digital or tokenised asset can be converted into cash or another asset at close to its fair market value without materially moving that price or incurring prohibitive friction. In decentralised finance and tokenised asset markets, liquidity is determined by order-book depth, automated market maker reserves, and the breadth of platforms on which an asset can be traded."@en ;
    rdfs:subClassOf ngm:decentralised-finance ;
    vc:enables ngm:atomic-swap,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:digital-ownership ;
    vc:slug "asset-liquidity" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:exchange-mechanism,
        ngm:liquidity-pool .

ngm:asset-metadata a owl:Class ;
    rdfs:label "Asset Metadata"@en ;
    rdfs:comment "Asset Metadata is the structured descriptive, administrative, and technical information attached to a digital asset that contextualises it within a system without being the primary content of that asset. It encompasses identifiers, provenance records, format specifications, rights information, semantic tags, and dependency relationships, enabling discovery, validation, licensing, and lifecycle management."@en ;
    rdfs:subClassOf ngm:metadata ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:ontology ;
    vc:slug "asset-metadata" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asset-management-system,
        ngm:digital-asset-management ;
    vc:uses ngm:metadata-schema,
        ngm:metadata-standard .

ngm:asset-service a owl:Class ;
    rdfs:label "Asset Service"@en ;
    rdfs:comment "An Asset Service is a runtime or backend system that exposes digital assets and their associated metadata to consuming applications through well-defined APIs, handling storage, retrieval, transcoding, access control, and lifecycle operations as managed infrastructure. It abstracts the complexity of distributed storage and processing from client applications, enabling consistent, scalable access to asset libraries."@en ;
    rdfs:subClassOf ngm:service-layer ;
    vc:enables ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:platform-service ;
    vc:slug "asset-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asset-management-system,
        ngm:content-pipeline ;
    vc:uses ngm:api-management,
        ngm:digital-asset-management .

ngm:assistive-technology a owl:Class ;
    rdfs:label "Assistive Technology"@en ;
    rdfs:comment "Assistive technology is equipment or software that helps people with disabilities perform tasks they would otherwise find difficult. Examples include screen readers, hearing aids and alternative input devices."@en ;
    rdfs:subClassOf ngm:accessibility ;
    vc:enables ngm:education ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "assistive-technology" ;
    vc:sourceDomain "accessibility" .

ngm:attention-aware-interaction a owl:Class ;
    rdfs:label "Attention Aware Interaction"@en ;
    rdfs:comment "Attention Aware Interaction refers to human-computer interaction techniques that leverage eye tracking, gaze detection, and attention modeling to understand user focus and adapt interfaces accordingly, enabling foveated rendering, gaze-based selection, and contextual content presentation in VR, A..."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:human-computer-interaction ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:adaptive-interfaces,
        ngm:foveated-rendering,
        ngm:gaze-based-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:attention-modeling,
        ngm:eye-tracking-hardware,
        ngm:gaze-detection-algorithms ;
    vc:slug "attention-aware-interaction" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:audio-signal-processing a owl:Class ;
    rdfs:label "Audio Signal Processing"@en ;
    rdfs:comment "Audio Signal Processing is the application of signal processing theory and algorithms to the analysis, transformation, synthesis, and encoding of audio-frequency signals, operating in either the time domain or frequency domain. It encompasses filtering, equalisation, dynamic range control, time-frequency analysis, psychoacoustic coding, and spatial rendering as applied to sound reproduction, communication, and computational audition systems."@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:enables ngm:spatial-audio,
        ngm:speech-recognition,
        ngm:speech-synthesis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-engine,
        ngm:audio-processing-system ;
    vc:slug "audio-signal-processing" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:audio-parameters,
        ngm:digital-signal-processing .

ngm:audit-function a owl:Class ;
    rdfs:label "Audit Function"@en ;
    rdfs:comment "An organisational capability or dedicated unit responsible for the planning, execution, and reporting of audit activities within or on behalf of an enterprise. The audit function provides independent assurance over risk management, internal controls, and governance processes, acting as a critical third line of defence in enterprise risk frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-mechanism ],
        ngm:audit ;
    vc:enables ngm:accountability,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audit-mechanism,
        ngm:audit-trail ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:governance-framework,
        ngm:risk-management-framework,
        ngm:transparency ;
    vc:slug "audit-function" ;
    vc:sourceDomain "governance" .

ngm:autonomous-ai-agents a owl:Class ;
    rdfs:label "Autonomous AI Agents"@en ;
    rdfs:comment "Autonomous AI Agents are intelligent software systems capable of independently perceiving their environment, reasoning over goals, planning multi-step action sequences, and executing tasks without continuous human intervention, typically powered by large language models or reinforcement learning. They differ from simpler AI tools by their ability to set sub-goals, call external tools, manage memory, and adapt dynamically to novel situations. Autonomous agents are increasingly deployed in enterprise workflows, research automation, customer service, and multi-agent collaborative systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:ai-agent-system,
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:planning-and-scheduling,
        ngm:reasoning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:autonomous-agent,
        ngm:autonomous-robot,
        ngm:multi-agent-systems ;
    vc:requires ngm:ai-safety,
        ngm:explainability ;
    vc:slug "autonomous-ai-agents" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models,
        ngm:reinforcement-learning,
        ngm:workflow-automation .

ngm:autonomous-mobile-robots a owl:Class ;
    rdfs:label "Autonomous Mobile Robots"@en ;
    rdfs:comment "Robotic platforms capable of self-directed locomotion through environments, navigating without fixed infrastructure guidance by using onboard sensing, mapping, localisation, and path-planning capabilities. Autonomous mobile robots (AMRs) operate in dynamic, human-shared spaces and are distinguished from automated guided vehicles (AGVs) by their ability to adapt routes in real time rather than following pre-defined paths."@en ;
    rdfs:subClassOf ngm:mobile-robotics ;
    vc:enables ngm:logistics-automation,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-avoidance,
        ngm:fleet-management,
        ngm:mobile-robot-platform,
        ngm:ros-navigation-stack ;
    vc:slug "autonomous-mobile-robots" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:path-planning,
        ngm:sensor-fusion,
        ngm:slam .

ngm:autonomous-operation a owl:Class ;
    rdfs:label "Autonomous Operation"@en ;
    rdfs:comment "The sustained execution of a system's core functions without ongoing human intervention, encompassing self-monitoring, self-configuration, self-healing, and self-optimisation capabilities that allow the system to maintain operational objectives across varying environmental conditions and failure states. Autonomous operation represents the highest level of system self-sufficiency on the automation continuum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-behavior ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:autonomous-system ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-agent,
        ngm:autonomous-mobile-robots ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:functional-safety,
        ngm:monitoring-system ;
    vc:requires ngm:autonomous-behavior,
        ngm:feedback-control ;
    vc:slug "autonomous-operation" ;
    vc:sourceDomain "ai" .

ngm:autonomy-level a owl:Class ;
    rdfs:label "Autonomy Level"@en ;
    rdfs:comment "A graded classification (typically 0–5) quantifying the degree to which an agent perceives, decides, and acts without human intervention, ranging from fully manual operation through partial and conditional autonomy to full self-governance, with domain-specific scales for AI, robotics, blockchain DAOs, and multi-agent systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:ai-agent-system,
        ngm:bdi-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:goal,
        ngm:objective ;
    vc:requires ngm:human-in-the-loop,
        ngm:safety ;
    vc:slug "autonomy-level" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:eu-ai-act .

ngm:autoregressive-model a owl:Class ;
    rdfs:label "Autoregressive Model"@en ;
    rdfs:comment "A model that generates a sequence by predicting each element conditioned on the previously generated elements, factorising the joint distribution into a product of conditional distributions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        ngm:generative-model ;
    vc:enables ngm:language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probabilistic-model ;
    vc:slug "autoregressive-model" ;
    vc:sourceDomain "machine-learning" .

ngm:avatar-behavior a owl:Class ;
    rdfs:label "Avatar Behavior"@en ;
    rdfs:comment "The set of behavioural patterns, animation responses, and interactive capabilities that govern how avatars and NPCs act in virtual environments, driven by AI/ML inference, procedural animation, inverse kinematics, facial expression synthesis, and real-time response to user inputs and social context."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-avatars,
        ngm:avatar,
        ngm:avatar-system,
        ngm:digital-human-technology,
        ngm:intelligent-npc ;
    vc:slug "avatar-behavior" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:animation-retargeting,
        ngm:behavioral-modeling,
        ngm:inverse-kinematics .

ngm:axelar a owl:Class ;
    rdfs:label "Axelar"@en ;
    rdfs:comment "Axelar is a decentralised cross-chain communication network that enables general message passing and token transfers between heterogeneous blockchains via a proof-of-stake overlay network and a permissionless gateway smart contract model. It provides a Universal Message Passing (UMP) primitive that allows any contract on any connected chain to call any contract on any other connected chain as a single composable operation."@en ;
    rdfs:subClassOf ngm:cross-chain-interoperability ;
    vc:enables ngm:cross-chain-messaging,
        ngm:omnichain-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chainlink-ccip,
        ngm:cosmos-ibc,
        ngm:wormhole ;
    vc:slug "axelar" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:proof-of-stake .

ngm:bank-of-england a owl:Class ;
    rdfs:label "Bank of England"@en ;
    rdfs:comment "The Bank of England (BoE) is the United Kingdom's central bank, responsible for monetary policy, financial stability, and prudential regulation of deposit-taking institutions and systemically important insurers. Founded in 1694, it issues banknotes, operates the RTGS payment infrastructure, and co-regulates financial markets alongside the Financial Conduct Authority under the framework established by the Financial Services and Markets Act 2000."@en ;
    rdfs:subClassOf ngm:central-bank ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:financial-regulation,
        ngm:financial-stability ;
    vc:slug "bank-of-england" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-stability-board ;
    vc:supports ngm:compliance-framework,
        ngm:risk-management-framework .

ngm:basel-committee-on-banking-supervision a owl:Class ;
    rdfs:label "Basel Committee on Banking Supervision"@en ;
    rdfs:comment "The Basel Committee on Banking Supervision (BCBS) is the primary global standard-setter for the prudential regulation of banks, operating under the auspices of the Bank for International Settlements in Basel, Switzerland. It develops minimum capital, liquidity, and leverage requirements — collectively the Basel Accords (Basel I, II, III, and the finalised Basel III framework completed in 2017) — that are adopted into national law by its 45-member jurisdictions. The Committee does not possess formal supranational authority; compliance is achieved through voluntary adoption by member central banks and supervisory agencies."@en ;
    rdfs:subClassOf ngm:regulatory-authority ;
    vc:enables ngm:regulatory-compliance,
        ngm:regulatory-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:financial-regulation,
        ngm:regulatory-standards,
        ngm:risk-management,
        ngm:systemic-risk ;
    vc:slug "basel-committee-on-banking-supervision" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:regulatory-technology .

ngm:bc-0120-consensus-mechanism a owl:Class ;
    rdfs:label "BC-0120-consensus-mechanism"@en ;
    rdfs:comment "BC-0120-consensus-mechanism is an ontology catalogue entry representing the knowledge domain of blockchain consensus mechanisms — the family of distributed protocols by which a peer-to-peer network of nodes agrees on a canonical ordering of transactions and the current state of a shared ledger without a trusted central authority. It serves as an organising concept node within a blockchain knowledge graph taxonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:finality,
        ngm:sybil-resistance ;
    vc:slug "bc-0120-consensus-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:fork-choice-rule .

ngm:bdi-model a owl:Class ;
    rdfs:label "BDI Model"@en ;
    rdfs:comment "A deliberative agent architecture grounded in Bratman's theory of practical reasoning, structuring agent cognition around Beliefs (knowledge about the world), Desires (motivational goals), and Intentions (committed plans), with a reasoning cycle of belief revision, deliberation, means-end reasoning, and intention reconsideration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:goal ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:ai-agent-system,
        ngm:autonomy-level ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent,
        ngm:goal ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:human-in-the-loop,
        ngm:objective ;
    vc:slug "bdi-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:artificial-intelligence .

ngm:behavior-analysis a owl:Class ;
    rdfs:label "Behavior Analysis"@en ;
    rdfs:comment "Behavior Analysis is an AI and machine learning technique concerned with the systematic observation, modelling, and interpretation of patterns in entity actions — whether human users, software agents, or autonomous systems — in order to detect anomalies, predict future actions, or classify intent. It combines statistical modelling, sequence analysis, and supervised or unsupervised learning to extract actionable intelligence from behavioural streams. Typical applications include cybersecurity threat detection, user experience optimisation, game AI design, and fraud prevention."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioral-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pattern-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioral-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fraud-detection,
        ngm:predictive-analytics,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
