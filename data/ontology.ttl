ngm:control-net a owl:Class ;
    rdfs:label "ControlNet"@en ;
    rdfs:comment "ControlNet is a trainable adapter architecture that attaches conditional spatial control to pre-trained text-to-image diffusion models by duplicating the U-Net encoder into a locked copy and a trainable copy, connecting them through zero-convolution layers initialised to exactly zero weight and bias. The zero initialisation guarantees that at the start of training no gradient noise corrupts the pre-trained backbone, allowing fine-tuning on relatively small paired datasets of (control map, image) pairs. Input control maps include Canny edge maps, depth maps, human pose skeletons, semantic segmentation masks, surface normal maps, line-art, and scribbles, each producing spatially precise, prompt-steerable image generation. The result is a modular conditioning mechanism that can be composed — multiple ControlNets with weighted merging — and transplanted across base diffusion model checkpoints without retraining."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:computer-vision,
        ngm:generative-ai ;
    vc:contrastsWith ngm:ip-adapter,
        ngm:lora,
        ngm:textual-inversion ;
    vc:dependsOn ngm:convolutional-neural-network,
        ngm:denoising-diffusion ;
    vc:enables ngm:conditional-image-synthesis,
        ngm:image-generation,
        ngm:spatially-guided-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder-copy,
        ngm:zero-convolution ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adapter-tuning,
        ngm:depth-estimation,
        ngm:edge-detection,
        ngm:image-conditioning,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:requires ngm:fine-tuning,
        ngm:neural-network-architecture,
        ngm:transfer-learning ;
    vc:slug "control-net" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:diffusion-model,
        ngm:latent-diffusion,
        ngm:stable-diffusion,
        ngm:u-net,
        ngm:zero-convolution .

