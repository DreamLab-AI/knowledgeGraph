    vc:sourceDomain "robotics" .

ngm:inference-compute a owl:Class ;
    rdfs:label "Inference Compute"@en ;
    rdfs:comment "Inference compute is the computational capacity consumed when a trained machine-learning model generates outputs from inputs, as distinct from the compute used during training. For large language models it scales with model size, context length, and the number of generated tokens, and increasingly with test-time reasoning techniques that spend more compute per query to improve answers. It is a primary cost and latency driver for deployed AI systems and agents."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "inference-compute" ;
    vc:sourceDomain "ai" .

ngm:inference-infrastructure a owl:Class ;
    rdfs:label "Inference Infrastructure"@en ;
    rdfs:comment "Inference infrastructure is the stack of hardware, serving software, and orchestration used to deploy machine-learning models for low-latency, high-throughput prediction in production. It encompasses accelerator fleets, model servers, autoscaling, load balancing, batching engines, and caching layers that route requests and manage GPU memory. It is what makes real-time AI services such as search and chat economically and operationally viable at scale."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:proprietary-large-language-models ;
    vc:slug "inference-infrastructure" ;
    vc:sourceDomain "ai" .

ngm:inflation-hedge a owl:Class ;
    rdfs:label "Inflation Hedge"@en ;
    rdfs:comment "An inflation hedge is an asset expected to retain or increase its value as the general price level rises, protecting purchasing power. Commonly cited examples include gold, real estate and index-linked bonds."@en ;
    rdfs:subClassOf ngm:store-of-value ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
