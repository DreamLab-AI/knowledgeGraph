ngm:tensor-rt a owl:Class ;
    rdfs:label "TensorRT"@en ;
    rdfs:comment "TensorRT is NVIDIA's high-performance deep learning inference optimisation SDK that takes trained neural network models and compiles them into highly efficient inference engines tuned for specific NVIDIA GPU architectures. It performs a suite of graph-level and kernel-level optimisations including layer fusion, tensor fusion, kernel auto-tuning, precision calibration (FP32, FP16, INT8, FP8), and dynamic shape support to maximise throughput and minimise latency. Models from training frameworks are ingested primarily via the ONNX interchange format, then compiled offline into serialised engine files that are loaded at runtime. TensorRT underpins production AI inference across data-centre GPU clusters, autonomous vehicle compute stacks, and NVIDIA Jetson edge platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nvidia-gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        ngm:inference-engine ;
    vc:bridgesTo ngm:autonomous-vehicle ;
    vc:contrastsWith ngm:onnx-runtime,
        ngm:openvino,
        ngm:tensor-flow-lite ;
    vc:dependsOn ngm:cuda,
        ngm:deep-learning-framework ;
    vc:enables ngm:edge-inference,
        ngm:low-latency,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:graph-optimisation,
        ngm:post-training-quantisation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:nvidia-corporation-jetson,
        ngm:python-pytorch-deep-learning-stack,
        ngm:tensor-flow ;
    vc:requires ngm:cuda,
        ngm:hardware-acceleration,
        ngm:nvidia-gpu ;
    vc:slug "tensor-rt" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:autonomous-driving,
        ngm:model-deployment,
        ngm:triton-inference-server ;
    vc:uses ngm:kernel-fusion,
        ngm:mixed-precision-training,
        ngm:onnx,
        ngm:quantisation .

ngm:terminal-coding-agents a owl:Class ;
    rdfs:label "Terminal Coding Agents"@en ;
    rdfs:comment "Terminal-native AI coding agents that operate through CLI interfaces with tool-call loops, providing autonomous software development capabilities via text-based interaction — includes opencode, Gemini CLI, Codex, crush, Open Interpreter, goose, and aider."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:agent-harness ;
    vc:enables ngm:autonomous-agent,
        ngm:software-engineering-automation,
        ngm:task-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:agent-evaluation-benchmarks,
        ngm:agent-execution-sandboxes,
        ngm:harness-configuration-packs,
        ngm:ide-coding-agents,
        ngm:multi-agent-orchestration-frameworks ;
    vc:requires ngm:agent-loop,
        ngm:large-language-models,
        ngm:sandboxed-code-execution,
        ngm:tool-use ;
    vc:slug "terminal-coding-agents" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:function-calling,
        ngm:harness-configuration-packs,
        ngm:model-context-protocol .

ngm:tessellation-shader a owl:Class ;
    rdfs:label "Tessellation Shader"@en ;
    rdfs:comment "A tessellation shader is a programmable stage of the GPU graphics pipeline that subdivides coarse geometric patches into finer primitives at render time, controlling the level of detail of surfaces dynamically. It comprises a control phase that sets tessellation factors and an evaluation phase that positions the generated vertices. By adaptively refining meshes on the GPU, it produces smooth curved surfaces and displacement-mapped detail without inflating the source geometry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:shader-language ;
    vc:contrastsWith ngm:compute-shader ;
    vc:enables ngm:level-of-detail,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rasterization ;
    vc:isPartOf ngm:graphics-pipeline,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:rasterization,
        ngm:webgpu ;
    vc:requires ngm:gpu,
        ngm:vertex-shader ;
    vc:slug "tessellation-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:level-of-detail ;
    vc:uses ngm:shader-language .

ngm:testing-infrastructure a owl:Class ;
    rdfs:label "Testing Infrastructure"@en ;
    rdfs:comment "The ensemble of tools, environments, frameworks, and automated pipelines used to validate software correctness, performance, and reliability across development and deployment stages. Testing infrastructure encompasses unit, integration, and end-to-end test runners, continuous integration services, containerised test environments, and monitoring dashboards that together ensure software meets quality standards before release."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        ngm:infra-software-engineering,
        ngm:quality-assurance ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:testing-process ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:monitoring-dashboard,
        ngm:software-testing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-security ;
    vc:slug "testing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:quality-assurance .

ngm:text-mining a owl:Class ;
    rdfs:label "Text Mining"@en ;
    rdfs:comment "Text mining is the automated discovery of useful patterns, structure and knowledge from large collections of unstructured natural-language text. It combines natural-language processing, information retrieval and data-mining techniques to transform documents into structured representations amenable to analysis. Applications span extracting entities and relations, classifying and clustering documents, and surfacing trends across corpora too large to read manually."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:information-extraction ;
    vc:contrastsWith ngm:information-retrieval ;
    vc:dependsOn ngm:natural-language-understanding ;
    vc:enables ngm:coreference-resolution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:information-extraction,
        ngm:named-entity-recognition ;
    vc:implements ngm:data-mining ;
    vc:isPartOf ngm:data-mining ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:named-entity-recognition,
        ngm:sentiment-analysis ;
    vc:requires ngm:tokenization ;
    vc:slug "text-mining" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:sentiment-analysis ;
    vc:uses ngm:information-retrieval,
        ngm:natural-language-processing .

ngm:texture-compression a owl:Class ;
    rdfs:label "Texture Compression"@en ;
    rdfs:comment "Texture compression is a set of techniques that store image textures in compact, GPU-decodable formats to reduce memory footprint and bandwidth during real-time rendering. Unlike general image compression, these formats support fast random access and fixed-rate block decoding directly in hardware, trading some image quality for large savings in storage and runtime cost. Common schemes include block-based formats such as BCn, ETC and ASTC."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:game-engine ;
    vc:dependsOn ngm:gpu-memory ;
    vc:enables ngm:level-of-detail,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mipmap ;
    vc:isPartOf ngm:asset-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-compression,
        ngm:shader,
        ngm:texture-mapping ;
    vc:requires ngm:gpu ;
    vc:slug "texture-compression" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:real-time-rendering,
        ngm:rendering ;
    vc:uses ngm:data-compression,
        ngm:texture-mapping .

ngm:think-aloud-protocol a owl:Class ;
    rdfs:label "Think Aloud Protocol"@en ;
    rdfs:comment "The Think Aloud Protocol is a qualitative usability research method in which participants verbalise their thought processes continuously while performing tasks with a system or interface. Originating in cognitive psychology, it provides direct access to users' mental models, expectations, and confusion points. The method is widely used in human-computer interaction research and UX design to uncover usability issues that observation alone cannot reveal. Two variants exist: concurrent think-aloud (verbalising during the task) and retrospective think-aloud (recalling thoughts after completing it)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usability-testing ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:dependsOn ngm:task-analysis,
        ngm:user-research ;
    vc:enables ngm:interaction-design,
        ngm:usability-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cognitive-walkthrough,
        ngm:usability-testing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:slug "think-aloud-protocol" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:user-centred-design ;
    vc:uses ngm:eye-tracking,
        ngm:session-recording,
        ngm:verbal-protocol-analysis .

ngm:third-party-auditing a owl:Class ;
    rdfs:label "Third Party Auditing"@en ;
    rdfs:comment "Third-party auditing is the independent examination of an organisation's systems, processes, controls, or claims by an external party that has no stake in the outcome, in order to provide credible assurance to stakeholders. By separating the auditor from the audited, it strengthens trust, accountability, and regulatory compliance beyond what self-assessment can offer. In technology and AI governance it covers security audits, conformity assessment, and verification of model or supply-chain claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:audit ;
    vc:bridgesTo ngm:standards ;
    vc:enables ngm:accountability,
        ngm:certification,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:conformity-assessment ;
    vc:isPartOf ngm:audit,
        ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
        ngm:penetration-testing,
        ngm:security-audit ;
    vc:requires ngm:audit-trail,
        ngm:transparency ;
    vc:slug "third-party-auditing" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:quality-assurance,
        ngm:regulatory-compliance ;
    vc:uses ngm:attestation,
        ngm:verification .

ngm:third-party-certification a owl:Class ;
    rdfs:label "Third Party Certification"@en ;
    rdfs:comment "Third-party certification is a conformity-assessment arrangement in which an independent accredited body, with no commercial interest in the outcome, evaluates a product, system or process against a defined standard and issues a certificate attesting to conformity. Its independence distinguishes it from first-party self-declaration and second-party customer assessment, lending the result greater credibility and market trust. In artificial intelligence it is increasingly proposed as a mechanism to assure that systems meet safety, fairness and governance requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        ngm:certification ;
    vc:contrastsWith ngm:ai-audit ;
    vc:dependsOn ngm:quality-assurance ;
    vc:enables ngm:regulatory-compliance,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:conformity-assessment ;
    vc:implements ngm:certification ;
    vc:isPartOf ngm:certification,
        ngm:conformity-assessment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:responsible-ai ;
    vc:requires ngm:conformity-assessment,
        ngm:risk-assessment ;
    vc:slug "third-party-certification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:ai-governance,
        ngm:trustworthy-ai ;
    vc:uses ngm:ai-audit .

ngm:third-party-risk-management a owl:Class ;
    rdfs:label "Third-Party Risk Management"@en ;
    rdfs:comment "Third-party risk management (TPRM) is the discipline of identifying, assessing, and controlling the risks an organisation inherits from vendors, suppliers, and other external partners. It covers due diligence, contractual controls, ongoing monitoring, and offboarding across security, compliance, operational, and reputational dimensions. TPRM has become essential as organisations rely on extended ecosystems of cloud services and outsourced functions."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:supply-chain-security ;
    vc:slug "third-party-risk-management" ;
    vc:sourceDomain "governance" .

ngm:threshold-optimisation a owl:Class ;
    rdfs:label "Threshold Optimisation"@en ;
    rdfs:comment "Threshold optimisation is the process of selecting the decision boundary applied to a model's continuous scores so that discrete predictions best satisfy a chosen objective. By tuning where a probability or score is converted into a class label, practitioners trade off precision against recall, manage class imbalance, and satisfy fairness or cost constraints. It is a post-hoc technique that adjusts operating points without retraining the underlying model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classification-threshold ],
        ngm:model-evaluation ;
    vc:bridgesTo ngm:fairness-in-machine-learning ;
    vc:contrastsWith ngm:equalized-odds ;
    vc:dependsOn ngm:model-calibration ;
    vc:enables ngm:bias-mitigation-techniques,
        ngm:fairness-metrics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:classification-threshold,
        ngm:decision-threshold ;
    vc:implements ngm:bias-mitigation-techniques ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:classification-threshold,
        ngm:machine-learning-model ;
    vc:slug "threshold-optimisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-evaluation ;
    vc:uses ngm:model-calibration,
        ngm:roc-curve .

ngm:threshold-selection a owl:Class ;
    rdfs:label "Threshold Selection"@en ;
    rdfs:comment "Threshold selection is the process of choosing the decision boundary that converts a classifier's continuous scores or probabilities into discrete class labels. The chosen threshold trades off competing error types, moving along the trade-off captured by the ROC and precision-recall curves. Appropriate selection depends on the relative costs of false positives and false negatives and on class prevalence in the deployment setting."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:bridgesTo ngm:statistical-inference ;
    vc:dependsOn ngm:precision,
        ngm:recall,
        ngm:specificity ;
    vc:enables ngm:classification,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-evaluation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:evaluation-metric,
        ngm:f1-score,
        ngm:sensitivity ;
    vc:slug "threshold-selection" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:supervised-learning ;
    vc:uses ngm:confusion-matrix,
        ngm:precision-recall-curve,
        ngm:roc-curve .

ngm:time-series a skos:Concept ;
    rdfs:label "Time Series"@en .

ngm:timestamp-service a owl:Class ;
    rdfs:label "Timestamp Service"@en ;
    rdfs:comment "A timestamp service issues verifiable evidence that a particular piece of data existed at or before a specific point in time, without revealing the data's contents. It accepts the hash of a document, binds it to a trusted time reference, and returns a signed timestamp token that anyone can later verify. Timestamp services support non-repudiation, intellectual-property priority, regulatory record-keeping, and long-term signature validation, and may be anchored in a trusted timestamp authority or in a public blockchain for trust-minimised proof of existence."@en ;
    rdfs:subClassOf ngm:timestamping-service ;
    vc:enables ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:trusted-timestamping ;
    vc:slug "timestamp-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hash-function,
        ngm:timestamp-authority .

ngm:tokenized-asset a owl:Class ;
    rdfs:label "Tokenized Asset"@en ;
    rdfs:comment "A tokenized asset is a representation of ownership or economic rights in a real-world or digital asset recorded as a blockchain token. The token acts as a programmable, transferable claim whose issuance, transfer, and settlement are governed by smart contracts, enabling fractional ownership, faster settlement, and broader access. Underlying assets range from securities, real estate, and commodities to art and intellectual property."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:asset-tokenization ;
    vc:bridgesTo ngm:non-fungible-token,
        ngm:real-world-asset ;
    vc:contrastsWith ngm:fungible-token ;
    vc:dependsOn ngm:blockchain,
        ngm:smart-contract ;
    vc:enables ngm:fractional-ownership ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:erc-721 ;
    vc:isPartOf ngm:asset-tokenization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:security-token,
        ngm:stablecoin,
        ngm:tokenization ;
    vc:requires ngm:blockchain ;
    vc:slug "tokenized-asset" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-asset,
        ngm:fractional-ownership ;
    vc:uses ngm:erc-20,
        ngm:smart-contract .

ngm:total-supply a owl:Class ;
    rdfs:label "Total Supply"@en ;
    rdfs:comment "Total Supply is the count of all tokens that have ever been created on a blockchain network, encompassing circulating tokens, locked or vested tokens, tokens held in treasury reserves, and any tokens that have been minted but not yet distributed—but excluding permanently destroyed (burned) tokens. It differs from the maximum supply (the hard cap set by the protocol) and from circulating supply (tokens freely tradeable on secondary markets). Total supply is a fundamental parameter in tokenomics analysis used to assess inflation, dilution, and long-term value dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circulating-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-cap ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:circulating-supply ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deflationary-token,
        ngm:halving,
        ngm:inflation,
        ngm:inflationary-token,
        ngm:market-capitalization,
        ngm:tokenomics,
        ngm:treasury-management ;
    vc:requires ngm:emission-schedule,
        ngm:supply-cap ;
    vc:slug "total-supply" ;
    vc:sourceDomain "blockchain" .

ngm:total-value-locked a owl:Class ;
    rdfs:label "Total Value Locked"@en ;
    rdfs:comment "Total Value Locked (TVL) is a metric that aggregates the market value of all assets deposited in a decentralised finance protocol or across an ecosystem at a given time. It serves as a proxy for adoption, liquidity depth and the economic weight of a protocol's smart contracts. Because it is denominated in volatile assets, TVL can shift with both deposit flows and underlying price movements, so it is interpreted alongside other indicators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:finance ;
    vc:contrastsWith ngm:compound ;
    vc:enables ngm:scenario-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:liquidity-pool,
        ngm:staking,
        ngm:yield-farming ;
    vc:requires ngm:smart-contract ;
    vc:slug "total-value-locked" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decision-making ;
    vc:uses ngm:smart-contract .

ngm:training-dataset-metadata a owl:Class ;
    rdfs:label "Training Dataset Metadata"@en ;
    rdfs:comment "Training dataset metadata is structured descriptive information about the data used to train a machine learning model, including its provenance, size, collection method, class distribution, known biases, and licensing terms. This metadata is a core component of AI model cards and datasheets, enabling reproducibility, fairness auditing, and regulatory accountability. Thorough dataset metadata underpins model transparency and responsible AI governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-versioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-schema ],
        ngm:ai-infrastructure ;
    vc:enables ngm:ai-fairness,
        ngm:model-evaluation-results,
        ngm:model-transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-versioning,
        ngm:metadata-schema,
        ngm:provenance-tracking ;
    vc:isPartOf ngm:ai-model-card ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fairness-metrics,
        ngm:model-performance,
        ngm:provenance-standard ;
    vc:requires ngm:data-governance,
        ngm:data-pipeline,
        ngm:training-data ;
    vc:slug "training-dataset-metadata" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:training-layer a owl:Class ;
    rdfs:label "Training Layer"@en ;
    rdfs:comment "The Training Layer is the stratum that fits model parameters from data using optimisation procedures. It sits above the Compute and Data strata it consumes and below the Model and Foundation Model strata that hold its results. It contains training loops, optimisers, loss functions, and the orchestration of large-scale learning runs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:foundation-model-layer,
        ngm:model-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:data-layer ;
    vc:slug "training-layer" ;
    vc:sourceDomain "machine-learning" .

ngm:transaction-history a owl:Class ;
    rdfs:label "Transaction History"@en ;
    rdfs:comment "Transaction history is the ordered, append-only record of all value transfers, state changes, or operations executed within a financial or data system, providing a tamper-evident chronological account of who transacted what, with whom, and when. In blockchain systems, transaction history is the fundamental data structure underpinning the distributed ledger — every confirmed block links to its predecessor through cryptographic hashing, making retroactive alteration of any transaction computationally prohibitive. Transaction history serves audit, compliance, forensic, tax, and portfolio analytics functions across both traditional and decentralised financial systems."@en ;
    rdfs:subClassOf ngm:blockchain-transaction ;
    vc:enables ngm:blockchain-analytics,
        ngm:blockchain-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:financial-transactions,
        ngm:on-chain-governance ;
    vc:slug "transaction-history" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:audit-trail,
        ngm:blockchain,
        ngm:distributed-ledger .

ngm:transfer-restriction a owl:Class ;
    rdfs:label "Transfer Restriction"@en ;
    rdfs:comment "A transfer restriction is logic embedded in a tokenised asset that conditions or blocks transfers based on the identity, eligibility, lock-up status or jurisdiction of the parties involved. It allows regulated securities to be represented on a blockchain while enforcing legal constraints automatically at the protocol level. Security token standards such as ERC-1400 expose a check function that returns whether a proposed transfer is permitted, with reason codes for rejected transfers to support auditability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kyc ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:security-token ;
    vc:contrastsWith ngm:erc-20 ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:compliance,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:know-your-customer,
        ngm:kyc ;
    vc:implements ngm:erc-1400,
        ngm:token-standard ;
    vc:isPartOf ngm:enterprise-token-standards,
        ngm:security-token ;
    vc:qualityScore "0.62"^^xsd:float ;
