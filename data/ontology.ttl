    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Human Centred Values
spatial-computing:HumanCentredValues rdf:type owl:Class ;
    rdfs:label "Human Centred Values"@en ;
    rdfs:comment "AI systems should be designed and operated in ways that respect the rule of law, human rights, democratic values and diversity, with appropriate safeguards to ensure human determination and control over consequential decisions (human agency), whilst incorporating mechanisms to protect fairness and human dignity."@en ;
    skos:prefLabel "Human Centred Values"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:human-centred-values" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:human-centred-values> ;
    vcw:contentHash "sha256-12-f96ab7f465b3" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0159" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0159" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Fairness (OECD)
artificial-intelligence:FairnessOECD rdf:type owl:Class ;
    rdfs:label "Fairness (OECD)"@en ;
    rdfs:comment "AI systems should not create or reinforce unfair bias, discrimination or disparate impacts on individuals or groups based on protected characteristics, and should incorporate appropriate safeguards to ensure equitable treatment and opportunity whilst respecting legitimate differentiation based on actual relevant differences."@en ;
    skos:prefLabel "Fairness (OECD)"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:fairness-oecd" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:fairness-oecd> ;
    vcw:contentHash "sha256-12-76657ad799a9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0160" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0160" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Transparency (OECD)
artificial-intelligence:TransparencyOECD rdf:type owl:Class ;
    rdfs:label "Transparency (OECD)"@en ;
    rdfs:comment "AI actors should commit to transparency and responsible disclosure regarding AI systems, providing sufficient information to enable people to understand AI outcomes, challenge decisions and participate meaningfully in AI-influenced processes."@en ;
    skos:prefLabel "Transparency (OECD)"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:transparency-oecd" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:transparency-oecd> ;
    vcw:contentHash "sha256-12-7566b316210d" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0161" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
