    vc:sourceDomain "distributed-collaboration" .

ngm:ai-energy-optimisation a owl:Class ;
    rdfs:label "AI Energy Optimisation"@en ;
    rdfs:comment "The set of techniques and engineering practices that reduce the energy consumed by training and running artificial intelligence systems while preserving acceptable task performance, spanning model compression, efficient hardware selection, workload scheduling, and data-centre operation."@en ;
