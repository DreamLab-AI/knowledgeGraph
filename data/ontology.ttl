        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:creator-royalties ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-emission ;
    vc:isPartOf ngm:nft-standard ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:oracle-service,
        ngm:payment-token,
        ngm:smart-contract-platform,
        ngm:token-standard ;
    vc:slug "smart-royalty-contract" ;
    vc:sourceDomain "spatial-computing" .

ngm:smpl-body-model a owl:Class ;
    rdfs:label "SMPL Body Model"@en ;
    rdfs:comment "SMPL (Skinned Multi-Person Linear model) is a parametric 3D human body model that represents body shape and pose with a low-dimensional set of parameters driving a deformable triangle mesh. It separates identity-dependent shape blend shapes from pose-dependent corrective deformations, enabling realistic articulated bodies that fit motion capture and image data. It is a foundational representation in human pose and shape estimation pipelines."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:pose-estimation ;
    vc:slug "smpl-body-model" ;
    vc:sourceDomain "ai" .

ngm:social-platform a owl:Class ;
    rdfs:label "Social Platform"@en ;
    rdfs:comment "A Social Platform is a networked software environment that mediates human connection, identity expression, content sharing, and community formation. It combines identity management, real-time communication, moderation tooling, and reputation mechanisms to sustain persistent social graphs, supporting both synchronous interaction (voice, video) and asynchronous content exchange across devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:avatar,
        ngm:virtual-community-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:communication-protocol,
        ngm:digital-identity ;
    vc:slug "social-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:platform-governance,
        ngm:social-network-graph ;
    vc:uses ngm:content-moderation,
        ngm:user-interface .

ngm:soft-prompt-embedding a owl:Class ;
    rdfs:label "Soft Prompt Embedding"@en ;
    rdfs:comment "Soft Prompt Embedding is a parameter-efficient fine-tuning technique in which a small set of continuous, learnable token vectors (soft prompts) are prepended to the model's input embedding sequence and optimised via gradient descent, conditioning a frozen large language model's behaviour without modifying its weights. Unlike discrete (hard) prompts composed of natural-language tokens, soft prompt embeddings exist solely in the continuous embedding space and have no direct human-interpretable form. This approach enables task-specific adaptation of large models at a fraction of the computational and storage cost of full fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:instruction-following ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:model-parameters ;
    vc:enables ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:parameter,
        ngm:token-embedding ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:prompt-engineering,
        ngm:prompt-tuning ;
    vc:requires ngm:embedding-model,
        ngm:large-language-models ;
    vc:slug "soft-prompt-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:software-infrastructure a owl:Class ;
    rdfs:label "Software Infrastructure"@en ;
    rdfs:comment "Software Infrastructure comprises the foundational software layers — including operating systems, middleware, APIs, frameworks, and runtime environments — that underpin applications and services without being directly user-facing. It provides the shared services, communication channels, and execution contexts on which higher-level metaverse, AI, and distributed-systems applications are built, analogous to the role that physical infrastructure plays for built environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:microservices-architecture,
        ngm:serverless-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-gateway,
        ngm:middleware,
        ngm:software-architecture ;
    vc:isPartOf ngm:digital-infrastructure ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "software-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:software-platform a owl:Class ;
    rdfs:label "Software Platform"@en ;
    rdfs:comment "An integrated technology foundation providing common services, APIs, and infrastructure for developing, deploying, and running applications, including cloud-native platforms, container orchestration systems, and internal developer platforms that abstract underlying complexity while enabling scala..."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:technology-infrastructure ;
    vc:enables ngm:application-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "software-platform" ;
    vc:sourceDomain "spatial-computing" .

ngm:solid-oidc a owl:Class ;
    rdfs:label "Solid-OIDC"@en ;
    rdfs:comment "Solid-OIDC is the authentication specification for the Solid ecosystem, extending OpenID Connect with decentralised identity so a user authenticates with their own WebID and identity provider rather than a centralised platform. It issues DPoP-bound access tokens that resource servers (Solid Pods) verify, enabling a user to control which applications access their personal data store. It is the identity layer that makes Solid's separation of identity, data, and application possible."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:solid ;
    vc:slug "solid-oidc" ;
    vc:sourceDomain "data" .

ngm:soulbound-tokens a owl:Class ;
    rdfs:label "Soulbound Tokens"@en ;
    rdfs:comment "Non-transferable tokens bound to a single account that represent credentials, affiliations or reputation rather than tradable value. Because they cannot be sold or moved, they encode persistent attributes of an identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:decentralized-identity ;
    vc:enables ngm:sybil-resistance,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:token-standard ;
    vc:slug "soulbound-tokens" ;
    vc:sourceDomain "blockchain" .

ngm:sparse-matrix a owl:Class ;
    rdfs:label "Sparse Matrix"@en ;
    rdfs:comment "A sparse matrix is a matrix in which the overwhelming majority of entries are zero, allowing specialised storage formats and algorithms that operate only on the non-zero elements. By storing and computing with structure rather than dense arrays, sparse representations dramatically reduce memory and arithmetic for large-scale linear algebra. They are foundational to optimisation problems such as bundle adjustment, graph algorithms and finite-element simulation where connectivity is local."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-structure ],
        ngm:linear-algebra ;
    vc:bridgesTo ngm:adjacency-matrix ;
    vc:enables ngm:bundle-adjustment,
        ngm:graph-representation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-structure ;
    vc:implements ngm:data-structure ;
    vc:isPartOf ngm:linear-algebra ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:adjacency-matrix,
        ngm:graph-representation ;
    vc:slug "sparse-matrix" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:bundle-adjustment,
        ngm:optimisation ;
    vc:uses ngm:linear-algebra .

ngm:spatial-ai a owl:Class ;
    rdfs:label "Spatial AI"@en ;
    rdfs:comment "Spatial AI is the application of machine learning and computer vision to understand, represent, and reason about three-dimensional physical space. It encompasses scene understanding, semantic mapping, depth estimation, and object detection, enabling robots, AR/VR systems, and autonomous agents to interpret their environment and plan actions within it."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:embodied-ai,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:neural-radiance-field,
        ngm:spatial-computing,
        ngm:spatial-mapping-technology ;
    vc:slug "spatial-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:3-d-gaussian-splatting,
        ngm:depth-estimation,
        ngm:object-detection,
        ngm:scene-understanding,
        ngm:semantic-segmentation .

ngm:spatial-embodiment-harm-taxonomy a owl:Class ;
    rdfs:label "Spatial Embodiment Harm Taxonomy"@en ;
    rdfs:comment "Metaverse and Spatial Risks encompass the range of harms and hazards that arise specifically from spatially embodied, real-time virtual interactions — including harassment and abuse that mimics physical-world dynamics, miscommunication amplified by latency and avatar fidelity limitations, digital addiction, physical health impacts from prolonged immersive use, privacy violations through biometric data collection, and regulatory gaps as legislation lags behind technology deployment. These risks require multi-layered mitigation combining technical safeguards, governance frameworks, and international regulatory coordination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:privacy,
        ngm:user-safety ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:metaverse-liability-model,
        ngm:risk-management ;
    vc:requires ngm:content-moderation,
        ngm:regulatory-framework ;
    vc:slug "spatial-embodiment-harm-taxonomy" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking-system a owl:Class ;
    rdfs:label "Spatial Tracking System"@en ;
    rdfs:comment "Technology for determining the six-degrees-of-freedom (6DOF) position and orientation of devices, controllers, or body parts in three-dimensional space, using visual-inertial SLAM, stereo cameras, and IMU sensors for precise real-time tracking in VR, AR, and mixed reality applications."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-tracking-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:speaker-recognition a owl:Class ;
    rdfs:label "Speaker Recognition"@en ;
    rdfs:comment "The automated identification or verification of a person's identity based on characteristics of their voice derived from acoustic speech signals. Speaker recognition encompasses two sub-tasks: speaker verification (confirming a claimed identity) and speaker identification (determining who among a set of known speakers produced a given utterance). Systems extract speaker-discriminative features such as MFCCs, i-vectors, or x-vectors from audio, then compare these against enrolled speaker models using distance metrics or neural classifiers. It is distinct from speech recognition, which transcribes words rather than identifies speakers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:voice-activity-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speaker-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-processing ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:contrastsWith ngm:speech-recognition,
        ngm:voice-activity-detection ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:access-control,
        ngm:biometric-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:speaker-embedding,
        ngm:speaker-model ;
    vc:isPartOf ngm:speech-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:biometric-authentication,
        ngm:speaker-diarisation,
        ngm:voice-assistant ;
    vc:requires ngm:audio-processing,
        ngm:voice-activity-detection ;
    vc:slug "speaker-recognition" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:personalisation,
        ngm:security ;
    vc:uses ngm:deep-learning,
        ngm:feature-extraction,
        ngm:neural-network .

ngm:spot-trading a owl:Class ;
    rdfs:label "Spot Trading"@en ;
    rdfs:comment "Spot trading is the buying and selling of an asset for immediate delivery and settlement at the current market price, as opposed to settlement at a future date. In cryptocurrency and traditional markets it involves placing orders against an order book or liquidity pool, with ownership of the underlying asset transferring promptly, and it contrasts with derivatives and margin trading where exposure is taken without immediate full ownership."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
