ngm:disparate-impact a owl:Class ;
    rdfs:label "Disparate Impact"@en ;
    rdfs:comment "Disparate Impact is a legal doctrine and AI fairness concept denoting the condition where a facially neutral policy, practice, or algorithmic decision system produces outcomes that disproportionately disadvantage a legally protected group relative to a comparator group, regardless of discriminatory intent. Measured via the four-fifths rule or statistical significance tests, it is legally actionable in employment (US EEOC guidelines), lending, housing, and insurance, and is the analytical basis for algorithmic bias audits under the EU AI Act and GDPR. Remediation requires either demonstrating business necessity or adopting less discriminatory alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        ngm:ai-fairness,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness-accuracy-tradeoffs,
        ngm:group-vs-individual-fairness ;
    vc:enables ngm:algorithmic-accountability,
        ngm:fairness-auditing-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:harmful-bias,
        ngm:intersectional-fairness,
        ngm:regulatory-compliance ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-metrics ;
    vc:slug "disparate-impact" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:dispute-resolution a owl:Class ;
    rdfs:label "Dispute Resolution"@en ;
    rdfs:comment "Dispute Resolution encompasses the processes and mechanisms by which conflicting parties reach a binding or agreed settlement without necessarily resorting to formal court litigation, including negotiation, mediation, arbitration, and online dispute resolution (ODR) platforms. In blockchain and smart-contract contexts, dispute resolution refers to the programmatic or semi-programmatic adjudication of disagreements arising from contract ambiguity, code exploits, or off-chain facts that automated execution cannot verify, using decentralised arbitration protocols, escrow mechanisms, and cryptoeconomic incentives to produce impartial outcomes. Effective dispute resolution balances finality, cost, speed, and procedural fairness across both traditional legal frameworks and emerging decentralised governance structures."@en ;
    rdfs:subClassOf ngm:dispute-resolution-mechanism ;
    vc:enables ngm:dao-governance,
        ngm:e-contract-arbitration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:arbitration-process,
        ngm:conflict-resolution,
        ngm:dao-legal-structures,
        ngm:legal-framework ;
    vc:slug "dispute-resolution" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:arbitration-decision-engine,
        ngm:legal-compliance,
        ngm:smart-contract .

