ngm:transparent-data-processing a owl:Class ;
    rdfs:label "Transparent Data Processing"@en ;
    rdfs:comment "Data handling practices that are openly disclosed to users, specifying what data is collected, how it is processed, who has access, and for what purposes, so as to enable informed consent and meaningful accountability. GDPR codifies this as the principle of lawfulness, fairness, and transparency; in metaverse and XR contexts it extends to immersive data streams including gaze tracking, movement patterns, and biometric signals. Implementation relies on audit trails, data flow mapping, privacy notices, and increasingly on zero-knowledge proofs for privacy-preserving verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:data-processing,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance ;
    vc:requires ngm:audit-trail,
        ngm:consent-management ;
    vc:slug "transparent-data-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:privacy-framework,
        ngm:zero-knowledge-proof .

ngm:transparent-revenue-sharing a owl:Class ;
    rdfs:label "Transparent Revenue Sharing"@en ;
    rdfs:comment "A financial distribution model where revenue allocation percentages, payment calculations, and disbursement records are openly visible and independently verifiable by all stakeholders. It is typically implemented through smart contracts that automatically distribute earnings according to immutable predefined rules, with all transactions recorded on-chain. Common applications include NFT creator royalties, DAO treasury allocations, gaming guild earnings, and metaverse land rental income."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:revenue-distribution,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:dao-governance,
        ngm:transparency-metrics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:nft-marketplace,
        ngm:virtual-economy ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "transparent-revenue-sharing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audit-trail,
        ngm:nft .

ngm:trusted-execution-pbft a owl:Class ;
    rdfs:label "Trusted Execution PBFT"@en ;
    rdfs:comment "Trusted Execution PBFT is a variant of Practical Byzantine Fault Tolerance that leverages Trusted Execution Environments (TEEs), specifically Intel SGX, to implement a Unique Sequential Identifier Generator (USIG) that reduces the protocol to two message phases rather than the standard three. By anchoring sequence number generation inside a tamper-resistant enclave, it eliminates the view-change overhead of classical PBFT while preserving Byzantine fault safety up to f < n/3 faulty replicas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:practical-byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:fault-tolerance,
        ngm:node,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:trusted-execution-environment ;
    vc:slug "trusted-execution-pbft" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature,
        ngm:secure-enclave .

ngm:trustworthy-ai-framework a owl:Class ;
    rdfs:label "Trustworthy AI Framework"@en ;
    rdfs:comment "Comprehensive governance and standards framework establishing principles, requirements, and assessment processes to ensure AI systems are lawful, ethical, and technically robust throughout their lifecycle. Defined by the EU High-Level Expert Group on AI and formalised in the EU AI Act, it implements a risk-based approach with seven trustworthiness dimensions covering human oversight, safety, privacy, transparency, fairness, societal wellbeing, and accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-risk-ai-system ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability,
        ngm:ai-safety,
        ngm:conformity-assessment,
        ngm:explainability,
        ngm:high-risk-ai-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:ai-governance-framework,
        ngm:ai-regulation,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:requires ngm:ai-audit,
        ngm:risk-assessment ;
    vc:slug "trustworthy-ai-framework" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-governance-principle .

ngm:unified-hardware-access a owl:Class ;
    rdfs:label "Unified Hardware Access"@en ;
    rdfs:comment "A standardised abstraction layer that provides consistent programmatic interfaces for accessing diverse XR hardware devices — including VR headsets, AR glasses, haptic controllers, eye-tracking modules, and six-DoF tracking systems — enabling cross-platform application development without device-specific code paths. The WebXR Device API (W3C) and OpenXR (Khronos Group) are the primary open standards implementing this abstraction for web and native runtimes respectively."@en ;
    rdfs:subClassOf ngm:hardware-abstraction,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:xr-runtime-environment ;
    vc:slug "unified-hardware-access" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard,
        ngm:open-standard ;
    vc:uses ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:xr-device .

ngm:unique-content-variation a owl:Class ;
    rdfs:label "Unique Content Variation"@en ;
    rdfs:comment "Procedurally generated or algorithmically created variations of digital content that produce distinct, individualised versions of assets, experiences, or environments, often used in NFTs and generative art to ensure scarcity and uniqueness."@en ;
    rdfs:subClassOf ngm:generative-content,
