    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:longest-chain-rule ;
    vc:slug "probabilistic-finality" ;
    vc:sourceDomain "blockchain" .

ngm:prompt-tuning a owl:Class ;
    rdfs:label "Prompt Tuning"@en ;
    rdfs:comment "Prompt Tuning is a parameter-efficient fine-tuning method that learns continuous soft prompt embeddings prepended to the input sequence, whilst keeping all pre-trained model weights frozen. It optimises task-specific prompts in the embedding space using gradient descent, requiring as little as 0.01% of model parameters and enabling efficient multi-task deployment from a single frozen backbone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-prompt-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-trained-language-model ],
        ngm:parameter-efficient-fine-tuning ;
    vc:bridgesTo ngm:in-context-learning,
        ngm:prompt-engineering ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:full-fine-tuning,
        ngm:lora,
        ngm:prefix-tuning ;
    vc:dependsOn ngm:embedding-space,
        ngm:transformer-architecture ;
    vc:enables ngm:few-shot-learning,
        ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gradient-descent,
        ngm:soft-prompt-embedding ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning,
