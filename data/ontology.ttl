    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:communication-theory,
        ngm:media-richness-theory,
        ngm:social-presence-theory ;
    vc:slug "media-theory" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:immersive-experience .

