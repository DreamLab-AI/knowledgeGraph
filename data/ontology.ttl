    vc:slug "linear-algebra" ;
    vc:sourceDomain "linear-algebra" .

ngm:nist-ai-rmf a owl:Class ;
    rdfs:label "NIST AI RMF"@en ;
    rdfs:comment "The NIST AI Risk Management Framework (AI RMF) is a voluntary guidance document published by the National Institute of Standards and Technology in January 2023 that helps organisations manage risks associated with the design, development, deployment, and operation of AI systems. It provides a structured, flexible, and measurable approach to AI risk management through four core functions: Govern, Map, Measure, and Manage. The framework is technology- and sector-agnostic, designed to be adapted across diverse organisational contexts and AI use cases."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:enables ngm:accountability,
