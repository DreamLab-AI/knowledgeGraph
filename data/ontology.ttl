    vc:standardizedBy ngm:standards ;
    vc:supports ngm:application-layer ;
    vc:uses ngm:congestion-control ;
    vc:uses ngm:flow-control .
ngm:transmission-delay a owl:Class ;
    rdfs:comment "The time required to push all of a packet's bits onto the transmission medium, calculated as packet size divided by the link's transmission rate. It is one of the four canonical components of network latency alongside propagation, processing, and queueing delay, dominates end-to-end delay on low-bandwidth links, and shrinks proportionally as link capacity increases, which is why upgrading link speed reduces this component but leaves propagation delay unchanged."@en ;
    rdfs:label "Transmission Delay"@en ;
    rdfs:subClassOf ngm:network-latency ;
    vc:contrastsWith ngm:propagation-delay ;
    vc:dependsOn ngm:bandwidth ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:latency ;
    vc:isPartOf ngm:network-latency ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:packet-switching ;
    vc:slug "transmission-delay" ;
    vc:sourceDomain "infrastructure" .
ngm:transmission-infrastructure a skos:Concept ;
    rdfs:label "Transmission Infrastructure"@en .
ngm:transmission-network a owl:Class ;
    rdfs:comment "A transmission network is the high-voltage infrastructure that carries bulk electrical power over long distances from generation sites to distribution substations near consumers. Comprising transmission lines, transformers, and switching stations, it minimises resistive losses through high voltages and is operated as a synchronised grid balancing supply and demand in real time."@en ;
    rdfs:label "Transmission Network"@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "transmission-network" ;
    vc:sourceDomain "infrastructure" .
ngm:transmitter a skos:Concept ;
    rdfs:label "Transmitter"@en .
