ngm:privacy-by-design a owl:Class ;
    rdfs:label "Privacy By Design"@en ;
    rdfs:comment "Privacy by Design is a proactive privacy framework and GDPR requirement (Article 25) mandating that data protection be embedded into system architecture, business practices, and technologies from inception rather than bolted on as afterthought, implementing privacy as the default setting. The framework comprises seven foundational principles articulated by Ann Cavoukian — including proactive prevention, privacy as default, full functionality (positive-sum), end-to-end lifecycle security, visibility and transparency, and respect for user privacy — requiring engineers and product teams to treat privacy as a core design constraint from the earliest specification stage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pseudonymisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-minimisation ],
        ngm:data-governance ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:secure-by-design ;
    vc:contrastsWith ngm:privacy-bolt-on ;
    vc:enables ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:transparency,
        ngm:user-trust ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-protection-by-default,
        ngm:gdpr-article-25,
        ngm:iso-29100 ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-and-ethics,
        ngm:data-protection-regulation,
        ngm:privacy-impact-assessment,
        ngm:transparency-and-explainability ;
    vc:requires ngm:consent-management,
        ngm:data-minimisation,
        ngm:data-protection,
        ngm:pseudonymisation ;
    vc:slug "privacy-by-design" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr,
        ngm:iso-29101 ;
    vc:supports ngm:algorithmic-accountability,
        ngm:data-subject-rights ;
    vc:uses ngm:access-control,
        ngm:encryption,
        ngm:federated-learning .

ngm:supply-chain-management a owl:Class ;
    rdfs:label "Supply Chain Management"@en ;
    rdfs:comment "Supply Chain Management (SCM) is the end-to-end coordination of the flow of goods, services, information, and finances from raw-material suppliers through manufacturers, distributors, and retailers to end consumers, with the goal of maximising value and minimising waste. It encompasses strategic planning, demand forecasting, procurement, inventory control, logistics, and supplier relationship management as an integrated discipline. Modern SCM increasingly employs digital technologies — including IoT sensors, AI-driven demand planning, blockchain-based provenance tracking, and digital twins — to achieve visibility, resilience, and sustainability across multi-tier networks. The field draws on operations research, systems theory, and data science to optimise trade-offs between cost, service levels, lead times, and risk."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logistics-optimization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:demand-forecasting ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
