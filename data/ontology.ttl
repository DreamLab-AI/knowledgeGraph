# Accessibility Standards
mv:AccessibilityStandards a owl:Class ;
    rdfs:label "Accessibility Standards"@en ;
    rdfs:comment "Accessibility Standards for the metaverse and extended reality (XR) encompass guidelines, technical specifications, and design principles that ensure virtual environments, interfaces, and interactions are usable by people with diverse disabilities including visual, auditory, physical, cognitive, and neurological impairments."@en ;
    skos:prefLabel "Accessibility Standards"@en ;
    dcterms:identifier "MV-9757" ;
    dcterms:subject "mv" .

# Adaptive Virtual Experience
mv:AdaptiveVirtualExperience a owl:Class ;
    rdfs:label "Adaptive Virtual Experience"@en ;
    rdfs:comment "Adaptive Virtual Experience refers to AI-driven immersive environments that dynamically adjust content, difficulty, pacing, and presentation in real-time based on user behavior, preferences, physiological responses, and interaction patterns to deliver personalized and engaging virtual reality experiences."@en ;
    skos:prefLabel "Adaptive Virtual Experience"@en ;
    dcterms:identifier "MV-9758" ;
    dcterms:subject "mv" .

# Adaptive Virtual World
mv:AdaptiveVirtualWorld a owl:Class ;
    rdfs:label "Adaptive Virtual World"@en ;
    rdfs:comment "Adaptive Virtual World describes a metaverse environment that uses procedural generation, AI-driven content creation, and real-time user behavior analysis to dynamically evolve landscapes, structures, weather patterns, NPCs, and game mechanics in response to collective and individual user actions."@en ;
    skos:prefLabel "Adaptive Virtual World"@en ;
    dcterms:identifier "MV-9759" ;
    dcterms:subject "mv" .

# Adversarial Attacks
mv:AdversarialAttacks a owl:Class ;
    rdfs:label "Adversarial Attacks"@en ;
    rdfs:comment "Adversarial Attacks are malicious techniques that exploit vulnerabilities in machine learning models by deliberately crafting deceptive input data to cause incorrect predictions, misclassifications, or unintended behaviors, often through subtle perturbations imperceptible to humans but significant to AI systems."@en ;
    skos:prefLabel "Adversarial Attacks"@en ;
    dcterms:identifier "MV-9760" ;
    dcterms:subject "mv" .

# Ai Art Categorization
mv:AiArtCategorization a owl:Class ;
    rdfs:label "Ai Art Categorization"@en ;
    rdfs:comment "AI Art Categorization encompasses taxonomies, classification systems, and machine learning methods for organizing, labeling, and evaluating AI-generated and AI-assisted artworks based on creation methodology, style, medium, aesthetic properties, and the degree of autonomous system involvement in the creative process."@en ;
    skos:prefLabel "Ai Art Categorization"@en ;
    dcterms:identifier "MV-9761" ;
    dcterms:subject "mv" .

# Ai Machine Learning
mv:AiMachineLearning a owl:Class ;
    rdfs:label "Ai Machine Learning"@en ;
    rdfs:comment "AI Machine Learning in the metaverse context refers to the application of artificial intelligence algorithms, neural networks, and deep learning architectures that enable intelligent virtual environments through natural language processing, computer vision, procedural content generation, and adaptive user experiences."@en ;
    skos:prefLabel "Ai Machine Learning"@en ;
    dcterms:identifier "MV-9762" ;
    dcterms:subject "mv" .

# Ai Origin Declaration
mv:AiOriginDeclaration a owl:Class ;
    rdfs:label "Ai Origin Declaration"@en ;
    rdfs:comment "AI Origin Declaration refers to technical standards and regulatory requirements for disclosing when digital content has been generated or substantially modified by artificial intelligence, encompassing watermarking, metadata embedding, and provenance tracking systems that enable verification of content authenticity and origin."@en ;
    skos:prefLabel "Ai Origin Declaration"@en ;
    dcterms:identifier "MV-9763" ;
    dcterms:subject "mv" .

# Ai Transparency Framework
mv:AiTransparencyFramework a owl:Class ;
    rdfs:label "Ai Transparency Framework"@en ;
    rdfs:comment "AI Transparency Framework encompasses governance structures, technical standards, and regulatory requirements that ensure artificial intelligence systems are explainable, interpretable, and accountable, enabling stakeholders to understand AI decision-making processes, limitations, and potential impacts."@en ;
    skos:prefLabel "Ai Transparency Framework"@en ;
    dcterms:identifier "MV-9764" ;
    dcterms:subject "mv" .

# Analog To Digital Converter
mv:AnalogToDigitalConverter a owl:Class ;
    rdfs:label "Analog To Digital Converter"@en ;
    rdfs:comment "Analog To Digital Converter (ADC) is an electronic component that converts continuous analog signals such as sound, light, or voltage into discrete digital representations through sampling, quantization, and encoding processes, enabling digital processing, storage, and transmission of real-world signals."@en ;
    skos:prefLabel "Analog To Digital Converter"@en ;
    dcterms:identifier "MV-9765" ;
    dcterms:subject "mv" .

# Animation Retargeting
mv:AnimationRetargeting a owl:Class ;
    rdfs:label "Animation Retargeting"@en ;
    rdfs:comment "Animation Retargeting is the process of transferring motion capture or animation data from one character skeleton to another with different proportions, joint configurations, or bone structures, enabling reuse of animation assets across diverse character models in games, film, and virtual environments."@en ;
    skos:prefLabel "Animation Retargeting"@en ;
    dcterms:identifier "MV-9766" ;
    dcterms:subject "mv" .

# Animation Software
mv:AnimationSoftware a owl:Class ;
    rdfs:label "Animation Software"@en ;
    rdfs:comment "Animation Software encompasses digital tools and applications for creating computer-generated moving images through 3D modeling, rigging, motion graphics, rendering, and compositing, supporting the complete animation pipeline from asset creation to final output for games, film, and metaverse content."@en ;
    skos:prefLabel "Animation Software"@en ;
    dcterms:identifier "MV-9767" ;
    dcterms:subject "mv" .

# Appearance Translation
mv:AppearanceTranslation a owl:Class ;
    rdfs:label "Appearance Translation"@en ;
    rdfs:comment "Appearance Translation refers to neural style transfer and image-to-image translation techniques that use deep learning to transform the visual style of images or video while preserving semantic content, enabling artistic stylization, domain adaptation, and visual content transformation across different aesthetic representations."@en ;
    skos:prefLabel "Appearance Translation"@en ;
    dcterms:identifier "MV-9768" ;
    dcterms:subject "mv" .

# Ar Display Device
mv:ArDisplayDevice a owl:Class ;
    rdfs:label "Ar Display Device"@en ;
    rdfs:comment "AR Display Device encompasses hardware systems including smart glasses, headsets, and head-mounted displays that superimpose computer-generated imagery onto the user's view of the real world through optical technologies such as waveguides, birdbath optics, holographic displays, and metasurfaces."@en ;
    skos:prefLabel "Ar Display Device"@en ;
    dcterms:identifier "MV-9769" ;
    dcterms:subject "mv" .

# Ar Experiences
mv:ArExperiences a owl:Class ;
    rdfs:label "Ar Experiences"@en ;
    rdfs:comment "AR Experiences are interactive augmented reality applications that overlay digital content onto the physical world in real-time through smartphones, tablets, or AR headsets, enabling enhanced visualization, contextual information display, and immersive interaction with virtual objects anchored in real environments."@en ;
    skos:prefLabel "Ar Experiences"@en ;
    dcterms:identifier "MV-9770" ;
    dcterms:subject "mv" .

# Ar Overlay
mv:ArOverlay a owl:Class ;
    rdfs:label "Ar Overlay"@en ;
    rdfs:comment "AR Overlay refers to the digital layer of virtual elements including holograms, data visualizations, animations, and 3D objects that are spatially anchored and rendered over the user's view of the physical world in augmented reality systems, creating a seamless blend of virtual and real content."@en ;
    skos:prefLabel "Ar Overlay"@en ;
    dcterms:identifier "MV-9771" ;
    dcterms:subject "mv" .

# Ar Scene Graph
mv:ArSceneGraph a owl:Class ;
    rdfs:label "Ar Scene Graph"@en ;
    rdfs:comment "AR Scene Graph is a hierarchical data structure used in augmented reality to represent and organize spatial relationships between virtual objects, real-world elements, and their transformations, enabling context-aware placement, semantic understanding, and natural interaction between digital content and physical environments."@en ;
    skos:prefLabel "Ar Scene Graph"@en ;
    dcterms:identifier "MV-9772" ;
    dcterms:subject "mv" .

# Arbitration Decision Engine
mv:ArbitrationDecisionEngine a owl:Class ;
    rdfs:label "Arbitration Decision Engine"@en ;
    rdfs:comment "Arbitration Decision Engine is an AI-powered or smart contract-based automated system that evaluates evidence, applies predetermined rules, and renders decisions in dispute resolution processes, functioning as an oracle that can trigger smart contract modifications and enable self-enforcing arbitral outcomes."@en ;
    skos:prefLabel "Arbitration Decision Engine"@en ;
    dcterms:identifier "MV-9773" ;
    dcterms:subject "mv" .

# Arbitration Process
mv:ArbitrationProcess a owl:Class ;
    rdfs:label "Arbitration Process"@en ;
    rdfs:comment "Arbitration Process in the blockchain and metaverse context refers to structured dispute resolution procedures using smart contracts and decentralized technologies, encompassing both on-chain mechanisms with automatic award enforcement and off-chain proceedings with traditional arbitral frameworks adapted for digital asset disputes."@en ;
    skos:prefLabel "Arbitration Process"@en ;
    dcterms:identifier "MV-9774" ;
    dcterms:subject "mv" .

# Arbitrator Expertise
mv:ArbitratorExpertise a owl:Class ;
    rdfs:label "Arbitrator Expertise"@en ;
    rdfs:comment "Arbitrator Expertise in blockchain and digital asset contexts refers to the specialized technical knowledge, legal background, and industry experience required by neutral decision-makers to understand distributed ledger technology, smart contracts, tokenomics, and crypto-asset classification for informed dispute resolution."@en ;
    skos:prefLabel "Arbitrator Expertise"@en ;
    dcterms:identifier "MV-9775" ;
    dcterms:subject "mv" .

# Archaeological Site Reconstruction
mv:ArchaeologicalSiteReconstruction a owl:Class ;
    rdfs:label "Archaeological Site Reconstruction"@en ;
    rdfs:comment "Archaeological Site Reconstruction refers to the use of 3D modeling, photogrammetry, LiDAR, and virtual reality technologies to create accurate digital representations of ancient sites, enabling study, documentation, preservation, and immersive public access to cultural heritage through realistic simulations of historical environments."@en ;
    skos:prefLabel "Archaeological Site Reconstruction"@en ;
    dcterms:identifier "MV-9776" ;
    dcterms:subject "mv" .

# Archival Standards
mv:ArchivalStandards a owl:Class ;
    rdfs:label "Archival Standards"@en ;
    rdfs:comment "Archival Standards encompass frameworks, specifications, and best practices for long-term digital preservation, including metadata standards (PREMIS, METS), reference models (OAIS), and storage technologies that ensure digital content remains accessible, authentic, and interpretable across technological changes."@en ;
    skos:prefLabel "Archival Standards"@en ;
    dcterms:identifier "MV-9777" ;
    dcterms:subject "mv" .

# Artifact Metadata
mv:ArtifactMetadata a owl:Class ;
    rdfs:label "Artifact Metadata"@en ;
    rdfs:comment "Artifact Metadata refers to structured descriptive, administrative, and provenance information associated with digital assets and cultural objects, particularly in NFT and blockchain contexts, documenting ownership history, authenticity, cultural significance, and preservation status for verification and long-term accessibility."@en ;
    skos:prefLabel "Artifact Metadata"@en ;
    dcterms:identifier "MV-9778" ;
    dcterms:subject "mv" .

# Asset Archive
mv:AssetArchive a owl:Class ;
    rdfs:label "Asset Archive"@en ;
    rdfs:comment "Asset Archive is a digital repository system for long-term storage, management, and preservation of 3D models, textures, animations, and other virtual world components, incorporating provenance tracking, version control, and standardized formats to ensure accessibility and interoperability across metaverse platforms."@en ;
    skos:prefLabel "Asset Archive"@en ;
    dcterms:identifier "MV-9779" ;
    dcterms:subject "mv" .

# Asset Format Standards
mv:AssetFormatStandards a owl:Class ;
    rdfs:label "Asset Format Standards"@en ;
    rdfs:comment "Asset Format Standards are technical specifications defining file formats, data structures, and interchange protocols for 3D models, textures, animations, and scene descriptions, enabling interoperability between content creation tools, game engines, and metaverse platforms through standards like glTF, USD, and FBX."@en ;
    skos:prefLabel "Asset Format Standards"@en ;
    dcterms:identifier "MV-9780" ;
    dcterms:subject "mv" .

# Attention Aware Interaction
mv:AttentionAwareInteraction a owl:Class ;
    rdfs:label "Attention Aware Interaction"@en ;
    rdfs:comment "Attention Aware Interaction refers to human-computer interaction techniques that leverage eye tracking, gaze detection, and attention modeling to understand user focus and adapt interfaces accordingly, enabling foveated rendering, gaze-based selection, and contextual content presentation in VR, AR, and metaverse environments."@en ;
    skos:prefLabel "Attention Aware Interaction"@en ;
    dcterms:identifier "MV-9781" ;
    dcterms:subject "mv" .

# Attribute Sharing
mv:AttributeSharing a owl:Class ;
    rdfs:label "Attribute Sharing"@en ;
    rdfs:comment "Attribute Sharing refers to identity federation mechanisms that enable selective disclosure of user credentials and identity attributes across metaverse platforms and blockchain applications, using Self-Sovereign Identity (SSI) principles and decentralized identifiers to maintain user control while enabling verification without centralized authorities."@en ;
    skos:prefLabel "Attribute Sharing"@en ;
    dcterms:identifier "MV-9782" ;
    dcterms:subject "mv" .

# Audio Parameters
mv:AudioParameters a owl:Class ;
    rdfs:label "Audio Parameters"@en ;
    rdfs:comment "Audio Parameters are the configurable settings and properties defining spatial audio behavior in virtual environments, including source position, direction, attenuation, room acoustics, HRTF profiles, and rendering parameters that enable realistic 3D sound experiences in VR, AR, and metaverse applications."@en ;
    skos:prefLabel "Audio Parameters"@en ;
    dcterms:identifier "MV-9783" ;
    dcterms:subject "mv" .

# Audio Spatialization
mv:AudioSpatialization a owl:Class ;
    rdfs:label "Audio Spatialization"@en ;
    rdfs:comment "Audio Spatialization is the technique of positioning sounds in three-dimensional space using Head-Related Transfer Functions (HRTFs), binaural processing, and ambisonics to create realistic 3D audio experiences that respond to listener position and head movement in virtual reality and immersive applications."@en ;
    skos:prefLabel "Audio Spatialization"@en ;
    dcterms:identifier "MV-9784" ;
    dcterms:subject "mv" .

# Authentication Standards
mv:AuthenticationStandards a owl:Class ;
    rdfs:label "Authentication Standards"@en ;
    rdfs:comment "Authentication Standards encompass protocols and specifications for verifying user identity in digital systems, particularly FIDO2 and WebAuthn standards that enable passwordless, phishing-resistant authentication using public key cryptography and hardware authenticators for secure access to metaverse platforms and blockchain applications."@en ;
    skos:prefLabel "Authentication Standards"@en ;
    dcterms:identifier "MV-9785" ;
    dcterms:subject "mv" .

# Automated Market Maker
mv:AutomatedMarketMaker a owl:Class ;
    rdfs:label "Automated Market Maker"@en ;
    rdfs:comment "Automated Market Maker (AMM) is a decentralized exchange protocol that uses algorithmic pricing mechanisms and liquidity pools instead of traditional order books, enabling permissionless token swaps where prices adjust automatically based on supply and demand within smart contract-managed reserves."@en ;
    skos:prefLabel "Automated Market Maker"@en ;
    dcterms:identifier "MV-9786" ;
    dcterms:subject "mv" .

# Automated Market Making
mv:AutomatedMarketMaking a owl:Class ;
    rdfs:label "Automated Market Making"@en ;
    rdfs:comment "Automated Market Making is the practice and methodology of operating decentralized exchange protocols that use algorithmic pricing and liquidity pools to facilitate permissionless trading, encompassing pool design, fee structures, capital efficiency optimization, and impermanent loss mitigation strategies."@en ;
    skos:prefLabel "Automated Market Making"@en ;
    dcterms:identifier "MV-9787" ;
    dcterms:subject "mv" .

# Avatar Creation
mv:AvatarCreation a owl:Class ;
    rdfs:label "Avatar Creation"@en ;
    rdfs:comment "Avatar Creation is the process of designing and generating 3D digital representations of users for metaverse environments, encompassing selfie-based AI generation, manual customization tools, full-body scanning, and procedural generation techniques that enable personalized virtual identities."@en ;
    skos:prefLabel "Avatar Creation"@en ;
    dcterms:identifier "MV-9788" ;
    dcterms:subject "mv" .

# Avatar Customization
mv:AvatarCustomization a owl:Class ;
    rdfs:label "Avatar Customization"@en ;
    rdfs:comment "Avatar Customization is the practice of modifying and personalizing digital avatar attributes including physical features, clothing, accessories, animations, and expressions to create unique virtual representations that reflect user identity and preferences in metaverse environments."@en ;
    skos:prefLabel "Avatar Customization"@en ;
    dcterms:identifier "MV-9789" ;
    dcterms:subject "mv" .

# Avatar Portability
mv:AvatarPortability a owl:Class ;
    rdfs:label "Avatar Portability"@en ;
    rdfs:comment "Avatar Portability is the capability to transfer digital avatar representations between different metaverse platforms, applications, and virtual worlds while maintaining visual fidelity, customization, and associated digital assets, enabled by standardized formats and interoperability frameworks."@en ;
    skos:prefLabel "Avatar Portability"@en ;
    dcterms:identifier "MV-9790" ;
    dcterms:subject "mv" .

# Avatar Standard
mv:AvatarStandard a owl:Class ;
    rdfs:label "Avatar Standard"@en ;
    rdfs:comment "Avatar Standard refers to technical specifications defining file formats, data structures, rigging conventions, and metadata schemas for 3D humanoid avatars, particularly the VRM format built on glTF 2.0 that enables cross-platform avatar interoperability in metaverse environments."@en ;
    skos:prefLabel "Avatar Standard"@en ;
    dcterms:identifier "MV-9791" ;
    dcterms:subject "mv" .

# Avatar System
mv:AvatarSystem a owl:Class ;
    rdfs:label "Avatar System"@en ;
    rdfs:comment "Avatar System is the integrated technical architecture for creating, customizing, animating, and rendering digital representations of users in virtual environments, encompassing character models, animation systems, facial expression rigs, physics simulations, and real-time rendering pipelines."@en ;
    skos:prefLabel "Avatar System"@en ;
    dcterms:identifier "MV-9792" ;
    dcterms:subject "mv" .

# Awareness
mv:Awareness a owl:Class ;
    rdfs:label "Awareness"@en ;
    rdfs:comment "Awareness in metaverse contexts refers to systems and mechanisms that provide users with perception of other participants, environmental changes, and relevant contextual information in shared virtual spaces, supporting presence, social interaction, and collaborative activities through visual, audio, and haptic cues."@en ;
    skos:prefLabel "Awareness"@en ;
    dcterms:identifier "MV-9793" ;
    dcterms:subject "mv" .

# Barter System
mv:BarterSystem a owl:Class ;
    rdfs:subClassOf mv:ExchangeMechanism ;
    rdfs:label "Barter System"@en ;
    rdfs:comment "A decentralized exchange mechanism enabling peer-to-peer trading of goods, services, or digital assets without monetary intermediaries, enhanced in digital contexts through blockchain-based matching algorithms and smart contracts that solve the traditional \"double coincidence of wants\" problem."@en ;
    skos:prefLabel "Barter System"@en ;
    dcterms:identifier "MV-9794" ;
    dcterms:subject "mv" .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:MatchingAlgorithm
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:SmartContracts
] .

