    vc:slug "ai-hardware" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:asset-registry a owl:Class ;
    rdfs:label "Asset Registry"@en ;
    rdfs:comment "An Asset Registry is a cryptographically-secured, on-chain or hybrid on/off-chain system for recording, authenticating, and transferring legal ownership rights and provenance metadata for real-world or digital assets, implemented through Smart Contracts, Distributed Ledger infrastruct..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
