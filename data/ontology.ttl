    vc:sourceDomain "ai" .
ngm:agent-loop a owl:Class ;
    rdfs:comment "The agent loop is the repeating control cycle — observe, plan, act, evaluate — through which an autonomous agent perceives its environment, selects a next action or tool call, executes it, and incorporates the result before repeating. It is the core execution pattern underlying agentic systems, terminal coding agents, and retrieval-augmented reasoning, continuing until a termination condition such as task completion or a step budget is reached. The loop's design governs how an agent balances exploration, tool use, and convergence toward a goal."@en ;
    rdfs:label "Agent Loop"@en ;
    rdfs:subClassOf ngm:agent-harness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:agent-harness ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "agent-loop" ;
    vc:sourceDomain "ai" .
ngm:agent-management a owl:Class ;
    rdfs:comment "The skills and practices required to oversee, coordinate, and evaluate AI agents, distinct from traditional software or human management."@en ;
    rdfs:label "Agent Management"@en ;
