ngm:etsi-arf-010 a owl:Class ;
    rdfs:label "ETSI ARF 010"@en ;
    rdfs:comment "ETSI ARF 010 is a technical deliverable produced by the ETSI Industry Specification Group on Augmented Reality Framework (ISG ARF), defining architectural principles, terminology, and interoperability requirements for augmented reality systems and services. It establishes a common reference architecture that allows AR components—such as tracking engines, scene anchors, and rendering pipelines—to interoperate across heterogeneous platforms and devices. The specification addresses how spatial anchors, coordinate systems, and world models are managed and shared, enabling consistent AR experiences in multi-vendor and multi-device deployments. ETSI ARF 010 serves as a foundational normative document within the ARF series, complemented by companion deliverables covering use cases, protocols, and conformance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:world-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-anchor ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:web-of-things ;
    vc:contrastsWith ngm:arcore,
        ngm:openxr ;
    vc:enables ngm:ar-interoperability,
        ngm:multi-device-ar,
        ngm:shared-ar-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ar-reference-architecture,
        ngm:spatial-anchor,
        ngm:world-model ;
    vc:implements ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:isPartOf ngm:etsi,
        ngm:etsi-arf ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:etsi-arf-011,
        ngm:extended-reality,
        ngm:iso-iec-18092,
        ngm:mixed-reality ;
    vc:requires ngm:coordinate-system,
        ngm:scene-description ;
    vc:slug "etsi-arf-010" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:etsi-isg-arf ;
    vc:uses ngm:3d-registration,
        ngm:pose-estimation,
        ngm:tracking .

