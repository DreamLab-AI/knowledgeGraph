    vc:enables ngm:contextual-representation-learning,
        ngm:long-range-dependency-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-head,
        ngm:attention-weight,
        ngm:output-projection-matrix,
        ngm:query-key-value-projection,
        ngm:scaled-dot-product-attention ;
    vc:implements ngm:attention-mechanism ;
    vc:isPartOf ngm:encoder-decoder-architecture,
