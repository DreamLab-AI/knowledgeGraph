] .

mv:Accountability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:Compliance
] .

mv:Accountability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:RiskManagementAI0078
] .

mv:Accountability rdfs:subClassOf [
