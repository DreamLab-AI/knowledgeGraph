ngm:data-portability a owl:Class ;
    rdfs:label "Data Portability"@en ;
    rdfs:comment "Data portability is the ability for users to obtain, move and reuse their personal or application data across services in a structured, machine-readable format without lock-in. It is both a legal right under regimes such as GDPR and a technical property enabled by open formats and interoperable storage. In decentralised-web designs it lets individuals carry data between providers, shifting control from platforms to users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standards ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:governance ;
    vc:contrastsWith ngm:data-silo,
        ngm:platform-lock-in ;
    vc:dependsOn ngm:api,
        ngm:data-schema ;
    vc:enables ngm:data-sovereignty,
        ngm:user-sovereignty ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:gdpr ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-web,
        ngm:digital-identity,
        ngm:privacy ;
    vc:requires ngm:data-format,
        ngm:interoperability,
        ngm:open-standards ;
    vc:slug "data-portability" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso,
        ngm:w3-c ;
    vc:supports ngm:decentralised-web,
        ngm:self-sovereign-identity ;
    vc:uses ngm:activity-pub,
        ngm:linked-data,
        ngm:solid .

ngm:data-standards a owl:Class ;
    rdfs:label "Data Standards"@en ;
    rdfs:comment "Data Standards are formally agreed specifications, schemas, formats, vocabularies, and protocols that define how data is structured, encoded, exchanged, and interpreted across systems, organisations, and domains. They enable interoperability between heterogeneous systems by establishing shared semantics and syntactic conventions, reducing integration costs and data quality errors. Governed by bodies such as ISO, W3C, IETF, and NIST, data standards span a spectrum from de facto industry conventions (e.g., JSON, CSV) to de jure normative specifications (e.g., SQL:2023, OWL2, FHIR). They are foundational to data governance, metadata management, and the reliable operation of distributed data ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-exchange-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        ngm:data-governance ;
    vc:bridgesTo ngm:federated-learning,
        ngm:knowledge-graph,
        ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:data-silo,
        ngm:proprietary-format ;
    vc:dependsOn ngm:consensus-process,
        ngm:standards-body ;
    vc:enables ngm:data-integration,
        ngm:data-interoperability,
        ngm:linked-data,
        ngm:open-data ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:controlled-vocabulary,
        ngm:data-exchange-format,
        ngm:data-schema,
        ngm:metadata-standard ;
    vc:implements ngm:fair-data-principles ;
    vc:isPartOf ngm:data-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-architecture,
        ngm:ontology ;
    vc:requires ngm:data-quality,
        ngm:semantic-interoperability ;
    vc:slug "data-standards" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:ietf,
        ngm:iso,
        ngm:w3-c ;
    vc:supports ngm:data-catalogue,
        ngm:master-data-management,
        ngm:regulatory-compliance ;
    vc:uses ngm:json-data-interchange-format,
        ngm:rdf,
        ngm:xml .

ngm:data-subject-rights a owl:Class ;
    rdfs:label "Data Subject Rights"@en ;
    rdfs:comment "Data subject rights are the legal entitlements granted to individuals over personal data that organisations hold about them, including rights of access, rectification, erasure, restriction, portability and objection. Codified in regimes such as the GDPR, these rights give people control over how their data is collected, used and shared, and impose corresponding obligations on data controllers and processors. Exercising and honouring them is a core requirement of modern data protection and privacy compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:data-protection ;
    vc:bridgesTo ngm:governance ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-portability ;
    vc:implements ngm:privacy-by-design ;
    vc:isPartOf ngm:data-protection ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:data-minimisation,
        ngm:regulatory-compliance ;
    vc:requires ngm:identity-verification ;
    vc:slug "data-subject-rights" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:accountability,
        ngm:data-privacy .

ngm:decarbonisation a owl:Class ;
    rdfs:label "Decarbonisation"@en ;
    rdfs:comment "Decarbonisation is the systematic reduction of carbon dioxide and other greenhouse-gas emissions from an activity, organisation or economy, ultimately toward net zero. It combines energy efficiency, electrification, renewable energy procurement and removal of residual emissions, often guided by science-based targets. For energy-intensive systems such as blockchains it is the pathway to credible carbon-neutral operation."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-neutral-blockchain,
        ngm:science-based-targets ;
    vc:slug "decarbonisation" ;
    vc:sourceDomain "governance" .

ngm:e-commerce a owl:Class ;
    rdfs:label "E-Commerce"@en ;
    rdfs:comment "E-Commerce (electronic commerce) is the commercial exchange of goods, services, and information conducted over digital networks, encompassing business-to-consumer (B2C), business-to-business (B2B), consumer-to-consumer (C2C), and direct-to-consumer (D2C) transaction models. It relies on integrated layers of digital payment infrastructure, identity and authentication, logistics coordination, and data-driven personalisation to operate at scale. Modern e-commerce platforms leverage cloud infrastructure, recommendation engines, and APIs to connect buyers, sellers, and fulfilment networks globally. It is a mature commercial domain that continues to evolve through mobile-first experiences, conversational commerce, and blockchain-based payment rails."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:metaverse-commerce ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:cybersecurity ;
    vc:enables ngm:digital-payments,
        ngm:personalisation,
        ngm:supply-chain-visibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:conversion-rate-optimisation,
        ngm:customer-data-platform,
        ngm:virtual-tourism ;
    vc:requires ngm:authentication,
        ngm:digital-identity,
        ngm:logistics,
        ngm:payment-system ;
    vc:slug "e-commerce" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:api,
        ngm:blockchain,
        ngm:content-delivery-network,
        ngm:marketplace,
        ngm:recommendation-system .

ngm:edge-ai-system a owl:Class ;
    rdfs:label "Edge AI System"@en ;
    rdfs:comment "An Edge AI System is a distributed computing architecture that deploys trained machine learning models directly onto edge devices, sensors, and gateways at the network periphery, enabling local inference without requiring continuous cloud connectivity. Processing occurs close to the data source, achieving sub-millisecond latency, reduced bandwidth consumption, and enhanced data privacy. Edge AI Systems must fit within the memory, power, and computational constraints of embedded hardware through model compression techniques such as quantisation, pruning, and knowledge distillation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-ai-accelerator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-inference-at-edge ],
        ngm:ai-infrastructure ;
    vc:dependsOn ngm:edge-computing-architecture,
        ngm:machine-learning-discipline-model ;
