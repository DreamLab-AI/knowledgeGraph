ngm:cross-border-payments a owl:Class ;
    rdfs:label "Cross-Border Payments"@en ;
    rdfs:comment "Cross-Border Payments are financial transactions that originate in one country and are settled in another, requiring currency conversion and multi-jurisdiction clearing. Traditional correspondent banking routes incur multi-day settlement cycles and layered fees; blockchain-based rails—including stablecoins, payment channels, and CBDCs—reduce settlement to minutes and lower intermediary costs. They sit at the intersection of monetary policy, regulatory compliance, and distributed-ledger technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance ;
    vc:requires ngm:smart-contract ;
    vc:slug "cross-border-payments" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:lightning-network,
        ngm:stablecoin .

ngm:hardware a owl:Class ;
    rdfs:label "Hardware"@en ;
    rdfs:comment "Hardware in the spatial computing domain encompasses the physical devices and electronic components that execute metaverse workloads: head-mounted displays, spatial audio systems, GPU rendering accelerators, depth cameras, haptic controllers, and edge compute nodes. Hardware capability is a primary constraint on the fidelity and interactivity of immersive experiences, driving the need for hardware abstraction layers and adaptive rendering pipelines that scale content quality to available compute resources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-component ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:embedded-systems,
        ngm:hardware-acceleration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gpu-compute,
        ngm:hardware-component ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:hardware-abstraction,
        ngm:hardware-and-edge ;
    vc:slug "hardware" ;
    vc:sourceDomain "spatial-computing" .

ngm:homomorphic-encryption a owl:Class ;
    rdfs:label "Homomorphic Encryption"@en ;
    rdfs:comment "Homomorphic encryption is a cryptographic scheme that allows arithmetic and logical operations to be performed directly on ciphertext, producing an encrypted result that decrypts to the same value as if the operations had been applied to the plaintext. Fully homomorphic encryption (FHE) supports arbitrary computation over encrypted data, enabling cloud services to process sensitive inputs without ever decrypting them. It sits at the intersection of cryptography and privacy-preserving technology, with practical schemes including BGV, BFV, CKKS, and TFHE."@en ;
    rdfs:subClassOf ngm:cryptography,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:contrastsWith ngm:differential-privacy ;
    vc:enables ngm:federated-learning,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:homomorphic-encryption-for-machine-learning,
        ngm:zero-knowledge-proof ;
    vc:slug "homomorphic-encryption" ;
    vc:sourceDomain "infrastructure" .

ngm:imu a owl:Class ;
    rdfs:label "IMU"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is a self-contained electronic sensor module that combines tri-axial accelerometers, gyroscopes, and optionally magnetometers to measure a body's specific force, angular rate, and orientation relative to an inertial reference frame. In spatial-computing headsets and controllers, the IMU provides low-latency, high-frequency pose estimates that are fused with visual odometry or SLAM to achieve stable, drift-corrected tracking. The same component is integral to robot proprioception, UAV stabilisation, and motion-capture systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:motion-tracking,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:inertial-measurement-unit ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation,
        ngm:slam ;
    vc:slug "imu" ;
    vc:sourceDomain "spatial-computing" .

ngm:json-ld a owl:Class ;
    rdfs:label "JSON-LD"@en ;
    rdfs:comment "JSON-LD (JSON for Linking Data) is a W3C Recommendation that defines a lightweight serialisation syntax for expressing Linked Data using the JSON data format. It adds a @context document that maps JSON keys to RDF IRIs, enabling any JSON document to be treated as an RDF graph whilst remaining valid JSON parseable by standard libraries. JSON-LD is a primary serialisation format for Verifiable Credentials, Schema.org structured data markup, and activity streams (ActivityPub), bridging the gap between pragmatic web development and formal semantic web standards."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:ontology,
        ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:linked-data,
        ngm:rdf ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:json-schema,
        ngm:sparql ;
    vc:slug "json-ld" ;
    vc:sourceDomain "blockchain" .

ngm:legal-framework a owl:Class ;
    rdfs:label "Legal Framework"@en ;
    rdfs:comment "A legal framework for technology systems comprises the body of laws, regulations, and legal requirements that govern the development, deployment, and operation of information technology."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
