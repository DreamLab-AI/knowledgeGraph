ngm:base-fee a owl:Class ;
    rdfs:label "Base Fee"@en ;
    rdfs:comment "The Base Fee is the algorithmically determined minimum fee per unit of gas that every transaction must pay to be included in an Ethereum block, introduced by EIP-1559. It adjusts automatically each block based on whether the previous block was above or below its gas target, increasing when demand is high and decreasing when low. Unlike miner tips, the base fee is burned rather than paid to validators, creating a deflationary pressure on ETH supply and making gas price prediction more reliable for users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eip-1559 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:miner,
        ngm:priority-fee ;
    vc:enables ngm:burning-mechanism,
        ngm:gas-fee-market,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-economics,
        ngm:gas-fee-market ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain-economics,
        ngm:gas-limit,
        ngm:gas-price,
        ngm:priority-fee ;
    vc:requires ngm:blockchain-transaction,
        ngm:eip-1559,
        ngm:gas,
        ngm:mempool ;
    vc:slug "base-fee" ;
    vc:sourceDomain "blockchain" .

ngm:batch-normalisation a owl:Class ;
    rdfs:label "Batch Normalisation"@en ;
    rdfs:comment "A technique that normalises layer inputs within a mini-batch to zero mean and unit variance, stabilising training dynamics, enabling higher learning rates, and acting as a form of regularisation in deep neural networks. Introduced by Ioffe and Szegedy (2015), it reduces internal covariate shift and has become a standard component in convolutional and other deep learning architectures."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:convolutional-neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:gradient-descent,
        ngm:regularisation ;
    vc:slug "batch-normalisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network,
        ngm:neural-network-layer .

ngm:bip-341 a owl:Class ;
    rdfs:label "BIP-341"@en ;
    rdfs:comment "BIP-341 is the Bitcoin Improvement Proposal that defines the Taproot upgrade, introducing Pay-to-Taproot (P2TR) as a new output type that merges script and key-path spending under a unified commitment scheme. It combines Schnorr signatures with Merklised Abstract Syntax Trees (MAST) to allow complex spending conditions to be committed on-chain while only revealing the executed branch at spend time. The proposal activated on the Bitcoin mainnet in November 2021 at block height 709,632. BIP-341 is accompanied by BIP-340 (Schnorr signatures) and BIP-342 (Tapscript), forming the complete Taproot bundle. The upgrade significantly improves privacy, fungibility, and script expressiveness for Bitcoin."@en ;
    rdfs:subClassOf ngm:bitcoin-improvement-proposals ;
    vc:enables ngm:bitcoin-network,
        ngm:script ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-340,
        ngm:taproot-assets,
        ngm:utxo-model ;
    vc:slug "bip-341" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-commitment,
        ngm:merkle-tree,
        ngm:schnorr-signature .

