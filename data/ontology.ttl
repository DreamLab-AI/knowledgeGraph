        ngm:itil-framework,
        ngm:nist-ai-rmf,
        ngm:oecd-corporate-governance-principles,
        ngm:uk-corporate-governance-code ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:dao-governance-for-telecollaboration,
        ngm:dao-legal-structures,
        ngm:data-protection-regulation,
        ngm:tokenomics-governance ;
