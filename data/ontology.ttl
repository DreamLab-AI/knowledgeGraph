    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:deep-learning,
        ngm:neural-radiance-field .

ngm:performance-metrics a owl:Class ;
    rdfs:label "Performance Metrics"@en ;
    rdfs:comment "Performance Metrics are quantitative measurements used to evaluate the efficiency, quality, and behaviour of AI models, software systems, or hardware platforms. In AI and metaverse contexts these include inference latency, frames per second, model accuracy, throughput, memory utilisation, and error rates. Metrics provide the empirical basis for benchmarking, monitoring dashboards, and continuous improvement pipelines."@en ;
