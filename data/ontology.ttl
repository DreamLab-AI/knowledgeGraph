ngm:chaumian-ecash a owl:Class ;
    rdfs:comment "Chaumian ecash is a form of digital cash, invented by David Chaum, that uses blind signatures to issue bearer tokens redeemable at a central mint while preserving payer privacy. The mint signs blinded token requests so it cannot link issued tokens to the users who later spend them, providing strong untraceability with offline-style bearer transfer. It matters as the cryptographic foundation for privacy-preserving custodial payment systems, revived in Bitcoin through mints such as Cashu and Fedimint."@en ;
    rdfs:label "Chaumian Ecash"@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cashu ;
    vc:relatedTo ngm:fedimint ;
    vc:slug "chaumian-ecash" ;
    vc:sourceDomain "blockchain" .
