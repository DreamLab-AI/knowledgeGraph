    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:access-control,
        ngm:metadata-standards,
        ngm:storage-infrastructure ;
    vc:slug "digital-archive" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-asset-lending a owl:Class ;
