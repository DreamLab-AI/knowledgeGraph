ngm:machine-learning a owl:Class ;
    rdfs:label "Machine Learning"@en ;
    rdfs:comment "Machine Learning is a sub-field of Artificial Intelligence in which computational systems learn to improve their performance on tasks by identifying statistical patterns in data rather than by following explicitly programmed rules. A model is exposed to a training dataset, an optimisation algorithm adjusts its parameters to minimise a loss function, and the resulting parameters generalise to unseen inputs. The discipline encompasses supervised learning from labelled examples, unsupervised learning from unlabelled structure, and reinforcement learning from reward signals in interactive environments. Foundational to modern AI stacks, machine learning underpins capabilities ranging from image recognition and natural language processing to recommendation systems and autonomous decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transfer-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unsupervised-learning ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:data-governance,
        ngm:smart-grid,
        ngm:supply-chain-optimisation ;
    vc:contrastsWith ngm:expert-system,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:data-pipeline,
        ngm:feature-engineering ;
    vc:enables ngm:computer-vision,
        ngm:generative-ai,
        ngm:natural-language-processing,
        ngm:predictive-analytics,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:deep-learning,
        ngm:reinforcement-learning,
        ngm:supervised-learning,
        ngm:transfer-learning,
        ngm:unsupervised-learning ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:requires ngm:computational-infrastructure,
        ngm:optimisation-algorithm,
        ngm:training-data ;
    vc:slug "machine-learning" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:iso-iec-23053-2022,
        ngm:nist-ai-rmf ;
    vc:supports ngm:decision-support,
