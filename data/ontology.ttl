ngm:honesty a owl:Class ;
    rdfs:label "Honesty"@en ;
    rdfs:comment "An alignment objective ensuring AI systems provide truthful and accurate information, avoiding false claims and acknowledging uncertainty when appropriate. Honesty (also called truthfulness) represents a critical dimension of trustworthy AI alongside helpfulness and harmlessness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:value-alignment ],
        ngm:ai-alignment,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:bias ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:harmlessness,
        ngm:helpfulness ;
    vc:requires ngm:ai-alignment,
        ngm:value-alignment ;
    vc:slug "honesty" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:explainability,
        ngm:trustworthy-ai .

