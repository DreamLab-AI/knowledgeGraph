        ngm:digital-identity,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:ethereum,
        ngm:quorum,
        ngm:r3-corda ;
    vc:enables ngm:enterprise-blockchain,
        ngm:permissioned-blockchain,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
