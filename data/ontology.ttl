# Information Protection
bc:InformationProtection a owl:Class ;
    rdfs:label "Information Protection"@en ;
    rdfs:comment "Information Protection is a concept within the blockchain domain. Further enrichment pending."@en ;
    skos:prefLabel "Information Protection"@en ;
    dcterms:identifier "BC-9501" ;
    dcterms:subject "bc" ;
    rdf:type owl:conceptClass .

