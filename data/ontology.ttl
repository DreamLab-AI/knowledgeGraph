ngm:data-security a owl:Class ;
    rdfs:comment "Data security comprises the policies, controls, and technologies that protect digital information from unauthorised access, corruption, or theft throughout its lifecycle. It spans encryption at rest and in transit, access control mechanisms, identity verification, and governance frameworks that together ensure confidentiality, integrity, and availability of data assets."@en ;
    rdfs:label "Data Security"@en ;
