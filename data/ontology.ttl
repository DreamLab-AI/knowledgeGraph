ngm:branch-and-bound a owl:Class ;
    rdfs:comment "An exact algorithmic paradigm for combinatorial optimisation that systematically explores a tree of candidate solution subsets, using bounds from relaxations of the problem to prune any branch that provably cannot contain a solution better than the best one found so far. Introduced by Land and Doig in 1960 for integer programming, branch and bound guarantees optimality while often avoiding exhaustive enumeration, and remains the backbone of modern mixed-integer programming and constraint solvers."@en ;
    rdfs:label "Branch and Bound"@en ;
    rdfs:subClassOf ngm:search-algorithm ;
    vc:contrastsWith ngm:dynamic-programming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:combinatorial-optimisation ;
    vc:isPartOf ngm:constraint-solver ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction ;
    vc:slug "branch-and-bound" ;
    vc:sourceDomain "artificial-intelligence" .
