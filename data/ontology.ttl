ngm:data-schema a owl:Class ;
    rdfs:label "Data Schema"@en ;
    rdfs:comment "A Data Schema is a formal specification that defines the structure, types, constraints, and semantics of data within a system or exchange protocol. It enumerates fields, their data types, cardinality rules, allowed values, and relationships between entities, enabling machines to validate conformance and enabling humans to understand data contracts. Data schemas are expressed in formalisms such as JSON Schema, XML Schema Definition, RDF SHACL, or OWL, and are versioned to manage evolution over time. They underpin interoperability between systems, database design, API contracts, and linked-data publishing."@en ;
    rdfs:subClassOf ngm:schema-definition ;
    vc:enables ngm:knowledge-representation,
        ngm:schema-registry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:metadata-schema,
        ngm:ontology ;
    vc:slug "data-schema" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:json-ld,
        ngm:json-schema,
        ngm:rdf .

ngm:decoder a owl:Class ;
    rdfs:label "Decoder"@en ;
    rdfs:comment "The component in an encoder-decoder architecture that generates the output sequence autoregressively, using masked self-attention, cross-attention to encoder outputs, and feed-forward layers."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:gpt,
        ngm:large-language-models ;
    vc:slug "decoder" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:cross-attention,
        ngm:self-attention .

