ngm:model-inference a owl:Class ;
    rdfs:label "Model Inference"@en ;
    rdfs:comment "Model inference is the operational phase of a machine learning system in which a trained model is applied to new, previously unseen inputs to produce predictions, classifications, or generated outputs. Unlike training, inference involves only a forward pass through the model and is optimised for low latency, high throughput, and efficient resource use. It is the stage at which a model delivers value in production, serving requests in real time, in batches, or at the edge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:machine-learning ;
    vc:contrastsWith ngm:model-training ;
    vc:dependsOn ngm:model-deployment ;
    vc:enables ngm:model-serving,
        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:mlops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:batch-processing,
        ngm:deep-learning,
        ngm:latency,
        ngm:model-optimization ;
    vc:requires ngm:inference-engine,
        ngm:model-training ;
    vc:slug "model-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:edge-computing,
        ngm:model-monitoring ;
    vc:uses ngm:gpu-acceleration,
        ngm:neural-network .

ngm:model-pruning-for-edge-deployment a owl:Class ;
    rdfs:label "Model Pruning for Edge Deployment"@en ;
    rdfs:comment "Model Pruning for Edge Deployment systematically removes redundant weights and neurons from neural networks, reducing model size and computational requirements while maintaining sufficient accuracy for edge inference."@en ;
