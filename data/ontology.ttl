        ngm:service-discovery ;
    vc:requires ngm:fault-tolerance ;
    vc:slug "etcd" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:kubernetes,
        ngm:microservices ;
    vc:uses ngm:consensus-algorithm,
        ngm:key-value-store .

