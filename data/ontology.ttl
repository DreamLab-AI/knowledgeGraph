            owl:someValuesFrom ngm:web-id ],
        ngm:infra-data-management,
        ngm:infra-network-and-comms,
        ngm:personal-data-store ;
    skos:broader ngm:infra-data-management,
        ngm:infra-network-and-comms ;
    vc:enables ngm:agent-personalisation,
        ngm:data-sovereignty,
        ngm:decentralised-identity,
        ngm:interoperable-personal-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acp-access-control-policy,
        ngm:ldp-container,
        ngm:rdf-resource,
        ngm:wac-access-control-list,
