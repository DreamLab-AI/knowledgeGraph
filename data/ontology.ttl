ngm:etsi-domain-infrastructure-security a owl:Class ;
    rdfs:comment "ETSI infrastructure security domain safeguarding metaverse and edge computing environments through NFV architectural frameworks, cross-domain authentication standards, and decentralised identity systems. It addresses multi-party trust models, privacy-preserving mechanisms, and security lifecycle management coordinated with 3GPP and ITU-T for ultra-edge and terminal-edge deployments."@en ;
    rdfs:label "ETSI_Domain_Infrastructure___Security"@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
