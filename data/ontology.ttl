ngm:virtual-physical-collision a owl:Class ;
    rdfs:label "Virtual Physical Collision"@en ;
    rdfs:comment "The detection and simulation of contact events between virtual objects and real-world physical elements in mixed and augmented reality environments. Virtual-physical collision systems generate haptic alerts, visual boundary warnings, and passthrough camera activations to prevent user injury and to produce physically plausible interactions between digital content and the real world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:room-scale ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:physics-simulation,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:user-safety ;
    vc:requires ngm:haptic-feedback,
        ngm:room-scale ;
    vc:slug "virtual-physical-collision" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physics-engine,
        ngm:spatial-tracking-technology .

