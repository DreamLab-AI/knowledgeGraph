    vc:uses ngm:mental-model .
ngm:heuristic-function a owl:Class ;
    rdfs:comment "A heuristic function is an estimating function used in search and optimisation that approximates the cost or distance from a given state to a goal state. It guides informed search algorithms by prioritising the exploration of states that appear most promising, trading guaranteed optimality for improved efficiency. A heuristic is admissible when it never overestimates the true cost, and consistent when it satisfies the triangle inequality, properties that determine the optimality guarantees of algorithms that use it."@en ;
    rdfs:label "Heuristic Function"@en ;
    rdfs:subClassOf ngm:search-algorithm ;
    rdfs:subClassOf _:r11637 ;
    vc:contrastsWith ngm:constraint-satisfaction ;
