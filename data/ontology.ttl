ngm:fungible-token a owl:Class ;
    rdfs:label "Fungible Token"@en ;
    rdfs:comment "A blockchain token where each unit is identical and fully interchangeable with any other unit of the same type, analogous to traditional fiat currency. Fungibility is enforced at the protocol level via standards such as ERC-20, ensuring uniform value and seamless divisibility across all holders."@en ;
