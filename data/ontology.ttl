        ngm:merkle-tree,
        ngm:public-key-cryptography,
        ngm:public-key-infrastructure .

ngm:description-logic a owl:Class ;
    rdfs:label "Description Logic"@en ;
    rdfs:comment "A family of formal knowledge representation languages used to describe concepts, roles, and individuals with well-defined model-theoretic semantics, providing decidable fragments of first-order logic tailored to structured knowledge representation and automated reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
