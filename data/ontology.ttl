# Zero Knowledge Proof
blockchain:ZeroKnowledgeProof rdf:type owl:Class ;
    rdfs:subClassOf blockchain:CryptographicProtocol ;
    rdfs:subClassOf blockchain:PrivacyPreservingComputation ;
    rdfs:label "Zero Knowledge Proof"@en ;
    rdfs:comment "A Zero-Knowledge Proof (ZKP) is a cryptographic protocol whereby a prover convinces a verifier that a statement is true (e.g., \"I know a secret value satisfying this predicate\") without revealing any information beyond the validity of the statement itself, satisfying three properties: completeness (honest provers always convince honest verifiers), soundness (dishonest provers cannot convince verifiers of false statements except with negligible probability), and zero-knowledge (the verifier learns nothing beyond the statement's truth); modern non-interactive variants — zk-SNARKs (Succinct Non-interactive Arguments of Knowledge), zk-STARKs (Scalable Transparent Arguments), and PLONK — underpin zkEVM rollups (Polygon zkEVM, zkSync Era, Starknet), privacy-preserving credential systems, and anonymous authentication mechanisms within VisionClaw Agentic Container verifiable credential workflows."@en ;
    skos:prefLabel "Zero Knowledge Proof"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:zero-knowledge-proof" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:zero-knowledge-proof> ;
    vcw:contentHash "sha256-12-5a2c8e1f7b4d" ;
    vcw:qualityScore "0.65"^^xsd:decimal ;
    vcw:legacyTermId "BC-0033" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.88"^^xsd:decimal ;
    dcterms:identifier "BC-0033" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

