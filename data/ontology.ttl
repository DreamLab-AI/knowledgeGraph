ngm:skeletal-rig a owl:Class ;
    rdfs:label "Skeletal Rig"@en ;
    rdfs:comment "A skeletal rig is the hierarchy of bones and control structures bound to a 3D model that allows it to be posed and animated. Each bone influences nearby vertices through skinning weights, so that rotating or translating a bone deforms the surrounding mesh in a controlled way. Rigs typically combine forward and inverse kinematics with control handles, enabling animators to drive complex character motion from a compact set of controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polygon-mesh ],
        ngm:3-d-modeling ;
    vc:bridgesTo ngm:visual-effects ;
    vc:contrastsWith ngm:uv-mapping ;
    vc:dependsOn ngm:3-d-modeling ;
    vc:enables ngm:animation,
        ngm:character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inverse-kinematics,
        ngm:vertex-attribute ;
    vc:implements ngm:animation-rig ;
    vc:isPartOf ngm:character-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:character-model,
        ngm:digital-asset ;
    vc:requires ngm:polygon-mesh ;
    vc:slug "skeletal-rig" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:motion-capture ;
    vc:uses ngm:animation-rig,
        ngm:inverse-kinematics .

ngm:skinning a owl:Class ;
    rdfs:label "Skinning"@en ;
    rdfs:comment "Skinning is the process of binding a deformable surface mesh to an underlying skeleton so that the mesh deforms naturally as the skeleton is animated. Each vertex is assigned weights that determine how strongly it follows each influencing bone, and these weights drive the deformation during playback. Skinning is essential to character animation, allowing a single rigged model to be posed and animated across many motions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:character-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:polygon-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blend-shape ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:character-rigging ],
        ngm:character-rigging ;
    vc:bridgesTo ngm:rendering-pipeline ;
    vc:dependsOn ngm:topology ;
    vc:enables ngm:animation,
        ngm:character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blend-shape,
        ngm:polygon-mesh ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:fbx,
        ngm:texture-mapping,
        ngm:uv-mapping ;
    vc:requires ngm:character-model,
