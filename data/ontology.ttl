    vc:slug "gri-standards" ;
    vc:sourceDomain "governance" .

ngm:gs1-digital-link a skos:Concept ;
    rdfs:label "Gs1 Digital Link"@en .

ngm:h-264 a owl:Class ;
    rdfs:label "H.264"@en ;
    rdfs:comment "H.264, also known as AVC (Advanced Video Coding) or MPEG-4 Part 10, is a block-oriented, motion-compensated video compression standard jointly developed by the ITU-T and ISO/IEC and finalised in 2003. It achieves substantially better compression efficiency than its predecessors through advanced intra and inter prediction, variable block-size motion compensation, an in-loop deblocking filter, and context-adaptive entropy coding. For two decades it has been the most widely deployed video codec, used in streaming, broadcast, Blu-ray, video conferencing, and surveillance, with broad hardware acceleration."@en ;
    rdfs:subClassOf ngm:video-codec ;
    vc:enables ngm:video-encoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:technical-standard ;
    vc:slug "h-264" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:video-compression .

ngm:hallucination a owl:Class ;
    rdfs:label "Hallucination"@en ;
    rdfs:comment "Hallucination in artificial intelligence refers to the phenomenon whereby a generative model produces fluent, confident, and syntactically plausible output that is factually incorrect, unsupported by provided context, or entirely fabricated. It is a fundamental failure mode of large language models, vision-language models, and other neural generative systems that optimise for next-token probability rather than verifiable truth. Hallucinations range from subtle factual distortions to wholesale invention of citations, persons, dates, or events, and represent a critical safety and reliability concern for deployed AI systems. Mitigation strategies include retrieval-augmented generation, grounding with tool use, chain-of-thought prompting, and output verification pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-risk ;
    vc:bridgesTo ngm:ai-governance,
        ngm:information-integrity,
        ngm:trust-and-safety ;
    vc:contrastsWith ngm:calibration,
        ngm:factual-grounding,
        ngm:truthfulness ;
    vc:dependsOn ngm:autoregressive-generation,
        ngm:large-language-model,
        ngm:neural-network ;
    vc:enables ngm:ai-safety-research,
        ngm:misinformation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-risk,
        ngm:conversational-ai,
        ngm:model-evaluation,
        ngm:prompt-engineering,
        ngm:uncertainty-quantification ;
    vc:requires ngm:human-oversight,
        ngm:output-verification ;
    vc:slug "hallucination" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought-prompting,
        ngm:retrieval-augmented-generation,
        ngm:tool-augmented-reasoning .

ngm:hardhat a owl:Class ;
    rdfs:label "Hardhat"@en ;
    rdfs:comment "Hardhat is a professional Ethereum development environment that provides a comprehensive toolchain for compiling, deploying, testing, and debugging Solidity smart contracts. It ships with Hardhat Network, an in-process Ethereum node implementation designed for local development that supports forking mainnet state and emitting Solidity stack traces on failure. Hardhat's plugin architecture integrates tightly with ethers.js and Waffle, and its tasks system allows developers to automate bespoke deployment and verification workflows. It has become the dominant development framework in the Ethereum ecosystem, displacing earlier tools such as Truffle."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
