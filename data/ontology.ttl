ngm:vyper a owl:Class ;
    rdfs:label "Vyper"@en ;
    rdfs:comment "A contract-oriented programming language for the Ethereum Virtual Machine that emphasises simplicity, auditability, and security. It uses Python-like syntax and deliberately omits features that can make contracts hard to reason about."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-virtual-machine ],
        ngm:programming-language ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum-virtual-machine ;
    vc:slug "vyper" ;
    vc:sourceDomain "blockchain" .

