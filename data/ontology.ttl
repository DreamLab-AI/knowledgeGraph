# Digital Citizens’ Assembly
mv:DigitalCitizensAssembly a owl:Class ;
    rdfs:label "Digital Citizens’ Assembly"@en ;
    rdfs:comment "structured deliberation process using XR spaces for policy co-creation."@en ;
    skos:prefLabel "Digital Citizens’ Assembly"@en ;
    dcterms:identifier "MV-4007" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Land Scarcity
mv:LandScarcity a owl:Class ;
    rdfs:label "Land Scarcity"@en ;
    rdfs:comment "Economic principle in virtual worlds where digital land parcels are artificially limited to create value and drive virtual real estate markets."@en ;
    skos:prefLabel "Land Scarcity"@en ;
    dcterms:identifier "MV-4008" ;
    dcterms:subject "mv" ;
    dcterms:type "emerging" ;
    rdf:type owl:ProcessClass .

# Avatar Wearable
mv:AvatarWearable a owl:Class ;
    rdfs:subClassOf mv:DigitalAsset ;
    rdfs:label "Avatar Wearable"@en ;
    rdfs:comment "Digital clothing, accessories, and cosmetic items that can be equipped by avatars in virtual environments, often tradeable as digital assets or NFTs."@en ;
    skos:prefLabel "Avatar Wearable"@en ;
    dcterms:identifier "MV-4009" ;
    dcterms:subject "mv" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Inflation Control
mv:InflationControl a owl:Class ;
    rdfs:label "Inflation Control"@en ;
    rdfs:comment "Mechanisms and policies in virtual economies to regulate the creation and distribution of virtual currency, preventing value depreciation and economic instability."@en ;
    skos:prefLabel "Inflation Control"@en ;
    dcterms:identifier "MV-4010" ;
    dcterms:subject "mv" ;
    dcterms:type "mature" ;
    rdf:type owl:ProcessClass .

# MetaverseDomain
mv:Metaversedomain a owl:Class ;
    rdfs:label "MetaverseDomain"@en ;
    rdfs:comment "The Metaverse Domain provides an ontological framework for interconnected digital platforms leveraging augmented, extended, and virtual realities to create immersive user experiences through multidimensional interactions. It encompasses virtual environments, avatar embodiment, spatial computing, digital economies, and the convergence of physical and virtual worlds where millions can simultaneously inhabit and interact in real-time regardless of physical distance."@en ;
    skos:prefLabel "MetaverseDomain"@en ;
    dcterms:identifier "MV-7000" ;
    dcterms:subject "mv" ;
    dcterms:type "reviewed" ;
    rdf:type owl:DomainClass .

# Inclusive Xr Experience
mv:InclusiveXrExperience a owl:Class ;
    rdfs:subClassOf mv:AccessibleExperience ;
    rdfs:label "Inclusive Xr Experience"@en ;
    rdfs:comment "Extended reality applications and environments designed to provide equitable, accessible experiences for users of all abilities, incorporating assistive technologies, alternative interaction modalities, and adaptive features that ensure meaningful participation in VR, AR, and metaverse spaces."@en ;
    skos:prefLabel "Inclusive Xr Experience"@en ;
    dcterms:identifier "MV-9000" ;
    dcterms:subject "mv" .

mv:InclusiveXrExperience rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:EquitableMetaverseAccess
] .

mv:InclusiveXrExperience rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InclusiveXrDesign
] .

mv:InclusiveXrExperience rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ImmersiveExperiences
] .

# MV-9001
mv:3DAnimation a owl:Class ;
    dcterms:identifier "MV-9001" .

# Inclusive Xr Design
mv:InclusiveXrDesign a owl:Class ;
    rdfs:subClassOf mv:AccessibleDesign ;
    rdfs:label "Inclusive Xr Design"@en ;
    rdfs:comment "Design methodologies for creating accessible VR, AR, and metaverse experiences that accommodate diverse user abilities, including those with visual, auditory, motor, and cognitive disabilities, ensuring equitable access through alternative input methods, adaptive interfaces, and assistive technology integration."@en ;
    skos:prefLabel "Inclusive Xr Design"@en ;
    dcterms:identifier "MV-9001" ;
    dcterms:subject "mv" .

mv:InclusiveXrDesign rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:UniversalXRAccess
] .

mv:InclusiveXrDesign rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InclusiveXrExperience
] .

