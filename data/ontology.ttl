        ngm:virtual-museum-tour ;
    vc:requires ngm:immersive-technology,
        ngm:virtual-environment ;
    vc:slug "virtual-field-trip" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersive-learning,
        ngm:virtual-destination .

ngm:virtual-museum-tour a owl:Class ;
    rdfs:label "Virtual Museum Tour"@en ;
    rdfs:comment "An immersive digital experience that enables users to explore museum collections, exhibitions, and cultural heritage sites through VR, AR, 360-degree imagery, or interactive 3D environments, providing global access to art and artefacts regardless of physical location. Delivery formats range from photogrammetry-reconstructed 3D galleries (Smithsonian, British Museum) to fully navigable VR spaces, with platforms such as Google Arts and Culture and Matterport enabling broad public access across device types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
