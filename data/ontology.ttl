ngm:network-latency a owl:Class ;
    rdfs:label "Network Latency"@en ;
    rdfs:comment "Network Latency is the round-trip communication delay between nodes in a network, directly constraining consensus speed, block propagation, transaction throughput, real-time application responsiveness, and distributed system coordination. High latency increases the probability of forks in blockchain systems, degrades user experience in interactive applications, and sets a fundamental lower bound on achievable synchronisation intervals in geographically distributed deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency-management-protocol ],
        ngm:network-component ;
    vc:bridgesTo ngm:blockchain-scalability,
        ngm:distributed-collaboration,
        ngm:spatial-computing-rendering ;
    vc:contrastsWith ngm:latency,
        ngm:throughput ;
    vc:dependsOn ngm:bandwidth,
        ngm:network-topology,
        ngm:physical-distance ;
    vc:enables ngm:distributed-coordination,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:processing-delay,
        ngm:propagation-delay,
        ngm:queuing-delay,
        ngm:transmission-delay ;
    vc:isPartOf ngm:network-performance,
        ngm:quality-of-service ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:distributed-system,
        ngm:gossip-protocol,
        ngm:sub-millisecond-latency ;
    vc:requires ngm:latency-management-protocol,
        ngm:network-infrastructure ;
    vc:slug "network-latency" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:block-propagation-time,
        ngm:consensus-mechanism ;
    vc:uses ngm:ping,
        ngm:round-trip-time .

ngm:network-slicing a owl:Class ;
    rdfs:label "Network Slicing"@en ;
    rdfs:comment "Network slicing is a virtualisation architecture that partitions a single physical network infrastructure into multiple isolated, logically independent virtual networks — called slices — each configured to provide the specific performance characteristics, security posture, and service topology required by a distinct application or tenant. Defined within 3GPP Release 15 and later releases for 5G networks, each slice is instantiated through software-defined networking and network function virtualisation, enabling differentiated service-level guarantees — such as ultra-low latency for industrial automation or high-throughput for video streaming — without dedicated physical hardware. Slices span radio access, transport, and core network domains and can be dynamically provisioned, scaled, and torn down."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radio-access-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-function-virtualization ],
        ngm:network-function-virtualization ;
    vc:bridgesTo ngm:intent-based-networking,
        ngm:multi-access-edge-computing ;
    vc:contrastsWith ngm:best-effort-networking,
        ngm:dedicated-hardware-provisioning ;
    vc:dependsOn ngm:5g-core-network,
        ngm:segment-routing,
        ngm:service-level-agreement ;
    vc:enables ngm:edge-computing,
        ngm:guaranteed-bandwidth,
        ngm:multi-tenancy,
        ngm:private-5g-network,
        ngm:quality-of-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:radio-access-network,
        ngm:service-function-chain,
        ngm:virtualised-network-function ;
    vc:implements ngm:3gpp-release-15 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:6-g-network-slice,
        ngm:latency ;
    vc:requires ngm:network-function-virtualization,
        ngm:resource-orchestration,
        ngm:software-defined-networking ;
    vc:slug "network-slicing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3gpp,
        ngm:etsi-nfv ;
    vc:supports ngm:edge-computing-architecture,
        ngm:industrial-iot,
        ngm:vehicle-to-everything .

ngm:neuromorphic-computing a owl:Class ;
    rdfs:label "Neuromorphic Computing"@en ;
    rdfs:comment "A computational paradigm that designs hardware and software systems to mirror the structure and function of biological neural networks, integrating memory and processing units to enable parallel, event-driven information processing inspired by how neurons communicate through electrical spikes. Unlike conventional von Neumann architectures, neuromorphic systems perform computation asynchronously at the location of data, enabling orders-of-magnitude improvements in energy efficiency for AI inference at the edge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neuromorphic-chips ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neuromorphic-chip ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:artificial-general-intelligence,
        ngm:cognitive-architecture ;
    vc:enables ngm:autonomous-system,
        ngm:edge-ai-accelerator,
        ngm:edge-ai-system,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:neuromorphic-chip,
        ngm:neuromorphic-chips ;
    vc:qualityScore "0.75"^^xsd:float ;
