ngm:data-compression a owl:Class ;
    rdfs:label "Data Compression"@en ;
    rdfs:comment "Data Compression in AI encompasses techniques for reducing the size of datasets, models, and computational representations while preserving essential information and predictive performance. Key methods include model quantisation (reducing numerical precision of weights), pruning (removing redundant parameters), knowledge distillation (training compact student models from large teachers), and neural compression via autoencoders. These techniques are critical for deploying AI on resource-constrained edge devices and for reducing storage, bandwidth, and energy costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy-coding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lossless-compression ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:network-bandwidth-management,
        ngm:storage-optimisation ;
    vc:contrastsWith ngm:full-precision-model ;
    vc:dependsOn ngm:information-theory ;
    vc:enables ngm:bandwidth-efficient-communication,
        ngm:federated-learning,
        ngm:model-compression-for-edge,
        ngm:on-device-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:entropy-coding,
        ngm:lossless-compression ;
    vc:isPartOf ngm:model-optimisation-and-performance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-pruning-for-edge-deployment,
        ngm:neural-architecture-search,
        ngm:weight-sharing ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "data-compression" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-inference,
        ngm:edge-ai,
        ngm:tiny-ml ;
    vc:uses ngm:autoencoder,
        ngm:knowledge-distillation,
        ngm:quantisation,
        ngm:sparse-representation .

ngm:data-model a owl:Class ;
    rdfs:label "Data Model"@en ;
    rdfs:comment "A data model is an abstract specification of how data elements are structured, related and constrained within a domain or system. It defines entities, attributes, relationships and integrity rules at conceptual, logical or physical levels of abstraction. Data models are prerequisites for metadata standards and for designing storage, exchange and querying of data."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:metadata-standard ;
    vc:slug "data-model" ;
    vc:sourceDomain "data" .

ngm:depth-sensing a owl:Class ;
    rdfs:label "Depth Sensing"@en ;
    rdfs:comment "Depth Sensing is the acquisition and processing of per-pixel or per-point distance information from a sensor to surfaces in a scene, yielding depth maps, range images, or 3D point clouds. Hardware modalities include structured light projection, time-of-flight (ToF) imaging, passive and active stereo vision, LiDAR scanning, and monocular depth estimation via machine learning. Depth sensing is a foundational enabling technology for spatial computing, robotic navigation, autonomous vehicles, augmented and mixed reality occlusion, gesture recognition, and 3D scene reconstruction, providing the geometric substrate upon which higher-level understanding is built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-input ],
        ngm:sensor-fusion ;
    vc:bridgesTo ngm:machine-learning,
        ngm:neural-radiance-field ;
    vc:contrastsWith ngm:monocular-depth-estimation ;
    vc:enables ngm:3-d-reconstruction,
        ngm:augmented-reality,
        ngm:gesture-recognition,
        ngm:object-detection,
        ngm:point-cloud,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:depth-estimation,
        ngm:scene-understanding,
        ngm:semantic-segmentation ;
    vc:requires ngm:camera-calibration,
        ngm:sensor-input,
        ngm:signal-processing ;
    vc:slug "depth-sensing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-navigation,
        ngm:mixed-reality,
        ngm:robotics ;
    vc:uses ngm:infrared-sensor,
        ngm:lidar,
        ngm:stereo-camera,
        ngm:structured-light,
        ngm:time-of-flight-sensor .

ngm:digital-ownership a owl:Class ;
    rdfs:label "Digital Ownership"@en ;
    rdfs:comment "The cryptographically verified right to possess, control, and transfer digital assets including NFTs, virtual real estate, in-game items, and tokenised content, established through blockchain technology and smart contracts that provide immutable proof of authenticity and provenance within metaverse economies and broader digital commerce contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ownership-record ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        ngm:property-rights ;
    vc:bridgesTo ngm:data-sovereignty,
        ngm:metaverse,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:intellectual-property-rights ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:decentralised-storage,
        ngm:distributed-ledger ;
    vc:enables ngm:asset-transfer,
        ngm:creator-royalties,
        ngm:fractional-ownership,
        ngm:marketplace,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:non-fungible-token,
        ngm:ownership-record ;
    vc:implements ngm:erc-1155,
        ngm:erc-721 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:self-sovereign-identity ;
    vc:requires ngm:blockchain-network,
        ngm:cryptographic-key-management,
        ngm:digital-wallet,
        ngm:smart-contracts,
        ngm:token-standard ;
    vc:slug "digital-ownership" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-rights-management,
        ngm:tokenised-real-world-assets .

ngm:ecdsa a owl:Class ;
    rdfs:label "ECDSA"@en ;
    rdfs:comment "Elliptic Curve Digital Signature Algorithm (ECDSA) is a cryptographic primitive that uses elliptic curve mathematics to generate and verify digital signatures, underpinning transaction authentication in Bitcoin, Ethereum, and most public blockchain networks. ECDSA provides non-repudiation, integrity verification, and ownership proof with compact key sizes relative to RSA equivalents."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:ed-dsa,
        ngm:rsa-signature,
        ngm:schnorr-signature ;
    vc:dependsOn ngm:cryptographic-key-management,
        ngm:elliptic-curve-discrete-logarithm-problem ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:non-repudiation,
        ngm:transaction-signing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature-standard,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:digital-signature-algorithm,
        ngm:p-256-curve,
        ngm:secp256k1 ;
    vc:requires ngm:elliptic-curve-parameters ;
    vc:slug "ecdsa" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist,
        ngm:sec-standards ;
    vc:supports ngm:bitcoin,
        ngm:code-signing,
        ngm:ethereum,
        ngm:tls ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:finite-field-arithmetic,
        ngm:private-key,
        ngm:public-key,
        ngm:random-number-generator .

ngm:encoder-decoder-architecture a owl:Class ;
    rdfs:label "Encoder Decoder Architecture"@en ;
    rdfs:comment "A neural network design pattern comprising an encoder that compresses an input sequence into a latent representation and a decoder that generates an output sequence from that representation, enabling sequence-to-sequence mappings for tasks such as machine translation, summarisation, and image captioning. The architecture underpins the original Transformer (Vaswani et al., 2017) and models such as T5 and BART."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:multimodal-ai-architecture-ai ;
    vc:contrastsWith ngm:decoder-only-architecture,
        ngm:recurrent-neural-network ;
    vc:dependsOn ngm:gradient-descent,
        ngm:neural-network ;
    vc:enables ngm:image-captioning,
        ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:text-summarisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cross-attention,
        ngm:feed-forward-network,
        ngm:positional-encoding,
        ngm:self-attention,
        ngm:token-embedding ;
    vc:implements ngm:large-language-model,
        ngm:transformer ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:bart,
        ngm:bert,
        ngm:t5-model ;
    vc:requires ngm:attention-mechanism,
        ngm:backpropagation ;
    vc:slug "encoder-decoder-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autoregressive-generation,
        ngm:transfer-learning ;
    vc:uses ngm:layer-normalisation,
        ngm:multi-head-attention,
        ngm:softmax-function .

ngm:entropy a owl:Class ;
    rdfs:label "Entropy"@en ;
    rdfs:comment "A measure of disorder or uncertainty. In thermodynamics it quantifies the unavailable energy in a system, and in information theory it quantifies the average uncertainty or information content of a source."@en ;
    rdfs:subClassOf ngm:information-theory ;
    vc:enables ngm:random-number-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "entropy" ;
    vc:sourceDomain "machine-learning" .

ngm:force-torque-sensor a owl:Class ;
    rdfs:label "Force Torque Sensor"@en ;
    rdfs:comment "Force-Torque Sensor - A multi-axis transducer mounted on the Robot Wrist that measures three-dimensional forces and torques (6-DoF) exerted during interaction with objects or humans, enabling Force Feedback, Contact Detection, and Compliance Control in precision manipulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
