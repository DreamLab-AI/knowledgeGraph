    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool,
        ngm:validator ;
    vc:slug "thorchain" ;
    vc:sourceDomain "blockchain" .

ngm:tim-reutermann-decentralised-governance-thinker a owl:Class ;
    rdfs:label "Tim Reutermann Decentralised Governance Thinker"@en ;
    rdfs:comment "Tim Reutermann is a writer and technologist whose work synthesises cypherpunk philosophy, decentralised governance models, and AI-driven economic paradigm shifts. He advocates liquid democracy, universal basic income, and open-source systems as mechanisms for aligning economic incentives with social goods in the face of automation-driven disruption."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
