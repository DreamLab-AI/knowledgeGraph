ngm:blend-shape a owl:Class ;
    rdfs:comment "A blend shape, also called a morph target, is a stored deformation of a 3D mesh that is blended with a base shape by a weighted interpolation of vertex positions. By combining multiple blend shapes at varying weights, animators produce smooth transitions between expressions and poses without altering the mesh topology. Blend shapes are central to facial animation, where subtle muscle movements are captured as named targets driven by animation rigs or performance capture."@en ;
    rdfs:label "Blend Shape"@en ;
    rdfs:subClassOf ngm:facial-animation ;
    rdfs:subClassOf _:r3274 ;
