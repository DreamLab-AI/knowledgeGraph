        ngm:recommendation-engine,
        ngm:recommendation-system .

ngm:polkadot a owl:Class ;
    rdfs:label "Polkadot"@en ;
    rdfs:comment "Polkadot is a heterogeneous multi-chain blockchain protocol designed by Gavin Wood and developed by Parity Technologies that enables independent application-specific blockchains — called parachains — to connect to a central relay chain, share its pooled security, and exchange messages and assets through the Cross-Consensus Message (XCM) format. Its nominated proof-of-stake consensus mechanism uses DOT token validators to secure the relay chain whilst parachains benefit from shared security without needing to bootstrap their own validator sets. Polkadot is built on the Substrate framework, which allows developers to construct purpose-built WebAssembly-based runtimes supporting forkless on-chain upgrades. The protocol addresses the 'island of value' problem by providing a unified security and interoperability layer for a heterogeneous ecosystem of sovereign blockchains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:polkadot-parachains ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:blockchain-protocol ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:avalanche,
        ngm:cosmos-ibc,
        ngm:ethereum ;
    vc:dependsOn ngm:cryptographic-primitive,
        ngm:distributed-ledger-technology ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-messaging,
        ngm:on-chain-governance,
        ngm:protocol-upgrades ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:polkadot-parachains,
        ngm:xcm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:decentralised-finance,
        ngm:smart-contracts,
        ngm:web3 ;
    vc:requires ngm:nominated-proof-of-stake,
        ngm:validator-set,
        ngm:web-assembly ;
    vc:slug "polkadot" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:nominated-proof-of-stake,
        ngm:web-assembly .

ngm:power-systems a owl:Class ;
    rdfs:label "Power Systems"@en ;
    rdfs:comment "Power Systems refers to the interconnected infrastructure of electrical generation, transmission, distribution, and consumption that constitutes a modern electricity network, together with the engineering discipline that analyses, designs, and controls this infrastructure. Key concerns include power flow analysis, voltage stability, frequency regulation, fault analysis, and the integration of variable renewable generation sources into grid operations. Power systems engineering underpins all modern industrial economies and is undergoing significant transformation as decarbonisation mandates, distributed energy resources, and digital control systems reshape traditional architectures. The discipline employs optimisation, control theory, and increasingly machine learning for real-time grid management."@en ;
    rdfs:subClassOf ngm:energy-and-power ;
    vc:enables ngm:battery-management-system,
        ngm:industrial-io-t ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:energy-management,
        ngm:renewable-energy,
        ngm:smart-grid ;
    vc:slug "power-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:optimal-control,
        ngm:optimisation,
        ngm:sensor-data .

ngm:proposal-system a owl:Class ;
    rdfs:label "Proposal System"@en ;
    rdfs:comment "Multi-stage governance workflow mechanism enabling DAO community members to initiate, discuss, deliberate, vote upon, and execute protocol changes through structured processes that combine off-chain deliberation (forums, governance calls), cryptographic signalling via off-chain snapshot votes, and binding on-chain execution through smart contracts, with threshold requirements (token holdings, quorum) balancing permissionless participation against governance efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
