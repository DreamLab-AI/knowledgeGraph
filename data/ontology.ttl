ngm:reverse-proxy a owl:Class ;
    rdfs:label "Reverse Proxy"@en ;
    rdfs:comment "A reverse proxy is a server that sits in front of one or more backend servers and forwards client requests to them, presenting a single entry point to the outside world. It terminates client connections, can offload TLS, cache responses, compress payloads and apply access controls before relaying traffic. By decoupling clients from backends it improves security, scalability and operational flexibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ssl-termination ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:caching ],
        ngm:network-architecture ;
    vc:bridgesTo ngm:content-delivery-network,
        ngm:load-balancer ;
    vc:contrastsWith ngm:api-gateway ;
    vc:dependsOn ngm:dns,
        ngm:http ;
    vc:enables ngm:high-availability,
        ngm:rate-limiting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:caching,
        ngm:ssl-termination ;
    vc:isPartOf ngm:cloud-infrastructure,
        ngm:network-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:load-balancer ;
    vc:requires ngm:http,
        ngm:tcp-ip ;
    vc:slug "reverse-proxy" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:microservices,
        ngm:web-application-firewall ;
    vc:uses ngm:caching,
        ngm:ssl-termination .

ngm:reward-modelling a owl:Class ;
    rdfs:label "Reward Modelling"@en ;
    rdfs:comment "Reward modelling is a machine-learning technique that trains a separate model to predict human preferences and use its scores as a reward signal for optimising another agent. It underpins reinforcement learning from human feedback, where the reward model ranks candidate outputs so a policy can be tuned toward preferred behaviour. It is central to aligning large language models with human values and intent."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:safety-and-alignment ;
    vc:slug "reward-modelling" ;
    vc:sourceDomain "ai" .

ngm:robot-standard a owl:Class ;
