ngm:user-authentication-mechanism a owl:Class ;
    rdfs:label "User Authentication Mechanism"@en ;
    rdfs:comment "A User Authentication Mechanism is a protocol or system component that verifies the claimed identity of a user before granting access to a resource or service. Mechanisms include password-based credentials, OAuth 2.0 federated login, biometric binding, multi-factor authentication, and decentralised identity using DIDs, each offering different trade-offs between security, usability, and privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:identity-and-access-management ;
    vc:requires ngm:access-control,
        ngm:identity-verification ;
    vc:slug "user-authentication-mechanism" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:decentralised-identity,
        ngm:oauth-2-0 .

ngm:user-context-awareness a owl:Class ;
    rdfs:label "User Context Awareness"@en ;
    rdfs:comment "User Context Awareness is the capability of digital systems to sense, model, and respond to a user's current situation—encompassing location, activity, device state, social context, and environmental factors—in order to deliver personalised, timely, and relevant experiences. It underpins adaptive XR interfaces, smart environment switching, and context-driven content recommendation in spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-awareness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:context-aware-computing,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:personalized-virtual-experiences,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:user-experience ;
    vc:requires ngm:context-awareness,
        ngm:sensor-fusion ;
    vc:slug "user-context-awareness" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:preference-learning .

ngm:v-llm a owl:Class ;
    rdfs:label "vLLM"@en ;
    rdfs:comment "vLLM is an open-source library for high-throughput serving of large language models. It introduced paged attention, a memory management technique that reduces waste in the key-value cache during generation."@en ;
