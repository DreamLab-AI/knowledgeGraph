ngm:ai-ethics a owl:Class ;
    rdfs:comment "AI Ethics addresses the moral principles, values, and guidelines governing the design, development, deployment, and use of artificial intelligence systems. This interdisciplinary field examines fairness, accountability, transparency, privacy, and bias mitigation, drawing on philosophy, law, and computer science to ensure AI systems respect human rights and societal values."@en ;
    rdfs:label "AI Ethics"@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
