        ngm:optimism-collective,
        ngm:uniswap-governance ;
    vc:requires ngm:proposal-system,
        ngm:quorum-mechanism ;
    vc:slug "delegate-democracy" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:compound-governor-bravo,
        ngm:erc-20-token-standard,
        ngm:open-zeppelin-governor-contracts,
        ngm:snapshot ;
    vc:supports ngm:citizen-engagement,
