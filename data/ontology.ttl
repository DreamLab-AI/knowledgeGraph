ngm:open-source-ai a owl:Class ;
    rdfs:label "Open-Source AI"@en ;
    rdfs:comment "Open-Source AI denotes artificial intelligence systems—including model weights, training code, datasets, evaluation benchmarks, and inference tooling—released under licences that permit public inspection, reproduction, modification, and redistribution. The degree of openness varies widely: fully open releases expose weights, training data, and procedures; open-weights releases share weights and inference code while withholding training data; and open-API systems expose neither. This transparency gradient determines reproducibility, auditability, and dual-use risk, and is formalised by frameworks such as the OSI Open Source AI Definition. Open-source AI accelerates community safety research, enables fine-tuning on proprietary data, and reduces vendor lock-in, while simultaneously raising governance questions about capability proliferation and misuse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-weights ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-source-licence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:benchmark-evaluation ],
        ngm:open-source-software ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:regulatory-compliance ;
    vc:dependsOn ngm:large-language-model,
        ngm:neural-network-architecture ;
    vc:enables ngm:edge-ai,
        ngm:federated-learning,
        ngm:fine-tuning,
        ngm:neural-network-quantisation,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:benchmark-evaluation,
        ngm:inference-engine,
        ngm:model-weights,
        ngm:training-dataset ;
    vc:isPartOf ngm:open-source-software ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:hugging-face-model-hub ;
    vc:requires ngm:compute-infrastructure,
        ngm:open-source-licence ;
    vc:slug "open-source-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety,
