        <urn:visionflow:linked:protocol-upgrades>,
        vf:dao-analytics,
        vf:delegate-democracy,
        vf:reputation-system,
        vf:treasury-management ;
    vc:hasPart <urn:visionflow:linked:block-snapshot>,
        <urn:visionflow:linked:delegation-registry>,
        <urn:visionflow:linked:governor-contract>,
        <urn:visionflow:linked:proposal-threshold>,
        <urn:visionflow:linked:quorum-mechanism>,
        <urn:visionflow:linked:timelock-contract>,
        <urn:visionflow:linked:vote-escrow>,
        <urn:visionflow:linked:voting-period>,
        vf:conviction-voting,
        vf:proposal-system,
        vf:quadratic-voting,
        vf:snapshot-voting ;
