    rdfs:label "Deduplication Filter"@en .
ngm:deep-dao a owl:Class ;
    rdfs:comment "DeepDAO is a leading analytics and data aggregation platform dedicated to tracking and measuring the organisational health, financial activity, governance participation, and membership dynamics of decentralised autonomous organisations across multiple blockchain networks. It provides standardised metrics — total assets under management, number of token holders, proposal counts, voter participation rates, and delegate rankings — that enable comparative analysis of DAO ecosystems and inform investment, research, and governance design decisions."@en ;
    rdfs:label "DeepDAO"@en ;
    rdfs:subClassOf ngm:dao-analytics ;
