    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:governance-token,
        ngm:impermanent-loss,
        ngm:slippage,
        ngm:total-value-locked,
        ngm:yield-farming ;
    vc:requires ngm:token-pair,
        ngm:wallet ;
    vc:slug "liquidity-provider" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:lp-token,
        ngm:smart-contract .

ngm:liveness-detection a owl:Class ;
    rdfs:label "Liveness Detection"@en ;
    rdfs:comment "Liveness detection is a set of techniques used during biometric capture to verify that the presented sample originates from a live, present human rather than a spoof such as a photograph, mask, recording or deepfake. It distinguishes genuine presentations from presentation attacks by analysing physiological signals, motion, texture and challenge responses, and is standardised under ISO/IEC 30107 as presentation attack detection. Liveness detection is essential to the integrity of remote identity verification, biometric authentication and onboarding flows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:facial-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        ngm:biometric-verification ;
    vc:enables ngm:authentication,
        ngm:fraud-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection ;
    vc:isPartOf ngm:biometric-authentication,
        ngm:identity-verification ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:cybersecurity ;
    vc:requires ngm:facial-recognition,
        ngm:image-processing ;
    vc:slug "liveness-detection" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:kyc,
        ngm:multi-factor-authentication ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning .

ngm:longest-chain-rule a owl:Class ;
    rdfs:label "Longest Chain Rule"@en ;
    rdfs:comment "The fork-choice rule used in proof-of-work blockchains that designates the chain with the most cumulative work (or greatest total difficulty) as the canonical chain. It resolves temporary forks by directing nodes to extend the heaviest chain, thereby converging the distributed network on a single transaction history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:51-attack ;
    vc:enables ngm:blockchain-protocol,
        ngm:decentralization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-reorganization,
        ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:difficulty-adjustment,
        ngm:selfish-mining ;
    vc:requires ngm:block,
        ngm:blockchain ;
    vc:slug "longest-chain-rule" ;
    vc:sourceDomain "blockchain" .

ngm:manipulator-arm a owl:Class ;
    rdfs:label "Manipulator Arm"@en ;
    rdfs:comment "A multi-jointed mechanical or virtual robotic arm integrated with avatars or immersive systems to enable precise object manipulation and physical interaction within virtual or mixed reality environments through control systems, haptic feedback, and inverse kinematics algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
