    vc:slug "owl-2-web-ontology-language" ;
    vc:sourceDomain "general" .

ngm:parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    rdfs:comment "A Parameter in machine learning and AI is a learnable variable internal to a model whose values are adjusted during training to minimise a loss function, as distinguished from hyperparameters, which are configuration choices set before training begins. In neural networks, parameters encompass weight matrices and bias vectors in each layer; the total parameter count (ranging from thousands in small models to hundreds of billions in large language models) is a primary indicator of model capacity and computational cost. Parameters are initialised randomly or via transfer learning, then updated iteratively through gradient-based optimisation algorithms such as stochastic gradient descent, encoding learned representations of the training distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:hyperparameter ;
    vc:enables ngm:deep-learning,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:fine-tuning,
        ngm:neural-network-architecture,
        ngm:overfitting,
        ngm:transformer,
        ngm:underfitting ;
    vc:requires ngm:loss-function,
        ngm:model-training ;
    vc:slug "parameter" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:neural-network .

ngm:paxos a owl:Class ;
    rdfs:label "Paxos"@en ;
    rdfs:comment "Paxos is a family of fault-tolerant distributed consensus algorithms first formally described by Leslie Lamport in 1989 and published in 1998, designed to allow a cluster of processes to agree on a single value or sequence of values despite the failure of a minority of participants. The algorithm proceeds through prepare and accept phases orchestrated by a proposer, with acceptors voting to commit proposed values and learners observing the final agreement. Multi-Paxos extends the basic protocol to achieve consensus on a log of commands efficiently, forming the algorithmic foundation of replicated state machines. Paxos and its derivatives, including Raft and HotStuff, underpin virtually every strongly consistent distributed database and coordination service in production use today."@en ;
    rdfs:subClassOf ngm:consensus-algorithm ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-computing,
        ngm:distributed-ledger ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism,
        ngm:state-machine-replication ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:distributed-protocol,
        ngm:hot-stuff-consensus,
        ngm:nakamoto-consensus,
        ngm:quorum ;
    vc:slug "paxos" ;
    vc:sourceDomain "infrastructure" .

ngm:payment-infrastructure a owl:Class ;
    rdfs:label "Payment Infrastructure"@en ;
    rdfs:comment "Payment infrastructure is the aggregate of networks, protocols, clearing houses, settlement systems, and regulatory frameworks that enable the transfer of monetary value between parties. It spans card networks, interbank messaging (SWIFT, ISO 20022), real-time gross settlement (RTGS) systems, and emerging digital-asset rails including stablecoins and central bank digital currencies. The infrastructure defines latency, finality, cost, and access characteristics that shape the global economy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        ngm:financial-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:payment-channel-network,
        ngm:payment-processor,
        ngm:payment-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdc-infrastructure,
        ngm:lightning-network,
        ngm:stablecoin ;
    vc:slug "payment-infrastructure" ;
    vc:sourceDomain "blockchain" .

ngm:permissionless-trading a owl:Class ;
    rdfs:label "Permissionless Trading"@en ;
    rdfs:comment "Permissionless trading refers to the ability to execute financial trades — buying, selling, or swapping digital assets — without requiring authorisation from a centralised intermediary, gatekeeper, or identity provider. Enabled by on-chain smart contracts and automated market makers (AMMs), permissionless trading removes the account approval, KYC, and whitelist requirements of traditional financial markets, allowing any wallet address to interact directly with liquidity pools. It is a foundational property of decentralised finance (DeFi) protocols."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:asset-trading,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:permissionless-network,
        ngm:token-swapping,
        ngm:uniswap ;
    vc:slug "permissionless-trading" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:persistent-memory a owl:Class ;
    rdfs:label "Persistent Memory"@en ;
    rdfs:comment "Persistent Memory (PMEM) is a class of byte-addressable, non-volatile storage technology that occupies the memory bus and exposes its capacity directly to processor load/store instructions, combining the persistence of storage media with latency approaching that of DRAM. It sits in a new tier of the memory hierarchy between volatile DRAM and block-accessed SSDs, enabling applications to retain state across power cycles without the overhead of traditional I/O system calls."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:enables ngm:machine-learning-infrastructure,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:data-persistence,
        ngm:data-storage,
        ngm:hardware-acceleration ;
    vc:slug "persistent-memory" ;
    vc:sourceDomain "hardware" ;
    vc:supports ngm:inference-engine,
        ngm:vector-database .

ngm:personalized-virtual-experiences a owl:Class ;
    rdfs:label "Personalized Virtual Experiences"@en ;
    rdfs:comment "AI-driven customization of virtual environments, content, and interactions based on individual user preferences, behaviors, and interests, enabling tailored journeys through metaverse spaces with adaptive storytelling, avatars, and content recommendations."@en ;
