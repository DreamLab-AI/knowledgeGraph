# Layer2
blockchain:Layer2 rdf:type owl:Class ;
    rdfs:label "Layer2"@en ;
    rdfs:comment "Secondary protocols built on top of Layer 1 blockchains that process transactions off-chain or in parallel batches, then periodically commit state changes to the main chain, achieving higher throughput (10-10000x), lower fees (90-99.9% reduction), and improved user experience while inheriting base layer security guarantees."@en ;
    skos:prefLabel "Layer2"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:layer2" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:layer2> ;
