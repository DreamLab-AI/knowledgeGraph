    vc:implements ngm:message-passing ;
    vc:isPartOf ngm:high-performance-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cuda,
        ngm:parallel-computing ;
    vc:requires ngm:computing-infrastructure,
        ngm:interconnect ;
    vc:slug "mpi" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:distributed-computing,
        ngm:scalability ;
    vc:uses ngm:interconnect,
        ngm:network-topology .

