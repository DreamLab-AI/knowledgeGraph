ngm:synthetic-data-generation a owl:Class ;
    rdfs:label "Synthetic Data Generation"@en ;
    rdfs:comment "Synthetic Data Generation is the process of algorithmically producing artificial datasets that statistically mirror real-world distributions without exposing sensitive personal information. Techniques include generative adversarial networks, diffusion models, physics simulation, and rule-based sampling, enabling model training where real data is scarce, private, or costly to label."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        ngm:data-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:privacy-law ;
    vc:contrastsWith ngm:data-annotation,
        ngm:data-collection ;
    vc:dependsOn ngm:compute-cluster,
        ngm:machine-learning-discipline-infrastructure ;
    vc:enables ngm:data-augmentation,
        ngm:embodied-ai-simulation,
        ngm:federated-learning,
        ngm:model-training,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation-strategies,
        ngm:deep-generative-model,
        ngm:differential-privacy,
        ngm:transfer-learning ;
    vc:requires ngm:statistical-modelling,
        ngm:training-dataset ;
    vc:slug "synthetic-data-generation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:regulatory-compliance ;
    vc:uses ngm:data-pipeline,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:generative-model,
        ngm:simulation,
        ngm:variational-autoencoder .

ngm:tensor-processing-unit a owl:Class ;
    rdfs:label "Tensor Processing Unit"@en ;
    rdfs:comment "A Tensor Processing Unit (TPU) is Google's custom application-specific integrated circuit (ASIC) designed to accelerate machine learning workloads, particularly tensor operations in deep neural network training and inference. Built around a systolic array architecture for highly efficient matrix multiplication, TPUs prioritise throughput and power efficiency over general-purpose flexibility, and have been instrumental in training large-scale models such as BERT, PaLM, and Gemini."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:systolic-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tensor-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compiler ],
        ngm:inference-hardware ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:edge-computing ;
    vc:contrastsWith ngm:field-programmable-gate-array,
        ngm:graphics-processing-unit,
        ngm:intelligence-processing-unit ;
    vc:dependsOn ngm:bfloat16,
        ngm:google-ai-technology-corporation-cloud ;
    vc:enables ngm:deep-learning,
        ngm:large-language-models,
        ngm:neural-network-inference,
        ngm:transformer ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:high-bandwidth-memory,
