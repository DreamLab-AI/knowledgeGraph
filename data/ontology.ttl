# General Purpose AI Model
artificial-intelligence:GeneralPurposeAIModel rdf:type owl:Class ;
    rdfs:label "General Purpose AI Model"@en ;
    rdfs:comment "An AI model that displays significant generality and is capable of competently performing a wide range of distinct tasks regardless of the way the model is placed on the market."@en ;
    skos:prefLabel "General Purpose AI Model"@en ;
