ngm:optical-sensor-array a owl:Class ;
    rdfs:label "Optical Sensor Array"@en ;
    rdfs:comment "A multi-element optical sensing arrangement comprising spatially distributed photodetectors—including CCD (Charge-Coupled Device) arrays, CMOS (Complementary Metal-Oxide-Semiconductor) image sensors, SPAD (Single-Photon Avalanche Diode) arrays, InGaAs infrared arrays, avalanche photodiode (APD) a..."@en ;
    rdfs:subClassOf ngm:computer-vision-system,
        ngm:imaging-parameters ;
    vc:enables ngm:2-d-li-dar,
        ngm:3-d-li-dar,
        ngm:autonomous-navigation,
        ngm:computer-vision,
        ngm:depth-estimation,
        ngm:depth-sensing,
        ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:human-tracking-and-slam-capture,
        ngm:point-cloud,
        ngm:slam ;
    vc:hasPart ngm:camera,
        ngm:camera-parameters,
        ngm:imaging-parameters,
        ngm:infrared-camera,
        ngm:infrared-led-illuminator,
        ngm:infrared-light-source,
        ngm:infrared-sensor,
        ngm:lens-and-camera-calibration ;
    vc:implements ngm:computer-vision-task,
        ngm:convolutional-neural-network,
        ngm:depth-estimation,
        ngm:feature-extraction,
        ngm:human-tracking-and-slam-capture,
        ngm:image-classification,
        ngm:point-cloud ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:2-d-li-dar,
        ngm:3-d-li-dar,
        ngm:ar-frame,
        ngm:ar-technology,
        ngm:computer-vision-system,
        ngm:depth-sensing,
        ngm:display-hardware,
        ngm:human-tracking-and-slam-capture,
        ngm:lidar,
        ngm:light-field,
        ngm:neural-radiance-field,
        ngm:neural-rendering,
        ngm:slam,
        ngm:spatial-computing ;
    vc:requires ngm:camera-parameters,
        ngm:digital-signal-processing,
        ngm:edge-computing,
        ngm:fpga,
        ngm:infrared-led-illuminator,
        ngm:infrared-light-source,
        ngm:lens-and-camera-calibration ;
