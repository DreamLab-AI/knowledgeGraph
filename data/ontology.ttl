        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:supervised-learning,
        ngm:unsupervised-learning ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:feature-engineering,
        ngm:keras ;
    vc:requires ngm:python ;
    vc:slug "scikit-learn" ;
    vc:sourceDomain "artificial-intelligence" ;
