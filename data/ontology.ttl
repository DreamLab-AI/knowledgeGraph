    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:display-technology,
        ngm:optical-systems,
        ngm:pose-tracking ;
    vc:slug "ar-display-device" ;
    vc:sourceDomain "spatial-computing" .

ngm:archival-standards a owl:Class ;
    rdfs:label "Archival Standards"@en ;
    rdfs:comment "Archival Standards encompass frameworks, specifications, and best practices for long-term digital preservation, including metadata standards (PREMIS, METS), reference models (OAIS), and storage technologies that ensure digital content remains accessible, authentic, and interpretable across techno..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
