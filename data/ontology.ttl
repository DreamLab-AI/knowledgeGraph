ngm:w-3-c-verifiable-credentials-2-0 a owl:Class ;
    rdfs:label "W3C Verifiable Credentials 2.0"@en ;
    rdfs:comment "A W3C specification, version 2.0, defining a data model for verifiable credentials and presentations that can be cryptographically verified. It standardises the structure of digital credentials and claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-verifiable-credentials-2-0" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-verifiable-credentials-data-model a owl:Class ;
    rdfs:label "W3C Verifiable Credentials Data Model"@en ;
    rdfs:comment "The W3C Verifiable Credentials Data Model (VCDM) is a W3C Recommendation that defines a standardised, machine-readable data model for expressing and cryptographically verifying claims about subjects on the Web. It establishes a three-party trust triangle comprising an issuer that creates and signs credentials, a holder that stores and presents them, and a verifier that checks their authenticity and validity. Credentials are expressed as JSON or JSON-LD documents and may be signed using proof mechanisms such as Data Integrity Proofs or JWT/SD-JWT, enabling selective disclosure and privacy-preserving presentation. The model underpins decentralised identity systems and Self-Sovereign Identity architectures by separating identity assertion from centralised identity providers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:blockchain,
        ngm:european-digital-identity-wallet ;
    vc:contrastsWith ngm:centralised-identity-provider,
        ngm:saml ;
    vc:enables ngm:digital-identity-wallet,
        ngm:privacy-preserving-authentication,
        ngm:selective-disclosure,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-status,
        ngm:credential-subject,
        ngm:verifiable-presentation ;
    vc:implements ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitstring-status-list,
        ngm:oauth-2-0,
        ngm:openid-connect,
        ngm:trust-registry ;
    vc:requires ngm:cryptographic-proof,
        ngm:decentralised-identifiers,
        ngm:json-ld ;
    vc:slug "w-3-c-verifiable-credentials-data-model" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3c ;
    vc:uses ngm:digital-signature,
        ngm:json-web-token,
        ngm:linked-data-proofs,
        ngm:selective-disclosure-jwt .

ngm:w-3-c-web-xr a owl:Class ;
    rdfs:label "W3C WebXR"@en ;
    rdfs:comment "W3C WebXR refers to the WebXR work at W3C, which specifies interfaces for virtual reality and augmented reality experiences delivered through the Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
