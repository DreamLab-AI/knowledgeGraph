ngm:gpu-driven-rendering a owl:Class ;
    rdfs:label "Gpu Driven Rendering"@en ;
    rdfs:comment "GPU-driven rendering is an architecture in which the GPU itself determines what to draw and issues its own draw commands, rather than relying on the CPU to traverse the scene and submit each object individually. Using compute shaders for culling and indirect, multi-draw commands, it minimises CPU overhead and draw-call cost, enabling scenes with very large object counts. It builds on compute capability, indirect drawing, and modern graphics APIs to keep the GPU saturated and scalable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader-compiler ],
        ngm:real-time-rendering ;
    vc:dependsOn ngm:gpu ;
    vc:enables ngm:frustum-culling,
        ngm:level-of-detail ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:gpu-rendering ;
    vc:isPartOf ngm:real-time-rendering,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:graphics-pipeline,
        ngm:vulkan ;
    vc:requires ngm:gpu,
        ngm:parallel-computing,
        ngm:shader-compiler ;
    vc:slug "gpu-driven-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:rasterization ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute,
        ngm:graphics-api .

ngm:gpu-programming a owl:Class ;
    rdfs:label "Gpu Programming"@en ;
    rdfs:comment "GPU programming is the practice of writing software that exploits the massively parallel architecture of graphics processing units to accelerate computation across thousands of concurrent threads. It encompasses both graphics pipelines, expressed through shaders, and general-purpose compute expressed through frameworks such as CUDA, OpenCL, and Vulkan compute. Effective GPU programming requires reasoning about memory hierarchies, thread divergence, and data parallelism to achieve high throughput on suitable workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        ngm:high-performance-computing ;
    vc:bridgesTo ngm:fragment-shader,
        ngm:vertex-shader ;
    vc:enables ngm:neural-rendering,
        ngm:ray-tracing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:shader ;
    vc:implements ngm:graphics-pipeline,
        ngm:rasterization ;
    vc:isPartOf ngm:high-performance-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:parallel-computing ;
    vc:requires ngm:memory-management,
        ngm:parallel-computing ;
    vc:slug "gpu-programming" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:machine-learning,
        ngm:rendering ;
    vc:uses ngm:cuda,
        ngm:opencl,
        ngm:simd,
        ngm:vulkan .

