ngm:continuous-delivery a skos:Concept ;
    rdfs:label "Continuous Delivery"@en .

ngm:coordination-mechanisms a owl:Class ;
    rdfs:label "Coordination Mechanisms"@en ;
    rdfs:comment "Coordination Mechanisms are the structural arrangements, protocols, and incentive designs that enable multiple autonomous agents—whether human organisations, software processes, or robotic systems—to align their actions toward shared goals whilst managing conflicts, resource contention, and information asymmetries. They include market-based mechanisms, hierarchical authority structures, consensus protocols, and shared state systems."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:dependsOn ngm:communication-protocol ;
    vc:enables ngm:multi-agent-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:coordination-protocol ;
    vc:slug "coordination-mechanisms" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:orchestration ;
    vc:uses ngm:consensus-mechanism .

ngm:cosine-similarity a owl:Class ;
    rdfs:label "Cosine Similarity"@en ;
    rdfs:comment "Cosine Similarity is a metric that measures the cosine of the angle between two non-zero vectors in an inner product space, yielding a value in [−1, 1] that quantifies directional similarity independently of vector magnitude. It is the dominant similarity measure for comparing high-dimensional sparse and dense vector representations of text, images, and other data in information retrieval and machine learning systems."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:hyperbolic-embedding,
        ngm:knowledge-graph-embedding ;
    vc:contrastsWith ngm:cross-encoder-reranking,
        ngm:euclidean-distance,
        ngm:jaccard-similarity ;
    vc:enables ngm:document-clustering,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:information-retrieval,
        ngm:nearest-neighbour-search ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embedding-search,
        ngm:matryoshka-representation-learning,
        ngm:tf-idf,
        ngm:vector-similarity-measure ;
    vc:requires ngm:inner-product,
        ngm:vector-space-model ;
    vc:slug "cosine-similarity" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:approximate-nearest-neighbour,
        ngm:bi-encoder,
        ngm:vector-database ;
    vc:uses ngm:dot-product,
        ngm:embedding,
        ngm:l2-normalisation .

ngm:cosmos a owl:Class ;
    rdfs:label "Cosmos"@en ;
    rdfs:comment "Cosmos is an ecosystem of sovereign, application-specific blockchains that interoperate through the Inter-Blockchain Communication (IBC) protocol, coordinated by a central hub (the Cosmos Hub, secured by the ATOM staking token) and constructed using the Cosmos SDK, a modular Go framework for building proof-of-stake chains. Each chain in the ecosystem runs the CometBFT (formerly Tendermint BFT) consensus engine, which provides instant deterministic finality and enables IBC light-client proofs across trust boundaries without centralised bridges. The architecture decouples application logic from consensus, permitting developers to optimise validator sets, fee markets, and governance parameters independently while participating in a shared interoperability fabric often described as the Internet of Blockchains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cosmos-sdk ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tendermint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cosmos-ibc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:blockchain-network ;
    vc:bridgesTo ngm:data-availability,
        ngm:modular-blockchain ;
    vc:contrastsWith ngm:ethereum,
        ngm:layer-2-rollup,
        ngm:polkadot ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability,
        ngm:decentralised-finance,
        ngm:interchain-accounts ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cosmos-hub,
        ngm:cosmos-ibc,
        ngm:cosmos-sdk,
        ngm:interchain-security ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:application-specific-blockchain,
        ngm:distributed-ledger-technology,
        ngm:liquid-staking ;
    vc:requires ngm:proof-of-stake,
        ngm:tendermint,
        ngm:validator-node ;
    vc:slug "cosmos" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:deterministic-finality,
        ngm:light-client,
        ngm:on-chain-governance,
        ngm:tendermint-consensus .

ngm:cost-function a owl:Class ;
    rdfs:label "Cost Function"@en ;
    rdfs:comment "A cost function is a scalar-valued mathematical function that maps a model's parameters or a system's state to a real number representing the magnitude of error, resource expenditure, or divergence from a desired outcome. In supervised machine learning, the cost function (also called a loss function) measures the aggregate discrepancy between predicted and ground-truth outputs across a training set, providing the objective that optimisation algorithms such as gradient descent minimise. In control theory and robotics, cost functions encode trajectory quality criteria including path length, energy consumption, and collision risk, enabling optimal control policies via formulations such as LQR and model predictive control. The design of the cost function is one of the most consequential decisions in any learning or optimisation system, as misspecified objectives lead to reward hacking, degenerate solutions, or physically unrealisable behaviours."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regularisation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:inverse-reinforcement-learning,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:reward-function,
        ngm:utility-function ;
    vc:dependsOn ngm:loss-landscape,
        ngm:parametric-model ;
    vc:enables ngm:gradient-descent,
        ngm:model-training,
        ngm:motion-planning,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:penalty-term,
        ngm:regularisation ;
    vc:implements ngm:bayesian-inference,
        ngm:maximum-likelihood-estimation ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:convex-optimisation,
        ngm:hyperparameter-tuning,
        ngm:neural-network,
        ngm:overfitting ;
    vc:requires ngm:differentiability,
        ngm:training-data ;
    vc:slug "cost-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:automatic-differentiation,
        ngm:backpropagation,
        ngm:reinforcement-learning .

ngm:creative-ai a owl:Class ;
    rdfs:label "Creative AI"@en ;
    rdfs:comment "Creative AI refers to artificial intelligence systems designed to generate, augment, or evaluate creative artefacts — including images, music, text, video, and interactive experiences — by learning latent representations of aesthetic structure from large corpora of human-produced works. Drawing on generative architectures such as diffusion models, large language models, transformers, and generative adversarial networks, these systems can synthesise novel content that extends or stylistically mimics human creative practice. They are deployed across professional creative pipelines in entertainment, advertising, game development, and design, while simultaneously raising contested questions of authorship, copyright, and economic disruption for human creators. Creative AI represents the convergence of machine learning research with aesthetic domains historically regarded as uniquely human, positioning it as both a technical milestone and a socio-cultural inflection point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twins,
        ngm:metaverse ;
    vc:contrastsWith ngm:discriminative-ai,
        ngm:rule-based-systems ;
    vc:enables ngm:content-creation,
        ngm:digital-content-creation,
        ngm:image-generation,
        ngm:music-generation,
        ngm:procedural-content-generation,
        ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-application,
        ngm:ai-art-categorization,
        ngm:creative-software,
        ngm:human-ai-collaboration,
        ngm:intellectual-property ;
    vc:requires ngm:deep-learning,
        ngm:training-data ;
    vc:slug "creative-ai" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:game-development ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:large-language-models,
        ngm:neural-style-transfer,
        ngm:transformer,
        ngm:variational-autoencoder .

ngm:cryptographic-signing a owl:Class ;
    rdfs:label "Cryptographic Signing"@en ;
    rdfs:comment "Cryptographic signing is the process of producing a verifiable proof of authorship and integrity over a message or document using a private key, such that anyone holding the corresponding public key can confirm the signature without being able to forge it. It underpins authentication, non-repudiation, software-supply-chain integrity, and blockchain transaction authorisation. Signing schemes include RSA, ECDSA, EdDSA, and Schnorr, each defining how a hash of the message is transformed under the signer's secret key into a compact, publicly verifiable signature."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:key-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol ;
    vc:slug "cryptographic-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:knowledge-graph-publication-classifier-key-cryptography .

ngm:curve-finance a owl:Class ;
    rdfs:label "Curve Finance"@en ;
    rdfs:comment "Curve Finance is a decentralised exchange protocol operating across Ethereum and multiple EVM-compatible chains, specialising in low-slippage swaps between assets expected to maintain near-parity in value, such as stablecoins and liquid staking tokens. It employs a hybrid invariant automated market maker that blends constant-sum and constant-product behaviour, concentrating liquidity near the peg to dramatically reduce trading costs for correlated assets. The protocol's CRV governance token is distributed to liquidity providers and can be locked in a vote-escrow mechanism (veCRV) that grants voting power over pool incentive allocation, creating a flywheel dynamic known as the Curve Wars. Curve v2 extended the model to volatile asset pairs using a price-repegging invariant, broadening the protocol's scope from stablecoin-only pools to general concentrated-liquidity trading."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:game-theory,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:balancer,
        ngm:centralised-exchange,
        ngm:uniswap ;
    vc:dependsOn ngm:evm-compatible-blockchain,
        ngm:oracle ;
    vc:enables ngm:flash-loan,
        ngm:stablecoin-swap,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:curve-dao-token,
        ngm:liquidity-pool,
        ngm:vote-escrow-mechanism ;
    vc:implements ngm:automated-market-maker,
        ngm:concentrated-liquidity ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convex-finance,
        ngm:defi-composability,
        ngm:impermanent-loss,
        ngm:token-incentive-design ;
    vc:requires ngm:ethereum,
        ngm:smart-contract,
        ngm:stablecoin ;
    vc:slug "curve-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:decentralised-autonomous-organisation,
        ngm:governance-token,
        ngm:liquidity-mining .

ngm:customer-data-platform a owl:Class ;
    rdfs:label "Customer Data Platform"@en ;
    rdfs:comment "A Customer Data Platform (CDP) is a packaged software system that ingests first-party customer data from disparate online and offline sources, resolves fragmented identifiers into persistent, unified customer profiles, and exposes those profiles via APIs to downstream marketing, analytics, and personalisation systems. Unlike data warehouses or CRM systems, a CDP is marketer-managed, real-time capable, and purpose-built for identity resolution and audience activation. CDPs enforce consent and privacy preferences at the profile level, making them a key architectural component for compliant, data-driven customer engagement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-resolution ],
        ngm:data-management ;
    vc:bridgesTo ngm:machine-learning,
        ngm:predictive-analytics ;
    vc:contrastsWith ngm:customer-relationship-management,
        ngm:data-management-platform,
        ngm:data-warehouse ;
    vc:enables ngm:audience-segmentation,
        ngm:customer-journey-analytics,
        ngm:personalisation,
        ngm:real-time-marketing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audience-builder,
        ngm:data-ingestion-pipeline,
        ngm:unified-customer-profile ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:general-data-protection-regulation,
        ngm:master-data-management,
        ngm:privacy ;
    vc:requires ngm:consent-management,
        ngm:data-governance,
        ngm:data-integration,
        ngm:identity-resolution ;
    vc:slug "customer-data-platform" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:customer-data-platform-institute ;
    vc:uses ngm:api-gateway,
        ngm:event-streaming,
        ngm:extract-transform-load .

ngm:data-augmentation-strategies a owl:Class ;
    rdfs:label "Data Augmentation Strategies"@en ;
    rdfs:comment "Techniques that create modified versions of training examples to increase dataset diversity and model robustness. Data augmentation strategies apply transformations that preserve label semantics whilst introducing variation, improving generalisation and reducing overfitting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:machine-learning-discipline ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline-pipeline ;
    vc:requires ngm:training-data ;
    vc:slug "data-augmentation-strategies" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:overfitting ;
    vc:uses ngm:generative-ai .

ngm:data-poisoning a owl:Class ;
    rdfs:label "Data Poisoning"@en ;
    rdfs:comment "A training-time adversarial attack where malicious actors inject, modify, or manipulate training data to compromise model integrity, causing targeted misclassifications, backdoor triggers, or general performance degradation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
