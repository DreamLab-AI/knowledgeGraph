ngm:pulse-code-modulation a owl:Class ;
    rdfs:comment "Pulse-code modulation (PCM) is a method for digitally representing sampled analogue signals by periodically measuring amplitude and quantising each sample to a fixed number of bits. It is the baseline uncompressed digital audio format underlying most audio signal processing pipelines and audio systems, from which compressed codecs are derived. Its two key parameters, sample rate and bit depth, jointly determine the fidelity and file size of the represented signal."@en ;
    rdfs:label "Pulse-Code Modulation"@en ;
    rdfs:subClassOf ngm:audio-signal-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
