    vc:requires ngm:kinematics-model ;
    vc:slug "task-space-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:end-effector ;
    vc:supports ngm:motion-planning ;
    vc:uses ngm:inverse-kinematics ;
    vc:uses ngm:jacobian-matrix .
