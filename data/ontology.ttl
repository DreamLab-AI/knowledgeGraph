        ngm:training ;
    vc:slug "technology-adoption" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:telecommunications a owl:Class ;
    rdfs:label "Telecommunications"@en ;
    rdfs:comment "Telecommunications is the sector and technical discipline concerned with the transmission of information — voice, data, and video — across distances through electronic, optical, or electromagnetic means, encompassing the physical infrastructure, protocols, standards, and regulatory frameworks that underpin global connectivity. It includes mobile and fixed-line networks, satellite systems, fibre optic backbones, and the software-defined and virtualised network functions that increasingly replace dedicated hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radio-access-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-slicing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:5-g-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-function-virtualization ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:postal-communications ;
    vc:dependsOn ngm:power-infrastructure,
        ngm:semiconductor-technology ;
    vc:enables ngm:edge-computing,
        ngm:internet-of-things,
        ngm:mobile-broadband ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:5-g-network,
        ngm:network-function-virtualization,
        ngm:network-slicing,
        ngm:radio-access-network,
        ngm:satellite-communications ;
    vc:implements ngm:software-defined-networking ;
    vc:isPartOf ngm:critical-national-infrastructure ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:network-protocol,
        ngm:telecommunications-infrastructure ;
    vc:requires ngm:spectrum-management,
        ngm:telecommunications-regulation ;
    vc:slug "telecommunications" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-g-p-p,
        ngm:e-t-s-i,
        ngm:international-telecommunication-union ;
    vc:supports ngm:cloud-computing,
