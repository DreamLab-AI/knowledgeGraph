        ngm:proprietary-graphics-api ;
    vc:enables ngm:cross-platform-rendering,
        ngm:gpu-compute,
        ngm:graphics-api,
        ngm:hardware-abstraction-layer,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gltf,
        ngm:nnef,
        ngm:opencl,
        ngm:opengl,
        ngm:openxr,
        ngm:spir-v,
