ngm:bilingual-rag-hallucination-mitigation-framework a owl:Class ;
    rdfs:label "Bilingual RAG Hallucination Mitigation Framework"@en ;
    rdfs:comment "Jing is a multi-agent AI framework designed to minimise hallucination in Chinese-English bilingual retrieval-augmented generation (RAG) pipelines, specifically applied to emotional-support chatbots for end-of-life counselling and palliative care. The system combines multiple large language models with open-source text-to-speech engines and real-time 3D avatars to deliver culturally sensitive, affectively aware conversational companions, initially targeting Japanese VR screen deployment contexts. Its multi-agent architecture distributes validation, retrieval, and generation tasks across specialised model instances to improve factual grounding and reduce hallucinated responses in high-stakes care settings."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-avatar,
        ngm:emotional-intelligence,
        ngm:healthcare-ai ;
    vc:slug "bilingual-rag-hallucination-mitigation-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:virtual-reality-applications ;
    vc:uses ngm:large-language-models,
        ngm:multi-agent-systems,
        ngm:retrieval-augmented-generation,
        ngm:text-to-speech .

ngm:bitcoin-proof-of-work-protocol-fungible-token-protocols a owl:Class ;
    rdfs:label "Bitcoin Fungible Token Protocols"@en ;
    rdfs:comment "Runes and Glyphs refers to two complementary Bitcoin token protocols: Runes, which encodes fungible token balances directly in Bitcoin transaction outputs using OP_RETURN data, and Glyphs, a related protocol developed by Melvin Carvalho that encodes token metadata as on-chain inscriptions compatible with the Ordinals framework. Together they extend Bitcoin's base layer with native fungible asset issuance without requiring a separate blockchain, enabling DAOs, project tokens, and programmable digital objects on Bitcoin testnet and mainnet."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:asset-tokenization,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation ;
    vc:slug "bitcoin-fungible-token-protocols" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-objects,
        ngm:nft .

