    vc:enables ngm:cross-border-payments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin ;
    vc:slug "ark-protocol" ;
    vc:sourceDomain "metaverse" .

ngm:arpana a owl:Class ;
    rdfs:label "arpana"@en ;
    rdfs:comment "A UK-focused jurisdictional practice framework for integrating crime scene reconstruction with court proceedings, combining forensic evidence management, chain-of-custody protocols, and digital evidence presentation standards to support admissible expert testimony."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
