# Dijkstra Algorithm
robotics:DijkstraAlgorithm rdf:type owl:Class ;
    rdfs:subClassOf robotics:RB1016pathplanning ;
    rdfs:subClassOf robotics:GraphSearch ;
    rdfs:label "Dijkstra Algorithm"@en ;
    rdfs:comment "A graph search algorithm that finds the shortest path from a source node to all other nodes in a weighted graph with non-negative edge weights. It systematically explores nodes in order of increasing distance from the source, guaranteeing optimal solutions."@en ;
    skos:prefLabel "Dijkstra Algorithm"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:dijkstra-algorithm" ;
