    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-25059,
        ngm:nist-ai-rmf ;
    vc:supports ngm:accuracy,
        ngm:f1-score,
        ngm:precision,
        ngm:recall,
        ngm:sensitivity,
        ngm:specificity ;
    vc:uses ngm:cross-validation,
        ngm:supervised-learning .

