ngm:deep-reinforcement-learning a owl:Class ;
    rdfs:comment "Deep Reinforcement Learning (DRL) is a machine learning paradigm that combines deep neural networks with reinforcement learning, enabling agents to learn optimal policies for sequential decision-making tasks by interacting with an environment, receiving scalar reward signals, and updating neural network parameters through gradient-based optimisation. Grounded in the Markov Decision Process framework, DRL applies the Bellman equation recursively to approximate value functions or directly optimise policies using methods such as DQN, PPO, SAC, and MuZero, achieving superhuman performance in games, robotics control, chip design, and language model alignment."@en ;
    rdfs:label "Deep Reinforcement Learning"@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    rdfs:subClassOf ngm:deep-learning ;
    rdfs:subClassOf ngm:reinforcement-learning ;
