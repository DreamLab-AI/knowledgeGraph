    vc:slug "investor-disclosure" ;
    vc:sourceDomain "governance" .

ngm:invoke-ai a owl:Class ;
    rdfs:label "InvokeAI"@en ;
    rdfs:comment "InvokeAI is an open-source, locally-deployed application and toolkit for running latent diffusion models — principally Stable Diffusion and its derivatives — via a browser-based canvas interface, a node-based workflow editor, and a Python API. It provides professional-grade image synthesis capabilities including text-to-image, image-to-image, inpainting, outpainting, and ControlNet-guided generation without reliance on cloud-hosted services. The platform is designed for creative professionals and researchers who require reproducible, privacy-preserving, and customisable generative image workflows on consumer-grade GPU hardware. Its modular architecture supports community fine-tuned model variants, LoRA adapters, and textual inversion embeddings, making it a central hub in the open-source generative image ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:node-based-editor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stable-diffusion-image-model ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:creative-tools,
        ngm:digital-content-creation ;
    vc:contrastsWith ngm:automatic1111,
        ngm:midjourney-text-to-image-service ;
    vc:enables ngm:image-to-image,
        ngm:inference,
        ngm:inpainting,
        ngm:outpainting,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:node-based-editor ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:image-generation,
        ngm:latent-diffusion,
        ngm:open-source-ai,
        ngm:prompt-engineering ;
    vc:requires ngm:gpu-compute,
        ngm:python-runtime,
        ngm:stable-diffusion-image-model ;
    vc:slug "invoke-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:control-net,
        ngm:diffusion-model,
        ngm:lora-adapter,
        ngm:text-encoder,
        ngm:textual-inversion .

ngm:io-t-integration a owl:Class ;
    rdfs:label "IoT Integration"@en ;
    rdfs:comment "IoT integration is the connection of networked physical sensors and actuators with software systems so that real-world telemetry flows into analytics, control, and decision platforms. It encompasses device connectivity, protocol gateways, data ingestion, and the synchronisation of physical state with digital models. It is the prerequisite for digital twins, real-time monitoring, and logistics optimisation that depend on live sensor data."@en ;
