        ngm:transport-layer-security ;
    vc:requires ngm:mathematical-hardness-assumption,
        ngm:private-key-management ;
    vc:slug "asymmetric-encryption" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication,
        ngm:confidentiality,
        ngm:information-security ;
    vc:uses ngm:hash-function,
        ngm:key-derivation-function,
        ngm:random-number-generator .

ngm:audit a owl:Class ;
    rdfs:label "Audit"@en ;
    rdfs:comment "A systematic, independent examination of records, systems, processes, or controls carried out by a qualified party to assess their accuracy, completeness, and conformance with applicable standards, regulations, or policies. Audits generate structured, documented evidence that supports accountability, risk management, and informed decision-making by management, stakeholders, and regulators. The discipline spans financial, operational, information-security, algorithmic, and sustainability domains, each governed by domain-specific professional standards and methodologies. Audit outputs — opinions, findings, and recommendations — are foundational instruments of organisational governance and public trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-log ],
        ngm:accountability-mechanism ;
    vc:bridgesTo ngm:ai-governance,
        ngm:algorithmic-auditing,
        ngm:smart-contract-audit ;
    vc:contrastsWith ngm:inspection,
        ngm:monitoring,
        ngm:review ;
    vc:dependsOn ngm:internal-controls,
        ngm:risk-assessment ;
    vc:enables ngm:accountability,
        ngm:compliance,
        ngm:regulatory-reporting,
        ngm:transparency,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audit-finding,
        ngm:audit-log,
        ngm:audit-mechanism,
        ngm:audit-opinion,
        ngm:audit-report,
        ngm:audit-trail ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:fraud-detection,
        ngm:zero-trust ;
    vc:requires ngm:documentation,
        ngm:evidence,
        ngm:independence,
        ngm:professional-judgement ;
    vc:slug "audit" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:cobit,
        ngm:international-standards-on-auditing,
        ngm:iso-iec-27001,
        ngm:soc-2 ;
    vc:supports ngm:corporate-governance,
        ngm:esg-reporting,
        ngm:governance,
        ngm:risk-management .

