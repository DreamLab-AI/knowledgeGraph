        ngm:service-robot,
        ngm:wearable-computing-platform ;
    vc:requires ngm:rb-0088-iso-13482-compliance,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0019-exoskeleton-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:uses ngm:rb-0056-impedance-control,
