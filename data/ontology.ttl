    vc:sourceDomain "distributed-collaboration" .

ngm:ai-evaluation a owl:Class ;
    rdfs:label "AI Evaluation"@en ;
    rdfs:comment "AI Evaluation is the systematic, multi-dimensional measurement of AI model capabilities, reliability, safety, alignment, and societal impact using benchmarks, held-out task suites, human preference judgments, automated graders, and adversarial probing. It encompasses the full lifecycle of rigorous assessment from pre-deployment capability elicitation through post-deployment monitoring, producing quantitative metrics and qualitative findings that guide model selection, release decisions, regulatory compliance, and ongoing risk assessment. Credible evaluation must guard against benchmark contamination, distribution shift, Goodhart pressures, and over-optimisation toward narrow scores, while ensuring elicitation methods are sufficient to reveal the true capability ceiling of the system under test."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:safety-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:evaluation-benchmarks-and-leaderboards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:evaluation-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:red-teaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:capability-elicitation ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:contrastsWith ngm:benchmark-contamination,
        ngm:benchmark-saturation ;
    vc:enables ngm:alignment-evaluation,
        ngm:model-card,
        ngm:scalable-oversight ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:capability-elicitation,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:evaluation-metric,
        ngm:llm-as-judge,
        ngm:red-teaming,
        ngm:safety-evaluation ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:ai-benchmark-epistemological-critique,
        ngm:ai-ethics,
        ngm:ai-safety,
        ngm:bias,
        ngm:large-language-models ;
    vc:requires ngm:calibration,
        ngm:held-out-test-set,
        ngm:human-oracle ;
    vc:slug "ai-evaluation" ;
    vc:sourceDomain "ai" .

ngm:ai-generated-content-disclosure a owl:Class ;
    rdfs:label "AI-Generated Content Disclosure"@en ;
    rdfs:comment "Mandatory transparency requirement specifying that content created wholly or partially by AI systems must be explicitly labeled with origin metadata for user awareness and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-watermarking ],
