ngm:carbon-offset-certificate a owl:Class ;
    rdfs:label "Carbon Offset Certificate"@en ;
    rdfs:comment "A verified document representing the reduction or removal of one metric ton of CO2 equivalent emissions, issued by recognized standards bodies after independent validation that confirms the underlying project's additionality, permanence, and measurability."@en ;
    rdfs:subClassOf ngm:environmental-certificate ;
    vc:enables ngm:carbon-neutrality,
        ngm:climate-investment,
        ngm:emissions-compensation ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:project-verification,
        ngm:registry-issuance,
        ngm:third-party-validation ;
    vc:slug "carbon-offset-certificate" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-offset-trading a owl:Class ;
    rdfs:label "Carbon Offset Trading"@en ;
    rdfs:comment "The buying and selling of verified carbon credits on voluntary and compliance markets through exchanges and over-the-counter transactions, enabling price discovery, liquidity provision, and efficient allocation of climate finance to emission reduction projects."@en ;
