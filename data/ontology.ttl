        ngm:symbolic-ai ;
    vc:dependsOn ngm:continual-learning,
        ngm:control-theory,
        ngm:deep-learning ;
    vc:enables ngm:adaptive-control,
        ngm:agentic-ai,
        ngm:autonomous-navigation,
        ngm:embodied-ai,
        ngm:robotic-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:hierarchical-reinforcement-learning,
        ngm:policy-gradient-methods,
        ngm:reinforcement-learning,
        ngm:temporal-difference-learning ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:adaptive-learning,
        ngm:agent-based-models,
        ngm:cognitive-science,
        ngm:cybernetics,
        ngm:multi-agent-systems,
        ngm:swarm-intelligence ;
    vc:requires ngm:exploration-exploitation-tradeoff,
        ngm:feedback-loop,
        ngm:markov-decision-process,
        ngm:simulation-environment ;
    vc:slug "adaptive-behaviour" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-reinforcement-learning,
        ngm:neural-network,
        ngm:policy-optimisation,
        ngm:reward-signal,
        ngm:world-model .

ngm:adaptive-bitrate-streaming a owl:Class ;
    rdfs:label "Adaptive Bitrate Streaming"@en ;
    rdfs:comment "Adaptive bitrate streaming (ABR) is a media delivery technique that encodes content at multiple quality levels and dynamically switches between them in response to measured network throughput and client buffer state. The player requests short segments at the highest sustainable bitrate, smoothing playback over variable connections. It underpins modern over-the-top video via protocols such as HLS and MPEG-DASH delivered over HTTP and content delivery networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-compression ],
        ngm:video-streaming ;
    vc:contrastsWith ngm:lossless-compression ;
    vc:dependsOn ngm:content-delivery-network ;
    vc:enables ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:codec ;
    vc:implements ngm:video-compression ;
    vc:isPartOf ngm:video-streaming ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:lossy-compression,
        ngm:mpeg ;
    vc:requires ngm:data-compression ;
    vc:slug "adaptive-bitrate-streaming" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:network-protocol ;
    vc:uses ngm:content-delivery-network,
        ngm:video-compression .

ngm:agent-loop a skos:Concept ;
    rdfs:label "Agent Loop"@en .

ngm:agent2-agent-protocol a owl:Class ;
    rdfs:label "Agent2Agent Protocol"@en ;
    rdfs:comment "Agent2Agent Protocol (A2A) is an open specification developed by Google and partner organisations that enables heterogeneous AI agents to discover, communicate, and collaborate across organisational and platform boundaries. It defines a standardised messaging envelope, capability advertisement mechanism, and task-delegation schema so that agents built on different frameworks — such as LangChain, CrewAI, or custom enterprise systems — can interoperate without bespoke integration code. The protocol operates over HTTPS with JSON-RPC 2.0 and supports both synchronous request-response and asynchronous streaming via Server-Sent Events. Agent capability cards, analogous to service discovery manifests, allow an agent to advertise its skills so that orchestrating agents can route work appropriately."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:bridgesTo ngm:interoperability-protocol ;
    vc:enables ngm:agentic-workflow,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:multi-agent-systems,
        ngm:server-sent-events ;
    vc:slug "agent2-agent-protocol" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:model-context-protocol,
        ngm:rest-api .

ngm:agricultural-robotics a owl:Class ;
    rdfs:label "Agricultural Robotics"@en ;
    rdfs:comment "Agricultural robotics is the engineering discipline concerned with the design, deployment, and operation of autonomous and semi-autonomous robotic systems applied to crop and livestock farming tasks, including soil preparation, precision planting, selective harvesting, agrochemical application, irrigation management, and herd monitoring. These systems integrate computer vision, machine learning, GNSS positioning, and mechatronic manipulation to function reliably in unstructured outdoor environments subject to variable terrain, lighting, weather, and biological variability. The field is a primary enabler of precision agriculture, supporting reductions in agrochemical inputs, labour dependency, and resource waste while maintaining or increasing yields. Commercial deployment spans ground-based field robots, unmanned aerial vehicles, and autonomous underwater and amphibious systems for aquaculture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mobile-robot-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        ngm:autonomous-robot ;
    vc:bridgesTo ngm:data-analytics,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:industrial-robotics ;
    vc:dependsOn ngm:deep-learning,
        ngm:edge-computing ;
    vc:enables ngm:precision-agriculture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:computer-vision-system,
        ngm:end-effector,
        ngm:mobile-robot-platform ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:internet-of-things,
        ngm:remote-sensing,
        ngm:swarm-robotics ;
    vc:requires ngm:autonomous-navigation,
        ngm:object-detection,
        ngm:path-planning,
        ngm:sensor-fusion ;
    vc:slug "agricultural-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:lidar,
        ngm:machine-learning,
        ngm:robotic-arm,
        ngm:unmanned-aerial-vehicle .

ngm:ai-accelerator a owl:Class ;
    rdfs:label "AI Accelerator"@en ;
    rdfs:comment "An AI accelerator is a class of specialised hardware designed to speed up machine learning workloads, particularly the dense linear algebra of neural network training and inference. Common forms include GPUs, tensor processing units, neural processing units, and custom application-specific integrated circuits that exploit massive parallelism, reduced-precision arithmetic, and high-bandwidth memory. By offloading matrix and tensor operations from general-purpose CPUs, AI accelerators deliver order-of-magnitude gains in throughput and energy efficiency for deep learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-center ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:systolic-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:hardware-accelerator ;
    vc:bridgesTo ngm:compute-infrastructure,
        ngm:machine-learning ;
    vc:enables ngm:deep-learning,
        ngm:distributed-training,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:high-bandwidth-memory,
        ngm:systolic-array ;
    vc:isPartOf ngm:compute-infrastructure,
        ngm:gpu-cluster ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:nvidia-corporation,
        ngm:nvlink,
        ngm:tpu ;
    vc:requires ngm:data-center ;
    vc:slug "ai-accelerator" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing ;
    vc:uses ngm:matrix-multiplication .

ngm:ai-documentation-standards a owl:Class ;
    rdfs:label "AI Documentation Standards"@en ;
    rdfs:comment "AI Documentation Standards are structured frameworks and templates for comprehensively documenting AI systems, datasets, and models to ensure transparency, accountability, reproducibility, and informed stakeholder decision-making throughout the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-model-card ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
