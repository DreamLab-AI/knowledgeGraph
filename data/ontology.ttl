        ngm:gaussian-distribution,
        ngm:jacobian-matrix,
        ngm:state-estimation ;
    vc:slug "extended-kalman-filter" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-model,
        ngm:observation-model .

ngm:extreme-programming a owl:Class ;
    rdfs:label "Extreme Programming"@en ;
    rdfs:comment "Extreme Programming (XP) is an agile software-development methodology that emphasises short iterations, continuous feedback, and engineering discipline to deliver high-quality software responsive to changing requirements. Its core practices include test-driven development, pair programming, continuous integration, collective code ownership, and frequent small releases. XP treats good practices to an 'extreme' degree, for example applying continuous code review through constant pairing."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:remote-pair-programming,
