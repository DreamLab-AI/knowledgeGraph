ngm:affective-computing-system a owl:Class ;
    rdfs:label "Affective Computing System"@en ;
    rdfs:comment "An Affective Computing System is a computational architecture that can recognise, interpret, simulate, or respond to human emotional and affective states through the integration of multimodal physiological and behavioural signals with machine learning models. Such systems aim to make human-computer interaction more natural and context-sensitive by treating emotion as a first-class computational variable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:annotated-training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-labelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emotion-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cognitive-feedback-interface ],
        ngm:affective-computing,
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-health,
        ngm:extended-reality,
        ngm:social-robotics ;
    vc:contrastsWith ngm:rational-agent,
        ngm:symbolic-ai ;
    vc:enables ngm:adaptive-interfaces,
        ngm:adaptive-learning,
        ngm:emotion-aware-interaction,
        ngm:emotional-analytics-engine,
        ngm:empathetic-ai,
        ngm:intelligent-tutoring,
        ngm:mental-health-monitoring ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:affective-response-module,
        ngm:cognitive-feedback-interface,
        ngm:emotion-recognition,
        ngm:multimodal-fusion,
        ngm:sensor-fusion ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:cognitive-load,
        ngm:cognitive-science,
        ngm:digital-health,
        ngm:emotional-intelligence,
        ngm:explainable-ai,
        ngm:federated-learning,
        ngm:user-experience-design ;
    vc:requires ngm:annotated-training-data,
        ngm:data-labelling,
        ngm:machine-learning ;
    vc:slug "affective-computing-system" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:behavioral-modeling,
        ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:facial-recognition,
        ngm:natural-language-processing,
        ngm:physiological-signal-processing,
        ngm:speech-recognition,
        ngm:transformer-architecture,
        ngm:wearable-computing .

