    vc:hasPart ngm:haptic-feedback,
        ngm:robotic-arm ;
    vc:isPartOf ngm:medical-robotics,
        ngm:minimally-invasive-surgery ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:patient-safety,
        ngm:surgical-robot ;
    vc:requires ngm:medical-imaging,
        ngm:motion-planning,
        ngm:real-time-control,
        ngm:sensor-fusion ;
    vc:slug "surgical-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-62304 ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:force-torque-sensor,
