    vc:slug "freedom-of-expression" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:data-sovereignty .

ngm:frontier-model-evaluation a owl:Class ;
    rdfs:label "Frontier Model Evaluation"@en ;
    rdfs:comment "Frontier model evaluation is the systematic assessment of the capabilities, limitations, and risks of the most advanced AI systems, including dangerous-capability and safety testing. It uses benchmarks, red-teaming, and threat-model-driven evaluations to inform deployment decisions and regulation. Such evaluation is increasingly required by AI governance regimes before high-capability models are released."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asia-pacific-regulation,
        ngm:frontier-models ;
    vc:slug "frontier-model-evaluation" ;
    vc:sourceDomain "ai" .

ngm:future-of-humanity-institute a owl:Class ;
    rdfs:label "Future of Humanity Institute"@en ;
    rdfs:comment "The Future of Humanity Institute (FHI) was a multidisciplinary research centre at the University of Oxford, founded in 2005 and directed by Nick Bostrom, focused on big-picture questions about humanity's long-term prospects. It produced influential work on existential risk, AI safety, and the governance of transformative technologies. The institute closed in 2024, but its research substantially shaped the fields of AI safety and longtermism."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:existential-risk,
        ngm:singularity ;
    vc:slug "future-of-humanity-institute" ;
    vc:sourceDomain "ai" .

ngm:geographic-distribution a owl:Class ;
    rdfs:label "Geographic Distribution"@en ;
    rdfs:comment "Geographic distribution is the placement of computing resources, data, or services across physically separate locations and regions. In distributed systems it reduces latency for global users, improves fault tolerance against regional outages, and helps satisfy data-residency requirements. It introduces trade-offs around consistency, replication, and inter-region network costs."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-architecture,
        ngm:geospatial-data ;
    vc:slug "geographic-distribution" ;
    vc:sourceDomain "infrastructure" .

ngm:gguf-format a owl:Class ;
    rdfs:label "GGUF Format"@en ;
    rdfs:comment "GGUF (GPT-Generated Unified Format) is a binary file format for storing large language model weights, metadata, and tokenizer data in a single self-contained file optimised for fast loading and local inference. Developed in the llama.cpp ecosystem as a successor to GGML, it supports a range of quantization schemes and embeds the metadata needed to run a model without external configuration. It is the de facto format for running quantized LLMs on consumer hardware."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-optimisation-and-performance,
        ngm:open-generative-ai-tools ;
    vc:slug "gguf-format" ;
    vc:sourceDomain "ai" .

ngm:gnss a owl:Class ;
    rdfs:label "Gnss"@en ;
    rdfs:comment "A Global Navigation Satellite System (GNSS) is a constellation of satellites that broadcast timed signals enabling receivers to compute their absolute position, velocity and time anywhere on Earth. GPS, Galileo, GLONASS and BeiDou are the principal systems, with receivers trilaterating position from signal travel times across multiple satellites. In robotics, GNSS provides global geo-referenced localisation that anchors local sensor-based estimates to an absolute coordinate frame."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gps ],
        ngm:localization ;
    vc:bridgesTo ngm:sensor-fusion ;
    vc:contrastsWith ngm:slam ;
    vc:dependsOn ngm:sensor ;
    vc:enables ngm:autonomous-navigation,
        ngm:localization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:gps ;
    vc:isPartOf ngm:localization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:gps,
        ngm:slam ;
    vc:requires ngm:sensor ;
    vc:slug "gnss" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:path-planning ;
    vc:uses ngm:kalman-filter,
        ngm:sensor .

ngm:google-ai-technology-corporation-cloud a owl:Class ;
    rdfs:label "Google Cloud"@en ;
    rdfs:comment "Google Cloud (formally Google Cloud Platform, GCP) is a suite of public cloud computing services operated by Google LLC, providing infrastructure-as-a-service (IaaS), platform-as-a-service (PaaS), and software-as-a-service (SaaS) offerings spanning compute, storage, networking, data analytics, and artificial intelligence. It is built on the same global infrastructure that powers Google Search, YouTube, and Google Workspace, spanning a worldwide network of data centres connected by Google's private fibre backbone. Google Cloud competes directly with Amazon Web Services and Microsoft Azure as one of the three dominant hyperscale cloud providers, and differentiates through deep integration of AI/ML capabilities via Vertex AI, TPU accelerator hardware, and pre-trained foundation models such as Gemini."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-centre ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-processing-unit ],
        ngm:cloud-platform ;
    vc:bridgesTo ngm:large-language-model,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:amazon-web-services,
        ngm:azure,
        ngm:on-premises-infrastructure ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:virtualisation ;
    vc:enables ngm:data-analytics,
