ngm:blockchain-core a owl:Class ;
    rdfs:label "Blockchain Core"@en ;
    rdfs:comment "Blockchain core denotes the foundational base-layer components of a blockchain system: the consensus protocol, the append-only ledger data structure, the peer-to-peer network, and the validation rules that together produce a shared, tamper-resistant state. It is the substrate on which higher-level constructs such as tokens, wallets, and smart contracts are built. As the trust anchor of a chain, its design dictates the network's security, decentralisation, and throughput."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-wallet,
        ngm:token-economics ;
    vc:slug "blockchain-core" ;
    vc:sourceDomain "blockchain" .

ngm:blockchain-document-trail-infrastructure a owl:Class ;
    rdfs:label "Blockchain Document Trail Infrastructure"@en ;
    rdfs:comment "A concept node representing resource trails related to blockchain exploration tools and Nostr-based document sharing infrastructure. In the NarrativeGoldmine context, blocktrails links to split-screen markdown editing and decentralised document storage via NosDAV and the Nostr protocol."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:blockchain-core-concepts,
        ngm:decentralised-identity ;
    vc:slug "blockchain-document-trail-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-base,
        ngm:web-technology .

ngm:blockchain-process a owl:Class ;
    rdfs:label "Blockchain Process"@en ;
    rdfs:comment "Blockchain Process encompasses the operational workflows and procedural mechanisms that govern blockchain network functioning, including consensus execution, block validation, transaction verification, mempool management, state transitions, and protocol upgrade procedures. These processes collectively maintain network integrity and enable trustless distributed agreement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bc-cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-scalability,
        ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:bc-cryptographic-primitive,
        ngm:consensus-mechanism ;
    vc:slug "blockchain-process" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-network,
        ngm:consensus-protocol .

