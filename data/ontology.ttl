ngm:bounded-rationality a owl:Class ;
    rdfs:label "Bounded Rationality"@en ;
    rdfs:comment "Bounded rationality is the principle that decision-makers are constrained by limited information, finite cognitive resources and time pressure, and therefore seek satisfactory rather than optimal outcomes. It contrasts with the idealised fully rational agent of classical economics and informs models of human and artificial decision behaviour. The concept grounds heuristics, satisficing and resource-rational approaches to reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-asymmetry ],
        [ a owl:Restriction ;
