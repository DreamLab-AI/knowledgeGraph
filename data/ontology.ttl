    rdfs:label "Inverter"@en .
ngm:invertible-neural-network a owl:Class ;
    rdfs:comment "An invertible neural network is a neural network architecture constructed so that its forward mapping has an explicit, tractable inverse, allowing outputs to be mapped back to inputs without approximation. This is achieved through coupling-layer designs that keep the Jacobian easy to compute and invert. Invertible architectures are the structural building block of normalising flows, where exact invertibility and tractable Jacobian determinants are required to compute likelihoods in a change-of-variables formulation."@en ;
    rdfs:label "Invertible Neural Network"@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:normalising-flow ;
    vc:slug "invertible-neural-network" ;
    vc:sourceDomain "machine-learning" .
