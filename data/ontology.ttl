ngm:message-passing a owl:Class ;
    rdfs:label "Message Passing"@en ;
    rdfs:comment "Message passing is a foundational communication paradigm in which processes, objects, or distributed agents interact exclusively by sending and receiving discrete, self-contained messages rather than accessing shared memory. It underlies actor-model concurrency, microservice architectures, and distributed AI agent frameworks, providing loose coupling, location transparency, and inherent support for asynchronous execution. Messages may traverse in-process channels, persistent message queues, or wide-area network transports, and may be delivered synchronously (blocking until acknowledgement) or asynchronously (fire-and-forget). Formal semantics are studied through process calculi such as the pi-calculus and CSP, and the paradigm has grown from Hewitt's 1973 Actor Model into the backbone of modern cloud-native and multi-agent AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:inter-agent-communication,
        ngm:model-context-protocol,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:remote-procedure-call,
        ngm:shared-memory ;
    vc:enables ngm:actor-model,
        ngm:distributed-computing,
        ngm:event-driven-architecture,
        ngm:fault-tolerance,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:message-broker,
        ngm:message-channel,
        ngm:message-queue ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:apache-kafka,
        ngm:process-calculus,
        ngm:protocol-buffer ;
    vc:requires ngm:network-transport,
        ngm:serialisation ;
    vc:slug "message-passing" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:asynchronous-communication,
        ngm:concurrency,
        ngm:distributed-architecture ;
    vc:uses ngm:middleware,
        ngm:publish-subscribe,
        ngm:remote-procedure-call .

ngm:microservices a owl:Class ;
    rdfs:label "Microservices"@en ;
    rdfs:comment "Microservices is an architectural style in which a large application is decomposed into a suite of small, independently deployable services, each responsible for a distinct bounded business capability and communicating through well-defined lightweight APIs or message channels. Each service runs in its own process, manages its own data store, and can be developed, deployed, scaled, and retired independently of other services. The pattern contrasts with monolithic architectures by enabling polyglot development, fine-grained fault isolation, and organisational alignment of teams with service ownership, at the cost of increased operational and distributed-systems complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:serverless-computing ;
