        ngm:depth-estimation,
        ngm:face-recognition,
        ngm:object-detection-and-tracking,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:convolutional-neural-network,
        ngm:scale-invariant-feature-transform ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:image-processing-software,
        ngm:object-detection,
        ngm:optical-flow,
        ngm:stereo-vision ;
    vc:requires ngm:c-plus-plus ;
    vc:slug "open-cv" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:augmented-reality,
        ngm:embedded-vision,
        ngm:perception-system,
        ngm:robot-operating-system ;
    vc:uses ngm:feature-extraction,
        ngm:image-segmentation,
        ngm:numpy,
        ngm:onnx .

