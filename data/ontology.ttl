    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-did-working-group" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-linked-data-platform a owl:Class ;
    rdfs:label "W3C Linked Data Platform"@en ;
    rdfs:comment "The W3C Linked Data Platform defines a set of rules for read-write operations on Linked Data resources using HTTP."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-linked-data-platform" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-owl-2 a owl:Class ;
    rdfs:label "W3C OWL 2"@en ;
    rdfs:comment "W3C OWL 2 is the Web Ontology Language, a knowledge representation language for authoring ontologies that describe classes, properties and individuals on the Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-owl-2" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-rdf-1-1 a owl:Class ;
    rdfs:label "W3C RDF 1.1"@en ;
    rdfs:comment "W3C RDF 1.1 is the Resource Description Framework, a data model for representing information about resources as subject-predicate-object triples on the Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-rdf-1-1" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-sparql-1-1 a owl:Class ;
    rdfs:label "W3C SPARQL 1.1"@en ;
    rdfs:comment "A W3C Recommendation defining SPARQL 1.1, the query language and protocol for retrieving and manipulating data stored in RDF format. It includes query, update and federation features."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-sparql-1-1" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-verifiable-credentials-2-0 a owl:Class ;
    rdfs:label "W3C Verifiable Credentials 2.0"@en ;
    rdfs:comment "A W3C specification, version 2.0, defining a data model for verifiable credentials and presentations that can be cryptographically verified. It standardises the structure of digital credentials and claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-verifiable-credentials-2-0" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-verifiable-credentials-data-model a owl:Class ;
    rdfs:label "W3C Verifiable Credentials Data Model"@en ;
    rdfs:comment "The W3C Verifiable Credentials Data Model specifies a data model for cryptographically verifiable claims exchanged on the Web between issuers, holders and verifiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-verifiable-credentials-data-model" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-web-xr a owl:Class ;
    rdfs:label "W3C WebXR"@en ;
    rdfs:comment "W3C WebXR refers to the WebXR work at W3C, which specifies interfaces for virtual reality and augmented reality experiences delivered through the Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-web-xr" ;
    vc:sourceDomain "standards" .

ngm:w3-c-prov a owl:Class ;
    rdfs:label "W3C PROV"@en ;
    rdfs:comment "W3C PROV is a family of W3C Recommendations that define a domain-agnostic data model and serialisations for representing provenance, the records of entities, activities, and agents involved in producing or influencing a piece of data. Centred on the PROV-DM data model and PROV-O OWL ontology, it enables interoperable description of how artefacts came to be, supporting trust, reproducibility, and auditing. It is widely used in scientific workflows, data catalogues, and metadata management systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:metadata-management ;
    vc:slug "w3-c-prov" ;
    vc:sourceDomain "data" .

ngm:w3-c-web-speech-api a owl:Class ;
    rdfs:label "W3C Web Speech API"@en ;
    rdfs:comment "The W3C Web Speech API is a browser interface specification that exposes speech recognition (speech-to-text) and speech synthesis (text-to-speech) to web applications through standardised JavaScript objects. It lets pages capture spoken input and produce spoken output without bespoke plugins, underpinning voice-driven and accessibility features on the web. Implementation depth and recognition backends vary across browsers, with some delegating recognition to cloud services."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:real-time-translation,
        ngm:speech-and-voice ;
    vc:slug "w3-c-web-speech-api" ;
    vc:sourceDomain "metaverse" .

ngm:warehouse-robotics a owl:Class ;
    rdfs:label "Warehouse Robotics"@en ;
    rdfs:comment "Warehouse robotics is the application of autonomous mobile robots, robotic arms, and coordinated fleets to automate storage, picking, sorting, and transport tasks within fulfilment and distribution centres. Systems integrate navigation, perception, fleet orchestration, and warehouse management software to move goods and people efficiently. It is one of the most commercially mature robotics domains, driven by e-commerce throughput and labour demands."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robotics-platform,
        ngm:topological-map ;
    vc:slug "warehouse-robotics" ;
    vc:sourceDomain "robotics" .

ngm:watermarking-service a owl:Class ;
    rdfs:label "Watermarking Service"@en ;
    rdfs:comment "Digital infrastructure that embeds imperceptible markers into media content to establish provenance, authenticate ownership, detect tampering, and identify AI-generated content, supporting content credentials standards like C2PA for verifiable digital asset tracking."@en ;
    rdfs:subClassOf ngm:content-authentication,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:content-authentication,
        ngm:open-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "watermarking-service" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:content-moderation,
        ngm:digital-rights-management,
        ngm:provenance-tracking ;
    vc:uses ngm:cryptography,
        ngm:signal-processing .

ngm:watermarks a owl:Class ;
    rdfs:label "Watermarks"@en ;
    rdfs:comment "Techniques for embedding imperceptible or visible signals into digital content—such as text, images, audio, or AI-generated outputs—to assert provenance, ownership, or authenticity. AI watermarking approaches include statistical token-distribution biasing (for large language models) and frequency-domain embedding (for images), enabling detection of machine-generated content and supporting intellectual property protection and content provenance verification."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:accountability,
        ngm:data-provenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "watermarks" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:transparency-oecd ;
    vc:uses ngm:cryptography,
        ngm:generative-ai .

ngm:wco-safe-framework a owl:Class ;
    rdfs:label "WCO SAFE Framework"@en ;
    rdfs:comment "The WCO SAFE Framework of Standards is a World Customs Organization instrument that sets out principles and standards to secure and facilitate global supply chains. It establishes customs-to-customs network arrangements, customs-to-business partnerships through Authorised Economic Operator (AEO) programmes, and risk-based advance electronic cargo data exchange. SAFE balances trade facilitation with security against terrorism and illicit trade."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation,
        ngm:standards-body ;
    vc:slug "wco-safe-framework" ;
    vc:sourceDomain "supply-chain" .

ngm:wearable-ai a owl:Class ;
    rdfs:label "Wearable AI"@en ;
    rdfs:comment "Wearable AI refers to body-worn devices that run or stream machine learning to sense context, recognise speech and imagery, and present information, often through glasses, earbuds or wrist devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:spatial-computing-domain ;
    vc:enables ngm:augmented-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:edge-computing ;
    vc:slug "wearable-ai" ;
    vc:sourceDomain "metaverse" .

ngm:web-rtc-w-3-c-specification a owl:Class ;
    rdfs:label "WebRTC W3C Specification"@en ;
    rdfs:comment "A W3C specification defining WebRTC, an API enabling real-time peer-to-peer audio, video and data communication between browsers. It defines the JavaScript interfaces for media and data transport."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "web-rtc-w-3-c-specification" ;
    vc:sourceDomain "standards" .

ngm:web-sockets a owl:Class ;
    rdfs:label "WebSockets"@en ;
    rdfs:comment "WebSockets is a protocol providing full-duplex communication channels over a single TCP connection between a client and a server. It is widely used for real-time web applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        ngm:communication-protocol ;
    vc:enables ngm:network-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:http ;
    vc:slug "web-sockets" ;
    vc:sourceDomain "general" .

ngm:web-xr a owl:Class ;
    rdfs:label "WebXR"@en ;
    rdfs:comment "WebXR is a web standard and API that lets browsers access virtual and augmented reality devices, providing pose tracking, input and rendering hooks for immersive experiences delivered over the web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-standard ],
        ngm:spatial-computing-domain ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:graphics-api,
        ngm:web-standard ;
    vc:slug "web-xr" ;
    vc:sourceDomain "metaverse" .

ngm:webhook a owl:Class ;
    rdfs:label "Webhook"@en ;
    rdfs:comment "A webhook is an event-driven integration mechanism in which a server sends an HTTP request to a pre-registered URL when a specified event occurs, pushing data to consumers instead of requiring them to poll. It enables loosely coupled, near-real-time communication between web services and is a standard pattern for notifications, CI triggers, and payment events. Reliability concerns are addressed through retries, idempotency keys, and signature verification."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:presence-indicator ;
    vc:slug "webhook" ;
    vc:sourceDomain "infrastructure" .

ngm:weights-and-biases a owl:Class ;
    rdfs:label "Weights and Biases"@en ;
    rdfs:comment "Weights & Biases (W&B) is a machine-learning experiment-tracking and MLOps platform that logs metrics, hyperparameters, model checkpoints, datasets, and system telemetry to enable reproducible and comparable training runs. It provides dashboards, artifact versioning, hyperparameter sweeps, and model-registry features that integrate with common training frameworks. W&B is widely adopted for managing and visualising the lifecycle of deep-learning experiments."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:machine-learning ;
    vc:slug "weights-and-biases" ;
    vc:sourceDomain "ai" .

ngm:wgsl a owl:Class ;
    rdfs:label "WGSL"@en ;
    rdfs:comment "WGSL (WebGPU Shading Language) is the shader programming language of the WebGPU API, used to write vertex, fragment, and compute shaders that run on the GPU from web applications. Designed for safety and portability, it maps cleanly onto native backends (Vulkan, Metal, Direct3D) while avoiding the platform-specific behaviours of older shading languages. WGSL is central to high-performance graphics and GPU compute on the modern web."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "wgsl" ;
    vc:sourceDomain "metaverse" .

ngm:who-evm a owl:Class ;
    rdfs:label "WHO EVM"@en ;
    rdfs:comment "WHO EVM (Effective Vaccine Management) is a World Health Organization assessment framework and set of standards for evaluating and improving immunisation supply chains, with particular emphasis on cold-chain integrity, storage, and distribution. It defines criteria and scored indicators across receipt, storage, temperature monitoring, and stock management to ensure vaccine potency from manufacturer to point of use. EVM assessments guide investments in cold-chain equipment and monitoring practice."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:standards-body ;
    vc:slug "who-evm" ;
    vc:sourceDomain "supply-chain" .

ngm:wi-fi a owl:Class ;
    rdfs:label "Wi-Fi"@en ;
    rdfs:comment "Wi-Fi is a family of wireless networking technologies based on the IEEE 802.11 standards that allow devices to connect to a local area network and the internet. It is managed by the Wi-Fi Alliance."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:internet-of-things,
        ngm:network-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "wi-fi" ;
    vc:sourceDomain "general" .

ngm:wireless-hart a owl:Class ;
    rdfs:label "WirelessHART"@en ;
    rdfs:comment "WirelessHART is an open wireless communication standard for industrial process automation, built on the IEEE 802.15.4 physical layer and using time-synchronised, self-organising mesh networking with channel hopping for reliability. It extends the HART field-device protocol to wireless sensor networks in plants, providing deterministic, secure, low-power monitoring and control. Centrally managed by a network manager, it prioritises robustness against interference in harsh RF environments."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ieee-802-15-4,
        ngm:io-t-sensor-network ;
    vc:slug "wireless-hart" ;
    vc:sourceDomain "infrastructure" .

ngm:world-models a owl:Class ;
    rdfs:label "World Models"@en ;
    rdfs:comment "World models are learned internal representations of an environment that predict how it evolves in response to actions. They let an agent plan and reason by simulating outcomes rather than acting directly in the world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:world-model ;
    vc:enables ngm:planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:slug "world-models" ;
    vc:sourceDomain "machine-learning" .

ngm:worldcoin a owl:Class ;
    rdfs:label "Worldcoin"@en ;
    rdfs:comment "A digital identity and cryptocurrency project that uses iris biometrics to issue a unique identifier intended to distinguish individual humans online."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:facial-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-authentication ],
        ngm:digital-identity ;
    vc:enables ngm:sybil-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:biometric-authentication,
        ngm:facial-recognition ;
    vc:slug "worldcoin" ;
    vc:sourceDomain "general" .

ngm:wto-trade-facilitation-agreement a owl:Class ;
    rdfs:label "WTO Trade Facilitation Agreement"@en ;
    rdfs:comment "The WTO Trade Facilitation Agreement (TFA) is a multilateral treaty, in force since 2017, that sets binding measures to expedite the movement, release, and clearance of goods across borders. It mandates simplified customs procedures, advance ruling systems, electronic payment, single-window submission, and cooperation between border agencies. The TFA matters because it reduces trade costs and delays, with provisions tied to the capacity of developing-country members."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation ;
    vc:slug "wto-trade-facilitation-agreement" ;
    vc:sourceDomain "supply-chain" .

ngm:x-509-certificate a owl:Class ;
    rdfs:label "X.509 Certificate"@en ;
    rdfs:comment "A standardised digital certificate format that binds a public key to an identity and is signed by a certificate authority within a public key infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:digital-certificate ;
    vc:enables ngm:authentication,
        ngm:transport-layer-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:slug "x-509-certificate" ;
    vc:sourceDomain "cryptographic" .

ngm:xr-accessibility-standards a owl:Class ;
    rdfs:label "XR Accessibility Standards"@en ;
    rdfs:comment "Guidelines, best practices, and technical specifications for making extended reality experiences accessible to users with disabilities, addressing visual, auditory, motor, cognitive, and vestibular impairments through inclusive design principles and assistive technology compatibility."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:accessibility ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "xr-accessibility-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:xr-framework a owl:Class ;
    rdfs:label "XR Framework"@en ;
    rdfs:comment "An XR Framework is a software architecture or SDK that provides unified runtime support, device abstraction, and application programming interfaces for extended reality experiences spanning augmented, virtual, and mixed reality. Frameworks such as OpenXR standardise access to headsets and input devices, whilst game engine integrations enable developers to target multiple XR platforms from a single codebase."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "xr-framework" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:extended-reality,
        ngm:game-engine .

ngm:zero-knowledge-machine-learning a owl:Class ;
    rdfs:label "Zero-Knowledge Machine Learning"@en ;
    rdfs:comment "Cryptographic techniques enabling verification that a machine learning model executed correctly on specific inputs without revealing model weights, training data, or private inputs. ZKML bridges zero-knowledge proofs and machine learning, allowing on-chain verification of off-chain AI inference with privacy guarantees."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:ai-technique,
        ngm:machine-learning ;
    vc:dependsOn ngm:zero-knowledge-proof ;
    vc:enables ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "zero-knowledge-machine-learning" ;
    vc:sourceDomain "blockchain" .

ngm:2-d-li-dar a owl:Class ;
    rdfs:label "2D LiDAR"@en ;
    rdfs:comment "2D LiDAR is a laser scanning sensor that emits a rotating beam in a single horizontal or vertical plane, producing a planar point cloud used for obstacle detection, proximity sensing, and 2D mapping. It is widely deployed on mobile robots and autonomous guided vehicles where full 3D sensing is unnecessary or cost-prohibitive."@en ;
    rdfs:subClassOf ngm:lidar,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:localization,
        ngm:proximity-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-perception ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-li-dar,
        ngm:laser-scanner,
        ngm:point-cloud,
        ngm:proximity-sensor,
        ngm:slam,
        ngm:ultrasonic-sensor ;
    vc:slug "2-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar-scanning .

ngm:3-d-design a owl:Class ;
    rdfs:label "3D Design"@en ;
    rdfs:comment "3D Design is the creative and technical discipline of conceiving, modelling, and refining three-dimensional digital objects and environments for interactive, immersive, or real-time applications. It encompasses spatial composition, form language, and visual hierarchy adapted for game engines, virtual reality, and metaverse platforms, requiring performance-conscious workflows such as level-of-detail strategies, UV unwrapping, and real-time shader design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:3-d-content-generation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-asset ;
    vc:isPartOf ngm:3-d-content-pipeline,
        ngm:3-d-development ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3-d-modeling,
        ngm:rendering-engine ;
    vc:slug "3-d-design" ;
    vc:sourceDomain "infrastructure" .

ngm:3-d-engine a owl:Class ;
    rdfs:label "3D Engine"@en ;
    rdfs:comment "A 3D engine is software that handles the representation, rendering, and often the physics and animation of three-dimensional scenes. It forms the core of many games and simulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-geometry ],
        ngm:game-engine ;
    vc:enables ngm:3-d-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computational-geometry ;
    vc:slug "3-d-engine" ;
    vc:sourceDomain "general" .

ngm:5-g a owl:Class ;
    rdfs:label "5G"@en ;
    rdfs:comment "5G (Fifth Generation) is the latest generation of mobile cellular network technology, standardised by 3GPP from Release 15 onwards, characterised by peak data rates exceeding 20 Gbps, radio latencies below 1 ms, and support for up to one million connected devices per square kilometre. It introduces three primary use-case families: enhanced mobile broadband (eMBB), ultra-reliable low-latency communications (URLLC), and massive machine-type communications (mMTC). 5G underpins advances in spatial computing, autonomous vehicles, industrial automation, and IoT at scale."@en ;
    rdfs:subClassOf ngm:telecommunications ;
    vc:enables ngm:5-g-connectivity,
        ngm:multi-access-edge-computing,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:5-g-network,
        ngm:internet-of-things,
        ngm:network-function-virtualization ;
    vc:slug "5-g" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp .

ngm:6-g-network-slice a owl:Class ;
    rdfs:label "6G Network Slice"@en ;
    rdfs:comment "Virtual partition of 6G infrastructure guaranteeing specified quality-of-service levels for immersive workloads through isolated resource allocation."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:dynamic-resource-allocation,
        ngm:guaranteed-bandwidth,
        ngm:low-latency-service,
        ngm:workload-isolation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:qo-s-policy,
        ngm:resource-allocation-unit,
        ngm:service-level-agreement,
        ngm:traffic-classifier ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:6-g-network-infrastructure,
        ngm:network-slicing-orchestrator,
        ngm:sdn-controller ;
    vc:slug "6-g-network-slice" ;
    vc:sourceDomain "infrastructure" .

ngm:a2-a-protocol a owl:Class ;
    rdfs:label "A2A Protocol"@en ;
    rdfs:comment "The Agent-to-Agent (A2A) Protocol is an open communication specification, proposed by Google in 2025, that defines how autonomous AI agents discover one another, negotiate capabilities, delegate tasks, and exchange results across heterogeneous agent frameworks and cloud environments. It uses HTTP/REST transport with JSON-structured messages and an Agent Card system for capability advertisement, enabling cross-vendor agent interoperability without requiring shared infrastructure. A2A complements tool-access protocols such as the Model Context Protocol by standardising the agent-to-agent interaction layer."@en ;
    rdfs:subClassOf ngm:agent-communication-protocol ;
    vc:enables ngm:agentic-workflow,
        ngm:inter-agent-communication,
        ngm:multi-agent-orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-to-agent-protocol,
        ngm:model-context-protocol,
        ngm:multi-agent-system ;
    vc:slug "a2-a-protocol" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:agent-frameworks,
        ngm:agentic-ai,
        ngm:function-calling .

ngm:accelerometer a owl:Class ;
    rdfs:label "Accelerometer"@en ;
    rdfs:comment "Accelerometer - A microelectromechanical sensor (MEMS) that detects changes in velocity and gravity along three orthogonal axes, enabling robots to measure Motion, Orientation, and Vibration for real-time feedback control and navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:gesture-recognition,
        ngm:motion-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:inertial-measurement-unit ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:signal-conditioning ;
    vc:slug "accelerometer" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robotics .

ngm:access-control-decisions a owl:Class ;
    rdfs:label "Access Control Decisions"@en ;
    rdfs:comment "Access Control Decisions are the runtime determinations made by a policy engine or decision point as to whether a particular subject—user, process, or device—is permitted to perform a requested action on a protected resource, based on evaluated policies, attributes, and contextual signals. These decisions are the operational output of an access control architecture and are typically produced by a Policy Decision Point (PDP) and enforced by a Policy Enforcement Point (PEP)."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:dependsOn ngm:authentication,
        ngm:identity-management ;
    vc:enables ngm:authorisation,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:policy-enforcement-point,
        ngm:role-based-access-control ;
    vc:slug "access-control-decisions" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:policy-decision-point,
        ngm:policy-engine .

ngm:access-control-module a owl:Class ;
    rdfs:label "Access Control Module"@en ;
    rdfs:comment "An Access Control Module is a self-contained software component that enforces authorization rules governing which principals may invoke which functions or read which resources. In smart-contract systems it is commonly implemented as a reusable mixin defining roles, ownership, and permission checks that other contracts inherit. It centralizes permission logic so that privileged operations such as timelocked upgrades or rights revocation are gated behind verifiable on-chain conditions."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-rights-management-extended,
        ngm:timelock ;
    vc:slug "access-control-module" ;
    vc:sourceDomain "security" .

ngm:access-control-policy a owl:Class ;
    rdfs:label "Access Control Policy"@en ;
    rdfs:comment "An Access Control Policy is a machine-readable specification of the rules that determine which agents may read, write, or append to a given resource. In decentralized web-data systems such as Solid, policies are expressed as RDF documents (e.g. WAC or ACP) attached to resources, granting or denying modes of access to identified WebID principals or groups. The policy is the declarative source of truth that an authorization engine evaluates on each request."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:solid ;
    vc:slug "access-control-policy" ;
    vc:sourceDomain "security" .

ngm:accessibility-tree a owl:Class ;
    rdfs:label "Accessibility Tree"@en ;
    rdfs:comment "The Accessibility Tree is a structured representation of a user interface that exposes each element's role, name, state, and value to assistive technologies and automation agents. Browsers derive it from the DOM, filtering out presentational nodes and computing accessible names so that screen readers and programmatic clients can understand and operate the page. It provides a stable semantic model that AI browser agents use to locate and interact with controls without parsing raw pixels."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents ;
    vc:slug "accessibility-tree" ;
    vc:sourceDomain "ai" .

ngm:accessible-design a owl:Class ;
    rdfs:label "Accessible Design"@en ;
    rdfs:comment "Accessible Design is the practice of creating virtual environments and interactions usable by people with diverse disabilities, incorporating universal design principles from conception through implementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology-integration ],
        ngm:inclusive-design,
        ngm:sc-governance-and-safety,
        ngm:universal-design ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:broader-user-base,
        ngm:inclusive-participation,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:assistive-technology-integration,
        ngm:user-research-with-disabled-participants ;
    vc:slug "accessible-design" ;
    vc:sourceDomain "spatial-computing" .

ngm:adaptive-interfaces a owl:Class ;
    rdfs:label "Adaptive Interfaces"@en ;
    rdfs:comment "Adaptive interfaces are user interface systems that dynamically reconfigure their layout, content, modality, or interaction style in response to the current user's context, behaviour, preferences, or inferred cognitive state. They employ user modelling, machine learning, and context-aware computing to personalise the interaction layer without requiring manual configuration. The goal is to optimise usability, accessibility, and task performance across diverse user populations and situational conditions."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:accessible-experience,
        ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:hyper-personalisation ;
    vc:slug "adaptive-interfaces" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:context-awareness,
        ngm:recommendation-system .

ngm:additive-manufacturing a owl:Class ;
    rdfs:label "Additive Manufacturing"@en ;
    rdfs:comment "Additive manufacturing (AM) is a family of processes that construct three-dimensional objects by depositing, sintering, or photopolymerising material layer by layer from a digital design file, in contrast to subtractive methods that remove material from a solid block. Processes include fused deposition modelling, selective laser sintering, stereolithography, binder jetting, and directed energy deposition, each suited to particular materials and resolution requirements. AM enables on-demand production of complex geometries, personalised products, and distributed manufacturing without the tooling investment of conventional production."@en ;
    rdfs:subClassOf ngm:digital-fabrication ;
    vc:contrastsWith ngm:collaborative-robotics ;
    vc:enables ngm:digital-fabrication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:digital-twin-creation ;
    vc:slug "additive-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cad-software,
        ngm:digital-twin .

ngm:adobe-creative-cloud a owl:Class ;
    rdfs:label "Adobe Creative Cloud"@en ;
    rdfs:comment "Adobe Creative Cloud is a subscription-based software platform operated by Adobe Inc. that delivers a suite of professional creative applications—including Photoshop, Illustrator, Premiere Pro, After Effects, and InDesign—alongside cloud storage, collaboration services, and asset management infrastructure. Launched in 2013 as the successor to Adobe Creative Suite, it transitioned the industry from perpetual licence software to a continuous-update, cloud-connected model. The platform is the dominant industry standard for graphic design, photography, video production, motion graphics, and digital publishing workflows."@en ;
    rdfs:subClassOf ngm:creative-tools ;
    vc:enables ngm:content-creation,
        ngm:content-production-workflow ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-creation,
        ngm:animation-software ;
    vc:slug "adobe-creative-cloud" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:adobe-firefly,
        ngm:cloud-platform .

ngm:aes-gcm a owl:Class ;
    rdfs:label "AES-GCM"@en ;
    rdfs:comment "AES-GCM (Advanced Encryption Standard – Galois/Counter Mode) is an authenticated encryption with associated data (AEAD) cipher mode that combines the AES block cipher operating in Counter Mode with the Galois Message Authentication Code. It provides both confidentiality and data integrity in a single pass, making it the dominant symmetric encryption scheme in modern secure communications."@en ;
    rdfs:subClassOf ngm:symmetric-encryption ;
    vc:enables ngm:end-to-end-encryption,
        ngm:network-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:cryptography ;
    vc:slug "aes-gcm" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:message-authentication-code,
        ngm:nonce .

ngm:agent-layer a owl:Class ;
    rdfs:label "Agent Layer"@en ;
    rdfs:comment "The Agent Layer is the stratum that hosts autonomous entities capable of perceiving, deciding, and acting toward goals. It sits above control and inference strata that supply its capabilities and below coordination and application strata that direct collectives of agents. It contains agent policies, goal representations, memory, and decision loops."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:coordination-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:inference-layer ;
    vc:slug "agent-layer" ;
    vc:sourceDomain "agent" .

ngm:agent2-agent-protocol-google-2025 a owl:Class ;
    rdfs:label "Agent2Agent Protocol (Google 2025)"@en ;
    rdfs:comment "The Agent2Agent Protocol (A2A), released by Google as an open specification in April 2025, is a JSON-RPC over HTTP(S) protocol that enables AI agents to discover one another via standardised agent cards, delegate tasks through a defined task lifecycle, and stream results back to requesting agents, regardless of the underlying model or framework used to implement the agents. It is designed as a complementary peer-to-peer layer alongside Anthropic's Model Context Protocol."@en ;
    rdfs:subClassOf ngm:agent-to-agent-protocol ;
    vc:enables ngm:agentic-workflow,
        ngm:inter-agent-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-communication-protocol,
        ngm:model-context-protocol ;
    vc:slug "agent2-agent-protocol-google-2025" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:message-passing,
        ngm:service-discovery .

ngm:agentic-alliance a owl:Class ;
    rdfs:label "Agentic Alliance"@en ;
    rdfs:comment "An open collaborative initiative advancing decentralised agent frameworks that integrate Nostr relays for communication, Bitcoin Lightning for micropayments, distributed identity, and open data connectors to enable trustless, economically-incentivised multi-agent coordination without central intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agents ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agents,
        ngm:smart-contract ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:distributed-ledger ;
    vc:requires ngm:blockchain ;
    vc:slug "agentic-alliance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:distributed-computing,
        ngm:distributed-identity,
        ngm:nostr-protocol .

ngm:agentic-metaverse-for-global-creatives a owl:Class ;
    rdfs:label "Agentic Metaverse for Global Creatives"@en ;
    rdfs:comment "A conceptual and technical framework for a decentralised, AI-agent-driven metaverse ecosystem enabling global creative collaboration, autonomous task execution, and value exchange. The architecture integrates Nostr for identity and communication, Bitcoin and Lightning Network for payments, and USD/Omniverse for 3D asset manipulation, with agentic actors managing task negotiation, content delivery, and digital-object provenance across interconnected virtual spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-frameworks ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nostr-protocol ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:digital-twin,
        ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:agent-frameworks,
        ngm:nostr-protocol ;
    vc:slug "agentic-metaverse-for-global-creatives" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:digital-asset,
        ngm:large-language-models,
        ngm:lightning-network .

ngm:ai-applications a owl:Class ;
    rdfs:label "AI Applications"@en ;
    rdfs:comment "Domain-specific deployments of artificial intelligence technologies delivering measurable value across industries including healthcare diagnostics, autonomous vehicles, industrial automation, financial services, and personal assistants. AI Applications translate research-level techniques—machine learning models, natural language processing, computer vision—into production systems operating within real-world constraints of safety, reliability, and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ai-governance,
        ngm:ai-risk-management ;
    vc:slug "ai-applications" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning,
        ngm:natural-language-processing .

ngm:ai-development-tools a owl:Class ;
    rdfs:label "AI Development Tools"@en ;
    rdfs:comment "Software frameworks, libraries, platforms, and integrated development environments designed to facilitate the creation, training, deployment, and maintenance of artificial intelligence systems. Includes deep learning frameworks (TensorFlow, PyTorch, JAX), AutoML platforms, model optimisation toolkits, MLOps infrastructure, and AI-assisted IDEs. Modern tools emphasise reproducibility, scalability, experiment tracking, and continuous delivery of AI systems."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:generative-ai,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ai-development-tools" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-lifecycle,
        ngm:machine-learning-infrastructure ;
    vc:uses ngm:auto-ml,
        ngm:data-pipeline .

ngm:ai-group-formation a owl:Class ;
    rdfs:label "AI Group Formation"@en ;
    rdfs:comment "AI Group Formation is the automated assignment of participants into subgroups using models that optimize for criteria such as skill balance, topic affinity, social diversity, or learning objectives. In collaborative and meeting platforms it drives features like intelligent breakout-room allocation, replacing manual or random grouping. The technique combines clustering, optimization, and sometimes reinforcement learning over participant attributes and interaction signals."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room,
        ngm:educational-technology ;
    vc:slug "ai-group-formation" ;
    vc:sourceDomain "ai" .

ngm:ai-investment a owl:Class ;
    rdfs:label "AI Investment"@en ;
    rdfs:comment "AI Investment is the allocation of capital toward artificial-intelligence research, talent, compute infrastructure, startups, and data assets in pursuit of strategic or financial returns. It spans venture funding, corporate capital expenditure on data centres and chips, sovereign funds, and public research grants. The scale and concentration of this capital is a primary driver of competitive dynamics among firms and nations."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-chips,
        ngm:competition-in-ai ;
    vc:slug "ai-investment" ;
    vc:sourceDomain "ai" .

ngm:ai-model-development a owl:Class ;
    rdfs:label "AI Model Development"@en ;
    rdfs:comment "The end-to-end engineering discipline of designing, training, evaluating, and deploying machine learning models, encompassing dataset curation, architecture selection, optimisation, and lifecycle management. It integrates software engineering, statistical modelling, and domain expertise to produce AI systems capable of performing specified tasks at scale. The discipline spans research prototyping through production deployment and ongoing maintenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-resources ],
        ngm:ai-system ;
    vc:enables ngm:ai-inference,
        ngm:ai-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-assessment ;
    vc:requires ngm:compute-resources,
        ngm:data-pipeline ;
    vc:slug "ai-model-development" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:fine-tuning,
        ngm:model-evaluation .

ngm:ai-talent-war a owl:Class ;
    rdfs:label "AI Talent War"@en ;
    rdfs:comment "The intensely competitive global contest among technology companies, research institutions, and nation-states to attract, retain, and concentrate the scarce pool of highly skilled AI researchers and engineers. The competition manifests through escalating compensation packages, aggressive academic recruitment, strategic immigration policy, and corporate acquisitions of talent-rich startups. Because frontier AI capability is tightly coupled to the concentration of top research talent, this competition is simultaneously an economic, geopolitical, and strategic-security phenomenon."@en ;
    rdfs:subClassOf ngm:competition-in-ai ;
    vc:contrastsWith ngm:ai-governance-framework ;
    vc:dependsOn ngm:education-and-ai ;
    vc:enables ngm:frontier-model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-talent,
        ngm:frontier-ai ;
    vc:slug "ai-talent-war" ;
    vc:sourceDomain "ai" .

ngm:ai-user a owl:Class ;
    rdfs:label "AI User"@en ;
    rdfs:comment "An individual or entity who interacts with, relies upon, or is affected by the outputs, decisions, or recommendations of an AI system in order to accomplish tasks, obtain services, or achieve objectives—either through direct interaction or indirect exposure to AI-mediated decisions. AI users are the primary experiencers of AI benefits and harms, encompassing diverse populations with varying technical literacy, accessibility needs, and degrees of voluntary engagement, making their rights and interests central to responsible AI governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:dependsOn ngm:eu-ai-act,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-operator,
        ngm:ai-provider ;
    vc:requires ngm:explainability,
        ngm:fairness,
        ngm:human-oversight ;
    vc:slug "ai-user" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:algorand a owl:Class ;
    rdfs:label "Algorand"@en ;
    rdfs:comment "Algorand is a permissionless, pure proof-of-stake Layer 1 blockchain protocol designed by MIT cryptographer Silvio Micali, providing instant transaction finality, high throughput, and carbon-negative operation through a cryptographically random committee-selection consensus mechanism. It resolves the blockchain trilemma of security, scalability, and decentralisation without forks by ensuring all confirmed blocks are final. The Algorand Virtual Machine (AVM) supports smart contract execution in TEAL bytecode and, via ARC standards, enables NFTs, DeFi, and tokenised assets at scale."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:enables ngm:asset-tokenization,
        ngm:decentralized-application,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:financial-technology ;
    vc:slug "algorand" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:pure-proof-of-stake,
        ngm:verifiable-random-function .

ngm:algorithmic-capture a owl:Class ;
    rdfs:label "Algorithmic Capture"@en ;
    rdfs:comment "Algorithmic Capture describes the process by which recommendation and ranking algorithms come to dominate the flow of attention, shaping what content people see and produce until human discretion is largely supplanted. By optimizing for engagement, these systems can homogenize discourse, amplify synthetic or low-quality content, and entrench platform control over information ecosystems. It is a central mechanism in narratives about the decline and automation of the open internet."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-governance,
        ngm:death-of-the-internet ;
    vc:slug "algorithmic-capture" ;
    vc:sourceDomain "governance" .

ngm:algorithmic-governance a owl:Class ;
    rdfs:label "Algorithmic Governance"@en ;
    rdfs:comment "Algorithmic Governance is the use of automated decision systems, models, and rule engines to make or enforce governance choices that were traditionally human and discretionary, such as moderation, resource allocation, or compliance enforcement. It can increase consistency, speed, and scale, but raises concerns about transparency, accountability, bias, and contestability of automated decisions. The concept spans platform moderation, public-sector automation, and on-chain rule enforcement."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-coordination,
        ngm:digital-society-surveillance ;
    vc:slug "algorithmic-governance" ;
    vc:sourceDomain "governance" .

ngm:algorithmic-transparency-reports a owl:Class ;
    rdfs:label "Algorithmic Transparency Reports"@en ;
    rdfs:comment "Algorithmic Transparency Reports are periodic public disclosures that document AI system characteristics, performance metrics, governance practices, and accountability mechanisms, enabling external stakeholders, regulators, and affected communities to scrutinise how algorithmic decision-making systems operate and impact individuals. Core sections include system purpose and deployment scope, disaggregated performance and fairness metrics, bias and disparate-impact analyses, data governance practices, explainability provisions, incident and remediation records, and stakeholder engagement summaries. Reports balance transparency objectives against proprietary-information protection and adversarial-exploitation risks, and align with requirements in EU AI Act Article 13 (high-risk system transparency), Platform-to-Business Regulation disclosure obligations, and voluntary civil-society commitments led by organisations such as the AI Now Institute."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:regulatory-compliance,
        ngm:stakeholder,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:diversity-non-discrimination-and-fairness,
        ngm:human-oversight,
        ngm:redress-procedure,
        ngm:risk-assessment ;
    vc:requires ngm:accountability,
        ngm:audit-trail,
        ngm:transparency ;
    vc:slug "algorithmic-transparency-reports" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:governance-framework,
        ngm:responsible-ai ;
    vc:uses ngm:ai-impact-assessment,
        ngm:explainability,
        ngm:fairness .

ngm:alpr-networks a owl:Class ;
    rdfs:label "ALPR Networks"@en ;
    rdfs:comment "ALPR Networks are interconnected systems of Automatic License Plate Recognition cameras that capture, read, timestamp, and geotag vehicle plates at scale across roads, lots, and checkpoints. Aggregated across many cameras and operators, the resulting databases reconstruct vehicle movement histories and enable mass location tracking. They are a prominent component of contemporary surveillance infrastructure and a focal point of privacy and civil-liberties concern."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-society-surveillance ;
    vc:slug "alpr-networks" ;
    vc:sourceDomain "security" .

ngm:ambient-computing a owl:Class ;
    rdfs:label "Ambient Computing"@en ;
    rdfs:comment "A paradigm in which computing capability is invisibly embedded throughout the physical environment, enabling technology to sense, infer, and respond to human needs without requiring deliberate interaction with discrete devices. Ambient computing dissolves the boundary between the digital and physical worlds by distributing processing, sensing, and actuation across interconnected objects, surfaces, and spaces that operate continuously in the background. It represents the convergence of pervasive connectivity, miniaturised hardware, and AI-driven contextual inference into an always-present computational substrate."@en ;
    rdfs:subClassOf ngm:pervasive-computing ;
    vc:enables ngm:context-aware-computing,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:io-t,
        ngm:mixed-reality ;
    vc:slug "ambient-computing" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:edge-ai,
        ngm:edge-computing,
        ngm:internet-of-things .

ngm:amm-algorithm a owl:Class ;
    rdfs:label "AMM Algorithm"@en ;
    rdfs:comment "An AMM Algorithm is the pricing rule of an Automated Market Maker that algorithmically sets exchange rates from the reserves held in a liquidity pool, removing the need for a traditional order book. The canonical form is the constant-product invariant x*y=k, with variants such as constant-sum, stableswap, and concentrated-liquidity curves tuned for different asset pairs. It determines slippage, price impact, and the impermanent loss that liquidity providers bear."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:impermanent-loss,
        ngm:liquidity-pool ;
    vc:slug "amm-algorithm" ;
    vc:sourceDomain "blockchain" .

ngm:annotated-training-data a owl:Class ;
    rdfs:label "Annotated Training Data"@en ;
    rdfs:comment "Annotated Training Data is a dataset whose examples have been augmented with ground-truth labels, bounding boxes, segmentation masks, or other targets that supervised models learn to predict. The annotations are produced by humans, programmatic rules, or model-assisted labeling and define the task the model is trained to solve. Its quality, coverage, and label consistency are primary determinants of supervised-model performance."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:segmentation-and-identification ;
    vc:slug "annotated-training-data" ;
    vc:sourceDomain "data" .

ngm:anonymisation a owl:Class ;
    rdfs:label "Anonymisation"@en ;
    rdfs:comment "Anonymisation is the process of transforming data so that individuals can no longer be identified, directly or by inference, while preserving enough utility for analysis. Techniques include suppression, generalization, pseudonymisation, k-anonymity, differential privacy, and the blurring or synthetic replacement of faces and identifiers in media. Effective anonymisation must resist re-identification through linkage with auxiliary data."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:face-swap,
        ngm:privacy-domain ;
    vc:slug "anonymisation" ;
    vc:sourceDomain "security" .

ngm:answer-ai a owl:Class ;
    rdfs:label "Answer AI"@en ;
    rdfs:comment "Answer.AI is an applied AI research and development lab founded by Jeremy Howard and Eric Ries, focused on producing practical, openly shared tools and techniques that make modern machine learning accessible and useful. It continues the fast.ai tradition of pragmatic, education-oriented research, releasing open-source libraries and methods aimed at real-world deployment rather than purely academic benchmarks. Its work emphasizes efficient fine-tuning, reproducibility, and lowering the barrier to building with foundation models."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai ;
    vc:slug "answer-ai" ;
    vc:sourceDomain "ai" .

ngm:antenna-array a owl:Class ;
    rdfs:label "Antenna Array"@en ;
    rdfs:comment "An Antenna Array is a set of multiple antenna elements arranged and phased together so that their combined radiation pattern can be electronically steered and shaped. By controlling the relative phase and amplitude of each element, the array forms directional beams, increases gain, and supports spatial multiplexing in techniques such as MIMO and beamforming. Arrays are foundational to modern wireless radio, 5G, radar, and precise satellite positioning receivers."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:wireless-radio ;
    vc:slug "antenna-array" ;
    vc:sourceDomain "infrastructure" .

ngm:apache-iceberg a owl:Class ;
    rdfs:label "Apache Iceberg"@en ;
    rdfs:comment "Apache Iceberg is an open table format for large analytic datasets stored in data lakes, adding database-like guarantees on top of object storage. It provides ACID transactions, schema and partition evolution, snapshot isolation, and time-travel queries by maintaining immutable metadata layers that track data files. Iceberg decouples the table format from the compute engine, letting Spark, Trino, Flink, and others operate consistently on the same tables."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:storage-infrastructure ;
    vc:slug "apache-iceberg" ;
    vc:sourceDomain "data" .

ngm:api a owl:Class ;
    rdfs:label "API"@en ;
    rdfs:comment "An Application Programming Interface, a defined set of operations, inputs and outputs through which software components or services communicate without exposing their internal implementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocols ],
        ngm:software-engineering ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:communication-protocols ;
    vc:slug "api" ;
    vc:sourceDomain "general" .

ngm:apple-vision-pro a owl:Class ;
    rdfs:label "Apple Vision Pro"@en ;
    rdfs:comment "Apple Vision Pro is a spatial computing head-mounted display developed by Apple, announced in June 2023 and released in the United States in February 2024, running the visionOS operating system. It combines ultra-high-resolution micro-OLED displays, a custom R1 chip for sensor processing, and an M2 chip for compute, enabling a fully immersive or passthrough-composited mixed reality experience. The device employs eye-tracking, hand-tracking, and voice input as its primary interaction modalities, replacing the traditional touchscreen paradigm with gaze-and-pinch gesture control."@en ;
    rdfs:subClassOf ngm:head-mounted-display ;
    vc:enables ngm:immersive-experience,
        ngm:mixed-reality,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:display-technology,
        ngm:extended-reality ;
    vc:slug "apple-vision-pro" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:spatial-audio .

ngm:application-window-capture a owl:Class ;
    rdfs:label "Application Window Capture"@en ;
    rdfs:comment "Application Window Capture is a screen-capture technique that grabs the pixels of a single specified application window rather than the entire display or a region. It lets users share or record one program while keeping other windows, notifications, and private content off-screen. Operating systems expose it through window-enumeration and per-window framebuffer APIs used by recording and conferencing software."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:screen-recording,
        ngm:screen-sharing ;
    vc:slug "application-window-capture" ;
    vc:sourceDomain "metaverse" .

ngm:april-tag a owl:Class ;
    rdfs:label "April Tag"@en ;
    rdfs:comment "An AprilTag is a square fiducial marker, resembling a simplified QR code, designed for robust detection and accurate 6-DoF pose estimation by computer-vision systems. Each tag encodes a unique ID with strong error correction, enabling reliable recognition under poor lighting, partial occlusion, and oblique viewing angles. AprilTags are widely used as visual landmarks for camera calibration, robot localization, and augmented-reality registration."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lens-and-camera-calibration ;
    vc:slug "april-tag" ;
    vc:sourceDomain "robotics" .

ngm:ar-overlay a owl:Class ;
    rdfs:label "Ar Overlay"@en ;
    rdfs:comment "AR Overlay refers to the digital layer of virtual elements including holograms, data visualizations, animations, and 3D objects that are spatially anchored and rendered over the user's view of the physical world in augmented reality systems, creating a seamless blend of virtual and real content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-anchoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-understanding ],
        ngm:sc-display-and-rendering,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-display-and-rendering,
        ngm:sc-platform-and-environment ;
    vc:enables ngm:information-augmentation,
        ngm:spatial-annotation,
        ngm:virtual-object-placement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:environmental-understanding,
        ngm:real-time-rendering,
        ngm:spatial-anchoring ;
    vc:slug "ar-overlay" ;
    vc:sourceDomain "spatial-computing" .

ngm:architecture a owl:Class ;
    rdfs:label "Architecture"@en ;
    rdfs:comment "In the AI domain, Architecture refers to the structural design of an AI model or system, specifying how computational components—such as layers, modules, attention heads, and connections—are organised and interact to process inputs and produce outputs. Architectural choices fundamentally determine a model's capacity, inductive biases, scalability, and suitability for particular tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:machine-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:decoder,
        ngm:encoder,
        ngm:neural-network-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:model-architecture,
        ngm:neural-network-architecture,
        ngm:transformer-architecture ;
    vc:slug "architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-computing,
        ngm:neural-network .

ngm:asset-archive a owl:Class ;
    rdfs:label "Asset Archive"@en ;
    rdfs:comment "Asset Archive is a digital repository system for long-term storage, management, and preservation of 3D models, textures, animations, and other virtual world components, incorporating provenance tracking, version control, and standardized formats to ensure accessibility and interoperability across..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardized-formats ],
        ngm:digital-repository,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:asset-preservation,
        ngm:content-reuse,
        ngm:cross-platform-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:metadata-management,
        ngm:standardized-formats,
        ngm:storage-infrastructure ;
    vc:slug "asset-archive" ;
    vc:sourceDomain "spatial-computing" .

ngm:asset-creation a owl:Class ;
    rdfs:label "Asset Creation"@en ;
    rdfs:comment "Asset Creation is the structured practice of producing digital or physical resources — including geometry, textures, audio, code, and data — intended for use within interactive experiences, virtual environments, or production pipelines. It encompasses the full authoring lifecycle from concept through final deliverable, applying artistic, technical, and automated methods to yield artefacts that meet quality, format, and performance requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        ngm:content-creation ;
    vc:enables ngm:asset-pipeline,
        ngm:digital-content-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-animation,
        ngm:3-d-modeling ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "asset-creation" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:game-engine,
        ngm:procedural-content-generation .

ngm:asset-optimization a owl:Class ;
    rdfs:label "Asset Optimization"@en ;
    rdfs:comment "Asset Optimization is the systematic process of reducing the computational cost, memory footprint, and bandwidth consumption of digital assets while preserving their perceptual quality and functional correctness for target deployment environments. It applies techniques including polygon reduction, texture compression, audio resampling, and level-of-detail generation to ensure assets perform acceptably on constrained hardware."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:enables ngm:gpu-acceleration,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "asset-optimization" ;
    vc:sourceDomain "spatial" ;
    vc:supports ngm:asset-pipeline,
        ngm:game-engine ;
    vc:uses ngm:level-of-detail,
        ngm:rendering-pipeline .

ngm:assistive-technology-support a owl:Class ;
    rdfs:label "Assistive Technology Support"@en ;
    rdfs:comment "Assistive Technology Support is the set of capabilities that make software interoperate correctly with assistive tools such as screen readers, magnifiers, switch access, and voice control. It is achieved by exposing semantic roles, names, states, and keyboard operability through accessibility APIs so that users with disabilities can perceive and operate an interface. Robust support is a prerequisite for accessible experiences and for compliance with standards like WCAG."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility-domain,
        ngm:accessible-experience ;
    vc:slug "assistive-technology-support" ;
    vc:sourceDomain "infrastructure" .

ngm:asynchronous-coordination a owl:Class ;
    rdfs:label "Asynchronous Coordination"@en ;
    rdfs:comment "Asynchronous Coordination is the alignment of distributed agents or processes that act without a shared global clock or blocking synchronization, communicating through messages, shared state, or eventual-consistency mechanisms. It tolerates network delay and partial failure by letting participants make progress independently and reconcile state later. This model underpins resilient distributed systems and decentralized multi-agent and swarm control."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-coordination,
        ngm:decentralized-swarm-control ;
    vc:slug "asynchronous-coordination" ;
    vc:sourceDomain "infrastructure" .

ngm:asynchronous-execution a owl:Class ;
    rdfs:label "Asynchronous Execution"@en ;
    rdfs:comment "An execution model in which operations are initiated without blocking the calling thread; completion is signalled via callbacks, promises, futures, or events, enabling high-throughput concurrent processing particularly suited to I/O-bound workloads and distributed system communication."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:execution-model ;
    vc:enables ngm:microservices-architecture,
        ngm:parallel-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "asynchronous-execution" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-agent-system,
        ngm:edge-computing ;
    vc:uses ngm:asynchronous-communication,
        ngm:event-driven-architecture .

ngm:authentication-protocol a owl:Class ;
    rdfs:label "Authentication Protocol"@en ;
    rdfs:comment "A defined sequence of exchanges through which one party proves its identity to another over a communication channel."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptographic-protocol ;
    vc:enables ngm:access-control,
        ngm:multi-factor-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:cryptography ;
    vc:slug "authentication-protocol" ;
    vc:sourceDomain "cryptographic" .

ngm:authorization a owl:Class ;
    rdfs:label "Authorization"@en ;
    rdfs:comment "The security process that determines what actions an authenticated principal is permitted to perform on specific resources within a system. Authorization evaluates the subject's identity, role, attributes, and contextual factors against a policy to produce an access decision, operating as a distinct layer from authentication and separate from audit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:access-control ;
    vc:enables ngm:compliance,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:zero-trust-architecture ;
    vc:requires ngm:authentication,
        ngm:identity-and-access-management ;
    vc:slug "authorization" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:policy-decision-point,
        ngm:role-based-access-control .

ngm:automata-theory a owl:Class ;
    rdfs:label "Automata Theory"@en ;
    rdfs:comment "Automata theory is the branch of theoretical computer science that studies abstract computing machines (automata) and the classes of formal languages they can recognise. It classifies machines such as finite-state automata, pushdown automata, and Turing machines by their computational power, establishing a hierarchy that defines what problems are decidable. The theory provides the formal foundations for compiler design, regular expressions, protocol verification, and model checking."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:formal-methods-domain,
        ngm:state-machine ;
    vc:slug "automata-theory" ;
    vc:sourceDomain "infrastructure" .

ngm:automatic-prompt-optimisation a owl:Class ;
    rdfs:label "Automatic Prompt Optimisation"@en ;
    rdfs:comment "Automatic prompt optimisation is a set of techniques that algorithmically search for or refine the prompts given to a large language model to maximise task performance, rather than relying on manual prompt crafting. Methods include gradient-free search, reinforcement learning, evolutionary algorithms, and LLM-driven self-improvement loops that score candidate prompts against an evaluation metric. It reduces the brittleness and labour of hand-tuned prompting and is a core component of mature prompt-engineering workflows."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering ;
    vc:slug "automatic-prompt-optimisation" ;
    vc:sourceDomain "ai" .

ngm:autonomous-driving-perception a owl:Class ;
    rdfs:label "Autonomous Driving Perception"@en ;
    rdfs:comment "The subsystem of an autonomous vehicle responsible for interpreting sensor data to construct a structured understanding of the vehicle's immediate environment, including the detection, classification, and tracking of objects, lane geometry, road surfaces, traffic signage, and dynamic actors. Autonomous driving perception fuses inputs from cameras, LiDAR, radar, and ultrasonic sensors to produce a real-time scene representation sufficient for safe navigation decisions."@en ;
    rdfs:subClassOf ngm:perception-system ;
    vc:enables ngm:autonomous-driving,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:object-detection,
        ngm:point-cloud,
        ngm:semantic-segmentation ;
    vc:slug "autonomous-driving-perception" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:lidar,
        ngm:sensor-fusion .

ngm:av1-codec a owl:Class ;
    rdfs:label "AV1 Codec"@en ;
    rdfs:comment "AV1 is a royalty-free video coding format developed by the Alliance for Open Media to deliver high compression efficiency for streaming and real-time video. It typically achieves around 30 percent better compression than HEVC/VP9 at equivalent quality, making it well suited to bandwidth-constrained applications such as screen sharing and live video. Being open and licence-free, it is widely adopted across browsers, hardware decoders, and conferencing platforms."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:screen-sharing ;
    vc:slug "av1-codec" ;
    vc:sourceDomain "infrastructure" .

ngm:avatar-creation a owl:Class ;
    rdfs:label "Avatar Creation"@en ;
    rdfs:comment "Avatar Creation is the process of designing and generating 3D digital representations of users for metaverse environments, encompassing selfie-based AI generation, manual customization tools, full-body scanning, and procedural generation techniques that enable personalized virtual identities."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets,
        ngm:sc-interaction ;
    skos:broader ngm:sc-content-and-assets,
        ngm:sc-interaction ;
    vc:enables ngm:digital-persona-management,
        ngm:metaverse-participation,
        ngm:virtual-self-expression ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-modeling-tools,
        ngm:ai-generation-systems,
        ngm:customization-interfaces ;
    vc:slug "avatar-creation" ;
    vc:sourceDomain "spatial-computing" .

ngm:avatar-wearable a owl:Class ;
    rdfs:label "Avatar Wearable"@en ;
    rdfs:comment "Digital clothing, accessories, and cosmetic items that can be equipped by avatars in virtual environments, often tokenised as NFTs to enable ownership, cross-platform portability, and secondary-market trading within metaverse economies."@en ;
    rdfs:subClassOf ngm:digital-asset,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:virtual-economy-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:avatar-system,
        ngm:virtual-economy ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:avatar-customization,
        ngm:avatar-interoperability,
        ngm:nft,
        ngm:nft-standard ;
    vc:slug "avatar-wearable" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-asset,
        ngm:digital-asset-management .

ngm:aztec-protocol a owl:Class ;
    rdfs:label "Aztec Protocol"@en ;
    rdfs:comment "The protocol underlying the Aztec network that combines zero-knowledge proofs with an encrypted note model to provide confidential transactions and private contracts on Ethereum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:aztec ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:zero-knowledge-proof ;
    vc:slug "aztec-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:bagging a owl:Class ;
    rdfs:label "Bagging"@en ;
    rdfs:comment "Bagging is a artificial intelligence concept and a type of Ensemble Mods. that enables Parallel Training."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:ensemble-methods ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:parallel-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "bagging" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:bbs-signature a owl:Class ;
    rdfs:label "BBS+ Signature"@en ;
    rdfs:comment "BBS+ Signature is a pairing-based digital signature scheme that signs a vector of messages simultaneously and supports the generation of zero-knowledge proofs that reveal only a chosen subset of those messages — a property known as selective disclosure — without revealing the full signed message set or enabling linkage of multiple presentations to the same credential. It is a cornerstone primitive for privacy-preserving verifiable credentials."@en ;
    rdfs:subClassOf ngm:cryptographic-signature ;
    vc:enables ngm:privacy-preserving-identity,
        ngm:selective-disclosure,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bls-signature,
        ngm:decentralized-identifiers ;
    vc:slug "bbs-signature" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-primitive,
        ngm:cryptographic-proof .

ngm:bbs-signatures a owl:Class ;
    rdfs:label "BBS+ Signatures"@en ;
    rdfs:comment "BBS+ Signatures is the collective term for the class of pairing-based multi-message signature schemes derived from the BBS construction, encompassing both the base signature algorithm and the proof-of-knowledge protocols that enable selective disclosure and unlinkable presentation of signed credential attributes. As a scheme family, BBS+ Signatures represent the cryptographic foundation for privacy-preserving digital credential ecosystems."@en ;
    rdfs:subClassOf ngm:cryptographic-signature ;
    vc:enables ngm:privacy-preserving-authentication,
        ngm:selective-disclosure,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bbs-signature,
        ngm:digital-identity,
        ngm:privacy-preserving-identity ;
    vc:slug "bbs-signatures" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-primitive,
        ngm:cryptographic-proof-system .

ngm:beam-search-decoding a owl:Class ;
    rdfs:label "Beam Search Decoding"@en ;
    rdfs:comment "Beam search decoding is the application of the beam search algorithm specifically to the inference phase of neural sequence-to-sequence and autoregressive language models, where token-by-token predictions are generated by retaining the k highest-scoring partial sequences at each step. It serves as the primary decoding strategy for tasks requiring high-fidelity, deterministic outputs such as translation, summarisation, and structured text generation."@en ;
    rdfs:subClassOf ngm:beam-search ;
    vc:enables ngm:machine-translation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:sampling ;
    vc:slug "beam-search-decoding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:encoder-decoder-architecture,
        ngm:large-language-models .

ngm:behavior-tree a owl:Class ;
    rdfs:label "Behavior Tree"@en ;
    rdfs:comment "A behavior tree is a hierarchical, modular control architecture for structuring the decision-making of autonomous agents and robots. It composes leaf action and condition nodes under control-flow nodes (sequence, fallback, parallel, decorator) that are evaluated by periodic ticks, returning success, failure, or running. Behavior trees offer greater modularity and reactivity than finite-state machines and are widely used in robotics middleware and game AI."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:nav2 ;
    vc:slug "behavior-tree" ;
    vc:sourceDomain "robotics" .

ngm:bert a owl:Class ;
    rdfs:label "BERT"@en ;
    rdfs:comment "BERT (Bidirectional Encoder Representations from Transformers) is a pre-trained deep language representation model developed by Google AI Language and published in 2018. It applies a bidirectional Transformer encoder trained with masked language modelling (MLM) and next sentence prediction (NSP) objectives on large text corpora, producing contextualised word embeddings. BERT established a new paradigm of pre-train-then-fine-tune for natural language processing tasks, achieving state-of-the-art performance across eleven NLP benchmarks upon release. Its architecture underpins a large family of subsequent models including RoBERTa, ALBERT, and multilingual mBERT."@en ;
    rdfs:subClassOf ngm:language-model ;
    vc:enables ngm:fine-tuning,
        ngm:natural-language-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:albert,
        ngm:m-bert,
        ngm:natural-language-processing,
        ngm:ro-berta ;
    vc:slug "bert" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:embeddings,
        ngm:self-attention,
        ngm:transformer-architecture .

ngm:bifrost-protocol a owl:Class ;
    rdfs:label "Bifrost Protocol"@en ;
    rdfs:comment "Bifrost is a Bitcoin-focused protocol stack associated with RGB and client-side validation, providing transport and interoperability for off-chain smart-contract state. In the RGB ecosystem it handles the peer-to-peer exchange of consignments and validation data so that asset and contract state can move between parties without publishing it on-chain. By keeping contract data client-side, it preserves Bitcoin's scalability and privacy while enabling rich asset issuance."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation ;
    vc:slug "bifrost-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:bipedal-balance a owl:Class ;
    rdfs:label "Bipedal Balance"@en ;
    rdfs:comment "Bipedal Balance is the set of sensing, computation, and actuation mechanisms that enable a two-legged robot or agent to maintain postural stability during standing, walking, and dynamic manoeuvres. It encompasses whole-body control strategies, inertial sensing, and real-time torque control to keep the centre of mass within a supportable base of support. The field integrates mechanics, control theory, and machine learning to achieve robust locomotion across uneven terrain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        ngm:legged-locomotion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning-for-robotics ;
    vc:requires ngm:robot-dynamics ;
    vc:slug "bipedal-balance" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inertial-measurement-unit,
        ngm:inverse-kinematics,
        ngm:torque-control,
        ngm:whole-body-control .

ngm:bitcoin-custody a owl:Class ;
    rdfs:label "Bitcoin Custody"@en ;
    rdfs:comment "Bitcoin custody is the practice and infrastructure for securely holding the private keys that control bitcoin, spanning self-custody, collaborative custody, and qualified institutional custodians. Approaches differ in how they distribute key control and recovery, using techniques such as multi-signature, hardware security modules, and multi-party computation to balance security against operational availability. Custody design is foundational to wallets, federations, and regulated products such as exchange-traded funds."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-etf,
        ngm:fedimint ;
    vc:slug "bitcoin-custody" ;
    vc:sourceDomain "blockchain" .

