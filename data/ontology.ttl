    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:robotics-control ;
    vc:slug "vp-robotics-project" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:machine-learning,
        ngm:robotics .

ngm:warmup a owl:Class ;
    rdfs:label "Warmup"@en ;
    rdfs:comment "A training technique where the learning rate starts small and gradually increases over a fixed number of initial steps to stabilise optimisation. Warmup prevents large early gradients from destabilising weight updates and is standard practice for large transformer models, typically preceding a cosine or linear decay schedule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimiser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:training ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:learning-rate-schedule,
        ngm:optimiser ;
    vc:slug "warmup" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gradient-descent .

ngm:web-bookmarks a owl:Class ;
    rdfs:label "Web Bookmarks"@en ;
    rdfs:comment "A curated collection of saved hyperlinks to external web resources, serving as a personal or shared reference library for articles, tools, and research material. In knowledge management contexts, web bookmarks act as annotated entry points linking internal knowledge graphs to external sources."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:knowledge-management ;
