ngm:depth-estimation a owl:Class ;
    rdfs:label "Depth Estimation"@en ;
    rdfs:comment "Depth Estimation is the computer vision task of recovering per-pixel distance from a camera (or a virtual viewpoint) to the surfaces of a 3D scene, producing a depth map D(u,v) ∈ ℝ⁺ aligned to an image I(u,v) that encodes scene geometry needed for 3D reconstruction, robotic perception, augmented-..."@en ;
