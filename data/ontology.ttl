ngm:rtab-map a owl:Class ;
    rdfs:label "RTAB-Map"@en ;
    rdfs:comment "RTAB-Map (Real-Time Appearance-Based Mapping) is an open-source library for RGB-D, stereo, and lidar graph-based SLAM with a memory-management scheme that bounds computation for large-scale, long-term operation. Its core is an appearance-based loop-closure detector that recognises previously visited places to correct accumulated drift. It is widely used on ground robots to build consistent metric and topological maps."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:topological-map ;
    vc:slug "rtab-map" ;
    vc:sourceDomain "robotics" .

ngm:runtime-inspection a owl:Class ;
    rdfs:label "Runtime Inspection"@en ;
    rdfs:comment "Runtime Inspection is the practice of dynamically examining the internal state, activations, attention patterns, and behavioural properties of an AI model while it is executing inference, as opposed to static analysis of weights or architecture prior to deployment. It enables detection of unexpected or dangerous reasoning paths, verification of safety constraints during live operation, and post-hoc explanation of individual predictions by observing intermediate computations at the moment they occur."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-governance ;
    vc:enables ngm:ai-safety,
        ngm:explainable-ai,
        ngm:formal-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-management,
        ngm:human-oversight,
        ngm:runtime-environment,
        ngm:traceability-mechanism ;
    vc:requires ngm:audit-trail,
        ngm:interpretability ;
    vc:slug "runtime-inspection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:model-transparency,
        ngm:monitoring-dashboard .

ngm:sa8000 a owl:Class ;
    rdfs:label "SA8000"@en ;
    rdfs:comment "SA8000 is a voluntary, auditable social-accountability standard developed by Social Accountability International that certifies organisations against decent-work criteria. It covers child and forced labour, health and safety, freedom of association, discrimination, working hours, and management systems, drawing on ILO conventions and human-rights instruments. Certification is used to demonstrate ethical labour practices across supply chains."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing ;
