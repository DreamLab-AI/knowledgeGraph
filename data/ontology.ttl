    rdfs:comment "Environmental, social and governance criteria used to evaluate the sustainability and ethical impact of an organisation's operations and investments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:corporate-governance ],
        ngm:sustainability ;
    vc:enables ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:corporate-governance,
        ngm:sustainability ;
    vc:slug "esg" ;
    vc:sourceDomain "governance" .

ngm:ethereum-smart-contracts a owl:Class ;
    rdfs:label "Ethereum Smart Contracts"@en ;
    rdfs:comment "Programs deployed to the Ethereum blockchain that execute deterministically on the Ethereum Virtual Machine and maintain state enforced by network consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-virtual-machine ],
