ngm:network-security a owl:Class ;
    rdfs:label "Network Security"@en ;
    rdfs:comment "Network security is the practice of protecting computer networks and the data transmitted across them from unauthorised access, misuse, modification, or denial of service through a combination of hardware controls, software policies, and operational procedures. It encompasses perimeter defence, intrusion detection and prevention, traffic analysis, encryption of data in transit, and access control applied at network boundaries and within internal segments. As networks have evolved from isolated LANs to globally distributed cloud and edge architectures, network security has broadened to encompass zero-trust models, software-defined perimeters, and AI-driven anomaly detection. It forms a foundational layer of broader cybersecurity strategy, intersecting with identity management, cryptographic standards, and regulatory compliance frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:machine-learning,
        ngm:software-defined-networking ;
    vc:contrastsWith ngm:perimeter-security ;
    vc:dependsOn ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:enables ngm:compliance-management,
        ngm:data-security,
        ngm:digital-security,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:firewall,
        ngm:intrusion-detection-system,
        ngm:network-segmentation,
        ngm:security-information-and-event-management,
        ngm:virtual-private-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:endpoint-security,
        ngm:information-security,
        ngm:threat-intelligence,
        ngm:vulnerability-management,
        ngm:zero-trust-architecture ;
    vc:requires ngm:access-control,
        ngm:authentication-mechanism,
        ngm:identity-management ;
    vc:slug "network-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-cybersecurity-framework ;
    vc:uses ngm:anomaly-detection,
        ngm:deep-packet-inspection,
        ngm:encryption,
        ngm:network-protocol,
        ngm:transport-layer-security .

ngm:probability-theory a owl:Class ;
    rdfs:label "Probability Theory"@en ;
    rdfs:comment "Probability theory is the branch of mathematics that provides a rigorous framework for quantifying and reasoning about uncertainty and random phenomena. Built on measure-theoretic foundations formalised by Andrei Kolmogorov in 1933, it defines probability spaces, random variables, and expectation operators over sigma-algebras to give a unified axiomatic treatment of chance. The theory encompasses both frequentist and Bayesian interpretations, and its core results — the law of large numbers, the central limit theorem, and the law of total probability — underpin virtually every quantitative discipline from statistical inference to machine learning and financial mathematics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        ngm:measure-theory ;
    vc:bridgesTo ngm:conformal-prediction,
        ngm:diffusion-models,
        ngm:financial-mathematics ;
    vc:contrastsWith ngm:deterministic-computation,
        ngm:fuzzy-logic ;
    vc:dependsOn ngm:lebesgue-integration,
        ngm:sigma-algebra ;
    vc:enables ngm:information-theory,
        ngm:monte-carlo-methods,
        ngm:reinforcement-learning,
        ngm:statistical-inference,
        ngm:stochastic-differential-equation,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bayesian-inference,
        ngm:central-limit-theorem,
        ngm:markov-chain,
        ngm:probability-distribution,
        ngm:random-variable,
        ngm:stochastic-process ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:bayesian-decision-theory,
        ngm:causal-inference,
        ngm:information-geometry,
        ngm:optimal-transport,
        ngm:statistics ;
    vc:requires ngm:measure-theory,
        ngm:real-analysis,
        ngm:set-theory ;
    vc:slug "probability-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:bayesian-networks,
        ngm:machine-learning,
        ngm:probabilistic-graphical-models .

ngm:rest-api a owl:Class ;
    rdfs:label "REST API"@en ;
    rdfs:comment "A REST API (Representational State Transfer Application Programming Interface) is a web service interface conforming to Roy Fielding's six architectural constraints — client–server separation, statelessness, cacheability, uniform interface, layered system, and optional code-on-demand — originally formalised in his 2000 doctoral dissertation. Resources are uniquely addressed by URIs, manipulated through standard HTTP verbs (GET, POST, PUT, PATCH, DELETE), and represented in negotiated formats such as JSON or XML. The uniform interface constraint — encompassing resource identification, manipulation through representations, self-descriptive messages, and hypermedia as the engine of application state (HATEOAS) — is the defining characteristic that separates REST from earlier RPC and SOAP-based architectures. REST APIs have become the dominant integration surface across cloud platforms, AI model serving, microservices ecosystems, and public developer APIs precisely because they align with existing HTTP infrastructure including caches, proxies, load balancers, and API gateways."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:federated-learning,
        ngm:llm-inference-api,
        ngm:model-serving ;
    vc:contrastsWith ngm:graphql,
        ngm:grpc,
        ngm:simple-object-access-protocol,
        ngm:websocket ;
    vc:enables ngm:api-economy,
        ngm:cloud-native-computing,
        ngm:microservices-architecture,
        ngm:service-oriented-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:hateoas,
        ngm:http,
        ngm:openapi-specification,
        ngm:representational-state-transfer ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:api-design,
        ngm:hypermedia,
        ngm:stateless-protocol ;
    vc:requires ngm:http-server,
        ngm:uri ;
    vc:slug "rest-api" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-gateway,
        ngm:content-negotiation,
        ngm:rate-limiting ;
    vc:uses ngm:json-data-interchange-format,
        ngm:oauth2,
        ngm:tls,
        ngm:xml .

ngm:workflow-automation a owl:Class ;
    rdfs:label "Workflow Automation"@en ;
    rdfs:comment "Workflow automation is the systematic encoding of business processes, data-transformation pipelines, or task sequences into executable software so that they proceed reliably and repeatedly with minimal human intervention, using rule-based triggers, conditional branching, state machines, and event-driven messaging. It spans a spectrum from deterministic rule engines and robotic process automation (RPA), which replicate structured human UI interactions, to agentic AI systems in which large language models serve as planning kernels that dynamically compose multi-step tool-call sequences in response to high-level goals. Architecturally, workflow automation systems couple an orchestration layer — responsible for sequencing, error recovery, and state persistence — with an integration layer that provides connectors to APIs, databases, messaging queues, and human-approval interfaces. By reducing operational latency, enforcing process compliance, and enabling organisations to scale knowledge-work capacity, workflow automation has become a foundational capability across enterprise IT, scientific data pipelines, and AI agent infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotic-process-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:batch-processing,
        ngm:manual-processing ;
    vc:dependsOn ngm:idempotency,
        ngm:observability,
        ngm:planning-and-scheduling ;
    vc:enables ngm:business-process-management,
        ngm:hyperautomation,
        ngm:intelligent-process-automation,
        ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:human-in-the-loop,
        ngm:robotic-process-automation,
        ngm:task-scheduling ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:integration-platform-as-a-service,
        ngm:low-code-platforms ;
    vc:requires ngm:api-integration,
        ngm:data-pipeline,
        ngm:event-streaming ;
    vc:slug "workflow-automation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:bpmn,
        ngm:dmn ;
    vc:uses ngm:agentic-ai,
        ngm:event-driven-architecture,
        ngm:function-calling,
        ngm:orchestration,
        ngm:state-machine .

ngm:dao a owl:Class ;
