    vc:requires ngm:software-engineering ;
    vc:slug "asynchronous-programming" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:distributed-computing ;
    vc:uses ngm:multithreading,
        ngm:python .

