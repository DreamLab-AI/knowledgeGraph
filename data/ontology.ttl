# Virtual Scouting
spatial-computing:VirtualScouting rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:PreProduction ;
    rdfs:label "Virtual Scouting"@en ;
    rdfs:comment "The process of exploring and evaluating potential filming locations or virtual production environments using digital tools, VR headsets, 360-degree cameras, and game engines, enabling filmmakers to navigate through locations remotely, compose shots, set up scene blocking, and make creative decisions without physical travel."@en ;
    skos:prefLabel "Virtual Scouting"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-scouting" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-scouting> ;
