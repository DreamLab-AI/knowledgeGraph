# Standardized Asset Classification
mv:StandardizedAssetClassification a owl:Class ;
    rdfs:subClassOf mv:AssetManagement ;
    rdfs:label "Standardized Asset Classification"@en ;
    rdfs:comment "Systematic taxonomies and frameworks for categorizing digital assets including cryptocurrencies, NFTs, and metaverse tokens based on characteristics such as issuance method, value mechanism, rights conferred, fungibility, and redemption properties."@en ;
