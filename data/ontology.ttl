ngm:common-sense-reasoning a owl:Class ;
    rdfs:label "Common Sense Reasoning"@en ;
    rdfs:comment "The capacity of an AI system to draw inferences that humans consider obvious from general background knowledge about the physical world, social norms, causality, and everyday object behaviour — without explicit instruction. It encompasses naive physics, naive psychology, temporal reasoning, spatial reasoning, and social cognition grounded in embodied human experience, and is tested against benchmarks including CommonsenseQA, HellaSwag, WinoGrande, and PIQA."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:world-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:natural-language-understanding,
        ngm:reasoning ;
    vc:contrastsWith ngm:formal-reasoning,
        ngm:logic-programming,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:deep-learning,
        ngm:foundation-models ;
    vc:enables ngm:ai-agents,
        ngm:embodied-ai,
        ngm:natural-language-understanding,
        ngm:question-answering,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:causal-reasoning,
        ngm:naive-physics,
        ngm:spatial-reasoning,
        ngm:temporal-reasoning,
        ngm:theory-of-mind ;
    vc:implements ngm:chain-of-thought,
        ngm:constitutional-ai,
        ngm:neurosymbolic-ai,
        ngm:rlhf ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:collective-intelligence,
        ngm:hallucination ;
    vc:requires ngm:grounding,
        ngm:knowledge-representation,
        ngm:world-model ;
    vc:slug "common-sense-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:knowledge-graph,
        ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:transformer-architecture .

ngm:commonsense-reasoning a owl:Class ;
    rdfs:label "Commonsense Reasoning"@en ;
    rdfs:comment "Commonsense reasoning is the ability of an artificial system to make plausible inferences about everyday situations using broad background knowledge that humans take for granted. It covers naive physics, folk psychology, temporal causality, social norms, and typical cause-and-effect expectations that are rarely stated explicitly in text. It remains a long-standing challenge because such knowledge is vast, tacit, and context-dependent, requiring both large-scale knowledge resources and flexible defeasible inference mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:world-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-base ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        ngm:reasoning ;
