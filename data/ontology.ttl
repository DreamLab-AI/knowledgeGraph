# Minimal Risk AI
artificial-intelligence:MinimalRiskAI rdf:type owl:Class ;
    rdfs:label "Minimal Risk AI"@en ;
    rdfs:comment "AI systems not classified as prohibited, high-risk, or limited-risk. These systems face no specific AI Act obligations beyond the general legal framework applicable to all products and services."@en ;
    skos:prefLabel "Minimal Risk AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:minimal-risk-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:minimal-risk-ai> ;
