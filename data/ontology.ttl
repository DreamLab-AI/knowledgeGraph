    vc:supports ngm:sybil-resistance ;
    vc:uses ngm:hash-function ;
    vc:uses ngm:preimage-resistance .
ngm:hashed-timelock-contract a owl:Class ;
    rdfs:comment "A Hashed Timelock Contract (HTLC) is a conditional payment construct that locks funds until either a recipient reveals a preimage matching a published hash, or a timeout elapses and the funds revert to the sender. By combining a hashlock with a timelock, it enables trustless, atomic transfers without a central intermediary. HTLCs are the foundational primitive behind Lightning Network payment routing and cross-chain atomic swaps."@en ;
    rdfs:label "Hashed Timelock Contract"@en ;
    rdfs:subClassOf ngm:lightning-network ;
    rdfs:subClassOf _:r11574 ;
    rdfs:subClassOf _:r11575 ;
