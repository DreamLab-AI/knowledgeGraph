    rdfs:comment "A convergent set of nascent and rapidly maturing technologies—including decentralised identity, linked data, nostr key-pair agents, lightning-network micropayments, and knowledge graph tooling—that together enable a new paradigm of interoperable, agent-driven digital infrastructure. The stack combines protocol-level primitives with knowledge management and collaborative AI to support autonomous, verifiable workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linked-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identity-did ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:agentic-ai,
        ngm:version-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralized-identity-did,
        ngm:knowledge-graph,
        ngm:linked-data ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:interoperability ;
    vc:slug "decentralised-agentic-infrastructure-stack" ;
    vc:sourceDomain "infrastructure" .

