ngm:digital-property-rights a owl:Class ;
    rdfs:label "Digital Property Rights"@en ;
    rdfs:comment "Digital Property Rights are the legally and technically enforceable claims governing ownership, transfer, and use of digital assets and virtual content. They encompass intellectual property protections, on-chain ownership assertions via non-fungible tokens, licensing frameworks, and governance rules that determine who can access, modify, or commercialise digital objects within virtual and mixed-reality environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-asset-management,
        ngm:digital-ownership ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:regulatory-compliance ;
    vc:requires ngm:blockchain,
        ngm:digital-governance ;
    vc:slug "digital-property-rights" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:nft,
        ngm:smart-contract .

ngm:digital-security a owl:Class ;
    rdfs:label "Digital Security"@en ;
    rdfs:comment "Digital Security encompasses the technical controls, protocols, and governance frameworks protecting digital systems, data, and identities from unauthorised access, tampering, and exploitation. It integrates cryptographic mechanisms, access management policies, threat detection, and incident response to ensure confidentiality, integrity, and availability of digital assets and infrastructure across networked environments."@en ;
