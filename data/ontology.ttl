# Transparent Data Processing
mv:TransparentDataProcessing a owl:Class ;
    rdfs:subClassOf mv:DataProcessing ;
    rdfs:label "Transparent Data Processing"@en ;
    rdfs:comment "Data handling practices that are openly disclosed to users, providing clear information about what data is collected, how it is processed, who has access, and for what purposes, enabling informed consent and accountability."@en ;
    skos:prefLabel "Transparent Data Processing"@en ;
    dcterms:identifier "MV-10087" ;
