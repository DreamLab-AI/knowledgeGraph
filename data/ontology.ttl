    vc:enables ngm:carbon-accounting,
        ngm:esg-reporting,
        ngm:green-finance,
        ngm:impact-investing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:high-level-political-forum,
        ngm:sdg-targets-and-indicators,
        ngm:voluntary-national-reviews ;
    vc:implements ngm:addis-ababa-action-agenda,
        ngm:paris-agreement ;
    vc:isPartOf ngm:2030-agenda-for-sustainable-development,
        ngm:un-global-governance-framework ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:environmental-standards,
        ngm:esg-investing,
        ngm:global-inequality,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:environmental-sustainability,
        ngm:multilateral-cooperation,
        ngm:official-development-assistance,
        ngm:sustainability-reporting ;
    vc:slug "sustainable-development-goals" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:un-statistical-commission,
        ngm:united-nations ;
    vc:supports ngm:climate-action,
        ngm:poverty-reduction .

ngm:synchronous-collaboration a owl:Class ;
    rdfs:label "Synchronous Collaboration"@en ;
    rdfs:comment "\"Real-time interaction mode where distributed participants engage simultaneously through technology-mediated channels, enabling immediate feedback, spontaneous ideation, and social presence comparable to co-located teamwork.\""@en ;
    rdfs:subClassOf ngm:dc-communication,
        ngm:telecollaboration ;
    skos:broader ngm:dc-communication ;
