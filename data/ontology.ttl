ngm:anonymous-credential a owl:Class ;
    rdfs:label "Anonymous Credential"@en ;
    rdfs:comment "An anonymous credential is a cryptographic attestation that lets a holder prove possession of certified attributes to a verifier without revealing their identity or allowing their presentations to be linked. Built on techniques such as blind signatures and zero-knowledge proofs, it supports selective disclosure of individual attributes while keeping the rest private. Anonymous credentials are a core privacy-enhancing primitive for authentication and access control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:digital-identity ;
    vc:enables ngm:selective-disclosure,
        ngm:unlinkability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:verifiable-credential-vc ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:self-sovereign-identity,
        ngm:verifiable-credential-vc ;
    vc:requires ngm:cryptographic-primitive ;
    vc:slug "anonymous-credential" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy,
        ngm:pseudonymity ;
    vc:uses ngm:zero-knowledge-proof .

ngm:antenna-array a owl:Class ;
    rdfs:label "Antenna Array"@en ;
    rdfs:comment "An Antenna Array is a set of multiple antenna elements arranged and phased together so that their combined radiation pattern can be electronically steered and shaped. By controlling the relative phase and amplitude of each element, the array forms directional beams, increases gain, and supports spatial multiplexing in techniques such as MIMO and beamforming. Arrays are foundational to modern wireless radio, 5G, radar, and precise satellite positioning receivers."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:wireless-radio ;
    vc:slug "antenna-array" ;
    vc:sourceDomain "infrastructure" .

ngm:anycast-routing a owl:Class ;
    rdfs:label "Anycast Routing"@en ;
    rdfs:comment "Anycast routing is a network addressing and routing technique in which a single IP address is advertised from multiple geographically distributed locations, and packets are delivered to whichever instance is nearest by the routing metric. It uses standard internet routing to steer each client to the closest available node, reducing latency and distributing load without client awareness. Anycast underpins resilient DNS, content delivery, and DDoS mitigation by enabling automatic failover and traffic absorption across many sites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:geographic-distribution ],
        ngm:routing ;
    vc:bridgesTo ngm:edge-computing ;
    vc:dependsOn ngm:load-balancing ;
    vc:enables ngm:failover,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:latency,
        ngm:load-balancer ;
    vc:requires ngm:geographic-distribution ;
    vc:slug "anycast-routing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cdn,
        ngm:dns ;
    vc:uses ngm:ip-addressing,
        ngm:network-routing .

ngm:application-development a owl:Class ;
    rdfs:label "Application Development"@en ;
    rdfs:comment "Application development is the systematic process of designing, building, testing, and deploying software applications to meet specified user or organisational requirements, encompassing activities from requirements analysis through to release and maintenance. It involves selecting appropriate technology stacks, architectural patterns, and development methodologies to produce reliable, maintainable, and performant software. The discipline spans mobile, web, desktop, and embedded application domains, each with distinct toolchains and constraints."@en ;
