ngm:federated-identity-system a owl:Class ;
    rdfs:comment "A federated identity system enables a user's digital identity and authentication to be recognised across multiple independent organisations or domains without each maintaining separate credentials. It relies on trust relationships between identity providers and relying parties, exchanging assertions via protocols such as SAML, OpenID Connect, and OAuth. Federation underpins single sign-on, cross-organisation access, and trust-framework governance."@en ;
    rdfs:label "Federated Identity System"@en ;
    rdfs:subClassOf ngm:identity-management ;
