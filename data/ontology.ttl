    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "real-time-digital-twin-synchronization" ;
    vc:sourceDomain "spatial-computing" .

ngm:real-time-language-translation a owl:Class ;
    rdfs:label "Real-Time Language Translation"@en ;
    rdfs:comment "\"The use of artificial intelligence-powered natural language processing to automatically translate spoken or written communication between languages during live telepresence interactions with sub-second latency, enabling cross-lingual collaboration without human interpreters through neural machin..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-machine-translation ],
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:cross-lingual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:neural-machine-translation ;
    vc:slug "real-time-language-translation" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:recall a owl:Class ;
    rdfs:label "Recall"@en ;
    rdfs:comment "A classification performance metric representing the proportion of actual positive instances that an artificial intelligence model correctly identifies, calculated as the ratio of true positives to all actual positives (true positives plus false negatives), measuring the model's completeness in d..."@en ;
    rdfs:subClassOf ngm:evaluation-metric,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:slug "recall" ;
    vc:sourceDomain "spatial-computing" .

ngm:rectified-flow a owl:Class ;
    rdfs:label "Rectified Flow"@en ;
    rdfs:comment "Rectified Flow is a generative modelling framework that trains a velocity field to transport samples along straight-line trajectories in the ODE sense between a source noise distribution and a target data distribution. By reflow iterations—repeatedly pairing coupled samples and re-training—the learned trajectories become increasingly linear, minimising the number of function evaluations (NFEs) required at inference time. The approach unifies flow matching and score-based diffusion models, offering competitive image and video generation quality with substantially faster sampling compared to standard diffusion schedules."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:flow-matching ;
    vc:slug "rectified-flow" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model .

ngm:remotely-operated-vehicle-rov a owl:Class ;
    rdfs:label "Remotely Operated Vehicle (ROV)"@en ;
    rdfs:comment "A Remotely Operated Vehicle (ROV) is a tethered underwater robot controlled by a human operator at the surface via a cable that supplies electrical power and bidirectional communications. ROVs are deployed for inspection, maintenance, and intervention tasks in environments too hazardous or deep for human divers, including oil and gas infrastructure, offshore wind farms, and scientific ocean exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-robot-type,
        ngm:underwater-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:camera,
        ngm:control-system,
        ngm:sensor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:inspection-robot,
        ngm:marine-robot,
        ngm:robotics ;
    vc:slug "remotely-operated-vehicle-rov" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:navigation,
        ngm:sensor-fusion .

ngm:render-target a owl:Class ;
    rdfs:label "Render Target"@en ;
    rdfs:comment "A memory buffer or texture surface to which a GPU writes the output of a rendering pass, including the default framebuffer displayed on screen and off-screen targets used for post-processing effects, shadow maps, reflections, and multi-pass rendering in real-time graphics pipelines."@en ;
    rdfs:subClassOf ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pixel-shader,
        ngm:shader,
        ngm:vertex-shader ;
    vc:slug "render-target" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute .

ngm:reputation-data a owl:Class ;
    rdfs:label "Reputation Data"@en ;
    rdfs:comment "A structured dataset containing historical records of user behavior, transaction outcomes, peer feedback, and trust metrics used to calculate reputation scores in peer-to-peer systems and virtual communities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-history ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:reputation-system,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:access-control,
        ngm:community-moderation,
        ngm:fraud-detection,
        ngm:trust-scoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavioral-pattern,
        ngm:feedback-score,
        ngm:transaction-history,
        ngm:trust-indicator ;
    vc:isPartOf ngm:reputation-system,
        ngm:social-graph,
        ngm:trust-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-storage,
        ngm:identity-provider,
        ngm:timestamp-service ;
    vc:slug "reputation-data" ;
    vc:sourceDomain "spatial-computing" .

ngm:reputation-scoring-model a owl:Class ;
    rdfs:label "Reputation Scoring Model"@en ;
    rdfs:comment "An algorithmic process that computes quantitative reputation scores by aggregating behavioral data, applying weighted scoring functions, implementing temporal decay, and evaluating threshold conditions to generate trust indicators for entities in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reputation-data ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control-decisions,
        ngm:governance-voting-weight,
        ngm:risk-assessment,
        ngm:trust-score-metric ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:behavioral-data-aggregator,
        ngm:temporal-decay-engine,
        ngm:threshold-evaluator,
        ngm:weighted-scoring-function ;
    vc:isPartOf ngm:trust-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:behavioral-models,
        ngm:reputation-data,
        ngm:scoring-algorithms,
        ngm:validation-rules ;
    vc:slug "reputation-scoring-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:rescue-robot a owl:Class ;
    rdfs:label "Rescue Robot"@en ;
    rdfs:comment "A Rescue Robot is a specialised mobile robot engineered to operate in hazardous, unstructured environments—including collapsed structures, disaster zones, and nuclear incidents—where direct human presence is unsafe. Such systems integrate multimodal locomotion (tracked, wheeled, or legged), sensor suites (IR, LIDAR, acoustic, tactile), and teleoperation or autonomous navigation to locate, assess, and extract casualties or gather situational data. Conformance with safety standards such as ISO 8373 and participation in benchmarks such as the RoboCup Rescue Robot League drives continuous capability development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:functional-safety ;
    vc:requires ngm:autonomous-navigation,
        ngm:sensor-fusion ;
    vc:slug "rescue-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:human-robot-interaction,
        ngm:path-planning .

ngm:resolution-test-chart a owl:Class ;
    rdfs:label "Resolution Test Chart"@en ;
    rdfs:comment "Standardized calibration patterns such as ISO 12233 charts used to measure and validate the optical resolution, colour accuracy, and image quality of displays in virtual reality and augmented reality headsets through computational analysis."@en ;
    rdfs:subClassOf ngm:calibration-tools,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:display-calibration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "resolution-test-chart" ;
    vc:sourceDomain "spatial-computing" .

ngm:revenue-distribution a owl:Class ;
    rdfs:label "Revenue Distribution"@en ;
    rdfs:comment "Revenue Distribution is the mechanism by which income generated by a platform, protocol, or creative ecosystem is allocated among contributors, token holders, and operational costs. In Web3 and spatial computing contexts, it is commonly encoded in smart contracts via tokenomics rules, protocol fee splits, and DAO-governed treasury allocations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:economic-systems ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:treasury-management ;
    vc:requires ngm:smart-contract,
        ngm:tokenomics ;
    vc:slug "revenue-distribution" ;
    vc:sourceDomain "spatial-computing" .

ngm:revenue-sharing a owl:Class ;
    rdfs:label "Revenue Sharing"@en ;
    rdfs:comment "Blockchain-enabled distribution mechanisms that automatically allocate earnings between creators, platforms, and stakeholders through smart contracts, with NFT royalties providing perpetual income streams for digital asset creators in metaverse economies."@en ;
    rdfs:subClassOf ngm:creator-economy,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:creator-monetization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "revenue-sharing" ;
    vc:sourceDomain "spatial-computing" .

ngm:right-to-be-forgotten a owl:Class ;
    rdfs:label "Right to Be Forgotten"@en ;
    rdfs:comment "A privacy right framework enabling individuals to request deletion or removal of personal data from online platforms and databases, with verification and audit mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:infra-legal-and-regulatory,
        ngm:privacy-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
