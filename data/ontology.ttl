ngm:api-monetisation a owl:Class ;
    rdfs:comment "The practice of generating revenue directly from programmatic interfaces by metering consumption and charging for it — through subscription tiers, pay-per-call and usage-based pricing, revenue sharing, or machine-payable protocols such as L402 — turning an API from an integration mechanism into a product with its own pricing, packaging, billing, and developer-experience lifecycle."@en ;
    rdfs:label "API Monetisation"@en ;
    rdfs:subClassOf ngm:api-management ;
