ngm:real-time-monitoring a owl:Class ;
    rdfs:label "Real-Time Monitoring"@en ;
    rdfs:comment "Real-time monitoring is the continuous collection, processing, and presentation of operational data with sufficiently low latency that the resulting insights can drive immediate decision-making or automated responses. It encompasses telemetry ingestion from sensors and software agents, stream processing to detect anomalies or threshold violations, and dashboard visualisation for human operators. Real-time monitoring is fundamental to industrial control systems, network operations centres, AI model serving, and smart infrastructure management. The discipline balances completeness of observation against the computational and bandwidth cost of high-frequency data collection."@en ;
    rdfs:subClassOf ngm:real-time-processing ;
    vc:enables ngm:ai-monitoring,
        ngm:compliance-monitoring,
        ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:performance-metrics,
        ngm:real-time ;
    vc:slug "real-time-monitoring" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:anomaly-detection,
        ngm:io-t-sensor-network,
        ngm:monitoring-dashboard .

ngm:runtime-environment a owl:Class ;
    rdfs:label "Runtime Environment"@en ;
    rdfs:comment "A Runtime Environment provides the execution context in which application code runs, managing memory allocation, code interpretation or compilation, system resource access, and cross-platform compatibility. In spatial computing, runtime environments span browser-based JavaScript engines with WebXR and WebGPU APIs, native frameworks such as Unity's IL2CPP and Unreal's C++ runtime, and standards such as WebAssembly that enable near-native performance across diverse hardware."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:game-engine,
        ngm:scripting-language ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "runtime-environment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:3-d-rendering-engine,
        ngm:cross-platform-interoperability ;
    vc:uses ngm:virtual-machine,
        ngm:web-assembly .

ngm:scalability a owl:Class ;
    rdfs:label "Scalability"@en ;
    rdfs:comment "Scalability is the property of a system that describes its capacity to handle increasing workloads by adding resources, without proportionate degradation in performance, cost efficiency, or reliability. Horizontal scalability adds more nodes to a distributed cluster; vertical scalability increases the resources of existing nodes. In distributed systems, achieving linear or near-linear scalability requires careful attention to coordination overhead, data partitioning strategies, and consistency trade-offs as captured by the CAP theorem. Scalability is a first-order design concern in cloud-native architectures, blockchain networks, and AI inference platforms serving large user populations."@en ;
    rdfs:subClassOf ngm:scalable-architecture ;
    vc:enables ngm:fault-tolerance,
        ngm:high-performance-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:distributed-architecture,
        ngm:performance-optimization,
        ngm:resilience,
        ngm:scalability-pattern ;
    vc:slug "scalability" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-systems,
        ngm:kubernetes,
        ngm:microservices-architecture .

ngm:soft-robotics a owl:Class ;
    rdfs:label "Soft Robotics"@en ;
    rdfs:comment "Robotics discipline employing compliant, flexible materials enabling safe human interaction and adaptation to unstructured environments, with applications across surgical robotics, food handling automation, wearable assistive devices, and collaborative manufacturing—advancing through bio-inspired..."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:reinforcement-learning ;
    vc:slug "soft-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:machine-learning,
        ngm:physics-engine,
        ngm:simulation .

ngm:symmetric-encryption a owl:Class ;
    rdfs:label "Symmetric Encryption"@en ;
    rdfs:comment "A cryptographic mod using a single shared secret key for both encryption and decryption, requiring secure key exchange between parties before communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-derivation-function ],
        ngm:bc-cryptographic-primitive,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:confidential-transactions ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:key-derivation-function ;
    vc:slug "symmetric-encryption" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:random-number-generation .

ngm:synthetic-media a owl:Class ;
    rdfs:label "Synthetic Media"@en ;
    rdfs:comment "Synthetic Media encompasses digitally generated or algorithmically manipulated audio, video, image, and text content produced by AI systems including generative adversarial networks, diffusion models, and large language models. It includes deepfakes, AI-generated video, voice cloning, and text-to-image outputs. Synthetic media raises significant concerns around misinformation, identity fraud, and content authenticity, driving the development of detection techniques and disclosure standards."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:deepfakes,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:ai-generated-content-disclosure,
        ngm:content-moderation ;
    vc:slug "synthetic-media" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai,
        ngm:video-generation .

ngm:taproot a owl:Class ;
    rdfs:label "Taproot"@en ;
    rdfs:comment "Taproot is a Bitcoin protocol upgrade activated in November 2021 (BIP 340–342) that introduces Schnorr signatures, Merkelised Abstract Syntax Trees (MAST), and Tapscript, collectively improving transaction privacy by making complex scripts indistinguishable from simple key-path spends, enhancing efficiency through signature aggregation, and expanding smart-contract expressiveness on the Bitcoin network."@en ;
    rdfs:subClassOf ngm:bitcoin-improvement-proposals ;
    vc:enables ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-network,
        ngm:bitcoin-script,
        ngm:bitcoin-technical-overview ;
    vc:slug "taproot" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-primitive,
        ngm:cryptographic-signature .

ngm:transaction-pool a owl:Class ;
    rdfs:label "Transaction Pool"@en ;
    rdfs:comment "The Transaction Pool (mempool) is the in-memory distributed data structure held by each full node that stores validated but as-yet-unconfirmed transactions awaiting inclusion in a block. Nodes propagate transactions through the pool via gossip, miners and validators select transactions (typically by fee priority), and the pool is cleared as blocks confirm or transactions expire. Pool size, fee dynamics, and congestion directly determine user-experienced confirmation latency and cost."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:fee-market,
        ngm:miner ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:double-spending,
        ngm:mempool,
        ngm:network-synchronization ;
    vc:slug "transaction-pool" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:gossip-protocol .

ngm:variational-inference a owl:Class ;
    rdfs:label "Variational Inference"@en ;
    rdfs:comment "Variational inference is a Bayesian machine learning method that approximates complex, intractable posterior distributions using a simpler parameterised family by optimising the evidence lower bound (ELBO) via gradient-based methods. Rather than sampling from the posterior as in Markov chain Monte Carlo approaches, variational inference reframes posterior estimation as an optimisation problem, making it tractable for large-scale models. It is the foundational inference mechanism underlying Variational Autoencoders and is widely applied in probabilistic topic modelling, latent variable models, and Bayesian deep learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bayesian-inference ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:generative-model,
        ngm:vae ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:latent-space ;
    vc:requires ngm:bayesian-inference ;
    vc:slug "variational-inference" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:vertex-shader a owl:Class ;
    rdfs:label "Vertex Shader"@en ;
    rdfs:comment "A mandatory, programmable GPU stage that processes individual vertices within the graphics pipeline, transforming 3D coordinates through model, view, and projection matrices into clip space whilst computing per-vertex attributes such as normals, texture coordinates, and lighting terms that are subsequently interpolated across primitives for the fragment shader."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:pixel-shader ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:shader ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:compute-shader,
        ngm:visual-effects ;
    vc:slug "vertex-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:rasterization .

ngm:virtual-machine a owl:Class ;
    rdfs:label "Virtual Machine"@en ;
    rdfs:comment "A sandboxed runtime environment that executes smart contract bytecode deterministically across distributed nodes, translating high-level contract code into low-level operations whilst metering computational resource consumption and enforcing state-transition rules. The Ethereum Virtual Machine is the canonical reference implementation, with alternatives including WebAssembly-based runtimes for improved performance."@en ;
    rdfs:subClassOf ngm:computing-infrastructure,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:smart-contract-execution ;
    vc:slug "virtual-machine" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-system ;
    vc:uses ngm:blockchain,
        ngm:cryptography .

ngm:visual-odometry a owl:Class ;
    rdfs:label "Visual Odometry"@en ;
    rdfs:comment "Visual odometry (VO) is a technique for incrementally estimating the pose (position and orientation) of a camera-equipped agent by detecting and tracking salient features across consecutive image frames and computing the relative camera motion between them. It provides ego-motion estimation without relying on GPS, wheel encoders, or external beacons, making it applicable in GPS-denied environments such as indoor spaces, underground tunnels, and planetary surfaces. Visual odometry is typically combined with inertial measurement data (visual-inertial odometry, VIO) or loop-closure detection to bound drift and form complete SLAM systems."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inertial-measurement-unit,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "visual-odometry" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:feature-extraction .

ngm:volumetric-capture a owl:Class ;
    rdfs:label "Volumetric Capture"@en ;
    rdfs:comment "Volumetric Capture is the process of recording a subject or environment in three dimensions using arrays of cameras, depth sensors, or LiDAR to produce a fully navigable 4D (space + time) representation. The resulting volumetric video or point-cloud sequences can be rendered from any viewpoint, enabling photorealistic holographic telepresence, immersive sports broadcasting, and digital twin creation for spatial computing platforms."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:real-time-rendering ;
    vc:slug "volumetric-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:photogrammetry,
        ngm:point-cloud .

ngm:xr-hardware a owl:Class ;
    rdfs:label "XR Hardware"@en ;
    rdfs:comment "XR Hardware encompasses the physical devices — head-mounted displays, spatial computing headsets, hand-tracking controllers, and wearable sensors — that enable augmented, mixed, and virtual reality experiences. These devices integrate display optics, inertial measurement units, inside-out tracking cameras, and wireless connectivity to render immersive spatial content with minimal latency."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback ;
    vc:slug "xr-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:eye-tracking,
        ngm:spatial-computing .

ngm:3-d-asset-standard a owl:Class ;
    rdfs:label "3D Asset Standard"@en ;
    rdfs:comment "3D Asset Standard is a technology infrastructure concept and a type of infrastructure."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
