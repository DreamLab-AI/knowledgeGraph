    vc:uses ngm:knowledge-graph,
        ngm:slot-filling .

ngm:differential-equations a owl:Class ;
    rdfs:label "Differential Equations"@en ;
    rdfs:comment "Equations relating a function to its derivatives, used to model how quantities change with respect to one or more independent variables; foundational to physics, engineering, biology, and modern machine-learning architectures such as neural ODEs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calculus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ordinary-differential-equation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-differential-equation ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:complex-systems,
        ngm:robotics ;
    vc:dependsOn ngm:calculus,
