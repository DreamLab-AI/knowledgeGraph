        ngm:picontrol ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:bandwidth-design,
        ngm:controller-tuning,
        ngm:noise-filtering,
        ngm:stability-analysis,
        ngm:velocity-estimation ;
    vc:slug "velocity-control" ;
    vc:sourceDomain "robotics" .

ngm:verifiable-credential-surface a owl:Class ;
    rdfs:label "Verifiable Credential Surface"@en ;
    rdfs:comment "A standardised JSON-LD 1.1 surface (S3) for issuing and storing W3C Verifiable Credentials 2.0|W3C VC 2.0 credentials signed by agents' DID Nostr Identity|did:nostr DIDs using Schnorr Signature|Schnorr signatures over JCS Canonicalisation|JCS-canonicalised payloads, enabling v..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-ld-1-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-issuance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256-hashing ],
