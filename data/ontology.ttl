        ngm:identity-verification ;
    vc:slug "right-to-be-forgotten" ;
    vc:sourceDomain "infrastructure" .

ngm:rigid-body a owl:Class ;
    rdfs:label "Rigid Body"@en ;
    rdfs:comment "A Rigid Body is an idealised mechanical object whose internal distances between all constituent points remain constant regardless of applied forces, making it the foundational abstraction for classical mechanics, robotic kinematics, and physics simulation. In robotics, links of a kinematic chain are modelled as rigid bodies connected by joints; their mass, centre of gravity, and inertia tensor parameterise the dynamics equations used for motion planning, control, and simulation. Rigid body assumptions break down for flexible or soft-robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:control-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:kinematics ;
    vc:isPartOf ngm:robot-component ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "rigid-body" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:forward-kinematics,
        ngm:inverse-kinematics .

ngm:ritual-artifact a owl:Class ;
    rdfs:label "Ritual Artifact"@en ;
    rdfs:comment "Digital objects within virtual worlds that hold cultural, spiritual, or ceremonial significance, often represented as NFTs enabling communities to preserve and share cultural heritage through blockchain-verified authenticity and ownership."@en ;
    rdfs:subClassOf ngm:digital-heritage,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-cultural-heritage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ritual-artifact" ;
    vc:sourceDomain "spatial-computing" .

ngm:robot-singularity a owl:Class ;
    rdfs:label "Robot Singularity"@en ;
    rdfs:comment "A Robot Singularity is a configuration of a serial or parallel robot manipulator at which the Jacobian matrix loses rank, causing the determinant to approach zero. At a singularity, the robot loses one or more degrees of freedom in Cartesian space: it cannot produce force or motion in certain directions, and inverse kinematics solutions become ill-conditioned or non-unique. Singularity avoidance and detection are central problems in motion planning, trajectory generation, and real-time control of robotic arms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:kinematics ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:path-planning ;
    vc:requires ngm:differential-kinematics,
        ngm:inverse-kinematics ;
    vc:slug "robot-singularity" ;
    vc:sourceDomain "robotics" .

ngm:robotics-application a owl:Class ;
    rdfs:label "Robotics Application"@en ;
    rdfs:comment "A deployed use-case or task domain in which robotic systems perform physical or cyber-physical work, spanning industrial automation, telepresence, telemedicine, logistics, hazardous environment inspection, and collaborative human-robot interaction. Robotics applications integrate perception, planning, actuation, and communication subsystems to accomplish domain-specific objectives with varying degrees of autonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-control ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:robotic-telepresence,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-system,
        ngm:human-robot-interaction ;
    vc:requires ngm:robot-control ;
    vc:slug "robotics-application" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:robotic-system,
        ngm:sensor-fusion .

ngm:robotics-telepresence-bridge a owl:Class ;
    rdfs:label "Robotics-Telepresence Bridge"@en ;
    rdfs:comment "\"The conceptual and technical integration between robotics systems and telepresence technologies, where remote operators experience physical presence in distant real-world locations through robot-mediated perception and action, combining robotic manipulation capabilities with telepresence social ..."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:hazardous-environment-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:tele-203-haptic-feedback-telepresence ;
    vc:slug "robotics-telepresence-bridge" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:robust-control a owl:Class ;
    rdfs:label "Robust Control"@en ;
    rdfs:comment "Robust Control is a branch of control theory that designs controllers guaranteeing stable and acceptable performance across a bounded set of model uncertainties and disturbances. It formalises worst-case design requirements through H-infinity and H2 optimisation frameworks, ensuring actuated systems remain within specification even when plant parameters deviate from nominal values."@en ;
    rdfs:subClassOf ngm:control-algorithm,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:adaptive-control ;
    vc:enables ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "robust-control" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:robot-safety,
        ngm:trajectory-control ;
    vc:uses ngm:feedback-control,
        ngm:pid-control .

ngm:royalty-mechanism a owl:Class ;
    rdfs:label "Royalty Mechanism"@en ;
    rdfs:comment "Automated process ensuring creators receive compensation when their assets are resold or used in secondary markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        [ a owl:Restriction ;
