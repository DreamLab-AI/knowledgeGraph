ngm:libertarian-thesis a owl:Class ;
    rdfs:label "Libertarian thesis"@en ;
    rdfs:comment "The Libertarian Thesis, as represented here by Hans-Hermann Hoppe's 'Democracy: The God That Failed', argues that democratic governance systematically expands state power and erodes individual liberties relative to private property-based natural order, and that radical decentralisation, covenant communities, and privatisation of public goods offer a more consistent path to a free society."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:property-rights ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:ai-governance,
        ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:economics ;
    vc:requires ngm:property-rights ;
    vc:slug "libertarian-thesis" ;
    vc:sourceDomain "infrastructure" .

ngm:licensing-requirements a owl:Class ;
    rdfs:label "Licensing Requirements"@en ;
    rdfs:comment "Licensing Requirements are the regulatory authorisation mandates imposed on virtual asset service providers by national or supranational regulators, ranging from state-level money transmitter licences in the United States to jurisdiction-specific crypto licences under EU MiCA, UK FCA, Singapore MAS, and Dubai VARA regimes. Compliance demands operational standards, minimum capital, custody controls, KYC procedures, AML programmes, and ongoing regulatory reporting, with global coverage costing major platforms tens to hundreds of millions of pounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:dependsOn ngm:blockchain,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bc-governance-and-regulation,
        ngm:blockchain-domain ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:requires ngm:anti-money-laundering,
        ngm:regulatory-framework ;
    vc:slug "licensing-requirements" ;
    vc:sourceDomain "blockchain" .

ngm:lies-damn-lies-and-statistics a owl:Class ;
    rdfs:label "Lies Damn Lies and Statistics"@en ;
    rdfs:comment "A critical epistemological lens applied to AI benchmark claims, model capability assessments, and statistical presentations that may mislead through selective metrics, dataset contamination, cherry-picked results, or hallucination. The page collects resources and reasoning for evaluating AI performance claims with rigour, highlighting how large language models can generate plausible but false outputs that resemble statistical truth."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:bias,
        ngm:large-language-models ;
    vc:slug "lies-damn-lies-and-statistics" ;
    vc:sourceDomain "infrastructure" .

ngm:limited-risk-ai a owl:Class ;
    rdfs:label "Limited Risk AI"@en ;
    rdfs:comment "Under the EU AI Act (Article 50), Limited Risk AI denotes systems subject only to transparency obligations—primarily chatbots and deepfake generators—where providers must inform users they are interacting with AI or label synthetic content as artificially generated. These systems face no conformity assessment, but non-compliance attracts fines of up to €7.5 million or 1.5% of global annual turnover."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:bias ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance,
        ngm:regulatory-framework ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:generative-ai,
        ngm:synthetic-media ;
    vc:requires ngm:transparency ;
    vc:slug "limited-risk-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:link-preview a owl:Class ;
    rdfs:label "Link Preview"@en ;
    rdfs:comment "Link Preview is a web infrastructure technique that fetches and parses Open Graph metadata, title, description, and thumbnail from a target URL to generate a rich card preview for display in social feeds, chat applications, or note-taking tools. APIs and Python libraries such as linkpreview and URLMeta automate this extraction, enabling knowledge graphs and collaborative platforms to surface contextual summaries alongside raw hyperlinks."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
