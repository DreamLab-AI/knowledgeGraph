    vc:sourceDomain "metaverse" .

ngm:multi-agent-coordination a owl:Class ;
    rdfs:label "Multi-Agent Coordination"@en ;
    rdfs:comment "Multi-agent coordination is the set of mechanisms and protocols by which a population of autonomous agents organise their individual actions, communications, and resource usage to achieve shared or mutually compatible goals without central command. It encompasses task decomposition and allocation, conflict detection and resolution, synchronisation of parallel workstreams, and the design of incentive structures that align agent behaviour across heterogeneous systems. Coordination differs from simple parallelism in that it requires agents to reason about the intentions and capabilities of peers, adapting their own behaviour accordingly. Contemporary implementations range from classical Distributed Constraint Optimisation Problems (DCOP) to large-language-model orchestration frameworks in which a controller agent delegates subtasks to specialist sub-agents and integrates their outputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conflict-resolution ],
        ngm:multi-agent-systems ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralised-control,
        ngm:single-agent-system ;
    vc:dependsOn ngm:distributed-systems,
        ngm:game-theory ;
    vc:enables ngm:agentic-workflow,
        ngm:distributed-problem-solving,
        ngm:emergent-behaviour ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conflict-resolution,
        ngm:consensus-mechanism,
        ngm:negotiation-protocol,
        ngm:task-allocation ;
    vc:isPartOf ngm:multi-agent-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-communication-language,
        ngm:auction-mechanism,
        ngm:plan-merging ;
    vc:requires ngm:ai-agent,
        ngm:communication-protocol,
        ngm:shared-environment ;
    vc:slug "multi-agent-coordination" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-vehicles,
        ngm:llm-orchestration,
        ngm:robotic-swarm ;
    vc:uses ngm:belief-desire-intention,
        ngm:message-passing,
        ngm:reinforcement-learning .

ngm:multi-step-reasoning a owl:Class ;
    rdfs:label "Multi-Step Reasoning"@en ;
    rdfs:comment "Multi-step reasoning is the capacity of an AI system to solve problems that require chaining several intermediate inferences, rather than mapping an input directly to an answer in a single step. It encompasses decomposing a problem into sub-problems, maintaining and updating intermediate state, and composing partial results into a final solution. In large language models it is elicited through chain-of-thought prompting, tool use, and search over reasoning paths, and it is a primary differentiator between shallow pattern completion and genuine problem-solving competence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-consistency ],
        ngm:reasoning ;
    vc:bridgesTo ngm:automated-reasoning,
        ngm:knowledge-graph-inference ;
    vc:contrastsWith ngm:pattern-matching,
        ngm:single-step-inference ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:large-language-model ;
    vc:enables ngm:autonomous-agent,
        ngm:complex-question-answering,
        ngm:reasoning-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:intermediate-state-tracking,
        ngm:problem-decomposition,
        ngm:step-verification ;
    vc:isPartOf ngm:cognitive-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:llm-agents,
        ngm:mathematical-reasoning,
        ngm:planning,
        ngm:retrieval-augmented-generation ;
    vc:requires ngm:self-consistency,
        ngm:working-memory ;
    vc:slug "multi-step-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:chain-of-thought-prompting,
        ngm:tool-use,
        ngm:tree-of-thought .

ngm:multimodal-ai-architecture-learning a owl:Class ;
    rdfs:label "Multimodal Learning"@en ;
    rdfs:comment "Multimodal learning is a sub-field of machine learning concerned with building models that can process, align, and reason over data from two or more sensory modalities — such as text, images, audio, video, and structured data — within a unified representation space. Models trained multimodally acquire richer, grounded representations than unimodal counterparts by exploiting cross-modal correlations and complementarity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
