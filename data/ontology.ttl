        ngm:data-governance,
        ngm:data-protection,
        ngm:digital-regulation,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:internet-governance,
        ngm:national-security ;
    vc:requires ngm:data-localisation ;
    vc:slug "digital-sovereignty" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:cybersecurity .

ngm:digital-trust a owl:Class ;
    rdfs:label "Digital Trust"@en ;
    rdfs:comment "Digital trust is the confidence that users, organisations, and systems place in the security, privacy, reliability, and integrity of digital services, identities, and transactions. It is established through verifiable mechanisms such as cryptography, certificates, identity assurance, and transparent governance rather than personal familiarity. Digital trust is foundational to e-commerce, online identity, and inter-organisational collaboration, where parties must rely on counterparties and infrastructure they cannot directly inspect."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:trust ;
    vc:bridgesTo ngm:security ;
    vc:dependsOn ngm:authentication,
        ngm:trust-framework ;
    vc:enables ngm:digital-identity,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-established ;
