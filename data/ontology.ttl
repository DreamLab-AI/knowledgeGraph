ngm:self-improvement a owl:Class ;
    rdfs:label "Self Improvement"@en ;
    rdfs:comment "The capacity of an AI system to autonomously modify its own architecture, weights, or learning algorithms to improve performance, generality, or efficiency without direct human intervention. Central to recursive self-improvement scenarios and AI safety research, raising fundamental questions about capability control, value alignment, and the conditions under which iterative self-modification remains aligned with intended objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:curriculum-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:ai-safety-research,
        ngm:artificial-general-intelligence,
        ngm:recursive-self-improvement,
        ngm:reinforcement-learning,
        ngm:value-alignment ;
    vc:requires ngm:machine-learning ;
    vc:slug "self-improvement" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:self-training a owl:Class ;
    rdfs:label "Self Training"@en ;
    rdfs:comment "A semi-supervised learning technique where a model is iteratively improved by training on its own high-confidence predictions on unlabelled data. Self-training enables learning from large amounts of unlabelled data by using the model's own predictions as pseudo-labels."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:semi-supervised-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:active-learning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:semi-supervised-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation ;
    vc:slug "self-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transfer-learning .

ngm:sentence-piece a owl:Class ;
    rdfs:label "SentencePiece"@en ;
    rdfs:comment "SentencePiece is a language-independent subword tokenisation library that processes raw Unicode text without language-specific pre-tokenisation, learning vocabulary units via Byte-Pair Encoding or the Unigram Language Model directly from corpora. It produces fully reversible, fixed-vocabulary tokenisations widely used in multilingual large language models such as T5, mT5, and ALBERT, and is particularly valuable for languages lacking explicit word boundaries."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:tokenisation ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:word-piece ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenisation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "sentence-piece" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:subword-tokenisation .

ngm:serious-incident a owl:Class ;
    rdfs:label "Serious Incident"@en ;
    rdfs:comment "Under EU AI Act Article 3(44), a Serious Incident is any incident or malfunctioning of an AI system that directly or indirectly causes death, serious health damage, serious disruption of critical infrastructure, or serious infringement of fundamental rights. Such incidents trigger mandatory reporting obligations for providers and deployers of high-risk AI systems and GPAI models with systemic risk, enabling rapid regulatory response and market surveillance under Article 73."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:market-surveillance-authority ],
        ngm:metaverse-and-spatial-risks,
