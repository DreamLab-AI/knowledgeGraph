ngm:textual-inversion a owl:Class ;
    rdfs:label "Textual Inversion"@en ;
    rdfs:comment "Textual inversion is a fine-tuning technique for text-to-image diffusion models that learns a new embedding vector for a placeholder token from a handful of example images, capturing a specific subject or style without altering the model weights. The learned pseudo-word can then be composed into prompts like any ordinary token. It is lightweight and shareable because only a small embedding, not the full network, is trained."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:kohya-dreambooth-and-similar ;
    vc:slug "textual-inversion" ;
    vc:sourceDomain "ai" .

ngm:time-of-flight-sensor a owl:Class ;
    rdfs:label "Time-of-Flight Sensor"@en ;
    rdfs:comment "A time-of-flight (ToF) sensor measures distance by emitting a light signal, typically infrared, and timing how long it takes to reflect back from a surface, yielding a per-pixel depth map. Because it directly measures travel time, it produces depth in real time without the baseline geometry needed by stereo cameras. ToF sensors are widely used for hand and gesture tracking, scene reconstruction, and mixed-reality depth sensing."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hand-tracking,
        ngm:mixed-reality ;
    vc:slug "time-of-flight-sensor" ;
    vc:sourceDomain "robotics" .

ngm:time-sensitive-networking a owl:Class ;
    rdfs:label "Time-Sensitive Networking"@en ;
    rdfs:comment "Time-Sensitive Networking (TSN) is a set of IEEE 802.1 standards that add deterministic, bounded-latency delivery to standard Ethernet, enabling time-critical and best-effort traffic to share the same network. TSN provides precise time synchronisation, traffic scheduling, frame preemption, and reservation mechanisms so that control-loop and audio-video data arrive within guaranteed time windows. It is foundational to industrial automation, automotive in-vehicle networks, and professional media, replacing proprietary fieldbuses with converged standard Ethernet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethernet ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:automotive-ethernet,
        ngm:industry-4-0,
        ngm:operational-technology ;
    vc:contrastsWith ngm:best-effort-networking,
        ngm:fieldbus,
        ngm:profinet ;
    vc:enables ngm:converged-network,
        ngm:deterministic-networking,
        ngm:industrial-automation,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credit-based-shaper,
        ngm:frame-preemption,
        ngm:stream-reservation-protocol,
        ngm:time-aware-shaper ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:avb,
        ngm:communication-protocol,
        ngm:networking-standard ;
    vc:requires ngm:ethernet,
        ngm:network-switch,
        ngm:precision-time-protocol ;
    vc:slug "time-sensitive-networking" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ieee-802-1 ;
    vc:uses ngm:clock-synchronization,
        ngm:quality-of-service,
        ngm:traffic-scheduling .

ngm:time-series-database a skos:Concept ;
    rdfs:label "Time Series Database"@en .

ngm:tokenised-securities a owl:Class ;
    rdfs:label "Tokenised Securities"@en ;
    rdfs:comment "Tokenised securities are regulated financial instruments such as equities, bonds, or fund units issued and transferred as blockchain tokens that carry the same legal rights as their traditional counterparts. They embed compliance logic, including transfer restrictions and investor accreditation checks, directly into smart contracts so that securities laws are enforced programmatically at the point of transaction."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:securities-regulation ;
    vc:slug "tokenised-securities" ;
    vc:sourceDomain "blockchain" .

ngm:tool-registry a owl:Class ;
    rdfs:label "Tool Registry"@en ;
    rdfs:comment "A tool registry is a catalogue that stores the definitions, schemas, permissions, and metadata of the external tools and functions an AI agent can invoke. It enables agents to discover, validate, and route calls to available capabilities at runtime, providing a governed and extensible interface between language models and the systems they act upon."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-internet ;
    vc:slug "tool-registry" ;
    vc:sourceDomain "ai" .

ngm:traceability a owl:Class ;
    rdfs:label "Traceability"@en ;
    rdfs:comment "Traceability is the ability to verify the history, location, or application of an item or piece of information by means of recorded identification. It requires that each unit or event be uniquely identified and that the linkages between successive states be persistently recorded, enabling both forward tracking from origin to destination and backward tracing from any point to its provenance. Traceability is foundational to supply-chain integrity, regulatory compliance, food and pharmaceutical safety, and software and data provenance, and it is increasingly underpinned by tamper-evident ledgers."@en ;
    rdfs:subClassOf ngm:process ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:provenance-tracking,
        ngm:supply-chain-traceability,
        ngm:traceability-mechanism ;
    vc:slug "traceability" ;
    vc:sourceDomain "supply-chain" .

ngm:training-data-distribution a owl:Class ;
    rdfs:label "Training Data Distribution"@en ;
    rdfs:comment "Training data distribution refers to the statistical properties and compositional characteristics of the dataset used to train a machine learning model, including the relative frequencies of classes, the coverage of input feature space, the presence of rare or tail events, and the demographic or domain balance of examples. The training data distribution determines what patterns a model can learn, what it will generalise from, and where it will fail: a model trained on a distribution that differs from the deployment distribution will exhibit degraded performance due to covariate shift or prior probability shift. Deliberate control of training data distribution — through curation, resampling, augmentation, and synthetic data generation — is a primary lever for improving model robustness, fairness, and safety."@en ;
    rdfs:subClassOf ngm:training-data ;
    vc:enables ngm:machine-learning-discipline,
        ngm:training-dataset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias,
        ngm:domain-adaptation,
        ngm:fairness ;
    vc:slug "training-data-distribution" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:data-augmentation-strategies,
        ngm:data-collection,
        ngm:synthetic-data .

ngm:trajectory-optimisation a owl:Class ;
    rdfs:label "Trajectory Optimisation"@en ;
    rdfs:comment "Trajectory optimisation is the computation of a path and control profile for a dynamic system that minimises a cost subject to physical and operational constraints. It is widely used in robotics, aerospace and autonomous vehicles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory ],
        ngm:motion-planning ;
    vc:enables ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-theory,
        ngm:optimisation ;
    vc:slug "trajectory-optimisation" ;
    vc:sourceDomain "robotics" .

ngm:transaction-manager a owl:Class ;
    rdfs:label "Transaction Manager"@en ;
    rdfs:comment "A transaction manager is a software component that coordinates the atomic execution of operations against a database or distributed system, enforcing the ACID properties of atomicity, consistency, isolation, and durability. It governs commit and rollback, manages concurrency control and locking, and in distributed settings orchestrates multi-resource protocols such as two-phase commit."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:graph-database ;
    vc:slug "transaction-manager" ;
    vc:sourceDomain "data" .

ngm:transfer-impact-assessment a owl:Class ;
    rdfs:label "Transfer Impact Assessment"@en ;
    rdfs:comment "A Transfer Impact Assessment (TIA) is a documented evaluation organisations conduct before transferring personal data across borders to determine whether the destination jurisdiction provides protection essentially equivalent to that of the originating data-protection regime. Required in the EU following the Schrems II ruling, a TIA examines the destination's surveillance laws, the legal remedies available to data subjects, and any supplementary technical and organisational measures needed to make the transfer lawful. It is a core compliance artefact for international data flows under the GDPR."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gdpr,
        ngm:privacy ;
    vc:slug "transfer-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance ;
    vc:uses ngm:data-protection .

ngm:trusted-platform-module a skos:Concept ;
    rdfs:label "Trusted Platform Module"@en .

ngm:trustless-settlement a owl:Class ;
    rdfs:label "Trustless Settlement"@en ;
    rdfs:comment "Trustless settlement is a mechanism for finalising financial or asset-transfer transactions in which parties need not extend personal or institutional trust to a counterparty or intermediary because correctness is guaranteed by cryptographic protocols and verifiable distributed consensus. The term reflects the displacement of counterparty trust with algorithmic certainty: smart contracts hold and release assets conditionally on cryptographically verifiable proofs, and immutable ledger state provides objective post-settlement finality. Trustless settlement underpins DeFi protocols, atomic swaps, and cross-chain bridges, enabling transaction finality without custodial banks, clearinghouses, or escrow agents."@en ;
    rdfs:subClassOf ngm:atomic-settlement ;
    vc:enables ngm:decentralized-exchange-dex,
        ngm:permissionless-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:decentralized-finance-de-fi,
        ngm:securities-settlement ;
    vc:slug "trustless-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:instant-value-settlement ;
    vc:uses ngm:consensus-mechanism,
        ngm:smart-contract-coordination,
        ngm:zero-knowledge .

ngm:ultrasonic-sensor a owl:Class ;
    rdfs:label "Ultrasonic Sensor"@en ;
    rdfs:comment "Ultrasonic Sensor is a robotics and autonomous systems concept and a type of robotics."@en ;
