    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:high-risk-ai-system .

ngm:proximal-policy-optimisation a owl:Class ;
    rdfs:label "Proximal Policy Optimisation"@en ;
    rdfs:comment "A reinforcement learning algorithm that updates policies through incremental steps whilst constraining how much the policy can change via a clipped surrogate objective, preventing destabilising updates. PPO is the dominant RL algorithm used in reinforcement learning from human feedback (RLHF) for fine-tuning language models to align with human preferences."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:reinforcement-learning ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:reinforcement-learning-algorithm ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:reinforcement-learning-from-human-feedback ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "proximal-policy-optimisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-feedback,
        ngm:reward-model .

ngm:proximity-detection a owl:Class ;
    rdfs:label "Proximity Detection"@en ;
    rdfs:comment "Proximity Detection is the computational process of determining the spatial distance and relative position between entities—users, objects, or agents—within a virtual or physical environment in real time. In metaverse and robotics contexts it underpins social-distance awareness, collision avoidance, interaction triggering, and context-sensitive content delivery. Implementations range from bounding-volume overlap tests and signed-distance fields in 3D engines to sensor-fusion pipelines combining lidar, ultrasound, and camera inputs in robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:collision-avoidance,
        ngm:presence-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:social-presence ;
    vc:requires ngm:collision-detection,
        ngm:sensor-fusion ;
    vc:slug "proximity-detection" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:lidar,
        ngm:point-cloud .

ngm:python-and-py-torch a owl:Class ;
    rdfs:label "Python and PyTorch"@en ;
    rdfs:comment "Python and PyTorch together form the dominant open-source stack for deep learning research and production. Python provides the high-level scripting environment and ecosystem (NumPy, Hugging Face, spaCy), whilst PyTorch supplies dynamic computational graph execution, autograd differentiation, and GPU acceleration via CUDA, enabling rapid prototyping and deployment of neural network models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:model-training,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "python-and-py-torch" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-pipeline,
        ngm:neural-network-architecture ;
    vc:uses ngm:gpu-compute,
        ngm:machine-learning-framework .

ngm:rapid-prototyping a owl:Class ;
    rdfs:label "Rapid Prototyping"@en ;
    rdfs:comment "Rapid Prototyping is an iterative product development approach that emphasises the construction of quick, low-fidelity or medium-fidelity artefacts—physical mock-ups, interactive wireframes, or functional code spikes—to test hypotheses with users and stakeholders before committing to full implementation. The methodology aims to compress the feedback loop between ideation and validated learning, reducing the risk of building features that do not meet user needs. It draws on lean startup principles, agile sprint structures, and design thinking frameworks, integrating user testing results directly into successive prototype iterations. Modern generative AI tools further accelerate rapid prototyping by auto-generating code scaffolds, UI components, and content variants."@en ;
    rdfs:subClassOf ngm:design-thinking ;
    vc:enables ngm:development-platform,
        ngm:digital-content-creation,
        ngm:product-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:human-computer-interaction,
        ngm:knowledge-management ;
    vc:slug "rapid-prototyping" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:ai-development-tools,
        ngm:collaborative-design,
        ngm:generative-design-tool,
        ngm:user-experience .

ngm:rb-0032-manipulability a owl:Class ;
    rdfs:label "rb 0032 manipulability"@en ;
    rdfs:comment "Manipulability is a scalar or ellipsoid measure of a robotic manipulator's capacity to move and exert forces in arbitrary directions from a given joint configuration. Introduced by Tsuneo Yoshikawa, the manipulability measure w = sqrt(det(J·Jᵀ)) quantifies how far a configuration is from kinematic singularity: higher values indicate greater dexterity, while w = 0 indicates a singular configuration where motion in at least one direction is lost. Manipulability is used in motion planning, redundancy resolution, and task-space control to avoid singular regions."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-kinematics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0031-singularity ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0024-workspace,
        ngm:rb-0037-dexterity ;
    vc:slug "rb-0032-manipulability" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0029-inverse-kinematics,
        ngm:rb-0049-motion-planning .

ngm:rb-0037-dexterity a owl:Class ;
    rdfs:label "rb 0037 dexterity"@en ;
    rdfs:comment "Dexterity, in robotics, is the ability of a manipulator to achieve a broad range of end-effector orientations and positions within its workspace, particularly in the vicinity of a given point, without encountering kinematic singularities. It is quantified by measures such as the Jacobian condition number, manipulability ellipsoid volume, or isotropy index. High dexterity enables a robot arm to approach objects from many angles, reconfigure during a task, and avoid joint limits — properties critical for assembly, surgery, and unstructured manipulation tasks."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0029-inverse-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0024-workspace,
        ngm:rb-0031-singularity,
        ngm:rb-0032-manipulability ;
    vc:slug "rb-0037-dexterity" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:end-effector,
        ngm:manipulation .

ngm:rb-0038-compliance a owl:Class ;
    rdfs:label "rb 0038 compliance"@en ;
    rdfs:comment "In robotics, compliance is the mechanical property of a robot joint or end-effector describing its tendency to yield under applied forces or torques, quantified as the inverse of stiffness. Compliant behaviour is essential for safe human-robot interaction, allowing robots to absorb contact forces without rigid collision, and is actively exploited in impedance and admittance control strategies to achieve gentle, force-sensitive manipulation."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0039-stiffness ;
    vc:enables ngm:human-robot-interaction,
        ngm:rb-0053-force-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0041-inertia,
        ngm:rb-0056-impedance-control,
        ngm:rb-0057-admittance-control ;
    vc:slug "rb-0038-compliance" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-safety .

ngm:rb-0045-acceleration a owl:Class ;
    rdfs:label "rb 0045 acceleration"@en ;
    rdfs:comment "In robotics, acceleration is the rate of change of velocity with respect to time, expressed for each joint (joint-space acceleration) or for the robot's end-effector (task-space acceleration), measured in rad/s² or m/s² respectively. Acceleration profiles govern the dynamic forces and torques that a manipulator must generate, coupling directly into Newton-Euler equations of motion. Limiting acceleration is central to safety (reducing impact forces) and to trajectory smoothness in collaborative applications."@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0041-inertia,
        ngm:rb-0043-torque,
        ngm:rb-0044-velocity ;
    vc:slug "rb-0045-acceleration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0051-trajectory-planning,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0060-optimal-control a owl:Class ;
    rdfs:label "rb 0060 optimal control"@en ;
    rdfs:comment "Optimal control is a branch of control theory that computes control inputs minimising (or maximising) a performance criterion — such as energy consumption, time, or tracking error — subject to system dynamics and constraints. In robotics, optimal control underpins trajectory optimisation, model predictive control, and reinforcement learning-based policy synthesis."@en ;
    rdfs:subClassOf ngm:control-theory,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0064-computed-torque-control ;
    vc:enables ngm:rb-0051-trajectory-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0047-feedback-control,
        ngm:rb-0062-model-predictive-control,
        ngm:reinforcement-learning ;
    vc:slug "rb-0060-optimal-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0022-robot-dynamics,
        ngm:rb-0030-jacobian-matrix .

ngm:rb-0063-sliding-mode-control a owl:Class ;
    rdfs:label "rb 0063 sliding mode control"@en ;
    rdfs:comment "Sliding Mode Control (SMC) is a nonlinear robust control technique that drives system states onto a predefined sliding surface in state space and then maintains them on that surface using discontinuous (switching) control actions. Once on the sliding manifold, the system dynamics become insensitive to matched disturbances and parameter uncertainties, making SMC highly robust for robot manipulators with uncertain dynamics, friction, and external loads. A key challenge is chattering — high-frequency oscillation caused by the switching law — which is addressed through boundary layer methods and higher-order SMC variants."@en ;
    rdfs:subClassOf ngm:control-theory,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0062-model-predictive-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0053-force-control,
        ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:rb-0048-pid-controller,
        ngm:rb-0061-nonlinear-control,
        ngm:robust-control ;
    vc:slug "rb-0063-sliding-mode-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0075-range-finder a owl:Class ;
    rdfs:label "rb 0075 range finder"@en ;
    rdfs:comment "A range finder is an exteroceptive sensor that measures the distance between a robot and surrounding objects or surfaces by emitting a signal (laser, ultrasonic, or infrared) and timing its return. Range finders are fundamental to obstacle detection, safety zone monitoring, and environment mapping in mobile and collaborative robots."@en ;
    rdfs:subClassOf ngm:exteroceptive-sensor,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:rb-0095-safety-zone,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:proximity-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0078-infrared-sensor,
        ngm:rb-0080-radar ;
    vc:slug "rb-0075-range-finder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:point-cloud,
        ngm:sensor-fusion .

ngm:rb-0077-depth-camera a owl:Class ;
    rdfs:label "rb 0077 depth camera"@en ;
    rdfs:comment "A depth camera is a sensor that captures per-pixel distance information alongside a conventional intensity image, producing a registered RGB-D data stream or raw point cloud. In robotics, depth cameras are used for 3D scene reconstruction, obstacle avoidance, object recognition, and SLAM. Common operating principles include structured light projection (e.g. Intel RealSense), time-of-flight measurement, and stereo triangulation; each involves different trade-offs in range, resolution, and outdoor usability."@en ;
    rdfs:subClassOf ngm:camera,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:obstacle-avoidance,
        ngm:point-cloud,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0066-robot-sensor ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0068-vision-system,
        ngm:rb-0069-lidar,
        ngm:stereo-camera ;
    vc:slug "rb-0077-depth-camera" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:simultaneous-localisation-and-mapping,
        ngm:visual-odometry ;
    vc:uses ngm:depth-estimation,
        ngm:depth-sensing .

ngm:real-time-ai a owl:Class ;
    rdfs:label "Real-Time AI"@en ;
    rdfs:comment "Real-Time AI refers to the application of artificial intelligence inference within strict latency bounds — typically sub-second to sub-millisecond — required for time-sensitive tasks such as autonomous driving, robotics control, live speech processing, financial trading, and augmented reality. It integrates specialised hardware (NPUs, GPUs, FPGAs), optimised model representations (quantisation, pruning, TensorRT/ONNX), and edge deployment architectures to ensure deterministic response times. The distinction from batch AI lies in the hard or soft real-time constraints that govern system correctness."@en ;
    rdfs:subClassOf ngm:real-time-computation ;
    vc:enables ngm:autonomous-vehicle,
        ngm:real-time-inference-at-edge,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:real-time-processing ;
    vc:slug "real-time-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:edge-computing,
        ngm:hardware-acceleration,
        ngm:inference-engine,
        ngm:npu .

ngm:real-time-character-animation a owl:Class ;
    rdfs:label "Real Time Character Animation"@en ;
    rdfs:comment "The process of generating and rendering character movements instantaneously during gameplay or interactive experiences, utilizing rigging systems, motion capture data, and procedural animation to create lifelike digital characters that respond dynamically to user input and environmental conditions."@en ;
    rdfs:subClassOf ngm:3-d-animation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:interactive-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "real-time-character-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:realtime-collaboration a owl:Class ;
    rdfs:label "Realtime Collaboration"@en ;
    rdfs:comment "Realtime Collaboration is the capability for multiple geographically distributed users to co-create, co-edit, and synchronise shared digital artefacts—documents, 3D scenes, code, or virtual environments—with sub-second latency, such that all participants observe consistent state simultaneously. Technically, it requires low-latency networking, conflict-resolution mechanisms such as CRDTs or operational transforms, and state-synchronisation protocols to reconcile concurrent edits without data loss."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crdt ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-user-systems ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration,
        ngm:immersive-workspaces,
        ngm:virtual-meeting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-and-telecollaboration,
        ngm:social-presence ;
    vc:requires ngm:crdt,
        ngm:multi-user-systems,
        ngm:network-latency ;
    vc:slug "realtime-collaboration" ;
    vc:sourceDomain "infrastructure" .

ngm:reed-solomon-codes a owl:Class ;
    rdfs:label "Reed-Solomon Codes"@en ;
    rdfs:comment "Reed-Solomon codes are a class of non-binary, cyclic, block error-correcting codes defined over finite fields (Galois fields), capable of correcting both erasures and symbol errors with provably optimal efficiency at the Singleton bound. Introduced by Irving Reed and Gustave Solomon in 1960, they treat data blocks as polynomials over a finite field and encode them by evaluating the polynomial at multiple distinct points, allowing the original polynomial to be reconstructed from any sufficient subset of evaluation points. Reed-Solomon codes underpin data reliability in storage media (CDs, DVDs, RAID), satellite communications, QR codes, and are foundational to erasure-coded distributed storage and modern polynomial commitment schemes used in zero-knowledge proofs."@en ;
    rdfs:subClassOf ngm:error-correction ;
    vc:enables ngm:data-integrity,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:distributed-storage,
        ngm:erasure-coding ;
    vc:slug "reed-solomon-codes" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:blockchain,
        ngm:cryptographic-proof .

ngm:reinforcement-learning-algorithm a owl:Class ;
    rdfs:label "Reinforcement Learning Algorithm"@en ;
    rdfs:comment "Reinforcement Learning Algorithms enable agents to learn optimal decision-making policies through interaction with environments, guided by reward signals. Core families include value-based methods (Q-learning, DQN), policy gradient methods (REINFORCE, PPO, TRPO), and actor-critic approaches (A3C, SAC), all of which balance exploration against exploitation to maximise cumulative expected reward."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:reinforcement-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:reward-function ;
    vc:slug "reinforcement-learning-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:proximal-policy-optimisation .

ngm:replication-system a owl:Class ;
    rdfs:label "Replication System"@en ;
    rdfs:comment "A replication system maintains synchronised copies of data or state across multiple nodes in a distributed environment, ensuring consistency, availability, and fault tolerance. It coordinates state propagation through protocols such as leader-based or leaderless replication, supporting both synchronous and asynchronous update strategies in blockchain, database, and metaverse infrastructure contexts."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-system ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-replication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:database-system ;
    vc:slug "replication-system" ;
    vc:sourceDomain "infrastructure" .

ngm:rgb-protocol a owl:Class ;
    rdfs:label "RGB Protocol"@en ;
    rdfs:comment "RGB Protocol is a client-side validation protocol built on top of Bitcoin and the Lightning Network that enables the issuance and transfer of smart contracts and tokenised assets (fungible and non-fungible) without placing contract state on the blockchain. Instead, RGB stores contract state in off-chain client-side data structures and uses Bitcoin UTXOs as single-use seals, with only cryptographic commitments anchored to Bitcoin transactions. This design inherits Bitcoin's security and censorship resistance while providing scalability, privacy, and programmability not available on-chain."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:enables ngm:asset-tokenization,
        ngm:layer-2-scaling,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:client-side-dco,
        ngm:rgb-and-client-side-validation,
        ngm:taproot-assets ;
    vc:slug "rgb-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-network,
        ngm:cryptographic-commitment,
        ngm:lightning-network,
        ngm:utxo-model .

ngm:ro-berta a owl:Class ;
    rdfs:label "RoBERTa"@en ;
    rdfs:comment "RoBERTa (Robustly Optimised BERT Pretraining Approach) is a transformer-based language model that refines BERT by removing the next-sentence-prediction objective, adopting dynamic masking, training on substantially larger corpora (160 GB vs 16 GB), and using larger batch sizes. These training-procedure improvements yield consistent performance gains on NLP benchmarks without altering the underlying transformer encoder architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:albert ;
    vc:enables ngm:named-entity-recognition,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:language-modeling,
        ngm:transformer-architecture ;
    vc:slug "ro-berta" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:transfer-learning .

ngm:robot-hardware a owl:Class ;
    rdfs:label "Robot Hardware"@en ;
    rdfs:comment "RobotHardware is the integrated electromechanical substrate of robotic systems encompassing all physical components required for autonomous or semi-autonomous operation: compute platforms (NVIDIA Jetson Orin NX/AGX, Raspberry Pi 5, BeagleBone AI-64), real-time microcontrollers (STM32H7, Teensy 4...."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
