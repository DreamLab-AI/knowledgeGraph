        <urn:visionflow:linked:laplace-mechanism>,
        <urn:visionflow:linked:randomised-response>,
        <urn:visionflow:linked:secret-sharing> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
