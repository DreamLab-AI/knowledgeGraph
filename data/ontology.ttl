    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "cardano" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:haskell,
        ngm:ouroboros-consensus,
        ngm:plutus-smart-contract-language .

