ngm:anchorage-digital a owl:Class ;
    rdfs:label "Anchorage Digital"@en ;
    rdfs:comment "A United States digital asset platform that holds a federal bank charter and provides custody, trading, staking, and financing services for institutional clients. It was the first crypto firm to receive a national trust bank charter from the Office of the Comptroller of the Currency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:self-custody ;
    vc:enables ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-compliance ;
    vc:slug "anchorage-digital" ;
    vc:sourceDomain "blockchain" .

