ngm:query-vector a owl:Class ;
    rdfs:label "Query Vector"@en ;
    rdfs:comment "A Query Vector is a dense numerical representation of a search query produced by an embedding model, enabling similarity-based retrieval in a high-dimensional vector space. It is matched against stored document or passage embeddings using distance metrics such as cosine similarity or inner product, forming the core retrieval mechanism in semantic search and retrieval-augmented generation systems. Query vectors encode the semantic intent of a query independent of exact keyword overlap, allowing conceptually related results to be surfaced even when surface-level vocabulary differs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:nearest-neighbor-search,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-model ;
    vc:isPartOf ngm:retrieval-augmented-generation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:query-key-value,
        ngm:query-processor,
        ngm:retrieval-augmented-generation-rag ;
    vc:requires ngm:embedding-model,
        ngm:vector-database ;
    vc:slug "query-vector" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:information-retrieval .

