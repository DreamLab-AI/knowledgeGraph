ngm:accessibility-audit-tool a owl:Class ;
    rdfs:label "Accessibility Audit Tool"@en ;
    rdfs:comment "An automated software utility that verifies compliance with accessibility standards (such as WCAG) in XR environments, identifying barriers for users with disabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility-standards ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:accessibility-reporting,
        ngm:compliance-verification,
        ngm:inclusive-design,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-testing-engine,
        ngm:compliance-dashboard,
        ngm:report-generator,
        ngm:wcag-validator ;
    vc:isPartOf ngm:quality-assurance-toolchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:accessibility-standards,
        ngm:testing-framework,
        ngm:user-interface-analyzer ;
    vc:slug "accessibility-audit-tool" ;
    vc:sourceDomain "spatial-computing" .

ngm:accessibility-captioning a owl:Class ;
    rdfs:label "Accessibility Captioning"@en ;
    rdfs:comment "Accessibility captioning is the practice of producing synchronised textual representations of spoken dialogue, sound effects, and other audio information within video or live media so that deaf, hard-of-hearing, or audio-impaired audiences can fully engage with the content. It encompasses both closed captions (user-selectable, stored separately from the video stream) and open captions (burned into the image), and spans pre-produced transcription and real-time automatic speech recognition pipelines."@en ;
    rdfs:subClassOf ngm:inclusive-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:transparency ;
    vc:slug "accessibility-captioning" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:wcag-2-2 ;
    vc:supports ngm:assistive-technology-integration ;
    vc:uses ngm:natural-language-processing,
        ngm:speech-recognition .

ngm:accountability-ai-0068 a owl:Class ;
    rdfs:label "Accountability (AI-0068)"@en ;
    rdfs:comment "Accountability (AI-0068) is the principle—as codified in AI governance frameworks bearing that reference identifier—that organisations deploying AI systems must be able to demonstrate responsibility for the systems' decisions, provide redress mechanisms when harm occurs, and maintain identifiable human oversight over automated processes. It imposes obligations on developers, deployers, and operators to document, audit, and accept liability for AI-driven outcomes, distinguishing it from the broader ethical principle of accountability by its grounding in specific regulatory or standards-based obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        ngm:accountability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:responsible-ai ;
    vc:requires ngm:ai-audit,
        ngm:explainable-ai ;
    vc:slug "accountability-ai-0068" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-regulation,
        ngm:transparency .

ngm:accountability-oecd a owl:Class ;
    rdfs:label "Accountability (OECD)"@en ;
    rdfs:comment "Organisations and individuals developing, deploying or operating AI systems should be accountable for their proper functioning in accordance with OECD AI Principles and applicable legal frameworks, based on their roles, context and ability to act."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:policy-framework ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:continuous-improvement,
        ngm:effective-governance,
        ngm:redress ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence ;
    vc:slug "accountability-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

