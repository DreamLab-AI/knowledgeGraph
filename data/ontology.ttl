ngm:depth-first-search a owl:Class ;
    rdfs:label "Depth-First Search"@en ;
    rdfs:comment "Depth-first search (DFS) is a graph and tree traversal algorithm that explores as far as possible along each branch before backtracking, following one path to its end before considering alternatives. It is naturally expressed through recursion or an explicit last-in-first-out stack and runs in time linear in the number of vertices and edges. DFS underpins many algorithms including topological sorting, cycle detection, finding connected components and solving maze and constraint problems through systematic backtracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-structure ],
        ngm:graph-algorithms ;
    vc:contrastsWith ngm:breadth-first-search ;
    vc:enables ngm:pathfinding ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:graph-search,
        ngm:search-algorithm ;
    vc:isPartOf ngm:graph-algorithms ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:computer-science,
        ngm:dijkstra-algorithm,
        ngm:search-algorithms ;
    vc:requires ngm:data-structure ;
    vc:slug "depth-first-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:algorithm,
        ngm:graph-theory .

ngm:dev-sec-ops a owl:Class ;
    rdfs:label "DevSecOps"@en ;
    rdfs:comment "DevSecOps is a software engineering practice that integrates security controls, testing, and policy enforcement directly into the continuous integration and delivery pipeline, making security a shared responsibility across development, operations, and security teams. It applies the principle of shift-left security, automating vulnerability scanning, dependency auditing, and policy-as-code checks at every stage from code commit through production deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-as-code ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:penetration-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-security ],
