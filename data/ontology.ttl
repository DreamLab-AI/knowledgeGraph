ngm:computational-photography a owl:Class ;
    rdfs:label "Computational Photography"@en ;
    rdfs:comment "A set of techniques that use digital computation to extend or improve the capabilities of a camera beyond what its optics and sensor alone can capture. It combines multiple exposures, sensor data, and algorithms to form a final image."@en ;
