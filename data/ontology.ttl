ngm:trajectory-optimisation a owl:Class ;
    rdfs:label "Trajectory Optimisation"@en ;
    rdfs:comment "Trajectory optimisation is the computation of a path and control profile for a dynamic system that minimises a cost subject to physical and operational constraints. It is widely used in robotics, aerospace and autonomous vehicles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        ngm:motion-planning ;
    vc:enables ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-theory,
        ngm:optimisation ;
    vc:slug "trajectory-optimisation" ;
    vc:sourceDomain "robotics" .

ngm:transaction-output a owl:Class ;
    rdfs:label "Transaction Output"@en ;
    rdfs:comment "A transaction output is a component of a blockchain transaction that specifies an amount of value and the conditions under which it can later be spent. In UTXO-based systems each output records a value and a locking script that defines who may consume it, and an unspent output becomes the input to a future transaction. Transaction outputs are the fundamental units of ownership and value transfer in such ledgers, and the set of all unspent outputs constitutes the current state of holdings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:script ],
        ngm:blockchain-transaction ;
    vc:bridgesTo ngm:bitcoin ;
    vc:contrastsWith ngm:transaction ;
    vc:enables ngm:unspent-transaction-output ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:script ;
    vc:implements ngm:utxo ;
    vc:isPartOf ngm:blockchain-transaction,
        ngm:transaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:double-spending,
        ngm:unspent-transaction-output ;
    vc:requires ngm:bitcoin ;
    vc:slug "transaction-output" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:utxo ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:script .

ngm:transfer-impact-assessment a owl:Class ;
    rdfs:label "Transfer Impact Assessment"@en ;
    rdfs:comment "A Transfer Impact Assessment (TIA) is a documented evaluation organisations conduct before transferring personal data across borders to determine whether the destination jurisdiction provides protection essentially equivalent to that of the originating data-protection regime. Required in the EU following the Schrems II ruling, a TIA examines the destination's surveillance laws, the legal remedies available to data subjects, and any supplementary technical and organisational measures needed to make the transfer lawful. It is a core compliance artefact for international data flows under the GDPR."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gdpr,
        ngm:privacy ;
    vc:slug "transfer-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance ;
    vc:uses ngm:data-protection .

ngm:transmission-network a owl:Class ;
    rdfs:label "Transmission Network"@en ;
    rdfs:comment "A transmission network is the high-voltage infrastructure that carries bulk electrical power over long distances from generation sites to distribution substations near consumers. Comprising transmission lines, transformers, and switching stations, it minimises resistive losses through high voltages and is operated as a synchronised grid balancing supply and demand in real time."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "transmission-network" ;
    vc:sourceDomain "infrastructure" .

ngm:trust-mechanism a owl:Class ;
    rdfs:label "Trust Mechanism"@en ;
    rdfs:comment "A trust mechanism is a system, protocol, or institution that allows parties who lack prior knowledge of one another to transact or cooperate with reasonable assurance of honest behaviour. Such mechanisms range from intermediaries and reputation systems to cryptographic and consensus protocols that replace interpersonal trust with verifiable, incentive-aligned guarantees."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barter-system,
        ngm:value-transfer ;
    vc:slug "trust-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:ultrasonic-sensor a owl:Class ;
    rdfs:label "Ultrasonic Sensor"@en ;
    rdfs:comment "An electronic sensor that emits ultrasonic sound waves (typically ~40 kHz) and measures the time-of-flight of reflected echoes to determine the distance to objects, widely used in robotics for obstacle detection, proximity sensing, and autonomous navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
