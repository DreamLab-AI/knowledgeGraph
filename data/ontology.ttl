    vc:sourceDomain "spatial-computing" .

ngm:metrics a owl:Class ;
    rdfs:label "Metrics"@en ;
    rdfs:comment "Metrics are numeric, time-series measurements that quantify the state and behaviour of systems, services and infrastructure over time. As one of the three pillars of observability alongside logs and traces, they are typically aggregated counters, gauges and histograms scraped or pushed at regular intervals. Metrics enable efficient trend analysis, alerting and capacity planning at scale because they compress system behaviour into compact, queryable numeric series."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:performance-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        ngm:observability ;
    vc:bridgesTo ngm:observability ;
    vc:contrastsWith ngm:telemetry ;
    vc:dependsOn ngm:telemetry ;
    vc:enables ngm:alerting,
        ngm:performance-monitoring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:performance-monitoring ;
    vc:isPartOf ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:kubernetes,
        ngm:monitoring,
        ngm:performance-monitoring ;
    vc:requires ngm:telemetry ;
    vc:slug "metrics" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:alerting,
        ngm:monitoring,
        ngm:observability ;
    vc:uses ngm:monitoring,
        ngm:telemetry .

ngm:microsoft-copilot a owl:Class ;
    rdfs:label "Microsoft Copilot"@en ;
    rdfs:comment "Microsoft Copilot is a family of AI-powered assistant products developed by Microsoft and embedded across its software ecosystem, including Windows, Microsoft 365, the Edge browser, GitHub, and Azure. The system builds on large language models from OpenAI (GPT-4 series) combined with Microsoft's own retrieval augmentation over Microsoft Graph, enabling context-aware responses grounded in a user's documents, emails, meetings, and calendar data. Enterprise deployments offer tenancy-scoped data access with existing permission boundaries, distinguishing Copilot from general-purpose chatbots. GitHub Copilot, a precursor product launched in 2021, provides AI-assisted code completion, chat, and pull-request summarisation inside developer environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:azure,
        ngm:role-based-access-control ;
    vc:contrastsWith ngm:google-ai-technology-corporation-gemini ;
    vc:enables ngm:code-generation,
        ngm:conversational-ai,
        ngm:document-summarisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:prompt-engineering,
        ngm:responsible-ai ;
    vc:isPartOf ngm:azure,
        ngm:microsoft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-ai,
        ngm:github-copilot,
        ngm:openai-research-organisation ;
    vc:requires ngm:large-language-models,
        ngm:retrieval-augmented-generation ;
    vc:slug "microsoft-copilot" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gpt-4,
        ngm:natural-language-processing,
        ngm:semantic-search,
        ngm:transformer-architecture .

ngm:midjourney-text-to-image-service a owl:Class ;
    rdfs:label "Midjourney Text-to-Image Service"@en ;
    rdfs:comment "Midjourney is a proprietary generative artificial intelligence service that produces images from natural-language text prompts. It is operated by an independent research lab of the same name and is accessed primarily through a Discord bot interface and, later, a dedicated web application. The system is known for a distinctive aesthetic and for iterating rapidly through successive model versions that improve coherence, resolution and prompt adherence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
