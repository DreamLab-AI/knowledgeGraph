        <urn:visionflow:linked:foundation-model-licensing>,
        <urn:visionflow:linked:generative-ai-products>,
        <urn:visionflow:linked:synthetic-media-creation>,
        vf:ai-agent-system ;
    vc:hasPart <urn:visionflow:linked:ai-infrastructure-providers>,
        <urn:visionflow:linked:ai-research-laboratory>,
        <urn:visionflow:linked:application-ai-companies>,
        <urn:visionflow:linked:capital-base>,
        <urn:visionflow:linked:foundation-model-labs>,
