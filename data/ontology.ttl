ngm:markov-chain-monte-carlo a owl:Class ;
    rdfs:label "Markov Chain Monte Carlo"@en ;
    rdfs:comment "Markov Chain Monte Carlo (MCMC) is a class of algorithms that generate samples from a target probability distribution by constructing a Markov chain whose stationary distribution equals the target, enabling approximate Bayesian inference and integration over high-dimensional spaces that are intractable by exact methods. Core algorithms include Metropolis-Hastings, Gibbs sampling, Hamiltonian Monte Carlo, and No-U-Turn Sampler."@en ;
    rdfs:subClassOf ngm:monte-carlo-methods,
        ngm:probabilistic-inference ;
    vc:enables ngm:bayesian-inference,
        ngm:probabilistic-model ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:probability-theory ;
    vc:slug "markov-chain-monte-carlo" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:markov-chain,
        ngm:sampling .

ngm:mathematical-reasoning a owl:Class ;
    rdfs:label "Mathematical Reasoning"@en ;
    rdfs:comment "Mathematical reasoning is the capacity of an AI system to perform multi-step symbolic manipulation, formal proof construction, and quantitative inference over structured mathematical problems including arithmetic, algebra, geometry, and theorem proving. It is considered a rigorous benchmark for general intelligence because correct solutions require compositional reasoning without shortcut pattern matching. Contemporary large language models exhibit emergent mathematical reasoning capabilities when combined with chain-of-thought prompting and tool use (e.g., code interpreters), though formal verification of proofs remains an open research challenge."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:dependsOn ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:code-generation,
        ngm:formal-verification,
        ngm:reasoning ;
    vc:slug "mathematical-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:chain-of-thought-reasoning,
        ngm:symbolic-ai .

ngm:measure-theory a owl:Class ;
    rdfs:label "Measure Theory"@en ;
    rdfs:comment "Measure Theory is the branch of mathematical analysis that studies measures, which assign a consistent notion of size, length, area, volume or probability to subsets of a space. It provides the rigorous foundation for the Lebesgue integral, which generalises the Riemann integral and handles a wider class of functions and limiting operations. It is the formal basis of modern probability theory, where a probability is a measure of total mass one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sigma-algebra ],
        ngm:owl-thing ;
    vc:enables ngm:probability-theory,
        ngm:stochastic-processes ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lebesgue-integral,
        ngm:sigma-algebra ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:real-analysis,
        ngm:set-theory ;
    vc:slug "measure-theory" ;
    vc:sourceDomain "measure-theory" .

ngm:mesh-data a owl:Class ;
    rdfs:label "Mesh Data"@en ;
    rdfs:comment "Mesh data is a structured representation of a three-dimensional surface or volume as a collection of vertices, edges, and polygonal faces — most commonly triangles or quads — that together define the geometry of a shape. It encodes both topological connectivity (which vertices form which faces) and geometric attributes (positions, normals, UV coordinates, vertex colours) required for rendering, simulation, and analysis. Mesh data serves as the primary interchange format between 3D modelling software, real-time engines, and spatial computing pipelines. It is produced by processes such as photogrammetry, structured-light scanning, LiDAR capture, and procedural generation."@en ;
    rdfs:subClassOf ngm:spatial-mesh ;
    vc:enables ngm:3-d-reconstruction,
        ngm:3-d-rendering,
        ngm:differentiable-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:point-cloud,
        ngm:three-dimensional-graphics ;
    vc:slug "mesh-data" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:photogrammetry,
        ngm:vertex-shader .

ngm:meta-learning a owl:Class ;
    rdfs:label "Meta-Learning"@en ;
    rdfs:comment "Meta-Learning, colloquially described as 'learning to learn', is the study and design of machine learning systems that improve their own learning algorithms or initialisation through experience across multiple tasks, enabling rapid adaptation to new tasks with minimal data. Rather than learning a task directly, a meta-learning algorithm learns a prior or inductive bias that facilitates fast generalisation. Key paradigms include model-agnostic meta-learning (MAML), which optimises for a parameter initialisation that is close to good solutions for many tasks, and metric-based approaches such as prototypical networks that learn a task-agnostic embedding space. Meta-learning is central to few-shot learning, continual learning, and automated machine learning research."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:parameter-efficient-fine-tuning,
        ngm:training-dataset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:slug "meta-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:gradient-descent .

ngm:micro-strategy a owl:Class ;
    rdfs:label "MicroStrategy"@en ;
    rdfs:comment "MicroStrategy (rebranded Strategy in 2025) is a Nasdaq-listed business intelligence and analytics software company that became the first publicly traded corporation to adopt Bitcoin as its primary treasury reserve asset, initiating this strategy in August 2020 under executive chairman Michael Saylor. The company has since deployed multiple capital market instruments—including convertible notes, equity offerings, and preferred stock—to continuously acquire Bitcoin, accumulating over 500,000 BTC by early 2025 and creating a leveraged Bitcoin exposure vehicle accessible through public equity markets. MicroStrategy's approach established a corporate treasury model that has been studied and replicated by other public companies seeking Bitcoin exposure."@en ;
    rdfs:subClassOf ngm:enterprise-blockchain ;
    vc:contrastsWith ngm:bitcoin-etf,
        ngm:data-analytics ;
    vc:enables ngm:digital-asset,
        ngm:digital-asset-market,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:bitcoin-etf,
        ngm:bitcoin-value-proposition,
        ngm:financial-instruments,
        ngm:treasury-management ;
    vc:slug "micro-strategy" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:asset-management,
        ngm:digital-transformation,
        ngm:investment-management ;
    vc:uses ngm:bitcoin-as-money,
        ngm:bitcoin-standard,
        ngm:securities-regulation .

ngm:model-transparency a owl:Class ;
    rdfs:label "Model Transparency"@en ;
    rdfs:comment "The capability to understand, explain, and interpret the decision-making processes within AI and machine learning models, encompassing explainability, interpretability, and accountability requirements essential for responsible AI deployment."@en ;
    rdfs:subClassOf ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:trustworthy-ai-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "model-transparency" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:model-weights a owl:Class ;
    rdfs:label "Model Weights"@en ;
    rdfs:comment "The learnable numerical parameters in a neural network that encode the connection strengths adjusted during training via backpropagation to minimise loss. Model weights constitute the primary artefact of training and are the target of fine-tuning, quantisation, pruning, and transfer learning; their distribution and magnitude critically determine model capability and safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:network-architecture ;
    vc:requires ngm:backpropagation,
        ngm:training ;
    vc:slug "model-weights" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:multimodal-learning a owl:Class ;
    rdfs:label "Multimodal Learning"@en ;
    rdfs:comment "Multimodal learning is a sub-field of machine learning concerned with building models that can process, align, and reason over data from two or more sensory modalities — such as text, images, audio, video, and structured data — within a unified representation space. Models trained multimodally acquire richer, grounded representations than unimodal counterparts by exploiting cross-modal correlations and complementarity."@en ;
    rdfs:subClassOf ngm:ai-machine-learning ;
    vc:enables ngm:vision-language-action-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:cross-modal-conditioning,
        ngm:multimodal-models ;
    vc:slug "multimodal-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism .

ngm:network-communication a owl:Class ;
    rdfs:label "Network Communication"@en ;
    rdfs:comment "Network Communication is the transmission of data between computing nodes via shared or dedicated media, governed by layered protocol stacks that abstract physical signal propagation into reliable, addressable data exchange. It encompasses all paradigms of machine-to-machine data transfer including wired, wireless, and optical mediums organised according to reference models such as the OSI seven-layer model and TCP/IP suite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:protocol-stack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:communication-network ;
    vc:enables ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:network-layer,
        ngm:protocol-stack,
        ngm:transport-layer ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:network-architecture,
        ngm:network-protocol ;
    vc:slug "network-communication" ;
    vc:sourceDomain "infrastructure" .

ngm:network-effects a owl:Class ;
    rdfs:label "Network Effects"@en ;
    rdfs:comment "Network effects describe the phenomenon whereby a product or service gains additional value for each existing user as the number of participants increases, creating a self-reinforcing growth dynamic. Direct network effects arise when users directly benefit from others on the same platform; indirect effects emerge when complementary products or services multiply with scale, creating cross-side externalities."@en ;
    rdfs:subClassOf ngm:positive-feedback ;
    vc:enables ngm:startup-ecosystem,
        ngm:technology-ecosystem ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ecosystem-connectivity,
        ngm:mass-adoption,
        ngm:technology-adoption ;
    vc:slug "network-effects" ;
    vc:sourceDomain "ai" .

ngm:network-slicing a owl:Class ;
    rdfs:label "Network Slicing"@en ;
    rdfs:comment "Network slicing is a virtualisation architecture that partitions a single physical network infrastructure into multiple isolated, logically independent virtual networks — called slices — each configured to provide the specific performance characteristics, security posture, and service topology required by a distinct application or tenant. Defined within 3GPP Release 15 and later releases for 5G networks, each slice is instantiated through software-defined networking and network function virtualisation, enabling differentiated service-level guarantees — such as ultra-low latency for industrial automation or high-throughput for video streaming — without dedicated physical hardware. Slices span radio access, transport, and core network domains and can be dynamically provisioned, scaled, and torn down."@en ;
    rdfs:subClassOf ngm:network-function-virtualization ;
    vc:enables ngm:edge-computing,
        ngm:guaranteed-bandwidth,
        ngm:quality-of-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:6-g-network-slice,
        ngm:latency ;
    vc:slug "network-slicing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing-architecture .

ngm:networking-domain a owl:Class ;
    rdfs:label "Networking Domain"@en ;
    rdfs:comment "The Networking Domain classifies concepts concerned with the transport of data between computing endpoints across links and networks. It covers protocols, addressing, routing, and the layered models that organise communication. As a top-level subject classification, it scopes the movement of data rather than the applications that consume it or the security controls applied to it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:addressing-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:addressing-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:owl-thing ;
    vc:enables ngm:data-transport,
        ngm:distributed-communication,
        ngm:service-reachability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:addressing-scheme,
        ngm:network-topology,
        ngm:peer-to-peer-network,
        ngm:routing-protocol,
        ngm:transport-protocol ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:addressing-scheme,
        ngm:physical-link ;
    vc:slug "networking-domain" ;
    vc:sourceDomain "networking" .

ngm:neural-radiance-fields a owl:Class ;
    rdfs:label "Neural Radiance Fields"@en ;
    rdfs:comment "A neural rendering technique that represents 3D scenes as continuous volumetric radiance functions encoded by multilayer perceptrons, mapping 5D inputs (3D spatial position plus 2D viewing direction) to colour and volume density. Novel viewpoints are synthesised by volumetric ray marching through the learned representation, enabling photorealistic view synthesis from sparse photograph sets without explicit 3D geometry. Introduced by Mildenhall et al. (ECCV 2020), NeRF has driven a generation of implicit neural scene representations spanning telepresence, virtual production, and robotics."@en ;
    rdfs:subClassOf ngm:dc-telepresence,
        ngm:real-time-rendering-pipeline ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:photorealistic-rendering,
        ngm:scene-capture-and-reconstruction,
        ngm:telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:3-d-content-generation,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-reconstruction,
        ngm:computer-vision,
        ngm:neural-rendering,
        ngm:point-cloud ;
    vc:slug "neural-radiance-fields" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning,
        ngm:ray-marching .

ngm:nominated-proof-of-stake a owl:Class ;
    rdfs:label "Nominated Proof of Stake"@en ;
    rdfs:comment "Nominated Proof of Stake (NPoS) is a consensus mechanism variant in which token holders nominate a set of validator candidates; an election algorithm selects the active validator set to maximise stake distribution while satisfying security constraints. Elected validators produce and finalise blocks, while nominators share both block rewards and slashing penalties, aligning incentives across the broader token holder community."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:pure-proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:blockchain-governance,
        ngm:deterministic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:polkadot-parachains ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "nominated-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm .

ngm:north-england-innovation-corridor a owl:Class ;
    rdfs:label "North England Innovation Corridor"@en ;
    rdfs:comment "The collaborative technology and innovation ecosystem spanning Manchester, Leeds, Liverpool, Sheffield, and Newcastle that constitutes the Northern Powerhouse. The corridor links world-class research universities, NHS trusts, advanced manufacturing facilities, and digital startups through coordinated investment, shared infrastructure, and regional development frameworks aimed at closing the productivity gap between North and South England."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manchester-tech-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liverpool-smart-cities ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:newcastle-ai-and-health-innovation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sheffield-advanced-manufacturing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leeds-digital-hub ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leeds-digital-hub,
        ngm:liverpool-smart-cities,
        ngm:manchester-tech-cluster,
        ngm:newcastle-ai-and-health-innovation,
        ngm:sheffield-advanced-manufacturing ;
    vc:isPartOf ngm:uk-tech-ecosystem ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-economy,
        ngm:digital-infrastructure ;
    vc:slug "north-england-innovation-corridor" ;
    vc:sourceDomain "infrastructure" .

ngm:ollama a owl:Class ;
    rdfs:label "ollama"@en ;
    rdfs:comment "An open-source runtime and model management platform that allows users to download, serve, and interact with large language models locally on macOS, Windows, and Linux. Ollama provides an OpenAI-compatible REST API, enabling integration with tools such as Open WebUI, ComfyUI, and agent frameworks, making local LLM inference accessible without cloud dependencies."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:function-calling,
        ngm:open-webui-and-pipelines,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing ;
    vc:slug "ollama" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models .

ngm:online-safety-act-2023 a owl:Class ;
    rdfs:label "Online Safety Act 2023"@en ;
    rdfs:comment "The Online Safety Act 2023 is a landmark piece of UK legislation that received Royal Assent in October 2023, establishing a comprehensive duty-of-care framework for online platforms and search services operating in the United Kingdom. The Act creates tiered obligations proportionate to service size and risk: all in-scope services must conduct risk assessments and remove illegal content; larger platforms with significant reach face additional requirements including transparency reporting, user empowerment tools, and protections for children. Ofcom is designated as the regulator with powers to audit compliance, issue fines of up to 10% of global annual turnover, and in extreme cases block services from UK users. The Act also introduces criminal liability for senior managers of companies that fail to protect children from serious online harms."@en ;
    rdfs:subClassOf ngm:digital-regulation ;
    vc:enables ngm:content-moderation-standards,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:age-verification,
        ngm:content-moderation,
        ngm:digital-safety,
        ngm:digital-services-act ;
    vc:slug "online-safety-act-2023" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:regulatory-framework ;
    vc:supports ngm:digital-society-harms,
        ngm:regulatory-compliance .

ngm:ontology-structure a owl:Class ;
    rdfs:label "Ontology Structure"@en ;
    rdfs:comment "The formal organisation of an ontology into classes, properties, axioms, and inter-concept relationships expressed in a logic-based language such as OWL or RDFS. Ontology Structure defines the hierarchy and constraint patterns that make machine-readable knowledge graphs queryable, inferable, and interoperable across domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-property-definitions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:owl-class-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-definition ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ontology-definition,
        ngm:ontology-property-definitions,
        ngm:owl-class-hierarchy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ontology-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:controlled-vocabulary .

ngm:open-zeppelin-governor a owl:Class ;
    rdfs:label "OpenZeppelin Governor"@en ;
    rdfs:comment "OpenZeppelin Governor is a modular, security-audited Solidity smart-contract framework that provides the core infrastructure for deploying on-chain governance systems on EVM-compatible blockchains. It implements a proposal lifecycle—proposal creation, voting delay, voting period, quorum check, and timelock-guarded execution—with pluggable modules for vote counting strategies (simple, bravo, fractional), token-based voting power sources (ERC-20 with EIP-5805 checkpointing or ERC-721), and timelock controller integration. Governor is used as the governance layer by major DeFi protocols and DAOs to manage protocol parameter changes, treasury disbursements, and contract upgrades."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:dao-governance,
        ngm:voting-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:on-chain-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "open-zeppelin-governor" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract .

ngm:passwordless-authentication a owl:Class ;
    rdfs:label "Passwordless Authentication"@en ;
    rdfs:comment "Passwordless Authentication encompasses identity verification mechanisms that prove user identity without requiring the user to memorise and enter a shared secret password. Instead, authentication relies on possession of a hardware token or device, biometric characteristics, cryptographic key pairs, or one-time codes delivered through a trusted channel. The FIDO2 standard, comprising the W3C WebAuthn specification and the FIDO Alliance's CTAP protocol, provides the primary open standard for passkey-based passwordless authentication, binding credentials to device hardware and enabling phishing-resistant login flows. Passwordless approaches eliminate credential stuffing, password spray, and phishing attack vectors that account for the majority of account compromise incidents."@en ;
    rdfs:subClassOf ngm:authentication-mechanism ;
    vc:enables ngm:authentication-standards,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:single-sign-on ;
    vc:slug "passwordless-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-identity-wallet ;
    vc:uses ngm:biometric-binding-mechanism,
        ngm:public-key-cryptography .

ngm:policy-decision-point a owl:Class ;
    rdfs:label "Policy Decision Point"@en ;
    rdfs:comment "A Policy Decision Point (PDP) is the logical component in an attribute-based or policy-based access control architecture that evaluates access requests against a set of authorisation policies and returns a permit, deny, or indeterminate decision. The PDP receives a request context—including subject attributes, resource attributes, action, and environment conditions—from a Policy Enforcement Point (PEP), retrieves applicable policies from a Policy Information Point (PIP) or Policy Administration Point (PAP), and applies the XACML combining algorithms or equivalent logic to reach a binding decision. PDPs are the computational core of fine-grained, dynamic authorisation systems used in zero-trust security architectures, identity federation, API gateways, and cloud IAM platforms."@en ;
    rdfs:subClassOf ngm:access-control-system ;
    vc:dependsOn ngm:authentication,
        ngm:cryptographic-verification ;
    vc:enables ngm:policy-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:policy-enforcement,
        ngm:policy-enforcement-point,
        ngm:policy-engine ;
    vc:slug "policy-decision-point" ;
    vc:sourceDomain "security" .

ngm:post-processing a owl:Class ;
    rdfs:label "Post Processing"@en ;
    rdfs:comment "A set of screen-space image processing effects applied after the primary rendering pass to enhance visual fidelity. Common effects include bloom, motion blur, depth of field, tone mapping, colour grading, ambient occlusion, and anti-aliasing, all executed as full-screen shader passes over the rendered framebuffer before presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-technique ],
        ngm:sc-display-and-rendering,
        ngm:visual-effects ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing ;
    vc:requires ngm:rendering-technique,
        ngm:shader ;
    vc:slug "post-processing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:visual-effects ;
    vc:uses ngm:rasterization .

ngm:preference-learning a owl:Class ;
    rdfs:label "Preference Learning"@en ;
    rdfs:comment "A machine learning paradigm that trains models from comparative human judgements (e.g., 'A is better than B') rather than absolute labels or demonstrations, enabling alignment with human values. Preference learning underpins reinforcement learning from human feedback and direct preference optimisation, and is the standard technique for aligning large language models."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:training ;
    vc:slug "preference-learning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ai-safety ;
    vc:uses ngm:machine-learning,
        ngm:reinforcement-learning .

ngm:probabilistic-finality a owl:Class ;
    rdfs:label "Probabilistic Finality"@en ;
    rdfs:comment "Probabilistic finality is a transaction confirmation model characteristic of longest-chain consensus mechanisms where confidence in transaction irreversibility increases exponentially with block depth, approaching but never reaching absolute certainty, with reversal probability decaying as (q/p)^..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:longest-chain-rule ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:longest-chain-rule ;
    vc:slug "probabilistic-finality" ;
    vc:sourceDomain "blockchain" .

ngm:process-automation a owl:Class ;
    rdfs:label "Process Automation"@en ;
    rdfs:comment "Process automation is the use of technology to perform repetitive business, operational, or industrial tasks with minimal human intervention, replacing manual steps in workflows with software execution, robotic systems, or rule-based logic engines. It spans a spectrum from simple macro-based automation of individual tasks through robotic process automation (RPA) that mimics user interface interactions, to intelligent automation that integrates machine learning models for decision-making in unstructured data contexts. The goal is to increase throughput, reduce errors, lower labour costs, and free human workers for higher-value activities."@en ;
    rdfs:subClassOf ngm:workflow-automation ;
    vc:enables ngm:customer-service-automation,
        ngm:digital-transformation,
        ngm:industrial-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-workflow,
        ngm:manufacturing-automation,
        ngm:trade-finance-automation ;
    vc:slug "process-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-integration,
        ngm:software-development-process .

ngm:prompt-tuning a owl:Class ;
    rdfs:label "Prompt Tuning"@en ;
    rdfs:comment "Prompt Tuning is a parameter-efficient fine-tuning method that learns continuous soft prompt embeddings prepended to the input sequence, whilst keeping all pre-trained model weights frozen. It optimises task-specific prompts in the embedding space using gradient descent, requiring as little as 0.01% of model parameters and enabling efficient multi-task deployment from a single frozen backbone."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:prefix-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:prompt-engineering ;
    vc:slug "prompt-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:language-modeling .

ngm:python a owl:Class ;
    rdfs:label "Python"@en ;
    rdfs:comment "Python is a high-level, dynamically typed, interpreted programming language with a design philosophy emphasising code readability and the minimisation of syntactic ceremony. Its extensive standard library and the PyPI ecosystem of third-party packages—including NumPy, SciPy, Pandas, PyTorch, TensorFlow, and Scikit-learn—make it the dominant language for machine learning research, data science, and scientific computing. Python's combination of interactive development via Jupyter notebooks, a permissive licence, and first-class support in cloud ML platforms has made it the lingua franca of artificial intelligence development."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:programming-language ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning,
        ngm:machine-learning-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:python-and-py-torch ;
    vc:slug "python" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-framework .

ngm:python-runtime a owl:Class ;
    rdfs:label "Python Runtime"@en ;
    rdfs:comment "The Python runtime is the interpreter process and associated standard library environment responsible for compiling Python source to bytecode, executing that bytecode in a virtual machine, managing heap memory through reference-counting combined with a cyclic garbage collector, and resolving module imports via the package search path. CPython—the canonical C-language reference implementation—uses a Global Interpreter Lock (GIL) that serialises bytecode execution across threads, making multi-processing the preferred concurrency model for CPU-bound workloads. The Python runtime underpins the dominant AI/ML toolchain including PyTorch, TensorFlow, and the Hugging Face ecosystem, making its performance characteristics, extension mechanisms, and packaging conventions central concerns for AI infrastructure engineering."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:runtime-environment ;
    vc:slug "python-runtime" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
        ngm:model-training ;
    vc:uses ngm:machine-learning-framework,
        ngm:python .

ngm:rb-0023-degrees-of-freedom a owl:Class ;
    rdfs:label "rb 0023 degrees of freedom"@en ;
    rdfs:comment "Degrees of Freedom (DOF) in robotics denotes the number of independent parameters required to fully specify the configuration of a robot mechanism. Each revolute or prismatic joint contributes one DOF; a 6-DOF manipulator can achieve arbitrary position and orientation in three-dimensional space. The number of DOF constrains the robot's reachable workspace, its dexterity, and the complexity of its kinematic and dynamic models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0026-robot-joint ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0026-robot-joint ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0021-robot-kinematics,
        ngm:rb-0024-workspace,
        ngm:rb-0031-singularity,
        ngm:rb-0037-dexterity ;
    vc:slug "rb-0023-degrees-of-freedom" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0028-forward-kinematics,
        ngm:rb-0029-inverse-kinematics,
        ngm:rb-0036-resolution .

ngm:rb-0031-singularity a owl:Class ;
    rdfs:label "rb 0031 singularity"@en ;
    rdfs:comment "A kinematic singularity is a robot configuration in which the Jacobian matrix loses rank, causing the manipulator to lose one or more degrees of freedom in Cartesian space. At a singularity, certain end-effector motions become unachievable regardless of joint velocity magnitudes, and inverse kinematics solutions either vanish or require unbounded joint speeds. Singularity avoidance and singularity-robust inverse kinematics (via damped least-squares) are critical for safe, continuous robot motion, particularly near workspace boundaries and for wrist configurations of six-axis arms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0037-dexterity ;
    vc:dependsOn ngm:differential-kinematics,
        ngm:rb-0029-inverse-kinematics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0024-workspace,
        ngm:rb-0032-manipulability,
        ngm:robot-singularity ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:slug "rb-0031-singularity" ;
    vc:sourceDomain "robotics" .

ngm:rb-0041-inertia a owl:Class ;
    rdfs:label "rb 0041 inertia"@en ;
    rdfs:comment "In robotics, inertia refers to the resistance of a robot's links and payload to changes in motion, quantified by the inertia tensor for rotational dynamics and mass for translational dynamics. Accurate inertia modelling is essential for dynamic control, trajectory planning, and compliance with power-and-force-limiting safety requirements, because high inertia directly increases the impact forces during unintended contact."@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0033-payload ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0043-torque,
        ngm:rb-0045-acceleration,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics ;
    vc:slug "rb-0041-inertia" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0064-computed-torque-control,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0043-torque a owl:Class ;
    rdfs:label "rb 0043 torque"@en ;
    rdfs:comment "Torque is the rotational force applied about a joint axis, expressed in Newton-metres (N·m). In robot dynamics, joint torques are the primary control inputs that drive links through desired trajectories; torque limits constrain the feasible workspace and influence payload capacity, and torque sensing enables compliant and force-controlled interaction."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0041-inertia,
        ngm:rb-0044-velocity,
        ngm:rb-0045-acceleration,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0043-torque" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:servo-motor .

ngm:rb-0064-computed-torque-control a owl:Class ;
    rdfs:label "rb 0064 computed torque control"@en ;
    rdfs:comment "Computed torque control (CTC) is a model-based robot control strategy that uses the full inverse dynamics model of a manipulator to compute the joint torques required to follow a desired trajectory. By cancelling the nonlinear dynamics — including Coriolis, centripetal, and gravitational terms — CTC transforms the closed-loop system into a set of independent linear double-integrators, enabling simple PD outer-loop controllers to achieve high-accuracy tracking. Its effectiveness depends on the fidelity of the dynamic model and is sensitive to parameter uncertainty."@en ;
    rdfs:subClassOf ngm:model-based-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0056-impedance-control,
        ngm:rb-0061-nonlinear-control,
        ngm:rb-0062-model-predictive-control ;
    vc:slug "rb-0064-computed-torque-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0043-torque,
        ngm:rb-0048-pid-controller .

ngm:rb-0096-safeguarding a owl:Class ;
    rdfs:label "rb 0096 safeguarding"@en ;
    rdfs:comment "Safeguarding, in the context of collaborative and industrial robotics, refers to the ensemble of physical barriers, electronic devices, and procedural controls deployed to prevent hazardous contact between robots and humans. Safeguarding measures include hard guards, light curtains, safety zones, and monitored-stop functions, and are mandated by standards such as ISO 10218 and ISO/TS 15066. Effective safeguarding is complementary to inherent safe design: it mitigates residual risks that cannot be eliminated through power-and-force limiting or speed reduction alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-curtain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0095-safety-zone ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:light-curtain,
        ngm:rb-0090-emergency-stop,
        ngm:rb-0095-safety-zone ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0096-safeguarding" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:real-time-computation a owl:Class ;
    rdfs:label "Real-Time Computation"@en ;
    rdfs:comment "Real-time computation refers to computational processes that must produce correct outputs within specified, externally imposed time constraints—where the correctness of a result depends not only on its logical accuracy but on its delivery before a deadline. Hard real-time systems guarantee deadline satisfaction under all conditions, soft real-time systems tolerate occasional deadline misses, and firm real-time systems discard late results as worthless. Applications span industrial control, autonomous vehicles, robotics, financial trading, and interactive media. Real-time computation requires deterministic execution paths, bounded memory allocation, and often specialised hardware or operating system schedulers."@en ;
    rdfs:subClassOf ngm:real-time ;
    vc:enables ngm:control-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:latency,
        ngm:real-time-ai ;
    vc:slug "real-time-computation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:autonomous-system,
        ngm:digital-signal-processing ;
    vc:uses ngm:edge-computing,
        ngm:parallel-processing .

ngm:real-time-inference-at-edge a owl:Class ;
    rdfs:label "Real-Time Inference at Edge"@en ;
    rdfs:comment "The execution of machine learning inference on edge devices under deterministic latency constraints, typically P99 latency below 10–100 ms, to support safety-critical and time-sensitive applications. Achieves real-time performance through hardware accelerators (NPUs, FPGAs, ASICs), model compression, and priority scheduling without reliance on cloud round-trips."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-system,
        ngm:knowledge-distillation-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:requires ngm:edge-computing,
        ngm:embedded-systems,
        ngm:model-compression-for-edge ;
    vc:slug "real-time-inference-at-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:latency-aware-edge-ai,
        ngm:npu .

ngm:real-world-asset-tokenisation a owl:Class ;
    rdfs:label "Real-World Asset Tokenisation"@en ;
    rdfs:comment "Real-world asset tokenisation (RWA) is the process of issuing blockchain-based digital tokens that represent legally enforceable claims over physical or financial assets such as real estate, government bonds, private credit, or commodities. By encoding ownership rights and transfer rules in smart contracts, RWA tokenisation enables fractional ownership, 24/7 secondary-market liquidity, and automated compliance enforcement. The practice bridges traditional capital markets and decentralised finance, requiring regulatory alignment with securities law and robust oracle infrastructure to reflect off-chain asset valuations on-chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle-network ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:decentralised-finance,
        ngm:liquidity-provision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:security-token ;
    vc:requires ngm:oracle-network,
        ngm:smart-contract ;
    vc:slug "real-world-asset-tokenisation" ;
    vc:sourceDomain "blockchain" .

ngm:recommendation-systems a owl:Class ;
    rdfs:label "Recommendation Systems"@en ;
    rdfs:comment "Recommendation Systems are information filtering systems that predict a user's preference for items—products, content, services—and surface the most relevant items from a large catalogue. They are categorised into collaborative filtering (leveraging the behaviour of similar users), content-based filtering (matching item attributes to user profiles), and hybrid approaches that combine both. Modern large-scale recommendation systems employ deep learning architectures, embedding models, and two-tower neural networks trained on implicit feedback signals such as clicks, watch-time, and purchases. Recommendation systems are among the highest-impact machine learning applications in commercial technology, driving substantial fractions of revenue at platforms such as Netflix, Amazon, YouTube, and Spotify, while also raising significant concerns about filter bubbles, engagement maximisation harms, and algorithmic amplification of misinformation."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:enables ngm:hyper-personalisation,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:embedding-model,
        ngm:machine-learning-model,
        ngm:recommendation-engine ;
    vc:slug "recommendation-systems" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:graph-neural-network,
        ngm:machine-learning-pipeline .

ngm:recursive-self-improvement a owl:Class ;
    rdfs:label "Recursive Self-Improvement"@en ;
    rdfs:comment "Recursive self-improvement (RSI) is a theoretical AI capability in which a system autonomously identifies and implements modifications to its own architecture, training procedure, or objective function that result in increased performance or capability, such that each improvement cycle enables further improvements in a self-amplifying feedback loop. This process is conjectured to be a pathway to artificial superintelligence if left unconstrained, as successive capability doublings could occur faster than human oversight can track. RSI is a central concern in AI safety research because systems capable of recursive self-improvement may rapidly violate designers' assumptions about capability bounds and alignment properties."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-safety-research ;
    vc:enables ngm:self-improvement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:value-alignment ;
    vc:slug "recursive-self-improvement" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:regulatory-authority a owl:Class ;
    rdfs:label "Regulatory Authority"@en ;
    rdfs:comment "A regulatory authority is a government body, statutory agency, or delegated entity empowered by legislation to create, enforce, and adjudicate rules governing a specific industry, market, or domain of public concern. Such bodies possess the legal power to issue binding standards, licenses, and penalties; conduct inspections and investigations; and compel disclosures, all with the aim of protecting consumers, ensuring market integrity, managing systemic risk, or advancing public policy objectives. Regulatory authorities operate at national, supranational, and sub-national levels and are increasingly engaged with digital markets, artificial intelligence, financial technology, and emerging technology sectors."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:regulatory-reporting,
        ngm:regulatory-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:financial-regulation,
        ngm:regulatory-compliance,
        ngm:regulatory-framework ;
    vc:slug "regulatory-authority" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compliance-monitoring,
        ngm:regulatory-technology .

ngm:regulatory-domain a owl:Class ;
    rdfs:label "Regulatory Domain"@en ;
    rdfs:comment "The Regulatory Domain classifies concepts concerning the rules issued by public authorities and the obligations they impose on regulated activities. It covers statutory requirements, supervisory regimes and the mechanisms through which compliance is demonstrated and enforced. As a top-level subject axis it constrains how systems in other domains may lawfully be designed and operated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:enforcement-action ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-domain ],
        ngm:owl-thing ;
    vc:enables ngm:consumer-protection,
        ngm:market-integrity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:compliance-obligation,
        ngm:enforcement-action,
        ngm:reporting-requirement,
        ngm:statutory-requirement,
        ngm:supervisory-authority ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-domain,
        ngm:identity-domain ;
    vc:slug "regulatory-domain" ;
    vc:sourceDomain "regulatory" .

ngm:reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The degree to which an AI system performs its intended function consistently and accurately over time and across repeated operations, producing predictable and dependable results under specified conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:monitoring,
        ngm:testing,
        ngm:validation-ai-0095 ;
    vc:slug "reliability" ;
    vc:sourceDomain "spatial-computing" .

ngm:residual-connection a owl:Class ;
    rdfs:label "Residual Connection"@en ;
    rdfs:comment "A neural network connection that adds the input of a layer directly to its output, forming a skip connection that enables stable gradient flow during backpropagation in very deep architectures. Residual connections mitigate the vanishing gradient problem and allow networks of hundreds of layers to be trained effectively, forming a foundational component of ResNet and Transformer architectures."@en ;
    rdfs:subClassOf ngm:neural-network-component ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:residual-network,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:activation-function,
        ngm:layer-normalisation ;
    vc:slug "residual-connection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation .

ngm:resilience a owl:Class ;
    rdfs:label "Resilience"@en ;
    rdfs:comment "The capacity of a system, network, or organisation to anticipate, withstand, recover from, and adapt to adverse conditions, attacks, or failures whilst maintaining essential functions. In distributed and blockchain contexts, resilience is achieved through decentralisation, redundancy, byzantine fault tolerance, and adaptive response mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:blockchain-scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:blockchain-network ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:slug "resilience" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cybersecurity,
        ngm:data-security .

ngm:responsible-ai-principles a owl:Class ;
    rdfs:label "Responsible AI Principles"@en ;
    rdfs:comment "Foundational ethical commitments and normative guidelines governing AI system design, development, deployment, and monitoring to ensure beneficial, fair, and rights-respecting outcomes. Core principles—including fairness, transparency, accountability, privacy, safety, and human oversight—are operationalised through frameworks such as the OECD AI Principles, the EU Ethics Guidelines for Trustworthy AI, and UNESCO's Recommendation on the Ethics of AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-and-explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-alignment ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability,
        ngm:ai-alignment,
        ngm:ai-fairness,
        ngm:ai-safety,
        ngm:human-oversight,
        ngm:transparency-and-explainability ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:differential-privacy,
        ngm:explainability ;
    vc:slug "responsible-ai-principles" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:rfid a owl:Class ;
    rdfs:label "RFID"@en ;
    rdfs:comment "Radio-Frequency Identification (RFID) is a wireless technology that uses electromagnetic fields to automatically identify and track tags attached to objects. Tags contain electronically stored information and can be read without requiring line of sight, enabling automated data capture across distances from a few centimetres to several metres."@en ;
    rdfs:subClassOf ngm:communication-network ;
    vc:enables ngm:food-safety,
        ngm:pharmaceutical-supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:blockchain-provenance,
        ngm:network-communication ;
    vc:slug "rfid" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:communication-infrastructure .

ngm:robot-manipulation a owl:Class ;
    rdfs:label "Robot Manipulation"@en ;
    rdfs:comment "Robot manipulation is the sub-field of robotics concerned with the planning and execution of purposeful physical interactions between robotic systems and objects in the world, encompassing grasping, assembly, in-hand manipulation, and tool use. It integrates kinematics, dynamics, perception, and planning to move objects from one configuration to another, adapting to uncertainty in object shape, pose, surface properties, and environmental dynamics. Robust manipulation remains one of the hardest open problems in robotics due to the combinatorial complexity of contact mechanics."@en ;
    rdfs:subClassOf ngm:manipulation ;
    vc:enables ngm:human-robot-interaction,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:industrial-manipulation,
        ngm:object-manipulation,
        ngm:teleoperation ;
    vc:slug "robot-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:sensor-fusion .

ngm:scope-2-emissions a owl:Class ;
    rdfs:label "Scope 2 Emissions"@en ;
    rdfs:comment "Scope 2 Emissions are the indirect greenhouse gas emissions attributable to an organisation arising from the generation of purchased or acquired electricity, steam, heat, or cooling consumed in its operations, as defined by the GHG Protocol Corporate Standard. Although the physical emissions occur at the power plant or thermal facility, they are accounted for by the purchasing organisation because its demand drives that generation, making Scope 2 the primary decarbonisation lever for energy-intensive organisations such as data centres and manufacturers."@en ;
    rdfs:subClassOf ngm:environmental-sustainability ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:carbon-neutrality-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:ghg-protocol,
        ngm:scope-1-emissions,
        ngm:scope-3-emissions ;
    vc:slug "scope-2-emissions" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:renewable-energy,
        ngm:renewable-energy-certificates,
        ngm:sustainability-reporting .

ngm:security-architecture a owl:Class ;
    rdfs:label "Security Architecture"@en ;
    rdfs:comment "A comprehensive framework defining security controls, policies, and technologies protecting metaverse infrastructure, user data, and digital assets through defence-in-depth strategies including authentication, encryption, access control, and threat monitoring."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety,
        ngm:system-architecture ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:secure-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "security-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:security-token-offering a owl:Class ;
    rdfs:label "Security Token Offering"@en ;
    rdfs:comment "A Security Token Offering (STO) is a regulated fundraising mechanism in which blockchain-based tokens representing ownership rights, revenue shares, or other financial entitlements are offered to investors under applicable securities law. Unlike utility token sales, STOs require issuer compliance with financial regulation, investor accreditation, and prospectus or exemption filings, bringing traditional capital market discipline to tokenised asset issuance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
