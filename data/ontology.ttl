    vc:sourceDomain "artificial-intelligence" .

vf:robot-control a owl:Class ;
    rdfs:label "Robot Control"@en ;
    rdfs:comment "Robot Control - The systems, algorithms, and methodologies that enable robots to execute tasks autonomously or semi-autonomously through sensing, decision-making, and actuation"@en ;
