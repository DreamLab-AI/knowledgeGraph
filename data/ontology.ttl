        ngm:natural-language-processing,
        ngm:sparql .

ngm:localisation a owl:Class ;
    rdfs:label "Localisation"@en ;
    rdfs:comment "Localisation is the computational process by which a mobile agent—robot, autonomous vehicle, or mixed-reality device—estimates its six-degree-of-freedom pose (position and orientation) within a reference coordinate frame, using sensor observations fused through probabilistic inference algorithms. It encompasses both map-based approaches (matching live sensor data against a prior map) and map-free approaches (dead-reckoning and visual odometry), as well as the joint Simultaneous Localisation and Mapping (SLAM) problem in which the map and pose are estimated concurrently. Accurate localisation is a prerequisite for autonomous navigation, path planning, and real-time spatial anchoring in both physical and virtual environments. The field draws on Bayesian filtering, factor graph optimisation, deep metric learning, and multi-sensor fusion across domains ranging from warehouse automation and self-driving vehicles to extended-reality (XR) headsets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-frame ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:indoor-positioning-system,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:global-localisation,
        ngm:position-tracking ;
    vc:dependsOn ngm:feature-extraction,
        ngm:loop-closure-detection,
        ngm:odometry ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:path-planning,
        ngm:simultaneous-localisation-and-mapping,
        ngm:spatial-anchoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dead-reckoning,
        ngm:global-navigation-satellite-system,
        ngm:map-matching,
        ngm:pose-estimation,
        ngm:slam ;
    vc:requires ngm:coordinate-frame,
        ngm:probabilistic-inference,
        ngm:sensor-fusion ;
    vc:slug "localisation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inertial-measurement-unit,
        ngm:kalman-filter,
        ngm:lidar,
        ngm:occupancy-grid,
        ngm:particle-filter,
        ngm:point-cloud .

ngm:machine-translation a owl:Class ;
    rdfs:label "Machine Translation"@en ;
    rdfs:comment "Machine Translation is the automated translation of text or speech from one natural language to another using neural network models, particularly transformer-based sequence-to-sequence architectures. Modern neural MT systems achieve near-human quality through pre-training on massive multilingual corpora, cross-lingual transfer learning, and attention mechanisms that model long-range linguistic dependencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder-decoder-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:beam-search-decoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:metaverse-interoperability,
        ngm:protocol-translation ;
    vc:contrastsWith ngm:human-translation,
        ngm:rule-based-machine-translation,
        ngm:statistical-machine-translation ;
