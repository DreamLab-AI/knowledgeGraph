    vc:sourceDomain "spatial-computing" .

ngm:epipolar-geometry a owl:Class ;
    rdfs:label "Epipolar Geometry"@en ;
    rdfs:comment "Epipolar Geometry is the projective geometry of stereo vision, describing the geometric relationship between two camera views of the same 3D scene. It is encapsulated in the Fundamental Matrix (uncalibrated cameras) and Essential Matrix (calibrated cameras), which constrain the search for correspondences between images to one-dimensional epipolar lines rather than the full 2D image plane."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:depth-estimation,
        ngm:stereo-vision,
        ngm:structure-from-motion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:point-cloud,
        ngm:slam ;
    vc:slug "epipolar-geometry" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:camera-calibration,
        ngm:camera-intrinsics .

ngm:equity a owl:Class ;
    rdfs:label "Equity"@en ;
    rdfs:comment "The principle of fair and impartial access to AI, media technologies, and digital infrastructure across geographic, socioeconomic, and demographic groups. Equity in this context addresses disparities in technological access, educational opportunity, and participation in AI-driven economies, and informs legal frameworks and international cooperation mechanisms designed to close digital divide gaps."@en ;
