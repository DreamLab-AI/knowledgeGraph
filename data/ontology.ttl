    rdfs:label "Communication Complexity"@en .
ngm:communication-for-locked-in-patients a skos:Concept ;
    rdfs:label "Communication For Locked In Patients"@en .
ngm:communication-infrastructure a owl:Class ;
    rdfs:comment "The physical and logical substrate — including fibre, wireless networks, data centres, protocols, and switching equipment — that enables the transmission of information between nodes in a networked system. It underpins digital services by providing reliable, low-latency, and high-bandwidth connectivity at scale, from local area networks to global internet backbones."@en ;
    rdfs:label "Communication Infrastructure"@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:cloud-computing ;
    vc:enables ngm:communication-tools ;
    vc:enables ngm:immersive-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-optimization ;
    vc:relatedTo ngm:network-communication ;
    vc:slug "communication-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network ;
    vc:uses ngm:communication-protocol .
ngm:communication-interface a owl:Class ;
    rdfs:comment "A communication interface is a defined boundary — hardware, software, or logical — through which two or more distinct systems, components, or agents exchange data, commands, or signals according to agreed protocols and encodings. It abstracts the internal implementation details of each participant, exposing only the contract necessary for interoperability, and may operate synchronously or asynchronously across local buses, networks, or inter-process mechanisms. Communication interfaces are fundamental to modular system design, enabling independent development, testing, and replacement of components without disrupting the broader system."@en ;
    rdfs:label "Communication Interface"@en ;
    rdfs:subClassOf ngm:communication-protocol ;
