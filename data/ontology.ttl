        ngm:eu-ai-act-regulatory-instrument ;
    vc:contrastsWith ngm:ieee,
        ngm:ietf,
        ngm:w3-c ;
    vc:enables ngm:compliance-framework,
        ngm:conformity-assessment,
        ngm:interoperability-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
