ngm:incident-response a owl:Class ;
    rdfs:label "Incident Response"@en ;
    rdfs:comment "Incident Response is the structured organisational process for detecting, containing, eradicating, and recovering from cybersecurity incidents, followed by post-incident analysis to prevent recurrence and strengthen defensive posture. It is operationalised through lifecycle models such as NIST SP 800-61 and the SANS PICERL framework (Preparation, Identification, Containment, Eradication, Recovery, Lessons Learned), enacted via security operations centre (SOC) playbooks, SIEM-driven detection pipelines, and SOAR-automated response actions. Effective incident response minimises dwell time—the interval between initial compromise and detection—limits lateral movement and data exfiltration, and satisfies regulatory notification obligations under frameworks such as GDPR and NIS2. AI-assisted triage, automated containment orchestration, and threat-intelligence enrichment have become defining characteristics of mature programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-incident-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-forensics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-operations-centre ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-intelligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-information-and-event-management ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:threat-hunting,
        ngm:vulnerability-management ;
    vc:enables ngm:business-continuity,
        ngm:cyber-resilience,
        ngm:incident-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-forensics,
        ngm:post-incident-review,
        ngm:threat-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-breach,
        ngm:identity-and-access-management,
        ngm:information-security,
        ngm:network-security,
        ngm:vulnerability ;
    vc:requires ngm:security-information-and-event-management,
        ngm:security-operations-centre,
        ngm:threat-intelligence ;
    vc:slug "incident-response" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-cybersecurity-framework ;
    vc:supports ngm:cybersecurity-standard,
        ngm:data-security,
        ngm:risk-management ;
    vc:uses ngm:ai-trust-risk-and-security-management,
        ngm:digital-forensics-framework,
        ngm:endpoint-detection-and-response,
        ngm:user-and-entity-behaviour-analytics .

ngm:identity-and-access-management a owl:Class ;
    rdfs:label "Identity and Access Management"@en ;
    rdfs:comment "Identity and Access Management (IAM) is a security discipline comprising the frameworks, policies, technologies, and processes that govern how digital identities are created, authenticated, authorised, and managed throughout their lifecycle within and across organisational boundaries. IAM systems enforce the principle of least privilege by ensuring that subjects—users, applications, devices, and service accounts—can access only the resources required for their legitimate purpose at the appropriate time. The discipline spans directory services, multi-factor authentication, role-based and attribute-based access control, privileged access management, identity governance and administration, and federated identity protocols that extend trust across cloud and partner environments. IAM is a foundational control domain within information security frameworks such as ISO/IEC 27001, NIST SP 800-53, and Zero Trust architecture models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privileged-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:directory-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authorisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:network-access-control,
        ngm:perimeter-security ;
    vc:enables ngm:access-control,
        ngm:audit-and-compliance,
        ngm:least-privilege,
        ngm:single-sign-on,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:authentication,
        ngm:authorisation,
        ngm:directory-service,
        ngm:privileged-access-management ;
    vc:implements ngm:attribute-based-access-control,
        ngm:role-based-access-control ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:data-governance,
        ngm:identity-management ;
    vc:requires ngm:cryptography,
        ngm:digital-certificate ;
    vc:slug "identity-and-access-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-sp-800-53,
        ngm:scim ;
    vc:uses ngm:ldap,
        ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:public-key-infrastructure,
        ngm:saml .

ngm:ietf a owl:Class ;
    rdfs:label "IETF"@en ;
    rdfs:comment "The Internet Engineering Task Force (IETF) is the principal international open-standards organisation responsible for developing and promoting voluntary Internet standards, particularly those comprising the Internet protocol suite (TCP/IP). It operates through volunteer working groups organised into technical areas, publishing specifications as Requests for Comments (RFCs) — the canonical technical definitions of protocols such as HTTP, TLS, QUIC, SMTP, and DNS. The IETF is a bottom-up, consensus-driven body with no formal membership; participation is open to any technically engaged individual. Its decision ethos of 'rough consensus and running code' has made it the dominant model for pragmatic, implementation-first standards development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rough-consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:request-for-comments ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-group ],
        ngm:standards-body ;
    vc:bridgesTo ngm:ai-infrastructure,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:ieee,
        ngm:iso,
        ngm:w3-c ;
    vc:enables ngm:api-standard,
        ngm:communication-protocol,
        ngm:interoperability,
        ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:request-for-comments,
        ngm:working-group ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:internet-governance,
        ngm:network-standards,
        ngm:open-source,
        ngm:security-protocol ;
    vc:requires ngm:rough-consensus ;
    vc:slug "ietf" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:dns,
        ngm:http,
        ngm:oauth-2-0,
        ngm:quic,
        ngm:tls ;
    vc:supports ngm:ai-governance,
        ngm:authentication-standards,
        ngm:remote-attestation,
        ngm:supply-chain-integrity .

ngm:spatial-audio a owl:Class ;
    rdfs:label "Spatial Audio"@en ;
    rdfs:comment "Three-dimensional sound technology that uses head-related transfer functions (HRTF) and object-based mixing to position audio sources in 3D space around the listener, creating immersive auditory experiences that replicate natural sound perception."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
