ngm:carbon-calculator a owl:Class ;
    rdfs:label "Carbon Calculator"@en ;
    rdfs:comment "A digital tool or software application that estimates greenhouse gas emissions from activities such as energy consumption, transportation, and production by applying standardized emission factors to user-provided data, enabling individuals and organizations to quantify and understand their carbon..."@en ;
    rdfs:subClassOf ngm:sustainability-tool ;
    vc:enables ngm:emissions-estimation,
        ngm:footprint-awareness,
        ngm:reduction-planning ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:activity-data,
        ngm:calculation-methodology,
        ngm:emission-factors ;
    vc:slug "carbon-calculator" ;
    vc:sourceDomain "spatial-computing" .

