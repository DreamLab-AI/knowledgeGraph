ngm:nvidia-corporation a owl:Class ;
    rdfs:label "NVIDIA Corporation"@en ;
    rdfs:comment "NVIDIA Corporation is an American multinational technology company specialising in the design and manufacture of graphics processing units (GPUs), system-on-chip units, and related software platforms that underpin modern parallel computing workloads. Founded in 1993, NVIDIA pioneered the GPU category and subsequently extended its platform to cover artificial intelligence accelerators, high-performance computing, autonomous vehicles, robotics, and data centre infrastructure. Its CUDA parallel-computing platform, combined with purpose-built AI accelerator hardware such as the A100 and H100, has made NVIDIA the dominant supplier of compute for training large language models and other deep neural networks. NVIDIA's vertically integrated hardware-software stack—spanning chips, drivers, libraries, and cloud services—positions the company as foundational infrastructure for the AI era."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semiconductor-fabrication ],
        ngm:gpu-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:omniverse,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:amd,
        ngm:google-tpu,
        ngm:intel-corporation ;
    vc:enables ngm:autonomous-vehicle,
        ngm:computer-vision,
        ngm:deep-learning,
        ngm:high-performance-computing,
        ngm:large-language-model ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cuda,
        ngm:nvidia-dgx,
        ngm:nvlink,
        ngm:tensor-core ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:transformer-architecture ;
    vc:requires ngm:hardware,
        ngm:semiconductor-fabrication ;
    vc:slug "nvidia-corporation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-centre,
        ngm:machine-learning,
        ngm:robotics,
        ngm:scientific-computing ;
    vc:uses ngm:parallel-computing,
        ngm:tsmc .

ngm:nvidia-corporation-h-100 a owl:Class ;
    rdfs:label "NVIDIA H100"@en ;
    rdfs:comment "The NVIDIA H100 is a data-centre GPU accelerator built on the Hopper microarchitecture (GH100 die), designed for AI model training, large-scale inference, and high-performance computing workloads. It introduced a dedicated Transformer Engine with FP8 mixed-precision support, fourth-generation NVLink interconnect, and high-bandwidth HBM3 memory, enabling substantially faster training of large language models and other deep-learning workloads compared to its predecessor, the A100. The H100 is manufactured on TSMC N4 process technology and is available in PCIe and SXM5 form factors, the latter optimised for dense multi-GPU server nodes. Its combination of raw compute throughput and high-speed GPU-to-GPU interconnect made it the de-facto standard accelerator for generative AI infrastructure from 2023 onwards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        ngm:gpu ;
    vc:bridgesTo ngm:ai-data-centre,
        ngm:foundation-model,
        ngm:generative-ai ;
    vc:contrastsWith ngm:amd-instinct-mi300x,
        ngm:google-tpu-v4,
        ngm:nvidia-a100 ;
    vc:dependsOn ngm:cuda,
        ngm:hopper-architecture,
        ngm:nvidia-software-stack ;
    vc:enables ngm:ai-inference,
        ngm:gpu-computing,
        ngm:high-performance-computing,
        ngm:large-language-model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:high-bandwidth-memory,
        ngm:nvlink,
        ngm:nvswitch,
        ngm:transformer-engine ;
    vc:implements ngm:fp8-precision,
        ngm:mixed-precision-training,
        ngm:tensor-core ;
    vc:isPartOf ngm:dgx-h100,
        ngm:gpu-cluster ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-accelerator,
        ngm:nvidia-corporation,
        ngm:nvidia-h200 ;
    vc:requires ngm:cuda,
        ngm:high-bandwidth-memory ;
    vc:slug "nvidia-h-100" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:infiniband,
        ngm:pcie-5 .

