ngm:social-network-analysis a owl:Class ;
    rdfs:label "Social Network Analysis"@en ;
    rdfs:comment "Social network analysis (SNA) is a methodology for studying social structures through graph-theoretic and statistical techniques applied to networks of actors (nodes) and their relationships (edges). It measures structural properties such as centrality, clustering, path length, and community structure to identify influential actors, information bottlenecks, and emergent communities within social systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-structure ],
        ngm:network-analysis ;
