ngm:synthetic-data-generator a owl:Class ;
    rdfs:label "Synthetic Data Generator"@en ;
    rdfs:comment "AI-powered system that produces artificial datasets preserving statistical properties and structural characteristics of original data while protecting privacy and enabling testing scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
