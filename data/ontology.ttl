ngm:openapi a owl:Class ;
    rdfs:comment "OpenAPI is a language-agnostic, machine-readable specification for describing HTTP-based RESTful APIs. An OpenAPI document defines available endpoints, operations, parameters, request and response schemas, and authentication mechanisms in a single structured file written in YAML or JSON. It enables automated generation of documentation, client SDKs, server stubs, and validation logic, decoupling an API's contract from its implementation."@en ;
    rdfs:label "OpenAPI"@en ;
    rdfs:subClassOf ngm:api ;
    vc:enables ngm:interoperability ;
