vf:instant-value-settlement a owl:Class ;
    rdfs:label "Instant value settlement"@en ;
    rdfs:comment "**Instant value settlement** is the process by which the transfer of economic value between counterparties — whether central-bank fiat currency, commercial bank money, tokenised deposits, stablecoins, securities, or programmable digital money — is completed in real time (sub-second to at most a few seconds) with immediate, irrevocable finality, eliminating or collapsing the traditional settlement lag (T+2 for equities in most markets, one to three business days for cross-border wire, several working days for correspondent-chain SWIFT transfers) that has characterised financial infrastructure since manual clearing houses in the nineteenth century. True instant settlement is distinguished from instant notification of a deferred settlement obligation: the critical property is that the payer's account is debited and the payee's account is irrevocably credited in a single atomic operation, eliminating principal risk (the risk that one counterparty delivers while the other fails to settle) and dramatically reducing liquidity needs by eliminating intraday float."@en ;
    rdfs:subClassOf vf:blockchain-network,
        vf:cryptocurrency,
        vf:distributed-ledger,
        vf:financial-infrastructure,
        vf:smart-contract ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:btc-layer-3,
        vf:cbdcs,
        vf:cross-border-compliance,
        vf:decentralized-exchange,
        vf:micropayments,
        vf:nostr-protocol,
        vf:smart-contract,
        vf:stable-coins,
        vf:treasury-management ;
    vc:hasPart vf:atomic-swap,
        vf:cross-chain-bridge,
        vf:cryptography-security-and-privacy,
        vf:digital-signature,
        vf:hash-function,
        vf:lightning-network,
        vf:liquidity-provision,
        vf:smart-contract,
        vf:stable-coins ;
    vc:implements vf:atomic-swap,
        vf:blockchain-network,
        vf:digital-signature,
        vf:distributed-ledger,
        vf:hash-function,
        vf:lightning-network,
        vf:smart-contract ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires vf:aml-kyc-compliance,
        vf:blockchain-network,
        vf:cryptography-security-and-privacy,
        vf:digital-identity,
        vf:digital-signature,
        vf:liquidity-provision,
        vf:regulatory-reporting ;
    vc:slug "instant-value-settlement" ;
    vc:sourceDomain "blockchain" .

