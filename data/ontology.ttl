ngm:liquid-staking-token a owl:Class ;
    rdfs:label "Liquid Staking Token"@en ;
    rdfs:comment "A liquid staking token (LST) is a transferable token issued to a user in exchange for assets staked through a liquid-staking protocol, representing a claim on the underlying stake plus accrued rewards. It frees staked capital from the usual lock-up by remaining tradable and composable across decentralised-finance applications while the principal continues to secure the network. The token's value tracks the staked position, accruing yield either through a rising exchange rate or a growing balance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:liquid-staking ;
    vc:bridgesTo ngm:tokenomics ;
    vc:contrastsWith ngm:wrapped-token ;
    vc:dependsOn ngm:proof-of-stake,
        ngm:validator-node ;
    vc:enables ngm:de-fi,
        ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:reward-distribution ;
    vc:implements ngm:liquid-staking,
        ngm:tokenomics ;
    vc:isPartOf ngm:liquid-staking,
        ngm:staking ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-validator,
        ngm:reward-distribution,
        ngm:slashing ;
    vc:requires ngm:staking,
        ngm:validator-node ;
    vc:slug "liquid-staking-token" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:ethereum,
        ngm:lido ;
    vc:uses ngm:proof-of-stake,
        ngm:token-minting .

ngm:live-co-authoring a owl:Class ;
    rdfs:label "Live Co-authoring"@en ;
    rdfs:comment "Live Co-authoring is the capability that allows multiple users to edit the same document or artifact concurrently, with changes propagated to all participants in near real time. It relies on conflict-resolution mechanisms such as operational transformation or CRDTs to merge simultaneous edits without data loss. Platforms such as Google Docs, Microsoft 365, and Notion use live co-authoring as their primary collaborative editing model."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:enables ngm:document-comments,
        ngm:shared-cursors ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:version-history ;
    vc:slug "live-co-authoring" ;
    vc:sourceDomain "distributed-collaboration" .

