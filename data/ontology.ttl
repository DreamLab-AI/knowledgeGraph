    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-framework,
        ngm:transparency ;
    vc:slug "regulatory-clarity" ;
    vc:sourceDomain "governance" .

ngm:regulatory-standards a owl:Class ;
    rdfs:label "Regulatory Standards"@en ;
    rdfs:comment "Legal and compliance frameworks governing metaverse and extended reality platforms, including data protection (GDPR), artificial intelligence (EU AI Act), digital services (DSA), and accessibility requirements that ensure user rights protection in immersive environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:compliance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "regulatory-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:relation-extraction a skos:Concept ;
    rdfs:label "Relation Extraction"@en .

ngm:remote-education a owl:Class ;
    rdfs:label "Remote Education"@en ;
    rdfs:comment "Remote education is the delivery of teaching and learning to geographically dispersed participants over digital networks, spanning live virtual classrooms, recorded content, and immersive metaverse environments. It depends on collaboration tools such as breakout rooms, shared media, and presence to recreate interactive instruction. Immersive variants add spatial co-presence to improve engagement over flat video."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room,
        ngm:education-metaverse ;
    vc:slug "remote-education" ;
    vc:sourceDomain "metaverse" .

ngm:reproducible-research a skos:Concept ;
    rdfs:label "Reproducible Research"@en .

ngm:reserve-asset a owl:Class ;
    rdfs:label "Reserve Asset"@en ;
    rdfs:comment "An asset held to back a liability or to provide a store of value, such as the holdings that back a stablecoin or the foreign currency reserves held by a central bank. Its purpose is to ensure that claims can be met."@en ;
    rdfs:subClassOf ngm:stablecoin ;
    vc:enables ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
