ngm:overfitting a owl:Class ;
    rdfs:label "Overfitting"@en ;
    rdfs:comment "Overfitting is a phenomenon in machine learning where a model learns the training data too precisely—including noise and spurious correlations—resulting in poor generalisation to unseen data. It corresponds to high variance and low bias in the bias-variance tradeoff, and is mitigated through regularisation, dropout, early stopping, and data augmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-capacity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-robustness,
        ngm:model-governance ;
    vc:contrastsWith ngm:generalisation,
