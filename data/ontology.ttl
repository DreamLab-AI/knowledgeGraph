# CLASS DEFINITIONS
# ==============================================================================

# Non-Fungible Token (NFT)
bc:NonFungibleToken a owl:Class ;
    rdfs:label "Non-Fungible Token (NFT)"@en ;
    rdfs:comment "A digital asset recorded on a distributed ledger that is uniquely identifiable and non-interchangeable, representing ownership or rights to specific digital or physical items."@en ;
    skos:prefLabel "Non-Fungible Token (NFT)"@en ;
    dcterms:identifier "20002" ;
    dcterms:subject "mv" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.95"^^xsd:decimal ;
    rdf:type owl:ObjectClass .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isPartOf ;
    owl:someValuesFrom mv:CryptoToken
] .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isPartOf ;
    owl:someValuesFrom mv:DigitalAsset
] .

