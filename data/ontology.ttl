    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0044-velocity,
        ngm:rb-0045-acceleration,
        ngm:rb-0052-collision-avoidance ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics,
        ngm:rb-0049-motion-planning ;
    vc:slug "rb-0051-trajectory-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:optimal-control,
        ngm:rb-0048-pid-controller .

ngm:retroactive-public-goods-funding a owl:Class ;
    rdfs:label "Retroactive Public Goods Funding"@en ;
    rdfs:comment "Retroactive Public Goods Funding (RetroPGF) is a capital allocation mechanism that rewards contributors to open-source software, protocol infrastructure, or public-benefit projects after they have demonstrably created value, rather than distributing speculative upfront grants based on predicted future impact. By funding proven outcomes rather than promises, RetroPGF reduces misallocation risk and aligns incentives for contributors who can work on public goods in anticipation of eventual recognition. It operates through a trusted allocator — typically a DAO committee or a network of badge holders — who evaluate demonstrated impact and distribute funds from a treasury accordingly."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:public-goods-funding ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:quadratic-funding,
        ngm:smart-contract ;
    vc:slug "retroactive-public-goods-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao,
        ngm:treasury-management .

