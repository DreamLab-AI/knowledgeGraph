        ngm:dao,
        ngm:de-fi-protocol-security,
        ngm:institutional-digital-asset-custody,
        ngm:layer-2-security-council,
        ngm:lightning-network,
        ngm:regulatory-compliance-custody,
        ngm:wholesale-payment-system ;
