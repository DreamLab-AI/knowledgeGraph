    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

# DAO Governance for Telecollaboration
distributed-collaboration:DAOGovernanceForTelecollaboration rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:BlockchainTechnology ;
    rdfs:label "DAO Governance for Telecollaboration"@en ;
    rdfs:comment "\"The application of decentralised autonomous organisation (DAO) governance mechanisms—token-weighted voting, proposal systems, treasury management—to coordinate geographically distributed teams through on-chain decision-making, enabling democratic, transparent collaboration without centralised management or hierarchical authority structures.\""@en ;
    skos:prefLabel "DAO Governance for Telecollaboration"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:dao-governance-for-telecollaboration" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:dao-governance-for-telecollaboration> ;
    vcw:contentHash "sha256-12-53c11cbe00e9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0252" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
