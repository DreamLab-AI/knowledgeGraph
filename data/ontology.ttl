ngm:fan-out a owl:Class ;
    rdfs:comment "A concurrency and orchestration pattern in which a single request or task is split into many independent sub-tasks that are dispatched simultaneously to multiple workers, agents, or services, then optionally recombined by a downstream fan-in step. Fan-out trades higher aggregate resource consumption for reduced wall-clock latency and throughput, and is the structural basis for parallel sub-agent execution, scatter-gather search, and map-style batch processing in agent systems."@en ;
    rdfs:label "Fan-Out"@en ;
    rdfs:subClassOf ngm:design-pattern ;
    rdfs:subClassOf ngm:designpattern ;
