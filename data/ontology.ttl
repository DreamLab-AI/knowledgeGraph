ngm:digital-marketplace a owl:Class ;
    rdfs:comment "A virtual platform enabling the discovery, purchase, sale, and exchange of digital assets, NFTs, virtual goods, and services within metaverse environments, utilising blockchain technology for transparent transactions, ownership verification, and decentralised commerce."@en ;
    rdfs:label "Digital Marketplace"@en ;
