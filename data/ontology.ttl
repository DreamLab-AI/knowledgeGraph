ngm:decentralised-trust a owl:Class ;
    rdfs:label "Decentralised Trust"@en ;
    rdfs:comment "Decentralised trust is an architectural property of a system in which confidence in the correctness of data, identity claims, or transaction outcomes is derived from cryptographic proofs, distributed consensus, and transparent protocol rules rather than from reliance on any single central authority or intermediary. Rather than placing faith in a bank, government registry, or certificate authority, participants in a decentralised trust model verify claims independently using public-key cryptography, Merkle proofs, or zero-knowledge proofs enforced by a distributed network. The result is a system where trust is a computable property of the protocol rather than a social or legal delegation to an institution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:trust ;
    vc:bridgesTo ngm:digital-governance,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:centralised-trust,
        ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:dependsOn ngm:hash-function,
        ngm:peer-to-peer-network ;
    vc:enables ngm:decentralised-finance,
        ngm:decentralised-identity,
        ngm:permissionless-participation,
        ngm:self-sovereign-identity,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:decentralisation,
        ngm:oracle-problem,
        ngm:web-of-trust ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:distributed-ledger ;
    vc:slug "decentralised-trust" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof,
        ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:distributed-consensus,
        ngm:merkle-proof,
        ngm:public-key-cryptography,
        ngm:trust-anchor,
        ngm:zero-knowledge-proof .

