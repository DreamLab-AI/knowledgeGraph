        ngm:soft-contact-tasks ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:compliant-motion-control,
        ngm:force-regulation ;
    vc:qualityScore "0.66"^^xsd:float ;
    vc:requires ngm:damping-control,
        ngm:stiffness-modulation,
        ngm:virtual-dynamics-model ;
    vc:slug "impedance-control" ;
    vc:sourceDomain "robotics" .

ngm:inertial-measurement-unit a owl:Class ;
    rdfs:label "Inertial Measurement Unit"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device incorporating tri-axial accelerometers and gyroscopes — and optionally tri-axial magnetometers — that measures a rigid body's specific force, angular velocity, and magnetic field strength to compute estimates of linear acceleration, angular rate, and orientation relative to an inertial reference frame. IMUs are classified by grade (consumer MEMS, tactical, navigation, strategic) according to drift, noise, and bias stability specifications. In robotics and spatial computing, IMUs provide the high-frequency proprioceptive backbone for state estimation, sensor-fusion pipelines, and attitude control loops."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:robot-sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:odometry,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-hardware ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation,
        ngm:slam ;
    vc:slug "inertial-measurement-unit" ;
    vc:sourceDomain "robotics" .

ngm:life-cycle-assessment a owl:Class ;
    rdfs:label "Life Cycle Assessment"@en ;
    rdfs:comment "Life Cycle Assessment (LCA) is a standardised, systematic methodology (ISO 14040/14044) for compiling and evaluating the inputs, outputs, and potential environmental impacts of a product system across all stages of its life cycle—from raw material acquisition through production, use, and end-of-life treatment. LCA quantifies a range of environmental impact categories including global warming potential (greenhouse gas emissions), acidification, eutrophication, water depletion, and land use, providing a comprehensive evidence base for comparing product alternatives and informing design for environment decisions. The results of LCA studies increasingly feed into ESG reporting, green finance due diligence, and supply chain transparency requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-assessment ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:carbon-footprint-assessment,
        ngm:environmental-sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:esg-reporting,
        ngm:supply-chain-traceability ;
    vc:requires ngm:environmental-assessment ;
    vc:slug "life-cycle-assessment" ;
    vc:sourceDomain "infrastructure" .

ngm:merkle-root a owl:Class ;
    rdfs:label "Merkle Root"@en ;
    rdfs:comment "A Merkle Root is the single cryptographic hash at the apex of a Merkle tree, computed by recursively hashing pairs of child hashes until a single digest remains, such that the root encodes the integrity of every transaction or data element in the tree. In blockchain systems, each block header contains the Merkle root of all transactions in that block, enabling lightweight clients to verify transaction inclusion via a logarithmic-length Merkle proof without downloading the full block. This compact commitment property makes the Merkle root fundamental to blockchain scalability, security, and efficient synchronisation protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-scalability,
        ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-hash,
        ngm:merkle-tree ;
    vc:isPartOf ngm:block,
        ngm:block-header ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-entity,
        ngm:digital-signature,
        ngm:nonce,
        ngm:proof-of-work ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:slug "merkle-root" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-infrastructure .

ngm:metaverse-domain a owl:Class ;
    rdfs:label "Metaverse Domain"@en ;
    rdfs:comment "The Metaverse Domain is an ontological category encompassing interconnected persistent digital environments that merge augmented, virtual, and extended realities into immersive, spatially coherent experiences. It includes the technological, economic, social, and governance layers enabling persistent identity, asset ownership, and real-time interaction across virtual worlds. The domain spans enabling technologies such as spatial computing, blockchain-based economies, avatar systems, and haptic feedback that collectively constitute the metaverse stack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
