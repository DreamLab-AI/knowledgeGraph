ngm:snapshot-hub a owl:Class ;
    rdfs:comment "Snapshot Hub is the backend service of the Snapshot off-chain governance platform that stores proposals, collects signed votes, and computes results using token balances read at a chosen block height. Votes are signed messages that incur no gas, while the hub indexes and tallies them according to a configurable voting strategy. It lets DAOs run gasless, verifiable governance while final execution remains optional and off-chain."@en ;
    rdfs:label "Snapshot Hub"@en ;
    rdfs:subClassOf ngm:network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:snapshot-block ;
    vc:relatedTo ngm:snapshot-voting ;
    vc:slug "snapshot-hub" ;
    vc:sourceDomain "blockchain" .
ngm:snapshot-management a skos:Concept ;
    rdfs:label "Snapshot Management"@en .
ngm:snapshot-off-chain-voting a owl:Class ;
    rdfs:comment "A gasless governance platform that records votes off-chain by having participants sign messages, using token balances captured at a chosen block as voting weight. It avoids transaction fees while preserving a verifiable tally tied to on-chain holdings."@en ;
    rdfs:label "Snapshot Off-Chain Voting"@en ;
