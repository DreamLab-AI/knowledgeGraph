ngm:eu-mi-ca-regulation a owl:Class ;
    rdfs:label "EU MiCA Regulation"@en ;
    rdfs:comment "The EU Markets in Crypto-Assets Regulation is a European Union framework establishing harmonised rules for crypto-asset issuance, trading and service provision, covering asset-referenced tokens, e-money tokens, and crypto-asset service providers across EU member states."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-frameworks ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        ngm:crypto-regulation ;
    vc:bridgesTo ngm:blockchain,
        ngm:central-bank-digital-currency,
        ngm:digital-asset-custody ;
    vc:contrastsWith ngm:defi-protocol,
        ngm:sec-crypto-enforcement ;
    vc:enables ngm:eu-single-market-passporting,
        ngm:investor-protection,
        ngm:market-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-referenced-token-regime,
        ngm:crypto-asset-service-provider-authorisation,
        ngm:electronic-money-token-regime ;
    vc:implements ngm:eu-financial-regulation,
        ngm:fatf-travel-rule ;
    vc:isPartOf ngm:eu-digital-finance-strategy ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering-directive,
        ngm:gdpr ;
    vc:requires ngm:crypto-asset-service-provider,
        ngm:kyc-aml-compliance,
        ngm:regulatory-frameworks,
        ngm:whitepaper-disclosure ;
    vc:slug "eu-mi-ca-regulation" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:european-banking-authority,
        ngm:european-securities-and-markets-authority ;
    vc:supports ngm:consumer-protection,
        ngm:financial-stability ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:stablecoin .

