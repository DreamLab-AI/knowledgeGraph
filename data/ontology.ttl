        ngm:physical-network-hardware ;
    vc:slug "networking-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:neural-ordinary-differential-equation a owl:Class ;
    rdfs:label "Neural Ordinary Differential Equation"@en ;
    rdfs:comment "A neural ordinary differential equation (Neural ODE) is a class of deep learning model that parameterises the derivative of a hidden state with a neural network and obtains outputs by numerically integrating this learned dynamics. Rather than stacking a fixed number of discrete layers, it treats the transformation of representations as a continuous trajectory governed by an ODE, with depth replaced by integration time. This continuous-depth formulation enables memory-efficient training via the adjoint method and natural modelling of time-series and continuous dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:numerical-integration ],
        ngm:neural-network ;
    vc:bridgesTo ngm:ordinary-differential-equation,
        ngm:scientific-computing ;
    vc:contrastsWith ngm:residual-network,
        ngm:stochastic-differential-equation ;
    vc:dependsOn ngm:ordinary-differential-equation ;
    vc:enables ngm:dynamical-systems,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ordinary-differential-equation ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:dynamical-systems,
        ngm:residual-network ;
    vc:requires ngm:gradient-descent,
        ngm:numerical-integration ;
    vc:slug "neural-ordinary-differential-equation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:optimisation,
        ngm:scientific-computing ;
    vc:uses ngm:backpropagation,
        ngm:numerical-integration,
        ngm:ordinary-differential-equation .

ngm:nist-fips-186 a owl:Class ;
    rdfs:label "NIST FIPS 186"@en ;
    rdfs:comment "A NIST Federal Information Processing Standard specifying the Digital Signature Standard (DSS), defining approved algorithms for generating and verifying digital signatures. It covers algorithms such as DSA, RSA and ECDSA depending on the revision."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nist ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:nist ;
