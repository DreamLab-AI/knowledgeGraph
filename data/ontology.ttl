ngm:institutional-custody a owl:Class ;
    rdfs:label "Institutional Custody"@en ;
    rdfs:comment "Institutional custody is the regulated safekeeping of digital assets on behalf of organisations such as funds, exchanges, and corporations, combining cryptographic key-management infrastructure with legal, operational, and insurance controls that meet fiduciary standards. Providers use cold storage, multi-signature and multi-party-computation schemes, hardware security modules, and segregated accounts to protect client assets against theft, loss, and insider risk while supporting auditability and regulatory reporting. It is a precondition for large-scale institutional participation in crypto markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cold-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management-system ],
        ngm:custody ;
    vc:bridgesTo ngm:securities-regulation ;
    vc:contrastsWith ngm:decentralised-finance,
        ngm:self-custody ;
    vc:dependsOn ngm:fiduciary-duty,
        ngm:financial-regulation ;
    vc:enables ngm:institutional-investment,
        ngm:spot-bitcoin-etf ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cold-storage,
        ngm:hardware-security-module,
        ngm:multi-party-computation ;
    vc:implements ngm:audit-trail,
        ngm:segregation-of-duties ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proof-of-reserves ;
    vc:requires ngm:key-management-system ;
    vc:slug "institutional-custody" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-asset-custody,
        ngm:regulatory-reporting ;
    vc:uses ngm:multi-signature-wallet,
        ngm:threshold-signature-scheme .

ngm:json-data-interchange-format-web-token a owl:Class ;
    rdfs:label "JSON Web Token"@en ;
    rdfs:comment "A JSON Web Token (JWT) is a compact, URL-safe representation of claims transmitted between parties, defined by IETF RFC 7519. A JWT consists of three Base64URL-encoded parts — header, payload, and signature — concatenated with periods. The header specifies the token type and signing algorithm; the payload carries claims (assertions about a subject such as user identity, roles, and expiry time); and the signature is computed using either a symmetric shared secret (HMAC) or an asymmetric key pair (RSA, ECDSA), allowing the receiving party to verify token integrity without a round-trip to an authorisation server. JWTs are the dominant stateless session mechanism in REST API and OAuth 2.0 / OpenID Connect identity architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:authentication-mechanism ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:saml-assertion ;
    vc:enables ngm:access-control,
        ngm:authentication,
        ngm:federated-identity,
        ngm:rest-api,
        ngm:session-management,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bearer-token ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:digital-identity,
        ngm:json-web-encryption,
        ngm:microservices-architecture,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:refresh-token,
        ngm:sd-jwt ;
    vc:requires ngm:public-key-infrastructure ;
    vc:slug "json-web-token" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:base64url-encoding,
        ngm:cryptographic-signature,
        ngm:elliptic-curve-digital-signature-algorithm,
        ngm:hmac,
        ngm:ietf,
        ngm:public-key-cryptography,
        ngm:rsa-algorithm .

ngm:kyc-aml a owl:Class ;
    rdfs:label "KYC/AML"@en ;
    rdfs:comment "KYC/AML refers to Know Your Customer and Anti-Money Laundering regulatory requirements that obligate financial institutions to verify customer identities and monitor transactions for illicit activity. KYC governs identity verification and risk profiling at onboarding, while AML covers ongoing monitoring, suspicious-activity reporting and sanctions screening. These regimes shape compliance for banks, exchanges and crypto-asset service providers."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analysis,
        ngm:distributed-identity ;
    vc:slug "kyc-aml" ;
    vc:sourceDomain "governance" .

ngm:layer-normalisation a owl:Class ;
    rdfs:label "Layer Normalisation"@en ;
    rdfs:comment "A normalisation technique that computes mean and variance across the feature dimension for each training example independently, then rescales activations using learnable scale and shift parameters. Unlike batch normalisation, layer normalisation is invariant to batch size, making it the standard choice for transformer and recurrent architectures where sequence lengths vary."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:batch-normalisation ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:feed-forward-network,
        ngm:residual-connection ;
    vc:slug "layer-normalisation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:learning-rate-schedule a owl:Class ;
    rdfs:label "Learning Rate Schedule"@en ;
    rdfs:comment "A systematic strategy for varying the learning rate hyperparameter during model training, either according to a fixed rule (step decay, cosine annealing, exponential decay) or adaptively in response to training signals. Learning rate schedules improve convergence and final model performance by applying higher rates early for rapid progress and lower rates during fine-tuning, thereby reducing the risk of overshooting loss minima."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:training-and-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline-framework,
        ngm:neural-network ;
    vc:requires ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:slug "learning-rate-schedule" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:training .

ngm:medical-ai a owl:Class ;
    rdfs:label "Medical AI"@en ;
    rdfs:comment "Medical AI encompasses artificial intelligence and machine learning applications in healthcare for disease detection, diagnosis, treatment planning, clinical decision support, drug discovery, and patient outcome prediction, subject to medical-device regulation and clinical validation requirements."@en ;
