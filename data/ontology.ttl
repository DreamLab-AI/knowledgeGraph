        ngm:liquidity-pool ;
    vc:slug "maker-dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract .

ngm:material-definition a owl:Class ;
    rdfs:label "Material Definition"@en ;
    rdfs:comment "A material definition is a structured data specification that describes how a surface or volume should appear under lighting, encoding properties such as base colour, roughness, metalness, emissivity, and transparency in a renderer-agnostic format. It underpins physically based rendering (PBR) pipelines by separating the description of physical surface behaviour from the rendering algorithm that evaluates it. Material definitions may be authored in formats such as MaterialX, glTF materials, or OpenUSD surface shading networks, enabling interchange across tools and engines. They are fundamental to achieving photorealistic and stylised visuals in real-time and offline 3D workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:pixel-shader,
        ngm:vertex-shader ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering,
        ngm:gltf-standard,
        ngm:open-usd,
        ngm:render-pipeline ;
    vc:slug "material-definition" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:physically-based-rendering,
