# Blockchain Energy Consumption
blockchain:BlockchainEnergyConsumption rdf:type owl:Class ;
    rdfs:subClassOf blockchain:EnvironmentalImpact ;
    rdfs:subClassOf blockchain:BlockchainPerformance ;
    rdfs:subClassOf blockchain:Sustainability ;
    rdfs:label "Blockchain Energy Consumption"@en ;
    rdfs:comment "The electrical power and computational resources consumed by blockchain networks during transaction validation, block creation, and network security operations, varying significantly across consensus mechanisms from energy-intensive Proof-of-Work (Bitcoin: ~140 TWh/year, 0.65% global electricity) to energy-efficient Proof-of-Stake (Ethereum post-Merge: 99.95% reduction), with ongoing research into sustainable consensus algorithms, renewable energy mining, carbon credit tokenization, and environmental impact measurement frameworks."@en ;
    skos:prefLabel "Blockchain Energy Consumption"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:blockchain-energy-consumption" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:blockchain-energy-consumption> ;
    vcw:contentHash "sha256-12-1dced05253fa" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-0496" ;
    vcw:ontologyStatus "mature" ;
    vcw:maturityLevel "production-ready" ;
    vcw:authorityScore "0.88"^^xsd:decimal ;
    dcterms:identifier "BC-0496" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "PerformanceMetric" .

