ngm:rmsnorm a owl:Class ;
    rdfs:label "RMSNorm"@en ;
    rdfs:comment "Root Mean Square Layer Normalisation (RMSNorm) is a neural network normalisation technique that re-scales each activation vector by the inverse of the root mean square of its elements, eliminating the mean-subtraction and bias terms present in standard Layer Normalisation. By removing the re-centring computation, RMSNorm reduces operational cost while achieving comparable training stability and generalisation performance to Layer Normalisation in transformer architectures. RMSNorm has been adopted as the default normalisation layer in several state-of-the-art large language models including LLaMA and Mistral, reflecting both its empirical effectiveness and its computational efficiency on GPU hardware."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:batch-normalisation,
        ngm:layer-normalisation ;
    vc:enables ngm:training-and-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:large-language-models ;
    vc:slug "rmsnorm" ;
    vc:sourceDomain "artificial-intelligence" .

