    vc:slug "geospatial-data" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso,
        ngm:open-geospatial-consortium ;
    vc:uses ngm:spatial-index .

ngm:gpt a owl:Class ;
    rdfs:label "GPT"@en ;
    rdfs:comment "Generative Pre-trained Transformer: an autoregressive language model that uses transformer decoder architecture and is pre-trained on large text corpora using next-token prediction. GPT models learn rich representations through unsupervised pre-training and are subsequently fine-tuned for diverse downstream NLP tasks, demonstrating that scale and the language modelling objective yield powerful transfer learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:ai-safety,
        ngm:multimodal-ai-architecture-ai ;
    vc:contrastsWith ngm:bert,
        ngm:encoder-decoder-architecture ;
    vc:dependsOn ngm:large-language-models,
        ngm:scaling-laws,
        ngm:unsupervised-learning ;
    vc:enables ngm:code-generation,
        ngm:conversational-ai,
        ngm:few-shot-learning,
        ngm:natural-language-processing,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:feed-forward-network,
        ngm:self-attention ;
    vc:implements ngm:causal-language-modelling,
        ngm:decoder-only-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:prompt-engineering ;
    vc:slug "gpt" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:next-token-prediction,
        ngm:pre-training,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transfer-learning .

ngm:graph-ql a owl:Class ;
    rdfs:label "GraphQL"@en ;
    rdfs:comment "GraphQL is a query language and runtime for APIs, developed by Facebook and open-sourced in 2015, that allows clients to specify precisely the data they need in a single request rather than consuming fixed-shape REST endpoints. It is defined by a strongly typed schema that describes the graph of types and fields the API exposes, and a runtime that resolves client queries against that schema by executing resolver functions. GraphQL eliminates the over-fetching and under-fetching problems inherent in REST by shifting data shape control to the client, and its introspection capability enables rich developer tooling and automatic documentation generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:type-system ],
        ngm:api-standard ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:large-language-model ;
    vc:contrastsWith ngm:g-rpc,
        ngm:rest-api ;
    vc:enables ngm:api-integration,
        ngm:code-generation,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-management,
        ngm:g-rpc,
        ngm:open-api-specification,
        ngm:rest-api ;
    vc:requires ngm:type-system ;
    vc:slug "graph-ql" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:linux-foundation ;
    vc:supports ngm:federation ;
    vc:uses ngm:http-protocol,
        ngm:json-data-interchange-format,
        ngm:schema-definition,
        ngm:type-system .

