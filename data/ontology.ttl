ngm:ai-ethics a owl:Class ;
    rdfs:label "AI Ethics"@en ;
    rdfs:comment "AI Ethics addresses the moral principles, values, and guidelines governing the design, development, deployment, and use of artificial intelligence systems. This interdisciplinary field examines fairness, accountability, transparency, privacy, and bias mitigation, drawing on philosophy, law, and computer science to ensure AI systems respect human rights and societal values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        ngm:ai-governance,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:bias-mitigation-techniques,
        ngm:compliance-framework ;
    vc:requires ngm:explainable-ai,
        ngm:fairness ;
    vc:slug "ai-ethics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:responsible-ai .

ngm:fault-tolerance a owl:Class ;
    rdfs:label "Fault Tolerance"@en ;
    rdfs:comment "System property denoting the capability of a computing or distributed system to continue providing correct service in the presence of component failures, encompassing the formal failure-model taxonomy enumerated by Cristian (fail-stop, fail-silent, omission, crash-recovery, timing, Byzantine arbi..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:replication ],
        [ a owl:Restriction ;
