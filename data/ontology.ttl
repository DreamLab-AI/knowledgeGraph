ngm:audio-codec a owl:Class ;
    rdfs:comment "An audio codec is a technology that encodes audio into a compressed digital representation and decodes it back for playback, reducing storage and bandwidth requirements. Lossy codecs discard perceptually less important information to achieve high compression, while lossless codecs preserve the original signal exactly. Codecs balance bitrate, audio quality, latency and computational cost, and define container-independent bitstream formats. They are essential to streaming, telephony, broadcasting and immersive spatial audio."@en ;
    rdfs:label "Audio Codec"@en ;
    rdfs:subClassOf ngm:audio-processing ;
    rdfs:subClassOf _:r2116 ;
    rdfs:subClassOf _:r2117 ;
    rdfs:subClassOf _:r2118 ;
    rdfs:subClassOf _:r2119 ;
