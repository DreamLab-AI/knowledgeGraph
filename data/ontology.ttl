ngm:enterprise-smart-contracts a owl:Class ;
    rdfs:label "Enterprise Smart Contracts"@en ;
    rdfs:comment "Enterprise smart contracts are self-executing code artefacts deployed on permissioned [[Distributed Ledger Technology]] platforms — [[Hyperledger Fabric]] chaincode (Go/Node.js/Java), [[R3 Corda]] CorDapps (Kotlin/JVM), [[Quorum Blockchain]] and [[Hyperledger Besu]] (EVM permissioned with Tessera..."@en ;
    rdfs:subClassOf ngm:business-logic-code,
        ngm:multi-party-agreement ;
    vc:enables ngm:atomic-settlement,
        ngm:delivery-versus-payment,
        ngm:insurance-claim-automation,
        ngm:provenance-tracking,
        ngm:regulatory-reporting-automation,
        ngm:syndicated-lending-automation,
        ngm:tokenised-securities,
        ngm:trade-finance-automation ;
    vc:hasPart ngm:chaincode,
        ngm:contract-state,
        ngm:cor-dapp,
        ngm:endorsement-policy,
        ngm:flow-logic,
        ngm:notary-service,
        ngm:private-data-collection,
        ngm:ricardian-contract-template,
        ngm:solidity-contract ;
    vc:implements ngm:accord-project-cicero,
        ngm:erc-1400-security-token,
        ngm:erc-3475-abstract-bond,
        ngm:erc-3643-t-rex,
        ngm:finos-common-domain-model,
        ngm:isda-common-domain-model,
        ngm:ricardian-contracts ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:b3i,
        ngm:contour,
        ngm:dtcc-digital-securities-initiative,
        ngm:finastra-fusion-lender-comm,
        ngm:insurwave,
        ngm:jpm-onyx,
        ngm:marco-polo-network,
        ngm:project-cedar,
        ngm:project-mariana,
        ngm:project-rosalind,
        ngm:trade-lens,
        ngm:we-trade ;
    vc:requires ngm:audit-function,
        ngm:certificate-authority,
        ngm:governance-framework,
        ngm:identity-management,
        ngm:legal-agreement,
        ngm:permissioned-blockchain,
        ngm:public-key-infrastructure ;
    vc:slug "enterprise-smart-contracts" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:accord-project,
        ngm:enterprise-ethereum-alliance,
        ngm:erc-1400,
        ngm:erc-3475,
        ngm:erc-3643,
        ngm:finos-cdm,
        ngm:hyperledger-foundation,
        ngm:isda-cdm,
        ngm:iso-tc-307 ;
    vc:supports ngm:confidential-computing,
        ngm:consortium-governance,
        ngm:cross-chain-interoperability,
        ngm:multi-party-workflow,
        ngm:regulatory-compliance,
        ngm:tokenisation,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:amd-sev-snp,
        ngm:aws-nitro-enclaves,
        ngm:azure-confidential-ledger,
        ngm:go,
        ngm:intel-sgx,
        ngm:java,
        ngm:kotlin,
        ngm:node-js,
        ngm:open-zeppelin-proxy-pattern,
        ngm:orion,
        ngm:solidity,
        ngm:tessera,
        ngm:web-assembly .

