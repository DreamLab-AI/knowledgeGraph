ngm:loss-function a owl:Class ;
    rdfs:label "Loss Function"@en ;
    rdfs:comment "A Loss Function is a mathematical function that quantifies the discrepancy between a model's predicted outputs and true target values, producing a scalar error measure that serves as the objective for optimisation algorithms during training."@en ;
