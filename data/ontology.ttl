ngm:identity-federation a owl:Class ;
    rdfs:label "Identity Federation"@en ;
    rdfs:comment "A distributed authentication workflow that enables cross-domain identity linking through trust relationships, allowing users to access resources across multiple organizations using a single set of credentials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider-id-p ],
