    vc:slug "precision-medicine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:medical-ai .

ngm:priority-fee a owl:Class ;
    rdfs:label "Priority Fee"@en ;
    rdfs:comment "A Priority Fee (also called a miner tip or validator tip) is an optional, user-specified additional payment on top of the base fee in EIP-1559-compatible blockchains, paid directly to the block producer to incentivise preferential inclusion and ordering of a transaction within the next block. By offering a higher tip, users signal urgency and compete for limited block space during periods of network congestion, enabling a market-based transaction prioritisation mechanism. Priority fees are burned alongside the base fee under EIP-1559's fee model only partially — the base fee is burned while the priority fee flows to the validator, aligning incentives for prompt transaction confirmation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:burning-mechanism ;
    vc:dependsOn ngm:base-fee,
        ngm:eip-1559 ;
    vc:enables ngm:gas-optimization,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gas ;
    vc:isPartOf ngm:fee-market,
        ngm:tokenomics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:gas-price,
        ngm:transaction-fee,
        ngm:validator-node ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "priority-fee" ;
    vc:sourceDomain "blockchain" .

ngm:privacy-and-data-governance a owl:Class ;
    rdfs:label "Privacy and Data Governance"@en ;
    rdfs:comment "Privacy and Data Governance is a trustworthiness dimension ensuring AI systems protect personal information, respect data rights, maintain data quality, and implement appropriate access controls throughout data collection, processing, storage, and sharing activities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:artificial-intelligence ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "privacy-and-data-governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:privacy-engineering a owl:Class ;
    rdfs:label "Privacy Engineering"@en ;
    rdfs:comment "Privacy Engineering is the systematic application of engineering methods to translate privacy principles and regulatory requirements into concrete technical controls embedded within systems and processes. It operationalises concepts such as data minimisation, purpose limitation, and consent management through design patterns, threat models, and measurable privacy metrics. Techniques include differential privacy for statistical disclosures, homomorphic encryption for computation on sensitive data, and k-anonymity for dataset release. The discipline bridges legal obligations—particularly GDPR and similar frameworks—with software architecture and data pipeline design, treating privacy as a quality attribute alongside performance and security."@en ;
    rdfs:subClassOf ngm:privacy-by-design ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-and-data-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:personal-data-store,
        ngm:secure-multi-party-computation ;
    vc:slug "privacy-engineering" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:consent-management,
        ngm:data-minimisation,
        ngm:differential-privacy,
        ngm:homomorphic-encryption .

ngm:privacy-preserving-data-mining a owl:Class ;
    rdfs:label "Privacy Preserving Data Mining"@en ;
    rdfs:comment "Privacy-Preserving Data Mining (PPDM) is a research field and collection of techniques that enable extraction of useful knowledge patterns—including association rules, classifiers, clusters, and outliers—from datasets while preventing disclosure of sensitive individual records. PPDM methods span data perturbation (noise addition, randomisation, synthetic data generation before mining), cryptographic protocols (secure multi-party computation for distributed pattern discovery, homomorphic encryption for encrypted operations), anonymisation transformations (k-anonymity, l-diversity, t-closeness applied before dataset release), and differential-privacy query mechanisms that inject calibrated noise into published pattern outputs. The field navigates an inherent privacy–utility trade-off: stronger privacy guarantees typically reduce pattern accuracy, and compositions of multiple analyses risk cumulative information leakage through inference and re-identification attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-sharing,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:membership-inference,
        ngm:model-inversion,
        ngm:pattern-recognition ;
    vc:requires ngm:differential-privacy,
        ngm:secure-multi-party-computation ;
    vc:slug "privacy-preserving-data-mining" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:homomorphic-encryption-for-machine-learning ;
    vc:uses ngm:anomaly-detection,
        ngm:federated-learning,
        ngm:synthetic-data .

ngm:project-management a owl:Class ;
    rdfs:label "Project Management"@en ;
    rdfs:comment "Project Management is the disciplined application of knowledge, skills, tools, and techniques to project activities in order to meet defined requirements within constraints of scope, time, cost, and quality. It encompasses initiation, planning, execution, monitoring and control, and closure phases, employing methodologies ranging from waterfall and PRINCE2 to agile frameworks such as Scrum and Kanban, and supporting the delivery of technology, construction, research, and organisational change initiatives."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:change-management,
        ngm:collaboration,
        ngm:software-development-process ;
    vc:slug "project-management" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance-framework,
        ngm:software-development ;
    vc:uses ngm:resource-management,
        ngm:risk-management,
        ngm:stakeholder-engagement,
        ngm:workflow-automation .

ngm:proof-of-stake-sustainability a owl:Class ;
    rdfs:label "Proof Of Stake Sustainability"@en ;
    rdfs:comment "Proof of Stake Sustainability refers to the environmental, economic, and governance characteristics of Proof of Stake consensus mechanisms that make them a viable long-term alternative to energy-intensive Proof of Work systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        [ a owl:Restriction ;
