ngm:stepper-motor a owl:Class ;
    rdfs:label "Stepper Motor"@en ;
    rdfs:comment "A stepper motor is an electromechanical actuator that divides a full rotation into a fixed number of discrete angular steps, enabling precise open-loop position control without requiring feedback sensors. By energising coils in sequence, the rotor advances one step per pulse, making stepper motors essential for applications demanding repeatable positioning such as CNC machining, 3D printing, and robotic joints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-loop-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        ngm:electric-motor,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:dc-servo-motor,
        ngm:servo-motor ;
    vc:enables ngm:robotics-control,
        ngm:robotics-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder,
        ngm:rotary-encoder ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robot-actuator,
        ngm:robotics ;
    vc:requires ngm:embedded-systems,
        ngm:motion-control,
        ngm:open-loop-control ;
    vc:slug "stepper-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:electric-actuator .

ngm:storage-systems a owl:Class ;
    rdfs:label "Storage Systems"@en ;
    rdfs:comment "Storage Systems are the hardware and software architectures responsible for persisting, organising, retrieving, and protecting digital data across the full hierarchy from on-chip registers and DRAM through local SSDs and HDDs to distributed cloud object stores and decentralised peer-to-peer networks. The discipline encompasses storage media technology, file systems, block and object storage interfaces, data durability through redundancy (RAID, erasure coding), consistency and replication protocols for distributed deployments, and the performance-cost-durability tradeoffs that govern system design. Storage Systems are foundational infrastructure for every computing application, with particular complexity arising in distributed and decentralised configurations where network partitions, node failures, and latency variability must be handled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:persistent-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-storage ],
        ngm:storage-infrastructure ;
    vc:enables ngm:data-integrity,
        ngm:data-replication,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cloud-storage,
        ngm:content-addressed-storage,
        ngm:distributed-storage,
        ngm:persistent-storage ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-storage-layer,
        ngm:storage-hardware ;
    vc:slug "storage-systems" ;
    vc:sourceDomain "infrastructure" .

ngm:supply-chain-provenance a owl:Class ;
    rdfs:label "Supply Chain Provenance"@en ;
    rdfs:comment "Supply chain provenance is the verified documentary record of an item's origin, material composition, transformation steps, custody changes, and transportation history from raw material extraction through to the end consumer, enabling authenticity verification, ethical sourcing attestation, and regulatory compliance. It extends data provenance principles to physical goods, typically combining IoT sensor data, third-party audit records, and cryptographic anchors (hashes or blockchain transactions) to create an immutable chain of evidence that resists falsification and supports granular attribution."@en ;
    rdfs:subClassOf ngm:provenance-tracking ;
    vc:enables ngm:anti-counterfeiting,
        ngm:supply-chain-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-custody,
        ngm:supply-chain,
        ngm:supply-chain-traceability ;
    vc:slug "supply-chain-provenance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:provenance-verification ;
    vc:uses ngm:audit-trail,
        ngm:supply-chain-blockchain .

