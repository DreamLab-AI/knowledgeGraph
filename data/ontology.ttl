    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:MixedReality
] .

mv:RealityVirtualityContinuum rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:AugmentedReality
] .

mv:RealityVirtualityContinuum rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VirtualReality
] .

