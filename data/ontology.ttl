ngm:multi-agent-coordination a owl:Class ;
    rdfs:label "Multi-Agent Coordination"@en ;
    rdfs:comment "Multi-agent coordination is the set of mechanisms and protocols by which a population of autonomous agents organise their individual actions, communications, and resource usage to achieve shared or mutually compatible goals without central command. It encompasses task decomposition and allocation, conflict detection and resolution, synchronisation of parallel workstreams, and the design of incentive structures that align agent behaviour across heterogeneous systems. Coordination differs from simple parallelism in that it requires agents to reason about the intentions and capabilities of peers, adapting their own behaviour accordingly. Contemporary implementations range from classical Distributed Constraint Optimisation Problems (DCOP) to large-language-model orchestration frameworks in which a controller agent delegates subtasks to specialist sub-agents and integrates their outputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conflict-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-agent ],
        ngm:multi-agent-systems ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralised-control,
        ngm:single-agent-system ;
    vc:dependsOn ngm:distributed-systems,
        ngm:game-theory ;
    vc:enables ngm:agentic-workflow,
        ngm:distributed-problem-solving,
        ngm:emergent-behavior ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conflict-resolution,
        ngm:consensus-mechanism,
        ngm:negotiation-protocol,
        ngm:task-allocation ;
    vc:isPartOf ngm:multi-agent-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-communication-language,
        ngm:auction-mechanism,
        ngm:plan-merging ;
    vc:requires ngm:ai-agent,
        ngm:communication-protocol,
        ngm:shared-environment ;
    vc:slug "multi-agent-coordination" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:llm-orchestration,
        ngm:robotic-swarm ;
    vc:uses ngm:belief-desire-intention,
        ngm:message-passing,
        ngm:reinforcement-learning .

