    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1008odometry
] .

rb:Localization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1015kalmanfilter
] .

rb:Localization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1014montecarlolocalization
] .

rb:Localization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:AutonomousVehicles
] .

rb:Localization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:MobileRobots
] .

# Monte Carlo Localization
rb:MonteCarloLocalization a owl:Class ;
    rdfs:subClassOf rb:RB1013localization ;
    rdfs:label "Monte Carlo Localization"@en ;
    rdfs:comment "A probabilistic localization algorithm that represents the robot's belief about its position using a set of weighted particles (samples), where each particle represents a hypothesis of the robot's pose. It implements a particle filter to recursively estimate the robot's pose distribution."@en ;
    skos:prefLabel "Monte Carlo Localization"@en ;
    dcterms:identifier "RB-1014" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.96"^^xsd:decimal ;
    rdf:type owl:AlgorithmClass .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:GlobalLocalization
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:KidnappedRobotProblem
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isInstanceOf ;
    owl:someValuesFrom rb:ParticleFilter
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isInstanceOf ;
    owl:someValuesFrom rb:BayesFilter
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1008odometry
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:SensorFusion
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:alternativeTo ;
    owl:someValuesFrom rb:RB1015kalmanfilter
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:MobileRobots
] .

rb:MonteCarloLocalization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:SLAM
] .

# Kalman Filter
rb:KalmanFilter a owl:Class ;
    rdfs:subClassOf rb:StateEstimation ;
    rdfs:subClassOf rb:BayesFilter ;
    rdfs:label "Kalman Filter"@en ;
    rdfs:comment "An optimal recursive Bayesian filter that estimates the state of a linear dynamic system from a series of noisy measurements. It minimizes the mean squared error of the estimated state by combining predictions with measurements using weighted averaging based on uncertainty."@en ;
    skos:prefLabel "Kalman Filter"@en ;
    dcterms:identifier "RB-1015" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.98"^^xsd:decimal ;
    rdf:type owl:AlgorithmClass .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:usedIn ;
    owl:someValuesFrom rb:RB1013localization
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:usedIn ;
    owl:someValuesFrom rb:RB1002closedloopcontrol
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:alternativeTo ;
    owl:someValuesFrom rb:RB1014montecarlolocalization
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:extendedBy ;
    owl:someValuesFrom rb:ExtendedKalmanFilter
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:extendedBy ;
    owl:someValuesFrom rb:UnscentedKalmanFilter
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:RB1008odometry
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:SensorFusion
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:Navigation
] .

rb:KalmanFilter rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:Tracking
] .

rb:KalmanFilter rdfs:subClassOf [
