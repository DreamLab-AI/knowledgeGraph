ngm:edge-layer a owl:Class ;
    rdfs:label "Edge Layer"@en ;
    rdfs:comment "The Edge Layer is the cross-cutting stratum at the periphery of a system, where it meets external devices, users, and data sources. It sits above local hardware and network resources and below the application workloads it serves close to origin. It contains edge gateways, local caches, and the boundary logic that mediates between core and periphery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-layer ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:application-layer,
        ngm:edge-computing-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware-layer,
        ngm:network-layer ;
    vc:slug "edge-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:electra a owl:Class ;
    rdfs:label "ELECTRA"@en ;
    rdfs:comment "ELECTRA (Efficiently Learning an Encoder that Classifies Token Replacements Accurately) is a transformer pre-training method that trains a discriminator to detect replaced tokens rather than reconstructing masked inputs, using a generator-discriminator architecture. This replaced token detection task utilises all positions in a sequence, yielding substantially greater sample efficiency than masked language modelling with less than one quarter of the compute required by comparable models."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:albert,
        ngm:ro-berta ;
    vc:enables ngm:machine-learning-discipline-model,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:large-language-models ;
    vc:slug "electra" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:language-modeling,
        ngm:transformer,
        ngm:transformer-architecture .

ngm:employment-contract-restructuring-analysis a owl:Class ;
    rdfs:label "Employment Contract Restructuring Analysis"@en ;
    rdfs:comment "Role reorg denotes an organisational restructuring process in which employment or contractual arrangements are renegotiated, typically comparing permanent employment contracts with temporary or agency-based assignments across dimensions such as salary, holiday entitlement, pension eligibility, notice periods, and additional benefits. Such analysis underpins workforce planning decisions in academic and research institutions, balancing income stability against contractual flexibility and total compensation."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:augmented-connected-workforce,
        ngm:economics ;
    vc:slug "employment-contract-restructuring-analysis" ;
    vc:sourceDomain "infrastructure" .

ngm:ensemble-collaborative-intelligence-principle a owl:Class ;
    rdfs:label "Ensemble Collaborative Intelligence Principle"@en ;
    rdfs:comment "Two Heads Are Better Than One is the principle that collaborative or ensemble approaches to problem-solving outperform individual effort, applied in AI contexts to multi-agent systems, ensemble methods, and human-in-the-loop architectures. It underpins debate-based reasoning, peer-review agent patterns, and consensus mechanisms where diverse model outputs are aggregated to improve accuracy and reduce error."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:ensemble-methods,
        ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-learning ;
    vc:slug "ensemble-collaborative-intelligence-principle" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:collective-intelligence-system,
        ngm:human-in-the-loop .

