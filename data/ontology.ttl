    vc:slug "smart-royalties-ledger" ;
    vc:sourceDomain "infrastructure" .

ngm:social-navigation a owl:Class ;
    rdfs:label "Social Navigation"@en ;
    rdfs:comment "Social Navigation is the discipline within robotics concerned with planning and executing robot motion through human-occupied spaces while respecting social norms, personal space conventions (proxemics), cultural context, and human comfort. It extends classical motion planning by incorporating models of human behaviour, pedestrian flow prediction, and non-verbal communication cues such as gaze and gesture, with the goal of producing movement that is perceived as natural and non-threatening."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proxemics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:human-robot-interaction,
        ngm:robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:collision-avoidance,
        ngm:obstacle-avoidance,
        ngm:social-robotics ;
    vc:requires ngm:motion-planning,
        ngm:path-planning,
        ngm:proxemics ;
    vc:slug "social-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning,
        ngm:sensor-fusion,
        ngm:slam .

ngm:solar-plans a owl:Class ;
    rdfs:label "solar plans"@en ;
    rdfs:comment "Solar plans are engineered configurations and optimisation analyses for solar photovoltaic (PV) installations, specifying panel tilt angles, array tiering, MPPT string layout, and economic projections for a given site's latitude and climate. This page documents a three-tier cascading solar panel system designed for Cumbria, England (54.5°N), where seasonal solar variation is extreme; the optimal configuration (43–45° tilt, 20% horizontal overlap, 18 panels at 6.3 kW peak) achieves approximately 3,179 kWh/year — three times the output of a conventional single-layer array in the same 10 m² footprint."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:internet-of-things,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-assessment,
        ngm:environmental-impact-metric,
        ngm:renewable-energy-certificates,
        ngm:sustainability ;
    vc:slug "solar-plans" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:optimization-algorithm,
        ngm:simulation .

ngm:solo-mining a owl:Class ;
    rdfs:label "Solo Mining"@en ;
    rdfs:comment "Solo Mining is a blockchain participation strategy in which an individual miner independently operates hashing hardware and attempts to discover valid blocks without joining a mining pool, retaining the full block reward upon success but accepting high variance in earnings proportional to the miner's share of total network hash rate. It contrasts with pool mining by preserving full decentralisation of block production but is economically viable only when a miner controls a significant fraction of total hash power."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:mining-pool,
        ngm:selfish-mining ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:block-reward,
        ngm:blockchain-network,
        ngm:nakamoto-consensus ;
    vc:requires ngm:consensus-algorithm,
        ngm:proof-of-work ;
    vc:slug "solo-mining" ;
    vc:sourceDomain "blockchain" .

ngm:some-legacy-linked-json a owl:Class ;
    rdfs:label "Some legacy Linked-JSON"@en ;
    rdfs:comment "Some legacy Linked-JSON is a collection of early-stage JSON-LD-based ontology data structures capturing metaverse entity models — including agents, scenes, digital assets, and virtual economies — created before the current NarrativeGoldmine v2 schema. These artefacts document the iterative evolution of the knowledge graph's data model and serve as a reference for schema migration and ontology provenance tracing."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
