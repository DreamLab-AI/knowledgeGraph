ngm:trusted-execution-environments a owl:Class ;
    rdfs:label "Trusted Execution Environments"@en ;
    rdfs:comment "Trusted Execution Environments (TEEs) are hardware-enforced isolated regions of memory and compute within a processor where code and data are protected against inspection or tampering by any software outside the enclave, including privileged system software such as the operating system, hypervisor, or firmware. They use processor-level memory encryption, access-control registers, and cryptographic attestation to establish a root of trust anchored in silicon, allowing remote parties to verify the identity and integrity of the code running inside before sharing sensitive data with it. TEEs are the foundational enabling technology for confidential computing, enabling privacy-preserving computation on sensitive workloads in untrusted cloud or edge environments. Prominent implementations include Intel SGX, Intel TDX, AMD SEV-SNP, and ARM TrustZone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-root-of-trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-enclave ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:remote-attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:memory-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-boot ],
        ngm:confidential-computing ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning ;
    vc:contrastsWith ngm:homomorphic-encryption,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:decentralised-identity,
        ngm:privacy-preserving-computation,
        ngm:secure-multi-party-computation,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:memory-encryption,
        ngm:remote-attestation,
        ngm:secure-enclave ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:key-management,
        ngm:side-channel-attack ;
    vc:requires ngm:hardware-root-of-trust,
        ngm:secure-boot ;
    vc:slug "trusted-execution-environments" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:confidential-computing-consortium ;
    vc:supports ngm:cloud-security,
        ngm:edge-computing,
        ngm:supply-chain-security ;
    vc:uses ngm:amd-sev,
        ngm:arm-trust-zone,
        ngm:intel-sgx .

