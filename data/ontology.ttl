ngm:etsi-domain-taxonomy a owl:Class ;
    rdfs:label "ETSI Domain Taxonomy"@en ;
    rdfs:comment "The ETSI Domain Taxonomy is a hierarchical classification framework produced by the European Telecommunications Standards Institute for systematically organising AI-related technical specifications, standards, and work items across application domains such as transportation, healthcare, telecommunications, and public safety. It provides a controlled vocabulary and structured ontology enabling consistent referencing of AI standards across ETSI technical committees and supports cross-domain applicability analysis. The taxonomy underpins ETSI's AI standardisation roadmap and aligns with CEN-CENELEC and ISO/IEC JTC 1/SC 42 standardisation activities. As a living classification instrument, it maps broad application sectors down to specific sub-domains, allowing AI systems and standards to receive multiple domain affiliations and enabling gap analysis across the European standardisation ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-committee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-application ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-governance,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:enables ngm:conformity-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-application,
        ngm:controlled-vocabulary ;
