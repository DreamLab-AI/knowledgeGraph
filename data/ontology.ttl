    rdfs:label "Decentralised AI Inference"@en .

ngm:decentralised-file-storage a owl:Class ;
    rdfs:label "Decentralised file storage"@en ;
    rdfs:comment "Decentralised file storage denotes a class of infrastructure protocols and networks that disaggregate object/blob persistence across geographically distributed, mutually untrusting node operators using content-addressing, cryptographic accountability, and (in most implementations) crypto-economic..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-hash-table ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erasure-coding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:libp2p ],
        ngm:content-addressed-storage,
        ngm:distributed-storage,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:censorship-resistance,
        ngm:data-sovereignty ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-identifier,
        ngm:distributed-hash-table,
        ngm:erasure-coding,
        ngm:pinning-service ;
    vc:implements ngm:kademlia-dht,
        ngm:proof-of-replication,
        ngm:proof-of-spacetime,
        ngm:reed-solomon-erasure-coding ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:distributed-ledger-technology,
        ngm:smart-contract,
        ngm:tokenomics ;
    vc:requires ngm:bandwidth,
        ngm:cryptographic-hash-function,
        ngm:libp2p,
        ngm:public-key-infrastructure ;
    vc:slug "decentralised-file-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:ipld,
        ngm:multiformats ;
    vc:supports ngm:decentralised-web,
        ngm:decentralized-application,
