    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SpatialAnchors
] .

mv:PhysicalVirtualRegistration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ComputerVision
] .

mv:PhysicalVirtualRegistration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SLAM
] .

# Platform Middleware
mv:PlatformMiddleware a owl:Class ;
    rdfs:subClassOf mv:SoftwareInfrastructure ;
    rdfs:label "Platform Middleware"@en ;
    rdfs:comment "A software layer that connects operating systems, applications, and services by providing common capabilities such as API management, message routing, authentication, and data integration to enable seamless communication between diverse systems."@en ;
