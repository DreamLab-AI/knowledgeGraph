ngm:jacobian-determinant a owl:Class ;
    rdfs:label "Jacobian Determinant"@en ;
    rdfs:comment "The Jacobian determinant is the scalar determinant of the Jacobian matrix of a differentiable vector-valued function, measuring the local factor by which the function expands or contracts volume around a point. In probability and machine learning it provides the change-of-variables correction needed to transform a probability density through an invertible mapping, ensuring the transformed density integrates to one. Its sign indicates whether the transformation preserves or reverses orientation, and its magnitude governs local volume scaling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        ngm:jacobian-matrix ;
    vc:bridgesTo ngm:normalising-flows ;
    vc:enables ngm:normalising-flows ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:jacobian-matrix,
        ngm:linear-algebra ;
    vc:isPartOf ngm:jacobian-matrix ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:information-theory,
        ngm:optimisation ;
    vc:requires ngm:differential-equations ;
    vc:slug "jacobian-determinant" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:normalising-flows ;
    vc:uses ngm:linear-algebra .

