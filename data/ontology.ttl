ngm:calibration a owl:Class ;
    rdfs:label "Calibration"@en ;
    rdfs:comment "Calibration is the systematic process of establishing, verifying, and correcting the quantitative relationship between a measurement instrument's or computational model's output and a known reference standard, encompassing intrinsic parameter estimation (gain, offset, nonlinearity, bias), extrinsic parameter determination (spatial pose and orientation relative to a reference frame), and inter-device consistency alignment. In physical systems it removes systematic error between raw sensor readings and true physical quantities; in machine learning it aligns predicted probability distributions to empirical frequencies. Calibration is a prerequisite for metrically accurate perception, reliable closed-loop control, trustworthy probabilistic inference, and coherent multi-modal data fusion across robotics, spatial computing, and AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ground-truth-labels ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reference-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:model-calibration,
        ngm:uncertainty-quantification ;
    vc:contrastsWith ngm:validation-process,
        ngm:verification ;
    vc:dependsOn ngm:optimisation ;
    vc:enables ngm:augmented-reality,
        ngm:pose-estimation,
        ngm:robot-control,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:camera-calibration,
        ngm:extrinsic-calibration,
        ngm:imu-calibration ;
    vc:isPartOf ngm:quality-assurance ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:requires ngm:ground-truth-labels,
        ngm:reference-standard ;
    vc:slug "calibration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-driving,
        ngm:medical-imaging,
        ngm:robotic-manipulation ;
    vc:uses ngm:checkerboard-pattern,
        ngm:fiducial-marker,
        ngm:imu,
        ngm:lidar .

ngm:data-availability a owl:Class ;
    rdfs:label "Data Availability"@en ;
    rdfs:comment "Data availability is the property of a distributed system—most critically blockchain networks and rollup scaling architectures—that guarantees all data necessary to verify and reconstruct network state is published and retrievable by any participant. The core data availability problem arises when a block producer publishes a block header without releasing the underlying transaction data, making it impossible for validators or light clients to verify the block's correctness without downloading all data. Modern solutions combine erasure coding (expanding data such that any sufficient subset allows full reconstruction) with data availability sampling (DAS), enabling light nodes to probabilistically confirm full publication by checking only a small random subset of encoded chunks. Data availability is a foundational primitive in modular blockchain architectures, separating the data publication concern from execution, consensus, and settlement layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:content-delivery-network,
        ngm:distributed-storage ;
    vc:contrastsWith ngm:data-withholding-attack,
        ngm:state-availability ;
    vc:dependsOn ngm:block-propagation,
        ngm:distributed-hash-table ;
    vc:enables ngm:blockchain-scalability,
        ngm:layer-2-scaling,
        ngm:light-client,
        ngm:modular-blockchain,
        ngm:rollup ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:danksharding,
        ngm:proto-danksharding ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:content-addressed-storage,
        ngm:data-availability-committee,
        ngm:fraud-proof,
        ngm:sharding,
        ngm:validity-proof,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:consensus-mechanism,
        ngm:peer-to-peer-network ;
    vc:slug "data-availability" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-commitment,
        ngm:data-availability-sampling,
        ngm:erasure-coding,
        ngm:kzg-polynomial-commitment,
        ngm:merkle-tree,
        ngm:reed-solomon-codes .

ngm:data-privacy a owl:Class ;
    rdfs:label "Data Privacy"@en ;
    rdfs:comment "Data Privacy is the governance and engineering discipline that ensures individuals retain meaningful control over their personal information through legal frameworks, technical safeguards, and organisational policies governing the appropriate collection, processing, storage, and sharing of personal data. It spans both the regulatory compliance dimension—expressed in instruments such as GDPR, CCPA, PIPEDA, and sector-specific regulations—and the engineering discipline of privacy-by-design that minimises data exposure through techniques such as anonymisation, pseudonymisation, differential privacy, federated learning, and consent management. As AI training practices, surveillance capitalism, and cross-border data flows intensify the stakes of personal information handling, data privacy functions as a core organisational risk management and trust-building domain. The field requires integration across legal, technical, and organisational layers to be effective, and is increasingly operationalised through dedicated Privacy-Enhancing Technologies (PETs)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-by-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-minimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-anonymization-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:federated-learning,
        ngm:on-device-ai,
        ngm:synthetic-data ;
    vc:contrastsWith ngm:data-monetisation,
        ngm:surveillance ;
    vc:enables ngm:data-subject-rights,
        ngm:digital-trust,
        ngm:granular-consent-control,
        ngm:informed-consent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consent-management,
        ngm:data-anonymization-pipeline,
        ngm:data-minimisation,
        ngm:privacy-by-design ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:gdpr-compliance,
        ngm:personal-data-store ;
    vc:requires ngm:access-control,
        ngm:audit-logging,
        ngm:data-governance ;
    vc:slug "data-privacy" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ccpa,
        ngm:gdpr,
        ngm:iso-27701 ;
    vc:uses ngm:cryptographic-security,
        ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption .

ngm:data-schema a owl:Class ;
    rdfs:label "Data Schema"@en ;
    rdfs:comment "A Data Schema is a formal specification that defines the structure, types, constraints, and semantics of data within a system or exchange protocol. It enumerates fields, their data types, cardinality rules, allowed values, and relationships between entities, enabling machines to validate conformance and enabling humans to understand data contracts. Data schemas are expressed in formalisms such as JSON Schema, XML Schema Definition, RDF SHACL, or OWL, and are versioned to manage evolution over time. They underpin interoperability between systems, database design, API contracts, and linked-data publishing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:namespace ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint ],
        ngm:schema-definition ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:database-system ;
    vc:enables ngm:api-contract,
        ngm:data-interoperability,
        ngm:data-validation,
        ngm:knowledge-representation,
        ngm:schema-registry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constraint ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:knowledge-graph,
        ngm:metadata-schema,
        ngm:ontology ;
    vc:requires ngm:data-type,
        ngm:namespace ;
    vc:slug "data-schema" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-governance,
        ngm:linked-data,
        ngm:schema-versioning ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:json-data-interchange-format-schema,
        ngm:owl,
        ngm:rdf,
        ngm:shacl,
        ngm:xml-schema-definition .

ngm:data-sovereignty a owl:Class ;
    rdfs:label "Data Sovereignty"@en ;
    rdfs:comment "Data sovereignty is the legal and political principle that digital data is subject to the laws, governance structures, and enforcement jurisdiction of the nation, region, or community in which it originates or is processed. It encompasses requirements such as data localisation (mandating that data remain physically within specified geographic boundaries), restrictions on cross-border data flows, and the right of governments or communities to compel access for regulatory, security, or cultural-preservation purposes. Data sovereignty directly shapes cloud architecture decisions, AI training dataset curation, federated system design, and multinational data-sharing agreements. It intersects with — yet is conceptually distinct from — privacy rights, data protection law, and cybersecurity, being principally concerned with jurisdictional control rather than individual rights."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:jurisdiction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-localisation ],
        ngm:data-governance ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:cloud-portability,
        ngm:data-free-flow ;
    vc:dependsOn ngm:data-residency,
        ngm:encryption ;
    vc:enables ngm:national-ai-strategy,
        ngm:sovereign-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-protection,
        ngm:gdpr ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:cross-border-data-transfer,
        ngm:cybersecurity ;
    vc:requires ngm:data-localisation,
        ngm:jurisdiction,
        ngm:regulatory-compliance ;
    vc:slug "data-sovereignty" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-27701 ;
    vc:supports ngm:digital-autonomy,
        ngm:national-security,
        ngm:privacy ;
    vc:uses ngm:confidential-computing,
        ngm:federated-learning,
        ngm:homomorphic-encryption .

ngm:embedding-model a owl:Class ;
    rdfs:label "Embedding Model"@en ;
    rdfs:comment "An embedding model is a neural network trained to project discrete or high-dimensional inputs—such as tokens, sentences, images, audio segments, or knowledge-graph nodes—into dense, fixed-dimensional vector representations in a continuous latent space that preserves semantic and structural relationships. The geometry of the resulting embedding space encodes similarity: semantically related inputs map to vectors with high cosine similarity, enabling downstream tasks such as semantic search, clustering, classification, and retrieval-augmented generation. Embedding models are trained using objectives such as contrastive learning, masked language modelling, or cross-modal alignment, and are evaluated on standardised benchmarks including MTEB and BEIR."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-latent-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:knowledge-graph-completion,
        ngm:spatial-index ;
    vc:contrastsWith ngm:large-language-model,
        ngm:sparse-representation ;
    vc:dependsOn ngm:contrastive-learning,
        ngm:training-data,
        ngm:transformer ;
    vc:enables ngm:anomaly-detection,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:neural-network-latent-space,
        ngm:pooling-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dimensionality-reduction,
        ngm:knowledge-graph,
        ngm:multimodal-ai-architecture-ai,
        ngm:natural-language-processing,
        ngm:transfer-learning ;
    vc:requires ngm:fine-tuning,
        ngm:gpu-computing ;
    vc:slug "embedding-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:nearest-neighbor-search,
        ngm:tokenization,
        ngm:vector-database .

ngm:predictive-analytics a owl:Class ;
    rdfs:label "Predictive Analytics"@en ;
    rdfs:comment "Predictive Analytics is the discipline of extracting patterns from historical data using statistical algorithms and machine learning models to generate probabilistic forecasts of future events, behaviours, or conditions. It encompasses the full workflow from data ingestion and feature engineering through model selection, training, validation, and operationalised deployment within business intelligence and decision-support systems. The field draws on regression, classification, ensemble methods, and time-series modelling to produce actionable outputs in domains ranging from demand forecasting and risk assessment to anomaly detection and personalised recommendation. It is distinguished from descriptive analytics by its forward-looking orientation and from prescriptive analytics by its focus on prediction rather than optimised action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:digital-twin ;
    vc:contrastsWith ngm:descriptive-analytics,
        ngm:prescriptive-analytics ;
    vc:enables ngm:anomaly-detection,
        ngm:decision-support,
        ngm:demand-forecasting,
        ngm:recommendation-system,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:business-intelligence ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:exploratory-data-analysis,
        ngm:model-inference,
        ngm:natural-language-processing ;
    vc:requires ngm:feature-engineering,
        ngm:machine-learning,
        ngm:statistical-modelling ;
    vc:slug "predictive-analytics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:classification,
        ngm:cross-validation,
        ngm:data-pipeline,
        ngm:ensemble-methods,
        ngm:model-training,
        ngm:regression,
        ngm:time-series-analysis .

ngm:vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "A Vulnerability is a weakness, flaw, or inadequacy in a system's design, implementation, or configuration that can be exploited to violate security policies or compromise integrity. Vulnerabilities are classified by origin (design flaw, implementation bug, configuration error), severity (CVSS score), and CIA impact (confidentiality, integrity, availability), and are managed through scanning, patching, and compensating controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-scanning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:patch-management ],
        ngm:risk ;
    vc:bridgesTo ngm:adversarial-robustness,
        ngm:smart-contract-security,
        ngm:supply-chain ;
    vc:contrastsWith ngm:resilience,
        ngm:security ;
    vc:dependsOn ngm:risk,
        ngm:threat-model ;
    vc:enables ngm:exploit,
        ngm:privilege-escalation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cve ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attack-vector,
        ngm:penetration-testing,
        ngm:threat-actor,
        ngm:zero-day-exploits ;
    vc:requires ngm:patch-management,
        ngm:risk-assessment,
        ngm:vulnerability-scanning ;
    vc:slug "vulnerability" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist,
        ngm:owasp .

ngm:bc-cryptographic-primitive a owl:Class,
        skos:Concept ;
    rdfs:label "Cryptographic Primitive"@en ;
    rdfs:comment "Taxonomy hub for the foundational cryptographic building blocks underpinning blockchain systems, including hash functions, digital signatures, asymmetric encryption, zero-knowledge proofs, and cryptographic commitments. These primitives collectively provide the security properties of integrity, authenticity, and privacy that make distributed ledger technology trustworthy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
