ngm:shader a owl:Class ;
    rdfs:label "Shader"@en ;
    rdfs:comment "A shader is a programmable GPU program that replaces fixed-function rendering pipeline stages, executing artist-authored or engine-generated algorithms in parallel across thousands of GPU threads to determine vertex positions, surface colour, lighting, and post-process effects. Shader types include vertex, tessellation control, tessellation evaluation, geometry, fragment (pixel), mesh, ray-generation, and compute shaders, each targeting a distinct stage of the GPU execution pipeline. Written in high-level shading languages such as GLSL, HLSL, Metal Shading Language, or WGSL, shaders are compiled to hardware-specific bytecode and scheduled by the GPU driver onto shader processor cores. In the context of spatial computing, shaders are the fundamental mechanism through which all real-time visual content is generated for head-mounted displays, AR overlays, and immersive 3D environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning-inference,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:fixed-function-pipeline ;
    vc:enables ngm:physically-based-rendering,
        ngm:post-processing,
        ngm:procedural-generation,
        ngm:ray-tracing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:compute-shader,
        ngm:geometry-shader,
        ngm:pixel-shader,
        ngm:ray-generation-shader,
        ngm:tessellation-shader,
        ngm:vertex-shader ;
    vc:isPartOf ngm:graphics-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:material-system,
        ngm:opengl,
        ngm:shader-language,
        ngm:vulkan,
        ngm:webgpu ;
    vc:requires ngm:gpu-driver,
        ngm:graphics-processing-unit,
        ngm:shader-language ;
    vc:slug "shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:opengl-arb ;
    vc:supports ngm:augmented-reality,
        ngm:real-time-rendering,
        ngm:rendering-technique,
        ngm:visual-effects ;
    vc:uses ngm:interpolation,
        ngm:rasterization,
        ngm:texture-mapping .

ngm:validator-set a owl:Class ;
    rdfs:label "Validator Set"@en ;
    rdfs:comment "A validator set is the finite, dynamically managed collection of nodes in a proof-of-stake or delegated consensus blockchain that are authorised to propose blocks, attest to their validity, and participate in the finality process during each epoch. Membership is gated by a minimum stake bond whose collateral is subject to slashing penalties for protocol violations such as equivocation or surround voting, aligning validator incentives with network security. The set is recomposed at epoch boundaries according to delegation weights, unbonding queues, and slashing events, and its cardinality governs the fundamental trade-off between decentralisation, Byzantine fault tolerance, and consensus latency. In sharded or layered architectures, validator sets may be further partitioned into sub-committees to scale throughput while preserving cryptographic security guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slashing-condition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:decentralised-ai-inference,
        ngm:federated-learning ;
    vc:contrastsWith ngm:mining-pool,
        ngm:proof-of-work ;
    vc:dependsOn ngm:cryptographic-signature,
        ngm:delegation ;
    vc:enables ngm:block-finality,
        ngm:block-proposal,
        ngm:byzantine-fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:slashing-condition,
        ngm:staking-bond,
        ngm:validator-node ;
    vc:implements ngm:casper-ffg,
        ngm:tendermint-bft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:committee-rotation,
        ngm:delegated-proof-of-stake,
        ngm:governance-token ;
    vc:requires ngm:epoch,
        ngm:proof-of-stake,
        ngm:staking ;
    vc:slug "validator-set" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:threshold-signature,
        ngm:verifiable-random-function .

ngm:autonomous-system a owl:Class ;
    rdfs:label "Autonomous System"@en ;
    rdfs:comment "An Autonomous System is a computational or physical entity capable of perceiving its environment through sensors, reasoning over that perception, and executing goal-directed actions without continuous human intervention, forming closed-loop sense-plan-act cycles. Architecturally, autonomous systems combine perception pipelines, world-model maintenance, deliberative or reactive planning, and actuator control, often augmented by machine learning to handle environmental uncertainty. They operate across a spectrum from fully automated (no human input required) to conditionally autonomous (human on the loop), and encompass platforms as diverse as self-driving vehicles, unmanned aerial systems, autonomous underwater vehicles, industrial robotic cells, and intelligent software agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
