ngm:computation-graph a owl:Class ;
    rdfs:label "Computation Graph"@en ;
    rdfs:comment "A Computation Graph is a directed graph in which nodes represent operations or variables and edges represent the flow of data (typically tensors) between them. It is the central abstraction in modern machine learning frameworks, where a model's forward pass is expressed as a graph and gradients are computed by traversing it in reverse via automatic differentiation. Graphs may be built statically ahead of execution or dynamically as code runs, and they enable optimisation, scheduling and hardware acceleration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor ],
        ngm:directed-acyclic-graph ;
    vc:bridgesTo ngm:py-torch,
        ngm:tensor-flow ;
    vc:dependsOn ngm:machine-learning-discipline-framework ;
    vc:enables ngm:backpropagation,
        ngm:gpu-acceleration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:tensor ;
    vc:implements ngm:neural-network ;
    vc:isPartOf ngm:deep-learning-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning ;
    vc:requires ngm:automatic-differentiation ;
    vc:slug "computation-graph" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:onnx ;
    vc:supports ngm:gradient-descent,
        ngm:model-training ;
    vc:uses ngm:directed-acyclic-graph .

ngm:compute-layer a owl:Class ;
    rdfs:label "Compute Layer"@en ;
    rdfs:comment "Software layer managing computational resources and orchestration for rendering, simulation, physics, AI processing, and real-time processing within metaverse systems."@en ;
