    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-framework,
        ngm:transparency ;
    vc:slug "regulatory-clarity" ;
    vc:sourceDomain "governance" .

ngm:regulatory-layer a owl:Class ;
    rdfs:label "Regulatory Layer"@en ;
    rdfs:comment "The Regulatory Layer is the cross-cutting stratum that represents jurisdiction-specific legal requirements and the authorities that impose them. It sits above the Compliance Layer, supplying the obligations that compliance verifies, and informs governance and institutional structures. It contains regulations, licensing regimes, reporting duties, and the mapping of activities to applicable rules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-layer ],
        ngm:owl-thing ;
    vc:enables ngm:governance-layer,
        ngm:institutional-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compliance-layer ;
    vc:slug "regulatory-layer" ;
    vc:sourceDomain "regulatory" .

ngm:regulatory-sandbox a owl:Class ;
    rdfs:label "Regulatory Sandbox"@en ;
    rdfs:comment "A regulatory sandbox is a supervised testing environment in which firms can trial innovative products, services, or business models with real customers under temporary regulatory relief and close oversight. It lets regulators observe emerging technology and firms validate compliance before full-scale launch. Sandboxes are a common policy tool for fintech, blockchain, and other convergent technologies."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:asia-pacific-regulation ;
    vc:slug "regulatory-sandbox" ;
    vc:sourceDomain "governance" .

ngm:remote-assistance a owl:Class ;
    rdfs:label "Remote Assistance"@en ;
    rdfs:comment "Remote assistance is a service modality in which an expert or system provides real-time guidance, intervention, or control to a person or machine at a physically separate location, mediated by communication and rendering technology. It spans technical IT support via screen-sharing, clinical guidance through telestration overlays on AR headsets, and safety-critical interventions in teleoperated robotics. Effective remote assistance requires low-latency bidirectional communication, shared situational awareness, and appropriate interaction modalities for the task domain."@en ;
    rdfs:subClassOf ngm:remote-collaboration ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:teleoperation,
        ngm:telepresence ;
    vc:slug "remote-assistance" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:remote-communication ;
    vc:uses ngm:communication-protocol,
        ngm:immersive-communication .

ngm:remote-communication a owl:Class ;
    rdfs:label "Remote Communication"@en ;
    rdfs:comment "Remote Communication encompasses the protocols, platforms, and practices that enable synchronous and asynchronous exchange of information between geographically distributed participants. It spans text, voice, video, and immersive modalities, and underpins distributed work, telecollaboration, and telepresence systems by abstracting physical distance through networked infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:distributed-work,
        ngm:telecollaboration,
        ngm:video-conferencing ;
