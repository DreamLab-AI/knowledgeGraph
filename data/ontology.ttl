ngm:fiducial-marker a owl:Class ;
    rdfs:label "Fiducial Marker"@en ;
    rdfs:comment "A fiducial marker is a designed visual pattern placed in a scene to serve as a reliable reference point for computer-vision systems. Its known geometry and high-contrast, machine-readable encoding allow algorithms to detect it robustly, recover camera pose, and assign a unique identifier. Fiducial markers such as ArUco and AprilTag families are widely used for camera calibration, augmented-reality registration, and robot localisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-intrinsics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:checkerboard-pattern ],
        ngm:optical-calibration-target ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:checkerboard-pattern ;
    vc:enables ngm:augmented-reality,
        ngm:camera-calibration,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:checkerboard-pattern ;
    vc:isPartOf ngm:optical-calibration-target ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:homography,
        ngm:lens-distortion-correction,
        ngm:photogrammetry ;
    vc:requires ngm:camera-intrinsics ;
    vc:slug "fiducial-marker" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:pose-estimation ;
    vc:uses ngm:computer-vision,
        ngm:feature-detection .

ngm:financial-conduct-authority a owl:Class ;
    rdfs:label "Financial Conduct Authority"@en ;
    rdfs:comment "The Financial Conduct Authority (FCA) is the independent conduct and prudential regulator for financial services firms and markets in the United Kingdom, established under the Financial Services Act 2012 as successor to the Financial Services Authority. It is responsible for protecting consumers from harm, maintaining the integrity of UK financial markets, and promoting effective competition in the interests of consumers. The FCA authorises and supervises approximately 50,000 financial services firms, sets binding conduct rules through the FCA Handbook, and exercises enforcement powers including fines, prohibition orders, and market bans. Its remit has expanded to include cryptoasset registration, sustainability-related disclosure requirements, and Consumer Duty obligations."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:bridgesTo ngm:cryptoasset-regulation,
        ngm:open-banking,
        ngm:regtech ;
    vc:contrastsWith ngm:prudential-regulation-authority,
        ngm:securities-exchange-commission ;
    vc:dependsOn ngm:financial-policy-committee,
        ngm:prudential-regulation-authority ;
    vc:enables ngm:consumer-protection,
        ngm:market-integrity,
        ngm:securities-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fca-consumer-duty ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:slug "financial-conduct-authority" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:bank-of-england,
        ngm:hm-treasury ;
    vc:supports ngm:anti-money-laundering,
        ngm:financial-crime-prevention,
        ngm:market-abuse-regulation ;
    vc:uses ngm:regulatory-sandbox .

ngm:finite-field-arithmetic a owl:Class ;
    rdfs:label "Finite Field Arithmetic"@en ;
    rdfs:comment "Finite Field Arithmetic is the set of operations - addition, subtraction, multiplication and inversion - defined over a finite field (Galois field), a mathematical structure with a finite number of elements in which every non-zero element has a multiplicative inverse. Computations stay closed within the field and behave consistently under modular reduction by a prime or irreducible polynomial. It is foundational to error-correcting codes, cryptography and many digital signal-processing algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:number-theory ],
        ngm:modular-arithmetic ;
    vc:bridgesTo ngm:elliptic-curve-cryptography ;
    vc:dependsOn ngm:modular-arithmetic ;
    vc:enables ngm:elliptic-curve-cryptography,
        ngm:error-correction,
        ngm:reed-solomon-codes ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:modular-arithmetic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hash-function,
        ngm:number-theory,
        ngm:public-key-cryptography ;
    vc:requires ngm:number-theory ;
    vc:slug "finite-field-arithmetic" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-primitive,
        ngm:cryptography ;
    vc:uses ngm:modular-arithmetic,
        ngm:number-theory .

ngm:foundation-models a skos:Concept ;
    rdfs:label "Foundation Models"@en .

ngm:foundry a owl:Class ;
    rdfs:label "Foundry"@en ;
    rdfs:comment "Foundry is a fast, modular, and portable Ethereum application development toolkit written in Rust, comprising four core tools: Forge (test framework), Cast (EVM interaction CLI), Anvil (local testnet node), and Chisel (Solidity REPL). It enables developers to write, compile, fuzz-test, and deploy Solidity and Vyper smart contracts entirely from the command line, with tests written directly in Solidity rather than JavaScript. Foundry has become the dominant professional-grade smart-contract development environment on Ethereum-compatible chains, replacing earlier JavaScript-based toolchains such as Hardhat and Truffle for many teams. Its architecture emphasises speed through native compilation and parallelised test execution, deterministic reproducibility via pinned dependencies, and deep EVM-level inspection through cheatcodes and traces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rust-systems-programming-language ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:continuous-integration,
        ngm:devops,
        ngm:static-analysis ;
    vc:contrastsWith ngm:brownie,
        ngm:hardhat,
        ngm:truffle ;
    vc:dependsOn ngm:ethereum,
        ngm:evm ;
    vc:enables ngm:formal-verification,
        ngm:fuzz-testing,
        ngm:property-based-testing,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:open-zeppelin,
        ngm:smart-contract-development-framework,
        ngm:vyper ;
    vc:requires ngm:evm,
        ngm:rust-systems-programming-language,
        ngm:solidity ;
    vc:slug "foundry" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:defi-protocol,
        ngm:evm-compatible-blockchain,
        ngm:nft ;
    vc:uses ngm:abi-encoding,
        ngm:json-data-interchange-format-rpc .

ngm:fsb a owl:Class ;
    rdfs:label "FSB"@en ;
    rdfs:comment "The Financial Stability Board (FSB) is an international body established in 2009 by the G20 that monitors and makes recommendations about the global financial system. It coordinates the work of national financial authorities and international standard-setting bodies to develop and promote effective regulatory, supervisory, and other financial sector policies. The FSB addresses vulnerabilities in financial markets, oversees the implementation of agreed reforms, and assesses systemic risks arising from entities, activities, and instruments across the global financial system, including emerging risks from crypto-assets, non-bank financial intermediation, and climate-related financial exposures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:g20 ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:ai-in-finance,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:bis,
        ngm:imf ;
    vc:enables ngm:cross-border-regulatory-cooperation,
        ngm:financial-stability,
        ngm:systemic-risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:climate-related-financial-risk,
        ngm:crypto-regulation,
        ngm:financial-system,
        ngm:systemic-risk ;
    vc:requires ngm:financial-regulation,
        ngm:g20 ;
    vc:slug "fsb" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:iosco ;
    vc:supports ngm:macroprudential-policy ;
    vc:uses ngm:data-reporting,
        ngm:peer-review,
        ngm:stress-testing .

ngm:gaming a owl:Class ;
