        ngm:standards-participation ;
    vc:slug "digital-sovereignty" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:cultural-self-determination,
        ngm:cybersecurity,
        ngm:strategic-autonomy .

ngm:dijkstra-algorithm a owl:Class ;
    rdfs:label "Dijkstra Algorithm"@en ;
    rdfs:comment "A graph search algorithm that finds the shortest path from a source node to all other nodes in a weighted graph with non-negative edge weights. It systematically explores nodes in order of increasing distance from the source, guaranteeing optimal solutions."@en ;
    rdfs:subClassOf ngm:path-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:graph-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:non-negative-weights,
        ngm:weighted-graph ;
    vc:slug "dijkstra-algorithm" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:graph-representation,
        ngm:priority-queue .

ngm:direct-preference-optimization a owl:Class ;
    rdfs:label "Direct Preference Optimization"@en ;
    rdfs:comment "Direct Preference Optimization (DPO) is a preference-based language model alignment algorithm introduced by Rafael Rafailov, Archit Sharma, Eric Mitchell, Stefano Ermon, Christopher D."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
