ngm:bdi-model a owl:Class ;
    rdfs:label "BDI Model"@en ;
    rdfs:comment "A deliberative agent architecture grounded in Bratman's theory of practical reasoning, structuring agent cognition around Beliefs (knowledge about the world), Desires (motivational goals), and Intentions (committed plans), with a reasoning cycle of belief revision, deliberation, means-end reasoning, and intention reconsideration."@en ;
