    vc:slug "software-engineering-agents" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought ;
    vc:uses ngm:reasoning .
ngm:software-engineering-automation a owl:Class ;
    rdfs:comment "Software engineering automation is the application of AI agents and tooling to perform software development tasks -- code generation, testing, refactoring and deployment -- with reduced human intervention. It builds on agent harnesses and autonomous task execution to let coding agents plan, execute and verify multi-step engineering work directly in a terminal or IDE. It underpins the current generation of terminal and IDE coding agents that operate over real codebases and toolchains."@en ;
    rdfs:label "Software Engineering Automation"@en ;
    rdfs:subClassOf ngm:software-engineering ;
    rdfs:subClassOf _:r19646 ;
