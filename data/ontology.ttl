ngm:standards a owl:Class ;
    rdfs:label "Standards"@en ;
    rdfs:comment "Established tools, protocols, formats, services, and specifications that support the creation, operation, continuous improvement, and common use of metaverse technologies, enabling interoperability between disparate systems, platforms, and applications."@en ;
