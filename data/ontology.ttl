        ngm:zero-knowledge-proof ;
    vc:requires ngm:access-control,
        ngm:consent-management,
        ngm:data-flow-analysis ;
    vc:slug "privacy-engineering" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:gdpr,
        ngm:iso-iec-27701 ;
    vc:supports ngm:data-protection,
        ngm:regulatory-compliance ;
    vc:uses ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:k-anonymity,
        ngm:pseudonymisation .

ngm:privacy-enhancing-computation-pec a owl:Class ;
    rdfs:label "Privacy-Enhancing Computation (PEC)"@en ;
    rdfs:comment "Computational techniques that enable data processing and analysis while preserving privacy through cryptographic mods such as homomorphic encryption, secure multi-party computation, and differential privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
