    vc:slug "data-redundancy" ;
    vc:sourceDomain "infrastructure" .
ngm:data-registry a owl:Class ;
    rdfs:comment "A Data Registry is a centralised or federated catalogue that maintains authoritative records of data assets, their schemas, provenance, ownership, and access policies. In digital and metaverse infrastructure, registries track digital assets, avatar identities, spatial anchors, and ontological terms, enabling discovery, governance, and interoperability across distributed systems. Blockchain-anchored registries provide tamper-evident provenance and decentralised control."@en ;
    rdfs:label "Data Registry"@en ;
    rdfs:subClassOf ngm:data-management ;
