mv:EtsiMetaverseDomainTaxonomy a owl:Class ;
    rdfs:label "Etsi Metaverse Domain Taxonomy"@en ;
    rdfs:comment "A hierarchical classification system developed by ETSI organising metaverse concepts, technologies, and services into structured categories, enabling consistent terminology, clear domain boundaries, and interoperable standards development across the telecommunications and immersive technology industries."@en ;
    skos:prefLabel "Etsi Metaverse Domain Taxonomy"@en ;
    dcterms:identifier "MV-9898" ;
    dcterms:subject "mv" .

# Event Driven Architecture
mv:EventDrivenArchitecture a owl:Class ;
    rdfs:subClassOf mv:SystemArchitecture ;
    rdfs:label "Event Driven Architecture"@en ;
    rdfs:comment "A software architecture pattern for metaverse systems built from decoupled services that publish, consume, and route events representing state changes, enabling real-time responsiveness, independent scaling, and resilient distributed systems for immersive virtual experiences."@en ;
    skos:prefLabel "Event Driven Architecture"@en ;
    dcterms:identifier "MV-9899" ;
    dcterms:subject "mv" .

mv:EventDrivenArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ScalableMetaverseInfrastructure
] .

mv:EventDrivenArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DistributedSystemArchitecture
] .

mv:EventDrivenArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:RealTimeSystems
] .

# Extended Reality Xr
mv:ExtendedRealityXr a owl:Class ;
    rdfs:label "Extended Reality Xr"@en ;
    rdfs:comment "An umbrella term encompassing virtual reality (VR), augmented reality (AR), and mixed reality (MR) technologies that combine or mirror the physical world with digital environments, enabling immersive experiences through spatial computing, 3D visualisation, and interactive digital overlays."@en ;
    skos:prefLabel "Extended Reality Xr"@en ;
    dcterms:identifier "MV-9900" ;
    dcterms:subject "mv" .

# Fast Spatial Queries
mv:FastSpatialQueries a owl:Class ;
    rdfs:subClassOf mv:SpatialComputing ;
    rdfs:label "Fast Spatial Queries"@en ;
    rdfs:comment "Optimised algorithms and data structures enabling rapid retrieval and processing of three-dimensional location-based data in metaverse environments, supporting real-time collision detection, proximity searches, visibility calculations, and spatial indexing for interactive virtual world experiences."@en ;
    skos:prefLabel "Fast Spatial Queries"@en ;
    dcterms:identifier "MV-9901" ;
    dcterms:subject "mv" .

mv:FastSpatialQueries rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:RealTimeMetaverseInteractions
] .

mv:FastSpatialQueries rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GeospatialEngine
] .

mv:FastSpatialQueries rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:3DRendering
] .

# Format Parser
mv:FormatParser a owl:Class ;
    rdfs:subClassOf mv:DataProcessing ;
    rdfs:label "Format Parser"@en ;
    rdfs:comment "Software components that interpret and convert various 3D asset file formats (glTF, USD, FBX, OBJ) into internal representations for metaverse platforms, enabling interoperability between content creation tools and runtime environments whilst preserving geometry, materials, animations, and metadata."@en ;
    skos:prefLabel "Format Parser"@en ;
    dcterms:identifier "MV-9902" ;
    dcterms:subject "mv" .

mv:FormatParser rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:CrossPlatformContent
] .

mv:FormatParser rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:3DAssetPipeline
] .

mv:FormatParser rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InteroperabilityStandard
] .

# Game Narratives
mv:GameNarratives a owl:Class ;
    rdfs:subClassOf mv:InteractiveStorytelling ;
    rdfs:label "Game Narratives"@en ;
    rdfs:comment "Interactive storytelling frameworks within metaverse gaming environments featuring branching storylines, player-driven plot progression, and adaptive narratives that evolve based on collective player decisions, creating dynamic and personalised gaming experiences."@en ;
    skos:prefLabel "Game Narratives"@en ;
    dcterms:identifier "MV-9903" ;
    dcterms:subject "mv" .

mv:GameNarratives rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ImmersiveGamingExperiences
] .

mv:GameNarratives rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:EducationalNarrative
] .

mv:GameNarratives rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DynamicCharacterAnimation
] .

# Gas Fee Market
mv:GasFeeMarket a owl:Class ;
    rdfs:subClassOf mv:BlockchainEconomics ;
    rdfs:label "Gas Fee Market"@en ;
    rdfs:comment "The economic mechanism governing blockchain transaction costs, where users bid with gas fees to prioritise transaction processing, creating a market-based system essential for metaverse operations including NFT trades, smart contract execution, and virtual asset transfers."@en ;
    skos:prefLabel "Gas Fee Market"@en ;
    dcterms:identifier "MV-9904" ;
    dcterms:subject "mv" .

mv:GasFeeMarket rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:EconomicParameters
] .

mv:GasFeeMarket rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SmartContract
] .

mv:GasFeeMarket rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:impacts ;
    owl:someValuesFrom mv:MetaverseVirtualEconomy
] .

# Gdpr Article45
mv:GdprArticle45 a owl:Class ;
    rdfs:subClassOf mv:DataProtectionRegulation ;
    rdfs:label "Gdpr Article45"@en ;
    rdfs:comment "The General Data Protection Regulation provision empowering the European Commission to determine whether third countries provide adequate data protection levels, enabling personal data transfers from the EU to approved jurisdictions without additional safeguards, critical for metaverse platforms operating across international boundaries."@en ;
    skos:prefLabel "Gdpr Article45"@en ;
    dcterms:identifier "MV-9905" ;
    dcterms:subject "mv" .

mv:GdprArticle45 rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InternationalDataTransfer
] .

mv:GdprArticle45 rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:PrivacyFramework
] .

mv:GdprArticle45 rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:governs ;
    owl:someValuesFrom mv:CrossBorderMetaverseOperations
] .

# Geospatial Engine
mv:GeospatialEngine a owl:Class ;
    rdfs:subClassOf mv:SpatialComputing ;
    rdfs:label "Geospatial Engine"@en ;
    rdfs:comment "Software platforms that stream, render, and process large volumes of geographic and 3D spatial data in real-time for metaverse applications, enabling digital twins of real-world locations, location-based experiences, and integration between physical geography and virtual environments."@en ;
    skos:prefLabel "Geospatial Engine"@en ;
    dcterms:identifier "MV-9906" ;
    dcterms:subject "mv" .

mv:GeospatialEngine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:GeospatiallyAccurateMetaverse
] .

mv:GeospatialEngine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:FastSpatialQueries
] .

mv:GeospatialEngine rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DigitalTwin
] .

# Global Metaverse Operations
mv:GlobalMetaverseOperations a owl:Class ;
    rdfs:subClassOf mv:MetaverseInfrastructure ;
    rdfs:label "Global Metaverse Operations"@en ;
    rdfs:comment "The international coordination and management of metaverse platforms across jurisdictions, encompassing cross-border infrastructure deployment, regulatory compliance, interoperability standards, and unified user experiences that enable seamless virtual world access regardless of geographic location."@en ;
    skos:prefLabel "Global Metaverse Operations"@en ;
    dcterms:identifier "MV-9907" ;
    dcterms:subject "mv" .

mv:GlobalMetaverseOperations rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:UnifiedVirtualExperience
] .

mv:GlobalMetaverseOperations rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:CrossBorderDataTransfer
] .

mv:GlobalMetaverseOperations rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InteroperabilityStandard
] .

# Gltf Standard
mv:GltfStandard a owl:Class ;
    rdfs:subClassOf mv:3DAssetStandard ;
    rdfs:label "Gltf Standard"@en ;
    rdfs:comment "Graphics Library Transmission Format (glTF) is a royalty-free, open interoperable 3D asset format developed by Khronos Group, designed for efficient runtime transmission and loading of 3D scenes across native and web-based engines, serving as a foundational standard for metaverse asset interoperability."@en ;
    skos:prefLabel "Gltf Standard"@en ;
    dcterms:identifier "MV-9908" ;
    dcterms:subject "mv" .

mv:GltfStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:CrossPlatform3DContent
] .

mv:GltfStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:FormatParser
] .

mv:GltfStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InteroperabilityStandard
] .

# Governance Architecture
mv:GovernanceArchitecture a owl:Class ;
    rdfs:subClassOf mv:PlatformGovernance ;
    rdfs:label "Governance Architecture"@en ;
    rdfs:comment "The structural framework defining decision-making processes, authority distribution, and rule enforcement mechanisms within metaverse platforms, encompassing both centralised corporate governance models and decentralised blockchain-based systems using DAOs and smart contracts for community-driven management."@en ;
    skos:prefLabel "Governance Architecture"@en ;
    dcterms:identifier "MV-9909" ;
    dcterms:subject "mv" .

mv:GovernanceArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:DecentralisedDecisionMaking
] .

mv:GovernanceArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GovernanceToken
] .

mv:GovernanceArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SmartContract
] .

# Governance Board
mv:GovernanceBoard a owl:Class ;
    rdfs:subClassOf mv:GovernanceArchitecture ;
    rdfs:label "Governance Board"@en ;
    rdfs:comment "An oversight body responsible for strategic decision-making and policy enforcement within metaverse organisations, evolving from traditional corporate board structures to decentralised autonomous organisation (DAO) models where token holders collectively govern through transparent on-chain voting mechanisms."@en ;
    skos:prefLabel "Governance Board"@en ;
    dcterms:identifier "MV-9910" ;
    dcterms:subject "mv" .

mv:GovernanceBoard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:CollectiveDecisionMaking
] .

mv:GovernanceBoard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GovernanceToken
] .

mv:GovernanceBoard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DAOGovernance
] .

# Grammar System
mv:GrammarSystem a owl:Class ;
    rdfs:subClassOf mv:NaturalLanguageProcessing ;
    rdfs:label "Grammar System"@en ;
    rdfs:comment "Natural language processing components within metaverse platforms that interpret, process, and generate human language for user interactions, enabling AI-powered conversations with virtual avatars, real-time language translation, grammar correction, and adaptive dialogue systems that respond to user proficiency levels."@en ;
    skos:prefLabel "Grammar System"@en ;
    dcterms:identifier "MV-9911" ;
    dcterms:subject "mv" .

mv:GrammarSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:MultilingualMetaverseExperience
] .

mv:GrammarSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:LargeLanguageModel
] .

mv:GrammarSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:AIAvatar
] .

# Granular Consent Control
mv:GranularConsentControl a owl:Class ;
    rdfs:subClassOf mv:PrivacyFramework ;
    rdfs:label "Granular Consent Control"@en ;
    rdfs:comment "Privacy management mechanisms enabling users to selectively authorise specific types of data collection and processing within metaverse environments, allowing separate consent decisions for analytics, advertising, cross-device tracking, and data transfers while maintaining GDPR compliance and user autonomy over personal information."@en ;
    skos:prefLabel "Granular Consent Control"@en ;
    dcterms:identifier "MV-9912" ;
    dcterms:subject "mv" .

mv:GranularConsentControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:UserDataAutonomy
] .

mv:GranularConsentControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GdprArticle45
] .

mv:GranularConsentControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DataProtectionRegulation
] .

# Hanim Standard
mv:HanimStandard a owl:Class ;
    rdfs:subClassOf mv:AnimationStandard ;
    rdfs:label "Hanim Standard"@en ;
    rdfs:comment "Humanoid Animation (H-Anim) is an ISO/IEC approved international standard developed by the Web3D Consortium for interchangeable humanoid figures, defining specifications for articulated avatars, skeletal hierarchies, and animation systems that enable character portability across 3D games, simulations, and virtual environments."@en ;
    skos:prefLabel "Hanim Standard"@en ;
    dcterms:identifier "MV-9913" ;
    dcterms:subject "mv" .

mv:HanimStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:CrossPlatformAvatars
] .

mv:HanimStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GltfStandard
] .

mv:HanimStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:AvatarInteroperability
] .

# Hardware Acceleration
mv:HardwareAcceleration a owl:Class ;
    rdfs:subClassOf mv:ComputingInfrastructure ;
    rdfs:label "Hardware Acceleration"@en ;
    rdfs:comment "The use of specialised hardware components, particularly GPUs and dedicated processors, to offload computationally intensive rendering, physics simulation, and AI workloads from the CPU, enabling real-time performance essential for immersive VR/AR metaverse experiences."@en ;
    skos:prefLabel "Hardware Acceleration"@en ;
    dcterms:identifier "MV-9914" ;
    dcterms:subject "mv" .

mv:HardwareAcceleration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:RealTimeVRPerformance
] .

mv:HardwareAcceleration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:HardwareResources
] .

mv:HardwareAcceleration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:GPURendering
] .

# Hardware Resources
mv:HardwareResources a owl:Class ;
    rdfs:subClassOf mv:ComputingInfrastructure ;
    rdfs:label "Hardware Resources"@en ;
    rdfs:comment "The physical computing infrastructure required for metaverse access and operation, encompassing VR/AR headsets, computing devices, display technologies, tracking sensors, and connectivity hardware that collectively enable immersive virtual experiences."@en ;
    skos:prefLabel "Hardware Resources"@en ;
    dcterms:identifier "MV-9915" ;
    dcterms:subject "mv" .

mv:HardwareResources rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:MetaverseAccess
] .

mv:HardwareResources rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:HardwareAcceleration
] .

mv:HardwareResources rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VRHeadset
] .

# Healthcare Application Classification
mv:HealthcareApplicationClassification a owl:Class ;
    rdfs:subClassOf mv:HealthcareTechnology ;
    rdfs:label "Healthcare Application Classification"@en ;
    rdfs:comment "A taxonomy framework categorising metaverse healthcare applications by technology type (AR, VR, lifelogging, mirror world), use case (telemedicine, training, therapy), and end user (patient, clinician), enabling systematic evaluation and deployment of immersive medical technologies."@en ;
    skos:prefLabel "Healthcare Application Classification"@en ;
    dcterms:identifier "MV-9916" ;
    dcterms:subject "mv" .

mv:HealthcareApplicationClassification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:StructuredHealthcareInnovation
] .

mv:HealthcareApplicationClassification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ExtendedRealityXr
] .

mv:HealthcareApplicationClassification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:MedicalSimulation
] .

# Ieee P2733 Standards
mv:IeeeP2733Standards a owl:Class ;
    rdfs:subClassOf mv:XRTechnicalStandard ;
    rdfs:label "Ieee P2733 Standards"@en ;
    rdfs:comment "IEEE standards development efforts addressing virtual reality, extended reality, and metaverse technologies, including specifications for VR sickness reduction (IEEE 3079-2020), comfort requirements, and ethical design practices that ensure safe and accessible immersive experiences."@en ;
    skos:prefLabel "Ieee P2733 Standards"@en ;
    dcterms:identifier "MV-9917" ;
    dcterms:subject "mv" .

mv:IeeeP2733Standards rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:SafeImmersiveExperiences
] .

mv:IeeeP2733Standards rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:Ieee7000Standard
] .

mv:IeeeP2733Standards rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VRSicknessMitigation
] .

# Ieee7000 Standard
mv:Ieee7000Standard a owl:Class ;
    rdfs:subClassOf mv:EthicalDesignStandard ;
    rdfs:label "Ieee7000 Standard"@en ;
    rdfs:comment "IEEE Standard Model Process for Addressing Ethical Concerns during System Design (IEEE 7000-2021), establishing systematic processes for incorporating ethical values such as transparency, sustainability, privacy, fairness, and accountability into technology development from concept exploration through implementation."@en ;
    skos:prefLabel "Ieee7000 Standard"@en ;
    dcterms:identifier "MV-9918" ;
    dcterms:subject "mv" .

mv:Ieee7000Standard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:EthicalTechnologyDevelopment
] .

mv:Ieee7000Standard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:IeeeP2733Standards
] .

mv:Ieee7000Standard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ValueBasedEngineering
] .

# Image Processing Software
mv:ImageProcessingSoftware a owl:Class ;
    rdfs:subClassOf mv:ComputerVisionSystem ;
    rdfs:label "Image Processing Software"@en ;
    rdfs:comment "Software systems that acquire, process, analyse, and visualise digital images for metaverse applications, employing computer vision algorithms for user tracking, environment creation, gesture recognition, 3D reconstruction, and real-time visual enhancement in virtual and augmented reality environments."@en ;
    skos:prefLabel "Image Processing Software"@en ;
    dcterms:identifier "MV-9919" ;
    dcterms:subject "mv" .

mv:ImageProcessingSoftware rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:VisualMetaverseInteraction
] .

mv:ImageProcessingSoftware rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:3DReconstruction
] .

mv:ImageProcessingSoftware rdfs:subClassOf [
