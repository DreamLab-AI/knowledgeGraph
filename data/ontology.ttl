    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "power-supply" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:infrastructure .

ngm:predictive-analytics a owl:Class ;
    rdfs:label "Predictive Analytics"@en ;
    rdfs:comment "Predictive Analytics is the practice of extracting information from existing data sets and applying statistical algorithms and machine learning techniques to forecast future outcomes. It combines feature engineering, model training, and evaluation pipelines to generate actionable predictions in domains such as user behaviour, demand forecasting, anomaly detection, and risk assessment. Predictive models are trained on historical data and deployed as AI applications embedded in business intelligence systems and decision-support workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:anomaly-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:feature-engineering,
        ngm:machine-learning ;
    vc:slug "predictive-analytics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:model-training .

ngm:robot-kinematics a owl:Class ;
    rdfs:label "Robot Kinematics"@en ;
    rdfs:comment "Robot Kinematics is the mathematical study of the geometry of robot motion—comprising forward kinematics (mapping joint parameters to end-effector pose) and inverse kinematics (computing joint configurations that achieve a desired pose)—without regard to the forces or torques that produce that motion. It is foundational to robot programming, trajectory planning, and the design of manipulation systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:service-robot,
        ngm:surgical-robot ;
    vc:slug "robot-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:self-attention a owl:Class ;
    rdfs:label "Self Attention"@en ;
    rdfs:comment "An attention mechanism where every token in a sequence attends to every other token in the same sequence, allowing the model to capture intra-sequence dependencies."@en ;
