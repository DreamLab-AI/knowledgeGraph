        ngm:parametric-design-methodology-modeling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-model,
        ngm:constraint-solver ;
    vc:isPartOf ngm:authoring-tool,
        ngm:content-creation-tool ;
    vc:qualityScore "0.35"^^xsd:float ;
