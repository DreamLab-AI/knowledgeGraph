    vc:sourceDomain "blockchain" .
ngm:slashing-condition a owl:Class ;
    rdfs:comment "A slashing condition is a rule in a proof-of-stake protocol that defines provable validator misbehaviour, such as double-signing or equivocation, and triggers the forfeiture of part of the offender's staked collateral. It makes attacks economically costly by penalising actions that threaten consensus safety, aligning validator incentives with honest participation. It is a core economic-security primitive of staking-based consensus."@en ;
    rdfs:label "Slashing Condition"@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism ;
    vc:relatedTo ngm:sustainable-consensus ;
    vc:slug "slashing-condition" ;
    vc:sourceDomain "blockchain" .
ngm:slashing-conditions a owl:Class ;
    rdfs:comment "Slashing conditions are the set of cryptographically provable validator violations that a proof-of-stake blockchain protocol enforces by destroying or redistributing staked tokens. Encoded directly in protocol logic, they cover equivocation, surround votes, and prolonged unavailability, and their parameters set the strength of the chain's economic security. They are an implemented enforcement mechanism in modern blockchain protocols."@en ;
    rdfs:label "Slashing Conditions"@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol ;
    vc:relatedTo ngm:proof-of-stake-sustainability ;
    vc:slug "slashing-conditions" ;
    vc:sourceDomain "blockchain" .
