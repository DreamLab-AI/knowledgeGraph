ngm:noise-schedule a owl:Class ;
    rdfs:label "Noise Schedule"@en ;
    rdfs:comment "A noise schedule is the function that determines how much Gaussian noise is added at each step of a diffusion model's forward process and, correspondingly, removed during sampling. It governs the variance trajectory from clean data to pure noise and strongly affects sample quality, training stability, and the number of steps required. Common forms include linear, cosine, and learned schedules."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:sampling ;
    vc:slug "noise-schedule" ;
    vc:sourceDomain "ai" .

ngm:numerical-integration a owl:Class ;
    rdfs:label "Numerical Integration"@en ;
    rdfs:comment "Numerical integration is the family of algorithms that approximate definite integrals and advance differential equations in time when closed-form solutions are unavailable. In physics simulation it denotes the time-stepping schemes (such as explicit and implicit Euler, Verlet, and Runge-Kutta methods) that integrate equations of motion to update positions and velocities each frame. The choice of scheme balances accuracy, numerical stability, and computational cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-simulation ],
        ngm:physics-simulation ;
    vc:contrastsWith ngm:finite-element-analysis ;
    vc:enables ngm:physics-simulation,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:rigid-body-dynamics ;
    vc:isPartOf ngm:physics-simulation,
        ngm:simulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:finite-element-analysis ;
    vc:requires ngm:physics-simulation ;
    vc:slug "numerical-integration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:collision-detection,
        ngm:real-time-rendering,
        ngm:rigid-body-dynamics ;
    vc:uses ngm:finite-element-analysis .

ngm:operational-transformation a owl:Class ;
    rdfs:label "Operational Transformation"@en ;
    rdfs:comment "Operational Transformation (OT) is a concurrency control technique for real-time collaborative editing systems that enables multiple users to concurrently modify a shared document by representing edits as discrete operations and automatically transforming each incoming operation against previously applied operations to preserve user intent. The core insight is that when two concurrent operations are applied in different orders across distributed replicas, at least one must be adjusted — transformed — so that the final document state converges to a consistent result. OT requires a pair of transformation functions (IT and ET for inclusion and exclusion transformation) and must satisfy formal consistency properties (TP1 and TP2) to guarantee convergence under all interleavings. It underpins real-time collaborative editors including Google Docs, Apache Wave, and Etherpad, and remains a foundational technique in distributed collaboration research despite the later emergence of CRDTs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-synchronisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:concurrency-control ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:bridgesTo ngm:large-language-model,
        ngm:multi-user-systems ;
    vc:contrastsWith ngm:crdt,
        ngm:synchronisation ;
    vc:enables ngm:collaboration-tools,
        ngm:collaborative-editing,
        ngm:eventual-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:replication ;
    vc:isPartOf ngm:distributed-systems,
        ngm:real-time-collaboration ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:conflict-resolution,
        ngm:consensus-protocol,
        ngm:distributed-systems-theory ;
    vc:requires ngm:concurrency-control,
        ngm:state-synchronisation ;
    vc:slug "operational-transformation" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:vector-clock .

ngm:owl-class-hierarchy a owl:Class ;
    rdfs:label "OWL Class Hierarchy"@en ;
    rdfs:comment "The OWL Class Hierarchy is the directed acyclic graph (DAG) of named and anonymous classes connected via rdfs:subClassOf axioms within a Web Ontology Language (OWL) ontology, imposing a partial order on the class extension lattice. It provides the primary vehicle for monotonic inheritance of properties and restrictions, enabling description-logic reasoners such as HermiT, Pellet, and FaCT++ to classify individuals, detect unsatisfiable classes, and compute implicit subsumption relationships that are not asserted explicitly. The hierarchy is closed under the OWL semantics of the chosen profile (OWL 2 DL, EL, QL, or RL), constraining the decidability and computational complexity of reasoning tasks performed over it. Well-engineered class hierarchies underpin interoperability across domains including biomedical ontologies (GO, SNOMED CT), geospatial standards, and knowledge-graph schemas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-schema ],
        ngm:ontology-structure ;
    vc:bridgesTo ngm:upper-ontology ;
    vc:contrastsWith ngm:closed-world-assumption ;
    vc:dependsOn ngm:formal-semantics,
        ngm:open-world-assumption ;
    vc:enables ngm:automated-reasoning,
        ngm:classification,
        ngm:consistency-checking,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:description-logic,
        ngm:owl-2-web-ontology-language ;
    vc:isPartOf ngm:owl-2-web-ontology-language ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biomedical-ontology ;
    vc:requires ngm:description-logic,
        ngm:rdf-schema ;
    vc:slug "owl-class-hierarchy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:knowledge-graph,
        ngm:ontology-alignment,
        ngm:semantic-web-linked-data-standard ;
    vc:uses ngm:turtle .

ngm:personalised-learning a owl:Class ;
    rdfs:label "Personalised Learning"@en ;
    rdfs:comment "Personalised learning is an educational approach in which the pace, content, modality, and assessment of instruction are dynamically adapted to the knowledge state, learning style, goals, and preferences of the individual learner. Technology-enabled personalised learning uses data about learner interactions and performance to drive adaptive algorithms that present the most effective next learning experience for each person, contrasting with one-size-fits-all curriculum delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-privacy ],
        ngm:adaptive-learning ;
    vc:bridgesTo ngm:data-governance,
        ngm:spatial-computing ;
    vc:dependsOn ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:enables ngm:education-and-ai,
        ngm:formative-assessment,
        ngm:immersive-learning,
        ngm:intelligent-tutoring-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:digital-technology-access-equity,
        ngm:education-technology,
        ngm:educational-methodology,
        ngm:learning-analytics ;
    vc:requires ngm:data-privacy ;
    vc:slug "personalised-learning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:competency-based-education ;
    vc:uses ngm:bayesian-knowledge-tracing,
        ngm:federated-learning,
        ngm:item-response-theory,
        ngm:knowledge-graph,
        ngm:large-language-models,
        ngm:recommendation-systems,
        ngm:spaced-repetition .

ngm:posterior-distribution a owl:Class ;
    rdfs:label "Posterior Distribution"@en ;
    rdfs:comment "A posterior distribution is the probability distribution over unknown quantities after observing data, obtained by combining a prior distribution with the likelihood via Bayes' theorem. It represents updated belief and is the central object of Bayesian inference. In recursive estimators such as Bayes and particle filters, the posterior at each step becomes the basis for the next prediction."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:prior-distribution,
        ngm:probabilistic-model ;
    vc:slug "posterior-distribution" ;
    vc:sourceDomain "ai" .

ngm:precision-medicine a owl:Class ;
    rdfs:label "Precision Medicine"@en ;
    rdfs:comment "Precision Medicine utilises artificial intelligence to tailor medical treatment to individual patient characteristics, integrating genomic, proteomic, and clinical data to predict treatment response and stratify patient populations. AI-driven precision medicine enables personalised diagnosis, prognosis, and therapeutic selection based on multi-omic data integration and predictive modelling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
