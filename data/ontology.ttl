ngm:tornado-cash a owl:Class ;
    rdfs:label "Tornado Cash"@en ;
    rdfs:comment "Tornado Cash is a set of non-custodial smart contracts on Ethereum and compatible networks that obscure the on-chain link between a deposit and a withdrawal. Users deposit a fixed denomination of a token into a pool and later withdraw the same amount to a different address, using a zero-knowledge proof to demonstrate ownership of a valid deposit without revealing which one. It became widely known both as a privacy tool and as the subject of sanctions by the United States Office of Foreign Assets Control in 2022."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zk-snark ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:financial-privacy,
        ngm:infra-legal-and-regulatory,
        ngm:open-source-software-liability ;
    vc:contrastsWith ngm:blockchain-surveillance,
        ngm:chain-analysis,
        ngm:custodial-exchange ;
    vc:enables ngm:anonymity-set,
        ngm:on-chain-privacy,
        ngm:transaction-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:deposit-pool,
        ngm:tornado-cash-governance-token ;
    vc:implements ngm:coin-mixing,
        ngm:immutable-smart-contract,
        ngm:non-custodial-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-compliance,
        ngm:decentralised-finance,
        ngm:ofac-sanctions ;
    vc:requires ngm:ethereum-smart-contract-platform,
        ngm:merkle-tree,
        ngm:zero-knowledge-proof,
        ngm:zk-snark ;
    vc:slug "tornado-cash" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:commitment-scheme,
        ngm:nullifier,
        ngm:relayer-network .

