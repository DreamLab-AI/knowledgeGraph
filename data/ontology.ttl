    vc:supports ngm:classification,
        ngm:clustering,
        ngm:regression ;
    vc:uses ngm:python,
        ngm:supervised-learning,
        ngm:unsupervised-learning .

ngm:score-matching a owl:Class ;
    rdfs:label "Score Matching"@en ;
    rdfs:comment "Score matching is a method for fitting probability models by matching the gradient of the log-density, the score, of the model to that of the data, avoiding the intractable normalising constant. It underpins score-based generative models and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:machine-learning-discipline ;
    vc:enables ngm:diffusion-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "score-matching" ;
    vc:sourceDomain "machine-learning" .

ngm:screen-capture a owl:Class ;
    rdfs:label "Screen Capture"@en ;
    rdfs:comment "Screen capture is the acquisition of the visual contents of a display, window, or application as still images or a stream of frames. It underpins screenshots, screen recording, and remote presentation, and is increasingly used to provide perceptual input to AI agents that operate graphical interfaces. Capture is mediated by operating-system or browser APIs subject to user permission."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents,
        ngm:screen-recording ;
    vc:slug "screen-capture" ;
    vc:sourceDomain "infrastructure" .

ngm:secure-aggregation a owl:Class ;
    rdfs:label "Secure Aggregation"@en ;
    rdfs:comment "Secure aggregation is a cryptographic protocol that computes the sum of inputs held by many parties without revealing any individual input to the aggregator or other participants. It is most prominent in federated learning, where a server combines model updates from clients while learning only the aggregate. Typical constructions use pairwise masking, secret sharing, or additively homomorphic encryption, with dropout-resilient designs so the protocol completes even when some clients disconnect."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        ngm:secure-multi-party-computation ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:differential-privacy ;
    vc:enables ngm:differential-privacy,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:secure-multi-party-computation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:key-exchange,
        ngm:public-key-cryptography ;
    vc:slug "secure-aggregation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:federated-learning ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:homomorphic-encryption,
        ngm:oblivious-transfer .

ngm:securities-exchange-act-1934 a owl:Class ;
    rdfs:label "Securities Exchange Act 1934"@en ;
    rdfs:comment "The Securities Exchange Act of 1934 is the US federal law that governs secondary trading of securities and created the Securities and Exchange Commission. It establishes registration, disclosure, and anti-fraud requirements for exchanges, brokers, and listed companies. It is a foundational reference for determining how digital assets and investment products are regulated in the United States."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-etf,
        ngm:howey-test ;
    vc:slug "securities-exchange-act-1934" ;
    vc:sourceDomain "blockchain" .

ngm:self-sovereign-identity-ssi a owl:Class ;
    rdfs:label "Self-Sovereign Identity (SSI)"@en ;
    rdfs:comment "Self-Sovereign Identity (SSI) is an identity model in which individuals control their own digital identifiers and credentials without dependence on a centralised issuing authority, using Decentralised Identifiers (DIDs) anchored to distributed ledgers and Verifiable Credentials signed by trusted issuers to enable selective disclosure. SSI shifts identity management from siloed service-provider accounts to portable, user-held credentials that can be verified without querying the original issuer."@en ;
    rdfs:subClassOf ngm:decentralized-identity ;
    vc:dependsOn ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:did-method,
        ngm:hyperledger-indy ;
    vc:slug "self-sovereign-identity-ssi" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:decentralized-identifiers,
        ngm:verifiable-credentials .

ngm:semantic-mapping a owl:Class ;
    rdfs:label "Semantic Mapping"@en ;
    rdfs:comment "Semantic mapping is the process of establishing correspondences between concepts, terms, or schema elements across different knowledge representations so that their meanings align. It links source vocabularies to target ontologies, enabling data expressed under one model to be interpreted consistently under another. Semantic mapping underpins interoperability across heterogeneous knowledge graphs, databases, and linked-data sources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entity-resolution ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:data-integration ;
    vc:dependsOn ngm:knowledge-representation ;
    vc:enables ngm:data-integration,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:entity-resolution ;
    vc:isPartOf ngm:knowledge-representation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:entity-resolution,
        ngm:knowledge-base ;
    vc:requires ngm:ontology,
        ngm:rdf ;
    vc:slug "semantic-mapping" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:linked-data ;
    vc:uses ngm:semantic-web,
        ngm:vector-embedding .

ngm:semiconductor-supply-chain a owl:Class ;
    rdfs:label "Semiconductor Supply Chain"@en ;
    rdfs:comment "The semiconductor supply chain is the globally distributed network of design, fabrication, assembly, testing and distribution activities that produce integrated circuits. It is highly specialised and geographically concentrated, depending on leading-edge foundries, advanced lithography equipment, rare materials and complex logistics. Because chips underpin computing, AI and critical infrastructure, the semiconductor supply chain has become a focal point of geopolitics, export controls and national-security policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logistics ],
        ngm:supply-chain ;
    vc:bridgesTo ngm:resilience ;
    vc:contrastsWith ngm:supply-chain-management ;
    vc:dependsOn ngm:export-controls,
        ngm:geopolitics ;
    vc:enables ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:supply-chain-management ;
    vc:isPartOf ngm:supply-chain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compute-governance,
        ngm:digital-sovereignty ;
    vc:requires ngm:foundry,
        ngm:logistics ;
    vc:slug "semiconductor-supply-chain" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-chips,
        ngm:gpu ;
    vc:uses ngm:supply-chain-management .

ngm:sensor-technology a owl:Class ;
    rdfs:label "Sensor Technology"@en ;
    rdfs:comment "Sensor Technology encompasses the diverse hardware devices and fusion algorithms that capture physical-world data for use in robotics, spatial computing, and XR systems. This includes inertial measurement units, LiDAR scanners, depth cameras, eye-tracking, haptic sensors, and biometric devices, combined with fusion techniques such as visual-inertial odometry and Kalman filtering to produce accurate, robust state estimates for autonomous systems and immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:perception-system,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:camera,
        ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:imu,
        ngm:lidar ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "sensor-technology" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:depth-sensing .

ngm:separation-of-duties a owl:Class ;
    rdfs:label "Separation Of Duties"@en ;
    rdfs:comment "Separation of duties is a control principle that divides a sensitive task among multiple people or roles so that no single individual can complete it alone, reducing the risk of fraud, error and abuse of privilege. It requires collusion to subvert controls and is foundational to access governance, financial controls and compliance regimes. It complements least-privilege and is operationalised through role-based access control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:least-privilege ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:role-based-access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:security ;
    vc:bridgesTo ngm:compliance ;
    vc:contrastsWith ngm:least-privilege ;
    vc:enables ngm:compliance,
        ngm:fraud-prevention ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audit-trail,
        ngm:least-privilege ;
    vc:implements ngm:access-control ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:least-privilege,
        ngm:segregation-of-duties ;
    vc:requires ngm:role-based-access-control ;
    vc:slug "separation-of-duties" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:governance,
        ngm:identity-management ;
    vc:uses ngm:role-based-access-control .

