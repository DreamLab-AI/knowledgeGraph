    vc:supports ngm:neural-network-training,
        ngm:reinforcement-learning,
        ngm:scientific-computing ;
    vc:uses ngm:gpu-computing,
        ngm:numpy-api,
        ngm:tensor-processing-unit .

ngm:kinematic-chain a owl:Class ;
    rdfs:label "Kinematic Chain"@en ;
    rdfs:comment "A kinematic chain is an assembly of rigid bodies (links) connected by joints that constrain their relative motion, forming the structural and mathematical basis for analysing and controlling the motion of mechanisms and robots. Open kinematic chains (serial manipulators) have one free end and exhibit simple forward kinematics but complex inverse kinematics; closed kinematic chains (parallel manipulators) have all links connected in loops, offering higher stiffness and load capacity. The Denavit-Hartenberg convention provides the canonical parameterisation for representing joint geometry and computing transformations along the chain, underpinning all modern robot programming and simulation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematic-element ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:kinematics ;
    vc:enables ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:kinematic-element ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:manipulator-arm,
        ngm:robot-kinematics ;
    vc:slug "kinematic-chain" ;
    vc:sourceDomain "robotics" .

ngm:knowledge-sharing a owl:Class ;
    rdfs:label "Knowledge Sharing"@en ;
    rdfs:comment "Collaborative practices and platforms within metaverse environments that facilitate the exchange of information, expertise, and learning experiences among users through immersive virtual spaces, avatars, and AI-enhanced interactions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:collaborative-systems-modality-technology ;
    vc:enables ngm:distributed-team-collaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "knowledge-sharing" ;
    vc:sourceDomain "spatial-computing" .

ngm:kotlin a owl:Class ;
    rdfs:label "Kotlin"@en ;
    rdfs:comment "Kotlin is a statically-typed, cross-platform programming language developed by JetBrains that compiles to JVM bytecode, JavaScript, and native binaries via LLVM. It offers concise syntax, null safety enforced at the type level, first-class coroutine support, and seamless interoperability with Java, making it the preferred language for Android development and increasingly for server-side and multiplatform applications."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:enables ngm:cross-platform-compatibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gradle,
        ngm:java,
        ngm:jvm-runtime ;
    vc:slug "kotlin" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compiler .

ngm:layer-2-solutions a owl:Class ;
    rdfs:label "Layer 2 Solutions"@en ;
    rdfs:comment "Layer 2 solutions are protocols and systems built atop a base blockchain (layer 1) that handle transactions off the main chain to increase throughput, reduce latency, and lower transaction costs, while periodically settling finality back to the underlying layer 1 for security. The principal layer 2 paradigms include optimistic rollups, zero-knowledge rollups, state channels, and sidechains, each offering distinct trust and performance tradeoffs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimistic-rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:blockchain-scalability ;
    vc:bridgesTo ngm:cross-chain-interoperability ;
    vc:contrastsWith ngm:layer-1-scaling,
        ngm:sharding ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:cryptographic-commitment ;
    vc:enables ngm:blockchain-transaction,
        ngm:decentralised-finance,
        ngm:micropayment,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:optimistic-rollup,
        ngm:payment-channel,
        ngm:sidechain,
        ngm:state-channel,
        ngm:zk-rollup ;
    vc:isPartOf ngm:blockchain-scalability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:layer-2-scaling,
        ngm:lightning-network,
        ngm:proto-danksharding ;
    vc:requires ngm:data-availability,
        ngm:layer-1-blockchain ;
    vc:slug "layer-2-solutions" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:fraud-proof,
        ngm:sequencer,
        ngm:smart-contract,
