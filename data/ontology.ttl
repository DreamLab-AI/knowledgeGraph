ngm:compute-shader a owl:Class ;
    rdfs:comment "A Compute Shader is a programmable GPU kernel that executes arbitrary parallel computations outside the traditional graphics rendering pipeline, enabling general-purpose GPU (GPGPU) workloads such as physics simulation, procedural generation, image post-processing, and data-parallel algorithms within real-time 3D and metaverse applications."@en ;
    rdfs:label "Compute Shader"@en ;
