ngm:knowledge-graph-embedding a owl:Class ;
    rdfs:label "Knowledge Graph Embedding"@en ;
    rdfs:comment "Knowledge graph embedding is the technique of representing the entities and relations of a knowledge graph as continuous low-dimensional vectors that preserve the graph's structural and semantic regularities. Scoring functions over these vectors model the plausibility of triples, enabling tasks such as link prediction, entity resolution and similarity-based retrieval through algebraic operations rather than symbolic traversal. It bridges symbolic knowledge representation with vector-based machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-graph ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:dependsOn ngm:knowledge-graph,
        ngm:representation-learning ;
    vc:enables ngm:entity-resolution,
        ngm:link-prediction,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:graph-embedding ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graph-neural-network,
        ngm:knowledge-representation,
        ngm:semantic-search ;
    vc:requires ngm:knowledge-graph ;
    vc:slug "knowledge-graph-embedding" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:reasoning,
        ngm:relation-extraction ;
    vc:uses ngm:embedding,
        ngm:graph-neural-network,
        ngm:vector-embedding .

ngm:ledger a owl:Class ;
    rdfs:label "Ledger"@en ;
    rdfs:comment "A ledger is a structured, authoritative record of financial transactions or state changes, historically maintained as a physical or centralised book of accounts and now realised as a distributed, cryptographically secured data structure in blockchain systems. In the distributed-ledger paradigm, every participating node holds a replica of the same append-only log, with consensus mechanisms ensuring that all copies remain consistent and tamper-evident. The concept spans traditional double-entry bookkeeping, centralised database ledgers (as in banking core systems), and fully decentralised [[Distributed Ledger Technology]] implementations such as [[Bitcoin]] and [[Ethereum]]. Ledger (the company, Ledger SAS) is a notable specific instantiation of hardware-wallet technology designed to protect the cryptographic keys that authorise writes to a blockchain ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:distributed-ledger-technology ;
    vc:bridgesTo ngm:data-provenance,
        ngm:digital-identity,
        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:centralised-database,
        ngm:custodial-wallet ;
    vc:dependsOn ngm:peer-to-peer-network,
        ngm:public-key-cryptography ;
    vc:enables ngm:digital-asset,
        ngm:self-custody,
        ngm:smart-contract,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:block,
        ngm:merkle-tree,
        ngm:transaction-record ;
    vc:implements ngm:double-entry-bookkeeping ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:account-model,
        ngm:utxo ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:private-key ;
    vc:slug "ledger" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:central-bank-digital-currency,
        ngm:decentralised-finance ;
    vc:uses ngm:cold-storage,
        ngm:digital-signature,
        ngm:key-management .

ngm:linear-programming a owl:Class ;
    rdfs:label "Linear Programming"@en ;
    rdfs:comment "Linear Programming is a mathematical optimisation technique for finding the best outcome of a linear objective function subject to a set of linear equality and inequality constraints. The feasible region forms a convex polytope, and the optimum, when it exists, lies at a vertex, which algorithms such as the simplex method and interior-point methods exploit. Linear programming underpins resource allocation, scheduling, and planning problems across operations research and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convex-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:objective-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        ngm:optimisation ;
    vc:contrastsWith ngm:combinatorial-optimisation ;
    vc:dependsOn ngm:convex-optimisation ;
    vc:enables ngm:resource-allocation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:constraint-satisfaction,
        ngm:objective-function ;
    vc:isPartOf ngm:operations-research,
        ngm:optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:machine-learning,
        ngm:numerical-methods ;
    vc:requires ngm:convex-optimisation ;
    vc:slug "linear-programming" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:operations-research ;
    vc:uses ngm:linear-algebra .

ngm:liquid-proof-of-stake a owl:Class ;
    rdfs:label "Liquid Proof of Stake"@en ;
    rdfs:comment "A Proof of Stake consensus variant that decouples staking participation from token illiquidity by allowing holders to delegate validation rights to elected validators (bakers) while retaining full ownership and transferability of their tokens. Pioneered by Tezos, it combines on-chain governance with delegated staking, enabling small token holders to participate in consensus rewards without running validator infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegation ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:governance ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:blockchain-governance,
        ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:enables ngm:decentralized-autonomous-organization,
        ngm:on-chain-governance,
        ngm:staking-reward,
        ngm:tokenomics-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delegation ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:slashing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:liquid-staking,
        ngm:proof-of-stake-sustainability,
        ngm:tezos ;
    vc:requires ngm:epoch,
        ngm:validator-node ;
    vc:slug "liquid-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-signature,
        ngm:token-economics,
        ngm:validator-set .

ngm:manufacturing-automation a owl:Class ;
    rdfs:label "Manufacturing Automation"@en ;
    rdfs:comment "Manufacturing automation is the systematic application of control technologies, robotics, sensors, machine vision, and software to perform production tasks with minimal human intervention across discrete, process, and hybrid manufacturing environments. It encompasses programmable logic controllers (PLCs), industrial robots, computer numerical control (CNC) machines, distributed control systems (DCS), and integrated supervisory architectures that coordinate material flow, quality inspection, and assembly operations. Modern implementations leverage AI-driven process optimisation, digital twin synchronisation, and edge-cloud hybrid architectures to achieve adaptive, self-correcting production lines capable of real-time reconfiguration. The discipline aims to increase throughput, improve consistency, reduce cycle times, and enhance worker safety by reassigning operators away from hazardous or highly repetitive tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scada ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:programmable-logic-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:industrial-io-t ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cnc-machining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-robot ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:predictive-maintenance,
        ngm:reinforcement-learning ;
    vc:enables ngm:cyber-physical-systems,
        ngm:flexible-manufacturing,
        ngm:mass-customisation,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cnc-machining,
        ngm:control-system,
        ngm:industrial-robot,
        ngm:machine-vision,
        ngm:programmable-logic-controller,
        ngm:sensor-fusion ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robotics,
        ngm:digital-twin,
        ngm:precision-manufacturing,
        ngm:smart-manufacturing ;
    vc:requires ngm:edge-computing,
        ngm:industrial-io-t,
        ngm:scada ;
    vc:slug "manufacturing-automation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:isa-95,
        ngm:iso-10218 .

ngm:matter-protocol a owl:Class ;
    rdfs:label "Matter Protocol"@en ;
    rdfs:comment "Matter is a royalty-free smart-home connectivity standard developed by the Connectivity Standards Alliance to provide a common application layer enabling devices from different manufacturers to interoperate over IP networks. Built on top of Thread and Wi-Fi for transport, Matter defines a unified data model, secure commissioning, and local control that removes dependence on proprietary vendor clouds. It is backed by Apple, Google, Amazon, and Samsung, and aims to resolve the fragmentation that historically forced consumers into single-ecosystem smart-home purchases."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol ;
    vc:slug "matter-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:thread-protocol,
        ngm:zigbee .

ngm:mechanistic-interpretability a owl:Class ;
    rdfs:label "Mechanistic Interpretability"@en ;
    rdfs:comment "Mechanistic interpretability is a research area that seeks to reverse-engineer the internal computations of neural networks into human-understandable algorithms. It studies features, circuits, and representations within model weights and activations to explain how specific behaviours arise. The field aims to make models transparent enough to predict, audit, and align, supporting AI safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparse-autoencoders ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:governance,
        ngm:security ;
    vc:contrastsWith ngm:post-hoc-explanation ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:representation-learning ;
    vc:enables ngm:ai-alignment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:activation-patching,
        ngm:sparse-autoencoders ;
    vc:implements ngm:causal-tracing ;
    vc:isPartOf ngm:ai-safety,
        ngm:explainable-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:model-evaluation,
        ngm:safety-and-alignment,
        ngm:superposition-hypothesis ;
    vc:requires ngm:neural-network,
        ngm:transformer-architecture ;
    vc:slug "mechanistic-interpretability" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:ai-risks,
        ngm:safety-and-alignment .

ngm:mining-reward a owl:Class ;
    rdfs:label "Mining Reward"@en ;
    rdfs:comment "A Mining Reward is the economic incentive awarded to the miner who successfully produces a valid block and appends it to the canonical blockchain, comprising a block subsidy of newly minted cryptocurrency plus the aggregate transaction fees of all transactions included in that block. The subsidy follows a pre-programmed halving schedule—in Bitcoin, halving every 210,000 blocks—gradually reducing issuance until the subsidy approaches zero and transaction fees become the sole miner compensation, aligning long-term network security incentives with user demand for block space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain-entity ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:blockchain-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-entity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain-economics,
        ngm:high-energy-consumption,
        ngm:miner,
        ngm:mining-pool,
        ngm:transaction-fee ;
    vc:requires ngm:consensus-mechanism,
        ngm:mining,
        ngm:proof-of-work ;
    vc:slug "mining-reward" ;
    vc:sourceDomain "blockchain" .

ngm:mobile-robot-platform a owl:Class ;
