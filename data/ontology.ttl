        ngm:training-data ;
    vc:enables ngm:autonomous-driving,
        ngm:computer-vision-system,
        ngm:instance-segmentation,
        ngm:object-detection-and-tracking,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anchor-box,
        ngm:feature-pyramid-network,
        ngm:heatmap-regression,
        ngm:iou-loss,
        ngm:non-maximum-suppression ;
    vc:implements ngm:object-detection ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bounding-volume,
        ngm:bounding-volume-hierarchy,
        ngm:gaussian-process-regression,
        ngm:image-classification,
        ngm:semantic-segmentation ;
    vc:requires ngm:benchmark-dataset,
        ngm:computer-vision,
        ngm:loss-function,
        ngm:regression ;
    vc:slug "bounding-box-regression" ;
    vc:sourceDomain "machine-learning" ;
