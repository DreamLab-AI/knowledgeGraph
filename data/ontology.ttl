        ngm:kyc-aml-compliance,
        ngm:regulatory-approval ;
    vc:slug "security-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:mifid-ii,
        ngm:regulation-d,
        ngm:securities-exchange-commission ;
    vc:uses ngm:asset-tokenisation,
        ngm:erc-3643-t-rex,
        ngm:erc1400-standard,
        ngm:smart-contract .

ngm:smart-city a owl:Class ;
