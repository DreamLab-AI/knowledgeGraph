ngm:bolt-11 a owl:Class ;
    rdfs:comment "BOLT11 is the Lightning Network specification for the invoice format used to request a single payment. It encodes payment amount, payment hash, description, expiry, and optional routing hints into a bech32-encoded string that the payer scans or pastes to initiate an off-chain payment."@en ;
    rdfs:label "BOLT11"@en ;
    rdfs:subClassOf ngm:bolt ;
