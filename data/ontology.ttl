    rdfs:label "Data Cards"@en .
ngm:data-catalog a owl:Class ;
    rdfs:comment "A data catalog is a centralised, searchable inventory of an organisation's data assets enriched with metadata, descriptions, ownership and usage context. It enables discovery, governance and self-service analytics by indexing datasets, schemas and their relationships, often integrating glossaries and lineage. As a component of metadata management and data fabric architectures it is essential for finding and trusting data at scale."@en ;
    rdfs:label "Data Catalog"@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
