    dcterms:modified "2026-04-26T17:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Accountability
artificial-intelligence:Accountability rdf:type owl:Class ;
    rdfs:label "Accountability"@en ;
    rdfs:comment "The assignment of clear responsibilities for AI system development, deployment, and outcomes, coupled with mechanisms for oversight, redress, and remediation, ensuring that actors can be held answerable for system impacts and failures."@en ;
    skos:prefLabel "Accountability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:accountability" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:accountability> ;
    vcw:contentHash "sha256-12-02d9fc164513" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0067" ;
