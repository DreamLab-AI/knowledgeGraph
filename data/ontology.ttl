    vc:slug "message-authentication" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:authentication-standards,
        ngm:bbs-signatures ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:message-authentication-code .

ngm:micro-strategy a owl:Class ;
    rdfs:label "MicroStrategy"@en ;
    rdfs:comment "MicroStrategy (rebranded Strategy in 2025) is a Nasdaq-listed business intelligence and analytics software company that became the first publicly traded corporation to adopt Bitcoin as its primary treasury reserve asset, initiating this strategy in August 2020 under executive chairman Michael Saylor. The company has since deployed multiple capital market instruments—including convertible notes, equity offerings, and preferred stock—to continuously acquire Bitcoin, accumulating over 500,000 BTC by early 2025 and creating a leveraged Bitcoin exposure vehicle accessible through public equity markets. MicroStrategy's approach established a corporate treasury model that has been studied and replicated by other public companies seeking Bitcoin exposure."@en ;
    rdfs:subClassOf ngm:enterprise-blockchain ;
    vc:contrastsWith ngm:bitcoin-proof-of-work-protocol-etf,
        ngm:data-analytics ;
    vc:enables ngm:digital-asset,
        ngm:digital-asset-market,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
