        ngm:computer-vision,
        ngm:multimodal-ai-architecture ;
    vc:contrastsWith ngm:flamingo,
        ngm:full-fine-tuning,
        ngm:llava,
        ngm:minigpt-4 ;
    vc:enables ngm:cross-modal-retrieval,
        ngm:diffusion-model,
        ngm:fine-tuning,
        ngm:image-captioning,
        ngm:multimodal-reasoning,
        ngm:visual-question-answering,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:image-text-contrastive-loss,
        ngm:large-language-model,
        ngm:learnable-query-tokens,
        ngm:linear-projection-layer,
        ngm:q-former,
        ngm:vision-transformer ;
    vc:qualityScore "0.93"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:gemini-multimodal-language-model,
        ngm:instruct-blip,
        ngm:kohya-dreambooth-and-similar,
        ngm:lora-fine-tuning,
        ngm:multimodal-understanding,
        ngm:stable-diffusion ;
    vc:requires ngm:frozen-image-encoder,
