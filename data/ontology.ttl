ngm:voice-over-ip a owl:Class ;
    rdfs:label "Voice Over Ip"@en ;
    rdfs:comment "Voice over IP (VoIP) is a family of technologies that digitise, compress, and transmit voice communications as packetised data over Internet Protocol networks rather than through dedicated circuit-switched telephony infrastructure. Audio is sampled, encoded using codecs such as G.711, G.729, or Opus, packetised, and transported using the Real-time Transport Protocol (RTP) over UDP, with session management handled by signalling protocols such as SIP or H.323. VoIP enables cost reduction, feature richness, and integration with unified communications platforms, but introduces quality-of-service sensitivities to packet loss, jitter, and latency. Encryption via SRTP and TLS/DTLS provides confidentiality and integrity for enterprise and consumer deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure ],
        ngm:real-time-communication ;
    vc:bridgesTo ngm:automatic-speech-recognition ;
    vc:contrastsWith ngm:real-time-collaborative-editing ;
    vc:dependsOn ngm:infrastructure,
        ngm:iot-infrastructure ;
    vc:enables ngm:communication-protocols,
        ngm:real-time-messaging,
        ngm:real-time-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:secure-communication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:real-time,
        ngm:real-time-computing,
        ngm:secure-channel ;
    vc:requires ngm:infrastructure,
        ngm:network-protocol ;
    vc:slug "voice-over-ip" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:communication-protocol,
        ngm:real-time-collaboration,
        ngm:real-time-communication ;
    vc:uses ngm:cryptographic-protocol,
        ngm:network-protocol .

