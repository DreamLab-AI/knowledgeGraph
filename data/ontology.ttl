ngm:erc20 a owl:Class ;
    rdfs:comment "ERC20 is the Ethereum fungible token standard (Ethereum Improvement Proposal 20) defining a mandatory common interface for token transfers, approvals, and balance queries. It specifies six required functions and two events enabling interoperable smart contract interaction, forming the technical foundation of decentralised finance, governance tokens, and digital asset ecosystems on EVM-compatible chains."@en ;
    rdfs:label "ERC20"@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
