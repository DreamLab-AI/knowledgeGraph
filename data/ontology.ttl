            owl:someValuesFrom ngm:programming-paradigm ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:code-generation,
        ngm:machine-learning-engineering ;
    vc:contrastsWith ngm:waterfall-model ;
    vc:dependsOn ngm:cloud-computing,
        ngm:containerisation ;
    vc:enables ngm:ai-augmented-software-engineering,
        ngm:cloud-native-applications,
        ngm:devops,
