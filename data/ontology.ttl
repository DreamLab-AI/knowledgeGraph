        ngm:risk-management ;
    vc:slug "investment-management" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-asset,
        ngm:smart-contract .

ngm:ip-addressing a owl:Class ;
    rdfs:label "IP Addressing"@en ;
    rdfs:comment "IP addressing is the scheme by which every host and interface on an Internet Protocol network is assigned a numeric identifier used to locate and route datagrams to it. It encompasses the structure of IPv4 and IPv6 address spaces, the partition of addresses into network and host portions via subnet masks and prefixes, and the assignment mechanisms that allocate addresses to devices. Correct addressing is the precondition for routing decisions and end-to-end delivery across interconnected networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipv6 ],
        ngm:internet-protocol ;
    vc:bridgesTo ngm:routing ;
    vc:contrastsWith ngm:domain-name-system ;
    vc:dependsOn ngm:network-protocol ;
    vc:enables ngm:packet-switching,
        ngm:routing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ipv4,
        ngm:ipv6 ;
    vc:isPartOf ngm:internet-protocol,
        ngm:tcp-ip ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-communication,
        ngm:osi-model ;
    vc:requires ngm:subnet-mask ;
    vc:slug "ip-addressing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf-rfc ;
    vc:supports ngm:domain-name-system ;
    vc:uses ngm:dns .

ngm:kinematic-model a owl:Class ;
    rdfs:label "KinematicModel"@en ;
    rdfs:comment "A kinematic model is a mathematical abstraction that describes the geometry of a robot's motion by relating joint-space variables (angles and displacements) to the position and orientation of the end-effector in Cartesian space, without accounting for the forces or torques that produce that motion. Forward kinematics maps joint configurations to end-effector poses using homogeneous transformation matrices or Denavit-Hartenberg parameters, whereas inverse kinematics solves the reverse problem of finding joint configurations that achieve a desired pose. Kinematic models are foundational to trajectory generation, motion planning, and simulation in robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:sensor-fusion ;
    vc:requires ngm:forward-kinematics,
        ngm:inverse-kinematics ;
    vc:slug "kinematic-model" ;
    vc:sourceDomain "robotics" .

ngm:latency-management-protocol a owl:Class ;
    rdfs:label "Latency Management Protocol"@en ;
    rdfs:comment "A systematic process for monitoring, measuring, and minimizing network delay in interactive metaverse sessions through adaptive techniques including traffic prioritization, predictive buffering, and dynamic routing optimization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
