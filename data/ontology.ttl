ngm:responsible-deployment a owl:Class ;
    rdfs:label "Responsible Deployment"@en ;
    rdfs:comment "Responsible deployment is the disciplined release of AI systems into production with safeguards that manage risk to users and society throughout the system lifecycle. It involves staged rollout, monitoring, impact assessment, access controls, and the ability to roll back or restrict capabilities when harms emerge. It operationalises governance principles at the point where models meet real users."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:social-impact-assessment-sia ;
    vc:slug "responsible-deployment" ;
    vc:sourceDomain "ai" .

