    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:digital-infrastructure,
        ngm:peer-to-peer-network ;
    vc:requires ngm:clock-synchronization,
        ngm:network-protocol ;
