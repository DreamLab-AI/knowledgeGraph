        ngm:finality,
        ngm:transaction-finality ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:slug "transaction-confirmation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block,
        ngm:block-time,
        ngm:timestamp .

ngm:transport-layer a owl:Class ;
    rdfs:label "Transport Layer"@en ;
    rdfs:comment "The Transport Layer is the stratum that provides end-to-end delivery of data between endpoints over a network. It sits above the Network Layer that routes packets and below the protocol and integration strata that rely on reliable channels. It contains segmentation, flow and congestion control, and connection management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-layer ],
