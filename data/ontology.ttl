ngm:supply-chain-finance a owl:Class ;
    rdfs:comment "Supply chain finance is a set of financing and risk-mitigation techniques that optimise working capital and liquidity across the parties in a supply chain. It typically allows suppliers to receive early payment on approved invoices while buyers extend their payment terms, using the buyer's stronger credit standing to lower financing costs. Blockchain and distributed-ledger implementations add shared visibility, automated settlement and tamper-evident provenance to these flows."@en ;
    rdfs:label "Supply Chain Finance"@en ;
    rdfs:subClassOf ngm:trade-finance ;
    rdfs:subClassOf _:r20203 ;
