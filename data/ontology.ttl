ngm:publish-subscribe-pattern a owl:Class ;
    rdfs:label "Publish-Subscribe Pattern"@en ;
    rdfs:comment "A messaging design pattern in which message producers (publishers) emit typed events to named topics or channels without direct knowledge of consumers, and message consumers (subscribers) declare interest in specific topics to receive matching events asynchronously. A broker or event bus mediates delivery, fully decoupling senders from receivers in space, time, and control flow. This architectural separation enables independent scaling, fault isolation, and runtime addition or removal of participants without coordination. Pub/Sub underpins event-driven architectures, stream processing systems, and reactive microservices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning ;
    vc:contrastsWith ngm:point-to-point-messaging ;
    vc:dependsOn ngm:distributed-systems,
        ngm:message-queue ;
    vc:enables ngm:event-driven-architecture,
        ngm:loose-coupling,
        ngm:reactive-systems,
        ngm:stream-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:message-broker ;
    vc:implements ngm:observer-pattern ;
    vc:isPartOf ngm:event-driven-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cqrs,
        ngm:event-sourcing,
        ngm:software-architecture ;
    vc:requires ngm:message-broker,
        ngm:network-transport ;
    vc:slug "publish-subscribe-pattern" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:amqp,
        ngm:apache-kafka,
        ngm:mqtt ;
    vc:supports ngm:microservices-architecture ;
    vc:uses ngm:serialisation .

ngm:real-time-computing a owl:Class ;
    rdfs:label "Real-Time Computing"@en ;
    rdfs:comment "Real-time computing is a computational paradigm in which the correctness of a system depends not only on producing logically correct results but also on producing them within specified timing constraints. Systems are classified as hard real-time (where a missed deadline constitutes a system failure, e.g. aircraft fly-by-wire), firm real-time (where late results are useless but non-catastrophic), or soft real-time (where occasional deadline misses degrade quality rather than cause failure, e.g. multimedia streaming). Achieving real-time guarantees requires deterministic scheduling, bounded interrupt latency, and careful resource management throughout the entire software stack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:digital-twin,
        ngm:inference ;
    vc:contrastsWith ngm:batch-processing ;
    vc:dependsOn ngm:clock-synchronization,
        ngm:latency ;
    vc:enables ngm:autonomous-vehicle,
        ngm:control-system,
        ngm:embedded-systems,
        ngm:industrial-automation ;
