    vc:slug "value-transfer" ;
    vc:sourceDomain "blockchain" .

ngm:variable-stiffness-actuator a owl:Class ;
    rdfs:label "Variable Stiffness Actuator"@en ;
    rdfs:comment "A variable stiffness actuator (VSA) is a compliant robotic actuator whose mechanical stiffness can be adjusted independently of its position, typically using antagonistic springs or adjustable elastic elements. This adjustable compliance lets robots store and release energy, absorb impacts and interact safely with humans and uncertain environments. VSAs are central to safe, energy-efficient force control in physical human-robot interaction."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:pneumatic-actuator ;
    vc:slug "variable-stiffness-actuator" ;
    vc:sourceDomain "robotics" .

ngm:vector-index a owl:Class ;
    rdfs:label "Vector Index"@en ;
    rdfs:comment "A vector index is a data structure that organises high-dimensional embedding vectors to enable fast approximate nearest-neighbour search over large collections. Using methods such as HNSW graphs, IVF partitioning or product quantisation, it trades a small amount of recall for large gains in query latency and scalability. Vector indexes are the retrieval engine behind semantic search and retrieval-augmented generation."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag,
        ngm:semantic-search ;
    vc:slug "vector-index" ;
    vc:sourceDomain "ai" .

ngm:vendor-neutrality a skos:Concept ;
    rdfs:label "Vendor Neutrality"@en .

ngm:venue-tethered-immersive-experience a owl:Class ;
    rdfs:label "Venue-Tethered Immersive Experience"@en ;
    rdfs:comment "An immersive or interactive experience tied to a specific physical venue or geographic location, combining real-world presence with digital or spatial computing overlays. Location-based experiences leverage spatial mapping, real-time content delivery, and user proximity to deliver contextually relevant narrative or interactive content that cannot be replicated remotely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gps ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-mapping ],
        ngm:immersive-experience,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:performing-arts,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-venue ;
    vc:requires ngm:gps,
        ngm:spatial-mapping ;
    vc:slug "venue-tethered-immersive-experience" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-delivery-network,
        ngm:extended-reality .

ngm:verifiable-credential-standard a owl:Class ;
    rdfs:label "Verifiable Credential Standard"@en ;
    rdfs:comment "The W3C Verifiable Credentials Data Model specification defines a structured, cryptographically verifiable format for expressing claims about subjects. Credentials are issued by a trusted issuer, held by a subject, and verified by relying parties using digital signatures and Decentralized Identifiers (DIDs), enabling portable, privacy-preserving identity across metaverse and web platforms without centralised databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:digital-identity,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:interoperability-standard ;
    vc:requires ngm:cryptography,
        ngm:decentralized-identifiers ;
    vc:slug "verifiable-credential-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards .

