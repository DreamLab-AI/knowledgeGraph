        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-derivation-function ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:cryptography ;
    vc:enables ngm:cryptographic-protocol,
        ngm:knowledge-graph-publication-classifier-key-infrastructure,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:asymmetric-encryption,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:key-derivation-function,
        ngm:random-number-generation,
        ngm:symmetric-encryption ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:elliptic-curve-cryptography,
        ngm:homomorphic-encryption,
        ngm:key-management,
        ngm:merkle-tree,
        ngm:post-quantum-cryptography,
        ngm:proof-of-work ;
    vc:slug "cryptographic-primitive" ;
    vc:sourceDomain "blockchain" .

ngm:human-oversight a owl:Class ;
    rdfs:label "Human Oversight"@en ;
    rdfs:comment "The continuous or periodic involvement of competent human actors in the governance, development, deployment, and operation of artificial intelligence systems, exercising meaningful control, judgment, and intervention capabilities to ensure AI system decisions and actions remain aligned with human values, ethical principles, legal requirements, and intended purposes, with particular emphasis on preventing, detecting, and correcting harmful or inappropriate AI behaviours through informed human decision-making authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
