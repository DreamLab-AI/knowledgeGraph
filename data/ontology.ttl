ngm:digital-human-avatar-representation a owl:Class ;
    rdfs:label "Digital Human Avatar Representation"@en ;
    rdfs:comment "The combined domain encompassing the creation, animation, and management of digital representations of human beings in virtual environments, including photorealistic digital humans, stylised avatars, and fictional characters. This domain integrates motion capture, AI-driven face and body generation, lip-synchronisation, and avatar portability standards to produce consistent, expressive agents across metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-humans ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:character-model ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:avatar-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:character-model,
        ngm:digital-humans ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "digital-human-avatar-representation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:animation-software,
        ngm:digital-human-technology,
        ngm:motion-capture .

