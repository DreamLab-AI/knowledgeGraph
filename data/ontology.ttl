ngm:data-persistence a owl:Class ;
    rdfs:label "Data Persistence"@en ;
    rdfs:comment "Data Persistence is the property of data surviving beyond the lifetime of the process, session, or physical medium that created it, encompassing all mechanisms and design patterns — relational databases, distributed file systems, append-only event logs, object stores, and key-value stores — that guarantee this durability. In transactional systems, persistence is formalised through the ACID properties (Atomicity, Consistency, Isolation, Durability), where the Durability guarantee ensures committed transactions survive system failure by means of write-ahead logging and fsync operations. Beyond single-node databases, distributed systems trade aspects of consistency for availability and partition tolerance as described in the CAP theorem and the PACELC model, producing a spectrum of persistence strategies from strongly consistent relational systems to eventually consistent distributed NoSQL stores. The selection of a persistence strategy profoundly shapes a system's fault tolerance, latency, throughput, and operational complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:write-ahead-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-sourcing ],
        ngm:data-management ;
    vc:bridgesTo ngm:blockchain-ledger,
        ngm:knowledge-graph,
        ngm:vector-database ;
    vc:contrastsWith ngm:eventual-consistency,
        ngm:in-memory-computing,
        ngm:volatile-storage ;
    vc:dependsOn ngm:acid-properties,
        ngm:consensus-algorithm,
        ngm:distributed-system ;
