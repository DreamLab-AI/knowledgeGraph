        ngm:screen-capture,
        ngm:set-of-mark-prompting,
        ngm:tool-schema,
        ngm:virtual-machine-sandbox,
        ngm:vision-language-model ;
    vc:implements ngm:chain-of-thought,
        ngm:plan-and-execute,
        ngm:re-act,
        ngm:reflexion,
        ngm:screen2-tree-parsing,
        ngm:set-of-mark-prompting,
        ngm:visual-grounding ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:agents,
