    vc:slug "google-gemini" ;
    vc:sourceDomain "ai" .

ngm:gov-uk-one-login a owl:Class ;
    rdfs:label "GOV.UK One Login"@en ;
    rdfs:comment "GOV.UK One Login is the UK government's single sign-on and identity-verification service that lets people access central-government digital services with one account. It combines authentication with identity proofing to a defined assurance level, replacing a fragmented landscape of departmental logins. It is a national digital-identity infrastructure aligned with emerging standards for verifiable credentials and digital identity."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:verifiable-credentials ;
    vc:slug "gov-uk-one-login" ;
    vc:sourceDomain "security" .

ngm:governance-infrastructure a owl:Class ;
    rdfs:label "Governance Infrastructure"@en ;
    rdfs:comment "Governance infrastructure is the set of tools, smart contracts, and systems that enable decentralised organisations to propose, deliberate, vote on, and execute collective decisions. It encompasses voting modules, treasury management, delegation, and on-chain execution that turn community decisions into enforced actions. It is the operational backbone of DAOs and on-chain governance."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-platform-compliance-hub,
        ngm:dao-tooling ;
    vc:slug "governance-infrastructure" ;
    vc:sourceDomain "blockchain" .

ngm:governance-voting a owl:Class ;
    rdfs:label "Governance Voting"@en ;
    rdfs:comment "Governance voting is the mechanism by which holders of governance tokens or members of a decentralised organisation cast votes on proposals to direct a protocol's decisions. Voting power is typically proportional to token holdings or delegated stake, and outcomes can execute automatically on-chain. It is the primary means by which token holders exercise collective control over protocol changes."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:crypto-token ;
    vc:slug "governance-voting" ;
    vc:sourceDomain "blockchain" .

ngm:government-digital-identity a owl:Class ;
    rdfs:label "Government Digital Identity"@en ;
    rdfs:comment "Government digital identity is a state-issued or state-recognised electronic identity that citizens and residents use to prove who they are when accessing public and private services online. It provides identity proofing and authentication backed by authoritative government records, often within a national trust framework. It increasingly draws on verifiable credentials and decentralised identity standards to give users portable, privacy-preserving credentials."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:hyperledger-indy ;
    vc:slug "government-digital-identity" ;
    vc:sourceDomain "security" .

ngm:gpt-4 a owl:Class ;
    rdfs:label "GPT 4"@en ;
    rdfs:comment "A large multimodal language model released by OpenAI in 2023, capable of accepting text and image inputs and producing text outputs, and a successor to the GPT-3.5 series."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
