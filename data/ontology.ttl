    vc:slug "safety-instrumented-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:fmea .
ngm:safety-integrity-level a owl:Class ;
    rdfs:comment "Safety Integrity Level (SIL) is a discrete measure of the risk-reduction provided by a safety function, defined by the IEC 61508 family of standards on four levels (SIL 1 to SIL 4). Each level corresponds to a target probability of dangerous failure on demand or per hour. SIL is used to specify, design, and verify that safety-related control systems achieve a tolerable level of risk."@en ;
    rdfs:label "Safety Integrity Level"@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
