ngm:invoke-ai a owl:Class ;
    rdfs:label "InvokeAI"@en ;
    rdfs:comment "InvokeAI is an open-source, locally-deployed application and toolkit for running latent diffusion models — principally Stable Diffusion and its derivatives — via a browser-based canvas interface, a node-based workflow editor, and a Python API. It provides professional-grade image synthesis capabilities including text-to-image, image-to-image, inpainting, outpainting, and ControlNet-guided generation without reliance on cloud-hosted services. The platform is designed for creative professionals and researchers who require reproducible, privacy-preserving, and customisable generative image workflows on consumer-grade GPU hardware. Its modular architecture supports community fine-tuned model variants, LoRA adapters, and textual inversion embeddings, making it a central hub in the open-source generative image ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python-runtime ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:creative-ai-tools,
        ngm:digital-content-creation ;
    vc:contrastsWith ngm:automatic1111,
        ngm:comfyui,
        ngm:midjourney ;
    vc:enables ngm:image-to-image,
        ngm:inpainting,
        ngm:local-inference,
        ngm:outpainting,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-manager,
        ngm:node-based-workflow-editor,
        ngm:unified-canvas ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:image-generation,
        ngm:latent-diffusion,
        ngm:open-source-ai,
        ngm:prompt-engineering ;
    vc:requires ngm:gpu-compute,
        ngm:python-runtime,
        ngm:stable-diffusion ;
    vc:slug "invoke-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:clip-text-encoder,
        ngm:controlnet,
        ngm:diffusion-model,
        ngm:lora-adapter,
        ngm:textual-inversion .

ngm:inward-investment a skos:Concept ;
    rdfs:label "Inward Investment"@en .

ngm:inworld-ai a owl:Class ;
    rdfs:label "Inworld AI"@en ;
    rdfs:comment "Inworld AI is a company providing tools for building interactive AI-driven characters for games and virtual experiences. Its platform combines language models, speech and behaviour controls to drive non-player characters and avatars."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-to-speech ],
        ngm:conversational-ai ;
    vc:enables ngm:avatar,
        ngm:game-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:text-to-speech ;
    vc:slug "inworld-ai" ;
    vc:sourceDomain "artificial-intelligence" .

