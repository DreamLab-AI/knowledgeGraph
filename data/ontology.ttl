ngm:strategic-bitcoin-reserve a owl:Class ;
    rdfs:label "Strategic Bitcoin Reserve"@en ;
    rdfs:comment "A strategic Bitcoin reserve is a holding of bitcoin maintained by a state, corporation, or institution as a long-term store of value and hedge against fiat debasement, analogous to gold or foreign-currency reserves. Proponents argue that bitcoin's fixed supply and censorship resistance make it a credible reserve asset, while critics cite volatility and custody risk. The concept gained prominence as governments and large treasuries began formal accumulation programmes."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-distribution,
        ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:slug "strategic-bitcoin-reserve" ;
    vc:sourceDomain "blockchain" .

ngm:stratum-v2 a owl:Class ;
    rdfs:label "Stratum V2"@en ;
    rdfs:comment "Stratum V2 is the second-generation protocol for communication between Bitcoin miners and mining pools, redesigned to improve efficiency, security, and decentralisation over the original Stratum. Its headline feature is Job Declaration, which lets individual miners construct their own block templates and choose which transactions to include rather than blindly mining the pool operator's template, redistributing transaction-selection power. It also adds end-to-end encryption, binary framing for lower bandwidth, and reduced susceptibility to man-in-the-middle hashrate hijacking."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:censorship-resistance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol ;
    vc:slug "stratum-v2" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:mining-pool,
        ngm:proof-of-work .

ngm:strict-encoding a owl:Class ;
    rdfs:label "Strict Encoding"@en ;
    rdfs:comment "Strict encoding is a deterministic binary serialisation scheme used in the RGB protocol that guarantees a single canonical byte representation for any given data structure. By forbidding ambiguous orderings and optional layout choices, it ensures that independently computed commitments and hashes match exactly, which is essential for client-side validation. It pairs with strict types to give RGB its reproducible, consensus-free verification."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation,
        ngm:strict-types ;
    vc:slug "strict-encoding" ;
    vc:sourceDomain "blockchain" .

ngm:structurizr-dsl a owl:Class ;
    rdfs:label "Structurizr DSL"@en ;
    rdfs:comment "The Structurizr DSL is a text-based domain-specific language for defining software architecture models conforming to Simon Brown's C4 Model, enabling teams to describe system context, containers, components, and code-level elements as code that can be version-controlled and rendered into multiple diagram formats. It is the primary input format for the Structurizr toolchain, which produces interactive, filterable architecture diagrams from a single workspace definition."@en ;
    rdfs:subClassOf ngm:diagrams-as-code ;
    vc:enables ngm:documentation-generation,
        ngm:software-architecture,
        ngm:technical-documentation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:c4-model ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:architecture,
        ngm:documentation-standards ;
    vc:slug "structurizr-dsl" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:enterprise-architecture .

ngm:stun-and-turn a owl:Class ;
    rdfs:label "STUN and TURN"@en ;
    rdfs:comment "STUN (Session Traversal Utilities for NAT) and TURN (Traversal Using Relays around NAT) are complementary protocols used to establish peer-to-peer connectivity across Network Address Translators and firewalls. STUN allows a client to discover its public IP address and port mapping, while TURN provides a relay server as a fallback when direct connectivity cannot be achieved. Together they form the ICE (Interactive Connectivity Establishment) framework used by WebRTC."@en ;
    rdfs:subClassOf ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:signaling-server,
        ngm:web-rtc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:peer-to-peer-network ;
    vc:slug "stun-and-turn" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:supply-chain-automation a owl:Class ;
    rdfs:label "Supply Chain Automation"@en ;
    rdfs:comment "Supply chain automation is the application of robotics, software and data-driven control to execute and coordinate logistics, warehousing, procurement and fulfilment tasks with minimal manual intervention. It spans physical automation such as robotic picking and conveyance and digital automation such as automated ordering, demand forecasting and exception handling. The goal is higher throughput, lower error rates and end-to-end visibility across the flow of goods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automation ],
