    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "assistive-technology" ;
    vc:sourceDomain "standards" .

ngm:attribute-based-access-control a owl:Class ;
    rdfs:label "Attribute-Based Access Control"@en ;
    rdfs:comment "Attribute-Based Access Control (ABAC) is an authorisation model that grants or denies access by evaluating policies against attributes of the subject, resource, action, and environment rather than against static role assignments. Decisions are computed dynamically from these attributes at request time, enabling fine-grained, context-aware control. ABAC is a cornerstone of zero-trust architectures because it can express rich conditional rules without proliferating roles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authorization ],
        ngm:access-control ;
    vc:bridgesTo ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:role-based-access-control ;
    vc:dependsOn ngm:identity-and-access-management ;
    vc:enables ngm:data-minimisation,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control-policy,
        ngm:authorization ;
    vc:implements ngm:authorization ;
    vc:isPartOf ngm:identity-and-access-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit-logging,
        ngm:cybersecurity ;
    vc:requires ngm:authentication ;
    vc:slug "attribute-based-access-control" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:compliance-monitoring ;
    vc:uses ngm:access-control-policy .

ngm:authentication-mechanism a owl:Class ;
    rdfs:label "Authentication Mechanism"@en ;
    rdfs:comment "An authentication mechanism is a technical procedure or protocol that verifies the claimed identity of a user, device, or system before granting access to protected resources. Such mechanisms range from simple password checks to sophisticated cryptographic challenges and biometric verification. They form the foundational layer of access control systems, ensuring that only authorised principals can interact with sensitive data or services. The strength and appropriateness of a chosen mechanism directly influences the overall security posture of a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:challenge-response-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credential-standard ],
        ngm:authentication ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:dependsOn ngm:cryptographic-protocol,
        ngm:digital-identity,
        ngm:trust-anchor ;
    vc:enables ngm:authorisation,
        ngm:multi-factor-authentication,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:challenge-response-protocol,
        ngm:verifiable-credential-standard ;
    vc:isPartOf ngm:identity-and-access-management,
        ngm:security-protocol ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:session-management ;
    vc:requires ngm:cryptographic-keys,
        ngm:public-key-infrastructure,
        ngm:secure-channel ;
    vc:slug "authentication-mechanism" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido2,
        ngm:oauth-2-0,
        ngm:open-id-connect ;
    vc:supports ngm:access-control,
        ngm:cybersecurity,
        ngm:non-repudiation ;
    vc:uses ngm:authentication-standards,
        ngm:biometric-data,
        ngm:one-time-password .

ngm:base-fee a owl:Class ;
    rdfs:label "Base Fee"@en ;
    rdfs:comment "The Base Fee is the algorithmically determined minimum fee per unit of gas that every transaction must pay to be included in an Ethereum block, introduced by EIP-1559. It adjusts automatically each block based on whether the previous block was above or below its gas target, increasing when demand is high and decreasing when low. Unlike miner tips, the base fee is burned rather than paid to validators, creating a deflationary pressure on ETH supply and making gas price prediction more reliable for users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eip-1559 ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:miner,
        ngm:priority-fee ;
    vc:enables ngm:burning-mechanism,
        ngm:gas-fee-market,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-economics,
        ngm:gas-fee-market ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain-economics,
        ngm:gas-limit,
        ngm:gas-price,
        ngm:priority-fee ;
    vc:requires ngm:blockchain-transaction,
        ngm:eip-1559,
        ngm:gas,
        ngm:mempool ;
    vc:slug "base-fee" ;
    vc:sourceDomain "blockchain" .

ngm:bip-340 a owl:Class ;
    rdfs:label "BIP-340"@en ;
    rdfs:comment "BIP-340 is the Bitcoin Improvement Proposal that standardises Schnorr signatures for use on the Bitcoin network using the secp256k1 elliptic curve, defining a deterministic 64-byte signature scheme that is provably secure in the random oracle model. It introduces x-only 32-byte public key encoding, a tagged hash nonce-generation procedure, and rigorous test vectors to guarantee cross-implementation compatibility. BIP-340 is a strict prerequisite for Taproot (BIP-341) and Tapscript (BIP-342), enabling key aggregation via MuSig2 and linear signature composition that makes multisignature spends indistinguishable on-chain from single-key spends. The proposal represents the most significant cryptographic upgrade to Bitcoin since its inception, substantially improving privacy, efficiency, and the expressiveness of multi-party signing protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secp256k1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tagged-hash ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ecdsa,
        ngm:ed25519 ;
    vc:enables ngm:bip-341,
        ngm:bip-342,
        ngm:mu-sig-2,
        ngm:point-time-locked-contract,
        ngm:taproot,
        ngm:taproot-assets,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:schnorr-signature,
        ngm:x-only-public-key ;
    vc:isPartOf ngm:taproot ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:random-oracle-model,
        ngm:schnorr-signature,
        ngm:secp256k1 ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:secp256k1,
        ngm:tagged-hash ;
    vc:slug "bip-340" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-core ;
    vc:supports ngm:lightning-network,
        ngm:multi-signature ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:sha-256 .

ngm:bls-signature a owl:Class ;
    rdfs:label "BLS Signature"@en ;
    rdfs:comment "A BLS Signature (Boneh–Lynn–Shacham signature) is a cryptographic signature scheme built on bilinear pairings over elliptic curves that permits multiple individual signatures to be aggregated into a single constant-size signature, which can be verified against the aggregate of the corresponding public keys in a single pairing operation. This aggregation property drastically reduces bandwidth and verification cost when many parties must co-sign a message or attest to a block."@en ;
    rdfs:subClassOf ngm:digital-signature ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:infrastructure ;
    vc:contrastsWith ngm:ecdsa,
        ngm:schnorr-signature ;
    vc:dependsOn ngm:discrete-logarithm-problem ;
    vc:enables ngm:consensus-mechanism,
        ngm:distributed-validator-technology,
        ngm:signature-aggregation,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:digital-signature,
        ngm:proof-of-stake ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:key-management,
        ngm:multi-party-computation,
        ngm:zero-knowledge-proof,
        ngm:zk-snark ;
    vc:slug "bls-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:distributed-key-generation,
        ngm:validator-attestation ;
    vc:uses ngm:bilinear-pairing,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:public-key-cryptography .

ngm:bolt-specifications a owl:Class ;
    rdfs:label "BOLT Specifications"@en ;
    rdfs:comment "The BOLT (Basis of Lightning Technology) specifications are the open, community-maintained set of documents defining the Lightning Network protocol, covering peer messaging, channel establishment and closure, commitment transactions, onion-routed payments, and invoice formats. By specifying the wire protocol and behaviour precisely, BOLTs ensure that independently developed Lightning implementations interoperate on a single payment network layered atop Bitcoin. They are the normative reference that makes the Lightning Network a multi-implementation open standard rather than a single product."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
        ngm:lightning-network ;
    vc:slug "bolt-specifications" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:network-protocol .

ngm:bounding-volume a owl:Class ;
    rdfs:label "Bounding Volume"@en ;
    rdfs:comment "A Bounding Volume is a simple geometric shape—typically a sphere, axis-aligned bounding box (AABB), oriented bounding box (OBB), or convex hull—that encloses a more complex geometric object or set of objects. By testing intersections or containment against the bounding volume rather than the full geometry, real-time rendering engines, physics simulators, and spatial query systems achieve orders-of-magnitude speedups during broad-phase culling and collision detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:spatial-data-structure ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:occlusion-culling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:scene-graph,
        ngm:spatial-index ;
    vc:slug "bounding-volume" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physics-simulation,
        ngm:real-time-rendering .

ngm:business-continuity a owl:Class ;
    rdfs:label "Business Continuity"@en ;
    rdfs:comment "Business continuity is the discipline of ensuring that an organisation's critical functions can continue, or be rapidly restored, during and after a disruptive event such as an outage, disaster, or cyber-incident. It combines planning, redundancy, recovery procedures, and testing to limit downtime and data loss against defined objectives. In technical infrastructure it is realised through high availability, disaster recovery, fault tolerance, and resilient architecture, and is closely coupled with risk management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:redundancy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:disaster-recovery ],
        ngm:resilience ;
    vc:contrastsWith ngm:disaster-recovery ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:high-availability,
        ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:operational-resilience,
        ngm:risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:high-availability,
        ngm:resilience,
        ngm:risk-management ;
    vc:requires ngm:disaster-recovery,
        ngm:redundancy ;
    vc:slug "business-continuity" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:incident-response ;
    vc:uses ngm:fault-tolerance,
        ngm:service-level-agreement .

ngm:byte-pair-encoding a owl:Class ;
    rdfs:label "Byte Pair Encoding"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges the most frequent pairs of characters or character sequences to build a vocabulary, originally developed for data compression and widely adopted in neural language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vocabulary ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:data-compression,
        ngm:information-theory ;
    vc:contrastsWith ngm:sentence-piece,
        ngm:word-piece ;
    vc:enables ngm:natural-language-processing,
        ngm:neural-machine-translation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:vocabulary ;
    vc:implements ngm:data-compression ;
    vc:isPartOf ngm:neural-network-text-tokenisation,
        ngm:subword-tokenisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gpt,
        ngm:large-language-models,
        ngm:ro-berta,
        ngm:tokenization ;
    vc:requires ngm:training-corpus ;
    vc:slug "byte-pair-encoding" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:transformer .

ngm:capital-allocation a owl:Class ;
    rdfs:label "Capital Allocation"@en ;
    rdfs:comment "Capital allocation is the process by which firms, investors and markets distribute scarce financial resources across competing uses to maximise risk-adjusted return or strategic value. It spans corporate decisions about investing, returning capital and funding, as well as investor decisions about deploying funds across assets and opportunities. Effective allocation channels capital towards its most productive uses, making it central to both firm performance and the efficiency of the wider financial system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:portfolio-management ],
        ngm:investment-management ;
    vc:bridgesTo ngm:financial-services ;
    vc:dependsOn ngm:liquidity ;
    vc:enables ngm:capital-efficiency,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:portfolio-management ;
    vc:isPartOf ngm:investment-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-system,
        ngm:risk-management ;
    vc:requires ngm:portfolio-management,
        ngm:risk-management ;
    vc:slug "capital-allocation" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:capital-markets ;
    vc:uses ngm:resource-allocation .

ngm:chain-of-thought-prompting a owl:Class ;
    rdfs:label "Chain-of-Thought Prompting"@en ;
    rdfs:comment "Chain-of-thought (CoT) prompting is a prompt engineering technique that elicits intermediate reasoning steps from a large language model before it produces a final answer, substantially improving performance on multi-step arithmetic, commonsense reasoning, and symbolic manipulation tasks. By including exemplars that demonstrate step-by-step reasoning or by appending the instruction 'Let's think step by step' (zero-shot CoT), the technique leverages the model's autoregressive generation to decompose complex problems into tractable substeps. CoT prompting was formally characterised by Wei et al. (2022) and has become a foundational capability-elicitation method for frontier language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emergent-capabilities ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-shot-prompting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tree-of-thoughts ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-consistency ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:explainable-ai,
        ngm:neuro-symbolic-ai ;
    vc:contrastsWith ngm:direct-answer-prompting,
        ngm:standard-prompting ;
    vc:enables ngm:ai-agent,
        ngm:common-sense-reasoning,
        ngm:mathematical-reasoning,
        ngm:multi-step-reasoning,
        ngm:symbolic-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:self-consistency,
        ngm:tree-of-thoughts,
        ngm:zero-shot-prompting ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-reasoning,
        ngm:react-prompting,
        ngm:reasoning-engine ;
    vc:requires ngm:emergent-capabilities,
        ngm:foundation-model ;
    vc:slug "chain-of-thought-prompting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:autoregressive-model,
        ngm:few-shot-prompting,
        ngm:in-context-learning,
        ngm:large-language-models,
        ngm:reinforcement-learning-from-human-feedback .

ngm:character-model a owl:Class ;
    rdfs:label "Character Model"@en ;
    rdfs:comment "A 3D digital representation of a character consisting of a polygonal mesh, textures, and materials, designed with clean topology optimized for animation and real-time rendering, serving as the foundation for rigging, skinning, and character animation workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
