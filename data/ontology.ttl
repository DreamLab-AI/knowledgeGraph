ngm:oauth-2-0 a owl:Class ;
    rdfs:label "OAuth 2.0"@en ;
    rdfs:comment "OAuth 2.0 is an open authorisation framework standardised as RFC 6749 (2012) that enables a resource owner to delegate scoped, time-limited access to their protected resources on a resource server to a third-party client application, without exposing credentials. The framework separates four distinct roles—resource owner, client, authorisation server, and resource server—and defines multiple grant types (authorisation code, client credentials, device code, refresh token) suited to different trust levels and client profiles. Access tokens with explicit scopes enforce the principle of least privilege, while extensions such as PKCE (RFC 7636), JWT access tokens (RFC 9068), token introspection (RFC 7662), and token revocation (RFC 7009) complete the lifecycle. OAuth 2.0 serves as the foundation upon which OpenID Connect 1.0 adds federated authentication, together underpinning modern Identity and Access Management platforms and Zero Trust Architecture policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:api-key-authentication,
        ngm:oauth-1-0 ;
    vc:enables ngm:api-security,
        ngm:delegated-authorisation,
        ngm:identity-federation,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:access-token,
        ngm:authorisation-code-flow,
        ngm:client-credentials-flow,
        ngm:pkce,
        ngm:refresh-token ;
    vc:implements ngm:rfc-6749,
        ngm:rfc-6750,
        ngm:rfc-7636 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:federated-identity,
        ngm:identity-and-access-management,
        ngm:openid-connect,
        ngm:saml ;
    vc:requires ngm:authentication,
        ngm:https,
        ngm:json-web-token ;
    vc:slug "oauth-2-0" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf ;
    vc:supports ngm:least-privilege,
        ngm:zero-trust-architecture ;
    vc:uses ngm:authorisation-server,
        ngm:bearer-token,
        ngm:scope .

ngm:real-time-communication a owl:Class ;
    rdfs:label "Real-Time Communication"@en ;
    rdfs:comment "Real-time communication (RTC) is the exchange of audio, video, and arbitrary data between two or more endpoints with latency low enough to support interactive, synchronous engagement — typically under 150 ms end-to-end for voice and video. It encompasses the protocols, codecs, signalling mechanisms, and network transport layers that jointly minimise delay, jitter, and packet loss while adapting to dynamic network conditions. Modern RTC systems span peer-to-peer browser sessions via WebRTC, carrier-grade VoIP infrastructure built on SIP and RTP, and real-time data channels used in collaborative applications, gaming, and distributed control systems. Quality of experience is governed by congestion control algorithms, forward error correction, jitter buffering, and adaptive bitrate strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-compression ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-rtc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-latency ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:extended-reality,
        ngm:spatial-audio ;
    vc:contrastsWith ngm:asynchronous-messaging,
        ngm:batch-processing ;
    vc:dependsOn ngm:content-delivery-network,
        ngm:ice-framework,
        ngm:wireless-connectivity ;
    vc:enables ngm:collaborative-editing,
        ngm:live-streaming,
        ngm:video-conferencing,
        ngm:voice-over-ip ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:real-time-transport-protocol,
        ngm:session-initiation-protocol,
        ngm:signalling,
        ngm:web-rtc ;
    vc:qualityScore "0.74"^^xsd:float ;
