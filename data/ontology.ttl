ngm:wco-safe-framework a owl:Class ;
    rdfs:comment "The WCO SAFE Framework of Standards is a World Customs Organization instrument that sets out principles and standards to secure and facilitate global supply chains. It establishes customs-to-customs network arrangements, customs-to-business partnerships through Authorised Economic Operator (AEO) programmes, and risk-based advance electronic cargo data exchange. SAFE balances trade facilitation with security against terrorism and illicit trade."@en ;
    rdfs:label "WCO SAFE Framework"@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
