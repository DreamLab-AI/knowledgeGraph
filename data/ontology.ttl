        ngm:target-tracking,
        ngm:visual-perception ;
    vc:slug "gaze-control" ;
    vc:sourceDomain "robotics" .

ngm:generative-ai-engineering a owl:Class ;
    rdfs:label "Generative AI Engineering"@en ;
    rdfs:comment "Generative AI Engineering is the applied discipline concerned with designing, developing, fine-tuning, and deploying generative AI systems—such as large language models, diffusion models, and multimodal transformer architectures—to create novel artefacts including text, images, audio, code, and synthetic data. It encompasses the full engineering lifecycle from model selection and prompt engineering through retrieval-augmented generation, evaluation, and production observability. The field bridges machine learning research and software engineering, requiring competence in model architecture, infrastructure, and responsible AI practices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-ai-agents,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fine-tuning,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation,
        ngm:synthetic-data-generation ;
