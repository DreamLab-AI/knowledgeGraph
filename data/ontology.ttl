        ngm:training-dataset ;
    vc:implements ngm:action-chunking-transformer,
        ngm:behavioural-cloning,
        ngm:dagger-ci-pipeline-engine,
        ngm:diffusion-policy,
        ngm:goal-conditioned-behaviour-cloning,
        ngm:inverse-reinforcement-learning ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:apprenticeship-learning,
        ngm:large-scale-pretrained-foundation-model,
