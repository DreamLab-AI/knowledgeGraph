            owl:someValuesFrom ngm:point-cloud-generation ],
        ngm:data-management ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:supply-chain-visibility ;
    vc:dependsOn ngm:global-positioning-system,
        ngm:satellite-imagery ;
