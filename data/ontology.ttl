ngm:gauge-voting a owl:Class ;
    rdfs:label "Gauge Voting"@en ;
    rdfs:comment "Gauge voting is a mechanism in protocols such as Curve where token holders allocate weights to liquidity pools, determining how reward emissions are distributed. Voting power is usually tied to time-locked governance tokens."@en ;
