    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Adversarial Robustness
artificial-intelligence:AdversarialRobustness rdf:type owl:Class ;
    rdfs:label "Adversarial Robustness"@en ;
    rdfs:comment "The capability of an AI system to maintain correct and consistent behavior when subjected to adversarial examples—inputs intentionally crafted with small, often imperceptible perturbations designed to cause misclassification or incorrect outputs."@en ;
    skos:prefLabel "Adversarial Robustness"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:adversarial-robustness" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:adversarial-robustness> ;
    vcw:contentHash "sha256-12-67ec8dc4eb5e" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0074" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0074" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T20:12:08Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AdversarialRobustness vcw:bridgesTo artificial-intelligence:ComputerVision .

# Model Robustness
artificial-intelligence:ModelRobustness rdf:type owl:Class ;
    rdfs:label "Model Robustness"@en ;
    rdfs:comment "The capacity of a machine learning model to maintain consistent and reliable performance when exposed to variations in input data, including noise, distributional shifts, and edge cases, without catastrophic degradation in accuracy or functionality."@en ;
    skos:prefLabel "Model Robustness"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-robustness" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-robustness> ;
    vcw:contentHash "sha256-12-8a413b1302b2" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
