        ngm:service-mesh ;
    vc:implements ngm:domain-driven-design,
        ngm:event-driven-architecture ;
    vc:isPartOf ngm:cloud-native ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:circuit-breaker-pattern,
        ngm:twelve-factor-app ;
    vc:requires ngm:container-orchestration,
        ngm:continuous-integration,
        ngm:distributed-tracing ;
    vc:slug "microservices-architecture" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:devops,
        ngm:observability ;
    vc:uses ngm:g-rpc,
        ngm:rest-api,
        ngm:saga-pattern .

ngm:on-chain-governance a owl:Class ;
    rdfs:label "On-chain Governance"@en ;
    rdfs:comment "On-chain governance is a blockchain coordination model in which protocol upgrade proposals, parameter changes, and treasury spending decisions are formally submitted, deliberated, voted on by token holders, and automatically enacted through the execution of smart contracts recorded on the distributed ledger. Governance logic is codified directly in the protocol layer, making all votes, quorum checks, and execution outcomes immutable, censorship-resistant, and publicly auditable on-chain records. It contrasts with off-chain governance, where decisions emerge from social consensus (forums, developer meetings, improvement-proposal repositories) and are implemented by core developers without cryptographic enforcement, creating reliance on trust in key actors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:mechanism-design,
        ngm:multi-stakeholder-governance ;
    vc:contrastsWith ngm:centralised-governance,
        ngm:off-chain-governance,
        ngm:plutocracy ;
    vc:dependsOn ngm:token-economics,
        ngm:voting-power ;
    vc:enables ngm:dao-governance,
        ngm:parameter-governance,
        ngm:protocol-upgrades,
        ngm:treasury-management,
        ngm:voting-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decentralised-autonomous-organisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:conviction-voting,
        ngm:open-zeppelin-governor,
        ngm:polkadot,
        ngm:proposal-system,
        ngm:quadratic-voting,
        ngm:tezos ;
    vc:requires ngm:consensus-mechanism,
        ngm:distributed-ledger,
        ngm:quorum ;
    vc:slug "on-chain-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract,
        ngm:timelock-controller,
        ngm:vote-delegation .

ngm:simultaneous-localisation-and-mapping a owl:Class ;
    rdfs:label "Simultaneous Localisation and Mapping"@en ;
    rdfs:comment "Simultaneous Localisation and Mapping (SLAM) is a computational technique by which a mobile robot or autonomous agent concurrently estimates its own pose and constructs a consistent map of a previously unknown environment from sequential sensor observations, resolving the fundamental circular dependency between localisation (which requires a map) and mapping (which requires a known pose). SLAM algorithms process data from sensors such as LiDAR, stereo cameras, RGB-D cameras, and inertial measurement units using probabilistic and optimisation-based frameworks — including extended Kalman filters, particle filters, and pose-graph optimisation — to maintain joint estimates of agent state and environmental structure. The problem is formulated as Bayesian inference over a high-dimensional joint distribution of robot trajectory and landmark positions, typically approximated through factor graphs. SLAM is foundational to autonomous vehicles, mobile robotics, augmented reality, and any system that must navigate without prior maps or GPS."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loop-closure-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-radiance-field,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:dead-reckoning,
        ngm:gps-navigation ;
    vc:dependsOn ngm:computer-vision ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:autonomous-vehicle,
        ngm:semantic-mapping,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:localisation,
        ngm:occupancy-grid,
        ngm:odometry,
        ngm:structure-from-motion,
        ngm:visual-place-recognition ;
    vc:requires ngm:loop-closure-detection,
        ngm:pose-estimation,
        ngm:sensor-fusion ;
    vc:slug "simultaneous-localisation-and-mapping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:bayesian-inference,
        ngm:factor-graph,
        ngm:inertial-measurement-unit,
        ngm:kalman-filter,
        ngm:lidar,
        ngm:particle-filter,
        ngm:point-cloud .

ngm:cryptographic-key-management a owl:Class ;
    rdfs:label "Cryptographic Key Management"@en ;
    rdfs:comment "The administration of cryptographic keys throughout their lifecycle, including generation, storage, distribution, rotation, backup, recovery, and destruction, ensuring the security and availability of keying material while preventing unauthorized access or compromise."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-generation ],
        ngm:cryptography ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:blockchain ;
    vc:contrastsWith ngm:password-management ;
    vc:dependsOn ngm:cryptographic-keys,
        ngm:private-key ;
    vc:enables ngm:authentication,
        ngm:digital-signature,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:key-generation,
        ngm:key-revocation,
        ngm:key-rotation ;
    vc:implements ngm:fips-140-3,
        ngm:nist-sp-800-57 ;
    vc:isPartOf ngm:security-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography ;
    vc:requires ngm:hardware-security-module,
        ngm:public-key-infrastructure,
        ngm:random-number-generation ;
    vc:slug "cryptographic-key-management" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:data-protection,
        ngm:zero-trust-architecture ;
    vc:uses ngm:key-derivation-function,
        ngm:secure-enclave .

ngm:differential-privacy a owl:Class ;
    rdfs:label "Differential Privacy"@en ;
    rdfs:comment "Differential Privacy is a mathematical framework providing provable privacy guarantees by adding carefully calibrated noise to data queries or model outputs, ensuring that the presence or absence of any single individual's data has negligible impact on analysis results. The epsilon (ε) parameter quantifies the privacy budget, with smaller values indicating stronger guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensitivity-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-budget-management ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin ;
    vc:contrastsWith ngm:anonymisation,
        ngm:k-anonymity-in-datasets ;
    vc:enables ngm:federated-edge-learning,
        ngm:privacy-by-design,
        ngm:privacy-preserving-machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gaussian-mechanism,
        ngm:laplace-mechanism,
        ngm:privacy-budget-management ;
    vc:implements ngm:privacy-mechanism ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation ;
    vc:requires ngm:sensitivity-analysis ;
    vc:slug "differential-privacy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-minimisation,
        ngm:data-protection,
        ngm:gdpr-compliance ;
    vc:uses ngm:machine-learning-discipline,
        ngm:stochastic-gradient-descent .

