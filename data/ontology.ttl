ngm:industrial-io-t a owl:Class ;
    rdfs:label "Industrial IoT"@en ;
    rdfs:comment "Industrial IoT (IIoT) is the application of Internet of Things technologies to industrial operational environments, connecting sensors, actuators, programmable logic controllers, and edge gateways to analytics platforms and supervisory control systems to enable real-time operational visibility, process optimisation, predictive maintenance, and remote asset management. IIoT bridges historically isolated operational technology (OT) networks—including SCADA systems, distributed control systems (DCS), and fieldbus networks—with IT infrastructure, creating a converged cyber-physical stack requiring rigorous security governance under frameworks such as IEC 62443. Key application-layer standards include OPC UA (IEC 62541), MQTT (ISO/IEC 20922), AMQP, and time-sensitive networking extensions (IEEE 802.1 TSN) for deterministic Ethernet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        ngm:internet-of-things ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning ;
    vc:contrastsWith ngm:consumer-iot ;
    vc:dependsOn ngm:cloud-computing,
        ngm:network-protocol ;
    vc:enables ngm:condition-monitoring,
        ngm:digital-twin,
        ngm:industrial-automation,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:edge-gateway,
        ngm:programmable-logic-controller,
        ngm:sensor ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:industry-4-0 ;
    vc:requires ngm:cybersecurity,
        ngm:operational-technology,
        ngm:scada ;
    vc:slug "industrial-io-t" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-62443,
        ngm:iec-62541 ;
    vc:uses ngm:edge-computing,
        ngm:mqtt,
        ngm:opc-ua,
        ngm:time-sensitive-networking .

ngm:iso-iec-27001 a owl:Class ;
    rdfs:label "ISO/IEC 27001"@en ;
    rdfs:comment "ISO/IEC 27001 is an internationally recognised standard that specifies the requirements for establishing, implementing, maintaining, and continually improving an Information Security Management System (ISMS) within the context of an organisation's overall business risks. It adopts a risk-based approach, requiring organisations to systematically identify information security risks and apply appropriate controls drawn from Annex A. Certification against ISO/IEC 27001 provides third-party assurance of an organisation's commitment to protecting the confidentiality, integrity, and availability of information assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:audit-trail,
        ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:gdpr-compliance ;
    vc:requires ngm:information-security,
        ngm:risk-assessment ;
    vc:slug "iso-iec-27001" ;
    vc:sourceDomain "infrastructure" .

ngm:latent-diffusion a owl:Class ;
    rdfs:label "Latent Diffusion"@en ;
    rdfs:comment "Latent Diffusion Models (LDMs) are a class of generative models that perform the iterative denoising diffusion process within the compressed latent space of a pre-trained variational autoencoder (VAE), rather than directly in high-dimensional pixel space. By encoding images into a compact, semantically rich latent representation, LDMs dramatically reduce training and inference compute whilst preserving perceptual quality, because the VAE absorbs the high-frequency, imperceptual detail that would otherwise burden the diffusion process. Conditioning on text, image, or other modalities is achieved via cross-attention layers inside a U-Net denoising backbone, enabling high-fidelity text-to-image synthesis, image editing, and multimodal generation at practical hardware budgets. Stable Diffusion, the most widely deployed open-source implementation, demonstrated that consumer GPUs could run production-quality image synthesis, catalysing a broad ecosystem of fine-tuning methods and downstream applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:u-net ],
        ngm:diffusion-model ;
    vc:bridgesTo ngm:augmented-reality-content-creation,
        ngm:digital-twin ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:normalising-flow,
        ngm:pixel-diffusion ;
    vc:enables ngm:image-generation,
        ngm:image-inpainting,
        ngm:image-to-image-translation,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:denoising-score-matching,
        ngm:encoder-decoder,
        ngm:noise-schedule ;
    vc:implements ngm:score-based-generative-model ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:generative-model,
        ngm:neural-network-latent-space,
        ngm:transformer ;
    vc:requires ngm:cross-attention,
        ngm:u-net,
        ngm:variational-autoencoder ;
    vc:slug "latent-diffusion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip,
        ngm:ddim-sampling,
        ngm:low-rank-adaptation .

ngm:load-balancing a owl:Class ;
    rdfs:label "Load Balancing"@en ;
    rdfs:comment "Load balancing is the distribution of incoming work across multiple compute resources to maximise throughput, minimise latency, and avoid overloading any single node. It operates at network layers from L4 transport to L7 application routing, using algorithms such as round-robin, least-connections, and consistent hashing. Health checking and failover make it foundational to scalable, resilient distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:distributed-inference,
        ngm:federated-learning ;
    vc:contrastsWith ngm:single-point-of-failure ;
    vc:dependsOn ngm:dns,
        ngm:reverse-proxy ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:horizontal-scaling,
        ngm:zero-downtime-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:connection-draining,
        ngm:health-check,
        ngm:load-balancing-algorithm ;
    vc:implements ngm:consistent-hashing,
        ngm:round-robin-scheduling ;
    vc:isPartOf ngm:distributed-architecture,
        ngm:service-mesh ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:auto-scaling,
        ngm:traffic-management ;
    vc:requires ngm:health-monitoring,
        ngm:network-infrastructure ;
    vc:slug "load-balancing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:content-delivery-network,
        ngm:microservices-architecture ;
    vc:uses ngm:session-persistence,
        ngm:ssl-termination .

ngm:medical-imaging a owl:Class ;
    rdfs:label "Medical Imaging"@en ;
    rdfs:comment "Medical imaging is the acquisition, reconstruction, processing, and computational analysis of visual representations of human anatomy and physiology — including X-ray, computed tomography (CT), magnetic resonance imaging (MRI), ultrasound, positron emission tomography (PET), single-photon emission computed tomography (SPECT), and digital pathology — for the purposes of clinical diagnosis, treatment planning, surgical guidance, and longitudinal disease monitoring. The field has undergone a fundamental shift with the integration of deep learning methods, particularly convolutional neural networks, vision transformers, and diffusion-based models, which now perform organ segmentation, lesion detection, and disease classification at or near radiologist-level accuracy on constrained benchmarks. Data interoperability is standardised by DICOM (Digital Imaging and Communications in Medicine) for image storage and transfer, and by HL7 FHIR for clinical report integration; AI-based clinical decision software requires regulatory clearance such as FDA 510(k) premarket notification, EU MDR/IVDR conformity assessment, or UKCA marking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-annotation ],
        ngm:healthcare-ai ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:contrastsWith ngm:natural-language-processing ;
    vc:enables ngm:clinical-decision-support,
        ngm:precision-medicine,
        ngm:radiology-ai,
        ngm:surgical-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:image-reconstruction,
        ngm:image-segmentation,
        ngm:object-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-pathology,
        ngm:electronic-health-record,
        ngm:healthcare-ai,
        ngm:radiomics ;
    vc:requires ngm:data-annotation,
        ngm:dicom,
        ngm:gpu-computing ;
    vc:slug "medical-imaging" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:dicom,
        ngm:hl7-fhir ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:federated-learning,
        ngm:image-segmentation,
        ngm:transformer-architecture .

ngm:neural-processing-unit a owl:Class ;
    rdfs:label "Neural Processing Unit"@en ;
    rdfs:comment "A Neural Processing Unit (NPU) is a specialised integrated circuit designed to accelerate neural network inference workloads by providing high-throughput, energy-efficient execution of the matrix multiplication and convolution operations that dominate deep learning computation. NPUs are integrated into mobile SoCs, personal computers, and edge devices to enable on-device AI inference without reliance on cloud compute, targeting performance-per-watt objectives unachievable by general-purpose CPUs or GPUs for these workloads."@en ;
    rdfs:subClassOf ngm:ai-hardware ;
    vc:bridgesTo ngm:edge-computing,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:central-processing-unit,
        ngm:gpu-compute,
        ngm:tensor-processing-unit ;
    vc:dependsOn ngm:memory-bandwidth,
        ngm:semiconductor-fabrication ;
    vc:enables ngm:edge-ai,
        ngm:on-device-inference,
        ngm:on-device-llm,
        ngm:private-ai-inference,
        ngm:real-time-ai-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:multiply-accumulate-unit,
        ngm:on-chip-sram,
        ngm:systolic-array ;
    vc:implements ngm:neural-network-inference,
        ngm:tensor-computation ;
    vc:isPartOf ngm:mobile-soc,
        ngm:system-on-chip ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:apple-neural-engine,
        ngm:copilot-plus-pc,
        ngm:npu ;
    vc:requires ngm:model-quantisation,
        ngm:neural-network-model ;
    vc:slug "neural-processing-unit" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:uses ngm:hardware-acceleration,
        ngm:inference-hardware,
        ngm:int8-quantisation .

ngm:optimal-control a owl:Class ;
    rdfs:label "Optimal Control"@en ;
    rdfs:comment "A control strategy that determines control inputs to minimize or maximize a performance criterion (cost function) while satisfying system dynamics and constraints. It seeks the best possible control policy according to specified objectives, using mathematical frameworks such as dynamic programming, the Hamilton-Jacobi-Bellman equation, and Pontryagin's Maximum Principle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cost-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        ngm:closed-loop-control ;
    vc:bridgesTo ngm:machine-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:heuristic-control,
        ngm:pid-controller ;
    vc:dependsOn ngm:control-theory,
        ngm:optimization-theory ;
    vc:enables ngm:autonomous-vehicle-control,
        ngm:motion-planning,
        ngm:spacecraft-attitude-control,
        ngm:trajectory-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bellman-optimality-principle,
        ngm:hamilton-jacobi-bellman-equation ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:numerical-optimization,
        ngm:robust-control,
        ngm:stochastic-control ;
    vc:requires ngm:cost-function,
        ngm:optimization-algorithm,
        ngm:state-space-representation,
        ngm:system-dynamics-model ;
    vc:slug "optimal-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:adaptive-control,
        ngm:robot-arm-trajectory-optimization ;
    vc:uses ngm:calculus-of-variations,
        ngm:dynamic-programming,
        ngm:linear-quadratic-regulator,
        ngm:model-predictive-control,
        ngm:pontryagins-maximum-principle .

ngm:presence a owl:Class ;
    rdfs:label "Presence"@en ;
    rdfs:comment "Perceptual state in which a user feels located inside a virtual or mixed environment, experiencing spatial, social, and self presence as a unified phenomenological response to immersive sensory stimulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensory-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
