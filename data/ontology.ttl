    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain,
        ngm:miner,
        ngm:mining,
        ngm:transaction-fee ;
    vc:slug "difficulty-adjustment" ;
    vc:sourceDomain "blockchain" .

