        ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-generation,
        ngm:code-synthesis,
        ngm:natural-language-generation,
        ngm:text-to-image,
        ngm:text-to-video ;
    vc:implements ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:transformer-architecture ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:retrieval-augmented-generation,
        ngm:synthetic-media ;
    vc:requires ngm:embeddings,
        ngm:foundation-model,
        ngm:gpu-compute ;
    vc:slug "content-generation" ;
    vc:sourceDomain "ai" .

ngm:context-engineering a owl:Class ;
