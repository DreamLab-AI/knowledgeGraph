ngm:green-computing a owl:Class ;
    rdfs:label "Green Computing"@en ;
    rdfs:comment "Green computing is the design, manufacture, operation and disposal of computing systems in ways that minimise environmental impact across their lifecycle. It targets energy efficiency, reduced carbon emissions, sustainable materials and responsible electronic-waste management. Practices range from efficient hardware and data-centre design to carbon-aware scheduling of workloads onto low-carbon energy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-efficiency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-aware-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lifecycle-assessment ],
        ngm:sustainability ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:contrastsWith ngm:energy-consumption ;
    vc:dependsOn ngm:renewable-energy ;
    vc:enables ngm:energy-efficiency ;
