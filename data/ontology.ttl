ngm:speech-recognition a owl:Class ;
    rdfs:label "Speech Recognition"@en ;
    rdfs:comment "Speech Recognition (also called Automatic Speech Recognition, ASR) is the computational task of converting spoken acoustic signals into a textual representation, enabling machines to interpret and act on human voice input. Modern systems use end-to-end deep learning architectures — principally transformer-based encoder-decoder models such as Wav2Vec 2.0 and Whisper — trained on thousands of hours of labelled audio to achieve near-human word-error rates across diverse speakers, languages, and acoustic environments. Key technical challenges include robustness to background noise, speaker variability, dialectal and accent diversity, and code-switching; deployment challenges include latency constraints for real-time streaming, on-device inference under power and memory limits, and domain adaptation for specialised vocabularies such as clinical or legal terminology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:accessibility-technology,
        ngm:multimodal-interaction,
        ngm:voice-user-interface ;
    vc:contrastsWith ngm:speaker-recognition,
        ngm:voice-activity-detection ;
    vc:dependsOn ngm:labelled-training-data,
        ngm:model-compression ;
    vc:enables ngm:clinical-documentation,
        ngm:language-translation,
        ngm:question-answering,
        ngm:real-time-captioning,
        ngm:virtual-assistant,
        ngm:voice-user-interface ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:named-entity-recognition,
        ngm:sentiment-analysis,
        ngm:speaker-diarisation,
        ngm:speech-synthesis,
        ngm:text-to-speech ;
    vc:requires ngm:acoustic-model,
        ngm:audio-signal-processing,
        ngm:feature-extraction,
        ngm:language-model ;
    vc:slug "speech-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:nist,
        ngm:w3c-web-speech-api ;
    vc:uses ngm:attention-mechanism,
        ngm:connectionist-temporal-classification,
        ngm:convolutional-neural-network,
        ngm:neural-network,
        ngm:transformer .

ngm:content-delivery-network a owl:Class ;
    rdfs:label "Content Delivery Network"@en ;
    rdfs:comment "A Content Delivery Network (CDN) is a geographically distributed system of edge servers and Points of Presence (PoPs) that cache, replicate, and serve web assets — static files, media streams, and increasingly dynamic API responses — from locations physically near end users, substantially reducing round-trip latency and offloading origin-server load. CDNs use anycast routing, DNS-based request steering, and intelligent load balancing to direct each client request to the nearest healthy PoP, with cache coherence governed by HTTP cache-control semantics (RFC 9111) and conditional request mechanisms. Modern CDNs have evolved into full edge-compute platforms, offering TLS termination, DDoS mitigation, Web Application Firewall (WAF) services, and serverless edge runtimes (e.g. Cloudflare Workers, Fastly Compute) that execute application logic at PoPs without origin round-trips, blurring the boundary between network infrastructure and distributed application hosting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dns ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:edge-ai-inference,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:origin-server,
        ngm:peer-to-peer-network ;
    vc:enables ngm:ddos-mitigation,
        ngm:edge-computing,
        ngm:low-latency-delivery,
        ngm:origin-offload ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:edge-server,
        ngm:load-balancer,
        ngm:point-of-presence,
        ngm:web-application-firewall ;
    vc:isPartOf ngm:internet-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:network-latency,
        ngm:reverse-proxy,
        ngm:web-performance ;
    vc:requires ngm:anycast-routing,
        ngm:dns,
        ngm:tls ;
    vc:slug "content-delivery-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:microservices-architecture,
        ngm:scalability-pattern,
        ngm:streaming-media ;
    vc:uses ngm:anycast-routing,
        ngm:encryption,
        ngm:http-caching,
        ngm:http3-quic .

ngm:control-system a owl:Class ;
    rdfs:label "Control System"@en ;
    rdfs:comment "Control system encompasses the computational and hardware subsystems that sense environmental state, evaluate performance against desired objectives, and generate actuation commands to regulate robot behaviour toward goals."@en ;
