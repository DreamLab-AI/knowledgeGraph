ngm:version-history a owl:Class ;
    rdfs:label "Version History"@en ;
    rdfs:comment "Version History is a chronological record of all changes made to a shared document or workspace, capturing who made each change and when. It enables collaborators to review past states, compare diffs, and restore previous versions if an edit introduces errors. This audit trail is critical for accountability and safe experimentation in distributed teams."@en ;
