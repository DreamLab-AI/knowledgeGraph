ngm:operational-transformation a owl:Class ;
    rdfs:label "Operational Transformation"@en ;
    rdfs:comment "Operational Transformation (OT) is a concurrency control technique for real-time collaborative editing systems that enables multiple users to concurrently modify a shared document by representing edits as discrete operations and automatically transforming each incoming operation against previously applied operations to preserve user intent. The core insight is that when two concurrent operations are applied in different orders across distributed replicas, at least one must be adjusted — transformed — so that the final document state converges to a consistent result. OT requires a pair of transformation functions (IT and ET for inclusion and exclusion transformation) and must satisfy formal consistency properties (TP1 and TP2) to guarantee convergence under all interleavings. It underpins real-time collaborative editors including Google Docs, Apache Wave, and Etherpad, and remains a foundational technique in distributed collaboration research despite the later emergence of CRDTs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-synchronisation ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:bridgesTo ngm:large-language-model,
        ngm:multi-user-virtual-environment ;
    vc:contrastsWith ngm:crdt,
        ngm:differential-synchronisation,
        ngm:pessimistic-locking ;
    vc:enables ngm:collaboration-tools,
        ngm:collaborative-editing,
        ngm:eventual-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:optimistic-replication ;
    vc:isPartOf ngm:distributed-systems,
        ngm:real-time-collaboration ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:conflict-resolution,
        ngm:consensus-protocol,
        ngm:distributed-consistency,
        ngm:merge-algorithm ;
    vc:requires ngm:causality-tracking,
        ngm:concurrency-control,
        ngm:state-synchronisation ;
    vc:slug "operational-transformation" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:operation-log,
        ngm:transformation-function,
        ngm:vector-clock .

