ngm:access-control-decisions a owl:Class ;
    rdfs:label "Access Control Decisions"@en ;
    rdfs:comment "Access Control Decisions are the runtime determinations made by a policy engine or decision point as to whether a particular subject—user, process, or device—is permitted to perform a requested action on a protected resource, based on evaluated policies, attributes, and contextual signals. These decisions are the operational output of an access control architecture and are typically produced by a Policy Decision Point (PDP) and enforced by a Policy Enforcement Point (PEP)."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:dependsOn ngm:authentication,
        ngm:identity-management ;
    vc:enables ngm:authorisation,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:policy-enforcement-point,
        ngm:role-based-access-control ;
    vc:slug "access-control-decisions" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:policy-decision-point,
        ngm:policy-engine .

ngm:accessibility-captioning a owl:Class ;
    rdfs:label "Accessibility Captioning"@en ;
    rdfs:comment "Accessibility captioning is the practice of producing synchronised textual representations of spoken dialogue, sound effects, and other audio information within video or live media so that deaf, hard-of-hearing, or audio-impaired audiences can fully engage with the content. It encompasses both closed captions (user-selectable, stored separately from the video stream) and open captions (burned into the image), and spans pre-produced transcription and real-time automatic speech recognition pipelines."@en ;
    rdfs:subClassOf ngm:inclusive-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:transparency ;
    vc:slug "accessibility-captioning" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:wcag-2-2 ;
    vc:supports ngm:assistive-technology-integration ;
    vc:uses ngm:natural-language-processing,
        ngm:speech-recognition .

ngm:acinq a owl:Class ;
    rdfs:label "ACINQ"@en ;
    rdfs:comment "ACINQ is a Paris-based Bitcoin technology company specialising in the development and operation of Lightning Network infrastructure, most notably the Eclair Lightning Network node implementation written in Scala and the Phoenix self-custodial mobile Bitcoin wallet. The company operates one of the largest publicly reachable Lightning Network routing nodes, providing significant liquidity and routing capacity to the network. ACINQ contributes to the BOLT (Basis of Lightning Technology) protocol specification process and has pioneered features such as trampoline routing to reduce the on-device computation required by mobile Lightning clients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:phoenix-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eclair ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:core-lightning,
        ngm:lnd ;
    vc:enables ngm:micropayment,
        ngm:non-custodial-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:eclair,
        ngm:phoenix-wallet ;
    vc:implements ngm:lightning-network,
        ngm:onion-routing ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-layer-2,
        ngm:bolt-12,
        ngm:channel-liquidity ;
    vc:requires ngm:bitcoin,
        ngm:payment-channel ;
    vc:slug "acinq" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:splicing ;
    vc:uses ngm:htlc,
        ngm:onion-routing,
        ngm:programming-language .

ngm:actor-model a owl:Class ;
    rdfs:label "Actor Model"@en ;
    rdfs:comment "The actor model is a mathematical model of concurrent computation in which the universal primitive is the actor, an independent entity that has private state and communicates only by sending asynchronous messages. In response to a message an actor can update its state, send messages to other actors and create new actors. Because actors share nothing and process one message at a time, the model avoids shared-memory data races and provides a foundation for scalable, fault-tolerant distributed systems."@en ;
    rdfs:subClassOf ngm:concurrency ;
    vc:contrastsWith ngm:shared-nothing-architecture ;
    vc:enables ngm:concurrency-model,
        ngm:distributed-computing,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:asynchronous-messaging,
        ngm:message-passing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-system,
        ngm:flow-control,
        ngm:reactive-systems ;
    vc:slug "actor-model" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:load-balancing,
        ngm:parallel-computing ;
    vc:uses ngm:event-driven-architecture,
        ngm:message-passing .

ngm:adaptive-learning-rate a skos:Concept ;
    rdfs:label "Adaptive Learning Rate"@en .

ngm:adaptive-music a owl:Class ;
    rdfs:label "Adaptive Music"@en ;
    rdfs:comment "Adaptive music is a compositional and audio-engineering approach in which a musical soundtrack modifies its structure, instrumentation, tempo, or emotional register dynamically in response to real-time contextual signals such as player actions, narrative state, or environmental parameters within interactive media. It replaces the static looping of pre-composed tracks with a system that maintains musical coherence while reflecting the moment-to-moment state of an interactive experience. The technique is foundational to game audio design and is increasingly applied in extended reality, therapeutic, and generative AI contexts."@en ;
    rdfs:subClassOf ngm:audio-system ;
    vc:enables ngm:emergent-gameplay,
        ngm:immersive-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:game-ai ;
    vc:slug "adaptive-music" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:audio-engine,
        ngm:game-engine .

ngm:adaptive-virtual-experience a owl:Class ;
    rdfs:label "Adaptive Virtual Experience"@en ;
    rdfs:comment "Adaptive Virtual Experience refers to AI-driven immersive environments that dynamically adjust content, difficulty, pacing, and presentation in real-time based on user behavior, preferences, physiological responses, and interaction patterns to deliver personalized and engaging virtual reality exp..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:sc-platform-and-environment ;
