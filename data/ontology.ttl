    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:distributed-systems,
        ngm:machine-learning ;
    vc:slug "quantum-computing" ;
    vc:sourceDomain "infrastructure" .

ngm:random-number-generation a owl:Class ;
    rdfs:label "Random Number Generation"@en ;
    rdfs:comment "The process of generating unpredictable and statistically random values for cryptographic operations, serving as a critical security primitive for key generation, nonces, and protocol initialization, distinguishing between true randomness from physical entropy sources and pseudo-randomness from d..."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:asymmetric-encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:verifiable-random-function ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "random-number-generation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-function .

ngm:rb-0022-robot-dynamics a owl:Class ;
    rdfs:label "rb 0022 robot dynamics"@en ;
    rdfs:comment "Robot dynamics is the study of the relationship between the forces and torques applied to a robot's joints and links and the resulting motion of the robot. It encompasses forward dynamics (computing accelerations from applied torques), inverse dynamics (computing required torques to achieve a desired motion), and the derivation of equations of motion via Newton-Euler or Lagrangian formulations. Dynamic models are essential for model-based controllers such as computed-torque control, optimal control, and trajectory optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0041-inertia ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0043-torque ],
        ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0051-trajectory-planning,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:newton-euler-dynamics,
        ngm:rb-0030-jacobian-matrix,
        ngm:rigid-body-dynamics ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0041-inertia,
        ngm:rb-0043-torque ;
    vc:slug "rb-0022-robot-dynamics" ;
    vc:sourceDomain "robotics" .

ngm:rb-0066-robot-sensor a owl:Class ;
    rdfs:label "rb 0066 robot sensor"@en ;
    rdfs:comment "A robot sensor is a transducer or measurement device integrated into or used by a robot system to acquire information about the robot's own state or its surrounding environment. Robot sensors span proprioceptive types — such as encoders, IMUs, and force-torque sensors — and exteroceptive types such as vision systems, LiDAR, radar, and proximity sensors. The data they provide forms the perceptual basis for control, motion planning, and safety functions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0073-imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0068-vision-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0069-lidar ],
        ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:rb-0052-collision-avoidance,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0067-force-torque-sensor,
        ngm:rb-0068-vision-system,
        ngm:rb-0069-lidar,
        ngm:rb-0072-encoder,
        ngm:rb-0073-imu ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:slug "rb-0066-robot-sensor" ;
    vc:sourceDomain "robotics" .

ngm:rb-0094-power-and-force-limiting a owl:Class ;
    rdfs:label "rb 0094 power and force limiting"@en ;
    rdfs:comment "Power and Force Limiting (PFL) is a collaborative robot safety mode defined in ISO/TS 15066 in which the robot's mechanical power, force, and momentum are continuously constrained so that any contact with a human remains below biomechanical injury thresholds. Unlike speed-and-separation monitoring, PFL allows direct physical contact by ensuring that contact forces can never exceed prescribed quasi-static and transient limits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
