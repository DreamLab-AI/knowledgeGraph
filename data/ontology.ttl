# Trust in Automation
robotics:TrustInAutomation rdf:type owl:Class ;
    rdfs:subClassOf robotics:HumanFactors ;
    rdfs:label "Trust in Automation"@en ;
    rdfs:comment "The psychological state in which a human user accepts vulnerability to an automated system's actions based on expectations that the system will perform appropriately to achieve the user's goals, despite uncertainty and the possibility of negative consequences. It represents the user's confidence in the system's reliability, competence, and integrity."@en ;
    skos:prefLabel "Trust in Automation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:trust-in-automation" ;
