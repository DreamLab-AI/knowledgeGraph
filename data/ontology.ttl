    vc:isPartOf ngm:computer-hardware ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:infrastructure,
        ngm:parallel-computing ;
    vc:requires ngm:computer-hardware ;
    vc:slug "central-processing-unit" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-processing,
        ngm:infrastructure .

ngm:circuit-breaker a owl:Class ;
    rdfs:label "Circuit Breaker"@en ;
    rdfs:comment "The circuit breaker is a fault-tolerance design pattern that monitors calls to a remote service or resource and, once failures exceed a threshold, trips open to fail fast and stop sending requests for a cooling-off period. After a timeout it allows a limited number of trial calls in a half-open state to test recovery before closing again. The pattern prevents cascading failures, protects struggling dependencies, and enables graceful degradation in distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observability ],
        ngm:fault-tolerance ;
    vc:bridgesTo ngm:service-mesh ;
    vc:dependsOn ngm:reliability-engineering ;
    vc:enables ngm:resilience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:observability ;
    vc:implements ngm:fault-tolerance,
        ngm:resilience ;
    vc:isPartOf ngm:fault-tolerance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:rate-limiting,
        ngm:service-mesh ;
    vc:requires ngm:observability ;
    vc:slug "circuit-breaker" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:microservices,
        ngm:reliability-engineering ;
    vc:uses ngm:observability .

ngm:circulating-supply a owl:Class ;
    rdfs:label "Circulating Supply"@en ;
    rdfs:comment "Circulating Supply is the quantity of a blockchain token that is publicly available and actively tradeable in the market at a given point in time—excluding tokens locked in smart contracts, held in treasury reserves, vested to team members, or burned. It serves as the operative supply figure for computing market capitalisation and price-to-earnings metrics, and changes continuously as new tokens are emitted via block rewards and locked tokens are released according to vesting schedules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:blockchain-economics,
        ngm:burning-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:fixed-supply-token,
        ngm:halving,
        ngm:market-capitalization,
        ngm:token-economics,
        ngm:tokenomics,
        ngm:total-supply ;
    vc:requires ngm:blockchain-protocol,
        ngm:emission-schedule ;
    vc:slug "circulating-supply" ;
    vc:sourceDomain "blockchain" .

ngm:climate-policy a owl:Class ;
    rdfs:label "Climate Policy"@en ;
    rdfs:comment "Climate policy is the set of government measures, regulations, and commitments intended to reduce greenhouse gas emissions and address the effects of climate change."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "climate-policy" ;
    vc:sourceDomain "governance" .

ngm:climate-risk a owl:Class ;
    rdfs:label "Climate Risk"@en ;
    rdfs:comment "Climate risk is the set of financial, operational and strategic threats that arise from climate change and the transition to a low-carbon economy. It is conventionally divided into physical risk, stemming from acute and chronic climate impacts, and transition risk, arising from policy, technology, market and reputational shifts. Organisations assess and disclose climate risk to inform capital allocation, resilience planning and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:materiality-assessment ],
        ngm:risk-management ;
    vc:bridgesTo ngm:financial-regulation,
        ngm:sustainability-reporting ;
    vc:dependsOn ngm:ghg-protocol ;
    vc:enables ngm:disclosure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:physical-risk,
        ngm:transition-risk ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-accounting,
        ngm:climate-change,
        ngm:esg,
        ngm:existential-risk ;
    vc:requires ngm:climate-scenario-analysis,
        ngm:materiality-assessment ;
    vc:slug "climate-risk" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:issb,
        ngm:tcfd ;
    vc:supports ngm:corporate-governance,
        ngm:sustainable-finance .

ngm:cloud-native-computing-foundation a owl:Class ;
    rdfs:label "Cloud Native Computing Foundation"@en ;
    rdfs:comment "The Cloud Native Computing Foundation (CNCF) is a vendor-neutral, open-source foundation hosted by the Linux Foundation that stewards critical cloud-native projects such as Kubernetes, Prometheus and Envoy. It defines and promotes the cloud-native computing model based on containers, microservices and declarative orchestration. The CNCF maintains a graduated project lifecycle (sandbox, incubating, graduated) and coordinates the wider ecosystem through events, certification programmes and a technical oversight committee."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kubernetes ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observability ],
        ngm:linux-foundation ;
    vc:bridgesTo ngm:standards-organization ;
    vc:contrastsWith ngm:standards-body ;
    vc:enables ngm:cloud-computing,
        ngm:devops ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:kubernetes,
        ngm:observability ;
    vc:isPartOf ngm:linux-foundation,
        ngm:open-source ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-platform,
        ngm:observability ;
    vc:slug "cloud-native-computing-foundation" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:cloud-native-applications,
        ngm:microservices,
        ngm:service-mesh ;
    vc:uses ngm:kubernetes .

ngm:code-execution a owl:Class ;
    rdfs:label "Code Execution"@en ;
    rdfs:comment "Code execution, in the context of AI agents, is the capability whereby a model generates source code and runs it in a sandboxed interpreter or runtime, then incorporates the results into its reasoning. It transforms a language model from a text generator into a tool-using agent that can compute, manipulate data, call APIs, and verify outputs programmatically. It matters because executable tool use grounds agent behaviour in deterministic computation and extends capabilities beyond what next-token prediction alone can achieve."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:cli-multi-agent-systems ;
    vc:slug "code-execution" ;
    vc:sourceDomain "ai" .

ngm:compound a owl:Class ;
    rdfs:label "Compound"@en ;
    rdfs:comment "Compound is an algorithmic, autonomous interest-rate protocol built on Ethereum that enables users to supply crypto assets to liquidity pools and earn continuously accruing interest, or borrow assets against over-collateralised positions at algorithmically determined rates. Interest rates adjust dynamically based on the utilisation ratio of each asset pool, eliminating the need for bilateral loan negotiation or centralised intermediaries. Supplied assets are represented as cTokens — ERC-20 tokens whose exchange rate appreciates with every block as interest accrues — which can themselves be used as collateral or freely traded. Governance of protocol parameters is conducted on-chain through the COMP token and the Compound Governor Bravo smart-contract system, making it one of the earliest fully decentralised autonomous lending protocols in the DeFi ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compound-governor-bravo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:over-collateralisation ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:mechanism-design ;
    vc:contrastsWith ngm:aave,
        ngm:maker-dao,
        ngm:uniswap ;
    vc:dependsOn ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:price-oracle ;
    vc:enables ngm:collateralised-borrowing,
        ngm:digital-asset-lending,
        ngm:liquidity-mining,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compound-governor-bravo,
        ngm:interest-rate-model ;
    vc:isPartOf ngm:decentralised-finance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:total-value-locked ;
    vc:requires ngm:liquidity-pool,
        ngm:oracle,
        ngm:over-collateralisation ;
    vc:slug "compound" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-20,
        ngm:ethereum,
        ngm:governance-token,
        ngm:smart-contracts .

ngm:computational-biology a owl:Class ;
    rdfs:label "Computational Biology"@en ;
    rdfs:comment "Computational biology is the application of computational methods, mathematical modelling, statistical inference, and data analysis to understand biological systems and processes at every scale of organisation, from individual molecules and cells through tissues, organisms, populations, and ecosystems. It develops algorithms and models to interpret molecular, cellular, and organismal data, spanning sequence analysis, structural prediction, systems modelling, and simulation. The discipline increasingly relies on machine learning and deep learning to extract patterns from large and complex biological datasets, and is the parent domain of bioinformatics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:molecular-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:big-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bioinformatics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        ngm:data-science,
        ngm:scientific-computing ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning,
        ngm:scientific-computing ;
    vc:enables ngm:drug-discovery,
        ngm:precision-medicine,
        ngm:synthetic-biology ;
