ngm:sparse-representation a owl:Class ;
    rdfs:comment "A sparse representation expresses a signal or data point as a linear combination of a small number of basis elements drawn from a larger, often overcomplete dictionary, with most coefficients zero. Sparsity yields compact, interpretable and noise-robust encodings, and underpins compressed sensing, dictionary learning and feature selection. It contrasts with dense distributed representations such as neural embeddings, and is recovered using L1 regularisation or greedy pursuit algorithms."@en ;
    rdfs:label "Sparse Representation"@en ;
    rdfs:subClassOf ngm:representation-learning ;
