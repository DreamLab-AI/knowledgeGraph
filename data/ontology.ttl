ngm:lightning-labs a owl:Class ;
    rdfs:label "Lightning Labs"@en ;
    rdfs:comment "Lightning Labs is a San Francisco-based technology company, founded in 2016 by Elizabeth Stark and Olaoluwa Osuntokun, that builds open-source software and commercial infrastructure for the Bitcoin Lightning Network. The company is the primary maintainer of lnd (Lightning Network Daemon), the most widely deployed Lightning Network implementation, and develops a suite of complementary tools including Loop, Pool, Faraday, and Taproot Assets. Lightning Labs contributes to the BOLT (Basis of Lightning Technology) specification process and advances Bitcoin Layer 2 scalability by enabling high-throughput, low-latency micropayments routed through a network of bidirectional payment channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:taproot-assets ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lnd ],
        ngm:blockchain-infrastructure ;
    vc:bridgesTo ngm:internet-of-things,
        ngm:machine-payments ;
    vc:contrastsWith ngm:blockstream,
        ngm:spiral ;
    vc:enables ngm:micropayment,
        ngm:payment-channel,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lightning-node-connect,
        ngm:lnd,
        ngm:loop,
        ngm:taproot-assets ;
    vc:implements ngm:bolt-specification,
        ngm:lightning-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-script,
        ngm:c-lightning,
        ngm:eclair ;
    vc:requires ngm:bitcoin,
        ngm:bitcoin-proof-of-work-protocol ;
    vc:slug "lightning-labs" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:layer-2-scaling ;
    vc:uses ngm:hashed-timelock-contract,
        ngm:musig2,
        ngm:taproot .

