        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serverless-architecture ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:artificial-intelligence-operations,
        ngm:edge-computing ;
    vc:contrastsWith ngm:legacy-application,
        ngm:monolithic-architecture ;
    vc:dependsOn ngm:service-discovery,
