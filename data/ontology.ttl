ngm:preimage a owl:Class ;
    rdfs:comment "A preimage is an input value that, when passed through a cryptographic hash function, produces a specified output digest. Preimage resistance, the computational infeasibility of finding such an input given only the digest, is a core security property required of cryptographic hash functions. In protocols such as hash time-locked contracts, revealing the preimage of a previously published hash is used as cryptographic proof that a condition has been satisfied, enabling trustless conditional payments."@en ;
    rdfs:label "Preimage"@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    rdfs:subClassOf _:r16748 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "preimage" ;
    vc:sourceDomain "blockchain" .
ngm:preimage-resistance a owl:Class ;
    rdfs:comment "Preimage Resistance is a security property of a cryptographic hash function requiring that, given a hash output h, it is computationally infeasible to find any input m such that H(m) = h. This one-way property is foundational for password hashing, proof-of-work puzzles, and blockchain address derivation, ensuring that knowledge of a public address does not reveal the corresponding private key."@en ;
    rdfs:label "Preimage Resistance"@en ;
    rdfs:subClassOf ngm:blockchain-entity ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:cryptographic-security ;
    vc:enables ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-hash-function ;
    vc:isPartOf ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
