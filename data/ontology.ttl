ngm:outlier-detection a owl:Class ;
    rdfs:comment "The identification of observations that deviate so markedly from the rest of a dataset as to arouse suspicion that they were generated by a different mechanism — via statistical tests, distance and density measures, or learned models; a mature discipline spanning Grubbs' test and the IQR rule through Local Outlier Factor and Isolation Forest, applied both as a data-preprocessing step to protect downstream models and as an analysis goal in itself, since an outlier may be an error to remove or a discovery to investigate."@en ;
    rdfs:label "Outlier Detection"@en ;
    rdfs:subClassOf ngm:anomaly-detection ;
