        ngm:network-protocol ;
    vc:enables ngm:condition-monitoring,
        ngm:digital-twin,
        ngm:industrial-automation,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:edge-gateway,
        ngm:programmable-logic-controller,
        ngm:sensor ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:industry-4-0 ;
    vc:requires ngm:cybersecurity,
        ngm:operational-technology,
        ngm:scada ;
    vc:slug "industrial-io-t" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-62443,
        ngm:iec-62541 ;
    vc:uses ngm:edge-computing,
