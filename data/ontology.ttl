ngm:shared-knowledge-base a owl:Class ;
    rdfs:label "Shared Knowledge Base"@en ;
    rdfs:comment "A collaborative knowledge repository enabling multiple agents or users to exchange, integrate, and query structured information using semantic web technologies, providing a common understanding of domain concepts through ontologies and linked data standards."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:knowledge-management-system ;
    vc:enables ngm:collaborative-systems-modality-knowledge-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "shared-knowledge-base" ;
    vc:sourceDomain "spatial-computing" .

ngm:shared-virtual-space a owl:Class ;
    rdfs:label "Shared Virtual Space"@en ;
    rdfs:comment "A Shared Virtual Space is a persistent, synchronised three-dimensional environment that multiple remote participants inhabit simultaneously through their avatars or representations. It provides a common spatial context for collaboration, enabling participants to co-locate, manipulate shared artefacts, and engage in spatial communication as if physically together. Such spaces underpin immersive remote collaboration by combining real-time synchronisation, access control, and spatial audio to create a convincing sense of co-presence."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:immersive-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:avatar-embodiment,
        ngm:virtual-reality-telepresence ;
    vc:slug "shared-virtual-space" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:side-channel-attack a owl:Class ;
    rdfs:label "Side-Channel Attack"@en ;
    rdfs:comment "A side-channel attack recovers secret information by observing physical or behavioural artefacts of a cryptographic implementation rather than breaking its underlying mathematics. Exploitable channels include timing variation, power consumption, electromagnetic emissions, cache access patterns, and acoustic emanations. It is a critical implementation-level threat that motivates constant-time code and masking countermeasures."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:hash-function ;
    vc:slug "side-channel-attack" ;
    vc:sourceDomain "security" .

ngm:siem a owl:Class ;
    rdfs:label "SIEM"@en ;
    rdfs:comment "SIEM (Security Information and Event Management) is a platform that aggregates, normalises, and correlates log and event data from across an organisation's IT estate to detect threats and support compliance. It combines real-time alerting, anomaly detection, and historical search with dashboards and audit reporting. It is a foundational tool of security operations centres and regulatory compliance programmes."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:cyber-security-and-cryptography ;
    vc:slug "siem" ;
    vc:sourceDomain "security" .

