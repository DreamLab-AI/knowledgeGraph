ngm:privacy-disclosure a owl:Class ;
    rdfs:label "Privacy Disclosure"@en ;
    rdfs:comment "The formal process by which platforms communicate to users what personal data is collected, how it is used, who it is shared with, and what rights users hold over it. In spatial computing and metaverse contexts, privacy disclosure must address novel data types including biometric signals, eye tracking, motion data, and behavioural analytics gathered in immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:privacy-framework ;
    vc:requires ngm:consent-management,
        ngm:data-protection ;
    vc:slug "privacy-disclosure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accountability .

