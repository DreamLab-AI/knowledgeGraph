ngm:purchasing-power a owl:Class ;
    rdfs:label "Purchasing Power"@en ;
    rdfs:comment "Purchasing power is the quantity of goods and services that a unit of currency can buy at a given point in time. It declines as prices rise, so it is inversely related to inflation and is commonly tracked through price indices such as the consumer price index. Real purchasing power, adjusted for price changes, is central to comparing incomes, wages and asset values across time and between economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:money ],
        ngm:finance ;
    vc:bridgesTo ngm:central-bank ;
    vc:contrastsWith ngm:inflation ;
    vc:dependsOn ngm:inflation,
        ngm:monetary-policy ;
    vc:hasMaturity ngmi:maturity-established ;
