            owl:someValuesFrom ngm:data-stewardship ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-lineage ],
        ngm:data-governance ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:security ;
    vc:contrastsWith ngm:data-anarchy ;
    vc:enables ngm:compliance-monitoring,
