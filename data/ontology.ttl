    rdfs:label "Holographic Training"@en .
ngm:holography a owl:Class ;
    rdfs:comment "A technique for recording and reconstructing the full wavefront of light, including both amplitude and phase, to reproduce three-dimensional images. It records the interference pattern between a reference beam and light scattered from an object."@en ;
    rdfs:label "Holography"@en ;
