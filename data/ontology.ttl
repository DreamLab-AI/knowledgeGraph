ngm:intrusion-detection a owl:Class ;
    rdfs:comment "The security discipline of monitoring networks, hosts, and applications to identify unauthorised access, policy violations, and malicious activity in progress. Intrusion detection systems (IDS) combine signature matching against known attack patterns with anomaly detection over baselines of normal behaviour, raising alerts that feed incident response; inline variants (IPS) additionally block detected traffic, trading detection breadth against false-positive risk."@en ;
    rdfs:label "Intrusion Detection"@en ;
    rdfs:subClassOf ngm:security-monitoring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:information-security ;
