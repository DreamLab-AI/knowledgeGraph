        ngm:cpu,
        ngm:gpu-resources,
        ngm:memory-bandwidth,
        ngm:network-bandwidth ;
    vc:isPartOf ngm:cloud-computing,
        ngm:data-centre ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:resource-allocation ;
    vc:requires ngm:cooling-system,
        ngm:power-infrastructure ;
    vc:slug "compute-resources" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:containerisation,
        ngm:workload-scheduling .

ngm:cross-attention a owl:Class ;
    rdfs:label "Cross Attention"@en ;
    rdfs:comment "An attention mechanism where queries come from one sequence whilst keys and values come from a different sequence, enabling information flow between the encoder and decoder in sequence-to-sequence models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-key-value ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-head-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scaled-dot-product-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-weight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:softmax-function ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:self-attention ;
    vc:dependsOn ngm:embedding,
        ngm:neural-network ;
    vc:enables ngm:image-captioning,
        ngm:machine-translation,
