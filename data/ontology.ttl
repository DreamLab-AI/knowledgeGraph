ngm:procedural-generation a owl:Class ;
    rdfs:label "Procedural Generation"@en ;
    rdfs:comment "Procedural Generation is the algorithmic creation of digital content — including terrain, geometry, textures, vegetation, buildings, soundscapes, quests, and narrative elements — using mathematical functions, noise algorithms, grammars, and rule-based systems rather than entirely manual authoring. It enables scalable world-building by deriving arbitrarily large, varied outputs from compact parametric seeds, making it foundational to games, simulation, virtual environments, and generative design workflows. Modern procedural generation incorporates machine-learning-guided heuristics alongside classical stochastic sampling, bridging traditional algorithmic design with contemporary AI-driven content synthesis. The technique trades artist-authoring effort for computational cost while preserving statistical variety and stylistic coherence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:generative-ai,
        ngm:latent-diffusion-model,
        ngm:neural-style-transfer ;
    vc:contrastsWith ngm:hand-crafted-level-design,
        ngm:manual-content-authoring ;
    vc:enables ngm:infinite-world,
        ngm:level-design,
        ngm:procedural-terrain,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:l-system,
        ngm:noise-function,
        ngm:voronoi-diagram,
        ngm:wave-function-collapse ;
    vc:implements ngm:parametric-design,
        ngm:stochastic-modelling ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-content-creation,
        ngm:computational-creativity,
        ngm:generative-design,
        ngm:metaverse-content-pipeline ;
    vc:requires ngm:game-engine,
        ngm:rendering-pipeline ;
    vc:slug "procedural-generation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:open-world-game,
        ngm:simulation,
        ngm:virtual-world ;
    vc:uses ngm:3-d-content-generation,
        ngm:noise-function-library,
        ngm:random-seed,
        ngm:spatial-indexing .

ngm:robot-kinematics a owl:Class ;
    rdfs:label "Robot Kinematics"@en ;
    rdfs:comment "Robot Kinematics is the mathematical study of the geometry of robot motion—comprising forward kinematics (mapping joint parameters to end-effector pose) and inverse kinematics (computing joint configurations that achieve a desired pose)—without regard to the forces or torques that produce that motion. It is foundational to robot programming, trajectory planning, and the design of manipulation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:contrastsWith ngm:robot-dynamics ;
    vc:enables ngm:end-effector-control,
        ngm:motion-planning,
        ngm:robot-programming,
        ngm:sensor-fusion,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:denavit-hartenberg-convention,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:jacobian-matrix ;
    vc:isPartOf ngm:robot-dynamics,
        ngm:robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot,
        ngm:industrial-manipulator,
        ngm:service-robot,
        ngm:soft-robotics,
        ngm:surgical-robot ;
    vc:requires ngm:coordinate-frames,
        ngm:degrees-of-freedom,
        ngm:transformation-matrix ;
    vc:slug "robot-kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-8373 ;
    vc:uses ngm:linear-algebra,
        ngm:quaternion-representation .

ngm:smart-contract-platform a owl:Class ;
    rdfs:label "Smart Contract Platform"@en ;
    rdfs:comment "A Smart Contract Platform is a blockchain-based infrastructure layer that provides a deterministic execution environment for self-executing programmable agreements, enabling decentralised application (dApp) development through virtual machine runtimes, developer toolchains, consensus-enforced state transitions, and economic incentive mechanisms such as gas metering. These platforms extend base-layer blockchains with Turing-complete or domain-specific scripting capabilities, allowing arbitrary business logic to be encoded and trustlessly enforced on a shared public ledger. Prominent examples include Ethereum and its EVM-compatible derivatives, Solana with its Sealevel parallel runtime, Cardano with its Plutus/eUTXO model, and Polkadot with its ink! WebAssembly runtime. Each platform makes distinct design trade-offs across the performance-security-decentralisation trilemma and imposes its own programming model, fee structure, and upgrade governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:multi-party-computation,
        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:centralised-application-server,
        ngm:traditional-contract ;
    vc:dependsOn ngm:merkle-tree,
        ngm:peer-to-peer-network,
        ngm:public-key-cryptography ;
    vc:enables ngm:dao,
        ngm:decentralised-application,
        ngm:decentralized-finance-de-fi,
        ngm:non-fungible-token,
        ngm:token-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:developer-toolchain,
        ngm:gas-metering,
        ngm:smart-contract,
        ngm:virtual-machine ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:formal-verification,
        ngm:oracle-network,
        ngm:tokenomics ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash-function,
        ngm:distributed-ledger ;
    vc:slug "smart-contract-platform" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:account-abstraction,
        ngm:layer-2-scaling,
        ngm:zero-knowledge-proof .

ngm:software-testing a owl:Class ;
    rdfs:label "Software Testing"@en ;
    rdfs:comment "Software Testing is the systematic discipline of evaluating software systems and components by executing them under controlled conditions, observing emergent behaviour, and verifying conformance to specified requirements, design intent, and quality attributes. It encompasses a hierarchy of test granularity — from unit and integration tests that validate individual components to system, end-to-end, and acceptance tests that assess the complete product — as well as specialised dimensions such as performance, security, accessibility, regression, and exploratory testing. Testing is an integral quality assurance mechanism embedded throughout the software development lifecycle, supporting early defect detection, risk mitigation, and continuous delivery. Alongside static analysis and formal verification, it constitutes the primary empirical evidence base for software correctness and reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:integration-testing ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:ai-testing,
        ngm:digital-twin,
        ngm:simulation ;
    vc:contrastsWith ngm:formal-verification,
        ngm:static-analysis ;
    vc:dependsOn ngm:requirements-engineering,
        ngm:version-control ;
    vc:enables ngm:continuous-delivery,
        ngm:defect-detection,
        ngm:software-reliability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:acceptance-testing,
        ngm:integration-testing,
        ngm:performance-testing,
        ngm:regression-testing,
        ngm:system-testing,
        ngm:unit-testing ;
    vc:isPartOf ngm:continuous-integration,
        ngm:software-development-lifecycle ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:agile-development,
        ngm:devops ;
    vc:requires ngm:test-automation,
        ngm:test-data-management ;
    vc:slug "software-testing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-829,
        ngm:iso-iec-29119 ;
    vc:supports ngm:robustness,
        ngm:safety,
        ngm:software-security ;
    vc:uses ngm:code-coverage,
        ngm:mock-objects,
        ngm:test-driven-development .

ngm:spatial-mapping a owl:Class ;
    rdfs:label "Spatial Mapping"@en ;
    rdfs:comment "The process of constructing and continuously updating three-dimensional representations of physical environments using sensor data—including depth cameras, LiDAR, and IMU—enabling AR/VR systems to understand surroundings for occlusion, collision, content placement, and navigation. Core algorithms include SLAM variants that fuse visual features with inertial measurements to produce dense mesh or voxel representations in real time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loop-closure-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-twin ;
    vc:contrastsWith ngm:gps-positioning ;
    vc:dependsOn ngm:odometry,
        ngm:point-cloud ;
    vc:enables ngm:augmented-reality,
        ngm:indoor-navigation,
        ngm:mixed-reality,
        ngm:occlusion,
        ngm:spatial-anchor ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:loop-closure-detection,
        ngm:semantic-map,
        ngm:surface-mesh,
        ngm:voxel-grid ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-technology,
        ngm:scene-understanding,
        ngm:spatial-computing ;
    vc:requires ngm:real-time-processing,
        ngm:sensor-fusion ;
    vc:slug "spatial-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision-system,
        ngm:depth-camera,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:neural-radiance-field,
        ngm:photogrammetry,
        ngm:slam .

ngm:user-interface a owl:Class ;
    rdfs:label "User Interface"@en ;
    rdfs:comment "A User Interface (UI) is the aggregate of visual, auditory, tactile, and interactive components through which a human perceives and controls a software system, forming the boundary between human cognition and computational logic. UIs span a spectrum from two-dimensional graphical desktop and web environments to three-dimensional spatial interfaces rendered in augmented and virtual reality, encompassing gesture, voice, gaze, and haptic modalities. Effective UI design integrates human-computer interaction principles — affordance, feedback, constraints, and error prevention — with visual design, accessibility requirements, and rendering performance budgets. In complex sociotechnical systems, the UI layer mediates trust, cognitive load, and task efficiency, making it a critical determinant of system adoption and usability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gesture-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interaction-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-driven-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:conversational-ai,
        ngm:extended-reality ;
    vc:contrastsWith ngm:application-programming-interface,
        ngm:command-line-interface ;
    vc:dependsOn ngm:display-technology,
        ngm:input-device,
        ngm:operating-system ;
    vc:enables ngm:accessibility,
        ngm:natural-language-interface,
        ngm:spatial-audio,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:3-d-user-interface,
        ngm:gesture-recognition,
        ngm:graphical-user-interface,
        ngm:haptic-feedback,
        ngm:voice-user-interface ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:software-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cognitive-load,
        ngm:mental-model ;
    vc:requires ngm:event-driven-architecture,
        ngm:interaction-design,
        ngm:rendering-pipeline ;
    vc:slug "user-interface" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:w3c-standards,
        ngm:wcag ;
    vc:supports ngm:localisation,
        ngm:multimodal-interaction ;
    vc:uses ngm:design-system,
        ngm:widget-toolkit .

ngm:voting-mechanism a owl:Class ;
    rdfs:label "Voting Mechanism"@en ;
    rdfs:comment "A voting mechanism is a formalised procedure by which participants in a collective system — such as token holders in a decentralised protocol, members of a cooperative, or delegates in a representative body — express preferences or binding decisions on resource allocation, parameter changes, protocol upgrades, or dispute resolution. The design of a voting mechanism encodes trade-offs between participation breadth, sybil resistance, plutocracy risk, voter apathy, and decisional legitimacy; canonical variants include token-weighted voting, quadratic voting, conviction voting, ranked-choice voting, and delegated liquid democracy. The chosen mechanism directly shapes the security, fairness, and perceived legitimacy of governance outcomes in both on-chain and off-chain contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-democracy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:on-chain-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conviction-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:plutocratic-governance,
        ngm:proof-of-work ;
    vc:enables ngm:dao-governance,
        ngm:decentralised-decision-making,
        ngm:on-chain-governance,
        ngm:protocol-upgrade ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conviction-voting,
        ngm:liquid-democracy,
        ngm:off-chain-voting,
        ngm:on-chain-voting,
        ngm:quadratic-voting,
        ngm:token-weighted-voting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:game-theory,
        ngm:governance-attack,
        ngm:mechanism-design,
        ngm:social-choice-theory,
        ngm:treasury-management ;
    vc:requires ngm:governance-token,
        ngm:quorum,
        ngm:sybil-resistance ;
    vc:slug "voting-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:multisig,
        ngm:smart-contract,
        ngm:snapshot-voting,
        ngm:timelock .

ngm:block a owl:Class ;
    rdfs:label "Block"@en ;
    rdfs:comment "The fundamental unit of a blockchain: a cryptographically linked, immutable data container that batches a set of transactions together with a block header containing the Merkle root of those transactions, a timestamp, the previous block's hash, and consensus-specific fields such as a nonce or validator signature. Sequential blocks form the chain that provides an append-only audit trail."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coinbase-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        ngm:distributed-data-structure ;
    vc:bridgesTo ngm:data-integrity,
        ngm:distributed-ledger-technology ;
    vc:contrastsWith ngm:orphan-block,
        ngm:uncle-block ;
    vc:dependsOn ngm:peer-to-peer-network ;
    vc:enables ngm:finality,
        ngm:immutability,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:blockchain-transaction,
        ngm:coinbase-transaction,
        ngm:merkle-root,
        ngm:nonce,
        ngm:timestamp ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-ledger ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:block-reward,
        ngm:block-size,
        ngm:block-time,
        ngm:fork,
        ngm:genesis-block ;
    vc:requires ngm:consensus-mechanism,
        ngm:digital-signature ;
    vc:slug "block" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:merkle-tree .

