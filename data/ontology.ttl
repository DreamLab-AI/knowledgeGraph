    vc:sourceDomain "infrastructure" .

ngm:knowledge-graph-style-guide a owl:Class ;
    rdfs:label "Knowledge Graph Style Guide"@en ;
    rdfs:comment "A Style Guide is a normative document specifying authoring conventions — voice, tone, markup syntax, citation format, and structural patterns — for consistent content creation within a knowledge graph or publication system. In the NarrativeGoldmine context it captures Logseq markdown conventions, UK English preferences, and the analytical-conversational register used throughout the graph."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
