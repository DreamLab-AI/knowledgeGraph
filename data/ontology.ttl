ngm:neural-3-d-generation a owl:Class ;
    rdfs:label "Neural 3D Generation"@en ;
    rdfs:comment "AI-powered creation of three-dimensional geometric models, volumetric representations, and 4D dynamic scenes using neural networks and machine learning techniques, including generative models, neural radiance fields, gaussian splatting, and diffusion-based 3D synthesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-parameters ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:automated-3-d-modeling,
        ngm:digital-twin-generation,
        ngm:rapid-prototyping,
        ngm:virtual-environment-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-representation,
        ngm:generative-model,
        ngm:neural-network,
        ngm:rendering-engine,
        ngm:training-pipeline ;
    vc:implements ngm:diffusion-model,
        ngm:gan,
        ngm:gaussian-splatting,
        ngm:neural-radiance-field,
        ngm:vae ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-asset-dataset,
        ngm:camera-parameters,
        ngm:gpu-compute,
        ngm:training-data ;
    vc:slug "neural-3-d-generation" ;
    vc:sourceDomain "artificial-intelligence" .

