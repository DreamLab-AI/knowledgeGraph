    vc:sourceDomain "security" .
ngm:user-education a owl:Class ;
    rdfs:comment "Structured programmes, tutorials, and onboarding materials that build user competencies in operating spatial computing platforms, XR devices, and metaverse applications, including safety guidance, digital literacy, and skill development delivered through interactive or immersive pedagogic methods."@en ;
    rdfs:label "User Education"@en ;
