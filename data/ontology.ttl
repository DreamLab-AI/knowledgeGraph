    vc:slug "enhanced-due-diligence" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:aml,
        ngm:kyc ;
    vc:uses ngm:identity-verification,
        ngm:transaction-monitoring .

ngm:enterprise-integration a owl:Class ;
    rdfs:label "Enterprise Integration"@en ;
    rdfs:comment "Enterprise integration is the discipline of connecting an organisation's disparate applications, data stores and processes so they operate as a coherent whole, exchanging information and coordinating workflows across system and organisational boundaries. It employs patterns such as messaging, APIs, service buses and event-driven architectures to overcome heterogeneity in technology, format and ownership. It underpins enterprise architecture, automation and end-to-end business processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:dependsOn ngm:api-gateway,
