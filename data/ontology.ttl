        ngm:planning,
        ngm:react-prompting ;
    vc:requires ngm:function-calling,
        ngm:json-schema,
        ngm:orchestration-layer,
        ngm:tool-schema ;
    vc:slug "tool-use" ;
    vc:sourceDomain "artificial-intelligence" ;
