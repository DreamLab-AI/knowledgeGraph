        ngm:compliance-framework,
        ngm:kyc ;
    vc:slug "fca" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fatf,
        ngm:financial-stability-board,
        ngm:iosco ;
    vc:supports ngm:anti-money-laundering,
        ngm:consumer-protection,
        ngm:financial-stability,
        ngm:market-integrity .

ngm:feature-importance a owl:Class ;
    rdfs:label "Feature Importance"@en ;
    rdfs:comment "Quantitative measures indicating the relative contribution or influence of individual input features on a machine learning model's predictions, enabling identification of the most critical variables driving model outputs. Methods include permutation importance, SHAP (SHapley Additive exPlanations) values, and tree-based Gini impurity scores, each providing global or local views of feature influence that support model debugging, data selection, and regulatory explainability requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-attribution ],
        ngm:explainability ;
    vc:bridgesTo ngm:data-governance ;
    vc:contrastsWith ngm:causal-inference,
        ngm:local-explanation ;
    vc:enables ngm:bias-detection,
        ngm:feature-selection,
        ngm:global-explanation,
        ngm:model-debugging,
        ngm:model-interpretability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:feature-attribution,
        ngm:partial-dependence-plot,
        ngm:permutation-importance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-evaluation,
        ngm:overfitting ;
    vc:requires ngm:trained-model,
        ngm:validation-dataset ;
    vc:slug "feature-importance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:regulatory-compliance,
        ngm:responsible-ai,
        ngm:transparency ;
    vc:uses ngm:dimensionality-reduction,
        ngm:gradient-boosting,
        ngm:machine-learning-discipline,
        ngm:random-forest,
        ngm:shapley-values .

ngm:financial-instruments a owl:Class ;
    rdfs:label "Financial Instruments"@en ;
    rdfs:comment "Financial instruments are contractual agreements or documents that convey a monetary claim, obligation, or ownership right between parties, encompassing equities, debt securities, derivatives, currencies, and commodities. In contemporary digital finance they extend to programmable on-chain instruments encoded as smart contracts, including decentralised lending protocols, synthetic assets, and tokenised representations of traditional financial claims. Their valuation, transferability, and settlement properties are governed by both legal frameworks and, increasingly, algorithmic rules embedded in blockchain protocols. International Accounting Standard 32 defines them as any contract that gives rise to a financial asset of one entity and a financial liability or equity instrument of another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance,
        ngm:smart-contracts,
        ngm:tokenization ;
    vc:contrastsWith ngm:intangible-assets,
        ngm:real-assets ;
    vc:dependsOn ngm:liquidity,
        ngm:market-infrastructure,
        ngm:price-discovery ;
    vc:enables ngm:capital-formation,
        ngm:portfolio-management,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:debt-securities,
        ngm:derivatives,
        ngm:equity-securities,
        ngm:foreign-exchange,
        ngm:structured-products ;
    vc:isPartOf ngm:capital-markets,
        ngm:financial-services ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:cryptocurrency,
        ngm:monetary-policy ;
    vc:requires ngm:clearing-and-settlement,
        ngm:financial-regulation,
        ngm:smart-contracts ;
    vc:slug "financial-instruments" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:international-accounting-standards,
        ngm:securities-regulation .

ngm:fluid-simulation a owl:Class ;
    rdfs:label "Fluid Simulation"@en ;
    rdfs:comment "Fluid Simulation is the computational modelling of liquid and gas dynamics using numerical methods — notably computational fluid dynamics (CFD) and Navier-Stokes solvers — to produce physically plausible representations of water, smoke, fire, and atmospheric phenomena in real-time or offline rendering pipelines. In spatial computing and metaverse environments it contributes to environmental immersion and interactive physics, running on GPU compute shaders for performance-critical applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:embodied-ai-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:computer-graphics,
        ngm:game-engine,
        ngm:particle-system,
        ngm:physics-engine ;
    vc:slug "fluid-simulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute,
        ngm:math-library .

ngm:flux-1 a owl:Class ;
    rdfs:label "Flux.1"@en ;
    rdfs:comment "Flux.1 is a family of open-weight text-to-image generative models developed by Black Forest Labs, founded by former Stability AI researchers including Robin Rombach, the co-creator of Latent Diffusion. Released in August 2024, Flux.1 employs a hybrid architecture combining multimodal and parallel diffusion transformer (DiT) blocks, achieving state-of-the-art image quality and prompt adherence that surpasses earlier diffusion models on benchmarks such as GenEval and T2I-CompBench. The family offers three variants — Flux.1 [pro], Flux.1 [dev], and Flux.1 [schnell] — spanning commercial API, open-weights research, and fast inference use cases respectively."@en ;
    rdfs:subClassOf ngm:diffusion-model ;
    vc:contrastsWith ngm:stable-diffusion-image-model ;
    vc:dependsOn ngm:model-training ;
    vc:enables ngm:inpainting,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:image-generation,
        ngm:latent-diffusion,
        ngm:text-to-image ;
    vc:slug "flux-1" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:lo-ra-do-ra-etc,
        ngm:node-based-diffusion-pipeline-interface-workflows ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:gas-fee-market a owl:Class ;
    rdfs:label "Gas Fee Market"@en ;
    rdfs:comment "The Gas Fee Market is the economic mechanism governing blockchain transaction costs, where users bid gas fees to prioritise transaction processing. Governed by EIP-1559 on Ethereum, it separates a burned base fee from an optional priority tip, creating a market-based congestion control system essential for NFT trades, smart contract execution, and virtual asset transfers in spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract-execution ],
        ngm:blockchain-economics ;
    vc:bridgesTo ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-economics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:eip-1559,
        ngm:layer2 ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract-execution ;
    vc:slug "gas-fee-market" ;
    vc:sourceDomain "blockchain" .

ngm:gas-price a owl:Class ;
    rdfs:label "Gas Price"@en ;
    rdfs:comment "Gas Price is the amount of cryptocurrency (denominated in gwei on Ethereum) that a transaction sender is willing to pay per unit of gas consumed during execution. It serves as the primary market mechanism for prioritising transactions within a block and compensating validators or miners for computational work. Gas price interacts with the gas limit and base fee to determine total transaction cost, and is subject to dynamic adjustment under fee-market protocols such as EIP-1559."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:priority-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-limit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:blockchain,
        ngm:mempool ;
    vc:enables ngm:fee-market,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee,
        ngm:priority-fee ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:eip-1559,
        ngm:mechanism-design,
        ngm:miner,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:token-economics,
        ngm:transaction-fee ;
    vc:requires ngm:gas,
        ngm:gas-limit,
        ngm:transaction ;
    vc:slug "gas-price" ;
    vc:sourceDomain "blockchain" .

ngm:generative-design-tool a owl:Class ;
    rdfs:label "Generative Design Tool"@en ;
    rdfs:comment "AI-assisted software application that produces optimized 3D designs from functional constraints using machine learning and computational algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
