        ngm:fine-tuning,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-scale-pretrained-foundation-model,
        ngm:open-source-framework ;
    vc:requires ngm:cuda,
        ngm:gpu-compute ;
    vc:slug "py-torch" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:parameter-efficient-fine-tuning,
        ngm:transfer-learning ;
    vc:uses ngm:attention-mechanism,
        ngm:batch-processing,
        ngm:python-pytorch-deep-learning-stack .

ngm:rendering a owl:Class ;
    rdfs:label "Rendering"@en ;
    rdfs:comment "Rendering is the computational process of generating a two-dimensional image or display output from a scene description, encompassing geometry, materials, lighting, and camera parameters. Techniques range from real-time rasterisation on GPUs to offline ray tracing and neural rendering methods used in film and spatial computing applications. High-quality, low-latency rendering is critical for immersive virtual and augmented reality experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:scene-representation ;
    vc:slug "rendering" ;
    vc:sourceDomain "spatial-computing" .

ngm:rest a owl:Class ;
    rdfs:label "REST"@en ;
    rdfs:comment "REST (Representational State Transfer) is an architectural style for distributed hypermedia systems, defined by Roy Fielding, that uses stateless client-server communication over HTTP with a uniform resource-based interface, cacheable responses, and layered system constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
