# Immersive Audio System
mv:ImmersiveAudioSystem a owl:Class ;
    rdfs:subClassOf mv:AudioTechnology ;
    rdfs:label "Immersive Audio System"@en ;
    rdfs:comment "Audio technologies enabling three-dimensional soundscapes in virtual environments through spatial audio processing, binaural rendering, and head-related transfer functions (HRTF), creating realistic acoustic experiences that respond to user position and movement within VR, AR, and metaverse applications."@en ;
    skos:prefLabel "Immersive Audio System"@en ;
    dcterms:identifier "MV-9920" ;
    dcterms:subject "mv" .

mv:ImmersiveAudioSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
