ngm:iccv a owl:Class ;
    rdfs:label "ICCV"@en ;
    rdfs:comment "ICCV (International Conference on Computer Vision) is a biennial top-tier academic conference sponsored by IEEE that focuses on the full spectrum of computer vision research, from low-level image processing to high-level scene understanding and embodied intelligence. Held in odd-numbered years and alternating with CVPR in global prestige, ICCV features highly selective peer review and is associated with the Marr Prize for outstanding contributions to the field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:computer-vision ;
    vc:contrastsWith ngm:cvpr ;
    vc:enables ngm:benchmark-standard,
        ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-reconstruction,
        ngm:image-classification,
        ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cvpr,
        ngm:iclr,
        ngm:icml,
        ngm:neur-ips ;
    vc:slug "iccv" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:computer-vision,
        ngm:deep-learning,
        ngm:multimodal-ai .

ngm:image-processing a owl:Class ;
    rdfs:label "Image Processing"@en ;
    rdfs:comment "Image Processing is the computational manipulation of digital images using mathematical operations to enhance visual quality, extract information, or transform image representations for downstream analysis or display. It encompasses classical signal processing operations—filtering, convolution, histogram equalisation, morphological operations, and frequency-domain transforms—as well as learned operations implemented through convolutional neural networks and vision transformers. Image processing is a prerequisite step in computer vision pipelines, medical imaging workflows, satellite remote sensing, and industrial quality inspection systems, operating on pixel grids to produce processed images or structured outputs."@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:enables ngm:feature-extraction,
        ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:digital-signal-processing,
        ngm:image-processing-software,
