    vc:sourceDomain "finance" .

ngm:reverse-proxy a skos:Concept ;
    rdfs:label "Reverse Proxy"@en .

ngm:rfc-5280 a skos:Concept ;
    rdfs:label "Rfc 5280"@en .

ngm:risk-based-approach a owl:Class ;
    rdfs:label "Risk-Based Approach"@en ;
    rdfs:comment "A risk-based approach is a regulatory and compliance methodology that allocates scrutiny and controls in proportion to assessed risk, rather than applying uniform requirements to all cases. In anti-money-laundering and cross-border compliance it directs enhanced due diligence at higher-risk customers and transactions while streamlining low-risk ones. It improves effectiveness and efficiency by focusing limited resources where harm is most likely."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:cross-border-compliance ;
    vc:slug "risk-based-approach" ;
    vc:sourceDomain "governance" .

ngm:robot-controller a skos:Concept ;
    rdfs:label "Robot Controller"@en .

ngm:robot-hardware a owl:Class ;
    rdfs:label "Robot Hardware"@en ;
    rdfs:comment "RobotHardware is the integrated electromechanical substrate of robotic systems encompassing all physical components required for autonomous or semi-autonomous operation: compute platforms (NVIDIA Jetson Orin NX/AGX, Raspberry Pi 5, BeagleBone AI-64), real-time microcontrollers (STM32H7, Teensy 4...."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ether-cat ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-suite ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:battery-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ros-2 ],
        ngm:mobile-robot-platform,
        ngm:robo-actuation-and-control,
        ngm:robotics-platform ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-operation,
        ngm:kinematics-model,
        ngm:motion-control,
        ngm:navigation,
        ngm:proprioceptive-sensor,
        ngm:robot-perception,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:battery-management-system,
        ngm:communication-bus,
        ngm:embedded-controller,
        ngm:motor-driver,
        ngm:power-distribution-board,
        ngm:sensor-suite,
        ngm:wiring-harness ;
    vc:implements ngm:can-fd-protocol,
        ngm:dds-middleware,
        ngm:ether-cat-protocol,
        ngm:micro-ros,
        ngm:ros2-control-framework,
        ngm:urdf-hardware-description ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
