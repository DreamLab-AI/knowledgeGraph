    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:public-key,
        ngm:smart-contract .

ngm:optimiser a owl:Class ;
    rdfs:label "Optimiser"@en ;
    rdfs:comment "An Optimiser is an algorithm that adjusts model parameters during training to minimise a loss function, guiding convergence towards an optimal solution. Modern optimisers such as Adam, RMSProp, and AdaGrad extend stochastic gradient descent with adaptive learning rates, momentum accumulation, and second-moment estimates, enabling faster and more stable training of deep neural networks across diverse tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:deep-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:hyperparameter,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:gradient-descent,
        ngm:loss-function ;
    vc:slug "optimiser" ;
    vc:sourceDomain "spatial-computing" .

ngm:owl-class-hierarchy a owl:Class ;
    rdfs:label "OWL Class Hierarchy"@en ;
    rdfs:comment "The taxonomic structure of classes and subclasses defined in the Web Ontology Language (OWL) that organizes concepts into inheritance relationships, enabling automated reasoning, consistency checking, and inference of implicit knowledge in semantic web applications."@en ;
