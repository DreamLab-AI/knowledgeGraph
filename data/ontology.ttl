    vc:slug "digital-rights" ;
    vc:sourceDomain "spatial-computing" .

ngm:financial-stability a owl:Class ;
    rdfs:label "Financial Stability"@en ;
    rdfs:comment "Financial stability refers to the condition in which the financial system — comprising banks, markets, payment infrastructure, and intermediaries — can absorb shocks and continue to perform its core functions of credit intermediation, risk transfer, and payment settlement. In the context of blockchain and crypto-assets, financial stability analysis examines how the growth of crypto markets, the interconnections between crypto and traditional finance, and the failure of large participants can propagate systemic risk. Regulatory bodies such as the Financial Stability Board, BIS, and IMF monitor these dynamics and advise on macroprudential policy responses."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:dependsOn ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:stablecoin,
        ngm:systemic-risk ;
    vc:slug "financial-stability" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:anti-money-laundering .

ngm:generative-adversarial-network a owl:Class ;
    rdfs:label "Generative Adversarial Network"@en ;
    rdfs:comment "A Generative Adversarial Network (GAN) is a deep learning architecture in which a generator network and a discriminator network are trained simultaneously in an adversarial min-max game: the generator learns to produce synthetic samples indistinguishable from real data, while the discriminator learns to detect fakes. GANs underpin high-fidelity image synthesis, video generation, data augmentation, and synthetic data creation across domains including healthcare, finance, and computer vision."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:autoencoder,
        ngm:diffusion-model ;
    vc:enables ngm:image-generation,
        ngm:synthetic-data,
        ngm:synthetic-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:generative-ai ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "generative-adversarial-network" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:identity-and-access-management a owl:Class ;
    rdfs:label "Identity and Access Management"@en ;
    rdfs:comment "Identity and Access Management (IAM) is a security discipline comprising the frameworks, policies, technologies, and processes that govern how digital identities are created, authenticated, authorised, and governed throughout their lifecycle within an organisation. IAM systems enforce the principle of least privilege by ensuring that subjects—users, applications, and service accounts—can access only the resources required for their legitimate purpose. Modern IAM encompasses directory services, multi-factor authentication, role-based and attribute-based access control, privileged access management, and federated identity across organisational boundaries."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:single-sign-on ;
    vc:slug "identity-and-access-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:oauth-2-0 .

ngm:inference-engine a owl:Class ;
    rdfs:label "Inference Engine"@en ;
    rdfs:comment "An Inference Engine is a specialised software runtime optimised for executing trained machine learning models in production — transforming input data into predictions, classifications, or generated content — with primary objectives of minimising latency, maximising throughput, and efficiently utilising hardware accelerators (GPUs, TPUs, NPUs). Inference engines apply techniques including operator fusion, kernel auto-tuning, mixed-precision quantisation, and memory layout optimisation to close the performance gap between a training-time model representation and optimal hardware utilisation, and they typically accept models in portable interchange formats such as ONNX or TensorRT engine plans to decouple model architecture from the serving runtime."@en ;
    rdfs:subClassOf ngm:inference ;
    vc:enables ngm:ai-deployment,
        ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpu-computing,
        ngm:hardware-acceleration,
        ngm:inference-hardware,
        ngm:latency,
        ngm:tensor-processing-unit ;
    vc:slug "inference-engine" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:mlops ;
    vc:uses ngm:machine-learning-model .

ngm:knowledge-base a owl:Class ;
    rdfs:label "Knowledge Base"@en ;
    rdfs:comment "A knowledge base is a structured, machine-readable repository of domain-specific information, factual assertions, and inference rules that software systems—including expert systems, question answering engines, and AI agents—can query, reason over, and update. Knowledge bases range from relational tables and document stores to formal ontologies expressed in OWL/RDF and property graphs, each offering different trade-offs between expressiveness, scalability, and reasoning complexity. In contemporary AI architectures, knowledge bases frequently serve as the external long-term memory component in retrieval-augmented generation pipelines."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:question-answering,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:expert-systems,
        ngm:knowledge-graph ;
    vc:slug "knowledge-base" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-representation,
        ngm:ontology .

ngm:middleware a owl:Class ;
    rdfs:label "Middleware"@en ;
    rdfs:comment "Software layer that mediates between applications and underlying services or infrastructure to enable communication, resource access, and interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        ngm:digital-infrastructure,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:distributed-communication,
        ngm:interoperability,
        ngm:resource-abstraction,
        ngm:service-integration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway,
        ngm:communication-protocol,
        ngm:message-queue,
        ngm:service-registry ;
    vc:isPartOf ngm:distributed-system,
        ngm:software-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compute-infrastructure,
        ngm:network-infrastructure,
        ngm:operating-system ;
    vc:slug "middleware" ;
    vc:sourceDomain "infrastructure" .

ngm:network-layer a owl:Class ;
    rdfs:label "Network Layer"@en ;
    rdfs:comment "Architectural layer governing communication protocols, packet routing, congestion control, and network topology. Provides reliable end-to-end message delivery, bandwidth management, and quality-of-service guarantees for distributed narrative systems across heterogeneous networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:congestion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:protocol-stack ],
        ngm:architectural-layer,
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:bandwidth-allocation,
        ngm:latency-management,
        ngm:message-delivery,
        ngm:network-resilience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:congestion-control,
        ngm:network-topology,
        ngm:protocol-stack,
        ngm:qo-s-manager,
        ngm:routing-engine ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "network-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:on-chain-governance a owl:Class ;
    rdfs:label "On-chain Governance"@en ;
    rdfs:comment "On-chain governance is a blockchain coordination model in which protocol upgrade proposals, parameter changes, and treasury spending decisions are formally submitted, deliberated, voted on by token holders, and automatically enacted through the execution of smart contracts recorded on the distributed ledger. This approach makes governance decisions transparent, censorship-resistant, and auditable, since all votes and execution outcomes are immutable on-chain records. It contrasts with off-chain governance, where decisions are reached through social consensus (forums, developer meetings) and implemented by core developers with no on-chain enforcement."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:dao-governance,
        ngm:voting-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:open-zeppelin-governor,
        ngm:proposal-system ;
    vc:slug "on-chain-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract .

ngm:policy-enforcement a owl:Class ;
    rdfs:label "Policy Enforcement"@en ;
    rdfs:comment "Mechanisms, architectures, and toolchains that translate declarative security and governance rules into runtime decisions—permitting, denying, mutating, or auditing operations across compute, data, network, and AI systems."@en ;
