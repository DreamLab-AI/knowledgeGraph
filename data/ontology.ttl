    vc:slug "high-energy-consumption" ;
    vc:sourceDomain "blockchain" .

ngm:hiroshima-ai-process a owl:Class ;
    rdfs:label "Hiroshima AI Process"@en ;
    rdfs:comment "The Hiroshima AI Process is a G7-led international initiative, launched in 2023, to develop shared principles and a voluntary code of conduct for organisations developing advanced AI systems. It promotes safe, secure, and trustworthy AI through international cooperation on guardrails for foundation and generative models. The process represents a multilateral, soft-law approach to AI governance complementing national regulation."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asia-pacific-regulation ;
    vc:slug "hiroshima-ai-process" ;
    vc:sourceDomain "governance" .

ngm:hlsl a owl:Class ;
    rdfs:label "HLSL"@en ;
    rdfs:comment "HLSL (High-Level Shading Language) is Microsoft's C-like programming language for writing GPU shader programs targeting the Direct3D graphics API. It lets developers author vertex, pixel, geometry, and compute shaders that run on the programmable stages of the rendering pipeline. HLSL is a cornerstone of real-time graphics on Windows and Xbox platforms."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "hlsl" ;
    vc:sourceDomain "metaverse" .

ngm:hnsw-index a owl:Class ;
    rdfs:label "HNSW Index"@en ;
    rdfs:comment "An HNSW (Hierarchical Navigable Small World) index is a graph-based data structure for approximate nearest-neighbour search over high-dimensional vectors. It builds a multi-layer proximity graph where greedy traversal from a sparse top layer down to a dense base layer locates close vectors in logarithmic time. HNSW is the standard index backing vector databases and semantic search at scale."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:semantic-search,
        ngm:storage-infrastructure ;
    vc:slug "hnsw-index" ;
    vc:sourceDomain "data" .

ngm:holographic-consensus a owl:Class ;
    rdfs:label "Holographic Consensus"@en ;
    rdfs:comment "Holographic consensus is a DAO governance mechanism that uses a prediction market of staked tokens to surface which proposals reflect the collective will, allowing a small attentive subset to make decisions that represent the whole. Predictors stake on whether a proposal will pass, boosting promising proposals to a faster majority-vote track while filtering spam. It addresses scalability of decentralised governance without requiring every member to vote on everything."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:governance-token ;
    vc:slug "holographic-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:holographic-display a owl:Class ;
    rdfs:label "Holographic Display"@en ;
    rdfs:comment "A display technology that reconstructs the wavefront of light to present three-dimensional images viewable without special eyewear. It relies on diffraction and interference to recreate depth cues such as parallax and accommodation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:holography ],
        ngm:display-technology ;
    vc:enables ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:holography ;
    vc:slug "holographic-display" ;
    vc:sourceDomain "display-technology" .

ngm:horizontal-scalability a owl:Class ;
    rdfs:label "Horizontal Scalability"@en ;
    rdfs:comment "Horizontal scalability is the capacity of a system to increase throughput by adding more independent nodes rather than upgrading a single machine (vertical scaling). It relies on partitioning work and state so that load can be distributed across commodity servers behind a balancer. Horizontal scaling underpins cloud-native and distributed architectures because it offers near-linear, fault-tolerant growth."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:distributed-systems-domain ;
    vc:slug "horizontal-scalability" ;
    vc:sourceDomain "infrastructure" .

ngm:hot-stuff a owl:Class ;
    rdfs:label "HotStuff"@en ;
    rdfs:comment "HotStuff is a leader-based Byzantine fault-tolerant consensus protocol that achieves linear communication complexity and responsiveness through a pipelined, three-phase voting structure with threshold signatures. Its linear view-change cost and rotating leadership make it well suited to large validator sets. HotStuff influenced modern BFT systems and underpins protocols such as Libra/Diem's consensus."@en ;
    rdfs:subClassOf ngm:byzantine-fault-tolerance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:fault-tolerance ;
    vc:slug "hot-stuff" ;
    vc:sourceDomain "blockchain" .

ngm:hot-stuff-consensus a owl:Class ;
    rdfs:label "HotStuff Consensus"@en ;
    rdfs:comment "A Byzantine fault-tolerant state machine replication protocol that achieves the first simultaneous combination of linear message complexity, optimistic responsiveness, and a simple three-phase voting pipeline. HotStuff replaces PBFT's quadratic message complexity with a leader-based threshold signature aggregation scheme, enabling safe view changes with O(n) messages and forming the foundation for the DiemBFT/LibraBFT and Aptos consensus protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:raft-consensus,
        ngm:tendermint-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-algorithm,
        ngm:state-machine-replication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:sybil-resistance ;
    vc:requires ngm:distributed-system,
        ngm:fault-tolerance ;
    vc:slug "hot-stuff-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:hsbc-orion a owl:Class ;
    rdfs:label "HSBC Orion"@en ;
    rdfs:comment "HSBC Orion is HSBC's institutional tokenisation platform for issuing and managing digital bonds and other assets on a permissioned distributed ledger. It enables on-chain issuance, settlement, and custody of tokenised securities within a regulated banking framework, used for sovereign and corporate digital bond programmes. Orion exemplifies enterprise adoption of consortium blockchain for capital markets infrastructure."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consortium-blockchain,
        ngm:enterprise-token-standards ;
    vc:slug "hsbc-orion" ;
    vc:sourceDomain "blockchain" .

ngm:hugging-face-accelerate a owl:Class ;
    rdfs:label "Hugging Face Accelerate"@en ;
    rdfs:comment "Hugging Face Accelerate is an open-source Python library that lets PyTorch training code run unchanged across CPUs, single or multiple GPUs, and TPUs by abstracting device placement and distributed launch. It handles mixed precision, gradient accumulation, and sharded data/model parallelism with minimal boilerplate. Accelerate lowers the barrier to scaling deep-learning training and inference across hardware configurations."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-speed,
        ngm:fast-ai ;
    vc:slug "hugging-face-accelerate" ;
    vc:sourceDomain "ai" .

ngm:hugging-face-model-hub a owl:Class ;
    rdfs:label "Hugging Face Model Hub"@en ;
    rdfs:comment "The Hugging Face Model Hub is a public repository and platform for sharing, discovering, and versioning machine-learning models, datasets, and demo spaces. Built on Git and Git-LFS, it hosts hundreds of thousands of pretrained models with standardised model cards, metadata, and direct integration into the Transformers ecosystem. It functions as the central distribution layer for open machine-learning artefacts."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fooocus,
        ngm:safetensors ;
    vc:slug "hugging-face-model-hub" ;
    vc:sourceDomain "ai" .

ngm:human-capture-and-recognition a owl:Class ;
    rdfs:label "Human Capture & Recognition"@en ;
    rdfs:comment "Techniques for digitally acquiring and interpreting human appearance, motion, and biometric data for use in virtual and augmented environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-scanning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:facial-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-tracking ],
        ngm:reality-capture,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:3-d-visualization,
        ngm:avatar-creation,
        ngm:digital-twin-generation,
        ngm:virtual-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-scanning,
        ngm:biometric-analysis,
        ngm:facial-recognition,
        ngm:motion-tracking,
        ngm:reality-modeling ;
    vc:isPartOf ngm:reality-capture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:depth-cameras,
        ngm:machine-learning-models,
        ngm:optical-sensors ;
    vc:slug "human-capture-and-recognition" ;
    vc:sourceDomain "spatial-computing" .

ngm:human-computer-interface a owl:Class ;
    rdfs:label "Human Computer Interface"@en ;
    rdfs:comment "The set of hardware and software components through which a human user perceives, commands, and receives feedback from a computing system. In spatial computing, human computer interfaces extend beyond screens and keyboards to include gesture input, voice commands, gaze control, haptic feedback, and brain-computer interfaces, fundamentally shaping how users navigate and manipulate virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hand-tracking ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-user-interface,
        ngm:brain-computer-interfaces ;
    vc:slug "human-computer-interface" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:spatial-tracking-technology .

ngm:human-development-index a owl:Class ;
    rdfs:label "Human Development Index"@en ;
    rdfs:comment "The Human Development Index (HDI) is a composite statistic published by the United Nations Development Programme that ranks countries by aggregating life expectancy, education (mean and expected years of schooling), and gross national income per capita. It measures human wellbeing beyond purely economic output and is used to compare development levels and to track progress over time. The HDI underpins many analyses of inequality and policy effectiveness."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:global-inequality ;
    vc:slug "human-development-index" ;
    vc:sourceDomain "governance" .

ngm:human-in-the-loop-learning a owl:Class ;
    rdfs:label "Human-in-the- Loop Learning"@en ;
    rdfs:comment "A machine learning paradigm that integrates human expertise into the training process through iterative feedback, active learning queries, and collaborative validation. HITL learning combines automated model updates with human judgement for data labelling, error correction, and safety-critical decision review, and is essential in domains where ground truth is subjective or expert-dependent."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:interactive-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:human-in-the-loop ;
    vc:slug "human-in-the-loop-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning ;
    vc:uses ngm:active-learning,
        ngm:data-annotation,
        ngm:reinforcement-learning-from-human-feedback .

ngm:human-interface-device a owl:Class ;
    rdfs:label "Human Interface Device"@en ;
    rdfs:comment "Physical hardware component enabling user input or feedback in immersive systems through controllers, sensors, and actuators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:device-drivers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptics ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:haptic-feedback,
        ngm:motion-tracking,
        ngm:spatial-interaction,
        ngm:user-input ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:communication-interface,
        ngm:haptics,
        ngm:input-sensors,
        ngm:output-actuators,
        ngm:tracking-components ;
    vc:isPartOf ngm:interaction-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:calibration,
        ngm:device-drivers,
        ngm:power-management ;
    vc:slug "human-interface-device" ;
    vc:sourceDomain "spatial-computing" .

ngm:hyperlane a owl:Class ;
    rdfs:label "Hyperlane"@en ;
    rdfs:comment "Hyperlane is an interoperability protocol that allows smart contracts on different blockchains to send messages and transfer assets between chains. It supports permissionless deployment to new chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:cross-chain-bridge ;
    vc:enables ngm:blockchain-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract ;
    vc:slug "hyperlane" ;
    vc:sourceDomain "blockchain" .

ngm:iata-temperature-control-regulations a owl:Class ;
    rdfs:label "IATA Temperature Control Regulations"@en ;
    rdfs:comment "The IATA Temperature Control Regulations (TCR) are the International Air Transport Association's standards governing the handling, packaging, labelling, and documentation of temperature-sensitive air cargo such as pharmaceuticals, vaccines, and perishables. They define acceptable temperature ranges, qualified packaging, and chain-of-custody requirements to preserve product integrity throughout air transport. Compliance is mandatory for carriers and shippers operating in regulated cold-chain logistics."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring ;
    vc:slug "iata-temperature-control-regulations" ;
    vc:sourceDomain "supply-chain" .

ngm:ibc a owl:Class ;
    rdfs:label "IBC"@en ;
    rdfs:comment "Inter-Blockchain Communication is a protocol for relaying authenticated data and tokens between independent blockchains. It is the native interoperability standard of the Cosmos ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cosmos-sdk ],
        ngm:blockchain-interoperability ;
    vc:enables ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cosmos-sdk,
        ngm:merkle-tree ;
    vc:slug "ibc" ;
    vc:sourceDomain "blockchain" .

ngm:ibc-specification a owl:Class ;
    rdfs:label "IBC Specification"@en ;
    rdfs:comment "The Inter-Blockchain Communication (IBC) specification is an open protocol standard for authenticated, ordered, and reliable message passing between independent distributed ledgers. Originating in the Cosmos ecosystem, it uses light-client verification and Merkle proofs so that two chains can trustlessly relay packets such as token transfers without a trusted intermediary. IBC underpins much of the modular and cross-chain interoperability landscape."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:enables ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability ;
    vc:slug "ibc-specification" ;
    vc:sourceDomain "blockchain" .

ngm:ico-ai-guidance a owl:Class ;
    rdfs:label "ICO AI Guidance"@en ;
    rdfs:comment "The ICO AI Guidance is the body of guidance issued by the UK Information Commissioner's Office on applying data-protection law to artificial-intelligence systems. It covers lawful basis, fairness, transparency, automated decision-making, and the trade-offs between accuracy and privacy when processing personal data in AI. The guidance helps organisations demonstrate accountability and conduct data-protection impact assessments for AI deployments."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:hyper-personalisation ;
    vc:slug "ico-ai-guidance" ;
    vc:sourceDomain "governance" .

ngm:icra a owl:Class ;
    rdfs:label "ICRA"@en ;
    rdfs:comment "ICRA, the International Conference on Robotics and Automation, is an annual academic conference organised by the IEEE Robotics and Automation Society."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "icra" ;
    vc:sourceDomain "robotics" .

ngm:icvcm-framework a owl:Class ;
    rdfs:label "ICVCM Framework"@en ;
    rdfs:comment "The ICVCM Framework is the governance framework established by the Integrity Council for the Voluntary Carbon Market to set quality benchmarks for carbon credits. Centred on the Core Carbon Principles and an associated Assessment Framework, it defines criteria for additionality, permanence, robust quantification, and transparent governance. The framework aims to restore trust and comparability across voluntary carbon-credit issuers."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:icvcm-core-carbon-principles ;
    vc:slug "icvcm-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:green-blockchain-initiatives .

ngm:identifier-layer a owl:Class ;
    rdfs:label "Identifier Layer"@en ;
    rdfs:comment "The Identifier Layer is the stratum that defines and manages the names and references used to denote entities unambiguously. It sits above the data and cryptographic primitives that make identifiers durable and verifiable and below the Identity Layer that binds meaning to them. It contains naming schemes, resolution mechanisms, and uniqueness guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-layer ],
        ngm:owl-thing ;
    vc:enables ngm:custody-layer,
        ngm:identity-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-layer,
        ngm:data-layer ;
    vc:slug "identifier-layer" ;
    vc:sourceDomain "identifier" .

ngm:iec-62061 a owl:Class ;
    rdfs:label "IEC 62061"@en ;
    rdfs:comment "IEC 62061 addresses the functional safety of safety-related control systems for machinery, covering the design and integration of such systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "iec-62061" ;
    vc:sourceDomain "standards" .

ngm:iec-62443 a owl:Class ;
    rdfs:label "IEC 62443"@en ;
    rdfs:comment "IEC 62443 is a series of standards addressing cybersecurity for industrial automation and control systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "iec-62443" ;
    vc:sourceDomain "standards" .

ngm:ieee-802-x a owl:Class ;
    rdfs:label "IEEE 802-X"@en ;
    rdfs:comment "IEEE 802 is the family of IEEE standards governing local area, metropolitan area, and personal area networks, defining the physical and data-link layers for technologies such as Ethernet (802.3), Wi-Fi (802.11), and low-rate wireless PANs (802.15.4). The suite standardises framing, medium access control, and addressing so that heterogeneous equipment can interoperate. It forms the backbone of most wired and wireless networking in use today."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ieee-802-15-4 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ieee-802-15-4 ;
    vc:slug "ieee-802-x" ;
    vc:sourceDomain "infrastructure" .

ngm:ieee-ras a owl:Class ;
    rdfs:label "IEEE RAS"@en ;
    rdfs:comment "The IEEE Robotics and Automation Society (RAS) is the professional society within IEEE dedicated to advancing robotics and automation through publications, conferences, and the development of technical standards. It sponsors standards such as IEEE 1872 (ontologies for robotics and automation) and maintains working groups covering terminology, safety, and interoperability. RAS is a primary standards-developing body for the robotics field."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:topological-map ;
    vc:slug "ieee-ras" ;
    vc:sourceDomain "robotics" .

ngm:ieee-robotics-standards a owl:Class ;
    rdfs:label "IEEE Robotics Standards"@en ;
    rdfs:comment "IEEE Robotics Standards are the technical standards developed under IEEE for the robotics and automation domain, covering robot ontologies, ethical design, terminology, and component interoperability. Notable examples include IEEE 1872 for core ontologies and the IEEE 7000 series for ethically aligned design of autonomous systems. They provide a normative foundation for safe, interoperable, and accountable robotic systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embodied-minds,
        ngm:mechanical-component ;
    vc:slug "ieee-robotics-standards" ;
    vc:sourceDomain "robotics" .

ngm:ilo-core-labour-standards a owl:Class ;
    rdfs:label "ILO Core Labour Standards"@en ;
    rdfs:comment "The ILO Core Labour Standards are the fundamental principles and rights at work codified by the International Labour Organization, covering freedom of association and collective bargaining, the elimination of forced and child labour, non-discrimination, and a safe and healthy working environment. They are expressed through ratifiable conventions that member states commit to uphold. The standards form the baseline against which ethical sourcing and labour due-diligence are assessed."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing ;
    vc:slug "ilo-core-labour-standards" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ethical-sourcing .

ngm:imf-cbdc-framework a owl:Class ;
    rdfs:label "IMF CBDC Framework"@en ;
    rdfs:comment "The IMF CBDC Framework is the International Monetary Fund's analytical and policy guidance for the design, adoption, and macro-financial implications of central bank digital currencies. It addresses monetary-policy transmission, financial stability, cross-border interoperability, and capacity development for member-state central banks. The framework helps jurisdictions evaluate whether and how to issue a CBDC."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:imf ;
    vc:slug "imf-cbdc-framework" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cbdcs .

ngm:imf-crypto-asset-classification-framework a owl:Class ;
    rdfs:label "IMF Crypto Asset Classification Framework"@en ;
    rdfs:comment "The IMF Crypto Asset Classification Framework is the International Monetary Fund's taxonomy and policy guidance for categorising crypto assets by their economic function and legal characteristics, such as whether they serve as means of payment, investment instruments, or stablecoins. It informs consistent statistical treatment, regulation, and macro-financial risk monitoring across jurisdictions. The framework supports coherent global oversight of the crypto-asset sector."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:imf ;
    vc:slug "imf-crypto-asset-classification-framework" ;
    vc:sourceDomain "blockchain" .

ngm:immersion-cooling a owl:Class ;
    rdfs:label "Immersion Cooling"@en ;
    rdfs:comment "Immersion cooling is a thermal-management technique in which electronic hardware is submerged directly in a thermally conductive but electrically insulating dielectric fluid to dissipate heat. It offers far higher heat-transfer efficiency than air cooling, enabling denser deployments and lower cooling energy overhead. The technique is widely adopted in high-density data centres and cryptocurrency-mining facilities."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-mining ;
    vc:slug "immersion-cooling" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:bitcoin-environmental-issues .

ngm:immersive-collaboration a owl:Class ;
    rdfs:label "Immersive Collaboration"@en ;
    rdfs:comment "Immersive collaboration is the practice of working together within shared spatial virtual or mixed-reality environments where participants, represented by avatars, interact with 3D content and one another in real time. It extends remote teamwork beyond flat video calls by providing spatial audio, embodied presence, and manipulable shared objects. Immersive collaboration is a key application of metaverse and XR technologies for the enterprise."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:immersive-computing ;
    vc:slug "immersive-collaboration" ;
    vc:sourceDomain "metaverse" .

ngm:immersive-education a owl:Class ;
    rdfs:label "Immersive Education"@en ;
    rdfs:comment "Immersive education is the use of virtual, augmented, and mixed-reality environments to deliver learning experiences in which students are spatially present within simulated or augmented contexts. It supports experiential and situated learning, letting learners practise skills, explore inaccessible places, and visualise abstract concepts in 3D. Immersive education is an applied intersection of educational technology and metaverse platforms."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:enables ngm:vircadia ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:learning-resources ;
    vc:slug "immersive-education" ;
    vc:sourceDomain "metaverse" .

ngm:impact-investing a owl:Class ;
    rdfs:label "Impact Investing"@en ;
    rdfs:comment "Impact investing is an investment approach that intentionally seeks to generate measurable positive social or environmental outcomes alongside a financial return. It is distinguished from conventional investing by the explicit intent to create impact and by the commitment to measure and report that impact against defined indicators. Impact investing spans asset classes and is a core practice within sustainable finance."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:sustainable-finance ;
    vc:slug "impact-investing" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:carbon-neutral-blockchain .

ngm:implementation-examples a owl:Class ;
    rdfs:label "implementation examples"@en ;
    rdfs:comment "Concrete, production-oriented code samples and reference designs demonstrating how theoretical concepts translate into functioning systems. In metaverse and blockchain contexts these span smart contract patterns (DeFi AMMs, NFT contracts, DAO governance), gas optimisation techniques, security patterns such as checks-effects-interactions, and upgradeability proxies. They serve as educational resources and accelerators for developers, reducing deployment risk through audited, annotated reference implementations."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "implementation-examples" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:digital-asset,
        ngm:smart-contracts ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:in-camera-vfx a owl:Class ;
    rdfs:label "In-Camera VFX"@en ;
    rdfs:comment "In-camera visual effects (ICVFX) is a virtual-production technique in which final-pixel visual effects are captured live during photography, typically by displaying real-time rendered 3D environments on large LED volumes behind the actors. Camera tracking drives the rendered background's perspective so that parallax and lighting match the physical camera, producing realistic in-camera composites without later green-screen keying. ICVFX collapses much of post-production into the shoot itself."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-production-vp ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:slug "in-camera-vfx" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:virtual-production-volume .

ngm:incident-investigation a owl:Class ;
    rdfs:label "Incident Investigation"@en ;
    rdfs:comment "Incident investigation is the structured process of determining the root cause, scope, and impact of a security or operational incident by collecting and analysing evidence. In a cybersecurity context it follows the breach lifecycle—identification, containment, evidence preservation, forensic analysis, and lessons learned—to understand how an incident occurred and to prevent recurrence. It relies heavily on audit trails and digital-forensics methods to reconstruct events."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-forensics-framework ;
    vc:slug "incident-investigation" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:audit-trail .

ngm:industrial-metaverse a owl:Class ;
    rdfs:label "Industrial Metaverse"@en ;
    rdfs:comment "A virtual platform integrating digital twin technology, simulation environments, and collaborative workspaces for manufacturing operations, supply chain management, remote equipment control, and industrial training across geographically distributed facilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-factory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:predictive-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:io-t-sensor-network ],
        ngm:metaverse-application-platform,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:collaborative-design,
        ngm:predictive-maintenance,
        ngm:remote-operations,
        ngm:smart-manufacturing,
        ngm:virtual-commissioning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-twin,
        ngm:predictive-analytics,
        ngm:remote-control-interface,
        ngm:supply-chain-visualization,
        ngm:training-simulation,
        ngm:virtual-factory ;
    vc:isPartOf ngm:metaverse-application-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-cad-integration,
        ngm:industrial-protocol-gateway,
        ngm:io-t-sensor-network,
        ngm:real-time-data-synchronization ;
    vc:slug "industrial-metaverse" ;
    vc:sourceDomain "spatial-computing" .

ngm:industry-cloud-platforms a owl:Class ;
    rdfs:label "Industry Cloud Platforms"@en ;
    rdfs:comment "Industry Cloud Platforms (ICPs) are collections of integrated cloud IT assets — including applications, data services, AI pipelines, and compliance tooling — tailored to the specific workflows, regulatory requirements, and data models of a vertical industry such as healthcare, financial services, manufacturing, or retail. They combine horizontal cloud infrastructure with deep domain knowledge, enabling organisations to run both vertical and cross-functional business applications on a unified platform while maintaining appropriate security controls. Gartner identified ICPs as a top strategic technology trend for 2024, driven by the need to reduce IT sprawl and accelerate industry-specific digital transformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-framework ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-transformation,
        ngm:healthcare-technology,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:compliance-framework,
        ngm:data-analytics,
        ngm:platform-service,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:microservices-architecture,
        ngm:platform-engineering ;
    vc:slug "industry-cloud-platforms" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:cloud-native-applications,
        ngm:data-governance,
        ngm:enterprise-architecture .

ngm:inflation-hedging a owl:Class ;
    rdfs:label "Inflation Hedging"@en ;
    rdfs:comment "Inflation hedging is an investment strategy that protects the real value of capital against the erosion of purchasing power caused by rising consumer prices. It allocates wealth to assets whose nominal value tends to rise with or outpace inflation, such as commodities, real estate, inflation-linked bonds, and scarce stores of value. Both gold and Bitcoin are frequently cited as inflation hedges because their supply is constrained relative to fiat currency issuance."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-value-proposition,
        ngm:gold ;
    vc:slug "inflation-hedging" ;
    vc:sourceDomain "blockchain" .

ngm:infrastructure-inspection a owl:Class ;
    rdfs:label "Infrastructure Inspection"@en ;
    rdfs:comment "Infrastructure inspection is the robotic application of surveying and assessing physical assets such as power lines, pipelines, bridges, wind turbines, and buildings to detect defects, corrosion, and structural risk. Robots equipped with cameras, thermal and LiDAR sensors capture data in environments that are hazardous, remote, or costly for human crews. It improves safety and inspection frequency while generating quantitative condition records for predictive maintenance."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aerial-robot,
        ngm:ground-robot ;
    vc:slug "infrastructure-inspection" ;
    vc:sourceDomain "robotics" .

ngm:instant-id a owl:Class ;
    rdfs:label "InstantID"@en ;
    rdfs:comment "InstantID is a diffusion-model technique for identity-preserving image generation that synthesises new images of a specific person from a single reference photograph, without per-subject fine-tuning. It combines a face encoder with an IdentityNet adapter that injects facial identity and spatial landmarks into a text-to-image diffusion backbone. While powerful for personalised avatars and stylisation, its zero-shot fidelity also raises misuse concerns around impersonation and synthetic media."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-net-and-similar-spatial-conditioning-systems,
        ngm:deepfakes-and-fraudulent-content ;
    vc:slug "instant-id" ;
    vc:sourceDomain "ai" .

ngm:instant-settlement a owl:Class ;
    rdfs:label "Instant Settlement"@en ;
    rdfs:comment "Instant settlement is the near-immediate, final transfer of value between parties, eliminating the multi-day clearing and settlement delays of traditional banking and card networks. In blockchain and payment-channel systems it is achieved through cryptographic finality or off-chain channel updates that make funds usable within seconds. It reduces counterparty and credit risk, frees up working capital, and is a defining property of digital money."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-lightning-network,
        ngm:digital-money ;
    vc:slug "instant-settlement" ;
    vc:sourceDomain "blockchain" .

ngm:institutional-adoption a owl:Class ;
    rdfs:label "Institutional Adoption"@en ;
    rdfs:comment "Institutional adoption is the process by which large organisations such as banks, asset managers, and corporations begin to use a technology or asset class at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        ngm:owl-thing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:financial-regulation ;
    vc:slug "institutional-adoption" ;
    vc:sourceDomain "finance" .

ngm:institutional-digital-asset-custody a owl:Class ;
    rdfs:label "Institutional Digital Asset Custody"@en ;
    rdfs:comment "Institutional digital asset custody is the regulated safekeeping of cryptocurrencies and tokenised assets on behalf of funds, banks, and corporations, with controls meeting fiduciary and compliance standards. It combines hardware security modules, multi-party computation or multi-signature key management, segregation of duties, insurance, and audited operational procedures. It is the trust layer that enables large pools of capital to hold crypto assets without bearing single-key loss or theft risk."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:custody-infrastructure,
        ngm:multi-sig-governance ;
    vc:slug "institutional-digital-asset-custody" ;
    vc:sourceDomain "blockchain" .

ngm:institutional-economics a owl:Class ;
    rdfs:label "Institutional Economics"@en ;
    rdfs:comment "A school of economic thought that studies how institutions, the formal and informal rules governing behaviour, shape economic activity and outcomes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economics ],
        ngm:economics ;
    vc:enables ngm:property-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:economics ;
    vc:slug "institutional-economics" ;
    vc:sourceDomain "general" .

ngm:intel a owl:Class ;
    rdfs:label "Intel"@en ;
    rdfs:comment "Intel is a semiconductor manufacturer that designs and produces microprocessors, chipsets and related hardware including security features such as Software Guard Extensions."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:enables ngm:intel-sgx,
        ngm:trusted-execution-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "intel" ;
    vc:sourceDomain "distributed-systems" .

ngm:intel-sgx a owl:Class ;
    rdfs:label "Intel SGX"@en ;
    rdfs:comment "Intel SGX is a set of processor instructions that create isolated memory regions called enclaves, protecting code and data from other software on the same system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intel ],
        ngm:trusted-execution-environment ;
    vc:enables ngm:information-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:intel ;
    vc:slug "intel-sgx" ;
    vc:sourceDomain "distributed-systems" .

ngm:intelligent-automation a owl:Class ;
    rdfs:label "Intelligent Automation"@en ;
    rdfs:comment "Intelligent automation is the combination of process automation with artificial intelligence so that workflows can handle unstructured inputs, make context-dependent decisions, and adapt over time. It extends rule-based robotic process automation with machine learning, natural language processing, and computer vision to automate tasks that previously required human judgement. It is widely applied to back-office operations, customer service, and document-intensive processes."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:robotic-process-automation ;
    vc:slug "intelligent-automation" ;
    vc:sourceDomain "ai" .

ngm:intelligent-environment a owl:Class ;
    rdfs:label "Intelligent Environment"@en ;
    rdfs:comment "An intelligent environment is a physical or virtual space embedded with sensing, computation, and adaptive agents that perceive context and respond to occupants without explicit commands. In metaverse and ambient-computing settings it hosts autonomous agents and virtual entities that react to user presence, intent, and environmental state. It blends ubiquitous sensing with embodied AI to deliver context-aware, responsive experiences."@en ;
    rdfs:subClassOf ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:intelligent-virtual-entity ;
    vc:slug "intelligent-environment" ;
    vc:sourceDomain "metaverse" .

ngm:intelligent-npc a owl:Class ;
    rdfs:label "Intelligent NPC"@en ;
    rdfs:comment "An Intelligent NPC (Non-Player Character) is a virtual agent in a game, simulation, or metaverse environment whose behaviour is driven by AI systems — typically combining perception, reasoning, planning, and natural-language interaction — rather than purely scripted or rule-based finite state machines. Modern intelligent NPCs leverage large language models for open-ended dialogue, reinforcement learning for adaptive combat and movement, and behavioural AI architectures (behaviour trees, goal-oriented action planning) to produce emergent, contextually appropriate responses to player actions and environmental stimuli. They form the interactive population of persistent virtual worlds and are central to immersive narrative experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioral-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dialogue-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioral-modeling ],
        ngm:digital-humans ;
    vc:dependsOn ngm:conversational-ai,
        ngm:generative-ai,
        ngm:pathfinding-algorithm ;
    vc:enables ngm:immersive-experience,
        ngm:interactive-storytelling,
        ngm:npc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavioral-learning,
        ngm:dialogue-system ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:character-model,
        ngm:game-mechanics,
        ngm:procedural-content-generation ;
    vc:requires ngm:behavioral-modeling,
        ngm:natural-language-processing ;
    vc:slug "intelligent-npc" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:agentic-ai,
        ngm:game-engine .

ngm:interaction-control a owl:Class ;
    rdfs:label "Interaction Control"@en ;
    rdfs:comment "A robotics control paradigm that explicitly manages contact forces and compliant behaviour when a robot interacts with its environment or human collaborators. Interaction control encompasses impedance control, admittance control, and force control strategies that allow robots to operate safely during physical contact, adapting stiffness, damping, and inertia in response to sensed forces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impedance-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-sensor ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:force-control,
        ngm:impedance-control ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:motion-control,
        ngm:robot-safety ;
    vc:requires ngm:control-system,
        ngm:robot-sensor ;
    vc:slug "interaction-control" ;
    vc:sourceDomain "robotics" .

ngm:interactive-filmmaking a owl:Class ;
    rdfs:label "Interactive Filmmaking"@en ;
    rdfs:comment "Interactive filmmaking is the production of cinematic content in which viewers influence the narrative, perspective, or outcome through their choices or presence, blurring the line between film and game. It leverages real-time game engines and virtual production techniques to render branching or responsive scenes on demand. It is enabled by virtual production volumes and real-time rendering pipelines that allow scenes to be reshaped live."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:virtual-production-volume,
        ngm:virtual-production-vp ;
    vc:slug "interactive-filmmaking" ;
    vc:sourceDomain "metaverse" .

ngm:interactive-visualization a owl:Class ;
    rdfs:label "Interactive Visualization"@en ;
    rdfs:comment "Interactive visualization is the graphical presentation of data or models that users can manipulate in real time through navigation, filtering, selection, and parameter adjustment to explore and understand information. It couples rendering with responsive input handling so that views update immediately as the user probes the underlying data or 3D scene. It supports analysis, design review, and decision-making across scientific, engineering, and immersive contexts."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-model,
        ngm:real-time-rendering ;
    vc:slug "interactive-visualization" ;
    vc:sourceDomain "metaverse" .

ngm:interface-standards a owl:Class ;
    rdfs:label "Interface Standards"@en ;
    rdfs:comment "Technical specifications and protocols that define how metaverse components, systems, and services communicate and interoperate, encompassing XR device interfaces, data exchange formats, and cross-platform communication requirements."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:technical-standard ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:cross-platform-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "interface-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:internet-infrastructure a owl:Class ;
    rdfs:label "Internet Infrastructure"@en ;
    rdfs:comment "Internet Infrastructure for AI encompasses the networking protocols, distributed systems, edge computing platforms, and content delivery networks that enable large-scale deployment and operation of AI services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:ai-infrastructure ;
    vc:enables ngm:distributed-computing,
        ngm:machine-learning-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-delivery-network,
        ngm:distributed-systems,
        ngm:edge-computing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "internet-infrastructure" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:network-protocol .

ngm:internet-of-agents a owl:Class ;
    rdfs:label "Internet of Agents"@en ;
    rdfs:comment "The Internet of Agents is an envisioned network architecture in which autonomous AI agents discover, communicate, transact, and collaborate with one another across organisational boundaries using shared protocols. It extends the web from human- and document-centric interaction to machine-to-machine delegation, negotiation, and task execution among agents. It depends on interoperable identity, messaging, and trust standards to let heterogeneous agents cooperate safely."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agentic-internet,
        ngm:decentralised-web ;
    vc:slug "internet-of-agents" ;
    vc:sourceDomain "ai" .

ngm:interpretable-ai a owl:Class ;
    rdfs:label "Interpretable AI"@en ;
    rdfs:comment "Machine learning models and systems whose internal decision-making processes are inherently transparent and understandable to humans without requiring additional post-hoc explanation techniques. Interpretable AI prioritises transparency by design—via linear models, decision trees, or rule-based systems—distinguishing it from explainable AI approaches that retrofit explanations onto opaque models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-transparency ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:large-language-models ;
    vc:enables ngm:accountability,
        ngm:explainable-ai,
        ngm:fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation ;
    vc:requires ngm:model-interpretability,
        ngm:model-transparency ;
    vc:slug "interpretable-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:investment-contract-analysis a owl:Class ;
    rdfs:label "Investment Contract Analysis"@en ;
    rdfs:comment "Investment contract analysis is the legal evaluation of whether a financial arrangement constitutes a security, most commonly by applying the Howey test's criteria of an investment of money in a common enterprise with an expectation of profit derived from others' efforts. In crypto-asset regulation it determines whether a token offering falls under securities law and its attendant registration and disclosure obligations. It is a decisive step in assessing regulatory exposure for digital-asset issuers."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:howey-test,
        ngm:securities-regulation ;
    vc:slug "investment-contract-analysis" ;
    vc:sourceDomain "blockchain" .

ngm:iros a owl:Class ;
    rdfs:label "IROS"@en ;
    rdfs:comment "IROS, the International Conference on Intelligent Robots and Systems, is an annual academic robotics conference co-sponsored by the IEEE and the Robotics Society of Japan."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "iros" ;
    vc:sourceDomain "robotics" .

ngm:isa-95 a owl:Class ;
    rdfs:label "ISA-95"@en ;
    rdfs:comment "ISA-95 is an international standard for integrating enterprise and control systems in manufacturing, defining models for the interface between business and production operations."@en ;
    rdfs:subClassOf ngm:opc-ua ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "isa-95" ;
    vc:sourceDomain "manufacturing" .

ngm:isda-common-domain-model a owl:Class ;
    rdfs:label "ISDA Common Domain Model"@en ;
    rdfs:comment "The ISDA Common Domain Model is the full name of the standardised, machine-readable representation of financial products, trade events, and lifecycle processes maintained by the International Swaps and Derivatives Association. It establishes a single canonical model so that distributed ledgers, smart contracts, and institutional systems process derivatives transactions identically and without reconciliation. It is a cornerstone standard for interoperable, automated post-trade infrastructure."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:enterprise-smart-contracts,
        ngm:isda-cdm ;
    vc:slug "isda-common-domain-model" ;
    vc:sourceDomain "blockchain" .

ngm:iso-10218-robot-safety a owl:Class ;
    rdfs:label "ISO 10218 Robot Safety"@en ;
    rdfs:comment "An ISO standard, in multiple parts, specifying safety requirements for industrial robots and robot systems. It addresses hazards and protective measures for robot design and integration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:iso ;
    vc:slug "iso-10218-robot-safety" ;
    vc:sourceDomain "standards" .

ngm:iso-10816 a owl:Class ;
    rdfs:label "ISO 10816"@en ;
    rdfs:comment "ISO 10816 is an international standard specifying the measurement and evaluation of mechanical vibration of rotating machinery by readings taken on non-rotating parts. It defines vibration severity zones that classify equipment condition from acceptable to unacceptable, guiding when intervention is required. It is widely used as the reference basis for condition monitoring and predictive maintenance of pumps, motors, fans, and turbines."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:predictive-maintenance ;
    vc:slug "iso-10816" ;
    vc:sourceDomain "infrastructure" .

ngm:iso-14040 a owl:Class ;
    rdfs:label "ISO 14040"@en ;
    rdfs:comment "ISO 14040 sets out the principles and framework for life cycle assessment as part of environmental management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:iso ;
    vc:slug "iso-14040" ;
    vc:sourceDomain "standards" .

ngm:iso-20400 a owl:Class ;
    rdfs:label "ISO 20400"@en ;
    rdfs:comment "ISO 20400 is an international standard providing guidance on integrating sustainability into procurement processes and decisions across an organisation and its supply chains. It helps buyers consider environmental, social, and economic impacts when sourcing goods and services, aligning purchasing with responsible and ethical principles. As a guidance standard rather than a certifiable requirement, it shapes policy, supplier engagement, and accountability for sustainable sourcing."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing ;
    vc:slug "iso-20400" ;
    vc:sourceDomain "supply-chain" .

ngm:iso-22000 a owl:Class ;
    rdfs:label "ISO 22000"@en ;
    rdfs:comment "ISO 22000 is an international standard specifying the requirements for a food safety management system, enabling any organisation in the food chain to demonstrate control of food-safety hazards. It integrates HACCP principles with management-system structure, prerequisite programmes, and interactive communication across the supply chain. It is widely certified by producers, processors, and logistics providers, including those operating cold-chain monitoring."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring ;
    vc:slug "iso-22000" ;
    vc:sourceDomain "supply-chain" .

ngm:iso-24165 a owl:Class ;
    rdfs:label "ISO 24165"@en ;
    rdfs:comment "ISO 24165 specifies a Digital Token Identifier for the unique identification of digital tokens, including the structure and assignment of the identifier."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
