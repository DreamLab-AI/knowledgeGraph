    vc:sourceDomain "robotics" .
ngm:variance a owl:Class ;
    rdfs:comment "The fundamental statistical measure of dispersion, defined as the expected squared deviation of a random variable from its mean, Var(X) = E[(X − E[X])²]. Its square root is the standard deviation; its multivariate generalisation is the covariance matrix; and it parameterises the spread of the Gaussian distribution. Variance governs the reliability of sample-based estimates, decomposes prediction error in the bias-variance trade-off, and is the quantity that variance-reduction techniques in Monte Carlo estimation and stochastic optimisation exist to control."@en ;
    rdfs:label "Variance"@en ;
    rdfs:subClassOf ngm:statistics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:covariance-matrix ;
    vc:isPartOf ngm:gaussian-distribution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:probability-distribution ;
    vc:relatedTo ngm:random-sampling ;
    vc:slug "variance" ;
    vc:sourceDomain "data" .
