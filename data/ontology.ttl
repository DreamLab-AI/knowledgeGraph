    vc:sourceDomain "spatial-computing" .

ngm:national-competitiveness a owl:Class ;
    rdfs:label "National Competitiveness"@en ;
    rdfs:comment "National competitiveness is the set of policies, institutions, and capabilities that determine a country's level of productivity and its ability to sustain growth in an open global economy. In a technology context it captures how strategic investment in research, talent, and digital infrastructure positions a nation relative to others. Technology adoption is widely treated as a primary driver because it raises productivity and creates spillover advantages."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "national-competitiveness" ;
    vc:sourceDomain "governance" .

ngm:national-income a skos:Concept ;
    rdfs:label "National Income"@en .

ngm:nb-io-t a owl:Class ;
    rdfs:label "NB-IoT"@en ;
    rdfs:comment "NB-IoT (Narrowband Internet of Things) is a 3GPP low-power wide-area cellular standard designed to connect large numbers of simple, battery-powered devices over licensed spectrum. It trades bandwidth and latency for deep indoor coverage, long battery life, and low module cost, operating within or alongside existing LTE deployments. It is widely used for metering, asset tracking, and environmental sensing where devices transmit small amounts of data infrequently."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:io-t-sensor-network ;
    vc:slug "nb-io-t" ;
    vc:sourceDomain "infrastructure" .

ngm:netting a skos:Concept ;
    rdfs:label "Netting"@en .

ngm:network-congestion a owl:Class ;
    rdfs:label "Network Congestion"@en ;
    rdfs:comment "Network congestion is the state in which the demand for a network's processing capacity exceeds its available throughput, causing transactions to queue and confirmation times and fees to rise. On a blockchain it occurs when the volume of pending transactions outstrips the space available in upcoming blocks, filling the mempool and triggering competitive fee bidding. Congestion exposes the scalability limits of a system and is a primary driver of fee market dynamics and layer-2 adoption. It is both a symptom of demand and a constraint that shapes protocol design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scalability ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:gas-fee ;
    vc:contrastsWith ngm:scalability ;
    vc:dependsOn ngm:block-time,
        ngm:scalability ;
    vc:enables ngm:fee-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fee-market,
        ngm:mempool,
        ngm:transaction,
        ngm:transaction-fee ;
    vc:requires ngm:scalability ;
    vc:slug "network-congestion" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:transaction-fee ;
    vc:uses ngm:mempool .

ngm:network-participation a owl:Class ;
    rdfs:label "Network Participation"@en ;
    rdfs:comment "Network participation is the act of an entity contributing resources or actions to a decentralised network in exchange for the right to influence and benefit from it. In blockchain systems this includes running nodes, validating or proposing blocks, providing liquidity, or voting, typically backed by staked capital or computational work. Participation rules and incentives determine the network's security, decentralisation, and reward distribution."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-entity,
        ngm:reward-distribution ;
    vc:slug "network-participation" ;
    vc:sourceDomain "blockchain" .

ngm:neural-interface a owl:Class ;
    rdfs:label "Neural Interface"@en ;
    rdfs:comment "A neural interface is a system that establishes a communication pathway between the nervous system and an external device, translating neural activity into machine-readable signals or delivering stimulation back to neural tissue. Interfaces range from non-invasive surface electrodes that read muscle or scalp potentials to implanted electrodes that record from or stimulate individual neurons. They enable direct neural control of prosthetics, robots, and computers, and the restoration of sensory feedback."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:human-robot-interaction ;
    vc:bridgesTo ngm:human-robot-interaction ;
    vc:dependsOn ngm:feedback-control ;
    vc:enables ngm:haptics,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:actuator ;
    vc:isPartOf ngm:prosthetics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robotics ;
    vc:requires ngm:control-system,
        ngm:machine-learning ;
    vc:slug "neural-interface" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:exoskeleton ;
    vc:uses ngm:electromyography,
        ngm:sensor,
        ngm:signal-processing .

ngm:neural-networks a skos:Concept ;
    rdfs:label "Neural Networks"@en .

ngm:neural-ode a owl:Class ;
    rdfs:label "Neural Ode"@en ;
    rdfs:comment "A neural ordinary differential equation (Neural ODE) is a deep learning model that parameterises the continuous-time derivative of a hidden state with a neural network, so the forward pass becomes the solution of an ODE by a numerical integrator. This replaces a discrete stack of layers with a continuous-depth transformation and trains efficiently via the adjoint sensitivity method, giving constant memory cost. Neural ODEs are well suited to modelling continuous dynamics, irregularly sampled time series, and continuous normalising flows."@en ;
    rdfs:subClassOf ngm:deep-learning ;
    vc:bridgesTo ngm:system-identification ;
    vc:contrastsWith ngm:residual-network ;
    vc:dependsOn ngm:backpropagation ;
    vc:enables ngm:system-identification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:neural-network ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:differential-equations,
        ngm:dynamical-systems,
        ngm:residual-network ;
    vc:slug "neural-ode" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:system-identification ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent,
        ngm:neural-network .

ngm:nis2-directive a owl:Class ;
    rdfs:label "Nis2 Directive"@en ;
    rdfs:comment "The NIS2 Directive is European Union legislation that raises and harmonises cybersecurity requirements for essential and important entities operating critical services across member states. It expands the scope of the earlier NIS Directive, imposes risk-management and governance obligations on covered organisations, and introduces stricter incident-reporting timelines and enforcement. It is a cornerstone of EU cyber-resilience policy for sectors such as energy, transport, health, and digital infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        ngm:regulatory-compliance ;
    vc:bridgesTo ngm:network-security ;
    vc:dependsOn ngm:risk-management ;
    vc:enables ngm:compliance,
        ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:gdpr,
        ngm:network-security ;
    vc:requires ngm:incident-response,
        ngm:risk-management ;
    vc:slug "nis2-directive" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:governance-framework,
        ngm:regulatory-compliance ;
    vc:supports ngm:cybersecurity,
        ngm:incident-management .

ngm:nist-sp-800-207 a owl:Class ;
    rdfs:label "NIST SP 800-207"@en ;
    rdfs:comment "A NIST Special Publication describing zero trust architecture, a security model that treats no implicit trust based on network location. It defines concepts, components and deployment approaches for zero trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nist ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:nist ;
    vc:slug "nist-sp-800-207" ;
    vc:sourceDomain "standards" .

ngm:nist-sp-800-53 a owl:Class ;
    rdfs:label "NIST SP 800-53"@en ;
    rdfs:comment "NIST SP 800-53 provides a catalogue of security and privacy controls for information systems and organisations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nist ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:nist ;
    vc:slug "nist-sp-800-53" ;
    vc:sourceDomain "standards" .

ngm:non-destructive-editing a owl:Class ;
    rdfs:label "Non-Destructive Editing"@en ;
    rdfs:comment "Non-destructive editing is a content-authoring approach in which modifications are recorded as separate, reversible operations or layers rather than overwriting the original source data. The source remains intact, and the final result is computed by composing the edit stack, so any change can be re-ordered, adjusted, or removed. It is fundamental to layered 3D scene description and modern media pipelines."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-scene-exchange-protocol-sxp,
        ngm:universal-scene-description ;
    vc:slug "non-destructive-editing" ;
    vc:sourceDomain "metaverse" .

ngm:non-verbal-communication a owl:Class ;
    rdfs:label "Non Verbal Communication"@en ;
    rdfs:comment "Non-verbal communication is the transmission of meaning through channels other than spoken or written words, including gesture, facial expression, gaze, posture, and interpersonal distance. It conveys emotion, intent, and social context that frequently carries more weight than the literal verbal message. In spatial computing and avatar-mediated environments, reproducing non-verbal cues is essential for credible co-presence and natural social interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proxemics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gaze-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gesture-recognition ],
        ngm:immersive-communication ;
    vc:bridgesTo ngm:gesture-recognition ;
    vc:contrastsWith ngm:emotion-recognition ;
    vc:enables ngm:co-presence,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gesture-recognition,
        ngm:proxemics ;
    vc:isPartOf ngm:immersive-communication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:proxemics,
        ngm:social-presence ;
    vc:requires ngm:eye-tracking,
        ngm:gaze-tracking ;
    vc:slug "non-verbal-communication" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:immersive-communication,
        ngm:telepresence ;
    vc:uses ngm:avatar,
        ngm:emotion-recognition,
        ngm:haptic-feedback .

ngm:nucleus-sampling a skos:Concept ;
    rdfs:label "Nucleus Sampling"@en .

ngm:obj-format a owl:Class ;
    rdfs:label "Obj Format"@en ;
    rdfs:comment "The OBJ format (Wavefront .obj) is a simple, text-based 3D geometry interchange format that stores polygon mesh data as lists of vertices, texture coordinates, normals and faces. It is openly documented and almost universally supported, with material properties carried in a companion .mtl file. Valued for its readability and portability rather than efficiency, OBJ remains a common lowest-common-denominator format for exchanging static 3D models between modelling tools and pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polygon-mesh ],
        ngm:polygon-mesh ;
    vc:bridgesTo ngm:gl-tf ;
    vc:contrastsWith ngm:fbx,
        ngm:gl-tf ;
    vc:dependsOn ngm:mesh-data ;
    vc:enables ngm:3-d-model,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:polygon-mesh ;
    vc:isPartOf ngm:3-d-asset ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:3-d-model,
        ngm:fbx,
        ngm:texture-mapping ;
    vc:requires ngm:polygon-mesh ;
    vc:slug "obj-format" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:3-d-asset ;
    vc:uses ngm:mesh-data,
        ngm:texture-mapping .

ngm:offline-reinforcement-learning a owl:Class ;
    rdfs:label "Offline Reinforcement Learning"@en ;
    rdfs:comment "Offline reinforcement learning trains a policy from a fixed dataset of previously collected experience without further interaction with the environment. It avoids online exploration, which makes it suitable where data collection is costly or unsafe."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:reinforcement-learning ;
    vc:enables ngm:learning-from-demonstration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:markov-decision-process,
        ngm:reinforcement-learning ;
    vc:slug "offline-reinforcement-learning" ;
    vc:sourceDomain "machine-learning" .

ngm:oma-3 a owl:Class ;
    rdfs:label "OMA3"@en ;
    rdfs:comment "OMA3 (Open Metaverse Alliance for Web3) is an industry consortium founded in 2022 by major metaverse and blockchain companies to establish open, interoperable standards for virtual worlds, digital assets, and cross-platform identity. It operates as a member-governed non-profit organisation whose working groups produce shared specifications, reference implementations, and governance frameworks ensuring that digital objects and user identities remain portable across disparate metaverse platforms. OMA3 sits at the intersection of Web3 ownership principles and spatial-computing infrastructure, seeking to prevent proprietary lock-in by codifying standards for asset transfer protocols, decentralised land registries, and avatar portability. Its outputs are designed to be adopted by blockchain networks, game engines, and virtual world platforms alike, making it a foundational governance body for an open metaverse ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-group ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        ngm:standards-body ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:proprietary-platform,
        ngm:walled-garden ;
    vc:enables ngm:asset-portability,
        ngm:cross-platform-identity,
        ngm:interoperability-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-framework,
        ngm:working-group ;
    vc:implements ngm:open-standard,
        ngm:web3 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentraland,
        ngm:metaverse-standards-forum,
        ngm:open-metaverse-interoperability-group ;
    vc:requires ngm:blockchain,
        ngm:decentralised-identity ;
    vc:slug "oma-3" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:avatar,
        ngm:metaverse,
        ngm:virtual-world ;
    vc:uses ngm:decentralised-autonomous-organisation,
        ngm:non-fungible-token,
        ngm:smart-contract .

ngm:omniverse a owl:Class ;
    rdfs:label "Omniverse"@en ;
    rdfs:comment "A platform developed by NVIDIA for building and operating three-dimensional simulation and collaboration applications, based on the Universal Scene Description framework. It is used for digital twins and physically accurate simulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
