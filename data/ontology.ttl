ngm:camera-tracking a owl:Class ;
    rdfs:comment "Camera Tracking is the process of continuously estimating the position and orientation (pose) of a camera in 3D space relative to a fixed reference frame or scene, typically using image feature analysis, optical flow, or fiducial marker detection. It underpins augmented reality, visual effects compositing, robotic navigation, and autonomous vehicle perception by enabling virtual or computed elements to be correctly registered to the physical world as the camera moves."@en ;
    rdfs:label "Camera Tracking"@en ;
    rdfs:subClassOf ngm:motion-tracking ;
    vc:enables ngm:augmented-reality ;
    vc:enables ngm:slam ;
    vc:enables ngm:visual-odometry ;
