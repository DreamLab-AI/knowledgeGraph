        ngm:virtual-environment ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ai-system,
        ngm:game-engine,
        ngm:physics-simulation,
        ngm:procedural-generation,
        ngm:state-management ;
    vc:slug "open-world" ;
    vc:sourceDomain "spatial-computing" .

ngm:openai-research-organisation-whisper a owl:Class ;
    rdfs:label "Open AI Whisper"@en ;
    rdfs:comment "OpenAI Whisper is an open-source automatic speech recognition (ASR) system released by OpenAI in September 2022, trained on approximately 680,000 hours of multilingual and multitask supervised audio data sourced from the internet. It employs a Transformer encoder-decoder architecture that jointly learns transcription, translation, and language identification from weakly supervised training data, achieving near-human accuracy across a broad range of accents, recording conditions, and languages. Whisper is released as open weights in multiple sizes (tiny, base, small, medium, large, and subsequent variants), enabling local deployment without API dependency. Its robustness to background noise, accented speech, and domain-specific vocabulary—combined with zero-shot multilingual performance—has made it the de facto baseline for ASR research and a widely deployed component in transcription pipelines, voice interfaces, and accessibility applications."@en ;
    rdfs:subClassOf ngm:automatic-speech-recognition ;
    vc:enables ngm:meeting-transcription,
        ngm:real-time-transcription ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:openai-research-organisation,
        ngm:speech-recognition,
        ngm:transformer-architecture ;
    vc:slug "open-ai-whisper" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:audio-processing-system,
        ngm:speech-and-voice .

ngm:origin-server a owl:Class ;
    rdfs:label "Origin Server"@en ;
    rdfs:comment "An origin server is the authoritative source of truth for web content, hosting the original, canonical version of resources that a content delivery network and its edge caches replicate and serve to end users. When an edge node lacks a requested resource or its cached copy has expired, it fetches the content from the origin server. By concentrating authoritative content and offloading repeat delivery to caches, the origin-edge model improves performance, scalability, and resilience."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:caching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        ngm:cdn ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:edge-server ;
    vc:dependsOn ngm:http ;
    vc:enables ngm:caching,
        ngm:content-delivery-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:caching ;
    vc:isPartOf ngm:cdn ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-server,
        ngm:reverse-proxy ;
    vc:requires ngm:http,
        ngm:infrastructure ;
    vc:slug "origin-server" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cdn,
        ngm:load-balancer ;
    vc:uses ngm:http,
        ngm:reverse-proxy .

ngm:over-the-air-update a owl:Class ;
    rdfs:label "Over The Air Update"@en ;
    rdfs:comment "An over-the-air (OTA) update is the wireless delivery of new software, firmware, or configuration to a deployed device without physical access. OTA mechanisms package an update, transport it over a network, verify its authenticity and integrity, and apply it safely with rollback protection. They are essential to maintaining, securing, and extending the capabilities of fleets of embedded and connected devices throughout their operational life."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:non-volatile-memory ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:cybersecurity ;
    vc:dependsOn ngm:telemetry ;
    vc:enables ngm:incident-response,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cryptographic-proof ;
    vc:isPartOf ngm:io-t ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:io-t,
        ngm:microcontroller ;
    vc:requires ngm:firmware,
        ngm:non-volatile-memory ;
    vc:slug "over-the-air-update" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:embedded-systems,
        ngm:reliability ;
    vc:uses ngm:encryption,
        ngm:wireless-communication .

ngm:ownership-transfer a owl:Class ;
    rdfs:label "Ownership Transfer"@en ;
    rdfs:comment "Ownership transfer is the process by which legal or functional control of an asset — physical, digital, or tokenised — passes from one party to another, recorded in a registry, ledger, or smart contract. In blockchain and Web3 contexts it typically refers to atomic state transitions that update on-chain ownership records for fungible tokens, NFTs, or tokenised real-world assets, with cryptographic proofs replacing traditional notarial or escrow intermediaries. The mechanism must satisfy atomicity, finality, and auditability requirements."@en ;
    rdfs:subClassOf ngm:digital-asset-management ;
    vc:enables ngm:fractional-ownership,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asset-tokenization,
        ngm:digital-ownership,
        ngm:property-rights ;
    vc:slug "ownership-transfer" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cross-chain-asset-transfer ;
    vc:uses ngm:digital-asset,
        ngm:provenance-tracking .

ngm:package-manager a owl:Class ;
    rdfs:label "Package Manager"@en ;
    rdfs:comment "A package manager is a tool that automates the installation, upgrade, configuration and removal of software libraries and their dependencies from curated repositories. It resolves version constraints across a dependency graph and records lockfiles so environments are reproducible. Package managers are foundational infrastructure for modern software development and continuous integration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-development ],
        ngm:software-development ;
    vc:dependsOn ngm:version-control ;
    vc:enables ngm:continuous-integration,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:software-development ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:reproducibility,
        ngm:software-development,
        ngm:version-control ;
    vc:requires ngm:software-development ;
    vc:slug "package-manager" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:continuous-integration,
        ngm:reproducibility ;
    vc:uses ngm:version-control .

ngm:parametric-design-methodology-modeling a owl:Class ;
    rdfs:label "Parametric Modeling"@en ;
    rdfs:comment "A CAD design modology that uses algorithms and adjustable parameters to generate and modify complex 3D geometry, enabling flexible, constraint-driven design where changes to input values automatically propagate throughout the model."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:generative-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "parametric-modeling" ;
    vc:sourceDomain "spatial-computing" .

ngm:part-of-speech-tagging a skos:Concept ;
    rdfs:label "Part Of Speech Tagging"@en .

ngm:participatory-design a owl:Class ;
    rdfs:label "Participatory Design"@en ;
    rdfs:comment "Participatory Design is a design methodology in which end-users, stakeholders, and affected communities are actively involved as co-designers throughout the design process rather than being passive subjects of research. Originating in Scandinavian workplace democracy movements of the 1970s, it prioritises the experiential knowledge of participants and seeks to produce systems that genuinely serve their needs. In digital technology and AI contexts, it is applied to ensure that systems reflect diverse human values and avoid embedding biases of the designer."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:bridgesTo ngm:ai ;
    vc:contrastsWith ngm:expert-driven-design ;
    vc:dependsOn ngm:stakeholder-engagement ;
    vc:enables ngm:inclusive-design,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:co-design-workshop ;
    vc:implements ngm:human-centred-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:ai-ethics,
        ngm:human-computer-interaction ;
    vc:slug "participatory-design" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:distributed-collaboration,
        ngm:policy ;
    vc:uses ngm:prototyping,
        ngm:user-research .

ngm:partition-tolerance a skos:Concept ;
    rdfs:label "Partition Tolerance"@en .

ngm:pattern-matching a owl:Class ;
    rdfs:label "Pattern Matching"@en ;
    rdfs:comment "Pattern matching is the act of checking a sequence or structure against a pattern to detect the presence of constituent components, and, in programming languages, of binding variables to parts of the matched structure. In symbolic AI and computation it underpins rule firing, unification, and term rewriting; in software it provides a declarative way to deconstruct data by shape. It contrasts with statistical pattern recognition by operating on exact, often symbolic, structure rather than learned probabilistic similarity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regular-expression ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finite-state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:contrastsWith ngm:pattern-recognition ;
    vc:enables ngm:symbolic-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:finite-state-machine,
        ngm:regular-expression ;
    vc:implements ngm:algorithm ;
    vc:isPartOf ngm:artificial-intelligence ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:finite-state-machine,
        ngm:pattern-recognition,
        ngm:regular-expression,
        ngm:symbolic-ai ;
    vc:requires ngm:algorithm ;
    vc:slug "pattern-matching" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:symbolic-ai ;
    vc:uses ngm:finite-state-machine,
        ngm:regular-expression .

ngm:peer-to-peer-trading a owl:Class ;
    rdfs:label "Peer-to-Peer Trading"@en ;
    rdfs:comment "Peer-to-peer trading is the direct exchange of assets between two parties without a centralised intermediary holding or matching the order. On blockchains it is typically mediated by smart contracts that escrow assets and enforce settlement atomically, removing custodial risk. It enables markets for tokens, NFTs, and goods to operate trustlessly through code rather than a central exchange."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barter-system,
        ngm:nft-swapping ;
    vc:slug "peer-to-peer-trading" ;
    vc:sourceDomain "blockchain" .

ngm:planetary-gearbox a owl:Class ;
    rdfs:label "Planetary Gearbox"@en ;
    rdfs:comment "A planetary gearbox is a gear-reduction mechanism in which several planet gears revolve around a central sun gear inside an outer ring gear. This epicyclic arrangement distributes load across multiple gear meshes, yielding high torque density, coaxial input and output, and compact reduction ratios. It is a core mechanical component in robotic joints and actuators where space and weight are constrained."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "planetary-gearbox" ;
    vc:sourceDomain "robotics" .

ngm:platform-layer a owl:Class ;
    rdfs:label "Platform Layer"@en ;
    rdfs:comment "Architectural tier providing core platform services including identity, world state management, and asset services upon which metaverse applications are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-service ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:application-development,
        ngm:asset-portability,
        ngm:interoperability,
        ngm:user-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-service,
        ngm:identity-service,
        ngm:persistence,
        ngm:platform-middleware ;
    vc:isPartOf ngm:technology-infrastructure-domain-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication-system,
        ngm:database-system,
        ngm:networking-layer ;
    vc:slug "platform-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:player-modelling a owl:Class ;
    rdfs:label "Player Modelling"@en ;
    rdfs:comment "Player modelling is the computational construction of representations of a player's preferences, skill, behaviour, and emotional state from in-game data. These models enable games to personalise difficulty, content, and recommendations, and to predict future actions. It is a foundational technique for adaptive and AI-driven game systems."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games ;
    vc:slug "player-modelling" ;
    vc:sourceDomain "ai" .

ngm:policy-layer a owl:Class ;
    rdfs:label "Policy Layer"@en ;
    rdfs:comment "The Policy Layer is the cross-cutting stratum that encodes machine-readable rules, constraints, and authorisations governing system behaviour. It sits above operational concerns and below the human-facing Governance Layer, translating governance intent into enforceable statements that other layers consult before acting. It contains policy definitions, decision points, and enforcement hooks rather than the data or compute those policies regulate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:compliance-layer,
        ngm:governance-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:identity-layer ;
    vc:slug "policy-layer" ;
    vc:sourceDomain "governance" .

ngm:polkadot-xcm a owl:Class ;
    rdfs:label "Polkadot XCM"@en ;
    rdfs:comment "Polkadot XCM (Cross-Consensus Messaging) is a format and language for communicating intent between consensus systems within and beyond the Polkadot network. Rather than transferring assets directly, XCM expresses instructions that a receiving chain interprets and executes locally, enabling asset transfers, remote calls and governance actions across parachains and the relay chain. It is transport-agnostic, relying on underlying delivery layers such as XCMP and HRMP, and is designed to be extensible and version-negotiated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polkadot ],
        ngm:cross-chain-communication ;
    vc:bridgesTo ngm:cross-chain-bridge ;
    vc:contrastsWith ngm:cosmos-ibc,
        ngm:layer-zero ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:enables ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cross-chain-communication ;
    vc:isPartOf ngm:polkadot ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger ;
    vc:requires ngm:polkadot ;
    vc:slug "polkadot-xcm" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:interoperability-protocol ;
    vc:supports ngm:smart-contract ;
    vc:uses ngm:message-passing,
        ngm:web-assembly .

ngm:portal-system a owl:Class ;
    rdfs:label "Portal System"@en ;
    rdfs:comment "A spatial computing mechanism that enables instantaneous traversal between distinct virtual locations, worlds, or platform environments, rendering a visual aperture through which users can see and enter the destination, thereby facilitating cross-world navigation and interoperability in metaverse platforms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:virtual-world-traversal ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-navigation-systems,
        ngm:virtual-environment ;
    vc:slug "portal-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:real-time-rendering,
        ngm:virtual-location .

ngm:positive-feedback a owl:Class ;
    rdfs:label "Positive Feedback"@en ;
    rdfs:comment "Positive feedback is a control and systems mechanism in which the output of a process amplifies the input that produced it, reinforcing change rather than damping it. While destabilising in control systems, it underlies self-reinforcing dynamics such as network effects, exponential growth, and adoption cascades. Its behaviour contrasts with negative feedback, which seeks equilibrium."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:network-effects ;
    vc:slug "positive-feedback" ;
    vc:sourceDomain "infrastructure" .

ngm:postgre-sql a owl:Class ;
    rdfs:label "PostgreSQL"@en ;
    rdfs:comment "PostgreSQL is an open-source, ACID-compliant object-relational database management system (ORDBMS) that extends the SQL standard with features such as table inheritance, function overloading, and a rich type system including arrays, JSON, and user-defined types. It supports both relational and document storage paradigms, advanced indexing strategies including GIN, GiST, BRIN, and B-tree, and full-text search, making it a versatile choice for analytical and transactional workloads. Developed from the POSTGRES project at UC Berkeley (1986), it has been maintained as free software since 1996 and is widely regarded as the most standards-compliant open-source relational database."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-engine ],
        ngm:database-system ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:machine-learning ;
    vc:contrastsWith ngm:nosql-database ;
    vc:enables ngm:data-governance,
        ngm:machine-learning-discipline-infrastructure,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-storage,
        ngm:graph-database,
        ngm:open-source-software,
        ngm:query-processor,
        ngm:sql ;
    vc:requires ngm:storage-engine ;
    vc:slug "postgre-sql" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-query,
        ngm:full-text-search,
        ngm:spatial-database,
        ngm:vector-database,
        ngm:version-control ;
    vc:uses ngm:b-tree-index,
        ngm:write-ahead-logging .

ngm:power-usage-effectiveness a owl:Class ;
    rdfs:label "Power Usage Effectiveness"@en ;
    rdfs:comment "Power usage effectiveness (PUE) is a metric used to assess the energy efficiency of a data centre, defined as the ratio of total facility energy to the energy delivered to IT equipment. A PUE of 1.0 represents perfect efficiency where all energy reaches computing hardware, while higher values reflect overhead from cooling, power conversion and lighting. It is a widely used benchmark for sustainability and operational efficiency in data centres."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
