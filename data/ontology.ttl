ngm:spatial-mapping a owl:Class ;
    rdfs:label "Spatial Mapping"@en ;
    rdfs:comment "The process of constructing and continuously updating three-dimensional representations of physical environments using sensor data—including depth cameras, LiDAR, and IMU—enabling AR/VR systems to understand surroundings for occlusion, collision, content placement, and navigation. Core algorithms include SLAM variants that fuse visual features with inertial measurements to produce dense mesh or voxel representations in real time."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-anchor ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ar-technology ;
    vc:slug "spatial-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision-system,
        ngm:lidar,
        ngm:slam .

ngm:state-estimation a owl:Class ;
    rdfs:label "State Estimation"@en ;
    rdfs:comment "State Estimation encompasses the algorithms and techniques used to infer the internal state of a robotic system from noisy sensor measurements."@en ;
