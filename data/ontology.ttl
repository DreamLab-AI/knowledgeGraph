ngm:rb-0047-feedback-control a owl:Class ;
    rdfs:label "rb 0047 feedback control"@en ;
    rdfs:comment "A closed-loop control strategy in which sensor measurements of a system's output are continuously compared to a reference setpoint, and the resulting error signal drives corrective actuator commands. Feedback control is the foundational mechanism for stable, accurate robotic motion, enabling autonomous robots and telerobotic systems to compensate for disturbances, model uncertainty, and environmental variation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:closed-loop-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:adaptive-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robotics-control,
        ngm:teleoperation ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "rb-0047-feedback-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:pid-control,
        ngm:robot-sensor .

ngm:rb-0051-trajectory-planning a owl:Class ;
    rdfs:label "rb 0051 trajectory planning"@en ;
    rdfs:comment "Trajectory planning is the process of computing a time-parametrised path — specifying position, velocity, and acceleration profiles — that moves a robot from a start configuration to a goal while satisfying kinematic and dynamic constraints, joint limits, and task requirements. It extends path planning by assigning timing to waypoints, enabling smooth, jerk-limited motions suitable for real-time execution by a robot controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0049-motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0022-robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0044-velocity,
        ngm:rb-0045-acceleration,
        ngm:rb-0052-collision-avoidance ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics,
        ngm:rb-0049-motion-planning ;
    vc:slug "rb-0051-trajectory-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:optimal-control,
        ngm:rb-0048-pid-controller .

ngm:recall a owl:Class ;
    rdfs:label "Recall"@en ;
    rdfs:comment "A classification performance metric representing the proportion of actual positive instances that an artificial intelligence model correctly identifies, calculated as the ratio of true positives to all actual positives (true positives plus false negatives), measuring the model's completeness in detecting positive cases, particularly critical in applications where missing positive instances (false negatives) carries significant cost or consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        ngm:model-performance ;
    vc:bridgesTo ngm:diagnostic-sensitivity,
        ngm:evaluation-metric,
        ngm:information-retrieval-evaluation ;
    vc:contrastsWith ngm:false-negative-rate,
        ngm:precision,
        ngm:specificity ;
    vc:dependsOn ngm:binary-classification,
        ngm:classification-model ;
    vc:enables ngm:model-comparison,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:false-negative,
        ngm:true-positive ;
    vc:isPartOf ngm:classification-evaluation,
        ngm:model-performance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:imbalanced-classification,
        ngm:information-retrieval ;
    vc:requires ngm:confusion-matrix,
        ngm:ground-truth-labels ;
    vc:slug "recall" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-25059,
        ngm:nist-ai-rmf ;
    vc:supports ngm:accuracy,
        ngm:f1-score,
        ngm:model-fairness ;
    vc:uses ngm:confusion-matrix,
        ngm:precision-recall-curve,
        ngm:roc-curve .

