    vc:sourceDomain "blockchain" .

ngm:project-nexus a owl:Class ;
    rdfs:label "Project Nexus"@en ;
    rdfs:comment "Project Nexus is a Bank for International Settlements initiative to interlink domestic instant-payment systems across countries through a standardised hub, enabling fast, low-cost cross-border retail payments. Rather than building a single global system, it provides a common protocol that connects existing national fast-payment rails. It is relevant to discussions of cross-border CBDC interoperability and payment-system modernisation."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:cbdcs ;
    vc:slug "project-nexus" ;
    vc:sourceDomain "blockchain" .

ngm:proof-based-consensus a owl:Class ;
    rdfs:label "Proof-Based Consensus"@en ;
    rdfs:comment "Proof-Based Consensus is the family of blockchain consensus mechanisms in which participants must provide a verifiable cryptographic or computational proof to earn the right to propose or validate blocks. This family includes proof-of-work (computational puzzle), proof-of-stake (economic stake), delegated proof-of-stake, proof-of-authority, proof-of-history, and related variants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-history ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
