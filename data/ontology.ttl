ngm:non-fungible-token a owl:Class ;
    rdfs:label "Non-Fungible Token"@en ;
    rdfs:comment "A token standard in which each unit is distinct and not interchangeable, used to represent ownership of a specific digital or referenced physical item on a distributed ledger; uniqueness is enforced by a token identifier and ownership is tracked via smart-contract state."@en ;
