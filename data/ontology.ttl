        <urn:visionflow:linked:manual-room-assignment>,
        <urn:visionflow:linked:participant-assignment-interface>,
        <urn:visionflow:linked:return-to-main-signalling>,
        <urn:visionflow:linked:room-level-recording>,
        <urn:visionflow:linked:room-state-tracking>,
        <urn:visionflow:linked:timer-and-notifications> ;
    vc:implements <urn:visionflow:linked:fishbowl-dialogue>,
