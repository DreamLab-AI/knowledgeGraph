    vc:bridgesTo ngm:metaverse,
        ngm:robotic-system ;
    vc:contrastsWith ngm:asynchronous-communication,
        ngm:co-location ;
    vc:dependsOn ngm:5-g-network,
        ngm:edge-computing,
        ngm:web-rtc ;
    vc:enables ngm:immersive-experience,
