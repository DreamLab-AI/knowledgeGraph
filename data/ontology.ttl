ngm:legitimacy a owl:Class ;
    rdfs:label "Legitimacy"@en ;
    rdfs:comment "Legitimacy is the property of an authority, institution or decision being widely accepted as rightful and worthy of compliance by the people it governs. It rests on perceptions of fairness, due process, representation and shared values rather than on coercion alone, and it can be derived from procedure, performance, tradition or consent. In governance systems, including decentralised and blockchain communities, legitimacy is what makes coordinated action stable and what allows rules to be followed without constant enforcement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:governance ;
    vc:dependsOn ngm:consensus,
        ngm:transparency,
        ngm:trust ;
    vc:enables ngm:governance-model,
        ngm:stakeholder-engagement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:social-contract,
        ngm:stakeholder-trust,
        ngm:transparency ;
    vc:requires ngm:accountability,
        ngm:fairness ;
    vc:slug "legitimacy" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:community-governance,
        ngm:decentralised-governance .

