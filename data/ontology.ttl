ngm:kyc a owl:Class ;
    rdfs:label "KYC"@en ;
    rdfs:comment "Know Your Customer, the set of procedures by which a regulated entity verifies the identity of its clients and assesses associated risks before and during a business relationship, forming a cornerstone of anti-money laundering and counter-terrorist financing compliance frameworks."@en ;
