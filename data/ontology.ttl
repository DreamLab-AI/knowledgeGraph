    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:CrossAttention vcw:bridgesTo artificial-intelligence:ComputerVision .

# Causal Attention
artificial-intelligence:CausalAttention rdf:type owl:Class ;
    rdfs:label "Causal Attention"@en ;
    rdfs:comment "An attention mechanism where each position can only attend to earlier positions in the sequence, preventing information flow from future tokens, essential for autoregressive generation."@en ;
    skos:prefLabel "Causal Attention"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:causal-attention" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:causal-attention> ;
