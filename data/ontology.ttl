# Edge Computing
infrastructure:EdgeComputing rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:ComputingParadigm ;
    rdfs:label "Edge Computing"@en ;
    rdfs:comment "Distributed computing paradigm processing data close to sources of data generation rather than centralised data centres. Reduces latency, bandwidth usage, and dependency on centralised infrastructure by moving computation to network edge nodes."@en ;
    skos:prefLabel "Edge Computing"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:edge-computing" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:edge-computing> ;
    vcw:contentHash "sha256-12-000000000000" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "NGM-edge-computing" ;
    vcw:ontologyStatus "stub" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-edge-computing" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T14:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

