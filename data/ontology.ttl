    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mixed-precision-training,
        ngm:quantisation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:slug "neural-network-quantisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-discipline-model,
        ngm:pretrained-model .

ngm:odometry a owl:Class ;
    rdfs:label "Odometry"@en ;
    rdfs:comment "The estimation of a mobile robot's position and orientation (pose) over time by integrating motion measurements from wheel encoders, IMUs, or visual sensors. It provides relative position estimates based on incremental motion and is subject to cumulative drift without correction."@en ;
