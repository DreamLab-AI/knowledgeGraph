ngm:fooocus a owl:Class ;
    rdfs:label "Fooocus"@en ;
    rdfs:comment "Fooocus is an open-source desktop image-generation interface for Stable Diffusion XL released in August 2023 by Lvmin Zhang (GitHub handle lllyasviel, originator of ControlNet, IC-Light, Forge, Paints-Undo, FramePack and OmniControl), conceived as a deliberate philosophical and ergonomic reaction..."@en ;
    rdfs:subClassOf ngm:gradio-application,
        ngm:local-image-generation-interface ;
    vc:enables ngm:faceswap,
        ngm:image-to-image-translation,
        ngm:inpainting,
        ngm:local-ai-art-creation,
        ngm:outpainting,
        ngm:privacy-preserving-image-generation,
        ngm:style-transfer,
        ngm:text-to-image-generation ;
    vc:hasPart ngm:automatic-free-u-module,
        ngm:automatic-refiner-scheduler,
        ngm:faceswap-module,
        ngm:gradio-web-ui,
        ngm:image-prompt-ip-adapter-module,
        ngm:inpaint-pipeline,
        ngm:lo-ra-blending-module,
        ngm:prompt-expansion-engine,
        ngm:pyra-canny-control-net,
        ngm:style-preset-library ;
    vc:implements ngm:control-net-conditioning,
        ngm:free-u-free-lunch-rebalancing,
        ngm:ip-adapter-image-conditioning,
        ngm:latent-diffusion-sampling,
        ngm:prompt-expansion,
        ngm:sdxl-refiner-handoff ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:control-net,
        ngm:fooocus-mre,
        ngm:frame-pack,
        ngm:hugging-face-diffusers,
        ngm:ic-light,
        ngm:paints-undo,
        ngm:ruined-fooocus,
        ngm:simple-sdxl2,
        ngm:stability-ai ;
    vc:requires ngm:cuda-toolkit,
        ngm:gpu-with-4-8-gb-vram,
        ngm:gradio-framework,
        ngm:py-torch,
        ngm:python-runtime,
        ngm:stable-diffusion-xl ;
    vc:slug "fooocus" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:creative-ml-open-rail-m-licence,
        ngm:gplv3-licence,
        ngm:gradio-specification,
        ngm:hugging-face-model-hub ;
    vc:supports ngm:concept-art-workflows,
        ngm:creative-tools,
        ngm:educational-ai-demonstrations,
        ngm:indie-game-asset-creation,
        ngm:local-privacy-workflows ;
    vc:uses ngm:clip-skip,
        ngm:dpm-plus-plus-2-m-karras-sampler,
        ngm:gpt-2-prompt-expansion,
        ngm:lcm-sampler,
        ngm:lightning-sampler,
        ngm:sdxl-vae-fp16-fix .

