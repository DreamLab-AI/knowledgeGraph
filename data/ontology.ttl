ngm:kernel-fusion a owl:Class ;
    rdfs:label "Kernel Fusion"@en ;
    rdfs:comment "Kernel fusion is a compiler and runtime optimisation that merges several adjacent GPU or accelerator operations into a single executable kernel. By combining elementwise, reduction and other operators, it eliminates intermediate memory writes, reduces kernel-launch overhead and improves arithmetic intensity. It is a key technique for accelerating deep-learning training and inference on memory-bandwidth-bound hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computation-graph ],
        ngm:gpu-acceleration ;
    vc:bridgesTo ngm:parallel-computing ;
    vc:contrastsWith ngm:pruning ;
    vc:dependsOn ngm:memory-bandwidth ;
    vc:enables ngm:inference-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:operator-fusion ;
    vc:isPartOf ngm:gpu-acceleration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:tensor-core,
        ngm:throughput,
        ngm:transformer-architecture ;
    vc:requires ngm:computation-graph ;
    vc:slug "kernel-fusion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:inference-optimisation ;
    vc:uses ngm:computation-graph,
        ngm:cuda .

ngm:khronos-gl-tf a owl:Class ;
    rdfs:label "Khronos glTF"@en ;
    rdfs:comment "Khronos glTF (GL Transmission Format) is an open royalty-free specification maintained by the Khronos Group that defines a JSON-based container format for 3D scenes and models, designed for efficient runtime delivery and rendering rather than authoring — storing geometry as compact binary buffer views, referencing PBR (Physically Based Rendering) material parameters, animation data, skeletal hierarchies, and scene graphs in a format that maps closely to GPU resource layouts, minimising parse and upload overhead. glTF 2.0 (2017) established the core specification and is widely regarded as the 'JPEG of 3D' due to its adoption across web browsers (via Three.js and Babylon.js), game engines (Unreal, Unity, Godot), AR/VR runtimes (OpenXR, WebXR), and digital twin platforms."@en ;
    rdfs:subClassOf ngm:gl-tf-3-d-file-format ;
    vc:enables ngm:asset-interoperability,
        ngm:augmented-reality,
        ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gltf-standard,
        ngm:khronos-group,
        ngm:open-xr,
        ngm:physically-based-rendering,
        ngm:vulkan ;
    vc:slug "khronos-gl-tf" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:virtual-production ;
    vc:uses ngm:3-d-file-format .

ngm:knowledge-graph-publication-classifier a owl:Class ;
    rdfs:label "Knowledge Graph Publication Classifier"@en ;
    rdfs:comment "Public, as a Logseq property tag (`public:: true`), marks a knowledge-graph page as intended for external publication. In the NarrativeGoldmine ontology it acts as an access-control classifier: pages bearing this annotation are included in export pipelines targeting the open WebVOWL visualisation and the public-facing OWL2 dataset. It is a metadata concept rather than a domain-level class, functioning analogously to an access-control label within the data-governance layer."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:linked-data,
        ngm:metadata-standard ;
    vc:slug "knowledge-graph-publication-classifier" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-governance,
        ngm:knowledge-graph .

ngm:kraken a owl:Class ;
    rdfs:label "Kraken"@en ;
    rdfs:comment "Kraken is a centralised cryptocurrency exchange founded in 2011 and headquartered in the United States. It provides spot trading, margin and futures trading, staking and custody services across a wide range of digital assets and fiat currencies. It is among the longer-established exchanges and is noted for its emphasis on regulatory compliance, security and the provision of fiat on-ramps in multiple jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spot-trading ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leveraged-trading ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:financial-infrastructure,
        ngm:infra-legal-and-regulatory,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:automated-market-maker,
        ngm:decentralised-exchange ;
    vc:dependsOn ngm:blockchain-infrastructure ;
    vc:enables ngm:crypto-trading,
        ngm:fiat-on-ramp,
        ngm:futures-trading,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leveraged-trading,
        ngm:order-book,
        ngm:spot-trading,
        ngm:staking ;
    vc:implements ngm:proof-of-reserves,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crypto-asset-service-provider,
        ngm:digital-asset ;
    vc:requires ngm:custody,
        ngm:kyc-aml,
        ngm:liquidity ;
    vc:slug "kraken" ;
    vc:sourceDomain "blockchain" .

ngm:kto a owl:Class ;
    rdfs:label "KTO"@en ;
    rdfs:comment "KTO (Kahneman-Tversky Optimization) is a method for aligning language models that learns from binary good or bad feedback on individual outputs rather than paired preference comparisons. Drawing on prospect theory, it defines a utility-based loss that down-weights losses relative to gains, simplifying data collection compared with preference-pair methods. It is an alternative to direct preference optimization in the post-training alignment toolkit."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimization,
        ngm:model-training ;
    vc:slug "kto" ;
    vc:sourceDomain "ai" .

ngm:kyoto-protocol a skos:Concept ;
    rdfs:label "Kyoto Protocol"@en .

ngm:labelled-data a skos:Concept ;
    rdfs:label "Labelled Data"@en .

ngm:lambda-architecture a owl:Class ;
    rdfs:label "Lambda Architecture"@en ;
    rdfs:comment "Lambda Architecture is a data-processing design pattern that handles massive quantities of data by combining a batch layer for comprehensive, accurate computation over the full dataset with a speed (or streaming) layer that processes recent data with low latency. A serving layer merges results from both layers so queries return a unified view that is eventually consistent yet responsive in near real time. The pattern accepts the operational cost of maintaining two parallel code paths in exchange for fault tolerance, reprocessing capability, and the reconciliation of historical accuracy with live freshness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scalability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-warehouse ],
        ngm:data-architecture ;
    vc:contrastsWith ngm:event-sourcing ;
    vc:enables ngm:fault-tolerance,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-processing,
        ngm:data-pipeline,
        ngm:stream-processing ;
    vc:isPartOf ngm:big-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:etl-pipeline ;
    vc:requires ngm:data-warehouse,
        ngm:scalability ;
    vc:slug "lambda-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:apache-kafka,
        ngm:apache-spark,
        ngm:data-lake .

ngm:language-model-alignment a owl:Class ;
    rdfs:label "Language Model Alignment"@en ;
    rdfs:comment "Language model alignment is the set of techniques used to make a language model's behaviour conform to human intentions, values and safety constraints. It typically follows pretraining with supervised fine-tuning and preference-based optimisation so that outputs are helpful, honest and harmless. Methods include reinforcement learning from human feedback and direct preference optimization."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimization,
        ngm:large-language-models ;
    vc:slug "language-model-alignment" ;
    vc:sourceDomain "ai" .

ngm:language-translation a owl:Class ;
    rdfs:label "Language Translation"@en ;
    rdfs:comment "Language translation is the automated or human-assisted conversion of text or speech from a source language into a target language whilst preserving semantic meaning, tone, and cultural context. Modern neural machine translation systems, built on transformer architectures and large language models, enable real-time multilingual communication across distributed collaboration platforms and metaverse environments."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:localization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:machine-translation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-collaboration ;
    vc:slug "language-translation" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:transformer .

ngm:laser-scanner a owl:Class ;
    rdfs:label "Laser Scanner"@en ;
    rdfs:comment "A Laser Scanner is a sensor that emits laser pulses and measures the time-of-flight or phase-shift of the returned signal to compute precise distance measurements across a scene, generating dense point clouds. In robotics and spatial computing, laser scanners serve as primary perception instruments for environment mapping, obstacle detection, and the construction of digital twins via LiDAR-based SLAM pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:point-cloud,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:sensor-fusion ;
    vc:slug "laser-scanner" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar .

ngm:latency-optimisation a owl:Class ;
    rdfs:label "Latency Optimisation"@en ;
    rdfs:comment "Latency optimisation is the set of techniques used to minimise the time between a request and its corresponding response in networked and distributed systems. It targets propagation, processing, queueing, and serialisation delays through measures such as edge placement, caching, protocol tuning, and concurrency. Low latency is critical for real-time communication, interactive collaboration, and responsive user experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:bandwidth-adaptation,
        ngm:distributed-systems ;
    vc:dependsOn ngm:content-delivery-network,
        ngm:edge-computing ;
    vc:enables ngm:real-time,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:distributed-collaboration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-latency,
        ngm:throughput ;
    vc:requires ngm:monitoring,
        ngm:observability ;
    vc:slug "latency-optimisation" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:quality-of-service,
        ngm:user-experience ;
    vc:uses ngm:caching,
        ngm:cdn .

ngm:layer-normalization a owl:Class ;
    rdfs:label "Layer Normalization"@en ;
    rdfs:comment "A neural network technique that normalises the activations across the features of a single training example, stabilising and accelerating training. It is widely used in transformer architectures where it normalises each token's representation independently of the batch."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:neural-network ;
    vc:enables ngm:transformer-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:activation-function ;
    vc:slug "layer-normalization" ;
    vc:sourceDomain "machine-learning" .

ngm:layer2-scaling a owl:Class ;
    rdfs:label "Layer2Scaling"@en ;
    rdfs:comment "Off-chain scaling solutions executing transactions on secondary networks ({{Rollups}}, PaymentChannels, {{Sidechains}}) that batch and settle to base layer (ereum mainnet), reducing transaction costs 100-1000x whilst maintaining security through CryptographicProof|cryptographic proofs."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-scalability ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "layer2-scaling" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof .

ngm:ldp-container a owl:Class ;
    rdfs:label "LDP Container"@en ;
    rdfs:comment "An LDP Container is a resource defined by the W3C Linked Data Platform specification that groups and manages other linked-data resources, exposing them through HTTP affordances for creation, retrieval, and deletion. Containers come in basic, direct, and indirect variants that differ in how membership triples are generated. They provide the hierarchical, REST-like structure that Solid pods and other LDP servers use to organise data."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:solid,
        ngm:solid-pod ;
    vc:slug "ldp-container" ;
    vc:sourceDomain "data" .

ngm:lead-screw-actuator a owl:Class ;
    rdfs:label "Lead Screw Actuator"@en ;
    rdfs:comment "A linear actuation mechanism that converts rotational motion from a motor into controlled axial displacement by driving a threaded nut along a precision-cut helical screw shaft. Lead screw actuators provide high mechanical advantage, inherent load-holding capability (due to the self-locking property when lead angle is below the friction angle), and positional repeatability, making them widely used in CNC machines, 3D printers, robotic joints, and medical devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanical-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:electric-linear-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:pid-controller ;
    vc:enables ngm:industrial-robot,
        ngm:torque-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:mechanical-component ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robotics-control,
        ngm:robotics-systems ;
    vc:slug "lead-screw-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:servo-motor,
        ngm:stepper-motor,
        ngm:torque .

ngm:learning-resources a owl:Class ;
    rdfs:label "Learning Resources"@en ;
    rdfs:comment "Educational materials and content designed for delivery through VR, AR, and metaverse platforms, including 3D models, interactive simulations, virtual environments, and AI-generated adaptive content for immersive learning experiences."@en ;
