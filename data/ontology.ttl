            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-notice ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:provenance-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-origin-declaration ],
        ngm:ai-governance-and-ethics,
        ngm:ai-transparency-framework ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:informed-consent,
        ngm:regulatory-compliance,
        ngm:trust-building,
        ngm:user-awareness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-origin-declaration,
