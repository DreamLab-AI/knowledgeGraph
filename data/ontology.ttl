        ngm:model-debugging ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:slug "confusion-matrix" ;
    vc:sourceDomain "spatial-computing" .

ngm:content-authentication a owl:Class ;
    rdfs:label "Content Authentication"@en ;
    rdfs:comment "Content Authentication is the process of verifying the origin, integrity, and provenance of digital content through cryptographic techniques such as digital signatures, watermarking, and blockchain-anchored certificates. It enables consumers and platforms to distinguish authentic content from synthetically generated or tampered media, particularly critical as generative AI proliferates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:digital-rights-management ;
    vc:requires ngm:cryptographic-verification,
        ngm:digital-signature ;
    vc:slug "content-authentication" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:blockchain,
        ngm:watermarks .

ngm:content-creation-pipeline a owl:Class ;
    rdfs:label "Content Creation Pipeline"@en ;
    rdfs:comment "A Content Creation Pipeline is an automated or semi-automated workflow that orchestrates the sequential and parallel stages of producing digital content—including ideation, scripting, asset generation, editing, quality assurance, and distribution—into a reproducible, scalable production system. In modern contexts, these pipelines integrate AI generation models, human editorial review, digital asset management, and multi-platform publishing endpoints, enabling high-throughput content production at reduced per-unit cost."@en ;
    rdfs:subClassOf ngm:content-creation ;
    vc:enables ngm:metaverse-content-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-content-creation,
        ngm:media-production,
        ngm:video-production-pipeline ;
    vc:slug "content-creation-pipeline" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:content-creation-tool .

ngm:content-production-workflow a owl:Class ;
    rdfs:label "Content Production Workflow"@en ;
    rdfs:comment "A structured sequence of stages and toolchain integrations through which raw creative inputs are transformed into publishable digital assets, covering pre-production, asset authoring, review, rendering, and distribution. In spatial computing contexts, such workflows incorporate 3D asset pipelines, real-time rendering checks, and version-controlled delivery to metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-content-creation,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:metaverse-content-pipeline ;
    vc:slug "content-production-workflow" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:generative-ai .

ngm:controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "A Controller is a computational module in a robotic or cyber-physical system that receives sensor feedback and reference setpoints, applies a control law or learned policy, and generates actuator commands that drive the system towards desired states. Controllers range from classical linear regulators (PID, LQR) to nonlinear model-based controllers (Model Predictive Control) and data-driven approaches (neural network policies, reinforcement learning). They operate within a closed-loop feedback architecture where the difference between desired and measured states — the error signal — drives corrective action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:feedback-loop ;
    vc:slug "controller" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller .

ngm:copyright a owl:Class ;
    rdfs:label "copyright"@en ;
    rdfs:comment "A legal right granting creators exclusive control over reproduction, distribution, adaptation, and public performance of original works for a defined term. In AI and metaverse contexts, copyright raises contested questions about ownership of AI-generated content, the legality of training data ingestion, and rights management for user-created assets within virtual platforms."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:legal-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:ai-governance ;
    vc:contrastsWith ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-rights,
        ngm:digital-rights-management ;
    vc:slug "copyright" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:legal-compliance .

ngm:crm a owl:Class ;
    rdfs:label "CRM"@en ;
    rdfs:comment "Customer Relationship Management (CRM) is a category of enterprise software and associated business processes that centralises the storage, tracking, and analysis of all interactions between an organisation and its customers, prospects, and partners across the full sales, marketing, and service lifecycle. A CRM system provides a shared record of each contact and account, enabling sales pipelines, service-case management, marketing campaign tracking, and analytical reporting from a single platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:crm-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:crm-systems ],
        ngm:enterprise-software-platform ;
    vc:enables ngm:customer-experience-management,
        ngm:customer-support-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:crm-integration,
        ngm:crm-systems ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:customer-data-platform,
        ngm:omnichannel ;
    vc:slug "crm" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:enterprise-workflow .

ngm:cross-attention a owl:Class ;
    rdfs:label "Cross Attention"@en ;
    rdfs:comment "An attention mechanism where queries come from one sequence whilst keys and values come from a different sequence, enabling information flow between the encoder and decoder in sequence-to-sequence models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-key-value ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:self-attention ;
    vc:enables ngm:multimodal-ai,
        ngm:multimodal-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:query-key-value ;
    vc:slug "cross-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:data-augmentation-strategies a owl:Class ;
    rdfs:label "Data Augmentation Strategies"@en ;
    rdfs:comment "Techniques that create modified versions of training examples to increase dataset diversity and model robustness. Data augmentation strategies apply transformations that preserve label semantics whilst introducing variation, improving generalisation and reducing overfitting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-pipeline ;
    vc:requires ngm:training-data ;
    vc:slug "data-augmentation-strategies" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:overfitting ;
    vc:uses ngm:generative-ai .

ngm:data-format a owl:Class ;
    rdfs:label "Data Format"@en ;
    rdfs:comment "Data Format defines the structural and encoding specification by which data is stored, transmitted, and interpreted between systems. Formats span binary serialisation (Protocol Buffers, Avro), text-based interchange (JSON, JSON-LD, XML), domain-specific schemas (DICOM, glTF), and columnar storage formats (Parquet). Format choice determines interoperability scope, parsing overhead, and compatibility with downstream processing pipelines."@en ;
    rdfs:subClassOf ngm:data-standards,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-interoperability,
        ngm:data-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:data-standards ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:json-ld,
        ngm:linked-data ;
    vc:slug "data-format" ;
    vc:sourceDomain "infrastructure" .

ngm:data-persistence a owl:Class ;
    rdfs:label "Data Persistence"@en ;
    rdfs:comment "Data Persistence is the property of data surviving beyond the lifetime of the process or session that created it, and the collection of mechanisms and design patterns — relational databases, distributed file systems, append-only event logs, object stores — that guarantee this durability. In transactional systems, persistence is formalised through the ACID properties (Atomicity, Consistency, Isolation, Durability), where durability specifically ensures committed transactions are not lost even in the event of system failure. Beyond single-node databases, distributed systems trade aspects of consistency for availability and partition tolerance as described in the CAP theorem, leading to a spectrum of persistence strategies from strongly consistent RDBMS to eventually consistent distributed key-value stores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-system ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:replication-system ;
    vc:requires ngm:database-system,
        ngm:distributed-system ;
    vc:slug "data-persistence" ;
    vc:sourceDomain "infrastructure" .

ngm:decentralized-application a owl:Class ;
    rdfs:label "Decentralized Application"@en ;
    rdfs:comment "A decentralized application (dApp) is a software application whose backend logic runs on a blockchain or peer-to-peer network rather than on centralised servers controlled by a single entity, ensuring that no single party can unilaterally modify, censor, or shut down the application. The on-chain components — typically smart contracts — enforce business logic and state transitions transparently, while user-facing frontends may remain conventional web or mobile interfaces that communicate with the blockchain via wallet connectors. dApps inherit the censorship resistance and trustlessness of their underlying blockchain while exposing usability challenges related to transaction costs, latency, and key management."@en ;
    rdfs:subClassOf ngm:blockchain-application ;
    vc:enables ngm:blockchain-governance,
        ngm:dao,
        ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:de-fi,
        ngm:smart-contract,
        ngm:web3 ;
    vc:slug "decentralized-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:evm,
        ngm:smart-contract-platform .

ngm:demand-forecasting a owl:Class ;
    rdfs:label "Demand Forecasting"@en ;
    rdfs:comment "Demand forecasting is the analytical process of estimating future customer demand for products or services over a specified time horizon using historical sales data, statistical models, and increasingly machine learning algorithms. Accurate demand forecasts drive inventory replenishment, capacity planning, production scheduling, and financial budgeting decisions across retail, manufacturing, logistics, and energy sectors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forecast-horizon ],
        ngm:predictive-analytics ;
    vc:enables ngm:demand-planning,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:forecast-horizon ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimisation,
        ngm:supply-chain ;
    vc:slug "demand-forecasting" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning .

ngm:diagrams-as-code a owl:Class ;
    rdfs:label "Diagrams as Code"@en ;
    rdfs:comment "Diagrams as Code (DaC) is a software-engineering discipline and tooling category in which technical diagrams (architecture, sequence, state, deployment, entity-relationship, Gantt, wireframe, timing, dataflow) are authored as plain-text source artefacts in a constrained, machine-readable grammar ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layout-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:renderer ],
