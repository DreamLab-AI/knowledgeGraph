ngm:gpu-rendering a owl:Class ;
    rdfs:label "GPU Rendering"@en ;
    rdfs:comment "GPU rendering is the computation of images from 2D or 3D scene descriptions using the massively parallel processing units of a graphics processing unit rather than the CPU. By executing shading, rasterisation, and ray-tracing workloads across thousands of cores, it delivers real-time interactive graphics and accelerates offline rendering. It is foundational to game engines, visualisation, and digital-content creation tools."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:animation-software,
        ngm:unreal-engine ;
    vc:slug "gpu-rendering" ;
    vc:sourceDomain "metaverse" .

ngm:hardware-abstraction a owl:Class ;
    rdfs:label "Hardware Abstraction"@en ;
    rdfs:comment "Hardware Abstraction is the software engineering principle and architectural practice of interposing a uniform programmatic interface layer between high-level software and the physical characteristics of underlying hardware components, enabling software to operate independently of specific hardware implementations. The abstraction layer translates generic API calls into vendor-specific or device-specific commands, shielding operating systems, runtimes, and applications from the diversity of processor architectures, memory subsystems, I/O controllers, graphics units, and peripheral devices. This principle underpins portability, vendor independence, and long-term maintainability of system software stacks across the full spectrum of computing platforms, from embedded microcontrollers to cloud server farms to spatial-computing headsets. Hardware Abstraction Layers (HALs) are the canonical realisation of this principle in operating systems, device driver frameworks, and graphics APIs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:device-drivers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:device-drivers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-abstraction-layer-hal ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instruction-set-architecture ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:ai-accelerator,
        ngm:spatial-computing,
        ngm:webgpu ;
    vc:contrastsWith ngm:bare-metal-programming ;
    vc:enables ngm:cross-platform-development,
        ngm:operating-system,
        ngm:portability,
        ngm:virtualisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:device-drivers,
        ngm:hardware-abstraction-layer-hal ;
    vc:implements ngm:application-programming-interface,
        ngm:posix ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:hardware,
        ngm:memory-management ;
    vc:requires ngm:device-drivers,
        ngm:firmware,
        ngm:instruction-set-architecture ;
    vc:slug "hardware-abstraction" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
