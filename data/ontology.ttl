ngm:community-governance a owl:Class ;
    rdfs:label "Community Governance"@en ;
    rdfs:comment "Community Governance refers to the structures, processes, and norms through which a community of stakeholders collectively makes decisions, allocates resources, resolves disputes, and sets rules for shared systems or commons. It encompasses formal mechanisms such as voting protocols, proposal systems, and constitutional rules, as well as informal norms of participation, legitimacy, and accountability. Community governance may be implemented on-chain through smart contracts and token-weighted voting in decentralised autonomous organisations, or off-chain through forum deliberation, elected councils, and working groups in open-source projects, platform cooperatives, and public institutions. The field draws on political science, institutional economics, commons theory, and distributed systems to design governance models that are simultaneously legitimate, efficient, and resistant to capture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dispute-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proposal-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:treasury-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-mechanism ],
        ngm:decentralised-governance ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:blockchain,
        ngm:digital-commons ;
    vc:contrastsWith ngm:centralised-control,
        ngm:corporate-governance ;
    vc:dependsOn ngm:legitimacy,
        ngm:social-contract ;
    vc:enables ngm:collective-decision-making,
        ngm:commons-management,
        ngm:protocol-upgrade ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dispute-resolution,
        ngm:proposal-system,
        ngm:treasury-management,
        ngm:voting-mechanism ;
    vc:isPartOf ngm:decentralised-governance,
        ngm:institutional-design ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:metagovernance,
        ngm:ostrom-principles,
        ngm:rough-consensus ;
    vc:requires ngm:accountability-mechanisms,
        ngm:consensus-mechanism,
        ngm:stakeholder-participation ;
    vc:slug "community-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:decentralised-autonomous-organisation,
        ngm:open-source-project,
        ngm:platform-cooperative ;
    vc:uses ngm:multisig-wallet,
        ngm:quadratic-voting,
        ngm:smart-contract,
        ngm:token-voting .

