        vf:eye-tracking,
        vf:hand-tracking,
        vf:human-tracking-and-slam-capture,
        vf:point-cloud,
        vf:slam ;
    vc:hasPart vf:camera,
        vf:camera-parameters,
        vf:imaging-parameters,
        vf:infrared-camera,
        vf:infrared-led-illuminator,
        vf:infrared-light-source,
        vf:infrared-sensor,
