ngm:validity-proof a owl:Class ;
    rdfs:comment "A validity proof is a cryptographic proof, typically a succinct zero-knowledge proof, that attests that a batch of state transitions was computed correctly according to the rules of a system. In layer-2 rollups it allows a base chain to accept a compressed state update after verifying a single proof, without re-executing the underlying transactions. Validity proofs give immediate, trustless finality in contrast to optimistic schemes that rely on fraud challenges."@en ;
    rdfs:label "Validity Proof"@en ;
    rdfs:subClassOf ngm:cryptographic-proof-system ;
