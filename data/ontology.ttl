    vc:slug "traditional-carbon-registry" ;
    vc:sourceDomain "metaverse" .

ngm:training-methods a owl:Class ;
    rdfs:label "Training Methods"@en ;
    rdfs:comment "Training Methods encompass the algorithms and procedures used to optimise machine learning model parameters against training data, including supervised, unsupervised, semi-supervised, reinforcement, transfer, curriculum, and contrastive learning paradigms. The choice of method fundamentally determines model capability, data efficiency, and generalisation behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transfer-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:contrastive-learning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
