    vc:implements ngm:standards-body ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ietf ;
    vc:relatedTo ngm:iso ;
    vc:requires ngm:decision-making ;
    vc:requires ngm:deliberation ;
    vc:requires ngm:stakeholder-engagement ;
