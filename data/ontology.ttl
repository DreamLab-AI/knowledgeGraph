ngm:robotics-process a owl:Class ;
    rdfs:label "Robotics Process"@en ;
    rdfs:comment "A Robotics Process encompasses the systematic procedures, methodologies, and workflows for robot development, deployment, operation, and maintenance, spanning requirements engineering, system design, hardware-software integration, verification and validation, commissioning, and lifecycle management. Agile and iterative development methods accommodate uncertainty and enable rapid prototyping; simulation-driven approaches using digital twins support virtual commissioning. Compliance with process standards such as ISO 9001 and IEC 61508 is required for safety-critical robotic applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:robot-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:systems-engineering ;
    vc:requires ngm:functional-safety ;
    vc:slug "robotics-process" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:digital-twin,
        ngm:formal-verification .

ngm:robustness-oecd a owl:Class ;
    rdfs:label "Robustness (OECD)"@en ;
    rdfs:comment "The OECD Robustness principle (Principle 1.4, revised 2024) mandates that AI systems function reliably and securely throughout their lifecycle, demonstrating resilience against errors, faults, distributional inconsistencies, and adversarial attempts to alter system use or performance. It requires continuous risk assessment covering statistical robustness, fault tolerance, and adversarial resistance, and connects to the EU AI Act Article 15 technical requirements. Providers are responsible for design and testing; deployers are responsible for ongoing monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai-principles ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:trustworthy-ai-framework ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:safety-oecd ;
    vc:requires ngm:adversarial-testing ;
    vc:slug "robustness-oecd" ;
    vc:sourceDomain "spatial-computing" .

ngm:root-mean-square-error a owl:Class ;
    rdfs:label "Root Mean Square Error"@en ;
    rdfs:comment "A regression performance metric representing the square root of the average squared differences between predicted and actual values, calculated by taking the mean of squared prediction errors and then applying the square root, providing a measure of prediction accuracy in the same units as the ta..."@en ;
    rdfs:subClassOf ngm:mean-absolute-error,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:mean-absolute-error ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:overfitting,
        ngm:training ;
    vc:slug "root-mean-square-error" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:model-evaluation-results,
        ngm:model-performance ;
    vc:uses ngm:gradient-descent,
        ngm:loss-function .

ngm:rule-of-law a owl:Class ;
    rdfs:label "Rule of Law"@en ;
    rdfs:comment "The constitutional and institutional principle that all persons, institutions, and entities—including AI systems and their operators—are accountable to laws that are publicly promulgated, equally enforced, independently adjudicated, and consistent with international human rights norms. Applied to AI governance, the rule of law requires legal certainty, non-arbitrary decision-making, procedural fairness, and effective remedies for AI-related harms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:infra-legal-and-regulatory,
        ngm:legal-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:compliance-framework ;
    vc:requires ngm:accountability,
        ngm:legal-framework ;
    vc:slug "rule-of-law" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-ethics,
        ngm:democratic-values,
        ngm:human-rights .

ngm:runtime-inspection a owl:Class ;
    rdfs:label "Runtime Inspection"@en ;
    rdfs:comment "Runtime Inspection is the practice of dynamically examining the internal state, activations, attention patterns, and behavioural properties of an AI model while it is executing inference, as opposed to static analysis of weights or architecture prior to deployment. It enables detection of unexpected or dangerous reasoning paths, verification of safety constraints during live operation, and post-hoc explanation of individual predictions by observing intermediate computations at the moment they occur."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        ngm:ai-governance,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-safety,
        ngm:explainable-ai,
        ngm:formal-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
