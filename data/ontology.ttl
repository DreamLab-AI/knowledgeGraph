        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        owl:Thing ;
    vc:bridgesTo ngm:ai-assisted-collaboration,
        ngm:decentralised-autonomous-organisation,
        ngm:distributed-systems,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:centralised-workflow,
