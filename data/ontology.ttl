ngm:mipmap a owl:Class ;
    rdfs:comment "A precomputed pyramid of progressively half-resolution versions of a texture image, from full size down to a single texel, from which the graphics pipeline selects (and trilinearly blends between) the level whose texel density best matches the on-screen footprint of the surface being shaded; introduced by Lance Williams in 1983, mipmapping eliminates minification aliasing and shimmer, improves texture-cache coherence, and costs only one third more memory than the base image."@en ;
    rdfs:label "Mipmap"@en ;
    rdfs:subClassOf ngm:texture-map ;
