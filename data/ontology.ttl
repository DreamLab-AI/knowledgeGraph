    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-interoperability ;
    vc:uses ngm:cross-chain-interoperability ;
    vc:uses ngm:cross-chain-messaging .
ngm:omnichannel a owl:Class ;
    rdfs:comment "Omnichannel is a customer engagement strategy that unifies all interaction channels — physical stores, web, mobile, social media, telephone, and messaging — into a single, consistent experience in which customer context and history transfer seamlessly across channel boundaries. Unlike multichannel approaches that operate channels in silos, omnichannel architectures share a common data layer and orchestration engine so that a session started on one channel can be continued on another without loss of state."@en ;
    rdfs:label "Omnichannel"@en ;
    rdfs:subClassOf ngm:customer-experience-management ;
    rdfs:subClassOf _:r15690 ;
    vc:enables ngm:customer-experience ;
    vc:enables ngm:customer-retention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crm ;
    vc:relatedTo ngm:omnichannel-routing ;
    vc:requires ngm:customer-data-platform ;
    vc:slug "omnichannel" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:conversational-ai .
ngm:omnichannel-orchestration a skos:Concept ;
    rdfs:label "Omnichannel Orchestration"@en .
ngm:omnichannel-routing a owl:Class ;
    rdfs:comment "Omnichannel routing is the contact-centre capability that directs customer interactions arriving across multiple channels, such as voice, chat, email, and social, to the most appropriate agent or automated handler using a unified queue and context. It maintains a single view of each customer's history so conversations can move between channels without loss of context. It is central to consistent, efficient customer service operations."@en ;
    rdfs:label "Omnichannel Routing"@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
