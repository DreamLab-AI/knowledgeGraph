        ngm:ice-protocol,
        ngm:rtcdata-channel,
        ngm:rtcpeer-connection,
        ngm:sdp-offer-answer,
        ngm:stun-server,
        ngm:turn-server ;
    vc:implements ngm:dtls-srtp-rfc-5764,
        ngm:ietf-rtcweb-standards,
        ngm:w3-c-web-rtc-1-0-specification ;
    vc:isPartOf ngm:telecollaboration-stack,
        ngm:video-conferencing-platform ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:dtls-srtp-encryption,
