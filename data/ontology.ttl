        ngm:mlops ;
    vc:uses ngm:adversarial-testing,
        ngm:formal-verification,
        ngm:regression-testing,
        ngm:static-analysis .

ngm:sparql a owl:Class ;
    rdfs:label "SPARQL"@en ;
    rdfs:comment "SPARQL (SPARQL Protocol and RDF Query Language) is a W3C Recommendation defining a query language, update language, and HTTP-based protocol for retrieving and modifying data stored in RDF graph databases and Linked Data endpoints. SPARQL 1.1 (2013) introduced federated queries across multiple remote endpoints via the SERVICE keyword, property paths for graph traversal, aggregation functions, and the SPARQL Update (SPARUL) sublanguage for graph mutation. It serves as the standard access layer for the Semantic Web and knowledge graph ecosystems, occupying a role analogous to SQL for relational databases. The four primary query forms — SELECT, CONSTRUCT, ASK, and DESCRIBE — provide flexible mechanisms for retrieving variable bindings, materialising derived graphs, testing graph patterns, and describing resources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:knowledge-graph-embedding,
        ngm:large-language-model ;
    vc:contrastsWith ngm:cypher-query-language,
        ngm:graphql,
        ngm:sql ;
    vc:enables ngm:federated-query,
        ngm:knowledge-graph-construction,
        ngm:linked-data,
        ngm:ontology-reasoning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:open-world-assumption,
        ngm:semantic-web ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:apache-jena,
        ngm:json-ld,
        ngm:knowledge-graph,
        ngm:turtle-syntax ;
    vc:requires ngm:graph-database,
        ngm:rdf,
        ngm:sparql-endpoint ;
    vc:slug "sparql" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3c ;
    vc:supports ngm:owl-ontology,
        ngm:shacl,
        ngm:wikidata ;
    vc:uses ngm:graph-pattern-matching,
        ngm:http-protocol,
        ngm:property-path,
        ngm:triple-pattern .

ngm:state-estimation a owl:Class ;
    rdfs:label "State Estimation"@en ;
    rdfs:comment "State Estimation is the computational discipline of inferring the latent, unobservable internal state of a dynamical system — such as position, velocity, orientation, and joint angles — from a sequence of noisy, incomplete sensor measurements, using probabilistic inference frameworks. Core algorithms include the Kalman Filter and its nonlinear extensions (EKF, UKF), particle filters, and factor-graph optimisation methods that maintain a belief distribution over state variables over time. The field underpins autonomous navigation, robotic manipulation, aerospace guidance systems, and any cyber-physical system that must act on estimated rather than directly observed quantities. Modern formulations unify Bayesian filtering, maximum-a-posteriori smoothing, and deep-learning-based perception to achieve robust estimation under sensor failure, model mismatch, and adversarial environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:extended-kalman-filter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:particle-filter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kalman-filter ],
        ngm:probabilistic-inference ;
    vc:bridgesTo ngm:deep-learning,
        ngm:digital-twin ;
    vc:contrastsWith ngm:deterministic-control,
        ngm:open-loop-control ;
    vc:dependsOn ngm:bayesian-inference,
        ngm:linear-algebra,
        ngm:stochastic-processes ;
    vc:enables ngm:autonomous-systems,
        ngm:navigation,
        ngm:robot-control,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:extended-kalman-filter,
        ngm:factor-graph,
        ngm:kalman-filter,
        ngm:particle-filter ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:path-planning,
        ngm:robot-dynamics,
        ngm:signal-processing ;
    vc:requires ngm:imu,
        ngm:probabilistic-models,
        ngm:sensor-fusion,
        ngm:system-dynamics ;
    vc:slug "state-estimation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:gps,
        ngm:lidar,
        ngm:visual-odometry,
        ngm:wheel-odometry .

ngm:asset-management a owl:Class ;
