ngm:sustainable-consensus a owl:Class ;
    rdfs:label "Sustainable Consensus"@en ;
    rdfs:comment "Sustainable consensus mechanisms are distributed agreement protocols designed for [[Blockchain Network|blockchain]] and distributed ledger systems that achieve Byzantine fault-tolerant finality whilst minimising energy consumption, carbon emissions, and physical resource expenditure—contrasting s..."@en ;
    rdfs:subClassOf ngm:climate-technology,
        ngm:energy-efficient-computing ;
    vc:enables ngm:carbon-neutral-blockchain,
        ngm:esg-compliant-blockchain,
        ngm:green-bond-settlement,
        ngm:institutional-de-fi-adoption,
        ngm:low-cost-transaction-processing,
        ngm:scalable-dlt-infrastructure ;
    vc:hasPart ngm:algorand-pure-proof-of-stake,
        ngm:avalanche-snow-consensus,
        ngm:block-proposer-selection,
        ngm:hot-stuff-bft,
        ngm:proof-of-authority,
        ngm:proof-of-history,
        ngm:proof-of-space,
        ngm:proof-of-space-time,
        ngm:proof-of-stake,
        ngm:slashing-condition,
        ngm:tendermint,
        ngm:tezos-liquid-proof-of-stake,
        ngm:validator-set ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:delegated-staking,
        ngm:economic-slashing,
        ngm:instant-finality-bft,
        ngm:nakamoto-style-probabilistic-finality,
        ngm:randomised-leader-election ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:blockchain-interoperability,
        ngm:carbon-credit-tracking,
        ngm:carbon-footprint-measurement,
        ngm:de-fi,
        ngm:esg-investing,
        ngm:layer-2-scaling ;
    vc:requires ngm:cryptographic-sortition,
        ngm:finality-gadget,
        ngm:fork-choice-rule,
        ngm:peer-to-peer-network,
        ngm:stake-locking,
        ngm:validator-economics ;
    vc:slug "sustainable-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bis-green-finance-standards,
        ngm:ccri-energy-benchmarks,
        ngm:cosmos-ibc-specification,
        ngm:crypto-climate-accord,
        ngm:eip-3675-ethereum-po-s,
        ngm:iso-14064-ghg-protocol ;
    vc:supports ngm:carbon-credit-tracking,
        ngm:crypto-climate-accord,
        ngm:decentralised-finance,
        ngm:green-finance,
        ngm:regulatory-compliance,
        ngm:smart-contract-platforms ;
    vc:uses ngm:bls-signature-aggregation,
        ngm:elliptic-curve-cryptography,
        ngm:merkle-trees,
        ngm:storage-proofs,
        ngm:threshold-cryptography,
        ngm:verifiable-random-function .

