    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:operating-system ;
    vc:uses ngm:cache .

ngm:credential-schema a owl:Class ;
    rdfs:label "Credential Schema"@en ;
    rdfs:comment "A Credential Schema is a machine-readable, versioned specification — typically expressed in JSON Schema or a JSON-LD vocabulary — that defines the mandatory and optional claims, data types, cardinality constraints, and value ranges permissible within a Verifiable Credential. Schemas function as a binding contract between credential issuers, holders, and verifiers: the issuer populates claims in conformance with a declared schema, the holder's identity wallet stores schema metadata alongside the credential, and the verifier resolves and validates the credential's structure against the schema before applying trust policy decisions. Schemas are published at stable, resolvable URIs and are referenced from the credentialSchema property defined in the W3C Verifiable Credentials Data Model; in AnonCreds ecosystems they are written to a Verifiable Data Registry, making them tamper-evident and globally discoverable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifier ],
        ngm:decentralised-identity ;
    vc:bridgesTo ngm:data-governance,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:access-control-policy,
        ngm:credential-format-standard ;
    vc:enables ngm:interoperability,
        ngm:selective-disclosure,
        ngm:verifiable-credential-vc,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:credential-definition ;
    vc:implements ngm:sd-jwt-vc ;
    vc:isPartOf ngm:self-sovereign-identity,
        ngm:trust-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:metadata-schema,
        ngm:ontology,
        ngm:schema-registry ;
    vc:requires ngm:decentralised-identifier,
        ngm:verifiable-data-registry ;
    vc:slug "credential-schema" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:hyperledger-aries,
        ngm:open-id-foundation,
        ngm:w3-c ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:json-data-interchange-format-ld,
