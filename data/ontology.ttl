    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:standards ;
    vc:enables ngm:audit-trail,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compliance-framework,
        ngm:regulatory-framework ;
    vc:slug "standards-compliance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compliance-monitoring,
        ngm:compliance-verification .

ngm:state-space a owl:Class ;
    rdfs:label "State Space"@en ;
    rdfs:comment "A state space is the mathematical set of all possible configurations (states) of a dynamical system, together with the transition rules that govern how the system evolves from one state to another over time. In control theory it is represented by first-order differential or difference equations relating state variables, inputs, and outputs; in artificial intelligence it denotes the complete set of system configurations that a search or planning algorithm may explore."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:enables ngm:optimal-control,
        ngm:reinforcement-learning,
        ngm:system-identification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:recurrent-neural-network,
        ngm:time-series-analysis ;
    vc:slug "state-space" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:state-observer ;
    vc:uses ngm:hidden-state,
        ngm:kalman-filter,
        ngm:state-estimation .

ngm:stereo-camera a owl:Class ;
    rdfs:label "Stereo Camera"@en ;
    rdfs:comment "A dual-lens imaging system that captures two horizontally offset images of a scene to compute disparity maps and recover metric 3D depth information. Stereo cameras are widely used in robotic navigation, obstacle avoidance, and spatial mapping because they provide passive depth sensing without emitting light."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:camera ;
    vc:enables ngm:object-detection,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:monocular-camera,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:visual-odometry ;
    vc:slug "stereo-camera" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera-parameters .

ngm:stranded-energy-monetisation a owl:Class ;
    rdfs:label "Stranded Energy Monetisation"@en ;
    rdfs:comment "Stranded energy monetisation is the practice of converting otherwise wasted or non-transmittable electricity—including curtailed renewable generation, flared natural gas, and grid-overflow surplus—into economic value through flexible, interruptible load processes such as Bitcoin mining or electrolyser hydrogen production. By co-locating computation or industrial loads at the energy source, it captures value that cannot reach load centres due to grid constraints."@en ;
    rdfs:subClassOf ngm:stranded-energy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:demand-response-mining,
        ngm:methane-mitigation-mining ;
    vc:slug "stranded-energy-monetisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:demand-response,
        ngm:methane-abatement .

ngm:super-resolution a owl:Class ;
    rdfs:label "Super Resolution"@en ;
    rdfs:comment "Super-Resolution is the process of enhancing the resolution and quality of low-resolution images by predicting and synthesising high-frequency details using deep learning models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        ngm:sc-display-and-rendering ;
