            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:namespace-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-model ],
