ngm:reprojection-error a owl:Class ;
    rdfs:comment "Reprojection error is the geometric distance, in image pixels, between an observed feature point and the position predicted by projecting its estimated three-dimensional point back through the estimated camera model. It serves as the primary residual minimised in camera calibration, pose estimation and bundle adjustment, where the sum of squared reprojection errors quantifies how well the reconstructed geometry explains the measurements. Low reprojection error indicates a consistent, well-calibrated reconstruction."@en ;
    rdfs:label "Reprojection Error"@en ;
    rdfs:subClassOf ngm:camera-calibration ;
    rdfs:subClassOf _:r18097 ;
