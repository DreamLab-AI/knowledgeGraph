        ngm:smart-contracts,
        ngm:token-weighted-voting,
        ngm:zero-knowledge-proof .

ngm:distributed-system-architecture a owl:Class ;
    rdfs:label "Distributed System Architecture"@en ;
    rdfs:comment "An architectural paradigm for metaverse systems that distributes computing resources, data storage, and processing across multiple interconnected nodes to achieve scalability, fault tolerance, and low-latency experiences whilst supporting s of concurrent users."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:system-architecture ;
    vc:enables ngm:metaverse-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "distributed-system-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:distributed-teams a owl:Class ;
    rdfs:label "Distributed Teams"@en ;
    rdfs:comment "Distributed teams are groups of collaborators who work from different geographic locations and often across time zones, coordinating primarily through digital communication and collaboration tools. They rely on asynchronous workflows, shared documentation, and recorded or AI-assisted meetings to maintain alignment without co-location. They have become a dominant model of knowledge work, trading the spontaneity of the office for flexibility and access to a global talent pool."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-video,
        ngm:meeting-ai-assistant ;
    vc:slug "distributed-teams" ;
    vc:sourceDomain "infrastructure" .

ngm:diversity-non-discrimination-and-fairness a owl:Class ;
    rdfs:label "Diversity, Non-Discrimination, and Fairness"@en ;
    rdfs:comment "Diversity, Non-Discrimination, and Fairness is a foundational trustworthiness dimension of responsible AI that requires systems to avoid unfair bias against protected characteristics (sex, race, religion, disability, age, sexual orientation), ensure equitable treatment and outcomes across demographic groups, implement accessibility and universal design for people with diverse abilities, and enable inclusive stakeholder participation throughout the AI development lifecycle. It encompasses three interdependent pillars: unfair-bias avoidance through pre-processing data corrections, in-processing fairness constraints, and post-processing adjustments; accessibility and universal design aligned with WCAG and the European Accessibility Act; and participatory design methodologies that co-create systems with affected communities. Legal mandates including the EU AI Act and GDPR enforce these requirements with substantial penalties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accessibility,
        ngm:digital-technology-access-equity,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:explainability,
        ngm:stakeholder,
        ngm:transparency ;
    vc:requires ngm:accountability,
        ngm:fairness ;
    vc:slug "diversity-non-discrimination-and-fairness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:human-rights,
        ngm:responsible-ai ;
    vc:uses ngm:algorithmic-bias,
        ngm:bias .

ngm:do-178-c a owl:Class ;
    rdfs:label "DO-178C"@en ;
    rdfs:comment "DO-178C (Software Considerations in Airborne Systems and Equipment Certification) is the primary international standard governing the development and certification of airborne software, published by RTCA in 2011 as the successor to DO-178B. It defines five software levels (A through E) based on failure severity, each requiring progressively more rigorous development assurance activities including requirements traceability, structural coverage testing, and independence in reviews. Compliance with DO-178C is required by aviation regulatory authorities (FAA, EASA) for software installed in certified aircraft."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:configuration-management ],
        ngm:safety-standard ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:agile-software-development,
        ngm:machine-learning ;
    vc:dependsOn ngm:lifecycle-management ;
    vc:enables ngm:avionics,
        ngm:embedded-systems,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:do-254,
        ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:requires ngm:configuration-management,
        ngm:formal-verification,
        ngm:software-testing,
        ngm:traceability ;
    vc:slug "do-178-c" ;
    vc:sourceDomain "standards" .

ngm:do-ra a owl:Class ;
    rdfs:label "DoRA"@en ;
    rdfs:comment "DoRA (Weight-Decomposed Low-Rank Adaptation) is a parameter-efficient fine-tuning method that decomposes pretrained weights into separate magnitude and direction components, applying low-rank updates only to the directional component while learning the magnitude independently. By separating these two degrees of freedom, DoRA more closely mirrors the learning dynamics of full fine-tuning than standard LoRA, improving accuracy on many tasks at comparable parameter cost and without added inference latency once merged. It is used to adapt large language and vision models efficiently."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:enables ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:transformer ;
    vc:slug "do-ra" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:low-rank-adaptation .

ngm:documentation-generation a owl:Class ;
    rdfs:label "Documentation Generation"@en ;
    rdfs:comment "Documentation Generation is the automated production of human-readable technical documentation—API references, code comments, user guides, and release notes—using large language models and natural language generation pipelines. By coupling static analysis, code execution traces, and prompt engineering, these systems reduce the documentation burden on developers while improving consistency and coverage."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ai-augmented-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-application ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:language-modeling,
        ngm:software-engineering ;
    vc:slug "documentation-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:code-generation,
        ngm:large-language-models,
        ngm:text-generation,
        ngm:transformer .

ngm:domain-name-system a owl:Class ;
    rdfs:label "Domain Name System"@en ;
    rdfs:comment "The Domain Name System (DNS) is a hierarchical, distributed naming system that translates human-readable domain names into the numerical addresses used to locate computers and services on a network. It is a foundational component of the Internet, resolving names through a delegated tree of authoritative servers, recursive resolvers and caching layers. DNS also carries service, security and routing metadata that many higher-level protocols depend upon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:caching ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dns ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ietf ],
        ngm:networking-infrastructure ;
    vc:contrastsWith ngm:ip-address ;
    vc:dependsOn ngm:network-protocol ;
    vc:enables ngm:http,
        ngm:load-balancing,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:caching,
        ngm:dns,
        ngm:name-resolution ;
    vc:isPartOf ngm:networking-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:security ;
    vc:requires ngm:ietf,
        ngm:network-protocol ;
    vc:slug "domain-name-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf ;
    vc:supports ngm:distributed-systems ;
    vc:uses ngm:caching .

ngm:driver-software a owl:Class ;
    rdfs:label "Driver Software"@en ;
    rdfs:comment "System-level software components that enable communication between operating systems and extended reality (XR) hardware devices, translating high-level application commands into hardware-specific instructions for VR headsets, AR glasses, haptic controllers, and spatial computing peripherals."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:system-software ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:extended-reality-xr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "driver-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:dynamic-model a owl:Class ;
    rdfs:label "Dynamic Model"@en ;
    rdfs:comment "A Dynamic Model is a mathematical or computational representation of a system that explicitly captures how the system's state evolves over time in response to inputs, internal dynamics, and disturbances. Distinguished from static models by their time-varying state equations—typically differential equations for continuous systems or recurrence relations for discrete systems—dynamic models are fundamental to control engineering, physics simulation, robotics, and economic forecasting. They may be physics-derived from first principles, identified from data using system identification techniques, or learned end-to-end from observations using neural networks."@en ;
    rdfs:subClassOf ngm:simulation ;
    vc:enables ngm:cyber-physical-systems,
        ngm:model-based-control,
        ngm:simulation-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:physics-simulation,
        ngm:probabilistic-model,
        ngm:world-model ;
    vc:slug "dynamic-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bayesian-inference,
        ngm:state-machine .

ngm:dynamical-systems-theory a owl:Class ;
    rdfs:label "Dynamical Systems Theory"@en ;
    rdfs:comment "The mathematical study of systems that evolve over time according to fixed rules, focusing on long-term behaviour, stability, attractors, bifurcations, and qualitative structure of trajectories in state space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calculus ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:stochastic-processes ;
    vc:enables ngm:chaos-theory,
        ngm:complex-systems,
        ngm:control-theory,
        ngm:stability-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:phase-space ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ergodic-theory,
        ngm:information-theory ;
    vc:requires ngm:calculus,
        ngm:differential-equations,
        ngm:linear-algebra,
        ngm:topology ;
    vc:slug "dynamical-systems-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:recurrent-neural-network,
        ngm:reinforcement-learning ;
    vc:uses ngm:feedback-loop,
        ngm:numerical-methods,
        ngm:state-space-representation .

ngm:dynamics a owl:Class ;
    rdfs:label "Dynamics"@en ;
    rdfs:comment "Dynamics is the branch of mechanics that studies the forces and torques that cause motion and the resulting accelerations of bodies. In robotics it provides the equations of motion that relate joint forces to accelerations, essential for force control, simulation, and model-based control. It contrasts with kinematics, which describes motion without reference to the forces that produce it."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:robo-actuation-and-control ;
    vc:slug "dynamics" ;
    vc:sourceDomain "robotics" .

ngm:ed-dsa a owl:Class ;
    rdfs:label "EdDSA"@en ;
    rdfs:comment "EdDSA (Edwards-curve Digital Signature Algorithm) is a high-performance digital signature scheme based on twisted Edwards elliptic curves, standardised in RFC 8032. It provides deterministic signing—eliminating the random number generation vulnerabilities that afflicted earlier schemes like ECDSA—whilst offering strong security with compact key and signature sizes. The most widely deployed instantiation is Ed25519, which operates over Curve25519 and produces 64-byte signatures with 128-bit security. EdDSA is extensively used in secure communications protocols, blockchain systems, verifiable credentials, and decentralised identity frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain-transaction,
        ngm:decentralised-identifier,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:ecdsa,
        ngm:post-quantum-cryptography,
        ngm:rsa-signature ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification,
        ngm:decentralised-identity,
        ngm:digital-signature-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:public-key-cryptography ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ed25519,
        ngm:openssh,
        ngm:schnorr-signature,
        ngm:signature-scheme,
        ngm:tls,
        ngm:wireguard ;
    vc:requires ngm:private-key,
        ngm:public-key ;
    vc:slug "ed-dsa" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:rfc-8032 ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:curve25519,
        ngm:elliptic-curve-cryptography,
        ngm:twisted-edwards-curve .

ngm:eip-4844 a owl:Class ;
    rdfs:label "EIP-4844"@en ;
    rdfs:comment "EIP-4844, known as Proto-Danksharding or 'Shard Blob Transactions', is an Ethereum Improvement Proposal activated on the Ethereum mainnet in March 2024 that introduces a new transaction type carrying temporary binary large objects (blobs) of data. Each blob is approximately 128 KB, persists for a short window (roughly two weeks) rather than being stored permanently in Ethereum state, and is made accessible to smart contracts only via a cryptographic commitment. The proposal dramatically reduces the data posting costs for Layer-2 rollups by creating a dedicated, cheap data-availability lane, providing a foundation for full Danksharding without requiring immediate shard implementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kzg-commitment ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-storage ;
    vc:contrastsWith ngm:calldata ;
    vc:enables ngm:danksharding,
        ngm:data-availability-sampling,
        ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:eip-1559,
        ngm:ethereum-improvement-proposal,
        ngm:gas-mechanism ;
    vc:requires ngm:ethereum,
        ngm:kzg-commitment,
        ngm:proof-of-stake ;
    vc:slug "eip-4844" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:optimistic-rollup,
        ngm:zk-rollup ;
    vc:uses ngm:beacon-chain,
        ngm:blob-transaction,
        ngm:elliptic-curve-cryptography,
        ngm:polynomial-commitment .

ngm:electrical-power a owl:Class ;
    rdfs:label "Electrical Power"@en ;
    rdfs:comment "Electrical Power is the rate at which electrical energy is transferred or consumed by a system, measured in watts. It is the fundamental resource that drives compute infrastructure, robotic actuators, sensors, and communications equipment. The availability, capacity, and efficiency of electrical power are primary constraints on data-centre scale and on the autonomy of mobile and robotic systems."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:electric-actuator ;
    vc:slug "electrical-power" ;
    vc:sourceDomain "infrastructure" .

ngm:embodied-cognition a owl:Class ;
    rdfs:label "Embodied Cognition"@en ;
    rdfs:comment "Embodied cognition is the theory that cognitive processes are deeply shaped by the body's sensorimotor systems and its interaction with the physical environment, rather than residing solely in abstract symbol manipulation in the brain. It holds that perception, action, and the body's morphology constrain and constitute thought, so understanding concepts is grounded in bodily experience. The view informs human-computer interaction and immersive design, where natural movement and spatial presence improve learning and comprehension. It contrasts with classical computationalism that treats the mind as disembodied information processing."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:bridgesTo ngm:immersive-learning,
        ngm:virtual-reality ;
    vc:contrastsWith ngm:artificial-intelligence ;
    vc:enables ngm:immersive-learning,
        ngm:presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:interaction-design,
        ngm:perception,
        ngm:presence ;
    vc:slug "embodied-cognition" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-computing ;
    vc:uses ngm:perception .

ngm:encryption-scheme a owl:Class ;
    rdfs:label "Encryption Scheme"@en ;
    rdfs:comment "An Encryption Scheme is a cryptographic construction comprising key-generation, encryption, and decryption algorithms that together transform plaintext into ciphertext and back under a key. Schemes are categorised as symmetric (shared key, e.g. AES) or asymmetric (public/private key, e.g. RSA, ECC), and are evaluated by their security definitions such as semantic security. They are the building blocks of confidentiality in cryptographic protocols."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:cryptography ;
    vc:slug "encryption-scheme" ;
    vc:sourceDomain "security" .

ngm:enterprise-ai a owl:Class ;
    rdfs:label "Enterprise Ai"@en ;
    rdfs:comment "Enterprise AI is the application of artificial-intelligence systems within large organisations to automate workflows, augment knowledge work and inform decisions, subject to governance, security and integration constraints. It spans foundation-model assistants, retrieval-augmented systems over corporate data, and agentic automation embedded in existing software estates. Distinct from consumer AI, it prioritises auditability, data residency, access control and measurable return on investment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance-law-and-privacy ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:enterprise-automation,
        ngm:enterprise-resource-planning ;
    vc:contrastsWith ngm:ai-adoption ;
    vc:dependsOn ngm:ai-governance-law-and-privacy ;
    vc:enables ngm:agentic-workflow,
        ngm:enterprise-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:foundation-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:enterprise-ai-adoption,
        ngm:institutional-adoption ;
    vc:requires ngm:ai-governance-law-and-privacy ;
    vc:slug "enterprise-ai" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-adoption,
        ngm:technology-adoption ;
    vc:uses ngm:ai-agents,
        ngm:foundation-model,
        ngm:microsoft-copilot .

ngm:environmental-impact-metric a owl:Class ;
    rdfs:label "Environmental Impact Metric"@en ;
    rdfs:comment "A quantitative measurement framework for assessing the environmental sustainability of metaverse and digital systems, encompassing energy consumption, carbon emissions, resource efficiency, and ecological footprint across computational infrastructure and user interactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sustainability-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-footprint-indicator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-calculator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring-infrastructure ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-footprint-indicator,
        ngm:sustainability-reporting ;
    vc:isPartOf ngm:esg-reporting,
        ngm:sustainability-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:carbon-calculator,
        ngm:data-collection,
        ngm:monitoring-infrastructure ;
    vc:slug "environmental-impact-metric" ;
    vc:sourceDomain "spatial-computing" .

ngm:ergonomics a owl:Class ;
    rdfs:label "Ergonomics"@en ;
    rdfs:comment "Ergonomics, also called human factors engineering, is the discipline of designing systems, tools and environments to fit the physical and cognitive characteristics of the people who use them. It studies posture, reach, force, repetition, perception and workload in order to optimise human performance, comfort and safety while reducing fatigue and injury. In robotics and automation it governs the design of workstations, controls and collaborative robots so that machines and humans can operate together efficiently and without harm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cognitive-load ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-factors ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usability ],
        ngm:human-factors ;
    vc:enables ngm:exoskeleton,
        ngm:usability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cognitive-load,
        ngm:usability ;
    vc:isPartOf ngm:human-computer-interaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:affordance,
        ngm:interaction-design,
        ngm:robotics,
        ngm:user-interface ;
    vc:requires ngm:human-factors ;
    vc:slug "ergonomics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:accessibility,
        ngm:user-experience ;
    vc:uses ngm:perception,
        ngm:user-centred-design .

ngm:escrow-system a owl:Class ;
    rdfs:label "Escrow System"@en ;
    rdfs:comment "An escrow system is a mechanism that holds assets or funds with a trusted third party or, on blockchains, in a smart contract until predefined release conditions are met. It reduces counterparty risk in transactions by guaranteeing that neither party can unilaterally seize value before obligations are fulfilled. On-chain escrows use conditional logic and timelocks to release or refund funds automatically."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:marketplace,
        ngm:timelock ;
    vc:slug "escrow-system" ;
    vc:sourceDomain "blockchain" .

ngm:ethics a owl:Class ;
    rdfs:label "Ethics"@en ;
    rdfs:comment "Ethics is the systematic study of what is right, good and obligatory, and of the principles that should guide conduct. In the context of artificial intelligence it concerns how systems should be designed, deployed and governed so that their effects on people and society are beneficial, fair and accountable. AI ethics draws on long-standing moral philosophy while addressing new questions raised by autonomous and data-driven systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:governance,
        ngm:responsible-ai ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:accountability,
        ngm:fairness,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-safety,
        ngm:responsible-ai ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:existential-risk,
        ngm:fairness,
        ngm:value-alignment ;
    vc:requires ngm:accountability,
        ngm:transparency ;
    vc:slug "ethics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:responsible-ai,
        ngm:value-alignment .

ngm:etsi-metaverse-domain-model a owl:Class ;
    rdfs:label "Etsi Metaverse Domain Model"@en ;
    rdfs:comment "A conceptual framework developed by ETSI defining the structural organisation, functional components, and interaction patterns of metaverse systems, providing a standardised reference architecture for telecommunications infrastructure supporting persistent, interconnected virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:domain-model ;
    vc:enables ngm:interoperability,
        ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-identity,
        ngm:network-infrastructure ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:edge-computing ;
    vc:slug "etsi-metaverse-domain-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:reference-architecture .

ngm:eu-taxonomy a owl:Class ;
    rdfs:label "EU Taxonomy"@en ;
    rdfs:comment "The EU Taxonomy is a classification system that defines which economic activities count as environmentally sustainable under European Union law. It sets technical screening criteria across climate and environmental objectives so that investors, companies, and regulators apply a common definition of green activity. The taxonomy underpins sustainable-finance disclosure and ESG reporting by preventing greenwashing through standardised criteria."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:sustainable-finance ;
    vc:slug "eu-taxonomy" ;
    vc:sourceDomain "governance" .

ngm:evidence-collection a owl:Class ;
    rdfs:label "Evidence Collection"@en ;
    rdfs:comment "Evidence collection is the systematic process of identifying, preserving, and documenting artefacts — digital or physical — in a manner that maintains their integrity and admissibility for legal, regulatory, or investigative proceedings. In digital contexts it encompasses forensic acquisition of disk images, memory dumps, network captures, and log files while maintaining strict chain-of-custody documentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-timestamping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:digital-forensics ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain ;
    vc:contrastsWith ngm:data-destruction ;
    vc:enables ngm:forensic-analysis,
        ngm:threat-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:memory-acquisition ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-evidence,
        ngm:data-integrity,
        ngm:e-discovery,
        ngm:incident-response,
        ngm:volatile-data ;
    vc:requires ngm:access-control,
        ngm:chain-of-custody,
        ngm:trusted-timestamping ;
    vc:slug "evidence-collection" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-27037 ;
    vc:supports ngm:cybercrime-investigation,
        ngm:legal-evidence,
        ngm:regulatory-compliance ;
    vc:uses ngm:audit-log,
        ngm:chain-of-custody,
        ngm:cryptographic-hash,
        ngm:forensic-imaging,
        ngm:write-blocker .

ngm:evm-compatibility a owl:Class ;
    rdfs:label "EVM Compatibility"@en ;
    rdfs:comment "EVM compatibility is the property of a blockchain or execution environment that allows it to run smart contracts compiled for the Ethereum Virtual Machine without modification, supporting the same bytecode, opcodes and account model. Compatible chains can reuse Ethereum tooling, wallets, contracts and developer skills, which lowers the cost of porting applications and bootstrapping liquidity. It is the foundation of the wider EVM ecosystem spanning Layer-2 rollups, sidechains and alternative Layer-1 networks."@en ;
    rdfs:subClassOf ngm:smart-contract-platform ;
    vc:dependsOn ngm:evm,
        ngm:solidity ;
    vc:enables ngm:cross-chain-bridge,
        ngm:interoperability,
        ngm:optimistic-rollup ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:arbitrum,
        ngm:bnb-chain,
        ngm:connext,
        ngm:polygon,
        ngm:zk-sync ;
    vc:slug "evm-compatibility" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:layer-2-scaling,
        ngm:rollup ;
    vc:uses ngm:ethereum .

ngm:expert-parallelism a owl:Class ;
    rdfs:label "Expert Parallelism"@en ;
    rdfs:comment "Expert parallelism is a distributed-training strategy for mixture-of-experts models that places different expert sub-networks on different accelerators and routes each token to its selected experts via all-to-all communication. Because only a sparse subset of experts is activated per token, expert parallelism scales total parameter count without a proportional rise in per-token compute. It is typically combined with data, tensor, and pipeline parallelism, and its efficiency hinges on balanced routing and low-latency interconnects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:load-balancing ],
        ngm:model-parallelism ;
    vc:bridgesTo ngm:distributed-training ;
    vc:contrastsWith ngm:data-parallelism,
        ngm:tensor-parallelism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:all-to-all-communication,
        ngm:routing-network ;
    vc:implements ngm:mixture-of-experts-architecture ;
    vc:isPartOf ngm:distributed-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-parallelism,
        ngm:pipeline-parallelism ;
    vc:requires ngm:gpu-cluster,
        ngm:load-balancing ;
    vc:slug "expert-parallelism" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:collective-communication,
        ngm:sparse-activation .

ngm:exteroceptive-sensor a owl:Class ;
    rdfs:label "Exteroceptive Sensor"@en ;
    rdfs:comment "Exteroceptive sensors are robot perception transducers that measure information about the external environment surrounding the robot rather than its internal kinematic, dynamic, or energetic state, providing the raw signals from which obstacle maps, semantic scene representations, object poses, t..."@en ;
