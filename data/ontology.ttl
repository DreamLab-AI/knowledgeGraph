# Identity Management
infrastructure:IdentityManagement rdf:type owl:Class ;
    rdfs:label "Identity Management"@en ;
    rdfs:comment "Identity management in blockchain contexts refers to the systems and protocols enabling individuals and organisations to create, control, and verify digital identities without reliance on centralised authorities. Decentralised identity (DID) architectures leverage blockchain technology to provide self-sovereign identity capabilities, where users maintain control over their personal data through cryptographic keys, verifiable credentials, and distributed ledger storage."@en ;
    skos:prefLabel "Identity Management"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:identity-management" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:identity-management> ;
    vcw:contentHash "sha256-12-254c5de7c963" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "NGM-7002" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-7002" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

infrastructure:IdentityManagement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:SelfSovereignIdentity
] .

# Access Control
infrastructure:AccessControl rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:SecurityMechanism ;
    rdfs:label "Access Control"@en ;
    rdfs:comment "Access control is a fundamental security mechanism that regulates which users, systems, or processes can view, use, or modify resources within a computing environment. It encompasses the policies, procedures, and technologies that govern the granting and restricting of access rights, ensuring that only authorised entities can perform specific actions on protected resources based on their identity, role, or attributes."@en ;
    skos:prefLabel "Access Control"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:access-control" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:access-control> ;
    vcw:contentHash "sha256-12-089f73f660f4" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "NGM-7003" ;
