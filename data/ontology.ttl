ngm:ai-in-games a owl:Class ;
    rdfs:label "AI in Games"@en ;
    rdfs:comment "AI in Games is the interdisciplinary research and engineering field encompassing the design, implementation, and study of computational systems that perceive, decide, learn, and generate within interactive entertainment software, spanning classical symbolic techniques (finite-state machines FSM d..."@en ;
    rdfs:subClassOf ngm:entertainment-technology,
        ngm:game-development ;
    vc:enables ngm:adaptive-tutoring,
        ngm:automated-playtesting,
        ngm:believable-npc-behaviour,
        ngm:dynamic-difficulty-adjustment,
        ngm:dynamic-narrative,
        ngm:emergent-gameplay,
        ngm:personalised-game-experience,
        ngm:procedural-replayability ;
    vc:hasPart ngm:animation-controller,
        ngm:behaviour-trees,
        ngm:finite-state-machine,
        ngm:game-playing-agents,
        ngm:goap,
        ngm:htn-planning,
        ngm:influence-map,
        ngm:monte-carlo-tree-search,
        ngm:navigation-mesh,
        ngm:npc-dialogue-system,
        ngm:pathfinding,
        ngm:procedural-content-generation ;
    vc:implements ngm:a-search,
        ngm:alpha-zero,
        ngm:behaviour-tree,
        ngm:dreamer-v3,
        ngm:impala,
        ngm:mu-zero,
        ngm:perlin-noise,
        ngm:proximal-policy-optimization,
        ngm:recast-navmesh,
        ngm:simplex-noise,
        ngm:utility-ai,
        ngm:voronoi-diagram,
        ngm:wave-function-collapse ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:computational-creativity,
        ngm:esports,
        ngm:game-analytics,
        ngm:game-user-research,
        ngm:generative-ai,
        ngm:player-modelling,
        ngm:speedrunning,
        ngm:twitch-plays ;
    vc:requires ngm:content-authoring-pipeline,
        ngm:game-engine,
        ngm:game-state-representation,
        ngm:player-modelling,
        ngm:quality-assurance,
        ngm:real-time-constraints,
        ngm:spatial-reasoning ;
    vc:slug "ai-in-games" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:aaai-aiide,
        ngm:fdg-conference,
        ngm:ieee-conference-on-games,
        ngm:igda-ai-special-interest-group,
        ngm:khronos-gl-tf,
        ngm:open-usd ;
    vc:supports ngm:bevy,
        ngm:convai,
        ngm:cry-engine,
        ngm:game-maker,
        ngm:godot,
        ngm:inworld-ai,
        ngm:nvidia-ace,
        ngm:roblox,
        ngm:unity-ml-agents,
        ngm:unreal-engine ;
    vc:uses ngm:curriculum-learning,
        ngm:domain-randomization,
        ngm:imitation-learning,
        ngm:markov-decision-process,
        ngm:partially-observable-mdp,
        ngm:reward-shaping,
        ngm:self-play .

