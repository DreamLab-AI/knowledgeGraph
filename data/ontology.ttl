    vc:slug "bias-in-ai" ;
    vc:sourceDomain "governance" .
ngm:bias-in-large-language-models a owl:Class ;
    rdfs:comment "Bias in Large Language Models is the systematic skew in the outputs, representations, and decisions of transformer-based foundation models (GPT-4o/4.5, Claude 3.5/4 Sonnet/Opus, Gemini 1.5/2.0 Pro, Llama 3/4, Mistral Large, Qwen 2.5, DeepSeek-V3) toward particular social groups, viewpoints, langu..."@en ;
    rdfs:label "Bias in Large Language Models"@en ;
