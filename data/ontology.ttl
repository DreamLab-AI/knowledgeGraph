        ngm:sdn-controller ;
    vc:slug "6-g-network-slice" ;
    vc:sourceDomain "infrastructure" .

ngm:accelerometer a owl:Class ;
    rdfs:label "Accelerometer"@en ;
    rdfs:comment "Accelerometer - A microelectromechanical sensor (MEMS) that detects changes in velocity and gravity along three orthogonal axes, enabling robots to measure Motion, Orientation, and Vibration for real-time feedback control and navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:gesture-recognition,
        ngm:motion-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:inertial-measurement-unit ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:signal-conditioning ;
    vc:slug "accelerometer" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robotics .

ngm:accessibility-audit-tool a owl:Class ;
    rdfs:label "Accessibility Audit Tool"@en ;
    rdfs:comment "An automated software utility that verifies compliance with accessibility standards (such as WCAG) in XR environments, identifying barriers for users with disabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-dashboard ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:accessibility-reporting,
        ngm:compliance-verification,
        ngm:inclusive-design,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-testing-engine,
        ngm:compliance-dashboard,
        ngm:report-generator,
        ngm:wcag-validator ;
    vc:isPartOf ngm:quality-assurance-toolchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:accessibility-standards,
        ngm:testing-framework,
        ngm:user-interface-analyzer ;
    vc:slug "accessibility-audit-tool" ;
    vc:sourceDomain "spatial-computing" .

ngm:accountability-oecd a owl:Class ;
