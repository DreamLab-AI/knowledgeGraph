ngm:multisig a owl:Class ;
    rdfs:label "Multisig"@en ;
    rdfs:comment "Multisig, or multi-signature, is a scheme requiring more than one cryptographic signature to authorise a transaction or action. It is widely used in cryptocurrency wallets and custody to distribute control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
