# Localization
rb:Localization a owl:Class ;
    rdfs:subClassOf rb:StateEstimation ;
    rdfs:label "Localization"@en ;
    rdfs:comment "The process of determining a mobile robot's position and orientation (pose) within a known or unknown environment using sensor measurements and a map or environmental model. It answers the question \"Where am I?\""@en ;
    skos:prefLabel "Localization"@en ;
    dcterms:identifier "RB-1013" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.97"^^xsd:decimal ;
    rdf:type owl:MethodClass .

rb:Localization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:Navigation
] .

rb:Localization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:RB1016pathplanning
] .

