            owl:someValuesFrom ngm:physical-layer ],
        ngm:metaverse-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:component-reusability,
        ngm:multi-vendor-integration,
        ngm:scalable-architecture,
        ngm:system-interoperability ;
