ngm:synthetic-biology a owl:Class ;
    rdfs:label "Synthetic Biology"@en ;
    rdfs:comment "Synthetic biology is a field that applies engineering principles to design and construct biological systems and organisms. It combines biology, genetics, and engineering."@en ;
