        ngm:api-design ;
    vc:bridgesTo ngm:microservices ;
    vc:contrastsWith ngm:rest ;
    vc:dependsOn ngm:schema ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
