vf:model-based-control a owl:Class ;
    rdfs:label "Model Based Control"@en ;
    rdfs:comment "Model Based Control (MBC) is a class of control-system design paradigms in which an explicit mathematical model of the plant's dynamics — encoding kinematics, inertia tensors, contact forces, aerodynamics, or learned neural representations — is embedded within the controller to predict, plan, and optimise trajectories under physical and operational constraints. Rather than treating the mapping from sensor readings to actuator commands as a black-box function to be approximated by trial-and-error reinforcement, model-based approaches exploit known or identified structure to compute feedforward compensation, solve constrained optimisation problems over finite prediction horizons, propagate uncertainty through the dynamic model, and achieve real-time closed-loop operation on complex multi-body or hybrid systems. The result is dramatically improved sample efficiency, interpretable control policies, guaranteed constraint satisfaction (when combined with suitable optimisation formulations), and principled mechanisms for incorporating prior physical knowledge — advantages that are particularly compelling for safety-critical deployments such as legged locomotion, surgical robotics, aerospa"@en ;
    rdfs:subClassOf <urn:visionflow:linked:predictive-control>,
        <urn:visionflow:linked:trajectory-optimisation>,
        vf:control-theory,
        vf:optimal-control,
        vf:robot-control ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:autonomous-vehicle-control>,
        <urn:visionflow:linked:compliant-manipulation>,
        <urn:visionflow:linked:constraint-satisfaction>,
        <urn:visionflow:linked:real-time-motion-planning>,
        <urn:visionflow:linked:robust-locomotion>,
        <urn:visionflow:linked:sample-efficient-learning> ;
    vc:hasPart <urn:visionflow:linked:constraint-set>,
        <urn:visionflow:linked:contact-model>,
        <urn:visionflow:linked:cost-function>,
        <urn:visionflow:linked:differential-dynamic-programming>,
        <urn:visionflow:linked:i-lqr>,
        <urn:visionflow:linked:model-predictive-control>,
        <urn:visionflow:linked:prediction-horizon>,
        <urn:visionflow:linked:system-identification>,
        <urn:visionflow:linked:whole-body-control> ;
    vc:implements <urn:visionflow:linked:differential-dynamic-programming>,
        <urn:visionflow:linked:interior-point-methods>,
        <urn:visionflow:linked:koopman-operator-methods>,
        <urn:visionflow:linked:quadratic-programming>,
        <urn:visionflow:linked:receding-horizon-control>,
        <urn:visionflow:linked:sequential-quadratic-programming> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:constraint-specification>,
        <urn:visionflow:linked:dynamic-model>,
        <urn:visionflow:linked:inertia-tensor>,
        <urn:visionflow:linked:jacobian-computation>,
        <urn:visionflow:linked:optimisation-solver>,
        <urn:visionflow:linked:state-estimator> ;
    vc:slug "model-based-control" ;
    vc:sourceDomain "robotics" .

vf:model-control-protocols-like-mcp a owl:Class ;
    rdfs:label "Model Control Protocols like MCP"@en ;
    rdfs:comment "Model Control Protocols like MCP refers to the family of open, standardised communication protocols that govern how large language model (LLM) inference hosts communicate with external services, tools, data sources, and agents at runtime, enabling composable agentic ecosystems without per-integration custom code. The canonical instantiation is Anthropic's **Model Context Protocol (MCP)**, published as an open specification in November 2024 and reaching stable 1.0 status, which defines a JSON-RPC 2.0 message layer carried over three transport bindings—stdio (subprocess pipe), Server-Sent Events (SSE) over HTTP, and streamable HTTP—through which **MCP Clients** (embedded in host applications such as Claude Desktop, Cursor, Cline, and Continue) discover and invoke capabilities advertised by **MCP Servers** (thin adapters that expose file-systems, databases, APIs, SaaS platforms, or entire workflow engines). The protocol defines four primitive capability types: **Resources** (static or dynamic data blobs the server can provide, e.g. files, database rows, live feeds), **Tools** (callable functions with JSON-Schema parameter schemas that the LLM may invoke by emitting a structured tool-c"@en ;
    rdfs:subClassOf vf:agent-frameworks,
        vf:agentic-internet,
        vf:agents,
        vf:api-gateway,
        vf:cli-multi-agent-systems ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:agent-frameworks,
        vf:agentic-internet,
        vf:ai-companions,
        vf:ai-search,
        vf:chatbots,
        vf:cli-multi-agent-systems,
        vf:comfy-ui-client ;
    vc:hasPart <urn:visionflow:linked:json-rpc>,
        <urn:visionflow:linked:mcp-client>,
        <urn:visionflow:linked:mcp-prompts>,
        <urn:visionflow:linked:mcp-resources>,
        <urn:visionflow:linked:mcp-sampling>,
        <urn:visionflow:linked:mcp-server>,
        <urn:visionflow:linked:mcp-tools>,
        <urn:visionflow:linked:server-sent-events>,
        <urn:visionflow:linked:stdio-transport>,
        <urn:visionflow:linked:tool-schema> ;
    vc:implements <urn:visionflow:linked:capability-advertisement>,
        <urn:visionflow:linked:dynamic-tool-discovery>,
        <urn:visionflow:linked:remote-procedure-call>,
        <urn:visionflow:linked:tool-use>,
        vf:function-calling ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:json-rpc>,
        <urn:visionflow:linked:json-schema>,
        <urn:visionflow:linked:llm-tool-use>,
        <urn:visionflow:linked:transport-protocol>,
        vf:access-control-system,
        vf:anthropic-claude ;
    vc:slug "model-control-protocols-like-mcp" ;
    vc:sourceDomain "artificial-intelligence" .

vf:model-inversion a owl:Class ;
    rdfs:label "Model Inversion"@en ;
    rdfs:comment "An inference-time privacy attack that reconstructs sensitive training data or attributes from a trained model by exploiting model outputs, predictions, or internal representations, potentially revealing confidential information about individuals in the training dataset."@en ;
    rdfs:subClassOf vf:artificial-intelligence ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
