        ngm:environmental-mapping,
        ngm:object-recognition,
        ngm:situational-awareness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:localization,
        ngm:object-detection,
        ngm:scene-understanding,
        ngm:sensor-fusion ;
    vc:isPartOf ngm:ai-agent-system,
        ngm:autonomous-system,
        ngm:robotics-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:multi-agent-perception ;
    vc:requires ngm:sensor-data,
        ngm:training-data ;
    vc:slug "perception-system" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-21448,
