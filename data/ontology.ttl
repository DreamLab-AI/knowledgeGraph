            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-core ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:brc-20 ],
        ngm:bitcoin-proof-of-work-protocol-network ;
    vc:bridgesTo ngm:digital-collectible,
        ngm:metaverse ;
    vc:contrastsWith ngm:erc-721,
        ngm:nft,
        ngm:smart-contract ;
    vc:enables ngm:digital-ownership,
        ngm:on-chain-storage,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:brc-20,
        ngm:inscription,
        ngm:satoshi ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-art,
        ngm:digital-asset,
        ngm:mining,
        ngm:transaction-fee ;
    vc:requires ngm:bitcoin-proof-of-work-protocol-core,
        ngm:proof-of-work,
        ngm:witness-data ;
    vc:slug "bitcoin-ordinals" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-script,
        ngm:blockchain-transaction,
        ngm:seg-wit,
        ngm:taproot,
        ngm:utxo .

ngm:bittorrent a owl:Class ;
    rdfs:label "Bittorrent"@en ;
    rdfs:comment "BitTorrent is a peer-to-peer protocol for distributing files by splitting them into pieces that participants download from and upload to one another rather than from a single server. Each participant who holds the complete file can seed it, while downloaders simultaneously share the pieces they already have, so aggregate capacity grows with demand. The protocol uses content hashing to verify pieces and a tracker or distributed hash table to help peers discover one another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bandwidth ],
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:content-delivery-network ;
    vc:enables ngm:decentralized-storage,
        ngm:replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gossip-protocol,
        ngm:ipfs ;
    vc:requires ngm:bandwidth,
        ngm:network-protocol ;
    vc:slug "bittorrent" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:data-distribution,
        ngm:distributed-storage,
        ngm:file-sharing ;
    vc:uses ngm:content-addressing,
        ngm:distributed-hash-table,
        ngm:overlay-network .

ngm:blake3 a owl:Class ;
    rdfs:label "BLAKE3"@en ;
    rdfs:comment "BLAKE3 is a cryptographic hash function released in 2020 that achieves exceptional speed through a tree-hashing construction enabling unlimited parallelism across SIMD lanes and CPU cores, while simultaneously functioning as a keyed hash, a key derivation function, and an extendable-output function (XOF). It is derived from the BLAKE2 family, inheriting its ARX (add-rotate-XOR) ChaCha-based compression function, and extends it with a Bao-style binary tree that allows verified streaming and incremental hashing. BLAKE3 produces digests of arbitrary length (defaulting to 256 bits), is formally specified under a Creative Commons public-domain dedication, and is designed to be faster than SHA-256 on modern hardware by factors of five to ten on multi-core systems. Its unified API replaces the need for separate HMAC, HKDF, or KDF constructions."@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    vc:enables ngm:content-addressing,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blake2,
        ngm:cryptographic-hash,
        ngm:data-integrity,
        ngm:merkle-tree ;
    vc:slug "blake3" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-primitive,
        ngm:hardware-acceleration .

ngm:blip-2-captioner a owl:Class ;
    rdfs:label "BLIP-2 Captioner"@en ;
    rdfs:comment "BLIP-2 is a vision-language model that bridges a frozen image encoder and a frozen large language model with a lightweight Querying Transformer (Q-Former), and a BLIP-2 captioner uses this model to generate natural-language descriptions of images. It produces high-quality captions efficiently because only the Q-Former is trained, leaving the heavy backbones fixed. Such captioners are commonly used to auto-label image datasets for training diffusion models and fine-tuning pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vision-transformer ],
        [ a owl:Restriction ;
