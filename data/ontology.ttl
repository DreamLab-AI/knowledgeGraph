ngm:dao-legal-structures a owl:Class ;
    rdfs:label "DAO Legal Structures"@en ;
    rdfs:comment "DAO Legal Structures are the corpus of statutory wrappers, jurisdictional incorporation regimes, and bespoke entity forms — spanning US state limited-liability companies, US state unincorporated nonprofit associations, offshore foundation companies, Swiss associations and foundations, Liechtenste..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
