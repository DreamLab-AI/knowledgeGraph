ngm:neural-architecture-search a owl:Class ;
    rdfs:label "Neural Architecture Search"@en ;
    rdfs:comment "Neural Architecture Search (NAS) is an automated machine learning technique that searches a defined space of neural network designs to discover architectures that maximise predictive performance or satisfy multi-objective constraints such as latency, parameter count, and energy consumption. NAS algorithms explore the architecture search space using strategies that include reinforcement learning, evolutionary algorithms, differentiable relaxations (DARTS), and predictor-based approaches, each making different trade-offs between search cost and solution quality. The field emerged from the observation that hand-designed architectures require substantial expert knowledge and iterative experimentation, and that automated search can discover non-obvious configurations that outperform human-designed baselines on targeted hardware or task distributions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:auto-ml ;
    vc:bridgesTo ngm:edge-computing,
        ngm:hardware-software-co-design ;
    vc:contrastsWith ngm:architecture,
        ngm:feature-engineering ;
    vc:dependsOn ngm:deep-learning,
        ngm:neural-network-architecture,
        ngm:transfer-learning ;
    vc:enables ngm:inference,
        ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:machine-learning-discipline-pipeline,
        ngm:mixture-of-experts-architecture,
        ngm:zero-cost-proxy ;
    vc:requires ngm:gpu-compute,
        ngm:performance-estimation-strategy,
        ngm:search-space-definition ;
    vc:slug "neural-architecture-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bayesian-optimisation,
        ngm:differentiable-architecture,
        ngm:evolutionary-algorithm,
        ngm:hyperparameter-tuning,
        ngm:machine-learning-discipline-framework,
        ngm:reinforcement-learning,
        ngm:weight-sharing .

ngm:pid-control a owl:Class ;
    rdfs:label "PID Control"@en ;
    rdfs:comment "PID (Proportional–Integral–Derivative) control is a closed-loop feedback control algorithm that computes a corrective output by summing three terms derived from the error signal: a proportional term that scales the instantaneous error, an integral term that accumulates past error to eliminate steady-state offset, and a derivative term that reacts to the rate of change of error to anticipate and damp future deviations. The control law u(t) = Kp·e(t) + Ki·∫e(τ)dτ + Kd·(de/dt) is parameterised by three tunable gains and applies universally to any plant where a measurable output can be compared against a desired setpoint. Originating in the 1940s through work by Minorsky, Ziegler, and Nichols, PID remains the dominant feedback controller in industrial automation, robotics, aerospace, and embedded systems due to its conceptual simplicity, zero requirement for an explicit plant model, and extensive supporting theory for stability analysis and gain tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:setpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proportional-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:derivative-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:impedance-control,
        ngm:model-predictive-control,
        ngm:open-loop-control,
        ngm:sliding-mode-control ;
    vc:dependsOn ngm:control-theory,
        ngm:stability-analysis ;
    vc:enables ngm:force-control,
        ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:derivative-control,
        ngm:proportional-control ;
    vc:implements ngm:closed-loop-control ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:anti-windup,
        ngm:bode-plot,
        ngm:cascade-control ;
    vc:requires ngm:feedback-loop,
        ngm:sensor,
        ngm:setpoint ;
    vc:slug "pid-control" ;
    vc:sourceDomain "robotics" ;
