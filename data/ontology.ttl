ngm:data-availability-sampling a owl:Class ;
    rdfs:label "Data Availability Sampling"@en ;
    rdfs:comment "Data availability sampling (DAS) is a technique that lets resource-limited clients gain high statistical confidence that all the data behind a block has been published, without downloading the whole block. Each client requests a few random fragments of an erasure-coded dataset; if enough randomly chosen fragments are returned across many clients, the full data can be reconstructed, so withholding it becomes detectable. DAS is a foundational primitive for scalable, modular blockchains and rollup-centric architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erasure-coding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erasure-coding ],
        ngm:data-availability ;
    vc:bridgesTo ngm:rollup ;
    vc:dependsOn ngm:peer-to-peer-network ;
    vc:enables ngm:light-client,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:erasure-coding ;
    vc:implements ngm:data-availability ;
    vc:isPartOf ngm:data-availability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:celestia,
        ngm:ethereum,
        ngm:fraud-proof,
        ngm:light-client ;
    vc:requires ngm:erasure-coding ;
    vc:slug "data-availability-sampling" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:rollup,
        ngm:sharding ;
    vc:uses ngm:erasure-coding .

