        ngm:monetary-authority ;
    vc:slug "monetary-policy" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bank-for-international-settlements,
        ngm:international-monetary-fund ;
    vc:supports ngm:financial-stability,
        ngm:full-employment,
        ngm:monetary-policy-transmission ;
    vc:uses ngm:economic-mechanism,
        ngm:inflation-targeting,
        ngm:tokenomics .

ngm:neural-network-text-tokenisation a owl:Class ;
    rdfs:label "Neural Network Text Tokenisation"@en ;
    rdfs:comment "The process of segmenting text into discrete units (tokens) — characters, subwords, or words — that serve as the atomic inputs to neural network language models, directly determining vocabulary size, out-of-vocabulary handling, and downstream model performance."@en ;
