ngm:system-dynamics a skos:Concept ;
    rdfs:label "System Dynamics"@en .

ngm:systemic-risk-management a owl:Class ;
    rdfs:label "Systemic Risk Management"@en ;
    rdfs:comment "Systemic risk management is the set of practices, institutions and policy tools aimed at identifying, monitoring and mitigating risks that could destabilise an entire financial system rather than a single firm. It combines macroprudential regulation, stress testing, capital and liquidity buffers, and resolution regimes to limit contagion across interconnected institutions and markets. Coordinated by bodies such as the Financial Stability Board and central banks, it seeks to preserve financial stability and prevent crises from cascading through the economy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stress-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:financial-stability ;
    vc:bridgesTo ngm:central-bank ;
    vc:contrastsWith ngm:prudential-regulation ;
    vc:dependsOn ngm:systemic-risk ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:stress-testing ;
    vc:implements ngm:macroprudential-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:basel-committee,
        ngm:financial-regulation,
        ngm:systemic-risk ;
    vc:requires ngm:risk-management ;
    vc:slug "systemic-risk-management" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-iii,
        ngm:fsb ;
    vc:supports ngm:financial-stability,
        ngm:prudential-regulation ;
    vc:uses ngm:macroprudential-policy,
        ngm:stress-testing .

ngm:tamper-evidence a owl:Class ;
    rdfs:label "Tamper Evidence"@en ;
    rdfs:comment "Tamper evidence is the property of a system, record, or physical artefact whereby any unauthorised alteration leaves detectable traces that can be subsequently verified. It relies on mechanisms such as cryptographic hashing, digital signatures, and immutable logs so that the integrity of an item can be assessed after the fact. Tamper evidence does not necessarily prevent modification, but it guarantees that modification cannot occur undetected."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:tamper-resistance ;
    vc:enables ngm:audit-trail,
        ngm:integrity-verification,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:nft,
        ngm:tamper-resistance ;
    vc:requires ngm:cryptographic-hash,
        ngm:digital-signature ;
    vc:slug "tamper-evidence" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:immutability,
        ngm:supply-chain-traceability ;
    vc:uses ngm:blockchain-anchoring,
        ngm:timestamp .

ngm:tamper-resistance a skos:Concept ;
    rdfs:label "Tamper Resistance"@en .

ngm:targeted-advertising a owl:Class ;
    rdfs:label "Targeted Advertising"@en ;
    rdfs:comment "Targeted advertising is the practice of delivering advertisements to specific individuals or audience segments selected on the basis of inferred characteristics, behaviour, or context. It relies on collecting and analysing personal data to predict which users are most likely to respond, and on automated systems that match adverts to audiences in real time. Because it depends on extensive data collection and profiling, targeted advertising sits at the centre of debates about privacy, consent, and the governance of digital platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        ngm:advertising ;
    vc:contrastsWith ngm:privacy ;
    vc:dependsOn ngm:data-collection ;
    vc:enables ngm:digital-marketing,
        ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:programmatic-advertising ;
    vc:isPartOf ngm:digital-marketing,
        ngm:surveillance-capitalism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:data-privacy,
        ngm:privacy ;
    vc:requires ngm:data-collection ;
    vc:slug "targeted-advertising" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:surveillance-capitalism ;
    vc:uses ngm:data-collection,
        ngm:personalisation,
        ngm:programmatic-advertising .

ngm:task-adaptation a owl:Class ;
    rdfs:label "Task Adaptation"@en ;
    rdfs:comment "The process of specialising a pre-trained or general-purpose machine learning model to perform well on a specific downstream task by adjusting its parameters, architecture, or inference behaviour. Task adaptation encompasses techniques such as fine-tuning, instruction tuning, prompt engineering, and parameter-efficient methods (LoRA, adapters) that bridge the gap between a model's pre-training distribution and the requirements of a target application."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:federated-learning ;
    vc:dependsOn ngm:machine-learning-discipline-model,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:enables ngm:machine-learning-discipline-pipeline,
        ngm:task-specific-head ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:hyperparameter ;
    vc:slug "task-adaptation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:instruction-tuning,
        ngm:prompt-engineering .

ngm:task-scheduling a skos:Concept ;
    rdfs:label "Task Scheduling"@en .

ngm:task-space-control a owl:Class ;
    rdfs:label "Task Space Control"@en ;
    rdfs:comment "Task space control, also called operational space control, regulates a robot's end-effector directly in Cartesian task coordinates rather than in joint space. Control laws are formulated in terms of end-effector position, orientation and force, with the manipulator Jacobian mapping task-space commands to joint actuation. This approach simplifies specification of interaction tasks such as following a path, applying a force or maintaining compliance against the environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics-model ],
        ngm:robot-control ;
    vc:bridgesTo ngm:impedance-control ;
    vc:contrastsWith ngm:trajectory-control ;
    vc:dependsOn ngm:feedback-control ;
    vc:enables ngm:compliance-control,
        ngm:force-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:closed-loop-control ;
    vc:isPartOf ngm:robot-control ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robot-control,
        ngm:trajectory-control ;
    vc:requires ngm:kinematics-model ;
    vc:slug "task-space-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:end-effector,
        ngm:motion-planning ;
    vc:uses ngm:inverse-kinematics,
        ngm:jacobian-matrix .

ngm:task-specific-head a owl:Class ;
    rdfs:label "Task Specific Head"@en ;
    rdfs:comment "A Task-Specific Head is a shallow neural network module appended to a frozen or fine-tuned pre-trained model to adapt its representations for a particular downstream task. Architecturally it may be a single linear projection for classification, start/end span predictors for question answering, or a lightweight decoder for generation; it is randomly initialised and optimised during fine-tuning whilst the shared base model provides task-agnostic representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:parameter-efficient-fine-tuning ;
    vc:requires ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:slug "task-specific-head" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:machine-learning-discipline-model,
        ngm:neural-network-layer .

ngm:task-specific-model a owl:Class ;
    rdfs:label "Task Specific Model"@en ;
    rdfs:comment "A Task Specific Model is a machine learning model trained or adapted to perform a single, narrowly defined task such as sentiment classification, named entity recognition or defect detection. Unlike general-purpose foundation models, it optimises parameters against the distribution of one objective, often yielding higher accuracy and lower inference cost for that task. Such models are typically produced by training from scratch on labelled data or by fine-tuning a larger base model."@en ;
    rdfs:subClassOf ngm:foundation-model ;
    vc:bridgesTo ngm:foundation-model ;
    vc:contrastsWith ngm:foundation-model,
        ngm:language-model ;
    vc:dependsOn ngm:model-architecture ;
    vc:enables ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fine-tuning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:transformer ;
    vc:slug "task-specific-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:decision-making ;
    vc:uses ngm:fine-tuning,
        ngm:transfer-learning .

ngm:taxation a skos:Concept ;
    rdfs:label "Taxation"@en .

ngm:tc-0003-telepresence-robot a owl:Class ;
    rdfs:label "tc 0003 telepresence robot"@en ;
    rdfs:comment "Telepresence Robot - Mobile robotic platform with audio-visual and manipulation capabilities enabling a remote operator to have a physical embodied presence, interact with environments, and perform tasks at a distance while maintaining situational awareness through real-time sensory feedback."@en ;
