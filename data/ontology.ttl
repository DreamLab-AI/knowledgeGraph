            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-assurance ],
        ngm:continuous-delivery ;
    vc:contrastsWith ngm:continuous-delivery ;
    vc:dependsOn ngm:continuous-delivery ;
    vc:enables ngm:feedback-loop ;
