ngm:multimodal-ai a owl:Class ;
    rdfs:comment "Artificial intelligence systems that jointly perceive, reason over and generate content across multiple data modalities — text, images, audio, video, depth and sensor streams — by learning shared or aligned representations, enabling capabilities such as image captioning, visual question answering, text-to-image and text-to-audio generation, and speech-driven interaction that no single-modality model can provide on its own."@en ;
    rdfs:label "Multimodal Artificial Intelligence"@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
