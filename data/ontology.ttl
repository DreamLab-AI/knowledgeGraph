    vc:sourceDomain "blockchain" ;
    vc:uses ngm:audit-trail,
        ngm:distributed-ledger-technology,
        ngm:immutability,
        ngm:internet-of-things,
        ngm:smart-contract .

ngm:shader a owl:Class ;
    rdfs:label "Shader"@en ;
    rdfs:comment "A programmable GPU program that replaces fixed-function rendering stages, defining how vertices are transformed and how fragments are coloured by executing artist-authored algorithms in parallel across thousands of GPU threads. Shaders encompass vertex, fragment, geometry, and compute variants, collectively controlling every aspect of a rendered image's visual appearance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
