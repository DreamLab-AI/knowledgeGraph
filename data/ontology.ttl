ngm:presence-indicator a owl:Class ;
    rdfs:comment "A presence indicator is a real-time signal encoding a user's availability, attention, and engagement state in a collaborative system, enabling other participants to determine the optimal channel and urgency of communication before initiating contact."@en ;
