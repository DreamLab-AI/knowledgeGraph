    vc:sourceDomain "spatial-computing" .
ngm:persistent-connection a skos:Concept ;
    rdfs:label "Persistent Connection"@en .
ngm:persistent-content-anchoring a owl:Class ;
    rdfs:comment "Persistent content anchoring is the augmented-reality capability of fixing virtual content to a precise real-world location so that it reappears in the same place across sessions, devices, and users. It relies on saving spatial-anchor data, typically derived from visual feature maps, and relocalising against that map on subsequent visits. The technique is essential for shared and durable AR experiences tied to physical space."@en ;
    rdfs:label "Persistent Content Anchoring"@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame ;
    vc:relatedTo ngm:ar-registration ;
    vc:slug "persistent-content-anchoring" ;
    vc:sourceDomain "metaverse" .
ngm:persistent-engagement a skos:Concept ;
    rdfs:label "Persistent Engagement"@en .
ngm:persistent-identifier a owl:Class ;
    rdfs:comment "A persistent identifier (PID) is a long-lasting, globally unique reference to a digital object that remains stable even as the object's location or custodian changes. PIDs such as DOIs, Handles, and ARKs are resolved through a managed indirection service that maps the identifier to current metadata and access endpoints. They are foundational to citation, provenance, and interoperability in scholarly and digital-object infrastructure."@en ;
    rdfs:label "Persistent Identifier"@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-objects ;
    vc:slug "persistent-identifier" ;
    vc:sourceDomain "data" .
ngm:persistent-identity a skos:Concept ;
    rdfs:label "Persistent Identity"@en .
ngm:persistent-memory a owl:Class ;
    rdfs:comment "Persistent Memory (PMEM) is a class of byte-addressable, non-volatile storage technology that occupies the memory bus and exposes its capacity directly to processor load/store instructions, combining the persistence of storage media with latency approaching that of DRAM. It sits in a new tier of the memory hierarchy between volatile DRAM and block-accessed SSDs, enabling applications to retain state across power cycles without the overhead of traditional I/O system calls."@en ;
    rdfs:label "Persistent Memory"@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:enables ngm:machine-learning-discipline-infrastructure ;
