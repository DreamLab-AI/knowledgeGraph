        ngm:telecollaboration ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:real-time-communication,
        ngm:synchronous-collaboration ;
    vc:enables ngm:deep-work,
        ngm:global-accessibility,
        ngm:open-source-development,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
