] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:IMU
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:Camera
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:combinedWith ;
    owl:someValuesFrom rb:RB1015kalmanfilter
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:combinedWith ;
    owl:someValuesFrom rb:SLAM
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:suffersFrom ;
    owl:someValuesFrom rb:CumulativeError
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:suffersFrom ;
    owl:someValuesFrom rb:WheelSlip
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:improvedBy ;
    owl:someValuesFrom rb:SensorFusion
] .

# Social Robotics
rb:SocialRobotics a owl:Class ;
    rdfs:subClassOf rb:HumanRobotInteraction ;
    rdfs:label "Social Robotics"@en ;
    rdfs:comment "A field of robotics focused on designing robots capable of interacting and communicating with humans and other autonomous agents in a socially acceptable manner, following social rules, norms, and expectations of human interaction."@en ;
