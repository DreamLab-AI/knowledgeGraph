ngm:enterprise-risk-management a owl:Class ;
    rdfs:label "Enterprise Risk Management"@en ;
    rdfs:comment "Enterprise Risk Management (ERM) is a structured, organisation-wide approach to identifying, assessing, prioritising, and mitigating risks that could affect an entity's objectives. It integrates financial, operational, strategic, compliance, and reputational risk into a single governance framework with defined ownership and reporting. Established frameworks such as COSO ERM and ISO 31000 provide the reference models."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:risk-assessment-methodology ;
    vc:slug "enterprise-risk-management" ;
    vc:sourceDomain "governance" .

ngm:entropy-coding a owl:Class ;
    rdfs:label "Entropy Coding"@en ;
    rdfs:comment "Entropy coding is a class of lossless data-compression techniques that assign shorter codewords to more frequent symbols and longer codewords to rarer ones, approaching the information-theoretic entropy limit of a source. Methods such as Huffman coding and arithmetic coding form the final, lossless stage of most image, audio, and video codecs, packing quantised data into a compact bitstream. Because it discards no information, entropy coding can be perfectly reversed during decoding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        ngm:lossless-compression ;
    vc:bridgesTo ngm:image-compression ;
    vc:contrastsWith ngm:lossy-compression ;
    vc:enables ngm:image-compression,
        ngm:video-compression ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-encoding ;
    vc:implements ngm:lossless-compression ;
    vc:isPartOf ngm:data-compression,
        ngm:video-compression ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:codec,
        ngm:data-encoding,
        ngm:signal-processing ;
    vc:requires ngm:entropy ;
    vc:slug "entropy-coding" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:bitrate,
        ngm:video-codec ;
    vc:uses ngm:entropy,
        ngm:statistics .

ngm:erc-20-token-standard a owl:Class ;
    rdfs:label "ERC-20 Token Standard"@en ;
    rdfs:comment "The ERC-20 Token Standard is the foundational Ethereum Request for Comments specification that defines a common interface for fungible tokens on the Ethereum blockchain, enabling seamless interoperability between token contracts, wallets, decentralised exchanges, and other smart contract systems. Proposed by Fabian Vogelsteller in 2015 and formalised as an Ethereum Improvement Proposal, it specifies six mandatory functions—totalSupply, balanceOf, transfer, transferFrom, approve, and allowance—and two events. ERC-20 standardisation catalysed the 2017 ICO boom and remains the dominant token interface in decentralised finance, with thousands of tokens deployed to this specification. Its simplicity has made it the basis for numerous extended standards including ERC-777, ERC-1400, and ERC-3643."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:enterprise-token-standards ;
    vc:bridgesTo ngm:security-token,
        ngm:tokenized-asset ;
    vc:contrastsWith ngm:erc-1155,
        ngm:erc-721,
        ngm:erc-777 ;
    vc:dependsOn ngm:ethereum,
        ngm:solidity ;
    vc:enables ngm:asset-tokenisation,
        ngm:decentralised-finance,
        ngm:decentralized-exchange-dex,
        ngm:initial-coin-offering,
        ngm:token-composability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:transfer-event ;
    vc:implements ngm:ethereum-improvement-proposal,
        ngm:fungible-token ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:erc-20,
        ngm:erc1400-standard,
        ngm:erc3643-standard,
        ngm:governance-token,
        ngm:stablecoin,
        ngm:utility-token ;
    vc:requires ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:smart-contract ;
    vc:slug "erc-20-token-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-smart-contract-platform-foundation ;
    vc:supports ngm:blockchain-interoperability,
        ngm:cryptocurrency-wallet ;
    vc:uses ngm:enterprise-smart-contracts,
        ngm:evm-compatible-blockchain .

ngm:error-signal a owl:Class ;
    rdfs:label "Error Signal"@en ;
    rdfs:comment "An error signal is the quantity in a feedback control system representing the instantaneous difference between the reference setpoint and the actual measured output. It is the driving input to the controller, which acts to reduce it toward zero. The error signal's magnitude, rate of change, and accumulated value are processed by proportional, derivative, and integral control terms respectively."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:derivative-control,
        ngm:feedback-loop ;
    vc:slug "error-signal" ;
    vc:sourceDomain "robotics" .

ngm:ethical-framework a owl:Class ;
    rdfs:label "Ethical Framework"@en ;
    rdfs:comment "A structured set of moral principles, values, and reasoning methods that guide the development, deployment, and use of AI systems to ensure they respect human dignity, promote well-being, and avoid harm. Ethical frameworks draw from consequentialism, deontology, virtue ethics, and care ethics to address AI-specific dilemmas around fairness, transparency, accountability, and privacy."@en ;
