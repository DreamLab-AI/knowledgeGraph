    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:legal-framework,
        ngm:social-platform ;
    vc:requires ngm:avatar-system,
        ngm:virtual-reality-platform ;
    vc:slug "virtual-wedding" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar,
        ngm:metaverse-venue,
        ngm:nft .

