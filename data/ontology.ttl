            owl:someValuesFrom ngm:machine-learning-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alignment ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:failure-mitigation,
        ngm:reliable-deployment,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:alignment,
