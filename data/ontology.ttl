    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:simulation ;
    vc:slug "omniverse" ;
    vc:sourceDomain "metaverse" .

ngm:on-premises a skos:Concept ;
    rdfs:label "On Premises"@en .

ngm:oneM2M a owl:Class ;
    rdfs:label "Onem2M"@en ;
    rdfs:comment "oneM2M is a global standards initiative that defines a common service layer for machine-to-machine and Internet of Things communication, enabling interoperable connection of devices, applications, and platforms across vertical industries. Developed by a partnership of regional standards bodies including ETSI, it specifies a horizontal middleware exposing reusable capabilities such as data management, device management, security, and discovery through a RESTful resource model. By abstracting these common functions, oneM2M reduces fragmentation and lets IoT solutions span domains like smart cities, transport, and energy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-layer ],
        ngm:io-t-infrastructure ;
    vc:enables ngm:interoperability,
        ngm:io-t ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:service-layer ;
    vc:implements ngm:service-layer ;
    vc:isPartOf ngm:io-t-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:standards ;
    vc:slug "oneM2M" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:etsi ;
    vc:supports ngm:io-t,
        ngm:smart-city ;
    vc:uses ngm:co-ap,
        ngm:mqtt,
        ngm:rest .

ngm:open-government a owl:Class ;
    rdfs:label "Open Government"@en ;
    rdfs:comment "Open government is a governance approach grounded in transparency, citizen participation, and accountability, holding that public institutions should make their information and decision-making accessible and engage the public in shaping them. It is operationalised through open data, freedom-of-information mechanisms, participatory processes, and the use of digital technology to expose how government works. The aim is to build public trust, improve services, and enable scrutiny of the use of public resources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-data ],
        ngm:digital-governance ;
    vc:bridgesTo ngm:digital-democracy ;
    vc:dependsOn ngm:open-data ;
    vc:enables ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:digital-governance,
        ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:digital-democracy,
        ngm:digital-governance,
        ngm:open-source ;
    vc:requires ngm:open-data,
        ngm:transparency ;
    vc:slug "open-government" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:stakeholder-engagement,
        ngm:transparency ;
    vc:uses ngm:data-sharing,
        ngm:open-data .

ngm:open-home-foundation a owl:Class ;
    rdfs:label "Open Home Foundation"@en ;
    rdfs:comment "The Open Home Foundation is a non-profit organization that stewards open-source smart-home projects, most notably Home Assistant, to advance privacy, choice, and sustainability in home automation. It holds and governs the intellectual property of these projects, funds development, and protects them from commercial capture. Its mission centers on local-first, user-controlled home technology rather than cloud-dependent proprietary platforms."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "open-home-foundation" ;
    vc:sourceDomain "infrastructure" .

ngm:open-protocol a skos:Concept ;
    rdfs:label "Open Protocol"@en .

ngm:open-rail a owl:Class ;
    rdfs:label "OpenRAIL"@en ;
    rdfs:comment "OpenRAIL (Responsible AI License) is a family of model licenses that grant broad permission to use and distribute AI models while imposing use-based behavioral restrictions to prevent harmful applications. Unlike traditional open-source licenses, it couples openness with enforceable conditions prohibiting specified misuse such as discrimination or disinformation. OpenRAIL has become a common licensing framework for openly released foundation models and their training artifacts."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:training-data ;
    vc:slug "open-rail" ;
    vc:sourceDomain "ai" .

ngm:open-source-initiative a owl:Class ;
    rdfs:label "Open Source Initiative"@en ;
    rdfs:comment "The Open Source Initiative is a non-profit organisation that stewards the Open Source Definition and maintains the authoritative process for reviewing and approving software licences as conforming to it. By certifying which licences qualify as open source, it provides a stable, community-recognised standard that distinguishes genuine open-source terms from merely source-available ones. The organisation also advocates for open-source software and educates on licensing and policy."@en ;
    rdfs:subClassOf ngm:standards-organization ;
    vc:bridgesTo ngm:standards ;
    vc:contrastsWith ngm:proprietary-software ;
    vc:enables ngm:licensing,
        ngm:open-source-licence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:open-standard ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-collaboration,
        ngm:open-source,
        ngm:open-source-licence ;
    vc:slug "open-source-initiative" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:open-standard ;
    vc:supports ngm:community,
        ngm:open-source ;
    vc:uses ngm:licensing .

ngm:open-x-embodiment a owl:Class ;
    rdfs:label "Open X-Embodiment"@en ;
    rdfs:comment "Open X-Embodiment is a large, collaborative open dataset and associated model effort that aggregates robot manipulation demonstrations across many robot embodiments and labs. By pooling trajectories from diverse hardware into a unified format, it enables training generalist robot policies that transfer across different platforms. The initiative supports research into cross-embodiment learning and the RT-X family of robotic foundation models."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embodied-minds,
        ngm:imitation-learning ;
    vc:slug "open-x-embodiment" ;
    vc:sourceDomain "robotics" .

ngm:open-zeppelin-contracts a owl:Class ;
    rdfs:label "OpenZeppelin Contracts"@en ;
    rdfs:comment "OpenZeppelin Contracts is a widely used open-source library of secure, audited, and reusable smart-contract components for Ethereum and EVM-compatible chains. It provides standard implementations of token interfaces such as ERC-20, ERC-721, and ERC-1155, along with access control, upgradeability, and security utilities. The library is a de facto baseline for safe smart-contract development, reducing the risk of common vulnerabilities."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-tooling,
        ngm:nft-minting ;
    vc:slug "open-zeppelin-contracts" ;
    vc:sourceDomain "blockchain" .

ngm:openapi-initiative a owl:Class ;
    rdfs:label "Openapi Initiative"@en ;
    rdfs:comment "The OpenAPI Initiative (OAI) is an open-governance consortium under the Linux Foundation that maintains the OpenAPI Specification, a vendor-neutral, machine-readable format for describing HTTP APIs. It evolved from the donated Swagger specification and provides a standard contract that both humans and tools can use to understand, document, generate and test RESTful interfaces. By standardising API descriptions it promotes interoperability across the API tooling ecosystem, including documentation generators, client SDK generators and gateways. The initiative governs the specification's stewardship and version evolution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:openapi ],
        ngm:standards ;
    vc:bridgesTo ngm:api-gateway ;
    vc:enables ngm:api-management,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:openapi ;
    vc:implements ngm:web-standard ;
    vc:isPartOf ngm:linux-foundation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:api-management,
        ngm:rest ;
    vc:requires ngm:web-standard ;
    vc:slug "openapi-initiative" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:linux-foundation ;
    vc:supports ngm:api-design,
        ngm:rest-api ;
    vc:uses ngm:openapi .

ngm:openmp a skos:Concept ;
    rdfs:label "Openmp"@en .

ngm:operational-efficiency a owl:Class ;
    rdfs:label "Operational Efficiency"@en ;
    rdfs:comment "Operational Efficiency is the capability of an organization or system to deliver outputs while minimizing wasted resources such as time, cost, energy, and labor. It is achieved through process optimization, automation, and measurement of input-to-output ratios across workflows. In industrial and digital contexts it is a primary target of automation and transformation initiatives that seek higher throughput and lower unit cost."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-transformation,
        ngm:robo-actuation-and-control ;
    vc:slug "operational-efficiency" ;
    vc:sourceDomain "infrastructure" .

ngm:operational-layer a owl:Class ;
    rdfs:label "Operational Layer"@en ;
    rdfs:comment "The Operational Layer is the cross-cutting stratum concerned with running, maintaining, and recovering a system in production. It sits above the runtime and tooling strata it relies on and supports the institutional commitments made above. It contains deployment pipelines, monitoring, incident response, and capacity management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:runtime-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tooling-layer ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:application-layer,
        ngm:institutional-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:runtime-layer,
        ngm:tooling-layer ;
    vc:slug "operational-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:optics a skos:Concept ;
    rdfs:label "Optics"@en .

ngm:optimal-transport a owl:Class ;
    rdfs:label "Optimal Transport"@en ;
    rdfs:comment "Optimal Transport is the mathematical theory of moving one probability distribution to another while minimising a total cost defined by a ground metric. Its solution induces the Wasserstein distance, a geometrically meaningful divergence between distributions that, unlike many alternatives, behaves well even when supports do not overlap. In machine learning it grounds generative model training, domain adaptation, and distribution matching, including flow-based formulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        ngm:probability-theory ;
    vc:bridgesTo ngm:domain-adaptation ;
    vc:enables ngm:domain-adaptation,
        ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:loss-function ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:neural-network,
        ngm:variational-autoencoder ;
    vc:requires ngm:probability-distribution ;
    vc:slug "optimal-transport" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:generative-adversarial-network,
        ngm:normalizing-flow ;
    vc:uses ngm:gradient-descent,
        ngm:probability-distribution .

ngm:optimistic-verification a owl:Class ;
    rdfs:label "Optimistic Verification"@en ;
    rdfs:comment "Optimistic Verification is a security model in which state transitions or cross-chain messages are presumed valid and accepted after a challenge period unless a fraud proof demonstrates otherwise. It avoids the cost of validating every claim upfront, relying instead on economically incentivized watchers to detect and dispute invalid assertions. The approach underpins optimistic rollups and many cross-chain bridge designs that prioritize throughput over instant finality."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "optimistic-verification" ;
    vc:sourceDomain "blockchain" .

ngm:optimization-algorithms a owl:Class ;
    rdfs:label "Optimization Algorithms"@en ;
    rdfs:comment "Mathematical procedures for minimising or maximising objective functions, central to training machine learning models. Gradient-based methods (SGD, Adam, RMSprop, AdaGrad) iteratively update model parameters to reduce loss; advanced techniques encompass momentum-based optimisation, adaptive learning rates, second-order methods (L-BFGS, natural gradient), and gradient-free approaches (evolutionary strategies, Bayesian optimisation), addressing non-convexity, saddle points, and high-dimensional parameter-space challenges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:fine-tuning,
        ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backpropagation,
        ngm:gradient-descent ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "optimization-algorithms" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network .

ngm:optimization-technique a owl:Class ;
    rdfs:label "Optimization Technique"@en ;
    rdfs:comment "A systematic method applied to improve computational performance, memory efficiency, or rendering throughput in metaverse and spatial computing infrastructure. Optimisation techniques span algorithmic improvements (level-of-detail, culling, compression), hardware utilisation strategies (GPU parallelism, cache coherence), and software-level approaches (batching, shader optimisation) that collectively reduce latency and resource consumption."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-infrastructure,
        ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "optimization-technique" ;
    vc:sourceDomain "infrastructure" ;
