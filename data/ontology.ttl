    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:point-cloud-generation ;
    vc:isPartOf ngm:geographic-information-system ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:lidar,
        ngm:logistics-optimization,
        ngm:point-cloud-generation ;
    vc:requires ngm:coordinate-reference-system,
