ngm:multi-cloud a owl:Class ;
    rdfs:comment "A cloud deployment strategy in which an organisation consumes services from two or more independent public cloud providers — such as AWS, Azure, and Google Cloud — distributing workloads to avoid vendor lock-in, satisfy data-residency and regulatory requirements, exploit provider-specific strengths, and improve resilience against provider-wide outages, at the cost of increased operational complexity, duplicated tooling, and cross-cloud egress charges."@en ;
    rdfs:label "Multi-Cloud"@en ;
    rdfs:subClassOf ngm:cloud-computing ;
