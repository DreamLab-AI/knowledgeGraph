    vc:slug "ebsi" ;
    vc:sourceDomain "blockchain" .
ngm:ecash a owl:Class ;
    rdfs:comment "A privacy-preserving digital cash system based on David Chaum's blind-signature cryptography, enabling bearer-token payments in which the issuing mint cannot link individual transactions to users. Modern implementations such as Cashu and Fedimint build Chaumian eCash on top of Bitcoin and the Lightning Network, enabling censorship-resistant micropayments for human and autonomous-agent use."@en ;
    rdfs:label "ecash"@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
