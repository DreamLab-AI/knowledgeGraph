    vc:slug "data-provenance" ;
    vc:sourceDomain "infrastructure" .

ngm:encoder-decoder-architecture a owl:Class ;
    rdfs:label "Encoder Decoder Architecture"@en ;
    rdfs:comment "A neural network design pattern comprising an encoder that compresses an input sequence into a latent representation and a decoder that generates an output sequence from that representation, enabling sequence-to-sequence mappings for tasks such as machine translation, summarisation, and image captioning. The architecture underpins the original Transformer (Vaswani et al., 2017) and models such as T5 and BART."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:multimodal-ai ;
    vc:contrastsWith ngm:decoder-only-architecture,
        ngm:encoder-only-architecture,
        ngm:recurrent-neural-network ;
    vc:dependsOn ngm:gradient-descent,
        ngm:neural-network ;
    vc:enables ngm:image-captioning,
        ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:text-summarisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cross-attention,
        ngm:feed-forward-network,
        ngm:latent-representation,
        ngm:positional-encoding,
        ngm:self-attention,
        ngm:token-embedding ;
    vc:implements ngm:large-language-model,
        ngm:transformer ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:bart-model,
        ngm:bert,
        ngm:t5-model ;
    vc:requires ngm:attention-mechanism,
        ngm:backpropagation ;
    vc:slug "encoder-decoder-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autoregressive-generation,
        ngm:transfer-learning ;
    vc:uses ngm:layer-normalisation,
        ngm:multi-head-attention,
        ngm:softmax-function .

ngm:high-availability a owl:Class ;
    rdfs:label "High Availability"@en ;
    rdfs:comment "High Availability (HA) is an infrastructure design property that specifies and enforces the conditions under which a system continues delivering its intended service despite component failures, maintenance windows, or demand spikes. HA is quantified by availability targets expressed as 'nines' — for example 99.9% permits roughly 8.7 hours of downtime per year, while 99.999% ('five nines') permits only 5.26 minutes — achieved through redundant components, active-active or active-passive failover, continuous health monitoring, and automated recovery orchestration. It is operationalised through the complementary metrics of Mean Time Between Failures (MTBF) and Mean Time To Recovery (MTTR), with recovery time objectives (RTO) and recovery point objectives (RPO) anchoring HA targets to business continuity requirements. HA is a foundational non-functional requirement in cloud-native platforms, telecommunications networks, financial trading systems, and safety-critical infrastructure where service interruption carries regulatory, commercial, or life-safety consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:redundancy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reliability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:aiops,
        ngm:predictive-maintenance ;
    vc:contrastsWith ngm:eventual-consistency,
        ngm:single-point-of-failure ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:storage-replication ;
    vc:enables ngm:business-continuity,
        ngm:disaster-recovery,
        ngm:service-level-agreement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:automatic-failover,
        ngm:data-replication,
        ngm:failover,
        ngm:load-balancing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:chaos-engineering,
        ngm:circuit-breaker-pattern,
        ngm:kubernetes,
        ngm:service-mesh ;
    vc:requires ngm:fault-tolerance,
        ngm:health-monitoring,
        ngm:redundancy,
        ngm:reliability ;
    vc:slug "high-availability" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-native,
        ngm:microservices-architecture,
        ngm:site-reliability-engineering ;
    vc:uses ngm:cloud-infrastructure,
        ngm:consensus-algorithms,
        ngm:container-orchestration,
        ngm:distributed-systems .

ngm:information-security a owl:Class ;
    rdfs:label "Information Security"@en ;
    rdfs:comment "Information Security addresses the protection of data, systems, models, and AI infrastructure from unauthorised access, adversarial attacks, privacy breaches, and malicious exploitation. Security measures encompass differential privacy, federated learning, robust training methods, secure multi-party computation, and encryption to ensure confidentiality, integrity, and availability of systems and data as critical infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulnerability-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authorisation ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:distributed-systems-security ;
    vc:contrastsWith ngm:adversarial-machine-learning ;
    vc:dependsOn ngm:public-key-infrastructure,
        ngm:secure-communication-protocols ;
    vc:enables ngm:data-governance,
        ngm:regulatory-compliance,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:access-control,
        ngm:cryptography,
        ngm:intrusion-detection,
        ngm:vulnerability-management ;
    vc:implements ngm:cia-triad,
        ngm:zero-trust-architecture ;
    vc:isPartOf ngm:risk-management ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:incident-response,
        ngm:security-operations ;
    vc:requires ngm:authentication,
        ngm:authorisation,
        ngm:threat-modeling ;
    vc:slug "information-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-cybersecurity-framework ;
    vc:supports ngm:ai-safety,
