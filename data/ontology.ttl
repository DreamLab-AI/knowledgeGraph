ngm:cybersecurity a owl:Class ;
    rdfs:comment "Cybersecurity is the discipline concerned with protecting computer systems, networks, and data from unauthorised access, damage, and attack. In the AI governance context it addresses adversarial threats to machine learning models, data poisoning, model extraction, and the use of AI techniques for automated threat detection, vulnerability analysis, and intrusion detection. It overlaps strongly with privacy, encryption, access control, and authentication."@en ;
    rdfs:label "Cybersecurity"@en ;
    rdfs:subClassOf ngm:information-security ;
