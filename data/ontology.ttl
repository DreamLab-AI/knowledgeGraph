ngm:conflict-resolution a owl:Class ;
    rdfs:label "Conflict Resolution"@en ;
    rdfs:comment "Conflict Resolution encompasses the structured methods, protocols, and mechanisms used to identify, address, and settle disputes between parties — whether human individuals, organisations, autonomous agents, or distributed systems. In technical contexts it includes algorithmic approaches for reconciling inconsistencies in distributed data systems, consensus protocols that converge divergent states, and governance frameworks for mediating disagreements in decentralised organisations. In social and legal contexts it spans negotiation, mediation, arbitration, and adjudication, with increasing automation and AI-assisted facilitation. Across all domains, effective conflict resolution preserves relationships, maintains system integrity, and enables continued collaboration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        ngm:dispute-resolution-mechanism ;
    vc:bridgesTo ngm:byzantine-fault-tolerance,
        ngm:value-alignment ;
    vc:enables ngm:community-governance-model,
        ngm:decentralized-governance,
        ngm:trustless-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:arbitration-decision-engine,
        ngm:arbitration-process,
        ngm:consensus-mechanism,
        ngm:mediation,
        ngm:negotiation-protocol ;
    vc:requires ngm:governance-framework,
        ngm:trust-model ;
    vc:slug "conflict-resolution" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:distributed-ledger-technology,
        ngm:multi-agent-systems,
        ngm:organisational-resilience ;
    vc:uses ngm:dao-governance,
        ngm:game-theory,
        ngm:natural-language-processing,
        ngm:smart-contract-coordination .

ngm:data-augmentation a owl:Class ;
    rdfs:label "Data Augmentation"@en ;
    rdfs:comment "Data augmentation is a machine learning technique that expands a training dataset by applying label-preserving transformations or synthesising new examples from existing data. Typical methods include geometric and photometric image transforms, noise injection, and generative model sampling such as GAN-produced samples, diffusion-model synthesis, and mixing-based strategies such as Mixup and CutMix. It improves model generalisation and robustness, mitigating overfitting when labelled data is scarce. Modern automated augmentation pipelines such as AutoAugment and RandAugment use reinforcement learning or random search to discover optimal policies, while 2024-2026 diffusion-based approaches such as DiffuseMix enable label-preserving generation of high-fidelity training examples that improve performance on imbalanced and low-resource benchmarks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixup ],
        ngm:machine-learning-discipline-technique,
        ngm:regularisation ;
    vc:contrastsWith ngm:active-learning,
        ngm:data-collection ;
    vc:enables ngm:class-imbalance-mitigation,
        ngm:model-generalisation,
        ngm:model-robustness,
        ngm:overfitting-prevention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoaugment,
        ngm:cutmix,
        ngm:feature-space-augmentation,
        ngm:geometric-transformation,
        ngm:mixup,
        ngm:noise-injection,
        ngm:photometric-transformation,
        ngm:randaugment ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:class-imbalance,
        ngm:dropout,
        ngm:regularisation,
        ngm:synthetic-data ;
    vc:requires ngm:data-preprocessing,
        ngm:training-dataset,
        ngm:training-pipeline ;
    vc:slug "data-augmentation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:few-shot-learning,
        ngm:self-supervised-learning,
        ngm:semi-supervised-learning,
        ngm:supervised-learning,
        ngm:transfer-learning ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-networks,
        ngm:reinforcement-learning,
        ngm:synthetic-data-generator,
        ngm:variational-autoencoder .

ngm:data-replication a owl:Class ;
    rdfs:label "Data Replication"@en ;
    rdfs:comment "The process of copying and maintaining data across multiple nodes, servers, or locations in distributed systems to ensure consistency, availability, and fault tolerance, using consensus algorithms like Paxos, Raft, and Byzantine Fault Tolerant protocols to coordinate state across decentralised networks."@en ;
