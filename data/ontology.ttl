    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-attention,
        ngm:multi-head-attention,
        ngm:positional-encoding,
        ngm:query-key-value,
        ngm:self-attention ;
    vc:slug "attention-weight" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer .

ngm:augmented-connected-workforce a owl:Class ;
    rdfs:label "Augmented Connected Workforce"@en ;
    rdfs:comment "The Augmented Connected Workforce (ACW) is a digitally enhanced work paradigm in which human capabilities are amplified through the seamless integration of AI, augmented reality, virtual reality, and IoT technologies, enabling immersive spatial interactions and real-time connectivity across distributed teams. ACW systems overlay contextual digital information onto physical workspaces and connect workers to shared virtual environments, boosting safety, training efficacy, and operational coordination. It is recognised by Gartner as a strategic technology trend reshaping how organisations design, operate, and evolve their human workforce."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-technology ],
        ngm:metaverse-and-telecollaboration,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
