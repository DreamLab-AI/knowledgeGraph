    vc:requires ngm:end-effector ;
    vc:requires ngm:grasp-planning ;
    vc:requires ngm:robot-perception ;
    vc:slug "robotic-grasping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:point-cloud ;
    vc:uses ngm:tactile-sensing .
ngm:robotic-manipulation a owl:Class ;
    rdfs:comment "Robotic manipulation is the field concerned with how robots physically interact with and change the state of objects in their environment — grasping, moving, assembling, and reorienting items using arms, hands, and end-effectors. It integrates perception, motion planning, control, and contact reasoning so that a robot can compute and execute the forces and trajectories needed to handle objects reliably under uncertainty. Manipulation spans rigid pick-and-place in structured factories through to dexterous, contact-rich handling of deformable or unfamiliar objects in unstructured human environments."@en ;
    rdfs:label "Robotic Manipulation"@en ;
    rdfs:subClassOf ngm:manipulation ;
    rdfs:subClassOf _:r18460 ;
    rdfs:subClassOf _:r18461 ;
    rdfs:subClassOf _:r18462 ;
    rdfs:subClassOf _:r18463 ;
    rdfs:subClassOf _:r18464 ;
