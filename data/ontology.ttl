    vc:slug "objective" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:optimization-algorithm,
        ngm:training-data .

ngm:obstacle-detection a owl:Class ;
    rdfs:label "Obstacle Detection"@en ;
    rdfs:comment "Obstacle Detection is the robotics perception task of identifying and localising physical objects in a robot's surroundings that may impede or endanger its motion. It fuses data from sensors such as lidar, cameras, radar and ultrasonic rangefinders to build a representation of free and occupied space. Reliable obstacle detection is a prerequisite for safe autonomous navigation, collision avoidance and motion planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        ngm:perception ;
    vc:bridgesTo ngm:autonomous-navigation ;
    vc:contrastsWith ngm:localization ;
    vc:dependsOn ngm:sensor-fusion ;
    vc:enables ngm:autonomous-navigation,
        ngm:collision-avoidance,
        ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:perception ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:slam,
        ngm:stereo-vision ;
    vc:requires ngm:perception,
        ngm:sensor-fusion ;
    vc:slug "obstacle-detection" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:path-planning ;
    vc:uses ngm:camera,
        ngm:lidar,
        ngm:object-detection,
        ngm:point-cloud .

ngm:occlusion-rendering a owl:Class ;
    rdfs:label "Occlusion Rendering"@en ;
    rdfs:comment "Occlusion rendering is the set of techniques used in real-time and offline graphics pipelines to correctly determine and display which surfaces are hidden behind other geometry from a given camera viewpoint, as well as to compute the darkening of surfaces due to local geometric obstruction of ambient light. It encompasses hardware depth-buffer culling, ambient occlusion shading, screen-space occlusion methods, and — in augmented reality — the masking of virtual objects by real-world foreground geometry. Correct occlusion is essential for perceptual plausibility in both games and AR/VR applications."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:enables ngm:ar-occlusion,
        ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ambient-occlusion,
        ngm:occlusion-culling ;
    vc:slug "occlusion-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-estimation,
        ngm:rasterization,
        ngm:ray-tracing .

ngm:on-chain-identity a owl:Class ;
    rdfs:label "On-Chain Identity"@en ;
    rdfs:comment "On-chain identity is a persistent, cryptographically controlled identifier recorded on a blockchain that an entity uses to accumulate verifiable attributes, history, and reputation. Anchored to an address or smart contract and controlled by private keys, it can hold credentials, tokens, and attestations that other applications read trustlessly. It enables portable reputation and access control across decentralised applications."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nft-minting,
        ngm:reputation-system ;
    vc:slug "on-chain-identity" ;
    vc:sourceDomain "blockchain" .

ngm:one-way-function a owl:Class ;
    rdfs:label "One Way Function"@en ;
    rdfs:comment "A one-way function is a function that is easy to compute on any input but computationally infeasible to invert, meaning that recovering the input from a typical output is practically impossible with available resources. One-way functions are a foundational primitive of modern cryptography, underpinning hashing, password storage, and the trapdoor constructions used in public-key schemes. Their existence is conjectured rather than proven, and it is closely tied to open questions in computational complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preimage-resistance ],
        ngm:cryptography ;
    vc:bridgesTo ngm:cryptographic-algorithm ;
    vc:contrastsWith ngm:trapdoor-function ;
    vc:dependsOn ngm:modular-arithmetic ;
    vc:enables ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cryptographic-hash-function ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:pseudorandom-function,
        ngm:trapdoor-function ;
    vc:requires ngm:preimage-resistance ;
    vc:slug "one-way-function" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:password-hashing,
        ngm:proof-of-work ;
    vc:uses ngm:hash-function .

ngm:open-policy-agent a owl:Class ;
    rdfs:label "Open Policy Agent"@en ;
    rdfs:comment "Open Policy Agent (OPA) is an open-source, general-purpose policy engine that decouples authorisation and policy decisions from application code by evaluating declarative policies against structured input. Policies are written in its purpose-built language, Rego, and OPA returns decisions that calling services enforce. As a graduated Cloud Native Computing Foundation project, it is widely used to implement policy-as-code across Kubernetes admission control, microservice authorisation, and API gateways. OPA acts as a policy decision point, leaving enforcement to integrated policy enforcement points."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-enforcement-point ],
        ngm:policy-engine ;
    vc:enables ngm:access-control,
        ngm:authorization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:policy-as-code,
        ngm:policy-decision-point ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:kubernetes,
        ngm:microservices ;
    vc:requires ngm:policy-enforcement-point ;
    vc:slug "open-policy-agent" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:open-source ;
    vc:supports ngm:attribute-based-access-control,
        ngm:role-based-access-control ;
    vc:uses ngm:security-policy .

ngm:operational-risk a owl:Class ;
    rdfs:label "Operational Risk"@en ;
    rdfs:comment "Operational risk is the risk of loss resulting from inadequate or failed internal processes, people and systems, or from external events. It encompasses fraud, human error, system failures, legal and compliance breaches, and disruptions such as cyber-attacks or natural disasters, but excludes strategic and reputational risk in its narrow Basel definition. Managing it relies on controls, monitoring, capital allocation and resilience planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:risk-management ;
    vc:bridgesTo ngm:governance-risk-compliance ;
    vc:dependsOn ngm:business-continuity,
        ngm:operational-resilience ;
    vc:enables ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:enterprise-risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:credit-risk,
        ngm:market-risk,
        ngm:supply-chain-risk-management ;
    vc:requires ngm:audit,
        ngm:fraud-detection ;
    vc:slug "operational-risk" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-iii ;
    vc:supports ngm:capital-adequacy,
        ngm:compliance .

ngm:optical-systems a owl:Class ;
    rdfs:label "Optical Systems"@en ;
    rdfs:comment "Optical Systems are arrangements of lenses, mirrors, waveguides, and combiners that direct and form light to project or relay images. In display hardware they govern how rendered content is delivered to the eye, including focus, field of view, and image clarity. Augmented- and virtual-reality headsets depend on compact optical systems such as pancake lenses and waveguide combiners to merge virtual imagery with the real world."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-display-device,
        ngm:display-hardware ;
    vc:slug "optical-systems" ;
    vc:sourceDomain "metaverse" .

ngm:outpainting a owl:Class ;
    rdfs:label "Outpainting"@en ;
    rdfs:comment "Outpainting is a generative AI technique that extends an existing image beyond its original canvas boundaries by synthesising new, contextually consistent pixel content in the surrounding regions. A masked version of the source image—padded with blank or noise-filled regions—is fed to a conditioned image generation model (typically a latent diffusion model) which fills the extended area while respecting the style, lighting, and semantic content of the original. Outpainting is widely used in content creation pipelines for widening aspect ratios, reconstructing damaged artwork borders, and generating panoramic background extensions for virtual production and 3D scene authoring."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:image-generation,
        ngm:inpainting ;
    vc:slug "outpainting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:latent-diffusion .

ngm:pagerank a owl:Class ;
    rdfs:label "PageRank"@en ;
    rdfs:comment "PageRank is a link-analysis algorithm that assigns a numerical importance score to each node in a directed graph based on the structure of incoming links, modelling importance as the stationary distribution of a random walk that occasionally teleports to a random node. Originally devised to rank web pages by treating hyperlinks as votes whose weight depends on the ranking of the linking page, it generalises to any graph where influence propagates along edges. The scores are computed iteratively until convergence and are robust to local manipulation because importance flows recursively from important neighbours."@en ;
    rdfs:subClassOf ngm:network-analysis ;
    vc:bridgesTo ngm:information-retrieval ;
    vc:dependsOn ngm:graph-theory ;
    vc:enables ngm:recommendation-system,
        ngm:search-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:information-retrieval,
        ngm:search-engine ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graph-theory,
        ngm:network-analysis,
        ngm:recommendation-system ;
    vc:slug "pagerank" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:knowledge-graph ;
    vc:uses ngm:graph-theory,
        ngm:markov-chain .

ngm:parallel-robot a owl:Class ;
    rdfs:label "Parallel Robot"@en ;
    rdfs:comment "A robot whose end-effector is connected to the base by multiple independent, simultaneously actuated kinematic chains (limbs), giving it a closed-loop structure. Parallel robots achieve high rigidity, speed, and accuracy with low moving mass; canonical examples include the Delta robot and Stewart platform used in pick-and-place, machining, and flight simulation applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delta-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stewart-platform ],
        ngm:manipulator-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:cylindrical-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delta-robot,
        ngm:stewart-platform ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:scara-robot ;
    vc:slug "parallel-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:electric-linear-actuator,
        ngm:forward-kinematics,
        ngm:robot-joint .

ngm:partial-synchrony a owl:Class ;
    rdfs:label "Partial Synchrony"@en ;
    rdfs:comment "Partial synchrony is a timing model for distributed systems that sits between the fully synchronous model, where message delays are bounded and known, and the fully asynchronous model, where delays are unbounded. In the partially synchronous model there exists an unknown bound on message delay that eventually holds after some unknown global stabilisation time (GST), or alternatively a known bound that holds only after GST. This model is the theoretical foundation for practical Byzantine fault-tolerant consensus protocols, allowing them to circumvent the FLP impossibility result by guaranteeing safety always and liveness once the network behaves synchronously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        ngm:consensus-protocol ;
    vc:contrastsWith ngm:flp-impossibility ;
    vc:enables ngm:blockchain-consensus,
        ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:fault-tolerance,
        ngm:quorum ;
    vc:requires ngm:consensus-protocol,
        ngm:leader-election ;
    vc:slug "partial-synchrony" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:paxos,
        ngm:raft,
        ngm:tendermint ;
    vc:uses ngm:gossip-protocol .

ngm:particle-system a owl:Class ;
    rdfs:label "Particle System"@en ;
    rdfs:comment "A computer graphics technique that simulates fuzzy, chaotic, or fluid phenomena by managing large numbers of small graphical objects with properties like position, velocity, color, and lifetime, controlled by emitters and affected by forces to create effects like fire, smoke, water, and magical e..."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:visual-effects ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "particle-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:pathfinding-algorithm a owl:Class ;
    rdfs:label "Pathfinding Algorithm"@en ;
    rdfs:comment "A computational algorithm that determines an optimal or near-optimal route between a start and goal node in a graph or spatial environment. Pathfinding algorithms are central to autonomous navigation, game AI, robotics, and metaverse movement systems, with classical examples including Dijkstra's algorithm for shortest paths and A* for heuristic-guided search in spatial graphs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:heuristic-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dijkstra-algorithm ],
        ngm:ai-technique,
        ngm:algorithm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:metaverse-navigation-systems,
        ngm:navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dijkstra-algorithm,
        ngm:graph-search,
        ngm:heuristic-methods ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:fast-spatial-queries,
        ngm:search-algorithms ;
    vc:slug "pathfinding-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:graph-algorithms,
        ngm:search-algorithm .

ngm:payment-protocol a owl:Class ;
    rdfs:label "Payment Protocol"@en ;
    rdfs:comment "A payment protocol is a defined set of rules and message formats governing how value transfer is initiated, authorised and settled between parties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocols ],
        ngm:communication-protocols ;
    vc:enables ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-protocols ;
    vc:slug "payment-protocol" ;
    vc:sourceDomain "distributed-systems" .

ngm:performance a owl:Class ;
    rdfs:label "performance"@en ;
    rdfs:comment "Performance is a measure of how efficiently a system completes its work, commonly expressed through throughput, latency, and resource usage."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "performance" ;
    vc:sourceDomain "infrastructure" .

ngm:perpetual-futures a owl:Class ;
    rdfs:label "Perpetual Futures"@en ;
    rdfs:comment "Perpetual futures are derivative contracts that track an underlying asset's price without an expiry or settlement date. A periodic funding-rate payment between long and short holders tethers the contract price to the spot index, replacing the convergence that expiry provides in traditional futures. They are a dominant instrument in crypto derivatives markets, enabling leveraged directional exposure that can be held indefinitely."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:d-yd-x,
        ngm:gmx ;
    vc:slug "perpetual-futures" ;
    vc:sourceDomain "blockchain" .

ngm:persistence-layer a owl:Class ;
    rdfs:label "Persistence Layer"@en ;
    rdfs:comment "A persistence layer is the architectural tier responsible for durably storing and retrieving application state across sessions and process restarts. It abstracts the underlying storage technology, databases, object stores, or distributed logs, behind a uniform interface for reading and writing data. In agent and spatial-computing systems it preserves memory, anchors, and context so that state survives beyond a single runtime."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:spatial-anchor ;
    vc:slug "persistence-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:persistent-memory a owl:Class ;
    rdfs:label "Persistent Memory"@en ;
    rdfs:comment "Persistent Memory (PMEM) is a class of byte-addressable, non-volatile storage technology that occupies the memory bus and exposes its capacity directly to processor load/store instructions, combining the persistence of storage media with latency approaching that of DRAM. It sits in a new tier of the memory hierarchy between volatile DRAM and block-accessed SSDs, enabling applications to retain state across power cycles without the overhead of traditional I/O system calls."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:enables ngm:machine-learning-discipline-infrastructure,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:data-persistence,
        ngm:data-storage,
        ngm:hardware-acceleration ;
    vc:slug "persistent-memory" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:inference-engine,
        ngm:vector-database .

ngm:personalized-virtual-experiences a owl:Class ;
    rdfs:label "Personalized Virtual Experiences"@en ;
    rdfs:comment "Personalized Virtual Experiences are AI-driven, dynamically adaptive virtual environments, narratives, and interactions that are tailored to the preferences, behaviour history, physiological signals, and declared identity of individual users. They integrate recommendation systems, adaptive content generation, avatar customisation, and contextual sensing to construct unique, user-specific pathways through spatial computing environments such as virtual reality, augmented reality, and metaverse platforms. The personalisation layer continuously models user intent and affect, adjusting scene composition, difficulty, pacing, social matchmaking, and content curation in real time. As a convergence point of machine learning, spatial computing, and human-computer interaction, these systems raise significant concerns around data sovereignty, consent, and algorithmic bias."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-profiling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioural-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-data-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:recommendation-systems ],
        ngm:virtual-experience ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-identity,
        ngm:generative-ai ;
    vc:contrastsWith ngm:shared-virtual-space,
        ngm:virtual-experience ;
    vc:dependsOn ngm:cloud-rendering,
        ngm:data-collection,
        ngm:edge-computing ;
    vc:enables ngm:adaptive-learning,
        ngm:immersive-storytelling,
        ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:behavioural-analytics,
        ngm:content-generation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:affective-computing,
        ngm:data-privacy,
        ngm:extended-reality,
        ngm:metaverse ;
    vc:requires ngm:real-time-data-processing,
        ngm:recommendation-systems,
        ngm:user-profiling ;
    vc:slug "personalized-virtual-experiences" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-system,
        ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:spatial-audio .

ngm:pervasive-computing a owl:Class ;
    rdfs:label "Pervasive Computing"@en ;
    rdfs:comment "Pervasive computing — also termed ubiquitous computing — is a paradigm in which computational capability is embedded throughout the physical environment and integrated seamlessly into everyday objects and infrastructure, such that computation becomes a background utility rather than a discrete user activity. Coined by Mark Weiser at Xerox PARC in 1991, the vision encompasses context-aware, networked devices that sense, process, and communicate without explicit user interaction. It is the conceptual precursor to the Internet of Things and ambient intelligence."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:enables ngm:context-aware-computing,
        ngm:internet-of-things,
        ngm:wearable-computing-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:context-awareness,
        ngm:sociotechnical-system ;
    vc:slug "pervasive-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:io-t-sensor-network .

ngm:plasma a owl:Class ;
    rdfs:label "Plasma"@en ;
    rdfs:comment "Plasma is a blockchain scaling framework that builds hierarchical chains of child ledgers anchored to a root chain, processing transactions off the main chain while periodically committing compact state commitments to it. Users retain the ability to exit a child chain back to the root chain by submitting fraud proofs, which preserves the security guarantees of the underlying ledger even if a child chain operator misbehaves. It was an early Layer 2 design that influenced later optimistic and rollup-based scaling approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:ethereum ;
    vc:contrastsWith ngm:rollup,
        ngm:sidechain ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:decentralization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:ethereum,
        ngm:rollup,
        ngm:scalability,
        ngm:sidechain ;
    vc:requires ngm:consensus ;
    vc:slug "plasma" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:scalability ;
    vc:uses ngm:consensus .

ngm:policy-administration-point a owl:Class ;
    rdfs:label "Policy Administration Point"@en ;
    rdfs:comment "A Policy Administration Point (PAP) is the component within an attribute-based or policy-based access control architecture responsible for authoring, storing, and distributing access control policies to Policy Decision Points. The PAP provides the administrative interface through which security administrators define rules governing which subjects may access which resources under what conditions. It is distinct from policy enforcement and evaluation components, focusing solely on policy lifecycle management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management ],
        ngm:access-control ;
    vc:bridgesTo ngm:distributed-ledger ;
    vc:contrastsWith ngm:session-key ;
    vc:dependsOn ngm:biometric-data ;
    vc:enables ngm:access-control,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-schema,
        ngm:governance ;
    vc:implements ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:policy-information-point,
        ngm:security ;
    vc:requires ngm:data-management,
        ngm:digital-identity ;
    vc:slug "policy-administration-point" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:personal-data,
        ngm:privacy .

ngm:posix a owl:Class ;
    rdfs:label "POSIX"@en ;
    rdfs:comment "POSIX (Portable Operating System Interface) is a family of IEEE standards that defines the application programming interface, command-line shells, and utility interfaces for maintaining compatibility between operating systems. By specifying system calls, file-system semantics, process control, and shell behaviour, POSIX allows software written against the standard to be ported across conforming Unix-like systems with minimal modification. It is the canonical contract underpinning portable system software."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:bridgesTo ngm:operating-system ;
    vc:contrastsWith ngm:api-standard ;
    vc:enables ngm:interoperability,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:file-system,
        ngm:operating-system ;
    vc:isPartOf ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability ;
    vc:slug "posix" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api-standard,
        ngm:ieee ;
    vc:supports ngm:portability ;
    vc:uses ngm:file-system .

ngm:post-training-quantisation a owl:Class ;
    rdfs:label "Post Training Quantisation"@en ;
    rdfs:comment "Post-training quantisation (PTQ) converts a trained full-precision neural network to a lower-precision representation, typically 8-bit integers, without re-running the original training loop. A small calibration dataset is used to estimate the dynamic range of activations so that scale and zero-point parameters can be chosen. PTQ trades a small, usually recoverable, drop in accuracy for substantial reductions in model size and inference cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        ngm:quantisation ;
    vc:contrastsWith ngm:knowledge-distillation,
        ngm:model-pruning-for-edge-deployment ;
    vc:dependsOn ngm:deep-neural-network ;
    vc:enables ngm:edge-inference,
        ngm:on-device-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:calibration ;
    vc:implements ngm:neural-network-quantisation,
        ngm:quantisation ;
    vc:isPartOf ngm:model-compression ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-compression-for-edge,
        ngm:model-quantization ;
    vc:requires ngm:calibration,
        ngm:neural-network ;
    vc:slug "post-training-quantisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:inference-compute,
        ngm:model-deployment ;
    vc:uses ngm:calibration .

ngm:power-purchase-agreement a owl:Class ;
    rdfs:label "Power Purchase Agreement"@en ;
    rdfs:comment "A Power Purchase Agreement (PPA) is a long-term contract between an electricity generator and a buyer that fixes the price, volume and delivery terms for electrical energy over a defined period. PPAs underpin the financing of generation assets, particularly renewable plants, by guaranteeing a stable revenue stream that de-risks capital investment. They allocate market, volume and curtailment risk between producer and offtaker and may be physical or virtual (financial)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:power-systems ;
