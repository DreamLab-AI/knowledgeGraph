ngm:subsumption-architecture a owl:Class ;
    rdfs:label "Subsumption Architecture"@en ;
    rdfs:comment "Subsumption architecture is a layered control method for autonomous agents in which simple reactive behaviours are stacked, with higher layers able to suppress or override lower ones to produce competent behaviour without a central world model."@en ;
