        ngm:nvidia-corporation-omniverse-platform,
        ngm:opc-ua .

ngm:quality-of-service a owl:Class ;
    rdfs:label "Quality Of Service"@en ;
    rdfs:comment "Quality of Service (QoS) is a set of network management techniques, policies, and protocols that prioritise, shape, and guarantee specified performance characteristics—including latency, jitter, throughput, and packet loss—for distinct traffic classes traversing shared network infrastructure. QoS mechanisms operate at multiple OSI layers, using traffic classification, queuing disciplines, scheduling algorithms, and admission control to meet differentiated service-level objectives. In real-time systems such as XR, telepresence, and cloud-native distributed applications, QoS is essential for maintaining acceptable user experience under variable load. Standardised frameworks including IntServ, DiffServ, and IEEE 802.1p provide interoperable models for end-to-end QoS across heterogeneous networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:edge-computing,
        ngm:extended-reality ;
    vc:dependsOn ngm:packet-switching,
        ngm:routing-protocol ;
    vc:enables ngm:low-latency-networking,
        ngm:real-time,
        ngm:service-level-agreement,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:jitter,
        ngm:latency,
        ngm:network-congestion ;
    vc:requires ngm:network-infrastructure,
        ngm:network-protocol ;
    vc:slug "quality-of-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-802-x,
        ngm:ietf ;
    vc:supports ngm:cloud-computing,
        ngm:video-streaming,
        ngm:voice-over-ip ;
    vc:uses ngm:traffic-shaping .

ngm:real-time-processing a owl:Class ;
    rdfs:label "Real-time Processing"@en ;
    rdfs:comment "Real-time Processing is a computational model where data is processed immediately upon arrival or generation, with minimal latency between input and output. Systems respond to events within strict time constraints (typically microseconds to seconds), enabling immediate decision-making through continuous stream-oriented processing rather than deferred batch operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:in-memory-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:complex-event-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:low-latency-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        ngm:data-processing ;
    vc:bridgesTo ngm:real-time-rendering,
        ngm:robotics-control ;
    vc:contrastsWith ngm:batch-processing,
        ngm:lambda-architecture ;
    vc:dependsOn ngm:edge-computing,
        ngm:event-driven-architecture ;
    vc:enables ngm:anomaly-detection,
        ngm:intrusion-detection,
        ngm:predictive-maintenance,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:complex-event-processing,
        ngm:in-memory-computing,
        ngm:stream-processing ;
    vc:isPartOf ngm:data-processing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:backpressure,
        ngm:fault-tolerance,
        ngm:time-series-database ;
    vc:requires ngm:low-latency-network,
        ngm:message-queue ;
    vc:slug "real-time-processing" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:digital-twin,
        ngm:high-frequency-trading ;
    vc:uses ngm:apache-flink,
        ngm:apache-kafka,
        ngm:publish-subscribe-pattern .

ngm:relational-database a owl:Class ;
    rdfs:label "Relational Database"@en ;
    rdfs:comment "A relational database organises data into tables of rows and columns, where relationships between tables are expressed through shared key values rather than physical pointers, following the relational model. Data is queried and manipulated declaratively, conventionally through SQL, and integrity is enforced via constraints, keys and typed schemas. Relational systems typically provide ACID transactions, making them the default choice for consistent, structured operational data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sql ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        ngm:database-management-system ;
    vc:contrastsWith ngm:centralised-database ;
    vc:dependsOn ngm:data-model ;
    vc:enables ngm:data-integration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:transaction ;
    vc:isPartOf ngm:data-storage ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:database-management-system,
        ngm:metadata ;
    vc:requires ngm:data-model,
        ngm:sql ;
    vc:slug "relational-database" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-management,
        ngm:data-quality ;
    vc:uses ngm:sql .

ngm:scope-3-emissions a owl:Class ;
    rdfs:label "Scope 3 Emissions"@en ;
    rdfs:comment "Scope 3 emissions are the indirect greenhouse gas (GHG) emissions that occur across an organisation's value chain as a consequence of its activities but outside its operational boundary, encompassing both upstream sources such as purchased goods and services, capital goods, and business travel, and downstream sources such as the use and end-of-life treatment of sold products. Defined under Category 3 of the GHG Protocol Corporate Standard, Scope 3 emissions typically constitute the largest share of a company's total carbon footprint — often exceeding 70 percent — making their measurement, reporting, and reduction critical to credible corporate climate strategies. Accurate Scope 3 accounting requires collaboration across supply chains and the use of spend-based, activity-based, or supplier-specific emission factors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain-transparency ],
        ngm:carbon-accounting ;
    vc:bridgesTo ngm:blockchain-provenance,
        ngm:digital-product-passport ;
    vc:contrastsWith ngm:scope-1-emissions,
        ngm:scope-2-emissions ;
    vc:enables ngm:decarbonisation,
        ngm:esg-reporting,
        ngm:net-zero-targets,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ghg-protocol,
        ngm:scope-1-emissions,
        ngm:scope-2-emissions,
        ngm:supply-chain ;
    vc:requires ngm:data-collection,
        ngm:supply-chain-transparency ;
    vc:slug "scope-3-emissions" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:corporate-sustainability-reporting-directive,
        ngm:ifrs-s2 ;
    vc:uses ngm:emission-factors,
        ngm:environmental-accounting,
        ngm:life-cycle-assessment .

ngm:search-algorithm a owl:Class ;
    rdfs:label "Search Algorithm"@en ;
    rdfs:comment "Search Algorithms in AI systematically explore solution spaces to find optimal or satisfactory solutions to problems. Classical algorithms include uninformed search (breadth-first, depth-first, uniform-cost) and informed search (A*, greedy best-first, beam search). Advanced techniques incorporate heuristics, pruning, bidirectional search, and iterative deepening. Modern AI integrates learning-based search (Monte Carlo Tree Search with neural networks, learned heuristics) and continuous optimisation methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:informed-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-space ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:information-retrieval,
        ngm:route-planning ;
    vc:contrastsWith ngm:gradient-descent,
        ngm:random-sampling ;
    vc:enables ngm:constraint-satisfaction,
        ngm:game-playing,
        ngm:monte-carlo-tree-search,
        ngm:navigation,
        ngm:planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:informed-search ;
    vc:implements ngm:a-star-algorithm,
        ngm:beam-search,
        ngm:breadth-first-search,
        ngm:depth-first-search ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:combinatorial-optimisation,
        ngm:computational-complexity-theory,
        ngm:constraint,
        ngm:reinforcement-learning ;
    vc:requires ngm:state-space ;
    vc:slug "search-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:dynamic-programming,
        ngm:graph-search,
        ngm:heuristic-methods,
        ngm:priority-queue .

ngm:spatial-mapping a owl:Class ;
    rdfs:label "Spatial Mapping"@en ;
    rdfs:comment "The process of constructing and continuously updating three-dimensional representations of physical environments using sensor data—including depth cameras, LiDAR, and IMU—enabling AR/VR systems to understand surroundings for occlusion, collision, content placement, and navigation. Core algorithms include SLAM variants that fuse visual features with inertial measurements to produce dense mesh or voxel representations in real time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loop-closure-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voxel-grid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-twin ;
    vc:contrastsWith ngm:gps ;
    vc:dependsOn ngm:odometry,
        ngm:point-cloud ;
    vc:enables ngm:augmented-reality,
        ngm:indoor-navigation,
        ngm:mixed-reality,
        ngm:spatial-anchor ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:loop-closure-detection,
        ngm:semantic-map,
        ngm:voxel-grid ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-technology,
