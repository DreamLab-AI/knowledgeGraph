    vc:requires ngm:real-time-rendering ;
    vc:slug "virtual-objects" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:nft .

ngm:virtual-securities-offering-vso a owl:Class ;
    rdfs:label "Virtual Securities Offering (VSO)"@en ;
    rdfs:comment "A tokenized securities issuance process that leverages blockchain technology to create, distribute, and manage digital representations of traditional securities with embedded regulatory compliance and automated governance mechanisms."@en ;
