        ngm:network-participation ;
    vc:slug "blockchain-entity" ;
    vc:sourceDomain "blockchain" .

ngm:decentralised-autonomous-organisation a owl:Class ;
    rdfs:label "Decentralised Autonomous Organisation"@en ;
    rdfs:comment "A Decentralised Autonomous Organisation (DAO) is a blockchain-native organisational structure in which governance rules, treasury management, and operational logic are encoded as smart contracts executing on a public distributed ledger, enabling token-holder communities to propose, deliberate, and vote on decisions without recourse to centralised management or traditional corporate hierarchy. DAOs achieve censorship-resistant, transparent coordination by replacing trusted intermediaries with deterministic on-chain execution, typically combining governance tokens that confer weighted voting rights with treasury contracts that custodise and disburse collective assets. As an emergent governance primitive, DAOs span DeFi protocols, grant programmes, investment collectives, open-source software foundations, and decentralised media organisations, presenting novel challenges around legal personality, voter apathy, and Sybil resistance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-blockchain ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:traditional-corporation ;
    vc:dependsOn ngm:decentralised-finance,
        ngm:tokenomics ;
    vc:enables ngm:on-chain-governance,
        ngm:permissionless-participation,
        ngm:protocol-governance,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance,
        ngm:voting-mechanism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-governance,
        ngm:liquid-democracy,
        ngm:sybil-resistance,
        ngm:token-weighted-voting ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-key-management,
        ngm:public-blockchain ;
    vc:slug "decentralised-autonomous-organisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:multisig-wallet,
        ngm:quadratic-voting,
        ngm:smart-contract .

ngm:gpu-computing a owl:Class ;
    rdfs:label "GPU Computing"@en ;
    rdfs:comment "GPU Computing is the use of graphics processing units as massively parallel co-processors to accelerate general-purpose computational workloads beyond rendering. Modern GPUs contain thousands of shader cores organised into streaming multiprocessors capable of executing thousands of threads simultaneously, making them ideal for data-parallel algorithms in deep learning training, scientific simulation, and signal processing. Frameworks such as CUDA and OpenCL expose this parallelism to application developers through a hierarchical thread and memory model. GPU computing has become the primary accelerator substrate for large-scale machine learning, high-performance computing, and increasingly for inference serving at cloud scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-driver ],
        ngm:hardware-acceleration ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:cpu-computing,
        ngm:field-programmable-gate-array,
        ngm:tensor-processing-unit ;
    vc:enables ngm:deep-learning,
        ngm:distributed-training,
        ngm:high-performance-computing,
        ngm:large-language-model,
        ngm:neural-network-inference,
        ngm:scientific-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:inference-hardware,
        ngm:model-parallelism,
        ngm:nvlink,
        ngm:render-pipeline ;
    vc:requires ngm:gpu-driver,
        ngm:high-bandwidth-memory ;
    vc:slug "gpu-computing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:compiler,
        ngm:compute-shader,
        ngm:cuda,
        ngm:mixed-precision-training,
        ngm:opencl,
        ngm:parallel-processing .

ngm:reinforcement-learning-from-human-feedback a owl:Class ;
    rdfs:label "Reinforcement Learning from Human Feedback"@en ;
    rdfs:comment "A technique for aligning language models with human preferences by training a reward model from human rankings of outputs and using reinforcement learning (typically PPO) to optimise the policy towards maximising predicted human preference. RLHF enables models to learn complex alignment objectives that are difficult to specify explicitly, forming a three-stage pipeline of supervised fine-tuning, reward model training, and RL optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximal-policy-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        ngm:ai-alignment ;
    vc:bridgesTo ngm:ai-governance,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:direct-preference-optimisation,
        ngm:reward-modelling ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:instruction-following,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:reinforcement-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-in-the-loop,
        ngm:instruct-gpt,
        ngm:reward-hacking ;
    vc:requires ngm:human-feedback,
        ngm:preference-learning,
        ngm:proximal-policy-optimisation,
        ngm:reward-model,
        ngm:supervised-fine-tuning ;
    vc:slug "reinforcement-learning-from-human-feedback" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:constitutional-ai-training-methodology,
        ngm:harmlessness-alignment,
        ngm:scalable-oversight ;
    vc:uses ngm:bradley-terry-model,
        ngm:kl-divergence-penalty,
        ngm:pairwise-comparison,
        ngm:policy-gradient-methods .

ngm:camera-calibration a owl:Class ;
    rdfs:label "Camera Calibration"@en ;
    rdfs:comment "Camera calibration is the process of estimating a camera's intrinsic parameters — focal length, principal point, pixel skew, and radial and tangential distortion coefficients — and, when multiple sensors are involved, extrinsic parameters describing the rigid-body transformation (rotation and translation) between coordinate frames. Accurate calibration is a prerequisite for metrically correct 3D reconstruction, stereo depth estimation, augmented-reality overlay registration, and robot visual servoing. The Zhang method, which solves for camera parameters from multiple images of a planar chessboard target via non-linear reprojection-error minimisation, is the dominant practical technique and is standardised in OpenCV and MATLAB's Computer Vision Toolbox. Calibration quality must be maintained over a device's operational lifetime, driving development of online self-calibration methods that exploit ego-motion and scene structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:lidar,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:calibration ;
    vc:dependsOn ngm:corner-detection,
        ngm:feature-detection ;
    vc:enables ngm:3-d-reconstruction,
        ngm:augmented-reality,
        ngm:depth-estimation,
        ngm:photogrammetry,
        ngm:pose-estimation,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:epipolar-geometry,
        ngm:projective-geometry ;
    vc:requires ngm:camera,
        ngm:image-processing,
        ngm:optimisation ;
    vc:slug "camera-calibration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:sensor-fusion,
        ngm:slam,
        ngm:stereo-vision,
        ngm:structure-from-motion ;
    vc:uses ngm:homography .

ngm:optimisation a owl:Class ;
    rdfs:label "Optimisation"@en ;
    rdfs:comment "Optimisation is the mathematical and computational discipline concerned with finding the best solution — maximum or minimum — of an objective function subject to given constraints, across a search space of possible decisions or parameter configurations. It encompasses deterministic methods (linear programming, convex optimisation, gradient-based search), stochastic methods (simulated annealing, evolutionary algorithms, Monte Carlo sampling), and learned methods (differentiable optimisation, meta-learning, neural combinatorial solvers). Optimisation is the theoretical core of machine learning training, operations research, control engineering, signal processing, and resource scheduling. The choice of optimisation algorithm fundamentally determines convergence speed, solution quality, and computational cost across all application domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective-function ],
        [ a owl:Restriction ;
