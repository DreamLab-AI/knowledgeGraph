ngm:snapshot a owl:Class ;
    rdfs:comment "Snapshot is an off-chain governance platform that lets token holders and decentralised autonomous organisations vote on proposals without paying on-chain transaction fees. Votes are signed cryptographically with a wallet and weighted according to token holdings recorded at a chosen block height, then aggregated and stored on the InterPlanetary File System. Because voting is gasless and non-binding at the protocol level, results are typically executed separately by multisignature wallets or on-chain modules."@en ;
    rdfs:label "Snapshot"@en ;
    rdfs:subClassOf ngm:de-fi ;
    rdfs:subClassOf ngm:decentralised-finance-domain ;
