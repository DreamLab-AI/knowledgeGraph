ngm:soft-robotics a owl:Class ;
    rdfs:label "Soft Robotics"@en ;
    rdfs:comment "Robotics discipline employing compliant, flexible materials enabling safe human interaction and adaptation to unstructured environments, with applications across surgical robotics, food handling automation, wearable assistive devices, and collaborative manufacturing—advancing through bio-inspired..."@en ;
