    vc:slug "synthetic-data-generator" ;
    vc:sourceDomain "spatial-computing" .

ngm:system a owl:Class ;
    rdfs:label "System"@en ;
    rdfs:comment "A bounded, purposeful arrangement of components—hardware, software, data, and processes—that interact to perform functions beyond those of any individual component. In AI contexts, a system integrates models, inference engines, data pipelines, and interfaces into deployable solutions that operate within broader sociotechnical environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
