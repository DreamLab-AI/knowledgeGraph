ngm:sybil-attack a owl:Class ;
    rdfs:label "Sybil Attack"@en ;
    rdfs:comment "A Sybil Attack is a network security threat in which a single adversary creates a large number of pseudonymous identities to gain disproportionate influence over a peer-to-peer system. In blockchain and distributed ledger contexts it can subvert reputation systems, distort consensus voting, facilitate eclipse attacks, and undermine proof-of-stake weighting. Countermeasures include proof-of-work, stake-weighted voting, identity verification, and peer diversity requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:federated-learning-poisoning,
        ngm:social-network-manipulation ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-identity,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:identity-management,
        ngm:network-topology ;
    vc:enables ngm:denial-of-service,
        ngm:double-spending,
        ngm:eclipse-attack,
        ngm:routing-attack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:consensus-mechanism,
        ngm:decentralized-identity,
        ngm:selfish-mining,
        ngm:witch-attack ;
    vc:requires ngm:peer-to-peer-network,
        ngm:pseudonymous-identity ;
    vc:slug "sybil-attack" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:fake-node,
        ngm:reputation-system .

ngm:system-identification a owl:Class ;
    rdfs:label "System Identification"@en ;
    rdfs:comment "System identification is the discipline of constructing or refining a mathematical model of a dynamical system—parametric or non-parametric—from observed input-output experimental data, enabling accurate simulation and model-based control design. It spans classical methods such as prediction error minimisation, subspace identification, and autoregressive modelling for linear time-invariant systems, through to Gaussian process regression, neural ordinary differential equations, and physics-informed learning for nonlinear and hybrid systems. In robotics and mechatronics, system identification calibrates rigid-body dynamics parameters—link inertia tensors, joint friction coefficients, and actuator gains—required by whole-body controllers and model predictive controllers to generate physically consistent torque commands. The field occupies an intersection of statistical estimation theory, control engineering, and machine learning, and is foundational to closing the sim-to-real gap in data-driven robot learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:physics-informed-neural-network,
        ngm:sim-to-real-transfer ;
    vc:contrastsWith ngm:domain-randomisation,
        ngm:model-free-control ;
    vc:dependsOn ngm:experimental-design,
        ngm:physics-simulation,
        ngm:signal-processing ;
    vc:enables ngm:adaptive-control,
        ngm:digital-twin,
        ngm:model-predictive-control,
        ngm:whole-body-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:observer-design,
        ngm:parameter-estimation,
        ngm:reinforcement-learning,
        ngm:structural-dynamics ;
    vc:requires ngm:excitation-trajectory,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:slug "system-identification" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:gaussian-process-regression,
        ngm:kalman-filter,
        ngm:least-squares-regression,
        ngm:maximum-likelihood-estimation,
        ngm:neural-ode .

ngm:system-prompt a owl:Class ;
    rdfs:label "System Prompt"@en ;
    rdfs:comment "A system prompt is a structured instruction block injected into the context window of a large language model at the start of an inference session, establishing operational context, persona, tool descriptions, safety constraints, and behavioural guidelines before any user turn is processed. Unlike user messages, system prompts are authored by operators rather than end users and govern the model's allowed behaviours, response style, and tool-use policy throughout the session. In agentic and multi-agent architectures, system prompts serve as the primary mechanism for role specialisation, capability scoping, safety guardrail enforcement, and task decomposition. The security boundary between the system prompt and user-controlled input is a central concern in prompt injection defence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:access-control,
        ngm:software-architecture ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:retrieval-augmented-generation,
        ngm:user-message ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:tokenisation ;
    vc:enables ngm:agentic-ai,
        ngm:function-calling,
        ngm:reasoning,
        ngm:role-specialisation,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:chain-of-thought,
        ngm:constitutional-ai,
        ngm:model-context-protocol,
        ngm:prompt-injection,
        ngm:self-consistency ;
    vc:requires ngm:context-window,
        ngm:inference,
        ngm:large-language-models ;
    vc:slug "system-prompt" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:few-shot-learning,
        ngm:instruction-tuning,
        ngm:natural-language-processing .

ngm:systemic-risk a owl:Class ;
    rdfs:label "Systemic Risk"@en ;
    rdfs:comment "Risk specific to high-impact capabilities of general-purpose AI models with significant impact on the Union market due to reach, or actual or foreseeable negative effects on public health, safety, fundamental rights, environment, democracy, or rule of law. Under EU AI Act Article 51, models exceeding 10^25 FLOPs training compute or matching the most advanced GPAI capabilities are presumed to carry systemic risk and face enhanced obligations including adversarial testing, incident reporting, and cybersecurity protection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
