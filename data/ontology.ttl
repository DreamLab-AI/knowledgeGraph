ngm:ens a owl:Class ;
    rdfs:label "ENS"@en ;
    rdfs:comment "The Ethereum Name Service (ENS) is a decentralised, on-chain naming system built on Ethereum that maps human-readable names ending in .eth to Ethereum addresses, content hashes, multi-coin addresses, and arbitrary text records via ERC-137 compliant smart contracts and pluggable resolver contracts. It functions as the Web3 analogue of DNS, replacing opaque hexadecimal addresses with memorable, self-sovereign labels backed by ERC-721 NFTs and governed by the ENS DAO. Off-chain resolution via CCIP-Read (EIP-3668) extends the system to conventional databases with on-chain verification, reducing gas overhead for high-frequency updates whilst preserving trustless resolution semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        ngm:decentralised-identity ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:dns,
        ngm:unstoppable-domains ;
    vc:enables ngm:decentralised-application,
        ngm:decentralised-web,
        ngm:self-sovereign-identity,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-3668,
        ngm:erc-137 ;
    vc:isPartOf ngm:ethereum ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:governance-token,
        ngm:wallet-address ;
    vc:requires ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:on-chain-governance ;
    vc:slug "ens" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-721,
        ngm:ethereum,
        ngm:ipfs,
        ngm:nft,
        ngm:smart-contract .

