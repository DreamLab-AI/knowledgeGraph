    rdfs:label "Established"@en .

vc:hasPart a owl:ObjectProperty ;
    rdfs:label "hasPart"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

vc:requires a owl:ObjectProperty,
        owl:TransitiveProperty ;
