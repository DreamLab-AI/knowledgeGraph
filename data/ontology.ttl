    rdfs:label "Presence Awareness"@en .

ngm:presence-detection a owl:Class ;
    rdfs:label "Presence Detection"@en ;
    rdfs:comment "Presence Detection is the real-time determination of whether a user, avatar, or entity is active and spatially located within a digital environment. It combines sensor fusion, computer vision, and network signalling to maintain accurate availability states, enabling responsive social interactions, attention-aware interfaces, and adaptive content delivery in spatial computing systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:spatial-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:context-aware-computing,
        ngm:presence ;
    vc:slug "presence-detection" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:sensor-fusion .

ngm:privacy-mechanism a owl:Class ;
    rdfs:label "Privacy Mechanism"@en ;
    rdfs:comment "A Privacy Mechanism is a technical method or protocol designed to preserve individuals' data privacy during data collection, processing, or publication. Examples include differential privacy, federated learning, and homomorphic encryption, each providing mathematically grounded guarantees against disclosure of sensitive information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:gdpr-compliance ;
    vc:requires ngm:privacy-by-design ;
    vc:slug "privacy-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:privacy .

ngm:privacy-preserving-protocol a owl:Class ;
    rdfs:label "Privacy-Preserving Protocol"@en ;
    rdfs:comment "A privacy-preserving protocol is a cryptographic protocol designed to let parties achieve a useful outcome while revealing as little personal or sensitive data as possible. Such protocols use techniques like zero-knowledge proofs, commitments, blind signatures, secure multiparty computation and differential privacy to prove claims, transact or compute jointly without disclosing the underlying inputs. They are central to confidential payments, anonymous credentials, private identity and any system that must reconcile verifiability with data minimisation."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:contrastsWith ngm:kyc ;
    vc:enables ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:cryptography,
        ngm:privacy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:homomorphic-encryption,
        ngm:tor,
        ngm:zero-knowledge-proof-zkp ;
    vc:slug "privacy-preserving-protocol" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:differential-privacy,
        ngm:revocation-registry ;
    vc:uses ngm:pedersen-commitment,
        ngm:schnorr-signatures,
        ngm:zero-knowledge-proof .

ngm:private-blockchain a owl:Class ;
    rdfs:label "Private Blockchain"@en ;
    rdfs:comment "A private blockchain is a permissioned distributed ledger in which access, participation, and validation rights are restricted to a pre-approved set of known entities, typically operated by a single organisation or a closed consortium. Unlike public blockchains, private blockchains prioritise throughput, deterministic finality, and data confidentiality over open participation, relying on governance frameworks and identity management rather than anonymous proof-of-work mining to secure the network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-governance ],
        [ a owl:Restriction ;
