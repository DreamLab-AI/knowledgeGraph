    vc:sourceDomain "security" .

ngm:toxic-content-counter-narrative-system a owl:Class ;
    rdfs:label "Toxic Content Counter-Narrative System"@en ;
    rdfs:comment "Project BroBots is a multi-agent research initiative to identify, classify, and counter toxic online content using NLP-based harm detection and counter-narrative generation. It employs fine-tuned large language models on social media corpora, the Agentic Alliance tech stack, and is motivated by the harms of automated bot-driven misinformation and harassment across internet platforms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
