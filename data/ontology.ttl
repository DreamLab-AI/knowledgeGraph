    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:checkpoints,
        ngm:revocation-mechanism,
        ngm:vote-delegation ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:aragon,
