    rdfs:comment "Umbrella term encompassing all immersive technologies including Augmented Reality (AR), Virtual Reality (VR), and Mixed Reality (MR), representing the full spectrum from entirely physical to entirely virtual environments and all hybrid states between."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality-ar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality-mr ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality-vr ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reality-virtuality-continuum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-tracking ],
        ngm:immersive-technology,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-reality-transitions,
        ngm:immersive-experiences,
        ngm:presence,
        ngm:spatial-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:augmented-reality-ar,
        ngm:mixed-reality-mr,
        ngm:reality-virtuality-continuum,
        ngm:virtual-reality-vr ;
    vc:isPartOf ngm:immersive-technology,
        ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:head-mounted-display,
        ngm:input-device,
        ngm:real-time-rendering,
        ngm:spatial-tracking ;
    vc:slug "extended-reality-xr" ;
    vc:sourceDomain "spatial-computing" .

ngm:formal-verification a owl:Class ;
    rdfs:label "Formal Verification"@en ;
    rdfs:comment "Formal verification is the application of mathematical proof techniques to rigorously establish that a system or algorithm satisfies its specified correctness properties under all possible inputs."@en ;
