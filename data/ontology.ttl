ngm:penetration-testing a owl:Class ;
    rdfs:label "Penetration Testing"@en ;
    rdfs:comment "Penetration testing is an authorised, structured simulation of real-world adversarial attacks against computing systems, networks, or applications, conducted to identify exploitable vulnerabilities before malicious actors can leverage them. Skilled practitioners — called penetration testers or ethical hackers — follow an agreed scope and rules of engagement, systematically applying the same techniques, tools, and thought processes used by genuine threat actors. Findings are documented with severity ratings, proof-of-concept evidence, and remediation guidance, directly informing an organisation's risk management and security improvement programme. The discipline bridges theoretical vulnerability knowledge with practical risk quantification, distinguishing it from automated scanning or passive audit activities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulnerability-scanning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:ai-security,
        ngm:software-testing ;
    vc:contrastsWith ngm:security-audit,
        ngm:vulnerability-scanning ;
    vc:enables ngm:information-security,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:vulnerability-scanning ;
    vc:isPartOf ngm:red-teaming,
        ngm:security-assessment ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:incident-response,
        ngm:threat-intelligence,
        ngm:zero-day-exploits ;
    vc:requires ngm:threat-modelling,
        ngm:vulnerability-management ;
    vc:slug "penetration-testing" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:owasp ;
    vc:uses ngm:network-analysis,
        ngm:social-engineering .

ngm:performance-metrics a owl:Class ;
    rdfs:label "Performance Metrics"@en ;
    rdfs:comment "Performance Metrics are quantitative and qualitative measurements used to assess the efficiency, correctness, and resource utilisation of AI models, software systems, distributed platforms, and hardware pipelines. They encompass latency, throughput, accuracy, recall, precision, error rate, memory footprint, and energy consumption, forming the empirical basis for benchmarking, capacity planning, and continuous improvement. In machine learning contexts, performance metrics bridge offline evaluation (held-out test sets) and online monitoring (production dashboards), enabling data-driven decisions about model retraining, architecture changes, and deployment rollback. Standardised metric suites underpin regulatory compliance, SLA enforcement, and comparative research across the field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accuracy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:throughput ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:precision-recall-curve ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ground-truth-labels ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmarking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:f1-score ],
        ngm:model-evaluation ;
    vc:bridgesTo ngm:energy-efficiency,
        ngm:regulatory-compliance,
        ngm:service-level-agreement ;
    vc:contrastsWith ngm:model-evaluation-results ;
    vc:dependsOn ngm:audit-logging,
        ngm:observability ;
    vc:enables ngm:capacity-planning,
        ngm:continuous-integration,
        ngm:model-optimisation-and-performance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:accuracy,
        ngm:f1-score,
        ngm:latency,
        ngm:mean-average-precision,
        ngm:precision-recall-curve,
        ngm:throughput ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:auc,
        ngm:confusion-matrix,
        ngm:roc-curve ;
    vc:requires ngm:benchmarking,
        ngm:data-collection,
        ngm:ground-truth-labels ;
    vc:slug "performance-metrics" ;
    vc:sourceDomain "machine-learning" ;
