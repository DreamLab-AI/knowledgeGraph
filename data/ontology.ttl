    vc:enables ngm:visual-realism ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "light-parameters" ;
    vc:sourceDomain "spatial-computing" .

ngm:lightning-labs a owl:Class ;
    rdfs:label "Lightning Labs"@en ;
    rdfs:comment "Lightning Labs is a company that develops software and infrastructure for the Lightning Network, a payment channel protocol built on Bitcoin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
