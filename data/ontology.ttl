ngm:quadruped-robot a owl:Class ;
    rdfs:label "Quadruped Robot"@en ;
    rdfs:comment "A robotic platform that locomotes on four legs using gaits inspired by mammals such as dogs and cats. Quadruped robots employ reinforcement learning, model-predictive control, and whole-body dynamics to achieve robust locomotion over rough terrain, enabling deployment in inspection, search-and-rescue, and logistics applications."@en ;
    rdfs:subClassOf ngm:legged-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:whole-body-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:humanoid-robot,
        ngm:mobile-robot,
        ngm:robotic-system ;
    vc:slug "quadruped-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning,
        ngm:robot-control,
        ngm:robot-kinematics,
        ngm:sensor-fusion .

