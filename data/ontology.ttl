ngm:autoregressive-model a owl:Class ;
    rdfs:label "Autoregressive Model"@en ;
    rdfs:comment "An autoregressive model generates sequences by predicting each element conditioned on all previously generated elements, thereby factorising the joint probability distribution of a sequence into an ordered product of conditional distributions via the chain rule of probability. This approach yields exact log-likelihoods and a straightforward maximum-likelihood training objective, making it the dominant paradigm for large language models, neural audio synthesis, and image generation. Inference is inherently sequential — each token must be sampled before the next can be computed — creating a fundamental latency trade-off relative to parallel decoding strategies. Modern architectures such as the Transformer exploit masked self-attention to parallelise training while preserving the strictly left-to-right conditional structure at inference time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-layer ],
        ngm:generative-model ;
    vc:bridgesTo ngm:multimodal-ai-architecture-ai,
        ngm:protein-structure-prediction,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:flow-based-model,
        ngm:generative-adversarial-network,
        ngm:masked-language-model,
        ngm:variational-autoencoder ;
    vc:dependsOn ngm:gpu-computing,
        ngm:training-data ;
    vc:enables ngm:code-generation,
        ngm:image-generation,
        ngm:language-model,
        ngm:large-language-model,
        ngm:neural-audio-synthesis,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder-stack,
        ngm:embedding-layer,
        ngm:language-model-head ;
    vc:implements ngm:maximum-likelihood-estimation,
        ngm:next-token-prediction,
        ngm:teacher-forcing ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:beam-search,
        ngm:hallucination,
        ngm:next-token-prediction,
        ngm:recurrent-neural-network,
        ngm:scaling-laws,
        ngm:speculative-decoding,
        ngm:time-series-forecasting ;
    vc:requires ngm:chain-rule-of-probability,
        ngm:probabilistic-model,
        ngm:tokenization ;
    vc:slug "autoregressive-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:chain-of-thought-reasoning,
        ngm:in-context-learning,
        ngm:prompt-engineering ;
    vc:uses ngm:byte-pair-encoding,
