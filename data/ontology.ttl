# Blockchain As A Service
blockchain:BlockchainAsAService rdf:type owl:Class ;
    rdfs:label "Blockchain As A Service"@en ;
    rdfs:comment "Cloud-based platform providing organisations with blockchain infrastructure, smart contract deployment, and ledger management without requiring internal blockchain expertise. This Service Model abstracts blockchain complexity and enables Decentralised Applications through API Interfaces and pre-built templates."@en ;
    skos:prefLabel "Blockchain As A Service"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:blockchain-as-a-service" ;
