        ngm:nakamoto-consensus,
        ngm:probabilistic-finality ;
    vc:slug "mining" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:proof-of-work .

ngm:ray-tracing a owl:Class ;
    rdfs:label "Ray Tracing"@en ;
    rdfs:comment "Ray Tracing is a physically-based light-transport simulation technique in computer graphics that generates images by casting rays from a virtual camera through each image-plane pixel into a three-dimensional scene, recursively computing colour values by evaluating ray-geometry intersections, surf..."@en ;
