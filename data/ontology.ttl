        ngm:hardware-acceleration,
        ngm:parallel-processing ;
    vc:requires ngm:ai-hardware,
        ngm:inference-hardware ;
    vc:slug "neuromorphic-computing" ;
    vc:sourceDomain "spatial-computing" .

ngm:onion-routing a owl:Class ;
    rdfs:label "Onion Routing"@en ;
    rdfs:comment "Onion routing is an anonymous-communication technique in which messages are wrapped in successive layers of encryption and relayed through a sequence of intermediary nodes, each of which removes one layer to learn only the next hop. Because no single relay knows both the source and destination, onion routing conceals the network path and protects communication metadata. It is the basis of the Tor network and is adapted in systems such as the Lightning Network for private multi-hop payment forwarding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:payment-channel-network,
        ngm:source-routing ;
    vc:contrastsWith ngm:proxy-server,
        ngm:vpn ;
    vc:dependsOn ngm:distributed-trust,
        ngm:network-routing ;
    vc:enables ngm:anonymous-communication,
        ngm:censorship-resistance,
        ngm:hidden-services,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:circuit,
        ngm:exit-node,
        ngm:relay-node ;
    vc:implements ngm:lightning-network,
        ngm:tor-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:mix-network,
        ngm:traffic-correlation-attack ;
    vc:requires ngm:key-exchange,
        ngm:public-key-infrastructure ;
    vc:slug "onion-routing" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:metadata-privacy,
        ngm:traffic-analysis-resistance ;
    vc:uses ngm:diffie-hellman-key-exchange,
        ngm:encryption,
        ngm:knowledge-graph-publication-classifier-key-cryptography,
        ngm:symmetric-encryption .

ngm:open-id-connect a owl:Class ;
    rdfs:label "OpenID Connect"@en ;
    rdfs:comment "OpenID Connect (OIDC) is a federated identity and authentication protocol standardised by the OpenID Foundation that adds an authentication layer on top of the OAuth 2.0 authorisation framework. Upon successful authentication, an OIDC-compliant identity provider issues a signed JSON Web Token (ID Token) containing identity claims — such as subject identifier, email, and session expiry — which the relying party verifies cryptographically using the provider's published JSON Web Key Set without querying the provider again. OIDC defines standard flows (authorisation code, implicit, hybrid, and device code), a discovery endpoint, and a UserInfo endpoint, enabling single sign-on across web and mobile applications and serving as the identity spine for enterprise federation, consumer social logins, open banking APIs, and decentralised identity wallets."@en ;
    rdfs:subClassOf ngm:identity-federation ;
    vc:bridgesTo ngm:eu-digital-identity-wallet,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:kerberos,
        ngm:ldap,
        ngm:saml ;
    vc:dependsOn ngm:json-web-key-set,
        ngm:json-web-token,
        ngm:oauth-2-0,
        ngm:transport-layer-security ;
    vc:enables ngm:api-security,
        ngm:decentralised-identity,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:identity-provider,
        ngm:relying-party ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:digital-identity,
        ngm:financial-grade-api,
        ngm:public-key-infrastructure ;
    vc:slug "open-id-connect" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:open-id-foundation ;
    vc:supports ngm:authentication,
        ngm:federated-identity,
        ngm:multi-factor-authentication,
        ngm:single-sign-on .

ngm:open-xr a owl:Class ;
    rdfs:label "OpenXR"@en ;
    rdfs:comment "OpenXR is the Khronos Group's open, royalty-free API standard for cross-platform access to extended reality (XR) hardware — encompassing virtual reality (VR) headsets, augmented reality (AR) glasses, and mixed reality (MR) devices — that defines a unified application-to-runtime interface, elimina..."@en ;
