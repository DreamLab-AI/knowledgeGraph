ngm:runbook a owl:Class ;
    rdfs:label "Runbook"@en ;
    rdfs:comment "A runbook is a documented set of procedures for operating, maintaining and recovering a system, giving operators a repeatable sequence of steps for routine tasks and known failure scenarios. Modern runbooks range from human-readable checklists to executable automations that orchestrate remediation directly. They are a core artefact of site reliability engineering, reducing reliance on individual expertise during incidents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:documentation ;
    vc:enables ngm:disaster-recovery,
        ngm:incident-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:devops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:documentation,
        ngm:incident-management ;
    vc:requires ngm:monitoring,
        ngm:observability ;
    vc:slug "runbook" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:on-call,
        ngm:reliability-engineering,
        ngm:site-reliability-engineering ;
    vc:uses ngm:automation,
        ngm:infrastructure-as-code .

ngm:s3-api a owl:Class ;
    rdfs:label "S3 Api"@en ;
    rdfs:comment "The S3 API is a RESTful, HTTP-based application programming interface for object storage that exposes buckets and objects through operations such as PUT, GET, DELETE and LIST. Originating with Amazon Simple Storage Service, it has become a de facto standard implemented by many cloud and on-premises storage systems, enabling portable, vendor-neutral object access. Clients authenticate with signed requests and address resources by bucket and key, allowing scalable, durable storage of unstructured data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:object-storage ;
    vc:bridgesTo ngm:data-pipeline ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:data-storage,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:object-storage,
        ngm:rest-api ;
    vc:isPartOf ngm:cloud-storage ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:data-ingestion ;
    vc:requires ngm:access-control ;
    vc:slug "s3-api" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api ;
    vc:supports ngm:storage-infrastructure ;
    vc:uses ngm:api-gateway,
        ngm:authentication .

ngm:sa8000 a owl:Class ;
    rdfs:label "SA8000"@en ;
    rdfs:comment "SA8000 is a voluntary, auditable social-accountability standard developed by Social Accountability International that certifies organisations against decent-work criteria. It covers child and forced labour, health and safety, freedom of association, discrimination, working hours, and management systems, drawing on ILO conventions and human-rights instruments. Certification is used to demonstrate ethical labour practices across supply chains."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing ;
    vc:slug "sa8000" ;
    vc:sourceDomain "supply-chain" .

ngm:safetensors-format a owl:Class ;
    rdfs:label "Safetensors Format"@en ;
    rdfs:comment "Safetensors is a file format for storing tensors — the weight matrices of machine-learning models — designed to be safe, fast, and simple. Unlike Python pickle-based formats, safetensors stores only raw tensor data and a JSON header describing shapes, dtypes, and offsets, so loading a file cannot execute arbitrary code. The layout supports zero-copy and memory-mapped loading, enabling rapid model initialisation and lazy access to individual tensors. Developed by Hugging Face, it has become a de facto standard for distributing open model weights."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:data-serialization,
        ngm:safetensors ;
    vc:slug "safetensors-format" ;
    vc:sourceDomain "ai" .

ngm:safety-assurance a owl:Class ;
    rdfs:label "Safety Assurance"@en ;
    rdfs:comment "Safety assurance is the systematic process of building and demonstrating justified confidence that a system will operate safely throughout its lifecycle. It draws on hazard analysis, structured safety cases, verification evidence, and continuous monitoring to argue that residual risk is acceptable. For autonomous and industrial systems it provides the evidentiary basis for deployment and regulatory acceptance."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:predictive-maintenance,
        ngm:robo-navigation-and-planning ;
    vc:slug "safety-assurance" ;
    vc:sourceDomain "robotics" .

ngm:saml-2-0 a owl:Class ;
    rdfs:label "SAML 2.0"@en ;
    rdfs:comment "Security Assertion Markup Language 2.0 (SAML 2.0) is an OASIS open standard ratified in 2005 that defines an XML-based framework for exchanging authentication and authorisation data between an Identity Provider and a Service Provider. It enables web-based federated single sign-on by allowing an IdP to issue digitally signed XML assertions attesting a user's identity and attributes, which the SP accepts without requiring the user to re-authenticate. SAML 2.0 consolidates and supersedes SAML 1.0 and 1.1, Liberty Alliance ID-FF 1.2, and Shibboleth 1.3, incorporating bindings for HTTP Redirect, POST, Artifact, and SOAP transports. The standard is governed by OASIS and remains the dominant federation protocol in enterprise, higher-education, and government identity ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:federated-identity ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:oauth-2-0,
        ngm:open-id-connect ;
    vc:enables ngm:cross-domain-authentication,
        ngm:federated-identity,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:attribute-based-access-control,
        ngm:directory-service,
        ngm:identity-management,
        ngm:identity-provider,
        ngm:provider ;
    vc:requires ngm:public-key-infrastructure,
        ngm:xml-encryption ;
    vc:slug "saml-2-0" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:oasis ;
    vc:uses ngm:http,
        ngm:soap,
        ngm:tls,
        ngm:xml .

