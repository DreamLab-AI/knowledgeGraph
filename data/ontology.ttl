ngm:scientific-computing a owl:Class ;
    rdfs:label "Scientific Computing"@en ;
    rdfs:comment "Scientific computing is the discipline concerned with the development and application of computational methods and software to solve mathematical and scientific problems that are analytically intractable or whose scale demands automation. It encompasses numerical analysis, algorithm design, software engineering for high-performance systems, and the management of large-scale simulation workflows. Key application domains include climate modelling, computational fluid dynamics, molecular dynamics, finite element analysis, and astronomical simulation. Scientific computing increasingly overlaps with machine learning as data-driven models augment or replace first-principles simulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:high-performance-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning,
        ngm:physics-informed-neural-networks ;
    vc:dependsOn ngm:high-performance-computing,
        ngm:simulation ;
    vc:enables ngm:climate-modelling,
        ngm:finite-element-analysis,
        ngm:fluid-simulation,
        ngm:molecular-dynamics,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:linear-algebra,
        ngm:numerical-analysis,
        ngm:parallel-programming ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computational-science,
        ngm:data-science ;
    vc:requires ngm:computational-resources,
        ngm:distributed-computing,
        ngm:numerical-libraries ;
    vc:slug "scientific-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cuda,
        ngm:gpu-computing,
        ngm:mpi,
        ngm:openmp,
        ngm:simulation-engine .

ngm:skeletal-animation a owl:Class ;
    rdfs:label "Skeletal Animation"@en ;
    rdfs:comment "Skeletal animation is a character animation technique in which a hierarchical rig of joints defines the articulated structure of a character or creature, and mesh vertices are deformed by the weighted influence of surrounding joints through a process known as skinning. Artists author motion by keyframing or procedurally driving joint transforms over time; the underlying mesh deforms accordingly in real time on the GPU via linear blend skinning or dual-quaternion skinning. The approach is the dominant method for animating characters in games, virtual reality, film visual effects, and virtual avatar systems due to its runtime efficiency, compact data representation, and amenability to motion capture retargeting and machine-learning-driven synthesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:character-rigging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:character-animation ;
    vc:bridgesTo ngm:biomechanical-simulation,
        ngm:digital-twin,
        ngm:neural-motion-synthesis ;
    vc:enables ngm:avatar-animation,
        ngm:facial-animation,
        ngm:pose-estimation,
        ngm:real-time-character-animation,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:animation-state-machine,
        ngm:blend-tree,
        ngm:character-rigging,
        ngm:linear-blend-skinning ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:animation-controller,
        ngm:gl-tf-3-d-file-format,
        ngm:level-of-detail,
        ngm:morph-target-animation,
        ngm:physics-based-animation,
        ngm:procedural-animation ;
    vc:requires ngm:gpu-compute,
        ngm:scene-graph ;
    vc:slug "skeletal-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-specification ;
    vc:uses ngm:animation-retargeting,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-capture,
        ngm:vertex-shader .

ngm:smart-grid a owl:Class ;
    rdfs:label "Smart Grid"@en ;
    rdfs:comment "A smart grid is a modernised electricity distribution and transmission network that integrates digital communication, real-time sensing, automated control, and distributed intelligence to improve efficiency, reliability, resilience, and sustainability relative to the traditional centralised grid. It enables bidirectional power and information flows, accommodating distributed generation from renewable sources, battery energy storage systems, demand-side flexibility, and vehicle-to-grid interactions. Advanced metering infrastructure, distribution automation, phasor measurement units, and AI-driven optimisation allow operators to balance supply and demand dynamically across thousands of grid-edge resources. Smart grids are a foundational component of low-carbon energy infrastructure and are governed by a set of interoperability standards spanning communications, cybersecurity, and market protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
