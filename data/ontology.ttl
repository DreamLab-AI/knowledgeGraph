        ngm:instruction-tuning ;
    vc:requires ngm:human-feedback,
        ngm:labelled-dataset,
        ngm:model-training,
        ngm:pre-trained-model ;
    vc:slug "supervised-fine-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:lora,
        ngm:parameter-efficient-fine-tuning .

ngm:symmetric-encryption a owl:Class ;
    rdfs:label "Symmetric Encryption"@en ;
    rdfs:comment "A cryptographic method using a single shared secret key for both encryption and decryption, requiring secure key exchange between parties before communication. Provides high-throughput confidentiality for data at rest and in transit, making it the standard approach for bulk data encryption across security, infrastructure, and distributed-systems domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
