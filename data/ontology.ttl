    vc:slug "telecommunications-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3gpp,
        ngm:ietf,
        ngm:itu-r ;
    vc:supports ngm:cloud-computing,
        ngm:content-delivery-network,
        ngm:distributed-systems,
        ngm:latency-management-protocol .

ngm:text-to-image-generation a owl:Class ;
    rdfs:label "Text-to-Image Generation"@en ;
    rdfs:comment "Text-to-image generation is a class of generative AI techniques that synthesise photorealistic or stylised images from natural-language textual descriptions, typically employing diffusion models, autoregressive transformers, or hybrid architectures trained on large paired datasets of images and captions. The synthesis process encodes a text prompt into a conditioning latent representation, then iteratively denoises random noise into structured visual output guided by that signal through cross-attention mechanisms. Leading systems such as DALL-E 3, Stable Diffusion XL, Midjourney, Imagen, and Flux exemplify the paradigm across proprietary and open-weight deployment modes. The field intersects creative tooling, computer vision, multimodal AI, and contested questions of copyright, consent, and synthetic media provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:image-generation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:c2pa,
        ngm:intellectual-property,
        ngm:synthetic-media ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:image-recognition ;
    vc:enables ngm:image-editing,
        ngm:multimodal-ai,
        ngm:prompt-engineering,
        ngm:synthetic-data-generation,
        ngm:text-to-video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:denoising-network,
        ngm:image-decoder,
        ngm:text-encoder ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:dreambooth,
        ngm:fine-tuning,
        ngm:generative-ai,
        ngm:lora,
        ngm:stable-diffusion ;
    vc:requires ngm:gpu-compute,
        ngm:image-caption-dataset,
        ngm:large-scale-pretraining ;
    vc:slug "text-to-image-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:clip,
        ngm:contrastive-learning,
        ngm:cross-attention,
        ngm:diffusion-model,
        ngm:latent-diffusion,
        ngm:transformer-architecture,
        ngm:variational-autoencoder .

ngm:threat-detection a owl:Class ;
    rdfs:label "Threat Detection"@en ;
    rdfs:comment "Threat detection is the cybersecurity discipline concerned with identifying malicious or anomalous activity within a system or network in time to enable an effective defensive response, distinguishing genuine threats from benign anomalies across high-volume, noisy telemetry. It encompasses signature-based detection of known attack patterns, behavioural analytics for novel threats, and machine learning models that model normal system baselines and flag statistical deviations. Effective threat detection must balance sensitivity (catching real attacks) against specificity (avoiding alert fatigue from false positives)."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:bridgesTo ngm:adversarial-machine-learning,
        ngm:supply-chain-security ;
    vc:contrastsWith ngm:vulnerability-scanning ;
    vc:enables ngm:incident-response,
        ngm:security-operations-center,
        ngm:threat-hunting,
        ngm:threat-surface-map ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:attack-vector,
        ngm:intrusion-detection-system,
        ngm:security-information-and-event-management,
        ngm:threat-actor,
        ngm:threat-intelligence,
        ngm:threat-model ;
    vc:requires ngm:log-management,
        ngm:telemetry ;
    vc:slug "threat-detection" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:information-security,
        ngm:network-security,
        ngm:vulnerability-management,
        ngm:zero-trust-security ;
    vc:uses ngm:ai-security,
        ngm:behavioural-analytics,
        ngm:endpoint-detection-and-response,
        ngm:machine-learning .

ngm:time-series-analysis a owl:Class ;
    rdfs:label "Time-Series Analysis"@en ;
    rdfs:comment "Time-series analysis is the statistical and computational study of data sequences indexed by time, encompassing methods for decomposition, modelling, forecasting, and anomaly detection of temporal patterns including trend, seasonality, and autocorrelation structures. Foundational techniques include ARIMA, exponential smoothing, spectral analysis, and state-space models, with deep learning approaches such as transformers and N-BEATS increasingly dominant in practice."@en ;
    rdfs:subClassOf ngm:data-analysis ;
    vc:bridgesTo ngm:signal-processing ;
    vc:enables ngm:anomaly-detection,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:markov-chain-monte-carlo,
        ngm:prediction-markets ;
    vc:slug "time-series-analysis" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bayesian-inference,
        ngm:probabilistic-model .

ngm:tracking-system a owl:Class ;
    rdfs:label "Tracking System"@en ;
    rdfs:comment "A Tracking System is a hardware and software assembly that continuously determines the position, orientation, and motion of one or more objects or agents within a defined reference frame, using sensing technologies such as optical cameras, inertial measurement units, electromagnetic emitters, ultrasound, GPS, or LiDAR. Tracking systems are foundational components of augmented and virtual reality, robotics, surgical navigation, sports analytics, logistics, and autonomous vehicles, where precise real-time knowledge of spatial state is essential for interaction, control, or safety."@en ;
    rdfs:subClassOf ngm:spatial-tracking-system ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:surgical-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation,
        ngm:spatial-mapping ;
    vc:slug "tracking-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:computer-vision,
        ngm:imu,
        ngm:lidar,
        ngm:sensor-fusion,
        ngm:slam .

ngm:tree-of-thoughts a owl:Class ;
    rdfs:label "Tree of Thoughts"@en ;
    rdfs:comment "Tree of Thoughts (ToT) is a deliberate reasoning framework for large language models that generalises linear chain-of-thought prompting into a tree-structured search over intermediate thought steps. At each node in the tree the model generates multiple candidate next-thoughts, evaluates their promise using an LLM-based heuristic, and selects branches to expand via breadth-first or depth-first search with backtracking. This enables systematic exploration of alternative reasoning paths and is particularly effective for combinatorial planning, mathematical proof construction, or multi-step problem-solving where greedy left-to-right decoding is insufficient. ToT was formalised by Yao et al. (2023) and represents the foundational instance of inference-time compute scaling through structured search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:heuristic-search,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:chain-of-thought,
        ngm:react-prompting,
        ngm:self-consistency ;
    vc:enables ngm:automated-planning,
        ngm:combinatorial-problem-solving,
        ngm:mathematical-reasoning,
        ngm:multi-step-reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:thought-evaluator,
        ngm:thought-generator,
        ngm:tree-search-algorithm ;
    vc:isPartOf ngm:deliberate-reasoning,
        ngm:inference-time-compute ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:graph-of-thoughts,
        ngm:monte-carlo-tree-search,
        ngm:process-reward-model,
        ngm:skeleton-of-thought,
        ngm:speculative-decoding ;
    vc:requires ngm:large-language-models,
        ngm:prompt-engineering ;
    vc:slug "tree-of-thoughts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backtracking,
        ngm:beam-search,
        ngm:breadth-first-search,
        ngm:depth-first-search .

ngm:trust-over-ip-foundation a owl:Class ;
    rdfs:label "Trust Over IP Foundation"@en ;
    rdfs:comment "The Trust over IP (ToIP) Foundation is a Linux Foundation project established in 2020 that defines a dual-stack architecture combining cryptographic machine trust at the technical layer with human, organisational, and legal trust governance frameworks for decentralised identity. The lower technical stack encompasses Decentralised Identifiers (DIDs), Verifiable Credentials, cryptographic key management, and peer-to-peer messaging protocols across four numbered layers, whilst the upper governance stack provides trust registries, policy schemas, legal agreements, and assurance level definitions enabling parties to establish authoritative trust relationships without a central intermediary. ToIP produces the governance meta-model and interoperability specifications needed to make self-sovereign identity deployments composable and trustworthy at ecosystem scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifiers ],
        ngm:standards-body ;
    vc:bridgesTo ngm:digital-wallet,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralised-identity-provider,
        ngm:federated-identity ;
    vc:enables ngm:credential-exchange,
        ngm:cross-border-identity,
        ngm:governance-framework,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:w3c-did-core,
        ngm:w3c-verifiable-credentials ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity-foundation,
        ngm:eidas-regulation,
        ngm:internet-identity-workshop,
        ngm:w3c-credentials-community-group ;
    vc:requires ngm:cryptographic-key-management,
        ngm:decentralised-identifiers,
        ngm:public-key-infrastructure ;
    vc:slug "trust-over-ip-foundation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:decentralised-identity,
        ngm:self-sovereign-identity,
        ngm:trust-registry,
        ngm:verifiable-credentials ;
    vc:uses ngm:did-document,
        ngm:didcomm-messaging,
        ngm:openid-for-verifiable-credentials .

ngm:two-phase-commit a owl:Class ;
    rdfs:label "Two-Phase Commit"@en ;
    rdfs:comment "Two-Phase Commit (2PC) is a distributed transaction coordination protocol that ensures atomic commitment across multiple participant nodes: either all participants commit a transaction or all abort it, with no partial updates persisted. In the prepare phase, a coordinator polls all participants for their readiness to commit; in the commit phase, it broadcasts the final decision based on unanimous consensus from the prepare phase. 2PC is the foundational protocol for distributed ACID transactions but is blocking in the presence of coordinator failure, a limitation addressed by Three-Phase Commit and Paxos-based variants."@en ;
    rdfs:subClassOf ngm:distributed-system-protocol ;
    vc:contrastsWith ngm:raft-consensus ;
    vc:enables ngm:transaction-confirmation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-protocol,
        ngm:distributed-consensus,
        ngm:transaction-finality,
        ngm:transaction-processing ;
    vc:slug "two-phase-commit" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:database-system,
        ngm:distributed-systems .

ngm:usability-testing a owl:Class ;
    rdfs:label "Usability Testing"@en ;
    rdfs:comment "Usability testing is an empirical user research method in which representative users are observed attempting to complete realistic tasks with a product, system, or prototype, while the evaluator records errors, task completion times, help-seeking behaviour, and verbal commentary to identify usability problems and inform design improvements. Unlike expert-based heuristic evaluation, usability testing generates direct evidence of how real people interact with an interface under ecologically valid conditions. It is a core practice in human-computer interaction, product design, and user experience research, conducted through moderated in-person sessions, remote think-aloud protocols, or automated unmoderated testing platforms."@en ;
    rdfs:subClassOf ngm:user-research ;
    vc:enables ngm:product-design,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:heuristic-methods,
        ngm:human-computer-interaction,
        ngm:user-experience ;
    vc:slug "usability-testing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:quality-assurance,
        ngm:software-testing .

ngm:vendor-lock-in a skos:Concept ;
    rdfs:label "Vendor Lock In"@en .

ngm:video-compression a owl:Class ;
    rdfs:label "Video Compression"@en ;
    rdfs:comment "Video compression is the process of encoding digital video data to reduce file size and bit rate for efficient storage and transmission, while maintaining perceptually acceptable quality. It exploits three principal forms of redundancy: spatial redundancy within individual frames, temporal redundancy across consecutive frames, and perceptual redundancy based on limitations of human visual perception. Modern video codecs such as H.264/AVC, H.265/HEVC, VP9, and AV1 implement intra-frame prediction, inter-frame motion compensation, discrete cosine or wavelet transforms, quantisation, and entropy coding to achieve compression ratios that make streaming, broadcast, and real-time communication practical over bandwidth-limited networks."@en ;
    rdfs:subClassOf ngm:data-compression ;
    vc:bridgesTo ngm:content-delivery-network,
        ngm:neural-video-compression ;
    vc:contrastsWith ngm:lossless-compression ;
    vc:dependsOn ngm:perceptual-coding,
        ngm:signal-processing ;
    vc:enables ngm:broadcast-television,
        ngm:content-delivery,
        ngm:real-time-communication,
        ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:entropy-coding,
        ngm:inter-frame-coding,
        ngm:intra-frame-coding,
        ngm:motion-estimation ;
    vc:implements ngm:av1,
        ngm:h264-avc ;
    vc:isPartOf ngm:multimedia-processing,
        ngm:video-codec ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adaptive-bitrate-streaming,
        ngm:latency ;
    vc:requires ngm:discrete-cosine-transform,
        ngm:rate-control ;
    vc:slug "video-compression" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:alliance-for-open-media,
        ngm:iso-iec-mpeg,
        ngm:itu-t ;
    vc:uses ngm:colour-subsampling,
        ngm:psychovisual-model .

ngm:voice-cloning a owl:Class ;
    rdfs:label "Voice Cloning"@en ;
    rdfs:comment "Voice cloning is a speech synthesis technique that uses a short reference audio recording of a target speaker to condition or fine-tune a neural text-to-speech model so that it reproduces that speaker's vocal characteristics — including timbre, prosody, accent, and speaking rhythm — when given arbitrary text input. Modern systems employ a speaker encoder network that extracts a fixed-dimensional speaker embedding from reference audio, which conditions a sequence-to-sequence acoustic model and vocoder to produce personalised synthetic speech. Zero-shot voice cloning generalises this capability to entirely unseen speakers without fine-tuning by leveraging large pre-trained generative models. The technology underpins both beneficial applications such as accessibility aids and audiobook narration, and adversarial uses including audio deepfakes and voice fraud."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:speech-synthesis ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:content-provenance,
        ngm:digital-watermarking ;
    vc:contrastsWith ngm:concatenative-synthesis,
        ngm:voice-conversion ;
    vc:enables ngm:accessibility-technology,
        ngm:audio-deepfake,
        ngm:audiobook-narration,
        ngm:personalised-voice-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biometric-authentication,
        ngm:deepfakes,
        ngm:generative-ai,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:synthetic-media ;
    vc:requires ngm:mel-spectrogram,
        ngm:speech-corpus,
        ngm:transfer-learning ;
    vc:slug "voice-cloning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:neural-network,
        ngm:speaker-embedding,
        ngm:text-to-speech,
        ngm:transformer,
        ngm:vocoder .

