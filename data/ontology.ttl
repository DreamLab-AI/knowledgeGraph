ngm:decentralized-trading a owl:Class ;
    rdfs:label "Decentralized Trading"@en ;
    rdfs:comment "Decentralized trading is the exchange of crypto-assets directly between parties through smart contracts on a blockchain, without a centralized intermediary holding custody of funds or matching orders. Trades settle peer-to-contract against liquidity pools or order books governed by deterministic on-chain logic, giving traders self-custody and permissionless access. It is the activity layer enabled by decentralized exchanges and automated market makers."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:automated-market-making,
        ngm:decentralized-exchange-dex ;
    vc:slug "decentralized-trading" ;
    vc:sourceDomain "blockchain" .

