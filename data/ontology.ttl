        ngm:data-governance ;
    vc:contrastsWith ngm:fault-tolerance,
        ngm:replication ;
    vc:dependsOn ngm:data-replication,
        ngm:storage-infrastructure ;
    vc:enables ngm:high-availability,
        ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:recovery-point-objective,
        ngm:recovery-time-objective ;
    vc:isPartOf ngm:business-continuity,
        ngm:disaster-recovery ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:air-gap,
        ngm:data-protection,
        ngm:fault-tolerance ;
    vc:requires ngm:data-integrity,
