        ngm:information-theory,
        ngm:machine-learning ;
    vc:requires ngm:discrete-mathematics,
        ngm:logic ;
    vc:slug "computer-science" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:acm,
        ngm:ieee ;
    vc:uses ngm:formal-methods,
        ngm:type-theory .

ngm:creative-ai a owl:Class ;
    rdfs:label "Creative AI"@en ;
    rdfs:comment "Creative AI refers to artificial intelligence systems designed to generate, augment, or evaluate creative artefacts — including images, music, text, video, and interactive experiences — by learning latent representations of aesthetic structure from large corpora of human-produced works. Drawing on generative architectures such as diffusion models, large language models, transformers, and generative adversarial networks, these systems can synthesise novel content that extends or stylistically mimics human creative practice. They are deployed across professional creative pipelines in entertainment, advertising, game development, and design, while simultaneously raising contested questions of authorship, copyright, and economic disruption for human creators. Creative AI represents the convergence of machine learning research with aesthetic domains historically regarded as uniquely human, positioning it as both a technical milestone and a socio-cultural inflection point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-scale-datasets ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:metaverse ;
    vc:contrastsWith ngm:discriminative-ai,
        ngm:rule-based-systems ;
    vc:enables ngm:ai-art,
        ngm:automated-design,
        ngm:content-creation,
        ngm:digital-content-creation,
        ngm:image-generation,
        ngm:music-generation,
        ngm:procedural-content-generation,
        ngm:text-to-image,
        ngm:text-to-speech,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:computational-creativity,
        ngm:copyright,
        ngm:creative-industries,
        ngm:human-ai-collaboration,
        ngm:multimodal-model,
        ngm:prompt-engineering,
        ngm:synthetic-media ;
    vc:requires ngm:deep-learning,
        ngm:gpu-compute,
        ngm:large-scale-datasets,
        ngm:training-data ;
    vc:slug "creative-ai" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:fashion,
        ngm:film-production,
        ngm:game-development ;
    vc:uses ngm:clip-model,
        ngm:diffusion-model,
        ngm:foundation-model,
        ngm:generative-adversarial-network,
        ngm:large-language-models,
        ngm:latent-space,
        ngm:style-transfer,
        ngm:transformer,
        ngm:variational-autoencoder .

ngm:data-mesh a owl:Class ;
    rdfs:label "Data Mesh"@en ;
    rdfs:comment "Data Mesh is a socio-technical paradigm for large-scale analytical data architecture, coined by Zhamak Dehghani (2020), that decentralises data ownership to domain-aligned teams who treat their analytical datasets as first-class products accessible via standardised interfaces. It rests on four principles: domain-oriented decentralised data ownership, data as a product, self-serve data infrastructure as a platform, and federated computational governance. Unlike monolithic data lakes or warehouses governed by a central data engineering team, a Data Mesh distributes accountability so that the teams who generate data also maintain its quality, documentation, and SLAs as discoverable data products. The model draws on domain-driven design and microservices thinking applied to analytical rather than operational data flows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:domain-driven-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-registry ],
        ngm:data-governance-framework ;
    vc:bridgesTo ngm:federated-learning,
        ngm:platform-engineering ;
    vc:contrastsWith ngm:data-fabric-architecture,
        ngm:data-warehouse ;
    vc:enables ngm:data-analytics,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:data-governance,
        ngm:data-lineage ;
    vc:requires ngm:domain-driven-design,
        ngm:schema-registry ;
    vc:slug "data-mesh" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-lake,
        ngm:event-driven-architecture ;
    vc:uses ngm:api-gateway,
        ngm:data-pipeline,
        ngm:microservices-architecture,
        ngm:policy-as-code .

ngm:data-protection-impact-assessment a owl:Class ;
    rdfs:label "Data Protection Impact Assessment"@en ;
    rdfs:comment "A Data Protection Impact Assessment is a structured process for identifying, evaluating and mitigating the risks that a planned data-processing activity poses to the rights and freedoms of individuals. It documents the nature, scope, context and purposes of processing, assesses necessity and proportionality, and records measures that reduce identified risks. Under the General Data Protection Regulation it is mandatory where processing is likely to result in high risk, such as large-scale profiling or use of sensitive data. It is a core accountability instrument linking privacy-by-design to demonstrable compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-processing ],
        ngm:risk-assessment ;
    vc:contrastsWith ngm:privacy-impact-assessment ;
    vc:dependsOn ngm:data-mapping,
        ngm:legal-basis ;
    vc:enables ngm:privacy,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mitigation-measures,
        ngm:risk-analysis ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:data-protection-law ;
    vc:requires ngm:data-processing,
        ngm:gdpr ;
    vc:slug "data-protection-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:compliance ;
    vc:uses ngm:data-governance .

ngm:database-query a owl:Class ;
    rdfs:label "Database Query"@en ;
    rdfs:comment "A structured request submitted to a database management system to retrieve, insert, update, or delete data according to defined criteria. Queries are expressed in formal query languages such as SQL for relational databases or SPARQL for RDF triple stores, and underpin knowledge graph retrieval, analytics pipelines, and real-time application data access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-optimiser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-schema ],
        ngm:data-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contract ;
    vc:contrastsWith ngm:batch-processing,
        ngm:stream-processing ;
    vc:dependsOn ngm:relational-database ;
    vc:enables ngm:data-analytics,
        ngm:knowledge-graph,
        ngm:linked-data,
        ngm:real-time-data-access ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:graph-ql,
        ngm:sparql,
        ngm:sql ;
    vc:isPartOf ngm:data-management,
        ngm:database-management-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rdf,
        ngm:semantic-web-linked-data-standard,
        ngm:transaction-processing ;
    vc:requires ngm:database-schema,
        ngm:query-optimiser,
        ngm:query-parser ;
    vc:slug "database-query" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso-iec-9075,
        ngm:sparql ;
    vc:supports ngm:full-text-search,
        ngm:semantic-search ;
    vc:uses ngm:query-processor,
        ngm:rest-api,
        ngm:sparql .

ngm:decentralized-application a owl:Class ;
    rdfs:label "Decentralized Application"@en ;
    rdfs:comment "A decentralized application (dApp) is a software application whose backend logic runs on a blockchain or peer-to-peer network rather than on centralised servers controlled by a single entity, ensuring that no single party can unilaterally modify, censor, or shut down the application. The on-chain components — typically smart contracts — enforce business logic and state transitions transparently, while user-facing frontends may remain conventional web or mobile interfaces that communicate with the blockchain via wallet connectors. dApps inherit the censorship resistance and trustlessness of their underlying blockchain while exposing usability challenges related to transaction costs, latency, and key management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:oracle ],
        ngm:blockchain-application ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:centralized-application ;
    vc:dependsOn ngm:evm,
        ngm:ipfs,
        ngm:smart-contract-platform ;
    vc:enables ngm:blockchain-governance,
        ngm:dao,
        ngm:decentralized-finance-de-fi,
        ngm:non-fungible-token,
        ngm:tokenized-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:oracle,
        ngm:smart-contract ;
    vc:implements ngm:censorship-resistance,
        ngm:trustless-execution ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:de-fi,
        ngm:web3 ;
    vc:requires ngm:blockchain-network,
        ngm:consensus-mechanism,
        ngm:wallet ;
    vc:slug "decentralized-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:account-abstraction,
        ngm:blockchain,
        ngm:layer-2-scaling .

ngm:deep-reinforcement-learning a owl:Class ;
    rdfs:label "Deep Reinforcement Learning"@en ;
    rdfs:comment "Deep Reinforcement Learning (DRL) is a machine learning paradigm that combines deep neural networks with reinforcement learning, enabling agents to learn optimal policies for sequential decision-making tasks by interacting with an environment, receiving scalar reward signals, and updating neural network parameters through gradient-based optimisation. Grounded in the Markov Decision Process framework, DRL applies the Bellman equation recursively to approximate value functions or directly optimise policies using methods such as DQN, PPO, SAC, and MuZero, achieving superhuman performance in games, robotics control, chip design, and language model alignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation-environment ],
        ngm:deep-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:imitation-learning,
        ngm:supervised-learning ;
    vc:enables ngm:agent,
        ngm:agentic-ai,
        ngm:multi-agent-reinforcement-learning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proximal-policy-optimisation,
        ngm:q-learning,
        ngm:temporal-difference-learning ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:diffusion-policy,
        ngm:game-theory,
        ngm:large-language-model,
        ngm:machine-learning-discipline,
        ngm:model-based-reinforcement-learning,
        ngm:offline-reinforcement-learning ;
    vc:requires ngm:backpropagation,
        ngm:experience-replay,
        ngm:markov-decision-process,
        ngm:simulation-environment ;
    vc:slug "deep-reinforcement-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:artificial-intelligence,
        ngm:safe-ai ;
    vc:uses ngm:action-space,
        ngm:bellman-equation,
        ngm:convolutional-neural-network,
        ngm:environment-model,
        ngm:gpu-acceleration,
        ngm:monte-carlo-tree-search,
        ngm:neural-network,
        ngm:policy-gradient-methods,
        ngm:reward-signal,
        ngm:value-function .

ngm:design-software a owl:Class ;
    rdfs:label "Design Software"@en ;
    rdfs:comment "Design software comprises applications used to create, edit, visualise, and publish visual, spatial, or interactive artefacts across disciplines including graphic design, user interface and user experience design, 3D modelling, architectural drafting, motion graphics, and industrial product design. These tools span 2D vector and raster editors, parametric and direct-modelling CAD environments, sculpting and procedural-generation suites, prototyping platforms, and real-time 3D authoring environments that feed directly into game engines and extended reality runtimes. Modern design software increasingly integrates generative AI assistance for layout suggestion, texture synthesis, mesh generation, and design-variant exploration. The category sits at the intersection of creative practice, software engineering, and spatial computing infrastructure, making it a foundational enabler of digital content pipelines across entertainment, architecture, manufacturing, and immersive media."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cad-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:animation-software ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:building-information-modelling,
        ngm:machine-learning ;
    vc:contrastsWith ngm:game-engine ;
    vc:enables ngm:3-d-content-generation,
        ngm:digital-twin,
        ngm:film-production,
        ngm:user-interface-design,
        ngm:virtual-production-workflow ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:3-d-modeling,
        ngm:animation-software,
        ngm:cad-software ;
    vc:isPartOf ngm:content-pipeline,
        ngm:technology-stack ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:colour-management,
        ngm:digital-asset-management,
        ngm:rendering-pipeline ;
    vc:requires ngm:file-format-standard,
        ngm:graphics-processing-unit ;
    vc:slug "design-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:extended-reality,
        ngm:metaverse,
        ngm:spatial-computing ;
    vc:uses ngm:3-d-rendering-engine,
        ngm:computer-vision,
        ngm:generative-ai,
        ngm:procedural-generation,
        ngm:rasterization .

ngm:emission-schedule a owl:Class ;
    rdfs:label "Emission Schedule"@en ;
    rdfs:comment "An Emission Schedule is the predetermined, protocol-encoded timeline that specifies the rate at which new tokens are minted and distributed to participants over the lifetime of a blockchain network. It governs how the total supply of a token expands from genesis toward any eventual supply cap or steady-state inflation rate, directly shaping the economic incentives for validators, miners, and stakers. Well-designed emission schedules balance early bootstrapping of network security with long-term sustainability once adoption is established."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:halving ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:total-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:incentive-alignment,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:halving ;
