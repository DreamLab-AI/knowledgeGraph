        ngm:multisig-wallet,
        ngm:tally-governance .

ngm:render-pipeline a owl:Class ;
    rdfs:label "Render Pipeline"@en ;
    rdfs:comment "A Render Pipeline is the ordered sequence of programmable and fixed-function GPU stages that transforms 3D scene geometry, material data, and lighting information into a final rasterised or ray-traced 2D image frame, typically encompassing vertex processing, tessellation, geometry shading, rasterisation, fragment shading, depth-stencil testing, blending, and screen-space post-processing. Modern graphics APIs — including Vulkan, DirectX 12, Metal, and WebGPU — expose explicit, low-overhead control over pipeline state objects and synchronisation barriers, enabling advanced techniques such as deferred rendering, clustered shading, variable-rate shading, and hardware-accelerated ray tracing. The render pipeline is the core computational artefact of any real-time interactive graphics system and is equally foundational to offline path-traced production rendering, though the stage granularity and scheduling strategies differ considerably between the two contexts. In spatial computing and metaverse platforms, render pipeline design determines latency, fidelity, and energy consumption on resource-constrained XR devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning-accelerator,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:offline-rendering,
        ngm:path-tracing ;
    vc:dependsOn ngm:driver-model,
        ngm:memory-bandwidth ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:ray-tracing,
        ngm:real-time-rendering,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:compute-shader,
        ngm:depth-buffer,
        ngm:fragment-shader,
        ngm:post-processing,
        ngm:rasteriser,
        ngm:shader,
        ngm:vertex-shader ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail,
        ngm:occlusion-culling,
        ngm:physics-engine,
        ngm:signal-processing ;
    vc:requires ngm:gpu,
        ngm:graphics-api,
        ngm:scene-graph ;
    vc:slug "render-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:w3c ;
    vc:uses ngm:3-d-rendering-engine,
        ngm:physically-based-rendering,
        ngm:vulkan,
        ngm:webgpu .

ngm:renewable-energy a owl:Class ;
    rdfs:label "Renewable Energy"@en ;
    rdfs:comment "Renewable Energy encompasses energy derived from naturally replenishing sources — principally solar photovoltaic, wind, hydropower, geothermal, tidal, and biomass — that are not depleted by use and produce little or no direct greenhouse gas emissions during operation. It forms the primary technical basis for decarbonising electricity systems worldwide, with cost reductions in solar and wind having made these technologies the cheapest sources of new generation capacity in most markets. Deployment is enabled by complementary systems including grid-scale energy storage, smart grid management, and market instruments such as Renewable Energy Certificates that allow attribution of clean generation to specific consumers. The sector intersects directly with digital infrastructure through the growing energy demands of data centres and AI workloads, driving hyperscaler Power Purchase Agreements and shaping where compute infrastructure is sited globally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-grid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-electronics ],
        ngm:energy-and-power ;
    vc:bridgesTo ngm:ai-energy-consumption,
        ngm:grid-aware-computing ;
    vc:contrastsWith ngm:fossil-fuels,
        ngm:nuclear-power ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:electrification-of-transport,
        ngm:green-hydrogen,
        ngm:sustainable-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:biomass-energy,
        ngm:geothermal-energy,
        ngm:hydropower,
        ngm:solar-photovoltaic,
        ngm:wind-power ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:carbon-market,
        ngm:environmental-sustainability,
        ngm:scope-2-emissions,
        ngm:sustainability-reporting ;
    vc:requires ngm:energy-storage,
        ngm:power-electronics,
        ngm:smart-grid ;
    vc:slug "renewable-energy" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-standards,
        ngm:international-renewable-energy-agency ;
    vc:supports ngm:data-centre-operations,
        ngm:energy-management,
        ngm:sustainable-technology ;
    vc:uses ngm:power-purchase-agreement,
        ngm:renewable-energy-certificates .

