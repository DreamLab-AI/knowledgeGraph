vf:virtual-machine a owl:Class ;
    rdfs:label "Virtual Machine"@en ;
    rdfs:comment "A virtual machine in blockchain contexts is a runtime environment executing [[SmartContract|smart contracts]] deterministically, translating high-level contract code into low-level operations whilst enforcing resource limits and preventing unauthorised state modifications. The [[EVM|Ethereum Virtual Machine]] dominates as the reference implementation, executing [[Solidity|Solidity]] bytecode across thousands of nodes globally, with alternatives including [[WASM|WebAssembly]]-based [[SolanaSVM|Solana's Sealevel VM]], [[MoveVM|Move VM]], and [[CairoVM|Cairo VM]] providing specialised optimisations for specific use cases. Deterministic execution is paramount—identical contract invocations across decentralised networks must produce identical results, enabling consensus formation without relying on centralised authorities."@en ;
    rdfs:subClassOf vf:computing-infrastructure ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "virtual-machine" ;
    vc:sourceDomain "infrastructure" .

