ngm:remote-attestation a owl:Class ;
    rdfs:comment "Remote attestation is a security mechanism by which one system proves the integrity and identity of its software and hardware state to a remote verifier. The attesting platform produces cryptographically signed evidence, rooted in a hardware root of trust, that captures measurements of its boot sequence and running code. A verifier checks this evidence against expected values and a trusted signing key before granting access or releasing secrets, allowing trust decisions to be made about a machine that is not physically controlled."@en ;
    rdfs:label "Remote Attestation"@en ;
    rdfs:subClassOf ngm:confidential-computing ;
    rdfs:subClassOf _:r17997 ;
    rdfs:subClassOf _:r17998 ;
    rdfs:subClassOf _:r17999 ;
