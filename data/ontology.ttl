        ngm:smart-contracts ;
    vc:requires ngm:financial-regulation ;
    vc:slug "financial-services" ;
    vc:sourceDomain "infrastructure" .

ngm:flash-attention a owl:Class ;
    rdfs:label "Flash Attention"@en ;
    rdfs:comment "Flash Attention is an IO-aware, exact attention algorithm that exploits GPU memory hierarchy by tiling the query, key, and value matrices to keep intermediate activations in fast on-chip SRAM rather than the much slower high-bandwidth DRAM (HBM), eliminating the O(N²) memory materialisation of the standard scaled dot-product attention. Introduced by Dao et al. at Stanford in 2022 and extended in Flash Attention 2 and 3, it achieves the same numerical output as standard attention whilst reducing HBM reads and writes by a factor proportional to the SRAM tile size, yielding 2–4× wall-clock speedups for long sequences with sub-linear memory growth. It is now a standard component of transformer training and inference frameworks including PyTorch, JAX, and vLLM."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-infrastructure ;
    vc:enables ngm:inference,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:transformer-architecture ;
    vc:requires ngm:attention-mechanism,
        ngm:gpu-compute ;
    vc:slug "flash-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:gas-fee-market a owl:Class ;
    rdfs:label "Gas Fee Market"@en ;
    rdfs:comment "The Gas Fee Market is the economic mechanism governing blockchain transaction costs, where users bid gas fees to prioritise transaction processing. Governed by EIP-1559 on Ethereum, it separates a burned base fee from an optional priority tip, creating a market-based congestion control system essential for NFT trades, smart contract execution, and virtual asset transfers in spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract-execution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain-economics,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-economics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:eip-1559,
        ngm:layer2 ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract-execution ;
    vc:slug "gas-fee-market" ;
    vc:sourceDomain "blockchain" .

ngm:gpt a owl:Class ;
    rdfs:label "GPT"@en ;
    rdfs:comment "Generative Pre-trained Transformer: an autoregressive language model that uses transformer decoder architecture and is pre-trained on large text corpora using next-token prediction. GPT models learn rich representations through unsupervised pre-training and are subsequently fine-tuned for diverse downstream NLP tasks, demonstrating that scale and the language modelling objective yield powerful transfer learning."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:dependsOn ngm:large-language-models ;
