ngm:mesh-network a owl:Class ;
    rdfs:comment "A mesh network is a network topology in which each node relays data for the network, cooperating to distribute information so that traffic can take multiple paths between source and destination. Mesh networks self-organise and self-heal: when a link or node fails, traffic is rerouted around the fault without manual reconfiguration. They are widely used in wireless sensor networks, smart-home protocols, and community and industrial deployments where infrastructure-free, resilient connectivity is required."@en ;
    rdfs:label "Mesh Network"@en ;
    rdfs:subClassOf ngm:network-topology ;
    rdfs:subClassOf _:r14097 ;
