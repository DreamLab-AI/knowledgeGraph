ngm:robotics-perception a owl:Class ;
    rdfs:label "Robotics Perception"@en ;
    rdfs:comment "Robotics perception is the set of capabilities by which a robot senses, interprets, and builds an internal representation of its physical environment from sensor data. It fuses inputs from cameras, lidar, depth sensors, and inertial units to perform object detection, scene understanding, localisation, and mapping. Robust perception is the foundation for autonomous navigation and manipulation, transforming raw, noisy measurements into actionable spatial knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        ngm:perception ;
    vc:bridgesTo ngm:computer-vision-system ;
    vc:enables ngm:autonomous-system,
        ngm:path-planning,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-estimation,
        ngm:object-detection,
        ngm:scene-understanding ;
    vc:isPartOf ngm:perception-system,
        ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:occupancy-grid,
        ngm:robot ;
    vc:requires ngm:computer-vision,
        ngm:lidar,
        ngm:sensor-fusion ;
    vc:slug "robotics-perception" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:environment-mapping,
        ngm:manipulation ;
    vc:uses ngm:camera,
        ngm:point-cloud,
        ngm:stereo-vision .

ngm:service-level-agreement a owl:Class ;
    rdfs:label "Service Level Agreement"@en ;
    rdfs:comment "A service level agreement (SLA) is a formal contract between a service provider and its customers that defines the measurable level of service to be delivered, including availability, performance, and response-time targets, together with the remedies or credits owed when those targets are breached. SLAs translate abstract reliability expectations into quantitative service level objectives and indicators that can be monitored and enforced. They are central to cloud computing, managed services, and outsourcing, providing the accountability framework around which capacity, support, and operational practices are organised."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-level-objective ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:error-budget,
        ngm:site-reliability-engineering ;
    vc:contrastsWith ngm:best-effort-service ;
    vc:dependsOn ngm:monitoring,
        ngm:observability ;
    vc:enables ngm:accountability,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:service-credit,
        ngm:service-level-indicator,
        ngm:service-level-objective ;
    vc:implements ngm:contractual-obligation ;
    vc:isPartOf ngm:service-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:capacity-planning,
        ngm:disaster-recovery ;
    vc:requires ngm:uptime-measurement ;
    vc:slug "service-level-agreement" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:managed-services ;
    vc:uses ngm:metrics .

ngm:shader-language a owl:Class ;
    rdfs:label "Shader Language"@en ;
    rdfs:comment "A Shader Language is a domain-specific programming language designed to express GPU-executable programs that control one or more programmable stages of a graphics or compute pipeline. Shader languages provide specialised type systems encompassing vectors, matrices, samplers, and atomic types, while deliberately restricting features incompatible with massively parallel execution such as dynamic memory allocation and unbounded recursion. Major production languages include GLSL (OpenGL Shading Language) for OpenGL and WebGL, HLSL (High-Level Shading Language) for DirectX, Metal Shading Language for Apple silicon and macOS/iOS platforms, and the emerging WGSL (WebGPU Shading Language) for the web-native WebGPU API. Modern shader toolchains commonly cross-compile to the hardware-agnostic intermediate representation SPIR-V, enabling portability across vendors and runtime environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader-compiler ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tessellation-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:geometry-shader ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning-accelerator,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:programming-language ;
    vc:dependsOn ngm:parallel-computing,
        ngm:spir-v ;
    vc:enables ngm:gpu-compute,
        ngm:physically-based-rendering,
        ngm:procedural-generation,
        ngm:ray-tracing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:compute-shader,
        ngm:geometry-shader,
        ngm:pixel-shader,
        ngm:tessellation-shader,
        ngm:vertex-shader ;
    vc:implements ngm:glsl,
        ngm:hlsl,
        ngm:wgsl ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:graphics-processing-unit,
        ngm:texture-mapping ;
    vc:requires ngm:gpu,
        ngm:graphics-api,
        ngm:shader-compiler ;
    vc:slug "shader-language" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:w3-c ;
    vc:supports ngm:augmented-reality,
        ngm:virtual-reality,
        ngm:webgpu .

ngm:simulation-environment a owl:Class ;
    rdfs:label "Simulation Environment"@en ;
    rdfs:comment "A simulation environment is a software-defined system that models physical or virtual worlds with sufficient fidelity to support training, testing, or validation of agents, algorithms, or hardware without exposure to real-world risk or cost. It integrates a physics engine, sensor models, actuator dynamics, and observation/action interfaces, and is used across robotics, autonomous vehicle development, reinforcement learning research, and military mission planning. Fidelity-reality gaps — differences between simulated and real-world dynamics — are the primary challenge in transferring learned behaviours from simulation to deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:action-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-model ],
        ngm:simulation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:metaverse,
        ngm:virtual-environment ;
    vc:contrastsWith ngm:hardware-in-the-loop-testing ;
    vc:enables ngm:domain-randomisation,
        ngm:embodied-ai-simulation,
        ngm:reinforcement-learning,
        ngm:sim-to-real-transfer,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:action-space,
        ngm:actuator-model,
        ngm:observation-space,
        ngm:physics-engine,
        ngm:sensor-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:openai-gym,
        ngm:physics-simulation,
        ngm:world-model ;
    vc:requires ngm:physics-engine,
        ngm:rendering-engine ;
    vc:slug "simulation-environment" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-vehicle-testing,
        ngm:robot-learning,
        ngm:simulation-engine ;
    vc:uses ngm:game-engine,
        ngm:neural-rendering .

ngm:smart-manufacturing a owl:Class ;
    rdfs:label "Smart Manufacturing"@en ;
    rdfs:comment "Smart manufacturing is an integrated approach to industrial production that embeds advanced sensing, connectivity, data analytics, and artificial intelligence throughout the production system to achieve real-time visibility, adaptive control, and continuous optimisation of manufacturing processes. It combines cyber-physical systems, the Industrial Internet of Things, digital twins, machine learning, and cloud and edge computing to create intelligent factories capable of self-monitoring, predictive maintenance, and autonomous quality control. Smart manufacturing extends beyond factory automation to encompass supply chain integration, mass customisation, and sustainability optimisation, representing the operational realisation of the Industry 4.0 paradigm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cyber-physical-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:5-g-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-io-t ],
        ngm:manufacturing-automation ;
    vc:bridgesTo ngm:digital-thread,
        ngm:industrial-metaverse ;
    vc:contrastsWith ngm:traditional-manufacturing ;
    vc:dependsOn ngm:cloud-computing,
        ngm:real-time-data-processing ;
    vc:enables ngm:industrial-automation,
        ngm:mass-customisation,
        ngm:predictive-maintenance,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:control-system,
        ngm:digital-twin,
        ngm:edge-computing,
        ngm:industrial-io-t ;
    vc:implements ngm:industrial-io-t ;
    vc:isPartOf ngm:industry-4-0 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:robotics ;
    vc:requires ngm:5-g-network,
        ngm:cyber-physical-systems ;
    vc:slug "smart-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-30141 ;
    vc:supports ngm:precision-manufacturing,
        ngm:sustainable-manufacturing ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning,
        ngm:opc-ua .

ngm:state-space-model a owl:Class ;
    rdfs:label "State Space Model"@en ;
    rdfs:comment "A State Space Model (SSM) is a mathematical framework that represents a dynamical system through a hidden (latent) state vector whose evolution over discrete or continuous time is governed by linear or learnable recurrence equations, paired with an output equation mapping states to observations. Originally formalised in control theory and signal processing — with the Kalman filter as a canonical inference algorithm — SSMs have been re-parameterised as structured sequence layers in deep learning, enabling sub-quadratic scaling in sequence length as an alternative to self-attention. Modern deep SSM variants such as S4, Mamba, and RWKV exploit diagonal or low-rank structure in the state transition matrix to achieve hardware-efficient training and inference on long sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:recurrent-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:autonomous-system,
        ngm:robotics-control ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:self-attention,
        ngm:transformer ;
    vc:dependsOn ngm:hidden-markov-model,
        ngm:probabilistic-model ;
    vc:enables ngm:audio-generation,
        ngm:language-model,
        ngm:long-range-dependency-modelling,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:kalman-filter ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:deep-learning,
        ngm:neural-network,
        ngm:sequence-model,
        ngm:sequence-to-sequence-model ;
    vc:requires ngm:linear-algebra,
        ngm:recurrent-neural-network,
        ngm:signal-processing ;
    vc:slug "state-space-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:convolution .

ngm:statistical-learning-theory a owl:Class ;
    rdfs:label "Statistical Learning Theory"@en ;
    rdfs:comment "A framework that studies the conditions under which algorithms can generalise from finite training data to unseen data, providing theoretical bounds on prediction error via concepts such as VC dimension, PAC learnability, and Rademacher complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        ngm:machine-learning-discipline ;
    vc:bridgesTo ngm:algorithmic-complexity,
        ngm:bayesian-inference ;
    vc:contrastsWith ngm:bias-variance-tradeoff,
        ngm:overfitting ;
    vc:dependsOn ngm:hypothesis-class,
        ngm:loss-function ;
    vc:enables ngm:deep-learning,
        ngm:model-selection,
        ngm:regularisation,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:empirical-risk-minimisation,
        ngm:pac-learning,
        ngm:vc-dimension ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-theory ;
    vc:requires ngm:concentration-inequalities,
        ngm:measure-theory,
        ngm:probability-theory,
        ngm:statistics ;
    vc:slug "statistical-learning-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:cross-validation,
        ngm:support-vector-machine .

ngm:statistical-testing a owl:Class ;
    rdfs:label "Statistical Testing"@en ;
    rdfs:comment "Statistical testing is the practice of using sample data to assess evidence for or against a hypothesis about a population or process. It formalises a null and alternative hypothesis, computes a test statistic and an associated significance level, and decides whether observed effects are likely to be genuine rather than due to chance. It underpins rigorous evaluation of models, experiments and measurements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:experimental-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-sampling ],
        ngm:statistical-analysis ;
    vc:bridgesTo ngm:a-b-testing ;
    vc:contrastsWith ngm:bayesian-inference ;
    vc:dependsOn ngm:probability-distribution,
        ngm:random-sampling ;
    vc:enables ngm:a-b-testing,
        ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:experimental-design,
        ngm:statistical-analysis ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:experimental-design,
        ngm:statistical-analysis,
