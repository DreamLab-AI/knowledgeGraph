ngm:vote-delegation a owl:Class ;
    rdfs:label "Vote Delegation"@en ;
    rdfs:comment "Vote delegation is a governance mechanism by which a token holder assigns their voting power to another address that votes on their behalf, without transferring ownership of the underlying assets. It is central to on-chain DAO governance, enabling passive holders to entrust active, informed delegates and improving participation rates. Delegation can be revoked or reassigned, and may be liquid, allowing chained or topic-specific delegation."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delegate-democracy,
        ngm:governance-token ;
    vc:slug "vote-delegation" ;
    vc:sourceDomain "blockchain" .

ngm:web-gl a owl:Class ;
    rdfs:label "WebGL"@en ;
    rdfs:comment "WebGL (Web Graphics Library) is a royalty-free JavaScript API that exposes a subset of OpenGL ES 2.0 and 3.0 to web browsers, enabling hardware-accelerated 2D and 3D rendering directly inside an HTML canvas element without requiring browser plug-ins. It communicates directly with the GPU through the browser's graphics pipeline, exposing programmable vertex and fragment shaders written in GLSL ES. Standardised by the Khronos Group and supported natively in all major browsers, WebGL underpins interactive visualisations, browser-based games, scientific data rendering, and WebXR spatial computing experiences. Its successor API, WebGPU, offers a more modern GPU abstraction while WebGL remains the dominant, battle-tested standard for cross-platform GPU-accelerated web graphics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:java-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:glsl ],
        ngm:graphics-api ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:contrastsWith ngm:direct3d,
        ngm:vulkan,
        ngm:webgpu ;
    vc:dependsOn ngm:opengl-es ;
    vc:enables ngm:data-visualisation,
        ngm:real-time-rendering,
        ngm:scientific-visualisation,
        ngm:web-xr ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:opengl-es ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:babylon-js,
        ngm:computer-graphics,
        ngm:three-js,
        ngm:web-assembly ;
    vc:requires ngm:glsl,
        ngm:gpu,
        ngm:java-script ;
    vc:slug "web-gl" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:uses ngm:rasterization,
        ngm:shader,
        ngm:texture-mapping .

ngm:3-d-rendering a owl:Class ;
    rdfs:label "3D Rendering"@en ;
    rdfs:comment "3D rendering is the computational process of generating a two-dimensional image or animation from a three-dimensional scene description by simulating the interaction of light with surfaces, materials, and geometry. It encompasses techniques ranging from real-time rasterization used in interactive applications to physically-based ray tracing and path tracing used for photorealistic offline production. The pipeline converts geometric primitives, shader programs, texture maps, and lighting data into final pixel colours via a GPU compute pipeline or software renderer. Contemporary rendering also incorporates neural methods such as Neural Radiance Fields and 3D Gaussian Splatting, as well as AI-driven upscaling and denoising, blurring the boundary between classical computer graphics and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-buffer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-lighting-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-pipeline ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:3-d-content-generation,
        ngm:3-d-gaussian-splatting,
        ngm:differentiable-rendering,
        ngm:neural-radiance-field ;
    vc:dependsOn ngm:3-d-rendering-engine,
        ngm:linear-algebra ;
    vc:enables ngm:augmented-reality,
        ngm:foveated-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering,
        ngm:real-time-graphics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:path-tracing,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:ray-tracing,
        ngm:render-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-aliasing,
        ngm:global-illumination,
        ngm:level-of-detail,
        ngm:spatial-computing ;
    vc:requires ngm:depth-buffer,
