    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-8101" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "IndustryEcosystem" .

infrastructure:TechnologyEcosystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:AIDevelopment
] .

