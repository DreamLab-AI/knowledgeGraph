ngm:task-specific-head a owl:Class ;
    rdfs:label "Task Specific Head"@en ;
    rdfs:comment "A Task-Specific Head is a shallow neural network module appended to a frozen or fine-tuned pre-trained model to adapt its representations for a particular downstream task. Architecturally it may be a single linear projection for classification, start/end span predictors for question answering, or a lightweight decoder for generation; it is randomly initialised and optimised during fine-tuning whilst the shared base model provides task-agnostic representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:parameter-efficient-fine-tuning ;
    vc:requires ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:slug "task-specific-head" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:machine-learning-model,
        ngm:neural-network-layer .

