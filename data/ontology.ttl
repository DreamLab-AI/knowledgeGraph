ngm:joint-configuration a owl:Class ;
    rdfs:label "Joint Configuration"@en ;
    rdfs:comment "Joint configuration is the complete set of joint positions of a robot manipulator that together determine the pose of its links and end effector."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        ngm:kinematics ;
    vc:enables ngm:mobile-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:forward-kinematics ;
    vc:slug "joint-configuration" ;
    vc:sourceDomain "robotics" .

ngm:joint-encoder a owl:Class ;
    rdfs:label "Joint Encoder"@en ;
    rdfs:comment "A joint encoder is a sensor mounted at a robot joint that measures angular or linear position, and often velocity, of that joint. It provides the proprioceptive feedback required for closed-loop position and motion control of articulated mechanisms. Encoders may be optical, magnetic or capacitive and are typically classed as incremental or absolute."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:proprioceptive-sensor ;
    vc:slug "joint-encoder" ;
    vc:sourceDomain "robotics" .

ngm:json-ld-1-1-standard a owl:Class ;
    rdfs:label "JSON-LD 1.1 Standard"@en ;
    rdfs:comment "JSON-LD 1.1 is a W3C Recommendation defining a JSON-based serialization for Linked Data, allowing JSON documents to be interpreted as RDF graphs. It introduces a context mechanism that maps JSON keys to IRIs, plus features such as framing, nested contexts and typed values added in the 1.1 revision. It is the dominant format for embedding machine-readable semantics in web data."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:linked-data-encoder ;
    vc:slug "json-ld-1-1-standard" ;
    vc:sourceDomain "data" .

ngm:keccak-256 a owl:Class ;
    rdfs:label "Keccak-256"@en ;
    rdfs:comment "A 256-bit cryptographic hash function based on the Keccak sponge construction, selected as the SHA-3 standard and used natively in Ethereum for address derivation, transaction hashing, and smart contract storage. It differs from NIST SHA-3 in padding and offers strong collision resistance and preimage resistance properties."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-cryptographic-primitive ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:preimage-resistance,
        ngm:sha-256 ;
    vc:slug "keccak-256" ;
    vc:sourceDomain "blockchain" .

ngm:key-exchange a owl:Class ;
    rdfs:label "Key Exchange"@en ;
    rdfs:comment "Key exchange is a cryptographic procedure by which two parties establish a shared secret over an insecure channel for use in subsequent encrypted communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptography ;
    vc:enables ngm:symmetric-encryption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "key-exchange" ;
    vc:sourceDomain "cryptography" .

ngm:kyc a owl:Class ;
    rdfs:label "KYC"@en ;
    rdfs:comment "Know Your Customer, the set of procedures by which a regulated entity verifies the identity of its clients and assesses associated risks before and during a business relationship."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
