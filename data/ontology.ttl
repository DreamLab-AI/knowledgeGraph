ngm:iso-ts-15066 a owl:Class ;
    rdfs:label "ISO TS 15066"@en ;
    rdfs:comment "ISO/TS 15066:2016 is an ISO Technical Specification that supplements ISO 10218-1 and ISO 10218-2 by providing detailed guidance and biomechanical data for the safety of collaborative robot applications in which industrial robots and human workers share a common workspace without a physical separating guard. It defines four collaboration modes — safety-rated monitored stop, hand guiding, speed and separation monitoring, and power and force limiting — along with body-part-specific pain thresholds that govern permissible contact forces and pressures for 29 anatomical regions. The specification is a foundational reference for cobot risk assessment, CE marking under the EU Machinery Directive, and the basis for evolving ISO 10218-3 work within ISO TC 299."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:robot-standard ;
    vc:bridgesTo ngm:computer-vision,
        ngm:sensor-fusion ;
    vc:contrastsWith ngm:iec-62061,
        ngm:iso-10218,
        ngm:iso-13849 ;
    vc:enables ngm:ce-marking,
        ngm:cobot-deployment,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:hand-guiding,
        ngm:power-and-force-limiting,
        ngm:safety-rated-monitored-stop,
        ngm:speed-and-separation-monitoring ;
    vc:isPartOf ngm:iso-10218 ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ergonomics,
        ngm:eu-machinery-directive,
        ngm:industrial-automation,
        ngm:robot-safety ;
    vc:requires ngm:biomechanical-data,
        ngm:risk-assessment ;
    vc:slug "iso-ts-15066" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:collaborative-robot,
        ngm:iso-tc-299 ;
    vc:supports ngm:functional-safety,
        ngm:human-robot-interaction,
        ngm:occupational-safety ;
    vc:uses ngm:force-control,
        ngm:proximity-sensing,
        ngm:torque-sensing .

ngm:manipulation a owl:Class ;
    rdfs:label "Manipulation"@en ;
    rdfs:comment "Manipulation is the capability of robotic or autonomous systems to physically interact with, grasp, reposition, and transform objects in an environment through controlled mechanical action. It integrates perception, kinematics, dynamics, and planning to enable precise, dexterous, and adaptive contact-rich tasks. Robotic manipulation encompasses the full pipeline from object detection and pose estimation through grasp planning, motion execution, and force-regulated contact control. As a foundational capability in intelligent systems, it bridges physical embodiment with higher-level task reasoning and is central to industrial automation, service robotics, and human-robot collaboration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:grasp-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
