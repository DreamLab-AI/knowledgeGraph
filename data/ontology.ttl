    vc:uses ngm:biometric-age-estimation,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof .

ngm:ar-frame a owl:Class ;
    rdfs:label "AR Frame"@en ;
    rdfs:comment "An AR Frame is a head-worn optical see-through augmented reality platform integrating a transparent or semi-transparent microdisplay (typically a microOLED, LCoS, or holographic waveguide projecting 480p-1080p imagery onto a combiner lens of 20°-50° diagonal field-of-view), onboard processing (AR..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
