ngm:ai-impact-assessment a owl:Class ;
    rdfs:label "AI Impact Assessment"@en ;
    rdfs:comment "A systematic process for identifying, analysing, evaluating, and documenting the potential positive and negative effects of an artificial intelligence system on individuals, groups, organisations, society, and the environment across multiple dimensions including fundamental rights, ethical principles, safety, fairness, privacy, environmental sustainability, and socioeconomic impacts, conducted prior to deployment and periodically thereafter to inform design decisions, risk mitigation strategies, governance arrangements, and stakeholder communication regarding AI system consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-rights ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:environmental-impact-assessment,
        ngm:gdpr ;
    vc:dependsOn ngm:risk-management ;
    vc:enables ngm:accountability,
        ngm:informed-decision-making,
        ngm:risk-management,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:documentation-and-reporting,
        ngm:risk-mitigation-planning,
        ngm:stakeholder-engagement ;
    vc:implements ngm:nist-ai-risk-management-framework ;
    vc:isPartOf ngm:ai-governance,
        ngm:ai-lifecycle ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:responsible-ai ;
    vc:requires ngm:fairness,
        ngm:human-rights,
        ngm:stakeholder ;
    vc:slug "ai-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eu-ai-act-article-27,
        ngm:iso-iec-23894-2023,
        ngm:iso-iec-42001-2023 ;
    vc:supports ngm:ai-audit,
