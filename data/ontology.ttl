ngm:zk-rollup a owl:Class ;
    rdfs:label "ZK Rollup"@en ;
    rdfs:comment "A ZK rollup is a Layer 2 scaling construction that executes transactions off-chain and posts a succinct validity proof, typically a zk-SNARK or zk-STARK, to a Layer 1 chain so the base layer can verify correctness without re-executing the batch. Compressed transaction data and the proof are published on-chain, inheriting the security of the underlying settlement layer while drastically reducing per-transaction cost. Unlike optimistic rollups, finality does not require a fraud-proof challenge window because validity is proven cryptographically."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:rollup ;
    vc:bridgesTo ngm:layer-2-networks ;
    vc:contrastsWith ngm:optimistic-rollup,
        ngm:sidechain,
        ngm:state-channel ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:scalability,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-availability ;
    vc:implements ngm:cryptographic-proof,
        ngm:zk-snark ;
    vc:isPartOf ngm:layer-2-scaling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain ;
    vc:requires ngm:zero-knowledge-proof ;
    vc:slug "zk-rollup" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An autonomous computational or physical entity that perceives its environment, reasons about its perceptions using internal beliefs and goals, and acts to achieve specified objectives—exhibiting autonomy, reactivity, proactivity, and social ability across AI, blockchain, robotics, and metaverse domains."@en ;
