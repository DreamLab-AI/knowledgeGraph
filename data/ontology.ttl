    vc:sourceDomain "machine-learning" .

ngm:monetary-system a owl:Class ;
    rdfs:label "Monetary System"@en ;
    rdfs:comment "The comprehensive framework of institutions, regulations, and mechanisms governing money creation, distribution, and management within an economy, now evolving to incorporate digital currencies, CBDCs, and blockchain-based financial systems."@en ;
