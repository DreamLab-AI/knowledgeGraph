    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:arbitration-decision-engine,
        ngm:code-interpretation-service,
        ngm:contract-analysis-process,
        ngm:on-chain-evidence-verification ;
    vc:isPartOf ngm:dispute-resolution-mechanism,
        ngm:smart-contract-governance ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:arbitrator-expertise,
        ngm:blockchain-transaction-log,
        ngm:identity-verification,
        ngm:smart-contract-code ;
    vc:slug "e-contract-arbitration" ;
    vc:sourceDomain "spatial-computing" .

ngm:ecash a owl:Class ;
    rdfs:label "ecash"@en ;
    rdfs:comment "A privacy-preserving digital cash system based on David Chaum's blind-signature cryptography, enabling bearer-token payments in which the issuing mint cannot link individual transactions to users. Modern implementations such as Cashu and Fedimint build Chaumian eCash on top of Bitcoin and the Lightning Network, enabling censorship-resistant micropayments for human and autonomous-agent use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:censorship-resistance ],
        ngm:bc-token-and-asset,
        ngm:payment-system ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:identity-management,
        ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:cashu,
        ngm:smart-contracts ;
    vc:requires ngm:censorship-resistance ;
    vc:slug "ecash" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:lightning-network .

ngm:edge-ai-for-smart-cities a owl:Class ;
    rdfs:label "Edge AI for Smart Cities"@en ;
    rdfs:comment "Edge AI for Smart Cities is the deployment of machine learning inference directly on distributed urban infrastructure—smart cameras, IoT sensors, edge gateways, and computing nodes embedded in roads, buildings, and public spaces—enabling real-time autonomous decision-making for traffic management, public safety monitoring, environmental sensing, and energy optimisation without requiring centrally routed cloud processing. This architecture achieves sub-second response latencies, preserves citizen privacy by processing video locally, and overcomes bandwidth constraints that make continuous cloud uplink of high-resolution urban sensor streams impractical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-twin-ecosystem ;
    vc:enables ngm:autonomous-system,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:edge-ai-accelerator,
        ngm:edge-ai-security ;
    vc:requires ngm:edge-ai-system,
        ngm:edge-computing,
        ngm:real-time-processing ;
    vc:slug "edge-ai-for-smart-cities" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning,
        ngm:object-detection,
        ngm:sensor-fusion .

ngm:edge-orchestration a owl:Class ;
    rdfs:label "Edge Orchestration"@en ;
    rdfs:comment "The process of dynamically coordinating, allocating, and balancing computational tasks between edge nodes and cloud infrastructure to optimize latency, resource utilization, and quality of experience for immersive metaverse applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-performance-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing-node ],
        ngm:edge-computing-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:adaptive-workload-distribution,
        ngm:low-latency-computing,
        ngm:optimized-resource-utilization,
        ngm:scalable-processing ;
    vc:hasMaturity ngmi:maturity-established ;
