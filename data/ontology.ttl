ngm:scene-geometry a owl:Class ;
    rdfs:label "Scene Geometry"@en ;
    rdfs:comment "Scene geometry is the structured description of the spatial shape, surfaces, and arrangement of objects within a three-dimensional environment. It captures positions, depths, surface orientations, and connectivity needed to render, simulate, or reason about a scene. Accurate scene geometry underpins realistic lighting, occlusion, collision, and interaction in spatial computing and computer graphics applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
