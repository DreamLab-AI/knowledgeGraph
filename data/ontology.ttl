ngm:autonomous-business-operations a owl:Class ;
    rdfs:comment "The use of artificial intelligence systems to independently manage, execute, and optimize core business functions and workflows with minimal human intervention."@en ;
    rdfs:label "Autonomous Business Operations"@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
