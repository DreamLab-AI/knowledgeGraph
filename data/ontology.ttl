    vc:enables ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:communication-protocols ;
    vc:slug "synchronous-collaboration" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:system-on-chip a owl:Class ;
    rdfs:label "System-on-Chip"@en ;
    rdfs:comment "A system-on-chip (SoC) is an integrated circuit that combines most or all of the components of a computer system onto a single die, typically including one or more processor cores, memory, input and output interfaces and specialised accelerators. By co-locating these subsystems, an SoC reduces physical size, power consumption and inter-component latency compared with multi-chip designs. SoCs are foundational to mobile devices, embedded systems and edge computing, where space and energy efficiency are critical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu ],
        ngm:hardware-component ;
    vc:contrastsWith ngm:microcontroller ;
    vc:dependsOn ngm:hardware ;
    vc:enables ngm:edge-computing,
        ngm:iot-device ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cpu,
        ngm:gpu,
        ngm:memory ;
    vc:isPartOf ngm:embedded-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:field-programmable-gate-array,
        ngm:hardware-component,
        ngm:system-architecture ;
    vc:slug "system-on-chip" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:internet-of-things,
        ngm:real-time-operating-system ;
    vc:uses ngm:non-volatile-memory .

ngm:tensor-computation a owl:Class ;
    rdfs:label "Tensor Computation"@en ;
    rdfs:comment "Tensor computation is the set of mathematical operations performed on multi-dimensional arrays (tensors) that form the core numerical substrate of modern machine learning. These operations include contraction, element-wise arithmetic, broadcasting, decomposition, and automatic differentiation, typically executed on specialised hardware such as GPUs or TPUs. Tensor computation frameworks provide graph-based or eager execution models that map operations to hardware acceleration primitives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:euclidean-distance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fourier-transform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python-programming-language ],
        ngm:tensor ;
    vc:contrastsWith ngm:programming-language ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:machine-learning,
        ngm:signal-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:euclidean-distance,
        ngm:fourier-transform ;
    vc:implements ngm:linear-algebra,
        ngm:numerical-methods ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:data-modelling ;
    vc:requires ngm:python-programming-language,
        ngm:statistical-analysis ;
    vc:slug "tensor-computation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:distributed-collaboration ;
    vc:uses ngm:data-schema .

ngm:text-summarisation a owl:Class ;
    rdfs:label "Text Summarisation"@en ;
    rdfs:comment "Text summarisation is the NLP task of producing concise, coherent summaries that capture the essential information from longer documents or collections. Systems employ extractive methods (selecting key sentences) or abstractive methods (generating new text) using transformer architectures such as BART, PEGASUS, and T5, with applications spanning news aggregation, research synthesis, and document retrieval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering,
        ngm:text-generation ;
    vc:requires ngm:language-modeling,
        ngm:natural-language-processing ;
    vc:slug "text-summarisation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:bart,
        ngm:large-language-models .

ngm:thermal-management a owl:Class ;
    rdfs:label "Thermal Management"@en ;
    rdfs:comment "Thermal Management is the engineering discipline of controlling the temperature of electronic and electromechanical systems to keep components within safe operating limits. In robotics it addresses heat generated by motors, motor drivers and power electronics, using cooling systems, heat conduction paths and temperature sensing to dissipate or redistribute heat. Effective thermal management protects reliability, sustains performance under load and prevents thermal shutdown or damage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-cooling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cooling-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:temperature-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cooling-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:temperature-sensor ],
        ngm:power-management ;
    vc:bridgesTo ngm:reliability-engineering ;
    vc:dependsOn ngm:power-management ;
    vc:enables ngm:energy-efficiency,
        ngm:reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cooling-system,
        ngm:liquid-cooling,
        ngm:temperature-sensor ;
    vc:isPartOf ngm:power-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:embedded-system,
        ngm:energy-efficiency,
        ngm:servo-motor ;
    vc:requires ngm:cooling-system,
        ngm:temperature-sensor ;
    vc:slug "thermal-management" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:actuator,
        ngm:motor-driver,
        ngm:power-electronics ;
    vc:uses ngm:cooling-system,
        ngm:liquid-cooling .

ngm:tls-handshake a owl:Class ;
    rdfs:label "Tls Handshake"@en ;
    rdfs:comment "The TLS handshake is the negotiation phase of the Transport Layer Security protocol in which a client and server agree on protocol version and cipher suite, authenticate via certificates, and establish shared session keys. It combines public-key cryptography for authentication and key agreement with symmetric cryptography for the subsequent record protocol. Modern versions complete in fewer round trips and provide forward secrecy through ephemeral key exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        ngm:transport-layer-security ;
    vc:bridgesTo ngm:mutual-tls,
        ngm:network-protocol ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:forward-secrecy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:nonce ;
    vc:isPartOf ngm:transport-layer-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:security ;
    vc:requires ngm:hash-function ;
    vc:slug "tls-handshake" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication,
        ngm:encryption ;
    vc:uses ngm:diffie-hellman-key-exchange,
        ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography .

ngm:tokenised-real-world-assets a owl:Class ;
    rdfs:label "Tokenised Real World Assets"@en ;
    rdfs:comment "Tokenised real-world assets (RWAs) are blockchain tokens that represent ownership or economic rights in tangible or traditional financial assets such as property, bonds, equities, or commodities. By mapping off-chain value onto programmable tokens, they enable fractional ownership, continuous settlement, and integration with decentralised finance while still depending on legal frameworks and custodians for enforceability."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance-de-fi,
        ngm:distributed-ledger ;
    vc:slug "tokenised-real-world-assets" ;
    vc:sourceDomain "blockchain" .

ngm:traditional-banking a owl:Class ;
    rdfs:label "Traditional Banking"@en ;
    rdfs:comment "Traditional banking is the long-established system by which licensed deposit-taking institutions accept customer funds, extend credit through loans and mortgages, and operate payment and settlement services under prudential regulatory oversight. Banks act as financial intermediaries, transforming short-term deposits into longer-term loans and profiting from the interest-rate spread while managing liquidity and credit risk. The sector is governed by capital-adequacy frameworks such as Basel III/IV, deposit-insurance schemes, and central-bank lender-of-last-resort facilities. Traditional banking is distinguished from shadow banking and fintech alternatives by its formal licensing, balance-sheet-based intermediation, and full integration with national payment and clearing infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:correspondent-banking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capital-adequacy ],
        ngm:traditional-finance ;
    vc:bridgesTo ngm:blockchain,
        ngm:central-bank-digital-currency,
        ngm:open-banking ;
    vc:contrastsWith ngm:decentralised-finance,
        ngm:neobank,
        ngm:shadow-banking ;
    vc:enables ngm:fractional-reserve-banking,
        ngm:monetary-policy-transmission,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:correspondent-banking,
        ngm:investment-banking ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:financial-inclusion,
        ngm:systemic-risk ;
    vc:requires ngm:capital-adequacy,
        ngm:central-bank,
        ngm:deposit-insurance,
        ngm:financial-regulation ;
    vc:slug "traditional-banking" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:interbank-settlement,
        ngm:know-your-customer,
        ngm:payment-system .

ngm:trust-over-ip-foundation a owl:Class ;
    rdfs:label "Trust Over IP Foundation"@en ;
    rdfs:comment "The Trust over IP (ToIP) Foundation is a Linux Foundation project established in 2020 that defines a dual-stack architecture combining cryptographic machine trust at the technical layer with human, organisational, and legal trust governance frameworks for decentralised identity. The lower technical stack encompasses Decentralised Identifiers (DIDs), Verifiable Credentials, cryptographic key management, and peer-to-peer messaging protocols across four numbered layers, whilst the upper governance stack provides trust registries, policy schemas, legal agreements, and assurance level definitions enabling parties to establish authoritative trust relationships without a central intermediary. ToIP produces the governance meta-model and interoperability specifications needed to make self-sovereign identity deployments composable and trustworthy at ecosystem scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifiers ],
        ngm:standards-body ;
    vc:bridgesTo ngm:digital-wallet,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:federated-identity ;
    vc:enables ngm:credential-exchange,
        ngm:cross-border-identity,
        ngm:governance-framework,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:w3-c-did-core,
        ngm:w3-c-verifiable-credentials ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity-foundation,
        ngm:eidas-regulation ;
    vc:requires ngm:cryptographic-key-management,
        ngm:decentralised-identifiers,
        ngm:public-key-infrastructure ;
    vc:slug "trust-over-ip-foundation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:decentralised-identity,
        ngm:self-sovereign-identity,
        ngm:trust-registry,
        ngm:verifiable-credentials ;
    vc:uses ngm:did-document,
        ngm:didcomm,
        ngm:openid-for-verifiable-credentials .

ngm:underfitting a owl:Class ;
    rdfs:label "Underfitting"@en ;
    rdfs:comment "Underfitting occurs when a machine learning model is insufficiently complex or inadequately trained to capture the underlying structure of its training data, resulting in high bias, low variance, and poor predictive performance on both training and unseen datasets. It is the converse of overfitting and arises from under-parameterisation, insufficient training duration, or excessive regularisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-capacity ],
        ngm:ai-technique,
        ngm:machine-learning-discipline ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:loss-function,
        ngm:regularisation ;
    vc:requires ngm:model-capacity,
        ngm:training ;
    vc:slug "underfitting" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:validation-process a owl:Class ;
    rdfs:label "Validation Process"@en ;
    rdfs:comment "Activity of systematically checking wher systems, components, or implementations satisfy specified requirements, standards, and compliance criteria through verification testing and quality assurance procedures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-assurance ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-verification,
        ngm:regulatory-approval,
        ngm:standards-conformance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-testing,
        ngm:quality-assurance,
        ngm:standards-validation ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compliance-standards ;
    vc:slug "validation-process" ;
    vc:sourceDomain "spatial-computing" .

ngm:vector-search a owl:Class ;
    rdfs:label "Vector Search"@en ;
    rdfs:comment "Vector search is a retrieval paradigm that identifies the items in a corpus whose high-dimensional vector representations are most similar to a query vector, using distance or similarity metrics such as cosine similarity, dot product, or Euclidean distance. Because exhaustive pairwise comparison scales as O(n·d) and becomes intractable for large corpora, practical systems use approximate nearest neighbour (ANN) algorithms — including HNSW, IVF-PQ, and LSH — that trade a small, configurable recall loss for orders-of-magnitude latency improvement. Vectors are typically produced by embedding models that encode semantic, visual, or multimodal meaning into dense float arrays, making vector search inherently meaning-sensitive rather than lexical. The paradigm underpins semantic search, recommendation systems, retrieval-augmented generation, duplicate detection, and cross-modal retrieval across text, image, audio, and structured data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hnsw-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverted-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:spatial-index ;
    vc:contrastsWith ngm:keyword-search,
        ngm:nearest-neighbor-search ;
    vc:dependsOn ngm:nearest-neighbor-search,
        ngm:vector-index ;
    vc:enables ngm:cross-modal-retrieval,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hnsw-index,
        ngm:inverted-index,
        ngm:product-quantisation ;
    vc:isPartOf ngm:vector-database ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dense-retrieval,
        ngm:hybrid-search,
        ngm:large-language-model ;
    vc:requires ngm:embedding-model,
        ngm:embeddings,
        ngm:similarity-metric ;
    vc:slug "vector-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cosine-similarity,
        ngm:dot-product,
        ngm:locality-sensitive-hashing .

ngm:virtual-production-volume a owl:Class ;
    rdfs:label "Virtual Production Volume"@en ;
    rdfs:comment "Large-scale physical LED wall or projection stage environment that merges live-action footage with real-time rendered 3D backgrounds, including LED panels, tracking systems, camera infrastructure, and stage hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-tracking-system ],
        ngm:sc-display-and-rendering,
        ngm:virtual-production-pipeline ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:in-camera-vfx,
        ngm:interactive-filmmaking,
        ngm:real-time-rendering,
        ngm:virtual-location ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:camera-tracking-system,
        ngm:rendering-pipeline ;
    vc:isPartOf ngm:film-production,
        ngm:virtual-production-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:camera-tracking,
        ngm:network-infrastructure,
        ngm:real-time-rendering-engine ;
    vc:slug "virtual-production-volume" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-production-workflow a owl:Class ;
    rdfs:label "Virtual Production Workflow"@en ;
    rdfs:comment "The end-to-end process for creating film and television content using virtual production techniques, integrating pre-visualisation, virtual art department asset creation, real-time game engine rendering, LED volume shooting, and post-production refinement in a non-linear pipeline where VFX work begins in pre-production rather than post-production. This approach captures composited digital environments in-camera, enabling creative decisions about lighting and framing to be made on set."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:production-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:film-production,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse ;
    vc:requires ngm:3-d-asset,
        ngm:3-d-rendering-engine,
        ngm:game-engine ;
    vc:slug "virtual-production-workflow" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-production-workflow,
        ngm:design-software .

ngm:visual-inertial-odometry a owl:Class ;
    rdfs:label "Visual-Inertial Odometry"@en ;
    rdfs:comment "Visual-inertial odometry (VIO) is a technique that estimates a device's six-degree-of-freedom motion and pose by fusing camera imagery with inertial measurement unit data. The complementary fusion compensates for the drift of inertial sensors and the scale ambiguity of monocular vision, yielding robust, low-latency tracking. VIO underpins inside-out tracking for mixed-reality headsets, drones and mobile robots."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mixed-reality ;
    vc:slug "visual-inertial-odometry" ;
    vc:sourceDomain "robotics" .

ngm:volumetric-video a owl:Class ;
    rdfs:label "Volumetric Video"@en ;
    rdfs:comment "Volumetric video captures a subject from many viewpoints to reconstruct a moving three-dimensional representation that can be viewed from any angle, rather than a fixed two-dimensional image sequence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:photogrammetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-atlas ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:metaverse,
        ngm:spatial-audio ;
    vc:contrastsWith ngm:2d-video,
        ngm:360-video ;
    vc:dependsOn ngm:performance-capture,
        ngm:real-time-rendering ;
    vc:enables ngm:free-viewpoint-video,
