ngm:verification-report a owl:Class ;
    rdfs:label "VERIFICATION REPORT"@en ;
    rdfs:comment "A verification report is a structured document recording the outcomes of systematic assessment activities that confirm ontologies, knowledge graphs, and metaverse infrastructure meet specified quality standards and functional requirements. It captures defect categorisation, schema compliance checks, semantic consistency validation, RDF triple counts, OWL axiom correctness, and remediation progress to provide transparent evidence of production readiness."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
