ngm:operational-resilience a owl:Class ;
    rdfs:label "Operational Resilience"@en ;
    rdfs:comment "Operational Resilience is the organisational and technical capacity to anticipate, prepare for, withstand, recover from, and adapt to disruptions—whether caused by cyber-attacks, infrastructure failures, natural disasters, or human error—in a manner that maintains continuity of critical business services. It extends traditional business continuity and disaster recovery concepts by placing emphasis on setting impact tolerances for important business services and testing end-to-end resilience under realistic disruption scenarios. Operational resilience is increasingly mandated by financial regulators and embedded in frameworks such as the Bank of England's SS1/21 and the EU's Digital Operational Resilience Act (DORA)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-availability ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:resilience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:monitoring-dashboard,
        ngm:risk-assessment ;
    vc:requires ngm:fault-tolerance,
        ngm:high-availability ;
    vc:slug "operational-resilience" ;
    vc:sourceDomain "infrastructure" .

ngm:optimiser a owl:Class ;
    rdfs:label "Optimiser"@en ;
    rdfs:comment "An Optimiser is an algorithm that adjusts model parameters during training to minimise a loss function, guiding convergence towards an optimal solution. Modern optimisers such as Adam, RMSProp, and AdaGrad extend stochastic gradient descent with adaptive learning rates, momentum accumulation, and second-moment estimates, enabling faster and more stable training of deep neural networks across diverse tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:deep-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:hyperparameter,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:gradient-descent,
        ngm:loss-function ;
    vc:slug "optimiser" ;
    vc:sourceDomain "spatial-computing" .

ngm:owl-class-hierarchy a owl:Class ;
    rdfs:label "OWL Class Hierarchy"@en ;
    rdfs:comment "The taxonomic structure of classes and subclasses defined in the Web Ontology Language (OWL) that organizes concepts into inheritance relationships, enabling automated reasoning, consistency checking, and inference of implicit knowledge in semantic web applications."@en ;
