    vc:slug "data-augmentation-strategies" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:overfitting ;
    vc:uses ngm:generative-ai .

ngm:data-breach a owl:Class ;
    rdfs:label "Data Breach"@en ;
    rdfs:comment "A Data Breach is a security incident in which sensitive, protected, or confidential data is accessed, disclosed, copied, transmitted, or destroyed by an unauthorised actor, whether through external attack, insider threat, or accidental exposure. In AI contexts, data breaches can compromise training datasets, model weights, inference outputs, or user interaction logs, triggering GDPR notification obligations (within 72 hours to supervisory authorities), regulatory penalties, and reputational damage. AI systems increase both the attack surface (by aggregating and processing large personal-data collections) and the potential for novel breach vectors such as model-inversion attacks and membership-inference attacks that reconstruct or identify individuals from model outputs without direct database access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-inversion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:membership-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:ai-governance-and-ethics,
        ngm:risk ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:incident-response,
        ngm:privacy,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accidental-exposure,
        ngm:data-exfiltration,
        ngm:external-attack,
        ngm:insider-threat,
        ngm:membership-inference,
        ngm:model-inversion,
        ngm:ransomware ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:cybersecurity,
        ngm:data-protection,
        ngm:differential-privacy,
        ngm:encryption,
        ngm:federated-learning,
        ngm:gdpr,
        ngm:privacy-preserving-data-mining,
        ngm:regulatory-compliance,
        ngm:zero-trust-architecture ;
    vc:requires ngm:access-control,
        ngm:security,
        ngm:vulnerability ;
    vc:slug "data-breach" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:risk-assessment,
        ngm:risk-management,
        ngm:threat-intelligence ;
    vc:uses ngm:adversarial-attack,
        ngm:data-poisoning,
        ngm:membership-inference,
        ngm:model-extraction,
        ngm:model-inversion .

ngm:data-stewardship a owl:Class ;
    rdfs:label "Data Stewardship"@en ;
    rdfs:comment "Data stewardship is the operational accountability for managing an organisation's data assets across their lifecycle, ensuring they are accurate, well-documented, secure, and used in line with policy. Data stewards act as the human layer of data governance, owning definitions, resolving quality issues, and curating metadata and lineage. It bridges governance policy and day-to-day data practice, enabling trustworthy, reusable data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        ngm:data-governance ;
    vc:dependsOn ngm:data-catalog ;
    vc:enables ngm:data-quality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-steward ;
    vc:implements ngm:data-governance ;
    vc:isPartOf ngm:data-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:interoperability ;
    vc:requires ngm:data-quality,
        ngm:metadata-management ;
    vc:slug "data-stewardship" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:master-data-management ;
    vc:uses ngm:data-catalog,
        ngm:data-lineage .

ngm:decision-engine a owl:Class ;
    rdfs:label "Decision Engine"@en ;
    rdfs:comment "A decision engine is a software component that encapsulates decision logic—rules, models, policies, or heuristics—and evaluates inputs against that logic to produce actionable outputs such as approvals, classifications, recommendations, or routing choices. Decision engines decouple business logic from application code, enabling non-developers to modify decision policies without code deployments, and support auditability by providing traceable reasoning paths for each decision. They range from rule-based expert systems to ML model inference services to hybrid architectures combining both. The emergence of large language model reasoning cores has extended the decision engine concept to unstructured input spaces, enabling complex multi-step decisioning with natural language explanation traces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:automated-reasoning,
        ngm:inference-engine ;
    vc:enables ngm:automated-decision-making,
        ngm:automated-planning,
        ngm:credit-scoring,
        ngm:decision-support,
        ngm:fraud-detection,
        ngm:informed-decision-making,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:decision-model-notation,
        ngm:explanation-module,
        ngm:feature-engineering-pipeline,
        ngm:model-scorer,
        ngm:rule-evaluator ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:decision-transparency,
        ngm:explainable-ai,
        ngm:fairness,
        ngm:model-risk-management,
        ngm:orchestration,
        ngm:regulation ;
    vc:slug "decision-engine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:automated-reasoning,
        ngm:bayesian-inference,
        ngm:chain-of-thought,
        ngm:knowledge-representation,
        ngm:policy-engine,
        ngm:probabilistic-reasoning .

ngm:deep-speed a owl:Class ;
    rdfs:label "DeepSpeed"@en ;
    rdfs:comment "DeepSpeed is an open-source deep learning optimisation library developed by Microsoft Research that enables training and inference of extremely large neural network models through ZeRO (Zero Redundancy Optimizer) memory partitioning, pipeline parallelism, and mixed-precision arithmetic. It reduces the per-device memory footprint of model states by partitioning optimiser states, gradients, and parameters across data-parallel devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pipeline-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        ngm:distributed-training ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:infrastructure ;
    vc:contrastsWith ngm:megatron-lm ;
    vc:dependsOn ngm:message-passing-interface,
        ngm:python-pytorch-deep-learning-stack ;
    vc:enables ngm:inference,
        ngm:large-language-model-training,
        ngm:model-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:pipeline-parallelism,
        ngm:sparse-attention,
        ngm:tensor-parallelism ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:data-parallelism,
        ngm:hugging-face-accelerate,
        ngm:model-quantization ;
    vc:requires ngm:gpu-cluster,
        ngm:high-performance-computing ;
    vc:slug "deep-speed" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cuda,
        ngm:gradient-checkpointing,
        ngm:mixed-precision-training,
        ngm:transformer-architecture .

ngm:defense-in-depth a owl:Class ;
    rdfs:label "Defense In Depth"@en ;
    rdfs:comment "Defense in depth is a security strategy that layers multiple, independent controls across an environment so that the failure or bypass of any single control does not lead to compromise. Adapted from military doctrine, it spans physical, network, host, application, and data layers, combining preventive, detective, and responsive measures to slow attackers, increase the cost of intrusion, and provide redundancy. It assumes no control is infallible and complements modern paradigms such as zero trust by ensuring that defences are distributed rather than concentrated at a single perimeter."@en ;
    rdfs:subClassOf ngm:security-architecture ;
    vc:contrastsWith ngm:perimeter-security ;
    vc:enables ngm:risk-mitigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:risk-mitigation ;
    vc:isPartOf ngm:security-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:cybersecurity,
        ngm:network-security ;
    vc:requires ngm:intrusion-detection ;
    vc:slug "defense-in-depth" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:endpoint-security,
        ngm:network-security ;
    vc:uses ngm:access-control,
        ngm:encryption,
        ngm:firewall .

ngm:delegation a owl:Class ;
    rdfs:label "Delegation"@en ;
    rdfs:comment "Delegation in blockchain systems is the act of assigning one's stake or voting rights to another participant who acts on one's behalf in consensus or governance, without transferring ownership of the underlying assets. In proof-of-stake networks token holders delegate stake to validators, sharing in rewards and slashing risk while the validator performs block production. In on-chain governance, delegation lets holders entrust their votes to representatives, a pattern formalised as liquid democracy. Delegation lowers the participation barrier for ordinary holders and concentrates operational responsibility with capable operators, while introducing trust and centralisation trade-offs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
        ngm:proof-of-stake ;
    vc:contrastsWith ngm:slashing ;
    vc:dependsOn ngm:trust,
        ngm:validator ;
    vc:enables ngm:liquid-democracy,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:reward-distribution,
        ngm:staking ;
    vc:implements ngm:delegated-proof-of-stake ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:reward-distribution ;
    vc:requires ngm:staking,
        ngm:validator ;
    vc:slug "delegation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:consensus,
        ngm:dao ;
    vc:uses ngm:proof-of-stake .

ngm:delegation-system a owl:Class ;
    rdfs:label "Delegation System"@en ;
    rdfs:comment "A delegation system is the governance mechanism by which stakeholders entrust their decision-making or voting power to chosen representatives. In decentralized governance it supports liquid democracy, where delegated authority can be reassigned or revoked at any time, scaling participation without requiring every holder to vote directly. It balances broad legitimacy with the expertise and availability of active delegates."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:tokenomics-governance ;
    vc:slug "delegation-system" ;
    vc:sourceDomain "governance" .

ngm:depth-map a owl:Class ;
    rdfs:label "Depth Map"@en ;
    rdfs:comment "A depth map is a per-pixel image in which each value encodes the distance from the camera to the corresponding point in the scene rather than its colour. It provides the 2.5D geometric structure needed to reconstruct surfaces, segment foreground from background and place virtual content in spatial computing. Depth maps are produced by stereo matching, structured light, time-of-flight sensing or learned monocular estimation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensing ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:computer-graphics ;
    vc:enables ngm:point-cloud,
        ngm:volumetric-video ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:point-cloud ;
    vc:isPartOf ngm:computer-vision ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:stereo-vision,
        ngm:volumetric-video ;
    vc:requires ngm:depth-sensing ;
    vc:slug "depth-map" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-computing ;
    vc:uses ngm:lidar,
        ngm:stereo-vision,
        ngm:structured-light .

ngm:determinism a owl:Class ;
    rdfs:label "Determinism"@en ;
    rdfs:comment "Determinism, in computing and distributed systems, is the property by which a computational process produces identical outputs given identical inputs and initial state, regardless of when, where, or how many times it is executed. Deterministic systems are essential for reproducibility of scientific experiments, predictability of embedded and safety-critical control systems, and correctness of distributed consensus protocols where all participating nodes must reach the same conclusion from the same inputs. In the context of blockchain and smart contracts, determinism is a hard requirement because non-deterministic execution would cause different nodes to compute different state transitions, breaking consensus."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:contrastsWith ngm:probabilistic-model,
        ngm:stochastic-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:formal-verification,
        ngm:random-number-generation,
        ngm:state-machine-replication ;
    vc:slug "determinism" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:automated-reasoning,
        ngm:blockchain,
        ngm:cyber-physical-systems .

ngm:diagrams-as-code a owl:Class ;
    rdfs:label "Diagrams as Code"@en ;
    rdfs:comment "Diagrams as Code (DaC) is a software-engineering discipline and tooling category in which technical diagrams (architecture, sequence, state, deployment, entity-relationship, Gantt, wireframe, timing, dataflow) are authored as plain-text source artefacts in a constrained, machine-readable grammar ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markdown ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:renderer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layout-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:layout-algorithm ],
        ngm:documentation-as-code,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:c4-model,
        ngm:code-review,
        ngm:continuous-integration,
        ngm:runbook ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:layout-engine,
        ngm:renderer ;
    vc:implements ngm:markdown-diagramming-as-code-tool,
        ngm:structurizr-dsl ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-diagram-tools,
        ngm:c4-model,
        ngm:documentation-as-code,
        ngm:excalidraw,
        ngm:logseq,
        ngm:notion ;
    vc:requires ngm:layout-algorithm,
        ngm:markdown,
        ngm:version-control ;
    vc:slug "diagrams-as-code" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:markdown-diagramming-as-code-tool,
        ngm:object-management-group,
        ngm:w3-c ;
    vc:supports ngm:mind-map ;
    vc:uses ngm:json-data-interchange-format-schema,
        ngm:open-api-specification .

ngm:differentiable-architecture a owl:Class ;
    rdfs:label "Differentiable Architecture"@en ;
    rdfs:comment "Differentiable Architecture refers to a neural network design paradigm, most prominently realised in Differentiable Architecture Search (DARTS), in which discrete structural choices — such as which operation to place at each edge of a candidate graph or how to connect layers — are relaxed to continuous mixture weights over a predefined set of operations. This relaxation renders the architecture selection problem differentiable, allowing the architecture parameters to be optimised jointly with network weights via gradient descent on a validation loss. Once optimised, the continuous mixture is discretised to yield a final architecture, dramatically reducing the computational cost of neural architecture search compared to evolutionary or reinforcement learning methods."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:hyperparameter,
        ngm:knowledge-distillation ;
    vc:slug "differentiable-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network-architecture .

ngm:digital-identity-standards a owl:Class ;
    rdfs:label "Digital Identity Standards"@en ;
    rdfs:comment "The technical specifications, protocols, and frameworks established by standards bodies such as W3C and ISO that define interoperable formats for digital identifiers, verifiable credentials, and authentication mechanisms enabling secure identity management across metaverse platforms and decentralized systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        [ a owl:Restriction ;
