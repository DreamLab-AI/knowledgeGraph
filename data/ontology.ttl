    rdfs:label "Vector Graphics Editor"@en .
ngm:vector-index a owl:Class ;
    rdfs:comment "A vector index is a data structure that organises high-dimensional embedding vectors to enable fast approximate nearest-neighbour search over large collections. Using methods such as HNSW graphs, IVF partitioning or product quantisation, it trades a small amount of recall for large gains in query latency and scalability. Vector indexes are the retrieval engine behind semantic search and retrieval-augmented generation."@en ;
    rdfs:label "Vector Index"@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag ;
    vc:relatedTo ngm:semantic-search ;
    vc:slug "vector-index" ;
    vc:sourceDomain "ai" .
