    vc:slug "environmental-standards" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-standards ;
    vc:supports ngm:circular-economy,
        ngm:environmental-sustainability .

ngm:equitable-access a owl:Class ;
    rdfs:label "Equitable Access"@en ;
    rdfs:comment "Equitable access is the principle and practice of ensuring that all people, regardless of ability, income, geography, or background, can reach and use a resource, service, or technology on fair terms. It goes beyond equal access by actively removing barriers and providing accommodations so that disadvantaged groups achieve comparable outcomes. In technology it is closely tied to accessibility standards and inclusive design."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:accessibility-standard ;
    vc:slug "equitable-access" ;
    vc:sourceDomain "governance" .

ngm:erc-4337 a owl:Class ;
    rdfs:label "ERC-4337"@en ;
    rdfs:comment "ERC-4337 is an Ethereum Request for Comment specifying an account abstraction standard that enables smart contract accounts to function as first-class transaction originators without requiring changes to the Ethereum consensus protocol. It introduces a separate transaction processing pipeline — the user operation mempool — in which bundlers aggregate user operations (UserOps), simulate them for validity, and submit them as bundled transactions to the EntryPoint smart contract, which validates and executes them on behalf of the respective smart contract wallets. Paymasters, a complementary component, allow third parties to sponsor gas fees, enabling gasless transactions and alternative fee payment tokens."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        ngm:account-abstraction ;
    vc:bridgesTo ngm:passkey-authentication ;
    vc:contrastsWith ngm:externally-owned-account ;
    vc:enables ngm:digital-wallet,
        ngm:gasless-transaction,
        ngm:multi-signature-wallet,
        ngm:session-key,
        ngm:social-recovery,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bundler ;
    vc:implements ngm:ethereum-improvement-proposal ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:eip-7702,
        ngm:ethereum-smart-contract-platform,
        ngm:layer-2-scaling,
        ngm:smart-contract-execution,
        ngm:transaction-standard ;
    vc:requires ngm:gas,
        ngm:mempool,
        ngm:smart-contract ;
    vc:slug "erc-4337" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ecdsa,
        ngm:evm,
        ngm:gas-optimization .

ngm:erc-721-standard a owl:Class ;
    rdfs:label "ERC-721 Standard"@en ;
    rdfs:comment "ERC-721 is an Ethereum token standard defining a minimal interface for non-fungible tokens (NFTs), where each token carries a unique identifier that distinguishes it from every other token in the same contract. It specifies ownership tracking, safe transfer functions, and an optional metadata extension for associating URIs with token properties."@en ;
    rdfs:subClassOf ngm:nft-standard ;
    vc:contrastsWith ngm:erc20-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-1155,
        ngm:ethereum-smart-contract-platform,
        ngm:nft ;
    vc:slug "erc-721-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ipfs .

ngm:esma a owl:Class ;
    rdfs:label "ESMA"@en ;
    rdfs:comment "The European Securities and Markets Authority (ESMA) is the European Union's independent financial regulator responsible for safeguarding the stability and integrity of EU securities markets. It develops technical standards, supervises certain market participants such as credit-rating agencies, and coordinates national regulators to ensure consistent application of EU financial law. ESMA plays a central role in regimes such as MiCA for crypto-assets and in securities and regulatory-reporting rules."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting,
        ngm:securities-regulation ;
    vc:slug "esma" ;
    vc:sourceDomain "governance" .

ngm:eu-ai-act-regulatory-instrument-article-50 a owl:Class ;
    rdfs:label "EU AI Act Article 50"@en ;
    rdfs:comment "EU AI Act Article 50 establishes transparency obligations that apply to providers and deployers of specific categories of AI system within the European Union's Artificial Intelligence Act regulatory framework. The article requires that AI systems designed to interact with natural persons, or that generate synthetic audio, image, video, or text content, must disclose their AI nature to affected individuals. Providers of deep fake content generation tools are required to label outputs in machine-readable form, and broadcast media and online platforms carrying synthetic media must carry appropriate disclosures. The article represents the EU's approach to mandating content authentication and countering AI-generated deception at scale."@en ;
    rdfs:subClassOf ngm:eu-ai-act-regulatory-instrument ;
    vc:contrastsWith ngm:high-risk-ai-system,
        ngm:prohibited-ai-practice ;
    vc:enables ngm:compliance-framework,
        ngm:content-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-generated-content-disclosure,
        ngm:ai-transparency-framework,
        ngm:deepfakes ;
    vc:slug "eu-ai-act-article-50" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:conformity-assessment .

ngm:eudi-wallet a owl:Class ;
    rdfs:label "EUDI Wallet"@en ;
    rdfs:comment "The EUDI Wallet (European Digital Identity Wallet) is a mobile application framework mandated under the revised eIDAS regulation, enabling European citizens and residents to store, present, and selectively disclose identity attributes and credentials across member states. It allows holders to prove identity, sign documents, and share verifiable attestations with public and private services while retaining control over what data is revealed. The wallet is the user-facing instrument of the EU's interoperable cross-border identity scheme."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-framework ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:digital-identity-wallet,
        ngm:verifiable-credentials ;
    vc:dependsOn ngm:e-idas ;
    vc:enables ngm:authentication,
        ngm:identity-verification,
        ngm:selective-disclosure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:verifiable-credentials ;
    vc:isPartOf ngm:digital-identity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-wallet,
        ngm:gdpr ;
    vc:requires ngm:trust-framework ;
    vc:slug "eudi-wallet" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:e-idas ;
    vc:supports ngm:digital-identity,
        ngm:privacy ;
    vc:uses ngm:decentralized-identifier,
        ngm:zero-knowledge-proof .

ngm:exchange-mechanism a owl:Class ;
    rdfs:label "Exchange Mechanism"@en ;
    rdfs:comment "An Exchange Mechanism is a protocol or technical construct that governs the transfer of digital assets, tokens, or value between parties within a virtual economy or cross-platform environment. Exchange mechanisms specify the rules for matching buyers and sellers, executing atomic swaps, handling liquidity, and settling transactions, forming the economic infrastructure of metaverse marketplaces."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-asset-trading,
        ngm:marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:liquidity-pool,
        ngm:token-economics ;
    vc:slug "exchange-mechanism" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:existential-ai-risk a owl:Class ;
    rdfs:label "Existential AI Risk"@en ;
    rdfs:comment "Existential AI risk is the class of scenarios in which advanced artificial intelligence systems could cause human extinction or permanently and drastically curtail humanity's long-term potential, in ways that are irreversible at civilisational scale. These risks arise from misalignment between AI objectives and human values, from insufficient human oversight of increasingly capable systems, or from deliberate misuse enabling catastrophic outcomes. The concept motivates foundational research in AI alignment, corrigibility, and interpretability, as well as international governance frameworks aimed at preventing unrecoverable failure modes. It is distinguished from near-term harms by its emphasis on trajectories toward transformative, hard-to-reverse states rather than localised or recoverable damage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:existential-risk ;
    vc:bridgesTo ngm:biosecurity,
        ngm:compute-governance,
        ngm:international-treaty,
        ngm:nuclear-risk ;
    vc:contrastsWith ngm:ai-bias ;
    vc:dependsOn ngm:capability-overhang,
        ngm:instrumental-convergence,
        ngm:transformative-ai ;
    vc:enables ngm:ai-safety-research,
        ngm:frontier-model-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-safety,
        ngm:global-catastrophic-risk ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:corrigibility,
        ngm:mesa-optimisation,
        ngm:reward-hacking,
        ngm:superintelligence,
        ngm:value-alignment ;
    vc:requires ngm:ai-alignment,
        ngm:ai-governance,
        ngm:interpretability ;
    vc:slug "existential-ai-risk" ;
    vc:sourceDomain "ai" .

ngm:experiment-tracking a skos:Concept ;
    rdfs:label "Experiment Tracking"@en .

ngm:extended-producer-responsibility a owl:Class ;
    rdfs:label "Extended Producer Responsibility"@en ;
    rdfs:comment "Extended Producer Responsibility (EPR) is an environmental policy principle that makes manufacturers financially and operationally responsible for the entire lifecycle of their products, especially the take-back, recycling, and final disposal stages. By internalising end-of-life costs, EPR incentivises producers to design for durability, repairability, and recyclability. It is implemented through schemes such as packaging levies, electronic-waste recovery obligations, and deposit-return systems."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:sustainability ;
    vc:slug "extended-producer-responsibility" ;
    vc:sourceDomain "governance" .

ngm:failover a skos:Concept ;
    rdfs:label "Failover"@en .

ngm:fairness-assessment a owl:Class ;
    rdfs:label "Fairness Assessment"@en ;
    rdfs:comment "Fairness assessment is the systematic evaluation of whether an AI or machine-learning system produces equitable outcomes across protected groups and individuals. It quantifies disparities using metrics such as demographic parity, equalised odds, and predictive parity, often computed from confusion-matrix statistics segmented by subgroup. The results inform mitigation, auditing, and governance decisions about model deployment."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:confusion-matrix ;
    vc:slug "fairness-assessment" ;
    vc:sourceDomain "governance" .

ngm:false-negative a owl:Class ;
    rdfs:label "False Negative"@en ;
    rdfs:comment "A false negative is a classification error in which a model incorrectly predicts the negative class for an instance that actually belongs to the positive class. It is a fundamental cell of the confusion matrix, often denoted FN, and directly reduces recall (sensitivity). In high-stakes domains such as medical screening or fraud detection, false negatives represent missed true cases and frequently carry asymmetric cost relative to false positives."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:contrastsWith ngm:false-positive,
        ngm:true-negative,
        ngm:true-positive ;
    vc:enables ngm:specificity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:confusion-matrix,
        ngm:model-evaluation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:classification,
        ngm:f1-score,
        ngm:precision,
        ngm:recall,
        ngm:sensitivity ;
    vc:slug "false-negative" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:anomaly-detection,
        ngm:fraud-detection ;
    vc:uses ngm:loss-function .

ngm:fatf-recommendations a owl:Class ;
    rdfs:label "FATF Recommendations"@en ;
    rdfs:comment "The FATF Recommendations are international standards on combating money laundering, terrorist financing and proliferation financing issued by the Financial Action Task Force."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-frameworks ],
        ngm:anti-money-laundering ;
    vc:enables ngm:travel-rule ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-frameworks ;
    vc:slug "fatf-recommendations" ;
    vc:sourceDomain "governance" .

ngm:fault-tolerance-system a owl:Class ;
    rdfs:label "Fault Tolerance System"@en ;
    rdfs:comment "A Fault Tolerance System is an engineering design framework enabling a distributed system to continue correct operation despite component failures, network disruptions, or malicious behaviour by a subset of participants. These systems employ redundancy, error detection, and automatic recovery to mask failures from end users, with Byzantine fault tolerance being the gold standard for adversarial environments such as public blockchains, which require at least 3f+1 total nodes to tolerate f Byzantine failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:replication-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
