ngm:3-d-generation a owl:Class ;
    rdfs:label "3D Generation"@en ;
    rdfs:comment "3D Generation refers to the automated or semi-automated creation of three-dimensional geometry, appearance, and scene representations using machine learning models, procedural algorithms, or hybrid approaches. Techniques include text-to-3D, image-to-3D, and scene-level generation via neural radiance fields, Gaussian splatting, diffusion models, and large multi-modal networks. The field aims to dramatically reduce the time and skill threshold required to produce photorealistic or stylised 3D content."@en ;
    rdfs:subClassOf ngm:3-d-content-generation ;
    vc:enables ngm:3-d-content-creation,
        ngm:digital-twin-generation,
        ngm:game-asset-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-reconstruction,
        ngm:neural-3-d-generation,
        ngm:text-to-3-d ;
    vc:slug "3-d-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-model,
        ngm:gaussian-splatting,
        ngm:ne-rf .

ngm:5g a skos:Concept ;
