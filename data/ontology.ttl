    rdfs:subClassOf spatial-computing:VirtualEnvironment ;
    rdfs:label "Virtual Destination"@en ;
    rdfs:comment "A digital location or space within virtual environments that serves as a point of interest or travel objective, including virtual recreations of real-world landmarks, fantasy worlds, themed experiences, and interactive attractions accessible through metaverse platforms."@en ;
