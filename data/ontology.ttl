        ngm:attention-mechanism,
        ngm:graph-neural-network .

ngm:self-attention a owl:Class ;
    rdfs:label "Self Attention"@en ;
    rdfs:comment "An attention mechanism where every token in a sequence attends to every other token in the same sequence, computing query-key compatibility scores to produce context-aware weighted value representations that capture intra-sequence dependencies without recurrence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scaled-dot-product-attention ],
        ngm:attention-mechanism ;
    vc:bridgesTo ngm:bioinformatics,
        ngm:computer-vision ;
    vc:contrastsWith ngm:cross-attention,
        ngm:recurrent-neural-network,
        ngm:state-space-model ;
    vc:dependsOn ngm:matrix-multiplication,
        ngm:softmax-function ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:sequence-to-sequence-learning,
        ngm:vision-transformer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:query-key-value-projection,
        ngm:scaled-dot-product-attention ;
    vc:implements ngm:attention-mechanism ;
    vc:isPartOf ngm:multi-head-attention,
        ngm:transformer ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:graph-attention-network,
        ngm:reinforcement-learning ;
    vc:requires ngm:input-embeddings,
        ngm:positional-encoding ;
    vc:slug "self-attention" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:long-range-dependency-modelling,
        ngm:parallel-computation ;
    vc:uses ngm:feed-forward-neural-network,
        ngm:weight-matrix .

ngm:self-custody a owl:Class ;
    rdfs:label "Self-Custody"@en ;
    rdfs:comment "Self-custody is the security model and operational practice whereby an individual or entity retains exclusive, unmediated control of the private cryptographic keys that authorise transactions over their digital assets, entirely without delegating that custody to a centralised exchange, broker, or financial institution. The axiom underpinning self-custody — 'not your keys, not your coins' — reflects the fact that whoever controls the private key controls the asset on-chain; counterparty risk from exchange insolvency, fraud, or regulatory asset freezes is therefore eliminated, but operational responsibility for key generation, backup, and signing security is transferred fully to the key holder. Self-custody is realised through software wallets (hot wallets), dedicated hardware security devices (cold wallets), multi-signature threshold schemes that distribute key material across several signatories, and advanced constructions such as threshold signature schemes (TSS) and social recovery wallets. Loss or compromise of the controlling private key or seed phrase results in permanent, irrecoverable loss of the associated assets with no recourse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:key-management ;
    vc:bridgesTo ngm:self-sovereign-identity,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:custodial-exchange,
        ngm:qualified-custodian,
        ngm:third-party-custody ;
    vc:enables ngm:censorship-resistance,
        ngm:decentralised-finance,
        ngm:financial-sovereignty ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:air-gap,
        ngm:bitcoin,
        ngm:decentralised-identity,
        ngm:digital-asset,
        ngm:social-recovery-wallet ;
    vc:requires ngm:private-key,
        ngm:secure-random-number-generation,
        ngm:seed-phrase ;
    vc:slug "self-custody" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptography,
        ngm:hardware-wallet,
        ngm:hierarchical-deterministic-wallet,
        ngm:multi-signature,
        ngm:threshold-signature-scheme,
        ngm:wallet .

ngm:single-sign-on a owl:Class ;
    rdfs:label "Single Sign-On"@en ;
    rdfs:comment "Single Sign-On (SSO) is an authentication architecture in which a user authenticates once to a central Identity Provider (IdP) and receives a cryptographically signed assertion or token that grants access to multiple independent service providers without re-entering credentials. Dominant protocol implementations include SAML 2.0 (XML-based assertions), OpenID Connect layered over OAuth 2.0 (JSON Web Token–based), and Kerberos (ticket-granting ticket mechanism in Windows/Active Directory environments). SSO reduces credential exposure and attack surface by centralising authentication at a hardened IdP, simplifies user lifecycle management across enterprise systems, and is the cornerstone of modern Identity and Access Management platforms encompassing provisioning, deprovisioning, and audit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        ngm:authentication ;
    vc:bridgesTo ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:decentralised-identity,
        ngm:password-manager ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management,
        ngm:federated-identity,
        ngm:zero-trust-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:kerberos,
        ngm:oauth2,
        ngm:openid-connect,
        ngm:saml ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:directory-services,
        ngm:federated-credential-exchange,
        ngm:identity-and-access-management ;
    vc:requires ngm:digital-certificate,
        ngm:identity-provider,
        ngm:public-key-infrastructure,
        ngm:trust-framework ;
    vc:slug "single-sign-on" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:audit-logging,
        ngm:role-based-access-control,
        ngm:user-provisioning ;
    vc:uses ngm:json-web-token,
        ngm:multi-factor-authentication,
        ngm:session-management .

ngm:staking a owl:Class ;
    rdfs:label "Staking"@en ;
    rdfs:comment "The act of locking cryptocurrency as a stake to participate in a proof-of-stake network's validation process, earning rewards and risking penalties for misbehaviour. The staked amount aligns a validator's incentives with the network's correct operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:native-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slashing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
