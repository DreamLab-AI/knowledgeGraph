    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-7012" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Asset Management
infrastructure:AssetManagement rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:FinancialServices ;
    rdfs:label "Asset Management"@en ;
    rdfs:comment "The professional management of digital and traditional assets through strategies including portfolio construction, risk management, custody, and performance optimization. In the context of fintech and DeFi, asset management encompasses crypto portfolio management, tokenized securities, yield optimization, and institutional-grade custody solutions that enable investors to navigate volatile digital markets while maximizing risk-adjusted returns."@en ;
    skos:prefLabel "Asset Management"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:asset-management" ;
