# Hardware Platform Agnostic
mv:HardwarePlatformAgnostic a owl:Class ;
    rdfs:label "Hardware Platform Agnostic"@en ;
    rdfs:comment "A design principle and architectural quality ensuring that software, systems, or protocols can operate independently of specific hardware architectures or platform implementations. Hardware-/Platform-Agnostic systems achieve portability through abstraction layers that decouple functionality from underlying physical or operating system constraints."@en ;
    skos:prefLabel "Hardware Platform Agnostic"@en ;
    dcterms:identifier "20320" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Interoperability
mv:Interoperability a owl:Class ;
    rdfs:label "Interoperability"@en ;
    rdfs:comment "The capability of distinct systems, applications, or organizational entities to exchange information, interpret shared data correctly, and utilize exchanged information for coordinated operations. Interoperability encompasses technical protocol compatibility, semantic data alignment, and organizational process integration across heterogeneous environments."@en ;
    skos:prefLabel "Interoperability"@en ;
    dcterms:identifier "20321" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Ownership Freedom distributed
mv:OwnershipFreedomdistributed a owl:Class ;
    rdfs:label "Ownership Freedom distributed"@en ;
    rdfs:comment "A socio-technical paradigm establishing user sovereignty through decentralized control mechanisms, cryptographic ownership proofs, and distributed governance models. Distributed ownership and freedom principles ensure individuals retain control over digital assets, personal data, and participation rights without reliance on centralized authorities or intermediaries."@en ;
    skos:prefLabel "Ownership Freedom distributed"@en ;
    dcterms:identifier "20322" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

