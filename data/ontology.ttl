            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-market-maker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:bc-defi-and-economics,
        ngm:smart-contract ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:decentralized-trading,
        ngm:liquidity-provision,
        ngm:price-discovery,
        ngm:token-swapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:price-oracle,
