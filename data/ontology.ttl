ngm:hnsw-index a owl:Class ;
    rdfs:label "HNSW Index"@en ;
    rdfs:comment "An HNSW (Hierarchical Navigable Small World) index is a graph-based data structure for approximate nearest-neighbour search over high-dimensional vectors. It builds a multi-layer proximity graph where greedy traversal from a sparse top layer down to a dense base layer locates close vectors in logarithmic time. HNSW is the standard index backing vector databases and semantic search at scale."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:semantic-search,
        ngm:storage-infrastructure ;
    vc:slug "hnsw-index" ;
    vc:sourceDomain "data" .

ngm:holographic-display a owl:Class ;
    rdfs:label "Holographic Display"@en ;
    rdfs:comment "A holographic display is a display system that reconstructs the full optical wavefront of a three-dimensional scene, enabling viewers to perceive genuine depth cues — including motion parallax, focus accommodation, and binocular disparity — without wearing specialised eyewear. It achieves this by encoding scenes as holograms (interference fringe patterns) and illuminating them with coherent or structured light to recreate the original light field. Unlike stereoscopic or autostereoscopic displays, holographic displays avoid the vergence-accommodation conflict because the eye can naturally refocus at different depths within the reconstructed scene. Practical implementations typically use spatial light modulators, diffractive optical elements, or photopolymer recording media to shape wavefronts, placing extreme demands on computational throughput and optical bandwidth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:holography ],
        ngm:display-technology ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:autostereoscopic-display,
        ngm:flat-panel-display,
        ngm:stereoscopic-display ;
    vc:dependsOn ngm:photonics,
        ngm:real-time-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing,
        ngm:telepresence,
        ngm:volumetric-display ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:diffractive-optical-element,
        ngm:hologram-rendering-pipeline,
        ngm:wavefront-reconstruction ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:head-mounted-display,
        ngm:mixed-reality,
        ngm:optical-see-through ;
    vc:requires ngm:coherent-light-source,
        ngm:computer-generated-holography,
        ngm:holography,
        ngm:spatial-light-modulator ;
    vc:slug "holographic-display" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:diffraction,
        ngm:gpu-compute,
        ngm:interference,
        ngm:light-field .

ngm:holography a owl:Class ;
    rdfs:label "Holography"@en ;
    rdfs:comment "A technique for recording and reconstructing the full wavefront of light, including both amplitude and phase, to reproduce three-dimensional images. It records the interference pattern between a reference beam and light scattered from an object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
