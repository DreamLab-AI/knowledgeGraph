    vc:enables ngm:community-governance,
        ngm:creator-monetization,
        ngm:fan-engagement,
        ngm:value-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:community-token,
        ngm:creator-token,
        ngm:governance-rights,
        ngm:reputation-system ;
    vc:isPartOf ngm:token-economy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:smart-contract-platform,
        ngm:token-standard ;
    vc:slug "social-token-economy" ;
    vc:sourceDomain "spatial-computing" .

ngm:sociotechnical-risk a owl:Class ;
    rdfs:label "Sociotechnical Risk"@en ;
    rdfs:comment "Sociotechnical risk is the potential for harm arising from the interaction between a technical system and the social context in which it is built and used. In AI it covers harms that emerge from people, institutions and technology together rather than from code alone."@en ;
    rdfs:subClassOf ngm:ai-risk ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "sociotechnical-risk" ;
    vc:sourceDomain "ai-safety" .

ngm:soft-body-dynamics a owl:Class ;
    rdfs:label "Soft Body Dynamics"@en ;
    rdfs:comment "Soft Body Dynamics is the branch of physics simulation concerned with deformable objects — including cloth, flesh, elastic materials, vegetation, and fluids — that change shape in response to forces, collisions, and internal stresses. Unlike rigid body simulation, soft body methods must track per-vertex or per-element deformation states, typically using mass-spring networks, finite element methods (FEM), or position-based dynamics (PBD). It is essential for visual fidelity in real-time virtual environments, character animation, and embodied AI simulations."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-animation,
        ngm:embodied-ai-simulation,
        ngm:game-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:dynamic-character-animation,
        ngm:fluid-simulation,
        ngm:real-time-rendering,
        ngm:rigid-body-dynamics ;
    vc:slug "soft-body-dynamics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute,
        ngm:physics-engine .

ngm:soft-prompt-embedding a owl:Class ;
    rdfs:label "Soft Prompt Embedding"@en ;
    rdfs:comment "Soft Prompt Embedding is a parameter-efficient fine-tuning technique in which a small set of continuous, learnable token vectors (soft prompts) are prepended to the model's input embedding sequence and optimised via gradient descent, conditioning a frozen large language model's behaviour without modifying its weights. Unlike discrete (hard) prompts composed of natural-language tokens, soft prompt embeddings exist solely in the continuous embedding space and have no direct human-interpretable form. This approach enables task-specific adaptation of large models at a fraction of the computational and storage cost of full fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:instruction-following ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:model-parameters ;
    vc:enables ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:parameter,
        ngm:token-embedding ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:prompt-engineering,
        ngm:prompt-tuning ;
    vc:requires ngm:embedding-model,
        ngm:large-language-models ;
    vc:slug "soft-prompt-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:software-engineering-agents a owl:Class ;
    rdfs:label "Software Engineering Agents"@en ;
    rdfs:comment "Software engineering agents are autonomous or semi-autonomous AI systems built on large language models that perform software development tasks — reading and editing codebases, running tests, debugging, and opening pull requests — by planning multi-step actions and invoking developer tools. They operate over real repositories using file navigation, shell execution, and version-control integration, and are evaluated on benchmarks such as SWE-bench that measure the rate at which they resolve genuine GitHub issues. They represent the application of agentic reasoning to the specific domain of writing and maintaining code."@en ;
    rdfs:subClassOf ngm:llm-agents ;
    vc:enables ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:llm-application-framework,
        ngm:llm-orchestration ;
    vc:slug "software-engineering-agents" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:reasoning .

ngm:software-engineering-domain a owl:Class ;
    rdfs:label "Software Engineering Domain"@en ;
    rdfs:comment "The Software Engineering Domain classifies concepts concerning the systematic development, maintenance and evolution of software systems. It covers requirements, design, construction, testing and the processes that coordinate these activities. As a top-level subject axis it provides the disciplined methods by which other domains are realised as reliable, maintainable software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-methods-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:version-control ],
        ngm:owl-thing ;
    vc:enables ngm:maintainable-systems,
        ngm:reproducible-builds ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:continuous-integration,
        ngm:requirements-engineering,
        ngm:software-architecture,
        ngm:testing,
        ngm:version-control ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:formal-methods-domain ;
    vc:slug "software-engineering-domain" ;
    vc:sourceDomain "software-engineering" .

ngm:solid-oidc a owl:Class ;
    rdfs:label "Solid-OIDC"@en ;
    rdfs:comment "Solid-OIDC is the authentication specification for the Solid ecosystem, extending OpenID Connect with decentralised identity so a user authenticates with their own WebID and identity provider rather than a centralised platform. It issues DPoP-bound access tokens that resource servers (Solid Pods) verify, enabling a user to control which applications access their personal data store. It is the identity layer that makes Solid's separation of identity, data, and application possible."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:solid ;
    vc:slug "solid-oidc" ;
    vc:sourceDomain "data" .

ngm:soon-next-later-ai-futurology a owl:Class ;
    rdfs:label "Soon-Next-Later (AI futurology)"@en ;
    rdfs:comment "Soon-Next-Later is a structured futurology framework for categorising AI capability developments across three temporal horizons: Soon (0–5 years, capabilities already emerging in products), Next (5–10 years, capabilities requiring current research to mature), and Later (10+ years, speculative capabilities dependent on fundamental advances). The framework provides practitioners with a tractable planning scaffold that avoids both near-term over-hype and long-horizon dismissiveness."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:sovereign-ai-bid ;
    vc:enables ngm:ai-governance,
        ngm:ai-policy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:sam-hammond,
        ngm:social-contract ;
    vc:slug "soon-next-later-ai-futurology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:ai-risk .

ngm:soulbound-tokens a owl:Class ;
    rdfs:label "Soulbound Tokens"@en ;
    rdfs:comment "Non-transferable tokens bound to a single account that represent credentials, affiliations or reputation rather than tradable value. Because they cannot be sold or moved, they encode persistent attributes of an identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:decentralized-identity ;
    vc:enables ngm:sybil-resistance,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:token-standard ;
    vc:slug "soulbound-tokens" ;
    vc:sourceDomain "blockchain" .

ngm:sparse-autoencoders a owl:Class ;
    rdfs:label "Sparse Autoencoders"@en ;
    rdfs:comment "Sparse autoencoders are neural networks trained to reconstruct their input through a wide hidden layer subject to a sparsity penalty, so that only a small number of latent units activate for any given input. In mechanistic interpretability they are applied to the activations of large language models to decompose dense, polysemantic representations into more monosemantic, human-interpretable features. They have become a leading tool for understanding what concepts a model internally represents."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:safety-and-alignment ;
    vc:slug "sparse-autoencoders" ;
    vc:sourceDomain "ai" .

ngm:sparse-mixture-of-experts a owl:Class ;
    rdfs:label "Sparse Mixture of Experts"@en ;
    rdfs:comment "An MoE variant with a trainable gating network that selects only a sparse combination of experts for each example, dramatically increasing model capacity whilst maintaining computational efficiency. Sparsely-gated MoE enables models with up to 137 billion parameters with manageable inference costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-model-architecture,
        ngm:model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:neural-network-architecture ;
    vc:enables ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:attention-mechanism,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:inference,
        ngm:training-data ;
    vc:slug "sparse-mixture-of-experts" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:spatial-computing-system a owl:Class ;
    rdfs:label "Spatial Computing System"@en ;
    rdfs:comment "An integrated computing platform that seamlessly merges digital content with physical environments, exemplified by Apple Vision Pro with its M2 and R1 chips, enabling interaction through eye tracking, hand gestures, and voice while displaying content on micro-OLED displays with spatial positionin..."@en ;
