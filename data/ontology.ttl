        ngm:web-gl ;
    vc:slug "gltf-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-iec,
        ngm:khronos-group ;
    vc:supports ngm:augmented-reality,
        ngm:avatar-standard,
        ngm:virtual-reality ;
    vc:uses ngm:physically-based-rendering,
        ngm:webgpu .

ngm:latent-diffusion a owl:Class ;
    rdfs:label "Latent Diffusion"@en ;
    rdfs:comment "Latent Diffusion Models (LDMs) are a class of generative models that perform the iterative denoising diffusion process within the compressed latent space of a pre-trained variational autoencoder (VAE), rather than directly in high-dimensional pixel space. By encoding images into a compact, semantically rich latent representation, LDMs dramatically reduce training and inference compute whilst preserving perceptual quality, because the VAE absorbs the high-frequency, imperceptual detail that would otherwise burden the diffusion process. Conditioning on text, image, or other modalities is achieved via cross-attention layers inside a U-Net denoising backbone, enabling high-fidelity text-to-image synthesis, image editing, and multimodal generation at practical hardware budgets. Stable Diffusion, the most widely deployed open-source implementation, demonstrated that consumer GPUs could run production-quality image synthesis, catalysing a broad ecosystem of fine-tuning methods and downstream applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:denoising-score-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:u-net ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder-decoder-architecture ],
        ngm:diffusion-model ;
    vc:bridgesTo ngm:augmented-reality-content-creation,
        ngm:digital-twin ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:normalising-flow ;
    vc:enables ngm:image-generation,
        ngm:image-to-image-translation,
        ngm:inpainting,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:denoising-score-matching,
        ngm:encoder-decoder-architecture,
        ngm:noise-schedule ;
    vc:implements ngm:score-based-generative-model ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:generative-model,
        ngm:neural-network-latent-space,
        ngm:transformer ;
    vc:requires ngm:cross-attention,
        ngm:u-net,
        ngm:variational-autoencoder ;
    vc:slug "latent-diffusion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip,
        ngm:low-rank-adaptation .

ngm:leader-election a owl:Class ;
    rdfs:label "Leader Election"@en ;
    rdfs:comment "Leader election is a fundamental coordination primitive in distributed computing that enables a cluster of peer nodes to agree on a single node — the leader — that assumes special coordination responsibilities such as sequencing writes, directing consensus rounds, or managing resource allocation on behalf of the group. In the presence of node failures, network partitions, or leader crashes, the leader election protocol must reliably select a new leader from the surviving nodes while ensuring safety (at most one leader at a time) and liveness (a leader is eventually elected) properties hold."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-partition-tolerance ],
        ngm:distributed-consensus ;
    vc:bridgesTo ngm:delegated-proof-of-stake ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-system,
        ngm:high-availability,
        ngm:log-replication,
        ngm:replication,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:etcd,
        ngm:participant-coordination,
        ngm:zookeeper ;
    vc:requires ngm:failure-detector,
        ngm:network-partition-tolerance ;
    vc:slug "leader-election" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-algorithm,
        ngm:fault-tolerance,
        ngm:paxos,
        ngm:quorum,
        ngm:raft .

ngm:legal-framework a owl:Class ;
    rdfs:label "Legal Framework"@en ;
    rdfs:comment "A legal framework for technology systems comprises the body of laws, regulations, and legal requirements that govern the development, deployment, and operation of information technology. It establishes obligations for data protection, privacy, security, and compliance, defining the legal boundaries within which organisations must operate when processing personal data, deploying AI systems, and conducting digital operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-protection-regulation ],
        [ a owl:Restriction ;
