    rdfs:label "Interoperability Layer"@en .

ngm:interoperability-standards a owl:Class ;
    rdfs:label "Interoperability Standards"@en ;
    rdfs:comment "Agreed specifications that allow independently developed systems, protocols or networks to exchange data and operate together reliably."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "interoperability-standards" ;
    vc:sourceDomain "general" .

