ngm:proxy-pattern a owl:Class ;
    rdfs:label "Proxy Pattern"@en ;
    rdfs:comment "The Proxy Pattern is a smart-contract design technique that separates a contract's persistent storage and address from its executable logic, allowing the logic to be upgraded without migrating state or changing the public address. A lightweight proxy contract holds the state and forwards calls via delegatecall to a swappable implementation contract. The pattern enables upgradeable contracts but introduces storage-layout, initialisation and access-control hazards that must be managed carefully."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:smart-contract ;
    vc:contrastsWith ngm:smart-contract ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip ;
    vc:isPartOf ngm:smart-contract ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:erc-20,
        ngm:token-standard ;
    vc:requires ngm:access-control ;
    vc:slug "proxy-pattern" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:eip ;
    vc:supports ngm:gas-optimization ;
    vc:uses ngm:ethereum,
        ngm:solidity .

ngm:prudential-regulation-authority a owl:Class ;
    rdfs:label "Prudential Regulation Authority"@en ;
    rdfs:comment "The Prudential Regulation Authority (PRA) is the United Kingdom regulator responsible for the prudential supervision of banks, building societies, credit unions, insurers and major investment firms. Operating as part of the Bank of England, it sets capital, liquidity and governance standards to promote the safety and soundness of individual firms and to protect insurance policyholders. The PRA shares the UK's twin-peaks regulatory model with the conduct-focused Financial Conduct Authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prudential-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:financial-regulation ;
    vc:contrastsWith ngm:financial-conduct-authority ;
    vc:dependsOn ngm:central-bank ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:prudential-regulation,
        ngm:regulatory-compliance ;
    vc:implements ngm:basel-iii ;
    vc:isPartOf ngm:bank-of-england ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:finance,
        ngm:financial-regulation ;
    vc:requires ngm:risk-management ;
    vc:slug "prudential-regulation-authority" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:systemic-risk .

ngm:pseudorandom-function a owl:Class ;
    rdfs:label "Pseudorandom Function"@en ;
    rdfs:comment "A pseudorandom function (PRF) is a keyed family of functions whose outputs are computationally indistinguishable from those of a truly random function to any adversary lacking the key. PRFs are a foundational primitive in modern cryptography, providing the security guarantee that underlies message authentication codes, key derivation, and many symmetric protocols. Given the same key and input a PRF is deterministic, yet without the key its outputs reveal no exploitable structure. Closely related is the pseudorandom permutation, which adds invertibility and models block ciphers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        ngm:security ;
    vc:bridgesTo ngm:key-derivation-function ;
    vc:contrastsWith ngm:cryptographic-hash-function ;
    vc:enables ngm:key-derivation-function,
        ngm:message-authentication-code ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:hmac ;
    vc:isPartOf ngm:security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:symmetric-encryption,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:entropy ;
    vc:slug "pseudorandom-function" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication,
        ngm:symmetric-encryption ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:random-number-generation .

ngm:qualified-electronic-signature a owl:Class ;
    rdfs:label "Qualified Electronic Signature"@en ;
    rdfs:comment "A qualified electronic signature (QES) is the highest-assurance class of electronic signature defined by the European Union's eIDAS regulation, created with a qualified signature-creation device and backed by a qualified certificate issued by an accredited trust service provider. It is legally equivalent to a handwritten signature across the EU and provides strong guarantees of signer identity and document integrity. QES underpins cross-border legal acts requiring the highest evidentiary weight."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:electronic-signature ;
    vc:bridgesTo ngm:digital-identity ;
    vc:contrastsWith ngm:biometric-authentication ;
    vc:enables ngm:authentication,
        ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature ;
    vc:isPartOf ngm:electronic-signature ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:eidas-regulation,
        ngm:electronic-signature ;
    vc:requires ngm:digital-signature,
        ngm:identity-verification,
        ngm:public-key-infrastructure ;
    vc:slug "qualified-electronic-signature" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:eidas-regulation ;
    vc:supports ngm:compliance ;
    vc:uses ngm:certificate-authority,
        ngm:cryptography,
        ngm:public-key-infrastructure .

ngm:quantum-computing a skos:Concept ;
    rdfs:label "Quantum Computing"@en .

ngm:quantum-error-correction a owl:Class ;
    rdfs:label "Quantum Error Correction"@en ;
    rdfs:comment "Quantum error correction is the set of techniques that protect quantum information against decoherence and operational noise by encoding a logical qubit redundantly across many physical qubits. Stabiliser measurements detect errors without collapsing the encoded state, allowing the system to diagnose and reverse bit-flip and phase-flip faults. It is the central prerequisite for fault-tolerant quantum computation, where logical error rates can be driven arbitrarily low provided physical error rates fall below a threshold."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:error-correction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:quantum-computation-paradigm ;
    vc:bridgesTo ngm:fault-tolerance,
        ngm:post-quantum-cryptography ;
    vc:dependsOn ngm:qubit ;
    vc:enables ngm:quantum-computation-paradigm,
        ngm:quantum-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:error-correction,
        ngm:quantum-gate,
        ngm:qubit ;
    vc:isPartOf ngm:quantum-computation-paradigm ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:quantum-computation-paradigm ;
    vc:requires ngm:linear-algebra,
        ngm:qubit ;
    vc:slug "quantum-error-correction" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:error-correction,
        ngm:quantum-gate ;
    vc:uses ngm:linear-algebra .

ngm:quasi-monte-carlo a owl:Class ;
    rdfs:label "Quasi Monte Carlo"@en ;
    rdfs:comment "Quasi-Monte Carlo (QMC) is a family of numerical integration and sampling methods that replace the pseudo-random points of classical Monte Carlo with deterministic low-discrepancy sequences. By spreading sample points more evenly across the integration domain, QMC achieves faster asymptotic convergence than standard Monte Carlo for many smooth, moderate-dimensional integrals. It is widely used in computational finance, computer graphics, and uncertainty quantification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variance-reduction ],
        ngm:monte-carlo-integration ;
    vc:bridgesTo ngm:computer-graphics ;
    vc:contrastsWith ngm:monte-carlo-integration ;
    vc:dependsOn ngm:sampling ;
    vc:enables ngm:variance-reduction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:variance-reduction ;
    vc:implements ngm:simulation ;
    vc:isPartOf ngm:numerical-methods ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:importance-sampling,
        ngm:statistics,
        ngm:stochastic-process ;
    vc:slug "quasi-monte-carlo" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:numerical-methods,
        ngm:uncertainty-quantification ;
    vc:uses ngm:random-sampling,
        ngm:sampling .

ngm:query-interface a owl:Class ;
    rdfs:label "Query Interface"@en ;
    rdfs:comment "A query interface is a defined boundary — programmatic, visual, or linguistic — through which users or systems express requests for data retrieval, graph traversal, or knowledge discovery against a data store or knowledge base, receiving structured results in return. Query interfaces range from formal declarative languages such as SQL and SPARQL to REST endpoints, vector similarity APIs, and natural-language question-answering systems built on large language models. They abstract the internal organisation of a data source behind a stable contract, enabling diverse clients to access data without knowledge of storage implementation details. Well-designed query interfaces balance expressiveness, performance, and ease of use."@en ;
    rdfs:subClassOf ngm:data-access-interface ;
    vc:enables ngm:enterprise-search,
        ngm:knowledge-graph,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:nearest-neighbor-search,
        ngm:vector-database ;
    vc:slug "query-interface" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:database-query,
        ngm:information-retrieval,
        ngm:sparql .

ngm:query-optimiser a owl:Class ;
    rdfs:label "Query Optimiser"@en ;
    rdfs:comment "A query optimiser is the component of a database management system that transforms a declarative query into an efficient physical execution plan. It enumerates candidate plans, estimates their cost using statistics about data distribution and access paths, and selects the plan expected to minimise resource usage. Cost-based optimisers rely on cardinality estimation and index awareness, while rule-based optimisers apply heuristic transformations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:statistics ],
        ngm:query-engine ;
    vc:enables ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:indexing,
        ngm:statistics ;
    vc:isPartOf ngm:database-management-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:database,
        ngm:postgre-sql,
        ngm:query-engine ;
    vc:requires ngm:indexing,
        ngm:statistics ;
    vc:slug "query-optimiser" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:database-query,
        ngm:performance-optimization ;
    vc:uses ngm:relational-database,
        ngm:sql .

ngm:radio-frequency-spectrum a owl:Class ;
    rdfs:label "Radio Frequency Spectrum"@en ;
    rdfs:comment "The radio frequency spectrum is the range of electromagnetic frequencies used to transmit information wirelessly, conventionally spanning roughly three kilohertz to three hundred gigahertz. It is a finite, shared natural resource divided into bands that are allocated and licensed by regulators to services such as broadcasting, mobile telephony, and wireless data, with propagation characteristics and capacity varying systematically with frequency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spectrum-allocation ],
        ngm:wireless-communication ;
    vc:contrastsWith ngm:bandwidth ;
    vc:dependsOn ngm:spectrum-allocation ;
    vc:enables ngm:cellular-network,
        ngm:wi-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:telecommunications ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:spectrum-management ;
    vc:requires ngm:spectrum-allocation ;
    vc:slug "radio-frequency-spectrum" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:spectrum-management ;
    vc:supports ngm:telecommunications,
        ngm:wireless-communication ;
    vc:uses ngm:signal-processing .

ngm:rapidly-exploring-random-tree a owl:Class ;
    rdfs:label "Rapidly Exploring Random Tree"@en ;
    rdfs:comment "A Rapidly Exploring Random Tree (RRT) is a sampling-based motion-planning algorithm that incrementally builds a space-filling tree by drawing random samples from the configuration space and extending the tree toward each sample. It efficiently explores high-dimensional spaces while respecting kinematic and obstacle constraints, and its variants such as RRT* add asymptotic optimality. RRT is widely used for robot path planning where the free space is too large or complex for grid-based search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        ngm:sampling-based-planning ;
    vc:bridgesTo ngm:autonomous-navigation ;
    vc:contrastsWith ngm:path-planning ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:path-planning,
        ngm:sampling-based-planning ;
    vc:isPartOf ngm:motion-planning,
        ngm:sampling-based-planning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:robot-operating-system ;
    vc:requires ngm:collision-detection ;
    vc:slug "rapidly-exploring-random-tree" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-planning ;
    vc:uses ngm:collision-detection,
        ngm:configuration-space .

ngm:rational-agent a skos:Concept ;
    rdfs:label "Rational Agent"@en .

ngm:rb-0007-collaborative-robot a owl:Class ;
    rdfs:label "rb 0007 collaborative robot"@en ;
    rdfs:comment "A collaborative robot (cobot) is an industrial robot designed and certified to work in direct physical proximity with human operators within a shared workspace, without requiring conventional hard safety guarding. Defined under ISO/TS 15066, cobots implement one or more of four collaborative operation modes — safety-rated monitored stop, hand guiding, speed-and-separation monitoring, and power-and-force limiting — each constraining robot behaviour so that human contact does not result in injury. Cobots typically feature lightweight, rounded structures, intrinsic force/torque sensing, and redundant safety-rated control architectures compliant with ISO 10218-1/-2."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:industrial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:rb-0093-speed-limitation,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0103-collaborative-operation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0056-impedance-control,
        ngm:rb-0105-speed-and-separation-monitoring,
        ngm:robo-human-robot-interaction ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0007-collaborative-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066,
        ngm:rb-0087-safety-standard .

ngm:rb-0032-manipulability a owl:Class ;
    rdfs:label "rb 0032 manipulability"@en ;
    rdfs:comment "Manipulability is a scalar or ellipsoid measure of a robotic manipulator's capacity to move and exert forces in arbitrary directions from a given joint configuration. Introduced by Tsuneo Yoshikawa, the manipulability measure w = sqrt(det(J·Jᵀ)) quantifies how far a configuration is from kinematic singularity: higher values indicate greater dexterity, while w = 0 indicates a singular configuration where motion in at least one direction is lost. Manipulability is used in motion planning, redundancy resolution, and task-space control to avoid singular regions."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-kinematics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0031-singularity ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0024-workspace,
        ngm:rb-0037-dexterity ;
    vc:slug "rb-0032-manipulability" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0029-inverse-kinematics,
        ngm:rb-0049-motion-planning .

ngm:rb-0034-repeatability a owl:Class ;
    rdfs:label "rb 0034 repeatability"@en ;
    rdfs:comment "Repeatability is a key performance metric of robot manipulators that quantifies the closeness of agreement between successive commanded returns to the same target position or pose, measured under identical conditions. It is formally defined in ISO 9283 as the radius of a sphere enclosing a specified percentage of attained positions from repeated attempts. Repeatability is distinct from accuracy — a robot may be highly repeatable but systematically offset from the commanded target — and is critical for applications such as assembly, welding, and precision manufacturing."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0047-feedback-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0036-resolution ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:calibration,
        ngm:performance-metrics,
        ngm:precision ;
    vc:slug "rb-0034-repeatability" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .

ngm:rb-0035-accuracy a owl:Class ;
    rdfs:label "rb 0035 accuracy"@en ;
    rdfs:comment "Robot accuracy is the closeness of agreement between a robot's commanded pose and its actual achieved pose, measured as the mean positional or orientational error across multiple repeated commanded positions. Defined in ISO 9283, it encompasses pose accuracy, path accuracy, and static compliance accuracy, and is distinct from repeatability, which measures the spread of repeated attempts at the same pose rather than deviation from the commanded value."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:accuracy ;
    vc:contrastsWith ngm:rb-0034-repeatability,
        ngm:rb-0036-resolution ;
    vc:dependsOn ngm:rb-0048-pid-controller ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:calibration,
        ngm:precision,
        ngm:rb-0021-robot-kinematics,
        ngm:rb-0029-inverse-kinematics ;
    vc:slug "rb-0035-accuracy" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .

ngm:rb-0062-model-predictive-control a owl:Class ;
    rdfs:label "rb 0062 model predictive control"@en ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced optimal control strategy that uses an explicit mathematical model of the plant to predict future system behaviour over a finite receding horizon, then solves an optimisation problem at each control step to determine the input sequence that minimises a cost function subject to state and input constraints. Only the first element of the computed sequence is applied before the optimisation is repeated. In robotics, MPC enables constraint-aware trajectory tracking, force regulation, and whole-body motion planning that classical PID controllers cannot achieve."@en ;
    rdfs:subClassOf ngm:optimal-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0048-pid-controller,
        ngm:rb-0063-sliding-mode-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0056-impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0060-optimal-control,
        ngm:rb-0061-nonlinear-control,
        ngm:state-space-control ;
    vc:slug "rb-0062-model-predictive-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0075-range-finder a owl:Class ;
    rdfs:label "rb 0075 range finder"@en ;
    rdfs:comment "A range finder is an exteroceptive sensor that measures the distance between a robot and surrounding objects or surfaces by emitting a signal (laser, ultrasonic, or infrared) and timing its return. Range finders are fundamental to obstacle detection, safety zone monitoring, and environment mapping in mobile and collaborative robots."@en ;
    rdfs:subClassOf ngm:exteroceptive-sensor,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:rb-0095-safety-zone,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:proximity-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0078-infrared-sensor,
        ngm:rb-0080-radar ;
    vc:slug "rb-0075-range-finder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:point-cloud,
        ngm:sensor-fusion .

ngm:rb-0077-depth-camera a owl:Class ;
    rdfs:label "rb 0077 depth camera"@en ;
    rdfs:comment "A depth camera is a sensor that captures per-pixel distance information alongside a conventional intensity image, producing a registered RGB-D data stream or raw point cloud. In robotics, depth cameras are used for 3D scene reconstruction, obstacle avoidance, object recognition, and SLAM. Common operating principles include structured light projection (e.g. Intel RealSense), time-of-flight measurement, and stereo triangulation; each involves different trade-offs in range, resolution, and outdoor usability."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:camera ;
    vc:enables ngm:obstacle-avoidance,
        ngm:point-cloud,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0066-robot-sensor ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0068-vision-system,
        ngm:rb-0069-lidar,
        ngm:stereo-camera ;
    vc:slug "rb-0077-depth-camera" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:simultaneous-localisation-and-mapping,
        ngm:visual-odometry ;
    vc:uses ngm:depth-estimation,
        ngm:depth-sensing .

ngm:rb-0088-iso-13482-compliance a owl:Class ;
    rdfs:label "rb 0088 iso 13482 compliance"@en ;
    rdfs:comment "ISO 13482 compliance refers to conformance with ISO 13482:2014, the international safety standard for personal care robots that interact with humans in non-industrial settings. Achieving compliance requires demonstrating that hazards have been identified, risks reduced to acceptable levels via protective measures, and that the robot meets defined performance and safety integrity criteria throughout its operational life."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0100-safety-integrity-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:functional-safety,
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:contrastsWith ngm:iso-10218 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0087-safety-standard,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0096-safeguarding,
        ngm:service-robot ;
    vc:requires ngm:rb-0089-risk-assessment,
        ngm:rb-0100-safety-integrity-level ;
    vc:slug "rb-0088-iso-13482-compliance" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508 .

ngm:rb-0100-safety-integrity-level a owl:Class ;
    rdfs:label "rb 0100 safety integrity level"@en ;
    rdfs:comment "Safety Integrity Level (SIL) is a discrete measure of the reliability required for a safety function in a robotic or automated system, defined by IEC 61508 on a four-level scale (SIL 1–4). A higher SIL demands greater hardware fault tolerance, stricter software development processes, and more comprehensive validation to ensure the safety function reduces risk to a tolerable level. SIL is assigned during risk assessment and drives the entire safety lifecycle of a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:cobot-safety-levels,
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0090-emergency-stop,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0100-safety-integrity-level" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:functional-safety,
        ngm:iec-61508 ;
    vc:supports ngm:rb-0092-protective-stop .

ngm:rb-1013-localization a owl:Class ;
    rdfs:label "RB 1013 localization"@en ;
    rdfs:comment "RB 1013 localization is a robotics navigation concept addressing the problem of a mobile robot determining its pose within a known or partially known environment. It encompasses probabilistic state estimation techniques such as particle filters, extended Kalman filters, and scan-matching algorithms applied to sensor data from LiDAR, wheel odometry, and IMUs to produce continuous pose estimates suitable for autonomous navigation."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:localization,
        ngm:slam,
        ngm:visual-odometry ;
    vc:slug "rb-1013-localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:particle-filter .

ngm:rdma a owl:Class ;
    rdfs:label "Rdma"@en ;
    rdfs:comment "Remote Direct Memory Access (RDMA) is a networking capability that lets one computer read from or write to the memory of another without involving either machine's operating system or CPU on the data path. By bypassing kernel buffering and copying, RDMA delivers very low latency and high throughput, which is essential for the collective communication patterns of large-scale distributed training. It is exposed through fabrics such as InfiniBand and RoCE and underpins high-performance computing clusters."@en ;
    rdfs:subClassOf ngm:networking ;
    vc:bridgesTo ngm:infrastructure ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:memory-bandwidth ;
    vc:enables ngm:collective-communication,
        ngm:distributed-training,
        ngm:low-latency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:networking ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:high-performance-computing ;
    vc:slug "rdma" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-parallelism,
        ngm:model-parallelism,
        ngm:tensor-parallelism ;
    vc:uses ngm:bandwidth,
        ngm:network-protocol .

ngm:reactive-control a owl:Class ;
    rdfs:label "Reactive Control"@en ;
    rdfs:comment "Reactive Control is a paradigm of robot control architecture in which sensor inputs are mapped directly to actuator outputs through fast, pre-compiled stimulus-response rules, without constructing an explicit world model. Associated with Brooks's subsumption architecture and behaviour-based robotics, it enables low-latency responses to environmental perturbations and is typically combined with deliberative or hybrid planners in practical autonomous systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:closed-loop-control ;
    vc:enables ngm:autonomous-robot,
        ngm:obstacle-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:manipulation,
        ngm:motion-control ;
    vc:slug "reactive-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:sensor-fusion .

ngm:real-analysis a owl:Class ;
    rdfs:label "Real Analysis"@en ;
    rdfs:comment "Real Analysis is the branch of mathematics that rigorously studies the real numbers, sequences, series, limits, continuity, differentiation and integration. It provides the formal foundations underlying calculus, establishing theorems on convergence and the structure of the real line. Real analysis underpins measure theory, functional analysis and the probabilistic and optimisation theory used in machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convergence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:topology ],
        ngm:calculus ;
    vc:bridgesTo ngm:functional-analysis,
        ngm:measure-theory ;
    vc:enables ngm:probability-theory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:convergence ;
    vc:isPartOf ngm:calculus ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:machine-learning ;
    vc:requires ngm:topology ;
    vc:slug "real-analysis" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:sigma-algebra .

ngm:real-time-collaboration a owl:Class ;
    rdfs:label "Real Time Collaboration"@en ;
    rdfs:comment "Real-time collaboration is the practice and technology of multiple users working concurrently on shared content with changes propagated and merged with minimal latency. It relies on synchronisation algorithms that resolve concurrent edits while preserving each participant's intent. It underpins collaborative editors, shared design tools, and multi-user virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-synchronization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conflict-resolution ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:operational-transformation ;
    vc:contrastsWith ngm:version-control ;
    vc:dependsOn ngm:low-latency,
        ngm:real-time-communication ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:distributed-collaboration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:state-synchronization ;
    vc:requires ngm:conflict-resolution,
        ngm:state-synchronization ;
    vc:slug "real-time-collaboration" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:version-control ;
    vc:uses ngm:crdt,
        ngm:operational-transformation .

ngm:redemption-mechanism a owl:Class ;
    rdfs:label "Redemption Mechanism"@en ;
    rdfs:comment "A redemption mechanism is the process by which a token holder can exchange a stablecoin or wrapped asset back into the underlying reserve asset it represents, such as fiat currency or collateral. It is the structural counterpart of minting and is central to maintaining a stablecoin's peg: credible redeemability allows arbitrageurs to profit from deviations between market price and par value, pulling the price back to the peg. Redemption mechanisms vary from direct par redemption with the issuer to on-chain burn-and-release contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-reserve ],
        ngm:stablecoin ;
    vc:contrastsWith ngm:minting ;
    vc:dependsOn ngm:proof-of-reserve ;
    vc:enables ngm:arbitrage,
        ngm:peg ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:burning,
        ngm:proof-of-reserve ;
    vc:isPartOf ngm:stablecoin ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-stablecoin,
        ngm:decentralized-finance,
        ngm:liquidity-pool ;
    vc:requires ngm:collateral,
        ngm:reserve ;
    vc:slug "redemption-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:tether,
        ngm:usdc ;
    vc:uses ngm:smart-contract .

ngm:redress-procedure a owl:Class ;
    rdfs:label "Redress Procedure"@en ;
    rdfs:comment "A Redress Procedure is a formalised mechanism enabling individuals or groups adversely affected by AI system decisions to challenge those decisions, seek explanations, request human review, and obtain remedies including correction, compensation, or policy changes. Redress procedures embody accountability by ensuring that consequential algorithmic decisions—in employment, credit, housing, criminal justice, and public services—remain contestable rather than treated as unappealable automated verdicts. Effective procedures must be accessible (understandable without legal expertise), timely (preventing irreversible harm), thorough (genuine rather than perfunctory human review), and proportionate, with escalation pathways from internal review through independent ombudsman services to judicial challenge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:algorithmic-transparency-reports,
        ngm:audit-trail,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:risk-assessment ;
    vc:requires ngm:explainability,
        ngm:human-oversight,
        ngm:transparency ;
    vc:slug "redress-procedure" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:human-rights,
        ngm:regulatory-compliance .

ngm:reference-model a owl:Class ;
    rdfs:label "Reference Model"@en ;
    rdfs:comment "A reference model is an abstract, authoritative description of the desired behaviour or structure of a system, used as the standard against which an actual implementation is measured or controlled. In control theory it specifies the ideal closed-loop response that a model-reference adaptive controller drives the plant to follow. In evaluation it serves as the baseline whose outputs define the expected target."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:evaluation-benchmarks-and-leaderboards ;
    vc:slug "reference-model" ;
    vc:sourceDomain "robotics" .

ngm:regulatory-requirements a owl:Class ;
    rdfs:label "Regulatory Requirements"@en ;
    rdfs:comment "Regulatory requirements are the legally binding or supervisory obligations imposed on organisations and individuals by governmental bodies, statutory agencies, and international instruments, specifying the conditions under which they may lawfully operate, offer products, or provide services. They derive from primary legislation, secondary instruments, and supervisory rulebooks, and are operationalised through licensing, capital adequacy, conduct-of-business, reporting, record-keeping, and data-protection mandates. Entities must demonstrate adherence through formal compliance programmes, independent audits, and periodic regulatory filings, with failure exposing them to financial penalties, operational restrictions, or revocation of authorisation. Regulatory requirements are increasingly sector-specific and jurisdictionally layered, requiring cross-border harmonisation mechanisms to reconcile conflicting national regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:record-keeping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:licensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:regulation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:data-sovereignty ;
    vc:contrastsWith ngm:self-regulation ;
    vc:dependsOn ngm:standards ;
    vc:enables ngm:compliance,
        ngm:regulatory-reporting,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-protection,
        ngm:licensing ;
    vc:isPartOf ngm:governance,
        ngm:regulatory-frameworks ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:policy,
        ngm:supervisory-authority ;
    vc:requires ngm:audit,
        ngm:data-governance,
        ngm:record-keeping ;
    vc:slug "regulatory-requirements" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:financial-stability-board .

ngm:reinforcement-learning-algorithm a owl:Class ;
    rdfs:label "Reinforcement Learning Algorithm"@en ;
    rdfs:comment "Reinforcement Learning Algorithms enable agents to learn optimal decision-making policies through interaction with environments, guided by reward signals. Core families include value-based methods (Q-learning, DQN), policy gradient methods (REINFORCE, PPO, TRPO), and actor-critic approaches (A3C, SAC), all of which balance exploration against exploitation to maximise cumulative expected reward."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:reinforcement-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:reward-function ;
    vc:slug "reinforcement-learning-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:proximal-policy-optimisation .

ngm:rejection-sampling a owl:Class ;
    rdfs:label "Rejection Sampling"@en ;
    rdfs:comment "Rejection sampling is a Monte Carlo technique for drawing samples from a target probability distribution by sampling from a simpler proposal distribution and accepting or rejecting each draw according to a ratio test. It requires a proposal that bounds the target up to a constant and yields exact samples from the target when accepted. In machine learning it also names a practical method of generating candidate model outputs, scoring them and keeping only those that pass a quality or reward threshold."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        ngm:sampling ;
    vc:contrastsWith ngm:importance-sampling,
        ngm:markov-chain-monte-carlo ;
    vc:dependsOn ngm:probability-distribution ;
    vc:enables ngm:bayesian-inference,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:probability-distribution,
        ngm:sampling ;
    vc:implements ngm:sampling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inference,
        ngm:normalizing-flow ;
    vc:requires ngm:probabilistic-model,
        ngm:probability-distribution ;
    vc:slug "rejection-sampling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:bayesian-inference ;
    vc:uses ngm:generative-model .

ngm:remote-assistance a owl:Class ;
    rdfs:label "Remote Assistance"@en ;
    rdfs:comment "Remote assistance is a service modality in which an expert or system provides real-time guidance, intervention, or control to a person or machine at a physically separate location, mediated by communication and rendering technology. It spans technical IT support via screen-sharing, clinical guidance through telestration overlays on AR headsets, and safety-critical interventions in teleoperated robotics. Effective remote assistance requires low-latency bidirectional communication, shared situational awareness, and appropriate interaction modalities for the task domain."@en ;
    rdfs:subClassOf ngm:remote-collaboration ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:teleoperation,
        ngm:telepresence ;
    vc:slug "remote-assistance" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:remote-communication ;
    vc:uses ngm:communication-protocol,
        ngm:immersive-communication .

ngm:remote-education a owl:Class ;
    rdfs:label "Remote Education"@en ;
    rdfs:comment "Remote education is the delivery of teaching and learning to geographically dispersed participants over digital networks, spanning live virtual classrooms, recorded content, and immersive metaverse environments. It depends on collaboration tools such as breakout rooms, shared media, and presence to recreate interactive instruction. Immersive variants add spatial co-presence to improve engagement over flat video."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room,
        ngm:education-metaverse ;
    vc:slug "remote-education" ;
    vc:sourceDomain "metaverse" .

ngm:reparameterisation-trick a owl:Class ;
    rdfs:label "Reparameterisation Trick"@en ;
    rdfs:comment "The reparameterisation trick is a technique for obtaining low-variance gradient estimates of an expectation over a random variable by expressing that variable as a deterministic, differentiable function of the distribution parameters and an independent noise source. By moving the stochasticity outside the computation graph, gradients can flow through a sampling step via backpropagation, enabling end-to-end training of models with latent random variables. It is foundational to variational autoencoders and to many stochastic optimisation methods in deep learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:variational-autoencoder ;
    vc:dependsOn ngm:gradient-descent,
        ngm:probability-distribution ;
    vc:enables ngm:generative-model,
        ngm:variational-autoencoder ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:variational-autoencoder ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:requires ngm:backpropagation,
        ngm:probability-distribution ;
    vc:slug "reparameterisation-trick" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:latent-variable-model,
        ngm:stochastic-optimisation ;
    vc:uses ngm:automatic-differentiation,
        ngm:stochastic-gradient-descent .

ngm:reporting-mechanisms a owl:Class ;
    rdfs:label "Reporting Mechanisms"@en ;
    rdfs:comment "Reporting mechanisms are the user-facing tools and processes through which people flag illegal content, abuse, or policy violations to a platform or authority. They are a mandated component of content-moderation regimes, requiring accessible channels, acknowledgement, and traceable handling of notices. Well-designed mechanisms balance ease of reporting against abuse of the reporting system itself."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:community-standards,
        ngm:digital-services-act ;
    vc:slug "reporting-mechanisms" ;
    vc:sourceDomain "governance" .

ngm:reprojection-error a owl:Class ;
    rdfs:label "Reprojection Error"@en ;
    rdfs:comment "Reprojection error is the geometric distance, in image pixels, between an observed feature point and the position predicted by projecting its estimated three-dimensional point back through the estimated camera model. It serves as the primary residual minimised in camera calibration, pose estimation and bundle adjustment, where the sum of squared reprojection errors quantifies how well the reconstructed geometry explains the measurements. Low reprojection error indicates a consistent, well-calibrated reconstruction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        ngm:camera-calibration ;
    vc:dependsOn ngm:feature-matching ;
    vc:enables ngm:bundle-adjustment,
        ngm:structure-from-motion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:camera-calibration ;
    vc:isPartOf ngm:bundle-adjustment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:sensor-calibration ;
    vc:requires ngm:camera-calibration,
        ngm:feature-matching ;
    vc:slug "reprojection-error" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:pose-estimation ;
    vc:uses ngm:optimisation,
        ngm:pose-estimation .

ngm:request-for-comments a owl:Class ;
    rdfs:label "Request For Comments"@en ;
    rdfs:comment "A Request for Comments (RFC) is a formally numbered document in a series used to define, describe and discuss internet technologies, protocols, procedures and conventions. Originating with the early ARPANET community and now stewarded primarily through the IETF, RFCs range from formal standards to informational and experimental memos. The series provides a durable, citable record of how core internet infrastructure is specified and evolved."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:open-standards ;
    vc:bridgesTo ngm:interoperability ;
    vc:dependsOn ngm:governance,
        ngm:internet-engineering-task-force ;
    vc:enables ngm:internet-protocol,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:communication-protocol,
        ngm:network-protocol ;
    vc:implements ngm:interoperability-standard ;
    vc:isPartOf ngm:open-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:internet-protocol,
        ngm:reference-implementation ;
    vc:slug "request-for-comments" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ietf,
        ngm:internet-engineering-task-force ;
    vc:supports ngm:interoperability,
        ngm:open-standards ;
    vc:uses ngm:network-protocol .

ngm:research-funding a owl:Class ;
    rdfs:label "Research Funding"@en ;
    rdfs:comment "Research funding is the provision of financial resources to support scientific, scholarly and technological investigation, supplied through mechanisms such as competitive grants, institutional block funding, philanthropy and industry sponsorship. It typically flows through proposal submission, peer review and award management, and shapes which questions are pursued and by whom. Research funding is a primary determinant of the direction, scale and independence of academic research and innovation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-review ],
        ngm:academic-research ;
    vc:bridgesTo ngm:innovation ;
    vc:contrastsWith ngm:finance ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:academic-research ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:peer-review ;
    vc:implements ngm:finance ;
    vc:isPartOf ngm:academic-research ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:innovation,
        ngm:peer-review ;
    vc:requires ngm:peer-review ;
    vc:slug "research-funding" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:governance ;
    vc:supports ngm:innovation ;
    vc:uses ngm:peer-review .

ngm:research-institution a owl:Class ;
    rdfs:label "Research Institution"@en ;
    rdfs:comment "A research institution is an organisation whose primary mission is the systematic production of new knowledge through investigation, experimentation and scholarship. It encompasses universities, dedicated research laboratories, government agencies and independent institutes that employ researchers, secure funding, and disseminate findings via peer-reviewed publication. Research institutions provide the infrastructure, governance and intellectual community within which scientific and technical advances are pursued and validated."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:innovation ;
    vc:contrastsWith ngm:think-tank ;
    vc:enables ngm:innovation,
        ngm:scientific-research ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:laboratory ;
    vc:isPartOf ngm:research-university ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:academia,
        ngm:artificial-intelligence,
        ngm:think-tank,
        ngm:university ;
    vc:requires ngm:grant-funding ;
    vc:slug "research-institution" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:peer-review ;
    vc:uses ngm:scientific-method .

ngm:research-university a owl:Class ;
    rdfs:label "Research University"@en ;
    rdfs:comment "A research university is a higher-education institution whose mission combines teaching with the production of original scholarship, conducting basic and applied research across disciplines and training postgraduate researchers. Such universities operate laboratories, secure competitive grant funding, publish peer-reviewed scholarship, and frequently anchor regional innovation ecosystems through technology transfer. They are central nodes in the pipeline that converts fundamental discovery into trained talent and commercialisable knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-and-development ],
        ngm:research-institution ;
    vc:bridgesTo ngm:innovation-ecosystem,
        ngm:technology-transfer ;
    vc:dependsOn ngm:grant-funding,
        ngm:peer-review ;
    vc:enables ngm:academic-research,
        ngm:talent-pipeline,
        ngm:technology-transfer ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:laboratory,
        ngm:phd-programme ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:research-institution ;
    vc:requires ngm:research-and-development ;
    vc:slug "research-university" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:innovation-ecosystem,
        ngm:scientific-publication .

ngm:residual-network a owl:Class ;
    rdfs:label "Residual Network"@en ;
    rdfs:comment "A deep neural network architecture introduced by He et al. (2016) that employs skip connections to allow gradients to propagate directly through layers, expressed as H(x) = F(x) + x. This residual formulation resolves the vanishing gradient problem in very deep networks, enabling training of architectures with hundreds of layers and achieving state-of-the-art performance on image recognition benchmarks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-layer ],
        ngm:ai-technique,
        ngm:deep-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:image-classification,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:neural-network-layer ;
    vc:slug "residual-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:gpu-compute .

ngm:resource-efficiency a owl:Class ;
    rdfs:label "Resource Efficiency"@en ;
    rdfs:comment "Resource efficiency is the practice of producing the same output or value while consuming fewer material, energy, or computational inputs. It encompasses minimising waste, reusing by-products, and optimising processes so that resources deliver maximum useful work. In sustainability and industrial contexts it is a primary lever for reducing cost and environmental footprint."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-symbiosis,
        ngm:performance-optimization ;
    vc:slug "resource-efficiency" ;
    vc:sourceDomain "infrastructure" .

ngm:risk-analysis a owl:Class ;
    rdfs:label "Risk Analysis"@en ;
    rdfs:comment "Risk analysis is the systematic process of identifying, characterising and estimating the likelihood and impact of events that could threaten objectives, in order to inform decisions about how to treat them. It combines qualitative judgement with quantitative techniques such as scenario modelling and probabilistic simulation to express uncertainty in actionable terms. As a core component of risk management, it produces the evidence base for prioritising controls, allocating capital and setting tolerances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stress-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scenario-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monte-carlo-methods ],
        ngm:risk-management ;
    vc:enables ngm:decision-making,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:monte-carlo-methods,
        ngm:scenario-analysis,
        ngm:stress-testing ;
    vc:isPartOf ngm:governance,
        ngm:risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decision-making,
        ngm:stress-testing ;
    vc:requires ngm:statistics ;
    vc:slug "risk-analysis" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance ;
    vc:uses ngm:monte-carlo-methods,
        ngm:scenario-analysis .

ngm:risk-scoring a owl:Class ;
    rdfs:label "Risk Scoring"@en ;
    rdfs:comment "Risk scoring is the quantitative practice of assigning a numerical value to an entity, transaction or event to express the likelihood and potential severity of an adverse outcome such as credit default, fraud or money laundering. Scores are derived from statistical and machine-learning models trained on historical data and behavioural features, producing a calibrated probability or rank that informs automated and human decisions. In finance it underpins lending, underwriting, transaction monitoring and regulatory compliance workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decision-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anomaly-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:risk-management ;
    vc:dependsOn ngm:data ;
    vc:enables ngm:fraud-detection,
        ngm:kyc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decision-tree ;
    vc:implements ngm:risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:regulatory-compliance ;
    vc:requires ngm:anomaly-detection,
        ngm:risk-assessment ;
    vc:slug "risk-scoring" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:anti-money-laundering ;
    vc:uses ngm:feature-engineering,
        ngm:machine-learning,
        ngm:predictive-analytics .

ngm:risk-scoring-engine a owl:Class ;
    rdfs:label "Risk Scoring Engine"@en ;
    rdfs:comment "A risk scoring engine is a software component that computes a numerical risk score for an entity, transaction, or session by combining multiple weighted signals through rules or models. In compliance and identity systems it quantifies how likely an action is fraudulent or non-compliant, feeding thresholds that trigger review, blocking, or escalation. The score provides a consistent, tunable basis for automated decisions."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:identity-verification ;
    vc:slug "risk-scoring-engine" ;
    vc:sourceDomain "security" .

ngm:risk-weighted-assets a owl:Class ;
    rdfs:label "Risk Weighted Assets"@en ;
    rdfs:comment "Risk-weighted assets (RWA) are a bank's assets and off-balance-sheet exposures weighted according to their credit, market, and operational risk, forming the denominator of regulatory capital ratios. Under the Basel framework, riskier exposures attract higher weights, so banks must hold proportionally more capital against them. RWA links the composition of a bank's portfolio to its minimum capital requirements and overall solvency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capital-adequacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:capital-adequacy ;
    vc:dependsOn ngm:operational-risk,
        ngm:risk-assessment ;
    vc:enables ngm:capital-adequacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:capital-adequacy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:basel-committee-on-banking-supervision,
        ngm:financial-regulation,
        ngm:operational-risk,
        ngm:risk-management ;
    vc:requires ngm:capital-adequacy,
        ngm:risk-management ;
    vc:slug "risk-weighted-assets" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee-on-banking-supervision,
        ngm:basel-iii ;
    vc:supports ngm:financial-regulation,
        ngm:regulatory-compliance ;
    vc:uses ngm:risk-assessment .

ngm:robot-component a owl:Class ;
    rdfs:label "Robot Component"@en ;
    rdfs:comment "A Robot Component is any modular element forming part of a robotic system, encompassing hardware modules (motors, sensors, links, joints), electrical components (power supplies, motor drivers, embedded computers), software components (perception modules, planners, controllers), and interface components (communication protocols, connectors, mounting systems). Standardised component interfaces—ISO 9409 tool flanges, EtherCAT, ROS 2—enable plug-and-play integration, reducing development time and supporting modular system design, component reuse, and hierarchical decomposition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:sensor-fusion ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "robot-component" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-system .

ngm:robust-control a owl:Class ;
    rdfs:label "Robust Control"@en ;
    rdfs:comment "Robust Control is a branch of control theory that designs controllers guaranteeing stable and acceptable performance across a bounded set of model uncertainties and disturbances. It formalises worst-case design requirements through H-infinity and H2 optimisation frameworks, ensuring actuated systems remain within specification even when plant parameters deviate from nominal values."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:control-algorithm ;
    vc:contrastsWith ngm:adaptive-control ;
    vc:enables ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "robust-control" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:robot-safety,
        ngm:trajectory-control ;
    vc:uses ngm:feedback-control,
        ngm:pid-control .

ngm:room-scale a owl:Class ;
    rdfs:label "Room Scale"@en ;
    rdfs:comment "A VR interaction paradigm in which the user can physically walk within a tracked play area — typically 2m × 2m or larger — with inside-out or lighthouse-based positional tracking translating real-world movement into the virtual environment. Room-scale VR requires boundary (chaperone) systems to prevent collisions with physical obstacles, and is contrasted with seated or standing-only VR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality-platform ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:haptics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:xr-meeting-space ;
    vc:requires ngm:sensor-fusion,
        ngm:virtual-reality-platform ;
    vc:slug "room-scale" ;
    vc:sourceDomain "spatial-computing" .

ngm:root-certificate a owl:Class ;
    rdfs:label "Root Certificate"@en ;
    rdfs:comment "A root certificate is a self-signed X.509 certificate that identifies a root certificate authority and serves as the trust anchor at the top of a certificate chain. Relying parties pre-install trusted root certificates in trust stores, and any certificate that chains back to a trusted root is accepted as authentic. Because a compromised root undermines all certificates beneath it, root keys are protected with the highest assurance and kept offline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:digital-certificate ;
    vc:dependsOn ngm:public-key-infrastructure ;
    vc:enables ngm:authentication,
        ngm:tls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-certificate ;
    vc:implements ngm:trust-anchor ;
    vc:isPartOf ngm:public-key-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:trust-anchor,
        ngm:x-509-certificate ;
    vc:requires ngm:certificate-authority ;
    vc:slug "root-certificate" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:certificate-revocation,
        ngm:ocsp ;
    vc:uses ngm:digital-certificate .

ngm:ros-navigation-stack a owl:Class ;
    rdfs:label "ROS Navigation Stack"@en ;
    rdfs:comment "The ROS Navigation Stack is a collection of software packages within the Robot Operating System (ROS) framework that provides a robot with the capability to move autonomously through an environment by combining map building, localisation, global path planning, local obstacle avoidance, and motor control into an integrated pipeline. It abstracts sensor inputs (laser scan, odometry, IMU), maintains a 2D occupancy grid map and cost layers, runs AMCL (Adaptive Monte Carlo Localisation) for pose estimation, and uses A* or Dijkstra for global plans combined with DWA (Dynamic Window Approach) or TEB (Timed Elastic Band) for local reactive navigation. The Navigation Stack is the de facto standard for mobile ground-robot navigation in research and production robotics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:occupancy-grid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:odometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:costmap ],
        ngm:robot-operating-system ;
    vc:bridgesTo ngm:machine-learning ;
    vc:dependsOn ngm:publish-subscribe-pattern ;
    vc:enables ngm:autonomous-navigation,
        ngm:autonomous-robot,
        ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:costmap,
        ngm:global-planner,
        ngm:local-planner,
        ngm:move-base ;
    vc:isPartOf ngm:robot-operating-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gazebo-simulator,
        ngm:mobile-robot,
        ngm:nav2,
        ngm:ros-2 ;
    vc:requires ngm:occupancy-grid,
        ngm:odometry,
        ngm:transform-tree ;
    vc:slug "ros-navigation-stack" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:localisation,
        ngm:particle-filter,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping .

ngm:rough-consensus a owl:Class ;
    rdfs:label "Rough Consensus"@en ;
    rdfs:comment "Rough consensus is a decision-making principle, central to internet standards development, in which a working group adopts a position when the dominant view has been established and substantive objections have been addressed, rather than requiring unanimity or a formal majority vote. Famously paired with running code in the IETF, it favours technically sound, broadly acceptable outcomes over precise headcounts. The chair judges the sense of the group, ensuring dissent is engaged with rather than merely outnumbered."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:working-group ],
        ngm:consensus ;
    vc:contrastsWith ngm:voting-mechanism ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:governance-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ietf,
        ngm:standardization,
        ngm:standards ;
    vc:requires ngm:working-group ;
    vc:slug "rough-consensus" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:internet-engineering-task-force ;
    vc:supports ngm:interoperability-standard ;
    vc:uses ngm:standards-body .

ngm:routing-table a owl:Class ;
    rdfs:label "Routing Table"@en ;
    rdfs:comment "A routing table is a data structure, held in a router, switch or networked host, that stores the mappings between destination network addresses and the next hop or outgoing interface used to forward packets toward them. Each entry typically records a destination prefix, a next-hop address, an interface, and a metric or administrative cost used to select among competing routes. Routing tables are populated by static configuration and by dynamic routing protocols, and are consulted on every forwarding decision."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:routing-protocol ],
        ngm:data-structure ;
    vc:bridgesTo ngm:payment-routing ;
    vc:contrastsWith ngm:peer-to-peer-network ;
    vc:dependsOn ngm:network-protocol ;
    vc:enables ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ip-address ;
    vc:implements ngm:routing-protocol ;
    vc:isPartOf ngm:network-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-hash-table,
        ngm:kademlia-dht ;
    vc:requires ngm:routing-protocol ;
    vc:slug "routing-table" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:network-protocol ;
    vc:supports ngm:distributed-systems ;
    vc:uses ngm:routing-protocol .

ngm:rsa a owl:Class ;
    rdfs:label "Rsa"@en ;
    rdfs:comment "RSA is a public-key cryptosystem, named after Rivest, Shamir and Adleman, whose security rests on the computational difficulty of factoring the product of two large prime numbers. It supports both encryption — where a message encrypted with a public key can only be decrypted with the corresponding private key — and digital signatures, where a private key signs data that anyone can verify with the public key. As one of the earliest and most widely deployed asymmetric algorithms, RSA underpins much of the legacy public-key infrastructure, though it is gradually being supplemented by faster elliptic-curve schemes and, prospectively, post-quantum alternatives."@en ;
    rdfs:subClassOf ngm:public-key-cryptography ;
    vc:contrastsWith ngm:ed25519,
        ngm:elliptic-curve-cryptography ;
    vc:dependsOn ngm:modular-arithmetic ;
    vc:enables ngm:key-exchange,
        ngm:tls ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:digital-signature,
        ngm:encryption,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:schnorr-signature ;
    vc:slug "rsa" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:asymmetric-cryptography ;
    vc:uses ngm:hash-function,
        ngm:key-generation .

ngm:russell-group a owl:Class ;
    rdfs:label "Russell Group"@en ;
    rdfs:comment "The Russell Group is a self-selecting association of leading research-intensive universities in the United Kingdom that advocates collectively on research funding, policy, and higher-education strategy. Its members are characterised by substantial research output, strong postgraduate provision, and extensive industry and international links. Membership is frequently used as a shorthand for institutions with high research standing."@en ;
    rdfs:subClassOf ngm:education ;
    vc:bridgesTo ngm:standards ;
    vc:contrastsWith ngm:collaboration ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:governance ;
    vc:isPartOf ngm:education ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collaboration,
        ngm:data,
        ngm:education,
        ngm:governance,
        ngm:standards ;
    vc:slug "russell-group" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:education ;
    vc:uses ngm:governance .

ngm:safety-lifecycle a owl:Class ;
    rdfs:label "Safety Lifecycle"@en ;
    rdfs:comment "The safety lifecycle is a structured, end-to-end process defined by functional-safety standards for managing safety from concept through decommissioning. It organises activities such as hazard and risk analysis, safety requirement allocation, design, implementation, verification, validation, operation, and modification into defined phases with documented inputs, outputs, and review gates. Standards such as IEC 61508, IEC 62061, and ISO 26262 prescribe safety lifecycles to ensure that safety-related systems achieve and sustain their required integrity levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-integrity-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:failure-mode-and-effects-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:functional-safety ;
    vc:enables ngm:safety-integrity-level ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:failure-mode-and-effects-analysis,
        ngm:hazard-analysis,
        ngm:risk-assessment ;
    vc:implements ngm:iec-61508,
        ngm:iec-62061 ;
    vc:isPartOf ngm:functional-safety ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:hazop,
        ngm:safety-case ;
    vc:requires ngm:hazard-analysis,
        ngm:safety-integrity-level ;
    vc:slug "safety-lifecycle" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262 ;
    vc:supports ngm:reliability-engineering,
        ngm:safety-instrumented-system ;
    vc:uses ngm:fault-tree-analysis,
        ngm:fmea .

ngm:safety-monitoring a owl:Class ;
    rdfs:label "Safety Monitoring"@en ;
    rdfs:comment "Safety monitoring is the continuous supervision of a robotic or automated system to detect hazardous states, component degradation or human proximity and to trigger protective responses. It fuses proprioceptive and exteroceptive sensing with state estimation, anomaly detection and decision logic to enforce safety constraints independently of the nominal task controller. It underpins certified human-robot collaboration and autonomous operation in shared workspaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        ngm:robot-safety ;
    vc:enables ngm:observability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
        ngm:real-time-monitoring ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:risk-assessment ;
    vc:requires ngm:perception,
        ngm:sensor-fusion,
        ngm:telemetry ;
    vc:slug "safety-monitoring" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:collision-avoidance,
        ngm:human-robot-collaboration,
        ngm:robot-safety ;
    vc:uses ngm:anomaly-detection .

ngm:saga-pattern a owl:Class ;
    rdfs:label "Saga Pattern"@en ;
    rdfs:comment "The saga pattern is a distributed-systems design for managing long-lived business transactions that span multiple services without a global lock or two-phase commit. A saga is a sequence of local transactions, each of which has an associated compensating transaction that semantically undoes its effect if a later step fails. Coordination is achieved either through orchestration, where a central coordinator drives the steps, or choreography, where services react to events, trading strong atomicity for eventual consistency and availability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:microservices ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:orchestration ;
    vc:contrastsWith ngm:two-phase-commit ;
    vc:dependsOn ngm:event-driven-architecture ;
    vc:enables ngm:eventual-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eventual-consistency ;
    vc:isPartOf ngm:microservices-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture,
        ngm:microservices,
        ngm:transaction ;
    vc:requires ngm:microservices ;
    vc:slug "saga-pattern" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:fault-tolerance,
        ngm:reliability ;
    vc:uses ngm:event-driven-architecture,
        ngm:orchestration .

ngm:satellite-monitoring a owl:Class ;
    rdfs:label "Satellite Monitoring"@en ;
    rdfs:comment "Satellite monitoring is the use of orbital remote-sensing platforms to observe and measure conditions on the Earth's surface over time. In sustainability and supply-chain contexts it supports verification of deforestation, land use, emissions plumes, and facility activity using multispectral, radar, and thermal imagery. The resulting geospatial data feeds carbon accounting, compliance, and ethical-sourcing assessments."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:ethical-sourcing ;
    vc:slug "satellite-monitoring" ;
    vc:sourceDomain "supply-chain" .

ngm:schema-management a owl:Class ;
    rdfs:label "Schema Management"@en ;
    rdfs:comment "Schema management is the practice of defining, versioning, evolving, and enforcing the structure of data across systems and over time. It governs how data schemas change without breaking producers and consumers, using compatibility rules, schema registries, and validation to keep pipelines reliable. As a discipline within data governance, it ensures that interfaces between services and analytical stores remain consistent and trustworthy as requirements evolve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-governance ;
    vc:bridgesTo ngm:data-architecture ;
    vc:enables ngm:data-integration,
        ngm:data-quality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-schema,
        ngm:data-validation ;
    vc:isPartOf ngm:data-governance,
        ngm:data-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:master-data-management,
        ngm:metadata-management ;
    vc:requires ngm:data-schema,
        ngm:data-validation,
        ngm:version-control ;
    vc:slug "schema-management" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-pipeline,
        ngm:interoperability ;
    vc:uses ngm:data-validation,
        ngm:schema-registry .

ngm:schnorr-signatures a owl:Class ;
    rdfs:label "Schnorr Signatures"@en ;
    rdfs:comment "A digital signature scheme based on the discrete logarithm problem over elliptic curve groups, producing compact fixed-size signatures with linear aggregation properties that enable efficient multi-signature and threshold constructions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:discrete-logarithm-problem ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-oracle-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:ecdsa,
        ngm:rsa-signature ;
    vc:enables ngm:batch-verification,
        ngm:key-aggregation,
        ngm:mu-sig-2,
        ngm:taproot,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bip-340 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:random-oracle-model ;
    vc:slug "schnorr-signatures" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:bitcoin,
        ngm:privacy-preserving-protocol ;
    vc:uses ngm:commitment-scheme,
        ngm:secp256k1 .

ngm:scientific-simulation a owl:Class ;
    rdfs:label "Scientific Simulation"@en ;
    rdfs:comment "Scientific simulation is the numerical modelling of physical, chemical, or biological systems to predict behaviour that is impractical to observe directly. It solves governing equations across discretised domains, as in fluid dynamics, molecular dynamics, and climate modelling, typically on high-performance computing infrastructure. Machine learning increasingly augments simulation through learned surrogates and data-driven generation."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:generative-adversarial-networks ;
    vc:slug "scientific-simulation" ;
    vc:sourceDomain "infrastructure" .

ngm:scope-definition a owl:Class ;
    rdfs:label "Scope Definition"@en ;
    rdfs:comment "Scope definition is the act of establishing the precise boundaries, entities, and conditions to which an assessment, consent, or measurement applies. In governance and consent systems it specifies which permissions, data, or activities are covered, while in environmental assessment it delineates the system boundary for impact accounting. Clear scope is a prerequisite for auditable and comparable results."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-environmental-impact-assessment,
        ngm:user-consent-token ;
    vc:slug "scope-definition" ;
    vc:sourceDomain "governance" .

ngm:secp256k1-elliptic-curve a owl:Class ;
    rdfs:label "secp256k1 Elliptic Curve"@en ;
    rdfs:comment "secp256k1 is a specific elliptic curve defined over a 256-bit prime field, standardised by the SEC and chosen for its efficient, verifiable parameters. It underpins ECDSA and Schnorr signatures used by Bitcoin, Nostr, and many other systems for key generation and digital signing. Its near-rigid, low-entropy parameters reduce concern about hidden weaknesses."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nostr-protocol,
        ngm:sovereign-keyset ;
    vc:slug "secp256k1-elliptic-curve" ;
    vc:sourceDomain "blockchain" .

ngm:secure-messaging a owl:Class ;
    rdfs:label "Secure Messaging"@en ;
    rdfs:comment "Secure messaging is the exchange of messages protected by cryptography so that only intended participants can read or authenticate them. It typically provides end-to-end encryption, forward secrecy, and integrity, often through ratcheting key-agreement protocols. It underpins privacy-preserving communication in consumer apps, enterprise systems, and decentralised networks."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:signal-protocol ;
    vc:slug "secure-messaging" ;
    vc:sourceDomain "security" .

ngm:security-infrastructure a owl:Class ;
    rdfs:label "Security Infrastructure"@en ;
    rdfs:comment "Security infrastructure encompasses the integrated set of hardware, software, processes, and policies that protect an organisation's information systems, networks, and data assets from unauthorised access, disruption, and exploitation. It includes perimeter defences, identity and access management systems, cryptographic key management, endpoint protection, monitoring and detection platforms, and incident response capabilities. Effective security infrastructure is layered—applying defence-in-depth principles so that compromise of any single control does not expose the entire system. Modern security infrastructure increasingly adopts zero-trust architectural principles, eliminating implicit trust based on network location and requiring continuous verification of every access request. Security infrastructure must align with regulatory requirements and evolve continuously in response to the changing threat landscape."@en ;
    rdfs:subClassOf ngm:security-framework ;
    vc:enables ngm:identity-and-access-management,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:vulnerability,
        ngm:zero-trust-architecture ;
    vc:slug "security-infrastructure" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:audit-trail,
        ngm:nist ;
    vc:uses ngm:access-control,
        ngm:authentication,
        ngm:cryptographic-key-management .

ngm:segmentation-and-identification a owl:Class ;
    rdfs:label "Segmentation and Identification"@en ;
    rdfs:comment "Segmentation and Identification is a foundational computer vision subdomain encompassing the computational processes of partitioning digital images and video frames into semantically meaningful regions and assigning categorical or instance-level identities to those regions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:medical-imaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-object-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:annotated-training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:panoptic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
