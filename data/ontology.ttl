ngm:meta-platforms a owl:Class ;
    rdfs:label "Meta Platforms"@en ;
    rdfs:comment "Meta Platforms Inc is a Menlo Park-headquartered American multinational technology conglomerate founded 4 February 2004 in a Harvard University dormitory by Mark Zuckerberg with co-founders Eduardo Saverin, Andrew McCollum, Dustin Moskovitz and Chris Hughes as TheFacebook.com — initially a Harvar..."@en ;
    rdfs:subClassOf ngm:foundation-model-developer,
        ngm:hyperscaler ;
    vc:enables ngm:consumer-ai-assistants,
        ngm:cross-platform-messaging,
        ngm:federated-microblogging,
        ngm:mixed-reality-computing,
        ngm:open-weight-ai-research,
        ngm:social-networking,
        ngm:targeted-advertising ;
    vc:hasPart ngm:facebook-product,
        ngm:fair,
        ngm:horizon-worlds,
        ngm:instagram,
        ngm:llama,
        ngm:messenger,
        ngm:meta-ai-assistant,
        ngm:meta-hyperion,
        ngm:meta-quest,
        ngm:mtia,
        ngm:project-orion,
        ngm:ray-ban-meta,
        ngm:reality-labs,
        ngm:threads,
        ngm:whats-app ;
    vc:implements ngm:activity-pub-federation,
        ngm:algorithmic-newsfeed-ranking,
        ngm:behavioural-advertising,
        ngm:community-notes-moderation,
        ngm:mixture-of-experts-architecture,
        ngm:open-weight-model-release,
        ngm:pass-through-mixed-reality ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:bluesky,
        ngm:cambridge-analytica,
        ngm:frances-haugen,
        ngm:mark-zuckerberg,
        ngm:mastodon,
        ngm:metaverse,
        ngm:oculus-vr,
        ngm:onavo,
        ngm:yann-le-cun ;
    vc:requires ngm:advertising-network,
        ngm:capital-markets-access,
        ngm:compute-infrastructure,
        ngm:datacentre,
        ngm:gpu-cluster,
        ngm:mobile-operating-system,
        ngm:sec-reporting ;
    vc:slug "meta-platforms" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:activity-pub,
        ngm:dma,
        ngm:dsa,
        ngm:eu-ai-act,
        ngm:fasb,
        ngm:gdpr,
        ngm:nasdaq-listing-rules,
        ngm:online-safety-act-2023,
        ngm:sec-form-10-k ;
    vc:supports ngm:activity-pub-federation,
        ngm:creator-economy,
        ngm:graph-ql,
        ngm:llama-ecosystem,
        ngm:meta-ai-research-community,
        ngm:open-compute-project,
        ngm:py-torch,
        ngm:react ;
