        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:data-protection-law ;
    vc:bridgesTo ngm:cloud-security,
        ngm:electronic-health-record,
        ngm:interoperability ;
    vc:contrastsWith ngm:ccpa,
        ngm:gdpr ;
    vc:dependsOn ngm:protected-health-information ;
    vc:enables ngm:data-portability,
