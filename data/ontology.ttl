ngm:ai-regulation a owl:Class ;
    rdfs:label "AI Regulation"@en ;
    rdfs:comment "AI regulation encompasses binding laws, technical standards, and administrative rules imposed by national or supranational bodies to govern the entire lifecycle of artificial intelligence systems — from design and training through deployment and monitoring. Regulatory instruments range from risk-based frameworks such as the EU AI Act, which imposes tiered obligations proportional to application risk, to sector-specific rules in finance, healthcare, and critical infrastructure. Regulation aims to protect fundamental rights, ensure accountability, and promote systemic safety while preserving innovation capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-policy ;
    vc:requires ngm:regulatory-compliance,
        ngm:risk-assessment ;
    vc:slug "ai-regulation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework,
        ngm:responsible-ai .

ngm:decentralised-finance a owl:Class ;
    rdfs:label "Decentralised Finance"@en ;
    rdfs:comment "Decentralised Finance (DeFi) encompasses financial services and instruments—including lending, borrowing, trading, and yield generation—implemented as permissionless, non-custodial smart contracts on public blockchains, eliminating the need for traditional financial intermediaries such as banks, brokers, and clearinghouses. Protocol logic is encoded directly in on-chain code that executes deterministically and transparently, allowing any party to verify the rules governing their funds. DeFi protocols compose with one another through shared liquidity pools and token standards, enabling complex financial strategies from interoperable building blocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-border-payments ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "decentralised-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:stablecoin,
        ngm:tokenization .

ngm:encryption a owl:Class ;
    rdfs:label "Encryption"@en ;
    rdfs:comment "Encryption is the cryptographic process of transforming plaintext data into ciphertext using a defined algorithm and key, such that only parties possessing the correct decryption key can recover the original information, thereby ensuring confidentiality. Symmetric encryption schemes (such as AES-GCM) use a shared secret key for both encryption and decryption, while asymmetric schemes (such as RSA-OAEP) use mathematically linked key pairs. Encryption operates at multiple layers of modern infrastructure—at rest in storage systems, in transit via TLS, and at the application layer in end-to-end encrypted messaging protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:confidential-computing,
        ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:privacy,
        ngm:zero-knowledge ;
    vc:requires ngm:cryptography,
        ngm:key-management ;
    vc:slug "encryption" ;
    vc:sourceDomain "infrastructure" .

ngm:governance-framework a owl:Class ;
    rdfs:label "Governance Framework"@en ;
    rdfs:comment "A governance framework is a structured system of policies, processes, procedures, and controls that organisations use to align their technology resources and operations with business objectives."@en ;
