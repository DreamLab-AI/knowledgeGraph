    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:digital-identity,
        ngm:stablecoin ;
    vc:slug "financial-inclusion" ;
    vc:sourceDomain "blockchain" .

ngm:force-torque-sensor a owl:Class ;
    rdfs:label "Force Torque Sensor"@en ;
    rdfs:comment "Force-Torque Sensor - A multi-axis transducer mounted on the Robot Wrist that measures three-dimensional forces and torques (6-DoF) exerted during interaction with objects or humans, enabling Force Feedback, Contact Detection, and Compliance Control in precision manipulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:impedance-control,
        ngm:precision-assembly,
        ngm:soft-robotic-grasping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:haptic-feedback-system,
        ngm:wrist-assembly ;
    vc:qualityScore "0.63"^^xsd:float ;
    vc:requires ngm:calibration,
        ngm:data-processing,
        ngm:signal-amplification ;
    vc:slug "force-torque-sensor" ;
    vc:sourceDomain "robotics" .

ngm:identity-and-access-management a owl:Class ;
    rdfs:label "Identity and Access Management"@en ;
    rdfs:comment "Identity and Access Management (IAM) is a security discipline comprising the frameworks, policies, technologies, and processes that govern how digital identities are created, authenticated, authorised, and governed throughout their lifecycle within an organisation. IAM systems enforce the principle of least privilege by ensuring that subjects—users, applications, and service accounts—can access only the resources required for their legitimate purpose. Modern IAM encompasses directory services, multi-factor authentication, role-based and attribute-based access control, privileged access management, and federated identity across organisational boundaries."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:single-sign-on ;
    vc:slug "identity-and-access-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:oauth-2-0 .

ngm:inference-hardware a owl:Class ;
    rdfs:label "Inference Hardware"@en ;
    rdfs:comment "Inference Hardware is a artificial intelligence concept and a type of AI Hardware. that enables Real-Time AI."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:real-time-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "inference-hardware" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:mixture-of-experts a owl:Class ;
    rdfs:label "Mixture of Experts"@en ;
    rdfs:comment "An architecture that uses multiple specialised sub-networks (experts) with a gating mechanism that routes inputs to a sparse subset of experts, enabling scaling without proportional compute increases. MoE is adopted in production LLMs like GPT-4, enabling massive scale with controlled costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparse-mixture-of-experts ],
        ngm:ai-model-architecture,
        ngm:model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:deep-learning ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:sparse-mixture-of-experts ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "mixture-of-experts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer-architecture .

ngm:natural-language-understanding a owl:Class ;
    rdfs:label "Natural Language Understanding"@en ;
    rdfs:comment "Natural Language Understanding (NLU) is the subfield of Natural Language Processing concerned with enabling machines to comprehend the meaning, intent, and pragmatic context of human language beyond surface-level syntax. NLU tasks include semantic role labelling, named entity recognition, coreference resolution, intent classification, and entailment inference, all of which require models to build structured representations of utterance meaning. Modern NLU systems are predominantly built on large pre-trained Transformer architectures such as BERT and its derivatives, which learn contextualised word representations from large corpora."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:question-answering,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "natural-language-understanding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:named-entity-recognition,
        ngm:transformer .

ngm:policy-engine a owl:Class ;
    rdfs:label "Policy Engine"@en ;
    rdfs:comment "A Policy Engine is an automated software component that evaluates, enforces, and logs governance, access-control, and behavioural rules within a metaverse or spatial computing system. It interprets declarative policy specifications (e.g., XACML, OPA Rego, or bespoke ontology-derived rules) and applies them at runtime to user actions, asset transactions, and inter-platform communications, enabling consistent compliance across distributed, multi-stakeholder virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:access-control,
        ngm:policy-enforcement ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:technical-standards ;
    vc:slug "policy-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:compliance-framework,
        ngm:metaverse-governance-and-safeguarding .

ngm:ray-tracing a owl:Class ;
    rdfs:label "Ray Tracing"@en ;
    rdfs:comment "Ray Tracing is a physically-based light-transport simulation technique in computer graphics that generates images by casting rays from a virtual camera through each image-plane pixel into a three-dimensional scene, recursively computing colour values by evaluating ray-geometry intersections, surf..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:light-transport,
        ngm:monte-carlo-methods,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:ambient-occlusion,
        ngm:caustics,
        ngm:global-illumination,
        ngm:participating-media-rendering,
        ngm:photorealistic-rendering,
        ngm:real-time-path-tracing,
        ngm:reflections,
        ngm:soft-shadows,
        ngm:subsurface-scattering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acceleration-structure,
        ngm:brdf,
        ngm:bvh-acceleration-structure,
        ngm:denoiser,
        ngm:intersection-test,
        ngm:primary-ray,
        ngm:reservoir-sampling,
        ngm:rt-core,
        ngm:secondary-ray,
        ngm:shading-model ;
    vc:implements ngm:bidirectional-path-tracing,
        ngm:metropolis-light-transport,
        ngm:multiple-importance-sampling,
        ngm:path-tracing,
        ngm:photon-mapping,
        ngm:re-stir,
        ngm:volumetric-rendering,
        ngm:whitted-ray-tracing ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:denoising,
        ngm:direct-x,
        ngm:dlss,
        ngm:lumen,
        ngm:neural-radiance-fields,
        ngm:opti-x,
        ngm:physically-based-rendering,
        ngm:vulkan ;
    vc:requires ngm:bvh-acceleration-structure,
        ngm:camera-model,
        ngm:gpu-compute,
        ngm:light-sources,
        ngm:material-model,
        ngm:monte-carlo-integration,
        ngm:rendering-equation,
        ngm:scene-geometry ;
    vc:slug "ray-tracing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:direct-x-raytracing,
        ngm:khronos-vulkan-khr-ray-tracing,
        ngm:open-rl,
        ngm:opti-x-sdk,
        ngm:pbrt-standard ;
    vc:supports ngm:architectural-visualisation,
        ngm:digital-twin,
        ngm:film-vfx,
        ngm:game-rendering,
        ngm:metaverse,
        ngm:product-visualisation,
        ngm:scientific-visualisation,
        ngm:virtual-production ;
    vc:uses ngm:ai-upscaling,
        ngm:brdf,
        ngm:dlss,
        ngm:importance-sampling,
        ngm:neural-denoising,
        ngm:reservoir-based-resampling,
        ngm:russian-roulette-termination,
        ngm:spatiotemporal-filtering .

ngm:robot-dynamics a owl:Class ;
    rdfs:label "Robot Dynamics"@en ;
    rdfs:comment "Robot Dynamics is the study of the forces, torques, and inertial properties that govern the motion of robotic systems. It encompasses forward dynamics (computing accelerations from applied forces) and inverse dynamics (computing required torques for a desired motion), underpinning trajectory planning, model-based control, and simulation. Accurate dynamic models are essential for high-speed manipulation, legged locomotion, and compliant human-robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque ],
        ngm:robo-actuation-and-control,
        ngm:robot-mechanics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:robot-safety,
        ngm:state-estimation ;
    vc:requires ngm:kinematics,
        ngm:torque ;
    vc:slug "robot-dynamics" ;
    vc:sourceDomain "robotics" .

ngm:signal-processing a owl:Class ;
    rdfs:label "Signal Processing"@en ;
    rdfs:comment "Signal Processing is the mathematical discipline concerned with the analysis, synthesis, filtering, transformation, and compression of analogue and digital signals including audio, video, sensor telemetry, and communications data. In spatial computing and immersive systems, signal processing underpins spatial audio rendering, motion capture noise reduction, depth-sensor filtering, and the real-time fusion of multi-modal sensor streams required for robust AR/VR tracking and interaction."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:depth-sensing,
        ngm:spatial-audio,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:render-pipeline ;
    vc:slug "signal-processing" ;
    vc:sourceDomain "spatial-computing" .

ngm:supply-chain a owl:Class ;
    rdfs:label "Supply Chain"@en ;
    rdfs:comment "A supply chain is the end-to-end network of organisations, processes, logistics flows, and information systems involved in producing and delivering a product from raw material sourcing through manufacturing, distribution, and retail to the final consumer. Supply chains are characterised by multi-tier supplier relationships, demand variability, lead-time uncertainty, and growing regulatory requirements around environmental and social provenance. Blockchain-based traceability systems and AI-driven demand-forecasting tools are increasingly applied to improve resilience, transparency, and sustainability reporting across supply chain tiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supply-chain-traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supply-chain-management ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:logistics-optimization,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:supply-chain-management,
        ngm:supply-chain-traceability ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:supply-chain-blockchain ;
    vc:slug "supply-chain" ;
    vc:sourceDomain "infrastructure" .

ngm:sybil-resistance a owl:Class ;
    rdfs:label "Sybil Resistance"@en ;
    rdfs:comment "Sybil resistance is the property of a distributed network that limits the influence any single adversary can exert by creating multiple pseudonymous or fake identities. It is a foundational security requirement for decentralised systems where participation rights, voting power, or reputation depend on identity uniqueness. Mechanisms achieving sybil resistance include proof-of-work, proof-of-stake, and humanity attestation schemes such as biometric or social vouching protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:sybil-attack ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:humanity-attestation,
        ngm:proof-of-stake,
        ngm:reputation-system ;
    vc:requires ngm:consensus-mechanism,
        ngm:identity-verification ;
    vc:slug "sybil-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:technical-standards a owl:Class ;
    rdfs:label "Technical Standards"@en ;
    rdfs:comment "Formal specifications, protocols, and guidelines that define how metaverse technologies, components, and systems should operate and interact, ensuring interoperability, quality, and compatibility across different platforms and implementations."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:universal-scene-description ;
    vc:slug "technical-standards" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:3-d-asset-standard,
        ngm:interoperability-standard .

ngm:teleoperation a owl:Class ;
    rdfs:label "Teleoperation"@en ;
    rdfs:comment "Teleoperation is remote control of AutonomousRobot|robots and physical systems by human operators in real-time, enabling task execution in hazardous, distant, or inaccessible environments whilst maintaining human supervision and decision-making authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:autonomous-robot,
        ngm:haptic-feedback ;
    vc:slug "teleoperation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:augmented-reality,
        ngm:spatial-audio,
        ngm:virtual-reality .

ngm:virtual-production a owl:Class ;
    rdfs:label "Virtual Production"@en ;
    rdfs:comment "Real-time filmmaking technique combining LED Volume stages, game engine rendering, and in-camera visual effects (ICVFX) to create photorealistic virtual environments during live-action production, enabling directors to see final composited imagery on set. It integrates motion capture, photogrammetry, and neural rendering to compress post-production timelines and allow creative decisions to be made on set rather than in post."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-volume ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-workflow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-stage ],
        ngm:real-time-rendering,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:virtual-production-pipeline,
        ngm:virtual-production-volume,
        ngm:virtual-production-workflow,
        ngm:virtual-stage ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:vfx-tools,
        ngm:volumetric-capture ;
    vc:slug "virtual-production" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:display-hardware,
        ngm:game-engine,
        ngm:motion-capture,
        ngm:neural-rendering,
        ngm:photogrammetry,
        ngm:real-time-rendering-pipeline .

ngm:yield-farming a owl:Class ;
    rdfs:label "Yield Farming"@en ;
    rdfs:comment "Yield farming is the practice of actively deploying digital assets into decentralised finance protocols—including liquidity pools, lending markets, and staking contracts—to earn token rewards, trading fees, or interest income, and optimising risk-adjusted returns by dynamically reallocating across multiple protocols. Participants typically receive liquidity provider tokens representing their pool share, which can themselves be deposited into other protocols to compound rewards, creating layered risk exposure. Yield farming strategies are sensitive to smart contract risk, impermanent loss, reward token price volatility, and regulatory classification of token distributions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-finance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:governance-token,
        ngm:liquidity-mining ;
    vc:requires ngm:decentralised-finance,
        ngm:liquidity-pool ;
    vc:slug "yield-farming" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:liquidity-provision .

ngm:api-standard a owl:Class ;
    rdfs:label "API Standard"@en ;
    rdfs:comment "Specification defining how independent software components communicate within metaverse systems, establishing protocols and data formats for interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-protocol ],
