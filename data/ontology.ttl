    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:consensus-mechanism,
        ngm:delegate-democracy,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake ;
    vc:slug "delegated-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:epoch,
        ngm:governance-token,
        ngm:validator-set .

