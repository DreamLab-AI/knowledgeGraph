ngm:inflation-hedge a owl:Class ;
    rdfs:comment "An inflation hedge is an asset expected to retain or increase its value as the general price level rises, protecting purchasing power. Commonly cited examples include gold, real estate and index-linked bonds."@en ;
    rdfs:label "Inflation Hedge"@en ;
    rdfs:subClassOf ngm:store-of-value ;
    vc:bridgesTo ngm:gold ;
    vc:bridgesTo ngm:inflation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "inflation-hedge" ;
    vc:sourceDomain "finance" .
ngm:inflation-hedging a owl:Class ;
    rdfs:comment "Inflation hedging is an investment strategy that protects the real value of capital against the erosion of purchasing power caused by rising consumer prices. It allocates wealth to assets whose nominal value tends to rise with or outpace inflation, such as commodities, real estate, inflation-linked bonds, and scarce stores of value. Both gold and Bitcoin are frequently cited as inflation hedges because their supply is constrained relative to fiat currency issuance."@en ;
    rdfs:label "Inflation Hedging"@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:relatedTo ngm:gold ;
    vc:slug "inflation-hedging" ;
    vc:sourceDomain "blockchain" .
