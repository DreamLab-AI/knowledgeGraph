    vc:slug "error-recovery" ;
    vc:sourceDomain "distributed-systems" .
ngm:error-signal a owl:Class ;
    rdfs:comment "An error signal is the quantity in a feedback control system representing the instantaneous difference between the reference setpoint and the actual measured output. It is the driving input to the controller, which acts to reduce it toward zero. The error signal's magnitude, rate of change, and accumulated value are processed by proportional, derivative, and integral control terms respectively."@en ;
    rdfs:label "Error Signal"@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
