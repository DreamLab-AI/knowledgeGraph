ngm:iot-platform a owl:Class ;
    rdfs:comment "A managed software layer that connects fleets of physical devices to applications and analytics, providing device provisioning and identity, secure bidirectional messaging, telemetry ingestion, rule-based event processing, over-the-air updates, and digital twin state management, so that organisations can operate heterogeneous sensor and actuator networks at scale without building the connectivity, security, and data-pipeline plumbing themselves."@en ;
    rdfs:label "IoT Platform"@en ;
    rdfs:subClassOf ngm:cloud-computing ;
    rdfs:subClassOf _:r12883 ;
