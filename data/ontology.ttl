ngm:cyber-physical-systems-domain a owl:Class ;
    rdfs:label "Cyber Physical Systems Domain"@en ;
    rdfs:comment "The Cyber Physical Systems Domain classifies concepts for engineered systems in which computation and networking are tightly coupled with physical processes through sensing and actuation. It covers control loops, embedded computing, and the integration of digital models with physical behaviour. As a subject classification under the Robotics Domain, it scopes the joint design of the computational and physical elements rather than the mechanical platform alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-networks ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-control-loop ],
        ngm:robotics-domain ;
    vc:enables ngm:autonomous-control,
        ngm:condition-monitoring,
        ngm:industrial-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator-system,
        ngm:digital-twin,
        ngm:embedded-control-system,
        ngm:real-time-control-loop,
        ngm:sensor-networks ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:networking-domain,
        ngm:real-time-computing,
        ngm:sensing-infrastructure ;
    vc:slug "cyber-physical-systems-domain" ;
    vc:sourceDomain "cyber-physical-systems" .

