ngm:ibm-food-trust a owl:Class ;
    rdfs:label "IBM Food Trust"@en ;
    rdfs:comment "IBM Food Trust is a permissioned blockchain network, built on Hyperledger Fabric, that enables food industry participants — growers, processors, distributors, retailers, and regulators — to digitally record, share, and verify supply chain events from farm to shelf. By anchoring provenance records in an immutable distributed ledger, it supports rapid traceability during food safety incidents, reduces waste through better freshness visibility, and builds consumer confidence in product origin claims. The platform operates as a multi-party ecosystem in which each participant controls the data they contribute while selectively sharing access with downstream trading partners. Walmart, Carrefour, Nestlé, and other major retailers have deployed it to meet regulatory traceability mandates such as the US FDA Food Safety Modernization Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:permissioned-blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hyperledger-fabric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:supply-chain ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:erp-system,
        ngm:iot-sensor ;
    vc:contrastsWith ngm:centralized-database,
        ngm:public-blockchain ;
    vc:enables ngm:food-safety,
        ngm:provenance-verification,
        ngm:recall-management,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:implements ngm:food-safety-modernization-act,
        ngm:gs1-standards ;
    vc:isPartOf ngm:food-supply-chain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:ethereum,
        ngm:non-fungible-token ;
    vc:requires ngm:digital-identity,
        ngm:hyperledger-fabric,
        ngm:permissioned-blockchain ;
    vc:slug "ibm-food-trust" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:regulatory-compliance,
        ngm:sustainability-reporting ;
    vc:uses ngm:api-gateway,
        ngm:consensus-mechanism,
        ngm:cryptographic-hash .

