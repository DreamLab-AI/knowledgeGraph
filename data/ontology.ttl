ngm:asymmetric-encryption a owl:Class ;
    rdfs:label "Asymmetric Encryption"@en ;
    rdfs:comment "A cryptographic system using mathematically related public-private key pairs where the public key encrypts data that only the corresponding private key can decrypt."@en ;
