    owl:someValuesFrom tc:CryptographicKeys
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom tc:SmartContracts
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:TrustlessCoordination
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:DecentralisedGovernance
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:TransparentDecisionMaking
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:CryptocurrencyPayments
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:TELE252daogovernancetelecollaboration
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:TELE251smartcontractcoordination
] .

tc:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:TELE253cryptocurrencyremuneration
] .

# Smart Contract Coordination
tc:SmartContractCoordination a owl:Class ;
    rdfs:label "Smart Contract Coordination"@en ;
    rdfs:comment "\"The use of blockchain smart contracts—self-executing programs stored on distributed ledgers—to automate coordination, task allocation, payment distribution, and milestone verification in distributed teams, enabling trustless collaboration through cryptographically enforced agreements that execute deterministically without centralised intermediaries.\""@en ;
    skos:prefLabel "Smart Contract Coordination"@en ;
    dcterms:identifier "TC-0251" ;
    dcterms:subject "tc" ;
    dcterms:type "developing" ;
    rdf:type owl:ProcessClass .

# DAO Governance for Telecollaboration
tc:DAOGovernanceForTelecollaboration a owl:Class ;
    rdfs:label "DAO Governance for Telecollaboration"@en ;
    rdfs:comment "\"The application of decentralised autonomous organisation (DAO) governance mechanisms—token-weighted voting, proposal systems, treasury management—to coordinate geographically distributed teams through on-chain decision-making, enabling democratic, transparent collaboration without centralised management or hierarchical authority structures.\""@en ;
    skos:prefLabel "DAO Governance for Telecollaboration"@en ;
    dcterms:identifier "TC-0252" ;
    dcterms:subject "tc" ;
    dcterms:type "developing" ;
    rdf:type owl:ProcessClass .

# Cryptocurrency Remuneration
tc:CryptocurrencyRemuneration a owl:Class ;
    rdfs:label "Cryptocurrency Remuneration"@en ;
    rdfs:comment "\"The payment of remote workers, freelancers, or distributed team members in cryptocurrency (Bitcoin, Ethereum, stablecoins) rather than traditional fiat currency, enabling borderless, instant, low-fee transactions that bypass traditional banking systems whilst providing financial inclusion for unbanked populations and facilitating blockchain-based collaboration.\""@en ;
    skos:prefLabel "Cryptocurrency Remuneration"@en ;
    dcterms:identifier "TC-0253" ;
    dcterms:subject "tc" ;
    dcterms:type "developing" ;
    rdf:type owl:ProcessClass .

# Digital Twin Collaboration
tc:DigitalTwinCollaboration a owl:Class ;
    rdfs:subClassOf tc:DigitalTwin ;
    rdfs:subClassOf tc:TELE002telecollaboration ;
    rdfs:label "Digital Twin Collaboration"@en ;
    rdfs:comment "\"The use of shared virtual replicas of physical assets, processes, or environments as collaborative workspaces where geographically distributed teams simultaneously inspect, analyse, simulate, and modify digital representations synchronised with real-world counterparts through sensor data streams, enabling remote collaboration on physical systems.\""@en ;
    skos:prefLabel "Digital Twin Collaboration"@en ;
    dcterms:identifier "TC-0300" ;
    dcterms:subject "tc" ;
    dcterms:type "developing" ;
    rdf:type owl:ObjectClass .

tc:DigitalTwinCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom tc:SensorData
] .

