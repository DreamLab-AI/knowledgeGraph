ngm:worldcoin a owl:Class ;
    rdfs:label "Worldcoin"@en ;
    rdfs:comment "A digital identity and cryptocurrency project that uses iris biometrics to produce a cryptographic proof of unique human personhood, enabling sybil-resistant participation in online systems and distributing an associated cryptocurrency token."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
