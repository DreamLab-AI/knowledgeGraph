    vc:slug "admittance-control" ;
    vc:sourceDomain "robotics" .

ngm:affordance a owl:Class ;
    rdfs:label "Affordance"@en ;
    rdfs:comment "An affordance is a property of an object or environment that signals the actions it makes possible to a perceiving agent, mediating the relationship between the agent's capabilities and the world. Originating in ecological psychology, the concept was adapted to design to describe how the perceptible features of an interface or physical artefact suggest how it can be used. In spatial and interactive computing, affordances guide users towards available actions, and perceived affordances are deliberately engineered so that controls and gestures feel discoverable and natural."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception ],
        ngm:interaction-design ;
    vc:dependsOn ngm:perception,
        ngm:scene-understanding ;
    vc:enables ngm:gesture-recognition,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:perception,
        ngm:usability ;
    vc:isPartOf ngm:human-computer-interaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:cognitive-load,
        ngm:ergonomics,
        ngm:virtual-reality ;
    vc:slug "affordance" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:user-interface ;
    vc:uses ngm:user-centred-design .

ngm:agentic-rag a owl:Class ;
    rdfs:label "Agentic RAG"@en ;
    rdfs:comment "Agentic RAG is an architecture that augments retrieval-augmented generation with an autonomous agent loop, letting a language model plan, decide when and what to retrieve, issue multiple queries across heterogeneous sources, reflect on retrieved evidence quality, reformulate queries, and verify results before generating a final response. Unlike the single-pass retrieve-then-read pipeline of naive RAG, Agentic RAG treats retrieval as a first-class action in a multi-step reasoning cycle, enabling resolution of multi-hop questions, adaptive source selection, self-correction, and iterative evidence accumulation under agent-controlled stopping criteria."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-orchestrator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:information-retrieval,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:rag-pipeline ;
    vc:dependsOn ngm:agentic-ai,
        ngm:foundation-models,
        ngm:rag-pipeline ;
    vc:enables ngm:hallucination-mitigation,
        ngm:knowledge-grounding,
        ngm:multi-hop-reasoning,
        ngm:question-answering,
        ngm:source-attribution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent-orchestrator,
        ngm:corrective-rag,
        ngm:query-rewriting,
        ngm:retrieval-grader,
        ngm:self-rag ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:agentic-workflow,
        ngm:enterprise-search,
        ngm:graph-rag,
        ngm:natural-language-processing,
        ngm:orchestration,
        ngm:rag-pipeline,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:requires ngm:agent-loop,
        ngm:embedding-model,
        ngm:large-language-models,
        ngm:retrieval-augmented-generation,
        ngm:vector-database ;
    vc:slug "agentic-rag" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:dense-retrieval,
        ngm:function-calling,
        ngm:hybrid-retrieval,
        ngm:knowledge-graph,
        ngm:reranking .

