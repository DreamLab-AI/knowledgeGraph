ngm:contract-code a owl:Class ;
    rdfs:comment "Contract code is the executable program logic that defines the rules, state, and behaviour of a smart contract deployed on a distributed ledger. It is typically written in a high-level language such as Solidity or Kotlin and compiled to bytecode that nodes execute deterministically. Because it is immutable once deployed and controls value, contract code is a primary target for auditing and formal verification."@en ;
    rdfs:label "Contract Code"@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:r3-corda ;
    vc:slug "contract-code" ;
    vc:sourceDomain "blockchain" .
ngm:contract-enforcement a owl:Class ;
    rdfs:comment "Contract enforcement is the set of legal, procedural, and technological mechanisms by which the obligations set out in an agreement are made binding and are upheld when a party fails to perform, ranging from courts and arbitration to automated on-chain execution. Traditional enforcement relies on dispute resolution processes and judicial remedies, whereas digital and blockchain-based approaches encode enforcement logic directly into self-executing code or arbitration protocols. Effective contract enforcement is a precondition for trust in both commercial transactions and decentralised digital agreements."@en ;
    rdfs:label "Contract Enforcement"@en ;
    rdfs:subClassOf ngm:dispute-resolution ;
    rdfs:subClassOf _:r5681 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:dispute-resolution ;
    vc:slug "contract-enforcement" ;
    vc:sourceDomain "governance" .
ngm:contract-law a skos:Concept ;
    rdfs:label "Contract Law"@en .
ngm:contract-law-frameworks a skos:Concept ;
    rdfs:label "Contract Law Frameworks"@en .
ngm:contract-net-protocol a owl:Class ;
    rdfs:comment "The Contract Net Protocol is a task-sharing interaction pattern for multi-agent systems in which a manager agent announces a task, soliciting bids from potential contractor agents, evaluates the responses, and awards the task to the most suitable bidder. It decomposes distributed problem solving into the phases of announcement, bidding, awarding, and result reporting, treating the agent population as a market for negotiating the allocation of work. The protocol provides a decentralised mechanism for dynamic task allocation without a fixed assignment table."@en ;
    rdfs:label "Contract Net Protocol"@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    rdfs:subClassOf ngm:multi-agent-system ;
    rdfs:subClassOf _:r5682 ;
    rdfs:subClassOf _:r5683 ;
