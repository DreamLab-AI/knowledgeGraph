ngm:geospatial-information a owl:Class ;
    rdfs:comment "Geospatial Information is data that describes objects, events, or phenomena with reference to a location on or near the Earth's surface. It integrates coordinate systems, geographic data layers, and spatial analytics to support location-aware applications including digital twins, augmented reality overlays, and urban simulation."@en ;
    rdfs:label "Geospatial Information"@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
