        ngm:document-management ;
    vc:enables ngm:decision-support-system,
        ngm:organisational-learning,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:community-of-practice,
        ngm:knowledge-audit,
        ngm:knowledge-repository,
        ngm:lessons-learned ;
    vc:qualityScore "0.72"^^xsd:float ;
