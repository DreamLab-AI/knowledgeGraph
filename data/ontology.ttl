        ngm:hyperledger-besu,
        ngm:ibft-consensus,
        ngm:permissioning-framework,
        ngm:private-transaction-manager,
        ngm:qbft-consensus,
        ngm:raft-consensus,
        ngm:solidity,
        ngm:tessera ;
    vc:implements ngm:enterprise-ethereum-alliance-specification,
