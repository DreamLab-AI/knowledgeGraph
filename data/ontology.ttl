ngm:real-time-operating-system a owl:Class ;
    rdfs:label "Real-Time Operating System"@en ;
    rdfs:comment "A Real-Time Operating System (RTOS) is an operating system designed to service computational tasks within guaranteed, bounded time constraints, providing temporal determinism that makes it the foundational software substrate for safety-critical and time-sensitive embedded applications. RTOSes implement priority-based preemptive scheduling, bounded interrupt latency, and synchronisation primitives (semaphores, mutexes, message queues) that ensure predictable worst-case task-switching behaviour irrespective of system load. They are classified as hard real-time — where any deadline miss constitutes a system failure — or soft real-time, where occasional misses cause graceful degradation rather than catastrophic failure. Deployed in medical devices, industrial controllers, automotive electronics, avionics, and robotics, RTOSes underpin every domain in which a missed computational deadline can cause physical harm, financial loss, or mission failure."@en ;
    rdfs:subClassOf ngm:operating-system ;
    vc:bridgesTo ngm:cyber-physical-systems,
        ngm:edge-ai ;
    vc:enables ngm:real-time,
        ngm:real-time-control,
        ngm:real-time-processing,
        ngm:safety-critical-systems,
        ngm:sub-millisecond-latency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interrupt-handler,
        ngm:memory-management-unit ;
    vc:implements ngm:inter-process-communication ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:freertos,
        ngm:robot-operating-system ;
    vc:requires ngm:deterministic-scheduling,
        ngm:worst-case-execution-time ;
    vc:slug "real-time-operating-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:industrial-automation,
        ngm:internet-of-things,
        ngm:motor-driver,
        ngm:robotic-system ;
    vc:uses ngm:embedded-ai-frameworks,
        ngm:latency,
        ngm:message-queue .

ngm:robot-kinematics a owl:Class ;
    rdfs:label "Robot Kinematics"@en ;
    rdfs:comment "Robot Kinematics is the mathematical study of the geometry of robot motion—comprising forward kinematics (mapping joint parameters to end-effector pose) and inverse kinematics (computing joint configurations that achieve a desired pose)—without regard to the forces or torques that produce that motion. It is foundational to robot programming, trajectory planning, and the design of manipulation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-frame ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0023-degrees-of-freedom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:denavit-hartenberg-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:contrastsWith ngm:robot-dynamics ;
    vc:enables ngm:end-effector,
        ngm:motion-planning,
        ngm:robot-programming,
        ngm:sensor-fusion,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:denavit-hartenberg-parameters,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:jacobian-matrix ;
    vc:isPartOf ngm:robot-dynamics,
        ngm:robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot,
        ngm:manipulator,
        ngm:service-robot,
        ngm:soft-robotics,
        ngm:surgical-robot ;
    vc:requires ngm:coordinate-frame,
