ngm:compliance-monitoring a owl:Class ;
    rdfs:label "Compliance Monitoring"@en ;
    rdfs:comment "Compliance Monitoring is the continuous, automated oversight of systems, processes, people, and data flows to verify ongoing adherence to applicable regulatory requirements, internal policies, contractual obligations, and technical standards across the full operational surface area of an organisa..."@en ;
