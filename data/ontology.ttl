ngm:certificate-revocation a owl:Class ;
    rdfs:comment "Certificate Revocation is the process by which a Certificate Authority (CA) invalidates a previously issued digital certificate before its natural expiry, typically due to key compromise, CA compromise, or change in the certificate holder's status. Revocation information is distributed via Certificate Revocation Lists (CRLs) or the Online Certificate Status Protocol (OCSP). It is a critical component of public key infrastructure (PKI) lifecycle management."@en ;
    rdfs:label "Certificate Revocation"@en ;
    rdfs:subClassOf ngm:security ;
    rdfs:subClassOf _:r4154 ;
    rdfs:subClassOf _:r4155 ;
