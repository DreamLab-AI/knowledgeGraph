ngm:garbled-circuits a owl:Class ;
    rdfs:label "Garbled Circuits"@en ;
    rdfs:comment "Garbled Circuits is a cryptographic technique, introduced by Yao in 1986, that enables two-party secure computation by encoding a Boolean circuit such that one party (the garbler) produces an encrypted representation of the circuit and the other party (the evaluator) can compute the output without learning the garbler's private inputs. Each gate of the circuit is replaced by a garbled truth table consisting of four ciphertexts, and the evaluator decrypts exactly one row per gate using wire labels obtained through [[Oblivious Transfer]]. Modern optimisations — including Free XOR, Half Gates, and Three Halves — reduce the communication and computation overhead to practical levels. Garbled circuits are foundational to general-purpose [[Multi-Party Computation]] and form the basis of many practical secure function evaluation protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:oblivious-transfer ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:homomorphic-encryption-for-machine-learning ;
    vc:contrastsWith ngm:homomorphic-encryption,
        ngm:zero-knowledge-proof ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:cryptographic-key ;
    vc:enables ngm:privacy-preserving-machine-learning,
        ngm:secure-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-primitive,
        ngm:oblivious-transfer ;
    vc:implements ngm:multi-party-computation,
        ngm:privacy-preserving-computation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:secure-aggregation ;
    vc:slug "garbled-circuits" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy-preserving-analytics ;
    vc:uses ngm:cryptographic-commitment,
        ngm:cryptographic-protocol,
        ngm:oblivious-transfer .

ngm:geometry a skos:Concept ;
    rdfs:label "Geometry"@en .

ngm:gfpgan a owl:Class ;
    rdfs:label "GFPGAN"@en ;
    rdfs:comment "GFPGAN (Generative Facial Prior GAN) is a practical deep-learning model for blind face restoration that leverages the rich facial priors encoded in a pretrained StyleGAN to recover realistic detail from degraded portraits. It restores resolution, removes artefacts, and reconstructs plausible facial features in a single forward pass. It is widely used in photo restoration and as a face-enhancement component in image and video pipelines."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:face-swap,
        ngm:image-and-video-restoration ;
    vc:slug "gfpgan" ;
    vc:sourceDomain "ai" .

ngm:gibbs-sampling a owl:Class ;
    rdfs:label "Gibbs Sampling"@en ;
    rdfs:comment "Gibbs sampling is a Markov chain Monte Carlo algorithm that draws samples from a multivariate distribution by iteratively sampling each variable from its full conditional distribution given the current values of all others. It is a special case of Metropolis-Hastings in which every proposal is accepted, and it requires the conditionals to be tractable. Gibbs sampling is widely used for posterior inference in hierarchical and graphical models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphical-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        ngm:markov-chain-monte-carlo ;
    vc:contrastsWith ngm:variational-inference ;
    vc:enables ngm:bayesian-inference,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:markov-chain-monte-carlo ;
    vc:isPartOf ngm:markov-chain-monte-carlo ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:markov-chain,
        ngm:sampling,
        ngm:stochastic-process ;
    vc:requires ngm:graphical-model,
        ngm:probabilistic-model ;
    vc:slug "gibbs-sampling" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:inference,
        ngm:posterior-distribution ;
    vc:uses ngm:markov-chain,
        ngm:probability-distribution .

