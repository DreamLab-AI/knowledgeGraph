    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SceneGraph
] .

# C2PA Standard
mv:C2paStandard a owl:Class ;
    rdfs:subClassOf mv:TechnicalStandard ;
    rdfs:label "C2PA Standard"@en ;
    rdfs:comment "An open technical standard developed by the Coalition for Content Provenance and Authenticity that establishes cryptographically-signed Content Credentials to certify the origin, history, and authenticity of digital media, functioning like a tamper-evident nutrition label for digital content."@en ;
    skos:prefLabel "C2PA Standard"@en ;
    dcterms:identifier "MV-9802" ;
    dcterms:subject "mv" .

mv:C2paStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:CryptographicSigning
] .

mv:C2paStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:MetadataFramework
] .

mv:C2paStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:TrustModel
] .

mv:C2paStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ContentProvenance
] .

