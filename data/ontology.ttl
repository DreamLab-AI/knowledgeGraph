ngm:trust-building a owl:Class ;
    rdfs:comment "Trust building is the deliberate process of establishing confidence among participants in a digital system through transparency, accountability, reliable behaviour, and clear communication. In online communities and AI-mediated platforms it is fostered by practices such as content provenance, disclosure of automated generation, and enforced community standards that make actors and outputs verifiable."@en ;
    rdfs:label "Trust Building"@en ;
    rdfs:subClassOf ngm:governance ;
