ngm:privacy-filter a owl:Class ;
    rdfs:label "Privacy Filter"@en ;
    rdfs:comment "A sidecar service (ADR-008) that sanitises agent outputs before emission to [[Nostr Relay|Nostr relays]] or [[Federation Surface|federation surfaces]], redacting personally identifiable information (PII), secrets, and regulated data, whilst maintaining data utility for downstream consumers and le..."@en ;
    rdfs:subClassOf ngm:security-layer ;
    vc:enables ngm:compliance-with-ccpa,
        ngm:compliance-with-gdpr,
        ngm:data-minimisation,
        ngm:privacy-preservation,
        ngm:selective-disclosure ;
    vc:hasPart ngm:audit-trail,
        ngm:pattern-matching,
        ngm:pii-detection,
        ngm:policy-enforcement,
        ngm:redaction-engine ;
    vc:implements ngm:data-anonymisation,
        ngm:privacy-preserving-data-emission,
        ngm:redaction-policies ;
    vc:maturity "established" ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:requires ngm:classification-rules,
        ngm:machine-learning-optional,
        ngm:privacy-policy,
        ngm:regular-expressions ;
    vc:slug "privacy-filter" ;
    vc:sourceDomain "infrastructure" .

