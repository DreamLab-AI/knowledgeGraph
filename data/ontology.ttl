vf:time-series-forecasting a owl:Class ;
    rdfs:label "Time Series Forecasting"@en ;
    rdfs:comment "Time Series Forecasting (TSF) is the domain of statistical and machine learning methods that predict future values of ordered sequential observations indexed by time, encompassing classical statistical approaches (ARIMA — AutoRegressive Integrated Moving Average — modelling the series as a linear combination of its own past values and past forecast errors with parameters (p,d,q) fitted by maximum likelihood or least squares; SARIMA extending ARIMA with seasonal (P,D,Q)_s components for recurring periodic patterns; ETS — Error-Trend-Seasonality — state space exponential smoothing with 30 possible model combinations selected via AIC/BIC; Prophet (Taylor and Letham 2018, Meta) decomposing into piecewise-linear or logistic growth trend, Fourier-series seasonality and sparse holiday regressors), deep learning architectures (DeepAR (Salinas et al. 2020, Amazon) — autoregressive LSTM outputting parametric probabilistic distributions trained globally across thousands of related series; N-BEATS (Oreshkin et al. 2020, Element AI) — purely residual MLP stack with forward/backward basis expansion achieving M4-competition accuracy without recurrence or attention; N-HiTS (Challu et al. 2023) — h"@en ;
    rdfs:subClassOf <urn:visionflow:linked:probabilistic-forecasting>,
        <urn:visionflow:linked:sequential-data-processing>,
        <urn:visionflow:linked:statistical-modelling>,
        vf:machine-learning,
        vf:predictive-analytics ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:anomaly-detection>,
        <urn:visionflow:linked:automated-reporting>,
        <urn:visionflow:linked:capacity-planning>,
        <urn:visionflow:linked:decision-support>,
        <urn:visionflow:linked:demand-planning>,
        <urn:visionflow:linked:risk-quantification>,
        <urn:visionflow:linked:scenario-analysis> ;
    vc:hasPart <urn:visionflow:linked:covariates>,
        <urn:visionflow:linked:evaluation-metric>,
        <urn:visionflow:linked:forecast-horizon>,
        <urn:visionflow:linked:interval-forecast>,
        <urn:visionflow:linked:lookback-window>,
        <urn:visionflow:linked:point-forecast>,
        <urn:visionflow:linked:probabilistic-forecast>,
        <urn:visionflow:linked:reconciliation-step> ;
    vc:implements <urn:visionflow:linked:arima>,
        <urn:visionflow:linked:exponential-smoothing>,
        <urn:visionflow:linked:hierarchical-reconciliation>,
        <urn:visionflow:linked:lstm>,
        <urn:visionflow:linked:normalising-flows>,
        <urn:visionflow:linked:quantile-regression>,
        <urn:visionflow:linked:state-space-models>,
        <urn:visionflow:linked:transformer-attention> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:cross-validation-strategy>,
        <urn:visionflow:linked:forecast-evaluation-protocol>,
        <urn:visionflow:linked:historical-time-series-data>,
        <urn:visionflow:linked:stationarity-analysis>,
        vf:compute-infrastructure ;
    vc:slug "time-series-forecasting" ;
    vc:sourceDomain "artificial-intelligence" .

