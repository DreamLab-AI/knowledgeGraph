    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:EdgeComputing
] .

mv:PhysicalNetworkHardware rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:5GNetworks
] .

mv:PhysicalNetworkHardware rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:NetworkFunctionVirtualization
] .

# Physical Virtual Registration
mv:PhysicalVirtualRegistration a owl:Class ;
    rdfs:subClassOf mv:SpatialComputing ;
    rdfs:label "Physical Virtual Registration"@en ;
    rdfs:comment "The process of aligning and synchronizing virtual content with physical world coordinates using spatial tracking, computer vision, and sensor fusion to ensure accurate overlay of digital objects in augmented reality environments."@en ;
    skos:prefLabel "Physical Virtual Registration"@en ;
    dcterms:identifier "MV-10007" ;
    dcterms:subject "mv" .

mv:PhysicalVirtualRegistration rdfs:subClassOf [
    a owl:Restriction ;
