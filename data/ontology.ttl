ngm:layer-2-scaling a owl:Class ;
    rdfs:label "Layer 2 Scaling"@en ;
    rdfs:comment "Layer 2 scaling refers to a category of protocols and systems built atop an existing blockchain (Layer 1) that increase transaction throughput and reduce fees by processing computation and data storage off the main chain while inheriting the security guarantees of the underlying Layer 1 through cryptographic proofs, fraud-proof mechanisms, or periodic state commitments. The Layer 2 anchors itself to the Layer 1 by periodically publishing compressed state roots or validity proofs, enabling the Layer 1 to serve as the ultimate settlement and security layer while the Layer 2 handles high-volume transaction processing. Major architectural families include ZK-rollups, optimistic rollups, state channels, and sidechains, each offering distinct trade-offs between latency, security assumptions, and EVM compatibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimistic-rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:blockchain-scalability ;
    vc:bridgesTo ngm:cryptographic-commitment,
        ngm:distributed-computing ;
    vc:contrastsWith ngm:layer-1-blockchain,
        ngm:sharding ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:ethereum ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:decentralised-finance,
        ngm:gas-optimization,
        ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lightning-network,
        ngm:optimistic-rollup,
        ngm:sidechain,
        ngm:state-channel,
        ngm:zk-rollup ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-availability-sampling,
        ngm:eip-4844 ;
    vc:requires ngm:data-availability,
        ngm:merkle-tree,
        ngm:smart-contract ;
    vc:slug "layer-2-scaling" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:fraud-proof,
        ngm:hash-time-locked-contract,
        ngm:sequencer,
        ngm:zero-knowledge-proof .

ngm:mechanism-design a owl:Class ;
    rdfs:label "Mechanism Design"@en ;
    rdfs:comment "Mechanism design, sometimes called reverse game theory, is a field of economics and game theory concerned with constructing the rules, incentive structures, and institutional frameworks of strategic interactions so that self-interested participants collectively produce socially desirable outcomes. Starting from a target social choice function rather than from a given game, the designer works backwards to identify what game structure (the mechanism) would implement that function as an equilibrium for rational agents. Mechanism design underpins auction theory, voting systems, market design, and cryptoeconomic protocol engineering, and has been central to Nobel-Prize-recognised work by Hurwicz, Maskin, and Myerson. Its principles govern token incentive structures, automated market makers, governance protocols, and public-goods funding schemes across decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-asymmetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incentive-compatibility ],
        ngm:game-theory ;
    vc:bridgesTo ngm:cryptoeconomics,
        ngm:multi-agent-systems,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:algorithmic-game-theory,
        ngm:behavioural-economics ;
    vc:enables ngm:auction-theory,
        ngm:incentive-alignment,
        ngm:on-chain-governance,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:incentive-compatibility,
        ngm:revelation-principle,
        ngm:social-choice-function,
        ngm:strategy-proofness ;
    vc:implements ngm:dominant-strategy-equilibrium,
        ngm:vickrey-clarke-groves-mechanism ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:market-design,
        ngm:public-goods,
        ngm:token-economics,
        ngm:voting-mechanism ;
    vc:requires ngm:game-theory,
        ngm:information-asymmetry,
        ngm:rational-agent ;
    vc:slug "mechanism-design" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:bayesian-game,
        ngm:contract-theory,
        ngm:nash-equilibrium .

ngm:microservices-architecture a owl:Class ;
    rdfs:label "Microservices Architecture"@en ;
    rdfs:comment "A distributed software architecture pattern that decomposes applications into independent, loosely coupled services communicating via APIs, enabling high concurrency, scalability, and resilience through containerisation technologies like Docker and orchestration platforms like Kubernetes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container-orchestration ],
