        ngm:physics-simulation .

ngm:end-to-end-encryption a owl:Class ;
    rdfs:label "End-to-End Encryption"@en ;
    rdfs:comment "End-to-end encryption (E2EE) is a communication security model in which data is encrypted on the sender's device and can only be decrypted by the intended recipient's device, ensuring that no intermediate party—including service providers, network operators, or infrastructure owners—can access the plaintext content. It combines asymmetric key exchange with symmetric session encryption to provide confidentiality, integrity, and authenticity without trusting intermediaries."@en ;
    rdfs:subClassOf ngm:encryption ;
    vc:enables ngm:privacy,
