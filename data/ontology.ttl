    vc:requires ngm:actuator ;
    vc:slug "compliant-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control .

ngm:component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A discrete, modular unit within an AI system or infrastructure that provides a specific capability, can be developed and tested independently, and interacts with other components through defined interfaces. Components include hardware accelerators, software modules, model artefacts, data pipelines, and monitoring subsystems."@en ;
