ngm:differential-drive-robot a owl:Class ;
    rdfs:label "Differential Drive Robot"@en ;
    rdfs:comment "Differential drive robot uses two independently controlled wheels on opposite sides to enable both forward/backward locomotion and in-place rotation, forming the most widely deployed Mobile Robot architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:odometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motor-driver ],
        ngm:robo-robot-type,
        ngm:wheeled-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:motor-driver,
        ngm:odometry ;
    vc:slug "differential-drive-robot" ;
    vc:sourceDomain "robotics" .

ngm:differentiated-instruction a skos:Concept ;
    rdfs:label "Differentiated Instruction"@en .

ngm:difficulty-target a owl:Class ;
    rdfs:label "Difficulty Target"@en ;
    rdfs:comment "A 256-bit threshold value in proof-of-work blockchains that a block's hash must be numerically less than or equal to for the block to be considered valid. The difficulty target is periodically recalculated by the Difficulty Adjustment algorithm to maintain a consistent average inter-block time regardless of changes in aggregate hash power. It is the primary mechanism by which mining difficulty is quantified and enforced across all network participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nonce ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:consensus-rule,
        ngm:network-hash-rate ;
    vc:enables ngm:blockchain-network,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:block-reward,
        ngm:blockchain-energy-consumption,
        ngm:halving,
        ngm:hash-function,
        ngm:merkle-root,
        ngm:mining-pool ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:nonce,
        ngm:proof-of-work ;
    vc:slug "difficulty-target" ;
    vc:sourceDomain "blockchain" .

ngm:digital-art-application a owl:Class ;
    rdfs:label "Digital Art Application"@en ;
    rdfs:comment "Software platforms and tools enabling artists to create, manipulate, and distribute visual art using digital technologies, including generative AI systems, 3D modeling software, and NFT minting platforms that facilitate artistic expression and commerce in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-systems ],
        ngm:creative-software,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-art-creation,
        ngm:nft-minting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:graphics-processing,
        ngm:storage-systems,
        ngm:user-interface ;
    vc:slug "digital-art-application" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-asset-governance a owl:Class ;
    rdfs:label "Digital Asset Governance"@en ;
    rdfs:comment "Digital asset governance is the set of rules, processes, and authority structures by which tokenised assets and the protocols managing them are controlled, upgraded, and held accountable across their lifecycle. It spans on-chain governance via governance tokens and DAOs, custody and key-management policy, token-standard conformance, and alignment with external regulatory and compliance regimes. By defining who may change parameters, mint or burn supply, and adjudicate disputes, it determines the legitimacy, security, and resilience of digital-asset systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        ngm:decentralized-governance ;
    vc:bridgesTo ngm:regulatory-compliance,
        ngm:tokenization ;
    vc:dependsOn ngm:smart-contract ;
    vc:enables ngm:asset-tokenization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:custody,
        ngm:governance-token ;
    vc:implements ngm:token-governance ;
    vc:isPartOf ngm:asset-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crypto-asset,
        ngm:digital-asset,
        ngm:nft ;
    vc:requires ngm:compliance,
        ngm:token-standard ;
    vc:slug "digital-asset-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:regulatory-compliance ;
    vc:uses ngm:dao,
        ngm:on-chain-governance .

ngm:digital-asset-risks a owl:Class ;
    rdfs:label "Digital Asset Risks"@en ;
    rdfs:comment "Comprehensive analysis of risks associated with digital assets, particularly Bitcoin, encompassing technical vulnerabilities, regulatory challenges, geopolitical concerns, financial stability threats, and systemic implications for global monetary systems. Covers attack vectors such as 51% attacks, selfish mining, network partitioning, exchange failures, and regulatory suppression, alongside macro-level risks including volatility, liquidity crises, and stablecoin depegging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:cryptocurrency,
        ngm:risk-management ;
    vc:requires ngm:fraud-detection,
        ngm:regulatory-compliance ;
    vc:slug "digital-asset-risks" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cybersecurity .

ngm:digital-collectible a owl:Class ;
    rdfs:label "Digital Collectible"@en ;
    rdfs:comment "A digital collectible is a uniquely identifiable digital item whose scarcity, ownership and authenticity are recorded on a blockchain, allowing it to be owned, displayed and traded much like a physical collectible. Typically issued as a non-fungible token or an inscription, each collectible carries provenance and metadata that distinguish it from copies of the same media. Digital collectibles span art, trading cards, in-game items and membership artefacts, and they form a core consumer use case for blockchain-based digital assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-art ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:non-fungible-token ;
    vc:bridgesTo ngm:bitcoin,
        ngm:ethereum ;
    vc:enables ngm:nft-marketplace,
        ngm:utility-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-art,
        ngm:metadata ;
    vc:isPartOf ngm:digital-asset ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:nft,
        ngm:ordinals,
        ngm:smart-contract ;
    vc:requires ngm:blockchain,
        ngm:provenance ;
    vc:slug "digital-collectible" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-art,
        ngm:provenance ;
    vc:uses ngm:inscription,
        ngm:token-standard .

ngm:digital-content-overlay a owl:Class ;
    rdfs:label "Digital Content Overlay"@en ;
    rdfs:comment "Digital Content Overlay is a type of Augmented Reality in the spatial computing domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
