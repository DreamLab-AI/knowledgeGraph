            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        ngm:crypto-token ;
    vc:bridgesTo ngm:crowdfunding,
        ngm:securities-law ;
    vc:contrastsWith ngm:initial-public-offering,
        ngm:mi-ca-regulation,
        ngm:venture-capital ;
