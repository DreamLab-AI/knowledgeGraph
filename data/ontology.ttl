        ngm:zephyr .

ngm:real-time-transcription a owl:Class ;
    rdfs:label "Real-time Transcription"@en ;
    rdfs:comment "Real-time transcription is the automated conversion of streaming audio to text with latency sufficiently low (typically below 500 ms word latency) to support synchronous human use cases such as live captioning, voice-controlled interfaces, meeting assistance, and broadcast subtitling. It requires streaming automatic speech recognition (ASR) architectures that produce partial and final hypotheses incrementally as audio frames arrive, rather than processing complete utterances offline. Modern systems combine acoustic models (typically based on conformer or whisper-encoder architectures), language models for hypothesis rescoring, and punctuation/formatting post-processors to produce readable output in real time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:accessibility,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:requires ngm:automatic-speech-recognition,
        ngm:real-time-processing ;
    vc:slug "real-time-transcription" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:regulatory-technology a owl:Class ;
    rdfs:label "Regulatory Technology"@en ;
    rdfs:comment "Regulatory Technology (RegTech) applies digital tools—including AI, machine learning, and distributed ledger systems—to automate and streamline regulatory compliance processes such as KYC/AML checks, audit trail generation, risk reporting, and consent management. In spatial-computing and metaverse contexts, RegTech addresses jurisdiction-sensitive data flows, real-time content moderation, and smart-contract-based enforcement of platform governance rules."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:governance-framework ;
    vc:slug "regulatory-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:compliance-framework,
        ngm:data-protection-regulation ;
    vc:uses ngm:machine-learning,
        ngm:smart-contracts .

ngm:rigid-body-dynamics a owl:Class ;
    rdfs:label "Rigid Body Dynamics"@en ;
    rdfs:comment "Rigid Body Dynamics is a branch of classical mechanics that models objects as non-deformable solids, computing motion, collision response, and momentum conservation through numerical integration. It underpins real-time physics simulation in game engines, robotics, and spatial computing environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-simulation ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:physics-based-animation,
        ngm:physics-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:fluid-simulation ;
    vc:requires ngm:collision-detection,
        ngm:physics-simulation ;
    vc:slug "rigid-body-dynamics" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:real-time-processing .

ngm:robot a owl:Class ;
    rdfs:label "Robot"@en ;
    rdfs:comment "A robot is an actuated mechanism programmable in two or more axes with a degree of autonomy, moving within its environment, to perform intended tasks."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:autonomous-agent,
        ngm:mechatronic-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "robot" ;
    vc:sourceDomain "robotics" .

ngm:ros-2 a owl:Class ;
    rdfs:label "ROS 2"@en ;
    rdfs:comment "ROS 2 (Robot Operating System 2) is an open-source robotics middleware framework developed by Open Robotics that provides a standardised publish-subscribe communication layer built on the DDS (Data Distribution Service) standard, along with a comprehensive ecosystem of drivers, libraries, and tools for sensor integration, motion planning, simulation, and hardware abstraction. ROS 2 supersedes ROS 1 with support for real-time execution, multi-robot systems, production-grade security via DDS-Security, and native Windows and macOS compatibility. It has become the de facto standard software framework for research and increasingly for commercial robotic platforms."@en ;
    rdfs:subClassOf ngm:middleware,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:real-time,
        ngm:simulation-software ;
    vc:slug "ros-2" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:communication-protocol,
        ngm:robot-operating-system .

ngm:safety a owl:Class ;
    rdfs:label "Safety"@en ;
    rdfs:comment "The condition whereby an AI system operates without causing unacceptable risk of physical injury, harm to human health or well-being, damage to property, or harm to the environment, achieved through hazard identification, risk assessment, and implementation of appropriate safeguards."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:hazard-analysis,
        ngm:risk-assessment-ai-0079 ;
    vc:slug "safety" ;
    vc:sourceDomain "spatial-computing" .

ngm:secp256k1 a owl:Class ;
    rdfs:label "secp256k1"@en ;
    rdfs:comment "secp256k1 is a Koblitz elliptic curve defined by the equation y² = x³ + 7 over the 256-bit prime field Fp (where p = 2²⁵⁶ − 2³² − 977), standardised in SEC 2 by the Standards for Efficient Cryptography Group (SECG). It is the cryptographic foundation of Bitcoin and Ethereum, where it underpins the Elliptic Curve Digital Signature Algorithm (ECDSA) used to authenticate transactions and derive public keys from private keys. secp256k1's specific choice of parameters enables unusually efficient computation via the Frobenius endomorphism, making scalar multiplication faster than on comparably secure non-Koblitz curves such as NIST P-256."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-keys,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:slug "secp256k1" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ecdsa,
        ngm:elliptic-curve-cryptography .

ngm:secure-enclave a owl:Class ;
    rdfs:label "Secure Enclave"@en ;
    rdfs:comment "A secure enclave is a hardware-isolated execution environment embedded within a processor that maintains confidentiality and integrity guarantees for code and data even when the host operating system, hypervisor, or other privileged software is compromised. Implemented through technologies such as Intel SGX, ARM TrustZone, and AMD SEV, secure enclaves generate remote attestation proofs allowing verifiers to confirm that specific code is executing within a genuine enclave without trusting the surrounding software stack. They are foundational to confidential computing, trusted execution environments, and privacy-preserving distributed computation."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:cryptographic-key-management,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:hardware-security-module,
        ngm:trusted-execution-environment ;
    vc:slug "secure-enclave" ;
    vc:sourceDomain "infrastructure" .

ngm:security-framework a owl:Class ;
    rdfs:label "Security Framework"@en ;
    rdfs:comment "A Security Framework is a structured set of policies, standards, controls, and procedures that an organisation applies to protect digital assets, infrastructure, and user data from threats. In metaverse and spatial-computing contexts, security frameworks address identity verification, access control, cryptographic integrity, DDoS mitigation, smart-contract auditing, and content-moderation pipelines operating at platform scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:access-control,
        ngm:authentication,
        ngm:cryptography ;
    vc:slug "security-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-governance,
        ngm:privacy-preserving-technology .

ngm:selfish-mining a owl:Class ;
    rdfs:label "Selfish Mining"@en ;
    rdfs:comment "A strategic block-withholding attack in proof-of-work blockchains where a mining pool privately mines a secret chain and selectively publishes blocks to waste the computational work of honest miners, thereby earning a disproportionate share of block rewards relative to its hash-rate contribution. Selfish mining is profitable when the attacker controls more than ~33% of network hash-rate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:consensus-mechanism,
        ngm:decentralization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:bitcoin-mining,
        ngm:double-spending,
        ngm:longest-chain-rule,
        ngm:mining-pool ;
    vc:requires ngm:block,
        ngm:blockchain-network ;
    vc:slug "selfish-mining" ;
    vc:sourceDomain "blockchain" .

ngm:server-sent-events a owl:Class ;
    rdfs:label "Server-Sent Events"@en ;
    rdfs:comment "Server-Sent Events (SSE) is a W3C-standardised unidirectional server-to-client streaming protocol layered on HTTP/1.1 and HTTP/2, enabling servers to push a continuous stream of text-based events to browser or API clients without the bidirectional overhead of WebSockets. Each event is delimited by the text/event-stream MIME type and carries optional id, event, data, and retry fields, supporting automatic reconnection. SSE is widely adopted in AI inference APIs—including the Anthropic and OpenAI streaming endpoints—and in the Model Context Protocol (MCP) transport layer for streaming tool responses."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:model-control-protocols-like-mcp,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:event-driven-architecture ;
    vc:slug "server-sent-events" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:communication-protocol .

ngm:signal-conditioning a owl:Class ;
    rdfs:label "Signal Conditioning"@en ;
    rdfs:comment "Signal conditioning is the processing of raw electrical outputs from sensors — through amplification, filtering, analogue-to-digital conversion, isolation, and calibration — to produce clean, scaled, and calibrated digital representations suitable for downstream control, estimation, and machine-learning algorithms. It sits at the boundary between the physical world and digital processing pipelines, and its quality directly determines the accuracy of perception systems built on top of it. In robotic systems, signal conditioning circuits and firmware handle inputs from IMUs, force-torque sensors, encoders, pressure sensors, and cameras before data is consumed by SLAM, Kalman filters, or neural networks."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:kalman-filter,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accelerometer,
        ngm:signal-processing ;
    vc:slug "signal-conditioning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:digital-signal-processing,
        ngm:imu .

ngm:smart-grid a owl:Class ;
    rdfs:label "Smart Grid"@en ;
    rdfs:comment "A smart grid is a modernised electricity distribution network that integrates digital communication, real-time sensing, and automated control to improve efficiency, reliability, and sustainability relative to the traditional centralised grid. It enables bidirectional power and information flows, accommodating distributed generation from renewable sources, battery storage, and vehicle-to-grid interactions. Smart grids use advanced metering infrastructure, demand-response programmes, and grid-edge intelligence to balance supply and demand dynamically. They are a foundational component of low-carbon energy infrastructure and increasingly incorporate AI-driven forecasting and optimisation."@en ;
    rdfs:subClassOf ngm:cyber-physical-systems ;
    vc:enables ngm:energy-and-power,
        ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:industrial-io-t,
        ngm:power-management ;
    vc:slug "smart-grid" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-energy-scarcity ;
    vc:uses ngm:demand-response,
        ngm:io-t-sensor-network,
        ngm:real-time-monitoring .

ngm:social-robotics a owl:Class ;
    rdfs:label "Social Robotics"@en ;
    rdfs:comment "A field of robotics focused on designing robots capable of interacting and communicating with humans and other autonomous agents in a socially acceptable manner, following social rules, norms, and expectations of human interaction."@en ;
    rdfs:subClassOf ngm:human-robot-interaction,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:assistive-robotics,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:communication-capabilities,
        ngm:social-intelligence ;
    vc:slug "social-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:affective-computing,
        ngm:computer-vision,
        ngm:natural-language-processing .

ngm:speaker-diarisation a owl:Class ;
    rdfs:label "Speaker Diarisation"@en ;
    rdfs:comment "Speaker diarisation is the automated process of segmenting a continuous audio stream into speaker-homogeneous regions and assigning a speaker label to each region, answering the question 'who spoke when?' without necessarily identifying the speakers by name. The pipeline typically comprises voice activity detection, acoustic feature extraction, speaker embedding (using models such as x-vectors or ECAPA-TDNN), agglomerative clustering or spectral clustering to group embeddings, and optional overlap detection. Speaker diarisation is a prerequisite component in meeting transcription, clinical consultation recording, and multiparty conversation analysis systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-processing-system ],
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:meeting-transcription,
        ngm:real-time-transcription ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:automatic-speech-recognition,
        ngm:natural-language-processing ;
    vc:requires ngm:audio-processing-system ;
    vc:slug "speaker-diarisation" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:state-channel a owl:Class ;
    rdfs:label "State Channel"@en ;
    rdfs:comment "State channels are Layer 2 scaling solutions enabling off-chain interactions between participants through signed state updates, requiring only on-chain transactions for channel opening, closing, and dispute resolution, thereby achieving instant finality and near-zero marginal transaction costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:off-chain-scaling ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:digital-signature ;
    vc:slug "state-channel" ;
    vc:sourceDomain "blockchain" .

ngm:state-management a owl:Class ;
    rdfs:label "State Management"@en ;
    rdfs:comment "State Management is the set of patterns, architectures, and tools used to represent, update, synchronise, and persist the mutable state of an application or distributed system in a predictable and auditable way. In single-page web applications, state management libraries such as Redux implement unidirectional data flow and immutable state trees. In distributed systems, state management encompasses consensus protocols, state machine replication, and event sourcing patterns that ensure all nodes maintain consistent views of shared state despite failures and network partitions. Blockchain ledgers represent a specialised form of state management with Byzantine fault-tolerant distributed consensus."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:enables ngm:distributed-system,
        ngm:fault-tolerance,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:distributed-systems,
        ngm:message-queue,
        ngm:smart-contract ;
    vc:slug "state-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:event-driven-architecture,
        ngm:state-machine,
        ngm:state-machine-replication .

ngm:style-transfer a owl:Class ;
    rdfs:label "Style Transfer"@en ;
    rdfs:comment "Style Transfer is the technique of applying the artistic style of one image (style image) to the content of another image (content image), creating a new image that combines content from one source with the aesthetic style of another."@en ;
    rdfs:subClassOf ngm:image-to-image-translation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-content-generation,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:generative-adversarial-network ;
    vc:slug "style-transfer" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning .

ngm:taproot-assets a owl:Class ;
    rdfs:label "Taproot Assets"@en ;
    rdfs:comment "Taproot Assets (formerly Taro, renamed mid-2022) is a Bitcoin-native asset-issuance and transfer protocol developed by Lightning Labs, formally specified in BIPs 327-330, that enables arbitrary fungible tokens, non-fungible tokens, and stablecoins to be issued on the Bitcoin base layer using ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-341 ],
        ngm:asset-issuance-protocol,
        ngm:bc-protocol-and-consensus,
        ngm:bitcoin-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:atomic-cross-asset-swaps,
        ngm:bitcoin-native-stablecoins,
        ngm:machine-to-machine-payments,
        ngm:multi-asset-lightning-payments,
        ngm:nfts-on-bitcoin,
        ngm:tokenised-securities-on-bitcoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-group-key,
        ngm:asset-witness-proof,
        ngm:lightning-asset-channel,
        ngm:merkle-sum-sparse-merkle-tree,
        ngm:rfq-market,
        ngm:tapd-daemon,
        ngm:taproot-script-leaf,
        ngm:universe-registry ;
    vc:implements ngm:bip-327,
        ngm:bip-328,
        ngm:bip-329,
        ngm:bip-330,
        ngm:client-side-validation,
        ngm:ms-smt-commitment-scheme,
        ngm:rfq-multi-asset-routing,
        ngm:universe-gossip-protocol ;
