            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:requirements-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:data-governance,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:waterfall-model ;
    vc:dependsOn ngm:agile-software-development,
        ngm:project-management ;
    vc:enables ngm:ai-augmented-software-engineering,
        ngm:ai-deployment,
        ngm:software-quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:continuous-deployment,
        ngm:continuous-integration,
        ngm:requirements-engineering,
        ngm:software-testing ;
    vc:implements ngm:devops,
        ngm:mlops ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-architecture,
        ngm:technical-debt ;
    vc:requires ngm:code-review,
        ngm:software-engineering,
        ngm:version-control ;
    vc:slug "software-development-process" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:reproducibility,
