vf:information-security a owl:Class ;
    rdfs:label "Information Security"@en ;
    rdfs:comment "Information Security in AI addresses the protection of data, models, and AI systems from unauthorized access, adversarial attacks, privacy breaches, and malicious exploitation. This includes defending against adversarial examples, model inversion attacks, data poisoning, membership inference, and model extraction. Security measures encompass differential privacy for data protection, federated learning for distributed privacy-preserving training, robust training methods, secure multi-party computation, and encryption of model parameters. As AI systems become critical infrastructure, information security ensures confidentiality, integrity, availability, and trustworthiness."@en ;
    rdfs:subClassOf vf:owl-thing ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "information-security" ;
    vc:sourceDomain "artificial-intelligence" .

