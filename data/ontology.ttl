    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:empirical-risk-minimisation,
        ngm:generalisation-bounds,
        ngm:pac-learning,
        ngm:rademacher-complexity,
        ngm:vc-dimension ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computational-learning-theory,
        ngm:information-theory ;
    vc:requires ngm:concentration-inequalities,
        ngm:measure-theory,
        ngm:probability-theory,
        ngm:statistics ;
    vc:slug "statistical-learning-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:cross-validation,
