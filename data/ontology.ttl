ngm:architecture a owl:Class ;
    rdfs:label "Architecture"@en ;
    rdfs:comment "In the AI domain, Architecture refers to the structural design of an AI model or system, specifying how computational components—such as layers, modules, attention heads, and connections—are organised and interact to process inputs and produce outputs. Architectural choices fundamentally determine a model's capacity, inductive biases, scalability, and suitability for particular tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
