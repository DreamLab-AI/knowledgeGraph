        ngm:signature-validator,
        ngm:timestamp-service ;
    vc:isPartOf ngm:data-governance,
        ngm:data-management,
        ngm:trust-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:digital-signature,
        ngm:metadata,
        ngm:timestamp-authority ;
    vc:slug "data-provenance" ;
    vc:sourceDomain "infrastructure" .

ngm:depth-sensing a owl:Class ;
    rdfs:label "Depth Sensing"@en ;
    rdfs:comment "Depth Sensing is the measurement and capture of per-pixel distance information from a sensor to surfaces in the environment, producing depth maps or point clouds. Technologies include structured light, time-of-flight (ToF), active stereoscopy, and LiDAR. Depth sensing is foundational to augmented reality occlusion, robotic navigation, 3D scene reconstruction, and gesture recognition in spatial computing systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:3-d-reconstruction,
        ngm:point-cloud,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation ;
    vc:slug "depth-sensing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:lidar,
        ngm:stereo-camera .

ngm:digital-asset-trading a owl:Class ;
    rdfs:label "Digital Asset Trading"@en ;
    rdfs:comment "The buying, selling, and exchange of cryptocurrencies, tokens, and other blockchain-based assets through centralised exchanges, decentralised protocols, and over-the-counter markets using various order types, trading strategies, and execution mechanisms to achieve price discovery and liquidity."@en ;
