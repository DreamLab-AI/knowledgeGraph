        ngm:json-ld,
        ngm:schema-org ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metadata-schema" ;
    vc:sourceDomain "infrastructure" .

ngm:mixture-of-experts a owl:Class ;
    rdfs:label "Mixture of Experts"@en ;
    rdfs:comment "An architecture that uses multiple specialised sub-networks (experts) with a gating mechanism that routes inputs to a sparse subset of experts, enabling scaling without proportional compute increases. MoE is adopted in production LLMs like GPT-4, enabling massive scale with controlled costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparse-mixture-of-experts ],
        ngm:ai-model-architecture,
        ngm:model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:deep-learning ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:sparse-mixture-of-experts ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "mixture-of-experts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer-architecture .

ngm:named-entity-recognition a owl:Class ;
    rdfs:label "Named Entity Recognition"@en ;
    rdfs:comment "Named Entity Recognition (NER) is the NLP task of identifying and classifying named entities (persons, organisations, locations, dates, quantities) within unstructured text into predefined categories."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-graph-construction,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "named-entity-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:encoder,
        ngm:transformer-architecture .

ngm:orchestration a owl:Class ;
    rdfs:label "Orchestration"@en ;
    rdfs:comment "The automated coordination, scheduling, and lifecycle management of containerised workloads, microservices, and distributed agents across heterogeneous infrastructure. In the context of metaverse and telecollaboration systems, orchestration—exemplified by Kubernetes—ensures that compute-intensive rendering, AI inference, and real-time communication services scale elastically and recover automatically from failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:distributed-systems,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:digital-infrastructure ;
    vc:slug "orchestration" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:latency .

ngm:rasterization a owl:Class ;
    rdfs:label "Rasterization"@en ;
    rdfs:comment "The dominant real-time rendering technique that converts 3D geometric primitives — predominantly triangles — into a 2D pixel representation by determining per-pixel coverage, depth, and colour through a GPU-accelerated pipeline of vertex processing, primitive assembly, scan conversion, fragment shading, and output merging. Rasterization trades photorealistic accuracy for deterministic, high-throughput performance suitable for interactive applications."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:ray-tracing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail ;
    vc:slug "rasterization" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:post-processing,
        ngm:rendering-technique ;
    vc:uses ngm:pixel-shader,
        ngm:vertex-shader .

ngm:rendering-technique a owl:Class ;
    rdfs:label "Rendering Technique"@en ;
    rdfs:comment "A specific algorithm or methodology for transforming a geometric scene description into a final pixel image, trading image quality against computational cost. Fundamental categories include rasterization for real-time performance, ray tracing for physically accurate light transport, and path tracing for unbiased global illumination, with hybrid and screen-space variants bridging these extremes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-processing ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:post-processing,
        ngm:rasterization,
        ngm:ray-tracing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail ;
    vc:slug "rendering-technique" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:visual-effects ;
    vc:uses ngm:shader .

ngm:scene-understanding a owl:Class ;
    rdfs:label "Scene Understanding"@en ;
    rdfs:comment "Scene Understanding is the high-level semantic interpretation of visual and sensor data to comprehend the structure, context, objects, relationships, and dynamics of an environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
