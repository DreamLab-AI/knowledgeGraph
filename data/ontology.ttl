ngm:green-bond-market a owl:Class ;
    rdfs:label "Green Bond Market"@en ;
    rdfs:comment "The green bond market is the segment of fixed-income capital markets in which debt instruments are issued specifically to finance projects with environmental or climate benefits, such as renewable energy, clean transport, or sustainable infrastructure. Proceeds are ring-fenced and reported against recognised frameworks like the ICMA Green Bond Principles. It channels institutional capital toward decarbonisation while offering investors verifiable sustainability exposure."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-neutral-blockchain,
        ngm:sustainable-finance ;
    vc:slug "green-bond-market" ;
    vc:sourceDomain "blockchain" .

ngm:gri-standards a owl:Class ;
    rdfs:label "GRI Standards"@en ;
    rdfs:comment "The GRI Standards are a globally adopted framework published by the Global Reporting Initiative for organisations to disclose their economic, environmental, and social impacts. They provide a modular set of universal, sector, and topic standards that standardise sustainability and ESG reporting for comparability across firms. Widely referenced by regulators and investors, they form a backbone of corporate non-financial disclosure."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:ethical-sourcing ;
    vc:slug "gri-standards" ;
    vc:sourceDomain "governance" .

ngm:gs1-epcis a owl:Class ;
    rdfs:label "GS1 EPCIS"@en ;
    rdfs:comment "GS1 EPCIS (Electronic Product Code Information Services) is a global standard that defines a common data model and interface for capturing and sharing supply-chain visibility events, answering what, when, where, why, and how for product movements. It standardises event-based traceability across trading partners using GS1 identifiers. EPCIS is widely deployed in pharmaceuticals, food safety, and logistics to enable end-to-end provenance."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring ;
    vc:slug "gs1-epcis" ;
    vc:sourceDomain "supply-chain" .

ngm:hallucination-reduction a owl:Class ;
    rdfs:label "Hallucination Reduction"@en ;
    rdfs:comment "Hallucination reduction is the set of techniques used to decrease the rate at which large language models generate fluent but factually incorrect or unsupported output. Approaches include grounding generation in retrieved evidence, fact-checking against trusted sources, calibrated abstention, and fine-tuning for faithfulness. It is central to deploying generative AI in high-stakes domains where accuracy is critical."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-grounded-domain,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "hallucination-reduction" ;
    vc:sourceDomain "ai" .

ngm:halving-schedule a owl:Class ;
    rdfs:label "Halving Schedule"@en ;
    rdfs:comment "The halving schedule is the predetermined, code-enforced rule in proof-of-work cryptocurrencies that periodically cuts the block subsidy paid to miners by half. In Bitcoin this occurs every 210,000 blocks (roughly four years), progressively reducing new issuance until the 21 million supply cap is reached. It is the core monetary policy mechanism that makes the asset's supply predictable and disinflationary."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-mining,
        ngm:bitcoin-technical-overview ;
    vc:slug "halving-schedule" ;
    vc:sourceDomain "blockchain" .

ngm:hard-money a owl:Class ;
    rdfs:label "Hard Money"@en ;
    rdfs:comment "Hard money refers to a form of money whose supply is difficult to expand, giving it a high stock-to-flow ratio and resistance to debasement. Historically embodied by gold, the concept extends to assets like Bitcoin whose issuance is algorithmically constrained. Hard money is valued as a store of value because its scarcity cannot be diluted by discretionary issuance."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gold,
        ngm:store-of-value ;
    vc:slug "hard-money" ;
    vc:sourceDomain "blockchain" .

ngm:hardhat a owl:Class ;
    rdfs:label "Hardhat"@en ;
    rdfs:comment "Hardhat is a development environment for Ethereum software, providing tools for compiling, testing, and debugging smart contracts."@en ;
