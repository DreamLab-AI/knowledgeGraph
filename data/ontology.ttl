        ngm:level-of-detail,
        ngm:texture-compression .

ngm:context-management a owl:Class ;
    rdfs:label "Context Management"@en ;
    rdfs:comment "Context management is the set of techniques for assembling, prioritising, compressing, and maintaining the information supplied to a language model within its bounded context window across a task or conversation. It governs what prompts, retrieved documents, prior turns, tool outputs, and state are placed in context, in what order, and at what fidelity, so that the model has the most relevant evidence without exceeding token limits. Effective context management is central to retrieval-augmented generation, long-running agents, and conversational systems, where it directly shapes coherence, accuracy, and cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:memory-management ],
        ngm:large-language-model ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:context-window ;
    vc:enables ngm:autonomous-agent,
        ngm:conversational-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:context-window,
        ngm:memory-management ;
    vc:implements ngm:retrieval-augmented-generation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:memory-management,
        ngm:prompt-engineering,
        ngm:state-management ;
    vc:requires ngm:token ;
    vc:slug "context-management" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:dialogue-system,
        ngm:session-management ;
    vc:uses ngm:knowledge-retrieval,
        ngm:prompt-engineering .

ngm:core-lightning a owl:Class ;
    rdfs:label "Core Lightning"@en ;
    rdfs:comment "Core Lightning (formerly c-lightning) is a specification-compliant, production-grade implementation of the Bitcoin Lightning Network protocol written in C and maintained by Blockstream. It provides a lightweight, modular node daemon that enables off-chain Bitcoin micropayments through bidirectional payment channels anchored on the Bitcoin blockchain. The implementation adheres to the BOLT (Basis of Lightning Technology) specification suite, ensuring interoperability with other Lightning implementations such as LND and Eclair. A distinguishing feature is its plugin architecture, which allows operators to extend node behaviour in arbitrary programming languages via a JSON-RPC interface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hashed-timelock-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bolt-specifications ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:machine-to-machine-payments ;
    vc:contrastsWith ngm:eclair,
        ngm:lnd ;
    vc:enables ngm:micropayment,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bolt-specifications,
        ngm:lightning-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockstream,
        ngm:channel-factory,
        ngm:peer-to-peer-network,
        ngm:splicing ;
    vc:requires ngm:bitcoin,
        ngm:bolt-specifications,
        ngm:hashed-timelock-contract,
        ngm:payment-channel ;
    vc:slug "core-lightning" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bolt-specifications ;
    vc:uses ngm:gossip-protocol,
        ngm:onion-routing,
        ngm:schnorr-signature,
        ngm:taproot .

ngm:corporate-sustainability-reporting a owl:Class ;
    rdfs:label "Corporate Sustainability Reporting"@en ;
    rdfs:comment "Corporate sustainability reporting is the structured disclosure by an organisation of its environmental, social, and governance (ESG) performance, impacts, risks, and opportunities, typically published alongside or integrated within financial reporting. It translates non-financial activity — emissions, resource use, workforce conditions, supply-chain practices, and governance arrangements — into standardised, often externally assured metrics intended for investors, regulators, and other stakeholders. Modern regimes increasingly mandate disclosure under frameworks such as the EU Corporate Sustainability Reporting Directive (CSRD) and the ISSB's IFRS S1/S2 standards, shifting reporting from voluntary marketing toward audited, decision-useful information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:greenhouse-gas-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-verification ],
        ngm:sustainability-reporting ;
    vc:bridgesTo ngm:carbon-credits ;
    vc:contrastsWith ngm:greenwashing ;
    vc:enables ngm:esg-investing,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:double-materiality,
        ngm:scope-3-emissions ;
    vc:implements ngm:eu-taxonomy,
        ngm:issb ;
    vc:isPartOf ngm:esg-reporting ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-accounting,
        ngm:stakeholder-engagement ;
    vc:requires ngm:greenhouse-gas-protocol,
        ngm:third-party-verification ;
    vc:slug "corporate-sustainability-reporting" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:tcfd ;
    vc:supports ngm:regulatory-compliance .

ngm:crash-fault-tolerance a owl:Class ;
    rdfs:label "Crash Fault Tolerance"@en ;
    rdfs:comment "Crash fault tolerance is the property of a distributed system that continues to operate correctly despite nodes failing by stopping, that is, by halting and ceasing to send messages. It assumes the crash-stop or crash-recovery failure model, in which faulty processes do not behave maliciously or send incorrect information. Protocols such as Paxos and Raft achieve it through replication and consensus over a quorum of non-faulty nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:fault-tolerance ;
    vc:bridgesTo ngm:distributed-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:dependsOn ngm:consensus-protocol,
        ngm:leader-election ;
    vc:enables ngm:high-availability,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:paxos,
        ngm:raft ;
    vc:isPartOf ngm:distributed-consensus,
        ngm:fault-tolerance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-protocol,
        ngm:quorum ;
    vc:requires ngm:quorum,
        ngm:replication ;
    vc:slug "crash-fault-tolerance" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:state-machine-replication ;
    vc:uses ngm:leader-election,
        ngm:replication .

ngm:creator-monetization a owl:Class ;
    rdfs:label "Creator Monetization"@en ;
    rdfs:comment "Creator Monetization refers to the suite of mechanisms, platforms, and economic models through which independent content creators convert their creative output and audience relationships into sustainable revenue streams. These mechanisms span advertising revenue sharing, subscription and membership tiers, merchandise and physical goods, live events, licensing, and on-chain token-based models including NFTs and creator coins. The field has been shaped by the shift from broadcast media to participatory digital platforms, enabling individuals rather than corporations to capture value from cultural production. Web3 infrastructure is expanding the design space by enabling programmable royalties and direct fan-ownership of creative works."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audience-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:creator-economy ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:dependsOn ngm:content-distribution,
        ngm:digital-payment-system ;
    vc:enables ngm:digital-marketplace,
