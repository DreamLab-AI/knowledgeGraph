ngm:state-machine-replication a owl:Class ;
    rdfs:label "State Machine Replication"@en ;
    rdfs:comment "State Machine Replication (SMR) is a fault-tolerance technique in which multiple server replicas each maintain an identical copy of a deterministic state machine, processing the same ordered sequence of client requests to achieve consistency. It underpins the correctness guarantees of distributed consensus protocols and forms the theoretical foundation of blockchain ledger replication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain,
        ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:state-machine ;
    vc:requires ngm:consensus-mechanism,
        ngm:fault-tolerance ;
    vc:slug "state-machine-replication" ;
    vc:sourceDomain "blockchain" .

ngm:structure-from-motion a owl:Class ;
    rdfs:label "Structure-from-Motion"@en ;
    rdfs:comment "Structure-from-Motion (SfM) is a photogrammetric pipeline that simultaneously estimates three-dimensional scene structure and camera motion parameters from an unordered set of overlapping two-dimensional images. Feature detection and matching across images (typically using descriptors such as SIFT or ORB) establishes correspondences, which are fed into bundle adjustment to jointly optimise point-cloud coordinates and camera extrinsics and intrinsics. SfM is foundational in photogrammetry, autonomous navigation, and AR/VR asset creation, producing dense or sparse 3D reconstructions from passive imagery alone."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:depth-estimation,
        ngm:point-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:slam,
        ngm:visual-odometry ;
    vc:slug "structure-from-motion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision .

ngm:supervised-fine-tuning a owl:Class ;
    rdfs:label "Supervised Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that uses labelled training data to adapt a pre-trained model to specific tasks, optimising performance through supervised learning on input-output pairs. Supervised fine-tuning (SFT) represents the most direct path from general pre-training to task-specific capability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:reinforcement-learning,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:requires ngm:human-feedback,
        ngm:model-training ;
    vc:slug "supervised-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:synthetic-media a owl:Class ;
    rdfs:label "Synthetic Media"@en ;
    rdfs:comment "Synthetic Media encompasses digitally generated or algorithmically manipulated audio, video, image, and text content produced by AI systems including generative adversarial networks, diffusion models, and large language models. It includes deepfakes, AI-generated video, voice cloning, and text-to-image outputs. Synthetic media raises significant concerns around misinformation, identity fraud, and content authenticity, driving the development of detection techniques and disclosure standards."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
