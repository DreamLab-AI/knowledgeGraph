        ngm:interaction-manager,
        ngm:knowledge-representation,
        ngm:learning-module,
        ngm:perception-system,
        ngm:reasoning-engine ;
    vc:isPartOf ngm:adaptive-virtual-world,
        ngm:ai-ecosystem,
        ngm:intelligent-environment ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ai-framework,
        ngm:computational-resources,
        ngm:sensor-input,
        ngm:training-data ;
    vc:slug "intelligent-virtual-entity" ;
    vc:sourceDomain "spatial-computing" .

ngm:interaction-control a owl:Class ;
    rdfs:label "Interaction Control"@en ;
    rdfs:comment "A robotics control paradigm that explicitly manages contact forces and compliant behaviour when a robot interacts with its environment or human collaborators. Interaction control encompasses impedance control, admittance control, and force control strategies that allow robots to operate safely during physical contact, adapting stiffness, damping, and inertia in response to sensed forces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impedance-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-control ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:force-control,
        ngm:impedance-control ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:motion-control,
        ngm:robot-safety ;
    vc:requires ngm:control-system,
        ngm:robot-sensor ;
    vc:slug "interaction-control" ;
    vc:sourceDomain "robotics" .

ngm:interface-standards a owl:Class ;
    rdfs:label "Interface Standards"@en ;
    rdfs:comment "Technical specifications and protocols that define how metaverse components, systems, and services communicate and interoperate, encompassing XR device interfaces, data exchange formats, and cross-platform communication requirements."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:technical-standard ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:cross-platform-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "interface-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:interpretable-ai a owl:Class ;
    rdfs:label "Interpretable AI"@en ;
    rdfs:comment "Machine learning models and systems whose internal decision-making processes are inherently transparent and understandable to humans without requiring additional post-hoc explanation techniques. Interpretable AI prioritises transparency by design—via linear models, decision trees, or rule-based systems—distinguishing it from explainable AI approaches that retrofit explanations onto opaque models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-interpretability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:large-language-models ;
    vc:enables ngm:accountability,
        ngm:explainable-ai,
        ngm:fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation ;
    vc:requires ngm:model-interpretability,
        ngm:model-transparency ;
    vc:slug "interpretable-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:jurisdictional-boundary a owl:Class ;
    rdfs:label "Jurisdictional Boundary"@en ;
    rdfs:comment "Legal and regulatory demarcations applicable to metaverse and virtual world governance, addressing the complex challenge of determining which laws apply when virtual activities span multiple physical jurisdictions with no clear territorial boundaries."@en ;
    rdfs:subClassOf ngm:legal-framework,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:virtual-world-governance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "jurisdictional-boundary" ;
    vc:sourceDomain "spatial-computing" .

ngm:k-anonymity-in-datasets a owl:Class ;
    rdfs:label "k-Anonymity in Datasets"@en ;
    rdfs:comment "k-Anonymity is a dataset privacy property that guarantees each record is indistinguishable from at least k-1 other records with respect to quasi-identifier attributes—fields such as age, gender, and postal code that can be combined to re-identify individuals. Anonymization is achieved through generalisation (replacing specific values with broader categories) and suppression (removing highly identifying records), producing equivalence classes where all members share identical quasi-identifier values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-anonymization-pipeline ],
        ngm:ai-technique,
        ngm:privacy-preserving-analytics ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:federated-learning,
        ngm:homomorphic-encryption ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:differential-privacy,
        ngm:privacy-mechanism,
        ngm:privacy-preserving-analytics,
        ngm:synthetic-data ;
    vc:requires ngm:data-anonymization-pipeline,
        ngm:data-governance ;
    vc:slug "k-anonymity-in-datasets" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:synthetic-data-generation .

ngm:kinematic-element a owl:Class ;
    rdfs:label "Kinematic Element"@en ;
    rdfs:comment "A Kinematic Element is a rigid body or joint primitive within a robot's mechanical structure that participates in the forward and inverse kinematic chain, defining the positional and orientational degrees of freedom of a limb segment. Chains of kinematic elements model the geometry of robotic arms, legs, and manipulators for motion planning and control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:legged-robot,
        ngm:mobile-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:control-system ;
    vc:slug "kinematic-element" ;
    vc:sourceDomain "robotics" .

ngm:kinematics-model a owl:Class ;
    rdfs:label "Kinematics Model"@en ;
    rdfs:comment "KinematicsModel is a mathematical representation of the geometric relationships between a robot's joint configuration space and its end-effector pose in Cartesian workspace coordinates, abstracting away forces and inertial effects to describe pure motion geometry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        ngm:geometric-model,
        ngm:mathematical-model,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:cartesian-impedance-control,
        ngm:force-control,
        ngm:motion-planning,
        ngm:robot-calibration,
        ngm:robot-control,
        ngm:teleoperation,
        ngm:trajectory-generation,
        ngm:visual-servoing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cartesian-space,
        ngm:denavit-hartenberg-parameters,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:jacobian-matrix,
        ngm:joint-space,
        ngm:redundancy-resolution,
        ngm:screw-theory,
        ngm:singularity-analysis ;
    vc:implements ngm:closed-form-ik,
        ngm:dh-convention,
        ngm:iterative-jacobian-solver,
        ngm:neural-inverse-kinematics,
        ngm:product-of-exponentials ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:calibration,
        ngm:collision-detection,
        ngm:manipulability-ellipsoid,
        ngm:task-space-control,
        ngm:workspace-analysis ;
    vc:requires ngm:homogeneous-transformation,
        ngm:joint-configuration,
        ngm:reference-frames,
        ngm:robot-description-format,
        ngm:se-3-lie-group ;
    vc:slug "kinematics-model" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee-robotics-and-automation-society,
        ngm:ros-industrial-consortium,
        ngm:urdf-specification ;
    vc:supports ngm:autonomous-mobile-robots,
        ngm:exoskeleton-control,
        ngm:industrial-manipulation,
        ngm:legged-locomotion,
        ngm:space-robotics,
        ngm:surgical-robotics ;
    vc:uses ngm:drake,
        ngm:gazebo,
        ngm:mu-jo-co,
        ngm:pinocchio-library,
        ngm:ros,
        ngm:sdf,
        ngm:urdf .

ngm:knowhere a owl:Class ;
    rdfs:label "Knowhere"@en ;
    rdfs:comment "KnoWhere is an AI-driven visitor attention-tracking system for museums and immersive experience spaces, using computer vision and machine vision cameras to capture gaze vectors, emotion signals, and spatial attention metrics in real time without wearables. It enables hyper-personalised narrative adaptation and provides curators with actionable behavioural analytics whilst preserving visitor privacy through anonymised data processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:segmentation-and-identification ],
        ngm:infra-computing-and-cloud,
        ngm:tracking-technology ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:immersive-experience,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:segmentation-and-identification ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:privacy ;
    vc:slug "knowhere" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:computer-vision,
        ngm:edge-computing,
        ngm:neural-network,
        ngm:sensor-fusion .

ngm:knowledge-organization a owl:Class ;
    rdfs:label "Knowledge Organization"@en ;
    rdfs:comment "The systematic arrangement, classification, and representation of knowledge structures so that information can be discovered, related, and reasoned over. Knowledge organization encompasses taxonomies, thesauri, ontologies, and knowledge graphs, and underpins semantic search, question answering, and AI knowledge-base construction."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
