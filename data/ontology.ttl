    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:creative-media-domain,
        ngm:music-and-audio ;
    vc:slug "performing-arts" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:motion-capture,
        ngm:spatial-audio,
        ngm:virtual-production .

ngm:persistent-state a owl:Class ;
    rdfs:label "Persistent State"@en ;
    rdfs:comment "The durable retention of application or world state across user sessions, server restarts, and network interruptions, such that virtual environments, user progress, and asset ownership remain consistent over time. In metaverse and multiplayer systems, persistent state is typically achieved through distributed databases, cloud storage synchronisation, or blockchain-based ledgers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:metaverse-application,
        ngm:session-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:distributed-system ;
    vc:requires ngm:cloud-infrastructure,
        ngm:data-storage ;
    vc:slug "persistent-state" ;
    vc:sourceDomain "infrastructure" .

ngm:physical-hardware a owl:Class ;
    rdfs:label "Physical Hardware"@en ;
    rdfs:comment "The tangible computing devices and peripherals required for metaverse and XR experiences, including VR headsets, AR glasses, haptic devices, motion controllers, and supporting infrastructure like GPUs and networking equipment."@en ;
    rdfs:subClassOf ngm:hardware,
