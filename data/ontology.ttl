        ngm:procedural-content-generation ;
    vc:implements ngm:deep-learning,
        ngm:evolutionary-algorithm,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games,
