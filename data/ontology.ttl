ngm:atomic-broadcast a owl:Class ;
    rdfs:comment "Atomic broadcast (also called total-order broadcast) is a distributed communication primitive guaranteeing that all correct processes deliver the same set of messages in the same total order. It strengthens reliable broadcast with an ordering property, ensuring agreement on both the content and sequence of delivered messages. Atomic broadcast is equivalent in power to consensus and underpins state-machine replication."@en ;
    rdfs:label "Atomic Broadcast"@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    rdfs:subClassOf _:r2034 ;
    rdfs:subClassOf _:r2035 ;
