        ngm:mechanical-load,
        ngm:servo-amplifier ;
    vc:slug "dc-servo-motor" ;
    vc:sourceDomain "robotics" .

ngm:de-fi-protocol a owl:Class ;
    rdfs:label "De Fi Protocol"@en ;
    rdfs:comment "A blockchain-based financial application providing decentralized financial services via smart contracts."@en ;
