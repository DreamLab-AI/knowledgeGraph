ngm:lossy-compression a owl:Class ;
    rdfs:comment "Data compression that achieves high ratios by permanently discarding information judged perceptually or statistically less important, guided by rate-distortion theory and models of human vision and hearing; the basis of virtually all deployed image, audio and video coding — JPEG, MP3, AAC, Opus, H.264/HEVC/AV1 — where transform coding, quantisation and entropy coding together trade reconstruction fidelity against bitrate, in contrast to lossless methods that guarantee exact reconstruction."@en ;
    rdfs:label "Lossy Compression"@en ;
    rdfs:subClassOf ngm:data-compression ;
    vc:contrastsWith ngm:lossless-compression ;
    vc:enables ngm:adaptive-bitrate-streaming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-codec ;
    vc:slug "lossy-compression" ;
    vc:sourceDomain "data" .
