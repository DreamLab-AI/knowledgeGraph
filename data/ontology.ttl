ngm:harmlessness a owl:Class ;
    rdfs:label "Harmlessness"@en ;
    rdfs:comment "An alignment objective ensuring AI systems avoid generating outputs that could cause harm, including toxic, dangerous, misleading, or unethical content. Harmlessness is one of the three core alignment dimensions alongside helpfulness and honesty, implemented through techniques such as Constitutional AI and RLHF to constrain model behaviour without sacrificing utility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
