ngm:encoder a owl:Class ;
    rdfs:label "Encoder"@en ;
    rdfs:comment "The component in an encoder-decoder architecture that processes an input sequence and produces contextualised representations via stacked self-attention and position-wise feed-forward layers; used as the representation-learning backbone in transformer models such as BERT and T5."@en ;
