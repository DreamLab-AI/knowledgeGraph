ngm:light-parameters a owl:Class ;
    rdfs:label "Light Parameters"@en ;
    rdfs:comment "Configurable settings that control virtual lighting behaviour in VR and metaverse environments, including intensity, colour temperature, bounce calculations, shadow quality, and reflection properties that determine visual realism and immersion."@en ;
