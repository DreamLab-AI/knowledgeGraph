vf:instance-segmentation a owl:Class ;
    rdfs:label "Instance Segmentation"@en ;
    rdfs:comment "Instance Segmentation extends object detection by predicting precise pixel-level masks for each individual object instance, combining object detection with semantic segmentation to delineate exact boundaries of distinct objects. Instance segmentation models (Mask R-CNN, YOLACT, SOLOv2) enable fine-grained object localisation essential for robotics manipulation, autonomous driving, and medical image analysis."@en ;
    rdfs:subClassOf vf:computer-vision ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "instance-segmentation" ;
    vc:sourceDomain "spatial-computing" .

vf:interaction-domain a owl:Class ;
    rdfs:label "Interaction Domain"@en ;
    rdfs:comment "The Interaction Domain encompasses the ontological framework for human-computer interaction (HCI) phenomena, including interactive computer systems, user interfaces, user actions, and the processes by which interactions occur. It provides formal representation of user experience elements, adaptive interactive systems, and the modularized understanding of how users engage with digital systems through various modalities."@en ;
    rdfs:subClassOf vf:spatial-computing ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "reviewed" ;
