ngm:text-preprocessing a owl:Class ;
    rdfs:comment "Text preprocessing is the stage of a natural language processing pipeline that transforms raw text into a normalised, structured form suitable for tokenisation and modelling, encompassing steps such as lowercasing, punctuation and whitespace normalisation, removal of unwanted characters, and segmentation into sentences or tokens. It precedes and feeds directly into tokenisation, which converts the cleaned text into the discrete units a neural network consumes. Consistent text preprocessing reduces vocabulary sparsity and noise, materially affecting downstream model quality."@en ;
    rdfs:label "Text Preprocessing"@en ;
    rdfs:subClassOf ngm:data-preprocessing ;
