    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bellman-equation,
        ngm:markov-decision-process,
        ngm:value-function .

ngm:tether a owl:Class ;
    rdfs:label "Tether"@en ;
    rdfs:comment "Tether is the issuer of USDT, the largest fiat-collateralised stablecoin by circulating supply, designed to maintain a value pegged to the United States dollar. Tokens are issued on numerous blockchains and are intended to be redeemable one-to-one for dollars, backed by reserves held by the issuer. Tether is widely used for trading, settlement and as a dollar proxy on exchanges, and its reserve composition and transparency have been subjects of regulatory scrutiny."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiat-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custodian ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:stablecoin ;
    vc:bridgesTo ngm:financial-regulation,
        ngm:infra-legal-and-regulatory,
        ngm:systemic-risk ;
    vc:contrastsWith ngm:algorithmic-stablecoin,
        ngm:central-bank-digital-currency,
        ngm:usd-coin ;
    vc:dependsOn ngm:dollar-peg,
        ngm:liquidity-provision ;
    vc:enables ngm:cross-border-payments,
        ngm:crypto-trading,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:decentralised-finance,
        ngm:digital-asset ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:money-market-fund,
        ngm:stablecoin-regulation ;
    vc:requires ngm:blockchain,
        ngm:custodian,
        ngm:fiat-currency ;
    vc:slug "tether" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:cryptocurrency-exchange,
        ngm:liquidity ;
    vc:uses ngm:ethereum,
        ngm:proof-of-reserves,
        ngm:smart-contract,
        ngm:tron-blockchain .

ngm:text-embeddings a owl:Class ;
    rdfs:label "Text Embeddings"@en ;
    rdfs:comment "Text embeddings are dense numerical vector representations of words, sentences, or documents that place semantically similar text close together in a high-dimensional space. They are produced by neural models trained so that distance or cosine similarity in the vector space reflects meaning rather than surface form. Embeddings are the foundation of semantic search, clustering, and retrieval-augmented generation."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag,
        ngm:semantic-search ;
    vc:slug "text-embeddings" ;
    vc:sourceDomain "ai" .

ngm:textual-inversion a owl:Class ;
    rdfs:label "Textual Inversion"@en ;
    rdfs:comment "Textual inversion is a fine-tuning technique for text-to-image diffusion models that learns a new embedding vector for a placeholder token from a handful of example images, capturing a specific subject or style without altering the model weights. The learned pseudo-word can then be composed into prompts like any ordinary token. It is lightweight and shareable because only a small embedding, not the full network, is trained."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:kohya-dreambooth-and-similar ;
    vc:slug "textual-inversion" ;
    vc:sourceDomain "ai" .

ngm:tls-encryption a owl:Class ;
    rdfs:label "TLS Encryption"@en ;
    rdfs:comment "TLS (Transport Layer Security) encryption is the cryptographic protocol layer that provides confidentiality, integrity, and server authentication for communications over TCP/IP networks, most visibly as the foundation of HTTPS. It operates through a handshake that negotiates cipher suites, authenticates servers (and optionally clients) via X.509 certificates, establishes ephemeral session keys using asymmetric key exchange (ECDHE), and then encrypts all subsequent data using symmetric ciphers (AES-GCM). TLS 1.3 (RFC 8446, 2018) is the current standard, eliminating obsolete constructs and reducing handshake latency to one round trip."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:x-509-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:infrastructure ;
    vc:contrastsWith ngm:ipsec,
        ngm:ssl ;
    vc:dependsOn ngm:hash-function,
        ngm:public-key-cryptography ;
    vc:enables ngm:forward-secrecy,
        ngm:http,
        ngm:network-security,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:transport-layer-security ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-transparency,
        ngm:cryptographic-key-management,
        ngm:key-derivation-function,
        ngm:tls ;
    vc:requires ngm:tcp-ip,
        ngm:x-509-certificate ;
    vc:slug "tls-encryption" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-integrity,
        ngm:mutual-authentication ;
    vc:uses ngm:asymmetric-encryption,
        ngm:certificate-authority,
        ngm:digital-certificate,
        ngm:elliptic-curve-diffie-hellman,
        ngm:public-key-infrastructure,
        ngm:symmetric-encryption .

ngm:trajectory-tracking a owl:Class ;
    rdfs:label "Trajectory Tracking"@en ;
    rdfs:comment "Trajectory tracking is the control problem of causing a dynamical system—typically a robot, vehicle, or aerial platform—to follow a prescribed time-parameterised path through configuration space with minimal deviation. It couples a reference trajectory generated by a planner with a feedback controller that corrects errors arising from disturbances, model mismatch, and actuation limits. Trajectory tracking controllers range from classical PID and linear quadratic regulators to model predictive controllers and learning-based approaches. It is a central capability in mobile robotics, autonomous driving, drone flight, and industrial manipulator control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedforward-control ],
        ngm:trajectory-control ;
    vc:bridgesTo ngm:imitation-learning,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:sensor-fusion,
        ngm:state-estimation,
        ngm:system-identification,
        ngm:trajectory-planning ;
    vc:enables ngm:autonomous-driving,
        ngm:autonomous-navigation,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feedforward-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:robust-control,
        ngm:trajectory-generation,
        ngm:whole-body-control ;
    vc:slug "trajectory-tracking" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:linear-quadratic-regulator,
        ngm:model-predictive-control,
        ngm:motion-model,
        ngm:pid-controller .

ngm:triple-store a owl:Class ;
    rdfs:label "Triple Store"@en ;
    rdfs:comment "A triple store is a database purpose-built to store and query RDF data as subject-predicate-object triples, forming the storage layer for semantic-web and knowledge-graph applications. It supports the SPARQL query language and often provides reasoning and inference over ontologies, enabling expressive graph traversal and entailment beyond what relational stores offer."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:knowledge-graphing ;
    vc:slug "triple-store" ;
    vc:sourceDomain "data" .

ngm:trust-model a owl:Class ;
    rdfs:label "Trust Model"@en ;
    rdfs:comment "A trust model is a formal description of which entities are trusted, for what, and on what basis within a security or identity system. It defines the roots of trust, the relationships through which trust is delegated or transitively established, and the assumptions an adversary cannot violate. Trust models range from centralised certificate hierarchies to decentralised webs of trust and zero-trust architectures, and they directly shape how authentication and authorisation are designed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trust-anchor ],
        ngm:security ;
    vc:contrastsWith ngm:decentralised-trust,
        ngm:web-of-trust ;
    vc:dependsOn ngm:trust ;
    vc:enables ngm:authentication,
        ngm:authorisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:trust-anchor ;
    vc:implements ngm:trust-establishment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:identity-verification,
        ngm:risk-assessment,
        ngm:threat-model ;
    vc:requires ngm:authentication,
        ngm:trust-anchor ;
    vc:slug "trust-model" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:zero-trust-architecture ;
    vc:uses ngm:certificate-authority,
        ngm:cryptographic-proof .

ngm:trusted-setup a owl:Class ;
    rdfs:label "Trusted Setup"@en ;
    rdfs:comment "A trusted setup is a one-time procedure that generates the public parameters (a common reference string) required by certain cryptographic protocols, notably succinct zero-knowledge proof systems. The procedure produces secret randomness, often called toxic waste, that must be irrecoverably destroyed; if it leaks, an adversary can forge proofs. Multi-party ceremonies distribute trust so that the setup remains sound as long as a single participant behaves honestly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:cryptography ;
    vc:contrastsWith ngm:forward-secrecy ;
    vc:dependsOn ngm:commitment-scheme,
        ngm:elliptic-curve-cryptography ;
    vc:enables ngm:verifiable-computation,
        ngm:zero-knowledge-proof,
        ngm:zk-snark ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:plonk,
        ngm:public-key-cryptography ;
    vc:requires ngm:hash-function,
        ngm:multi-party-computation ;
    vc:slug "trusted-setup" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain ;
    vc:uses ngm:kzg-commitment,
        ngm:polynomial-commitment .

ngm:variance-reduction a owl:Class ;
    rdfs:label "Variance Reduction"@en ;
    rdfs:comment "Variance Reduction is a family of techniques that lower the statistical variance of Monte Carlo and stochastic estimators so that fewer samples are needed to reach a target accuracy. Methods such as importance sampling, control variates, antithetic variates, and stratification reshape how samples are drawn or combined without introducing bias. In machine learning, variance reduction stabilises gradient estimates in stochastic optimisation and accelerates convergence of simulation-based methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sampling ],
        ngm:monte-carlo-integration ;
    vc:bridgesTo ngm:optimisation ;
    vc:enables ngm:simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:numerical-methods ;
    vc:isPartOf ngm:monte-carlo-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:importance-sampling,
        ngm:numerical-methods ;
    vc:requires ngm:sampling ;
    vc:slug "variance-reduction" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:machine-learning,
        ngm:stochastic-gradient-descent ;
    vc:uses ngm:importance-sampling,
        ngm:sampling .

ngm:vector-index a owl:Class ;
    rdfs:label "Vector Index"@en ;
    rdfs:comment "A vector index is a data structure that organises high-dimensional embedding vectors to enable fast approximate nearest-neighbour search over large collections. Using methods such as HNSW graphs, IVF partitioning or product quantisation, it trades a small amount of recall for large gains in query latency and scalability. Vector indexes are the retrieval engine behind semantic search and retrieval-augmented generation."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag,
        ngm:semantic-search ;
    vc:slug "vector-index" ;
    vc:sourceDomain "ai" .

ngm:velocity-control a owl:Class ;
    rdfs:label "VelocityControl"@en ;
    rdfs:comment "A closed-loop feedback control strategy that regulates the rate of change of position (linear velocity v in m/s or angular velocity ω in rad/s) of a robotic actuator, motor shaft, conveyor system, or mobile robot platform by continuously measuring actual velocity via tachometers (±full-scale accu..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedforward-compensation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:noise-suppression ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-observer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:error-calculation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stability-analysis ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:energy-efficiency,
        ngm:velocity-profiling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:error-calculation,
        ngm:feedforward-compensation,
        ngm:state-observer ;
    vc:implements ngm:adaptive-control,
        ngm:cascade-control,
        ngm:feedforward-control,
        ngm:observer-design ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:noise-suppression,
        ngm:stability-analysis ;
    vc:slug "velocity-control" ;
    vc:sourceDomain "robotics" .

ngm:verifiable-credential-standard a owl:Class ;
    rdfs:label "Verifiable Credential Standard"@en ;
    rdfs:comment "The W3C Verifiable Credentials Data Model specification defines a structured, cryptographically verifiable format for expressing claims about subjects. Credentials are issued by a trusted issuer, held by a subject, and verified by relying parties using digital signatures and Decentralized Identifiers (DIDs), enabling portable, privacy-preserving identity across metaverse and web platforms without centralised databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:digital-identity,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:interoperability-standard ;
    vc:requires ngm:cryptography,
        ngm:decentralized-identifiers ;
    vc:slug "verifiable-credential-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards .

ngm:video-encoding a owl:Class ;
    rdfs:label "Video Encoding"@en ;
    rdfs:comment "Video encoding is the process of compressing raw or lightly-compressed video frames into a deliverable bitstream using a video codec, encompassing decisions about encoding parameters (resolution, frame rate, bitrate mode, keyframe interval, codec profile and level), rate control algorithms, and hardware or software encoder selection to balance output quality, file size, and encoding speed for a given delivery target."@en ;
    rdfs:subClassOf ngm:video-codec ;
    vc:dependsOn ngm:compute-resources ;
    vc:enables ngm:bandwidth-adaptation,
        ngm:bandwidth-optimization,
        ngm:cdn ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:decoder ;
    vc:slug "video-encoding" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:computer-vision-video-analysis,
        ngm:encoder .

ngm:virtual-meeting a owl:Class ;
    rdfs:label "Virtual Meeting"@en ;
    rdfs:comment "A synchronous gathering of geographically distributed participants conducted through video conferencing, spatial computing, or immersive VR/AR technologies to enable remote collaboration. Virtual meetings span traditional video-call platforms with screen sharing and virtual whiteboards through to persistent 3D avatar-based spaces such as Meta Horizon Workrooms and Microsoft Mesh, which replicate physical presence cues including spatial audio and non-verbal body language."@en ;
    rdfs:subClassOf ngm:dc-communication,
        ngm:telecollaboration ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:immersive-workspaces,
        ngm:telecollaboration-and-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:social-vr,
        ngm:virtual-event-platform ;
    vc:slug "virtual-meeting" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:collaboration-platform,
        ngm:immersive-technology,
        ngm:spatial-computing .

ngm:visual-question-answering a owl:Class ;
    rdfs:label "Visual Question Answering"@en ;
    rdfs:comment "Visual question answering (VQA) is a multimodal AI task in which a system produces a natural-language answer to a free-form question posed about an image or scene. It requires jointly grounding linguistic semantics in visual content, combining object recognition, spatial reasoning, and language understanding. VQA is a benchmark capability for vision-language models and a building block for assistive and augmented-reality interfaces."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:vision-language-model ;
    vc:slug "visual-question-answering" ;
    vc:sourceDomain "ai" .

ngm:vulnerability-scanning a owl:Class ;
    rdfs:label "Vulnerability Scanning"@en ;
    rdfs:comment "Vulnerability scanning is the automated process of inspecting systems, networks, and applications to identify known security weaknesses by comparing observed configurations and software versions against databases of disclosed vulnerabilities. It produces prioritised findings that feed remediation and patch-management workflows, and is typically run on a recurring schedule across an organisation's assets. Scanning is a detective control that complements deeper manual assessment such as penetration testing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:vulnerability ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:audit ;
    vc:dependsOn ngm:vulnerability ;
    vc:enables ngm:security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit ;
    vc:implements ngm:security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:automation,
        ngm:security,
        ngm:vulnerability ;
    vc:requires ngm:vulnerability ;
    vc:slug "vulnerability-scanning" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:governance ;
    vc:uses ngm:automation .

ngm:welfare-economics a owl:Class ;
    rdfs:label "Welfare Economics"@en ;
    rdfs:comment "Welfare economics is the branch of economics that evaluates the allocation of resources and the distribution of outcomes in terms of aggregate social well-being. It formalises notions of efficiency, principally Pareto efficiency, alongside frameworks for comparing distributions through social welfare functions, and provides the normative basis for assessing market outcomes, market failures, and policy interventions. In tokenised and blockchain economies it informs mechanism design, public-goods funding, and the analysis of incentive structures that determine whether decentralised systems produce socially desirable equilibria."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-goods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:microeconomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-theory ],
        ngm:microeconomics ;
    vc:bridgesTo ngm:behavioural-economics,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:behavioural-economics ;
    vc:dependsOn ngm:utility-theory ;
    vc:enables ngm:mechanism-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:public-goods,
        ngm:utility-theory ;
    vc:isPartOf ngm:economics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:game-theory,
        ngm:public-goods ;
    vc:requires ngm:microeconomics ;
    vc:slug "welfare-economics" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:public-goods ;
    vc:uses ngm:game-theory,
        ngm:utility-theory .

ngm:wholesale-cbdc a owl:Class ;
    rdfs:label "Wholesale CBDC"@en ;
    rdfs:comment "A Wholesale Central Bank Digital Currency (wCBDC) is a form of central bank money issued in digital form and restricted to use by financial institutions—commercial banks, clearing houses, and other regulated entities—for large-value interbank settlement and financial market infrastructure operations, as distinct from retail CBDC which is available to the general public. Wholesale CBDCs are designed to modernise payment system infrastructure by enabling atomic delivery-versus-payment settlement, programmable payment conditions through smart contracts, and 24/7 settlement finality, addressing inefficiencies in legacy correspondent banking and real-time gross settlement systems. Multiple central banks are actively piloting wholesale CBDC, including Project Jura (BIS, Banque de France, SNB), Project Dunbar (BIS, MAS, SARB, RBA, BNM), and the Bank of England's New Payments Architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        ngm:central-bank-digital-currency ;
    vc:bridgesTo ngm:blockchain,
        ngm:tokenised-securities ;
    vc:contrastsWith ngm:retail-cbdc,
        ngm:stablecoin ;
    vc:enables ngm:atomic-swap,
        ngm:cross-border-payments,
        ngm:delivery-versus-payment,
        ngm:instant-value-settlement,
        ngm:monetary-policy-implementation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:central-bank,
        ngm:correspondent-banking,
        ngm:financial-infrastructure,
        ngm:real-time-gross-settlement ;
    vc:requires ngm:central-bank,
        ngm:kyc-aml-compliance ;
    vc:slug "wholesale-cbdc" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bank-for-international-settlements,
        ngm:iso-20022 ;
    vc:supports ngm:financial-stability,
        ngm:monetary-sovereignty,
        ngm:monetary-system ;
    vc:uses ngm:digital-payment-system,
        ngm:distributed-ledger,
        ngm:interoperability-protocol,
        ngm:smart-contract,
        ngm:zero-knowledge-proof .

ngm:wireless-radio a owl:Class ;
    rdfs:label "Wireless Radio"@en ;
    rdfs:comment "Wireless radio refers to the technology and systems that transmit and receive information using electromagnetic waves propagated through free space without physical conductors, encompassing the hardware, protocols, modulation schemes, and spectrum management practices that enable wireless communication across a range of frequencies from kilohertz to millimetre-wave bands. It is the physical-layer foundation of all wireless networking standards including cellular, Wi-Fi, Bluetooth, and satellite communications."@en ;
    rdfs:subClassOf ngm:telecommunications ;
    vc:enables ngm:telecommunications-infrastructure,
        ngm:wi-fi ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:antenna-array,
        ngm:radio-access-network,
        ngm:wireless-connectivity ;
    vc:slug "wireless-radio" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:radio-transceiver .

ngm:workforce-development a owl:Class ;
    rdfs:label "Workforce Development"@en ;
    rdfs:comment "Workforce development encompasses structured programmes, training environments, and skills-acquisition systems that equip individuals and organisations with the competencies required by evolving labour markets. In spatial computing contexts, it leverages immersive learning, simulation, and augmented connected workforce platforms to deliver scalable, experiential upskilling."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:dependsOn ngm:education-technology,
        ngm:virtual-reality ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:education-metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "workforce-development" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersive-learning,
        ngm:simulation .

ngm:world-wide-web-consortium a owl:Class ;
    rdfs:label "World Wide Web Consortium"@en ;
    rdfs:comment "The World Wide Web Consortium (W3C) is the principal international standards organisation for the World Wide Web, founded in 1994 by Tim Berners-Lee to develop interoperable technical specifications and guidelines. Through a consensus process its member organisations and working groups produce Recommendations covering core web technologies such as HTML, CSS, the Document Object Model, and accessibility, as well as Semantic Web standards including RDF, OWL, and SPARQL. The W3C promotes a single, open, royalty-free Web that is accessible, secure, and consistent across browsers and devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-group ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:standards-body ;
    vc:bridgesTo ngm:decentralised-identifiers,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:proprietary-standard ;
    vc:enables ngm:web-accessibility,
        ngm:web-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:web-accessibility-initiative,
        ngm:working-group ;
    vc:implements ngm:consensus-standardisation ;
    vc:isPartOf ngm:internet-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-standards,
        ngm:internet-engineering-task-force ;
    vc:requires ngm:open-standard ;
    vc:slug "world-wide-web-consortium" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3c-recommendation-process ;
    vc:supports ngm:semantic-web,
        ngm:web-standards ;
    vc:uses ngm:html,
        ngm:rdf .

ngm:xr-applications a owl:Class ;
    rdfs:label "XR Applications"@en ;
    rdfs:comment "XR Applications are software systems designed to run on extended reality platforms — encompassing augmented reality (AR), virtual reality (VR), and mixed reality (MR) — that blend real and virtual environments to deliver spatially aware, immersive user experiences. They span consumer entertainment, enterprise training, industrial maintenance, medical simulation, and remote collaboration domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-anchoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensing ],
        ngm:extended-reality ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:enables ngm:augmented-reality-collaboration,
        ngm:immersive-computing,
        ngm:remote-assistance,
        ngm:surgical-simulation,
        ngm:virtual-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:foveated-rendering,
        ngm:web-xr ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:extended-reality-xr,
        ngm:mixed-reality,
        ngm:scene-understanding,
        ngm:virtual-reality ;
    vc:requires ngm:depth-sensing,
        ngm:spatial-anchoring,
        ngm:spatial-computing ;
    vc:slug "xr-applications" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:enterprise-training,
        ngm:industrial-maintenance ;
    vc:uses ngm:augmented-reality,
        ngm:gpu-acceleration,
        ngm:hand-tracking,
        ngm:head-mounted-display,
        ngm:open-xr,
        ngm:real-time-rendering,
        ngm:spatial-audio .

ngm:zero-knowledge a owl:Class ;
    rdfs:label "Zero Knowledge"@en ;
    rdfs:comment "Cryptographic proof systems enabling a prover to convince a verifier that a statement is true without disclosing any information beyond the validity of the statement itself. zk-SNARKs and zk-STARKs are the dominant proof systems, with applications spanning blockchain scalability through ZK-rollups, privacy-preserving identity verification, confidential DeFi transactions, and verifiable AI model outputs. Foundational to privacy-preserving computation and Layer 2 scaling architectures."@en ;
    rdfs:subClassOf ngm:privacy-enhancing-computation-pec,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:blockchain-scalability,
        ngm:digital-identity,
        ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "zero-knowledge" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:decentralised-finance,
        ngm:zero-knowledge-machine-learning ;
    vc:uses ngm:cryptographic-protocol,
        ngm:cryptography .

ngm:3-d-content-pipeline a owl:Class ;
    rdfs:label "3D Content Pipeline"@en ;
    rdfs:comment "The comprehensive workflows, tools, and methodologies for creating, processing, optimising, and delivering three-dimensional assets for metaverse and spatial computing applications. A 3D content pipeline spans concept art, geometry modelling, UV mapping, PBR texturing, rigging, LOD generation, and platform-specific optimisation, integrating DCC tools, game engines, version control, and CI/CD systems to support distributed teams and continuous asset delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:character-rigging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:dependsOn ngm:asset-management-system,
        ngm:ci-cd-automation ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:procedural-generation,
        ngm:real-time-rendering,
        ngm:xr-content-delivery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-animation,
        ngm:3-d-asset,
        ngm:character-rigging,
        ngm:level-of-detail,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-generation,
        ngm:digital-twin ;
    vc:requires ngm:digital-content-creation,
        ngm:game-engine,
        ngm:version-control ;
    vc:slug "3-d-content-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
