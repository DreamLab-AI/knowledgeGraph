ngm:bank-secrecy-act a owl:Class ;
    rdfs:label "Bank Secrecy Act"@en ;
    rdfs:comment "The Bank Secrecy Act (BSA), enacted in the United States in 1970, is the primary federal anti-money-laundering statute that requires financial institutions to assist US government agencies in detecting and preventing money laundering and financial crime. It mandates customer identification, suspicious activity reporting (SARs), currency transaction reporting (CTRs), and record-keeping — establishing the foundational framework for AML compliance in the US financial system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:customer-due-diligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:beneficial-ownership ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:suspicious-activity-report ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:bc-0456-virtual-asset-service-providers,
        ngm:corporate-transparency-act,
        ngm:travel-rule ;
    vc:contrastsWith ngm:gdpr ;
    vc:enables ngm:financial-crime-detection,
