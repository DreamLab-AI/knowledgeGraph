ngm:ros-2 a owl:Class ;
    rdfs:label "ROS 2"@en ;
    rdfs:comment "ROS 2 (Robot Operating System 2) is an open-source robotics middleware framework developed by Open Robotics that provides a standardised publish-subscribe communication layer built on the DDS (Data Distribution Service) standard, along with a comprehensive ecosystem of drivers, libraries, and tools for sensor integration, motion planning, simulation, and hardware abstraction. ROS 2 supersedes ROS 1 with support for real-time execution, multi-robot systems, production-grade security via DDS-Security, and native Windows and macOS compatibility. It has become the de facto standard software framework for research and increasingly for commercial robotic platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nav2 ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:autonomous-vehicles,
        ngm:industrial-automation,
        ngm:middleware ;
    vc:contrastsWith ngm:ros-1 ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning,
        ngm:multi-robot-systems,
        ngm:real-time-control,
        ngm:robot-control,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:moveit-2,
        ngm:nav2,
        ngm:ros2-control,
        ngm:rviz2 ;
    vc:implements ngm:hardware-abstraction-layer,
        ngm:robotics-middleware ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cyclone-dds,
        ngm:gazebo-simulator,
        ngm:real-time,
        ngm:simulation-software ;
    vc:requires ngm:dds-security,
        ngm:quality-of-service ;
    vc:slug "ros-2" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:edge-computing,
        ngm:robot-simulation ;
    vc:uses ngm:colcon,
        ngm:communication-protocol,
        ngm:data-distribution-service,
        ngm:publish-subscribe-pattern,
        ngm:robot-operating-system,
        ngm:unified-robot-description-format .

ngm:safety-integrity-level a owl:Class ;
    rdfs:label "Safety Integrity Level"@en ;
    rdfs:comment "Safety Integrity Level (SIL) is a discrete measure of the risk-reduction provided by a safety function, defined by the IEC 61508 family of standards on four levels (SIL 1 to SIL 4). Each level corresponds to a target probability of dangerous failure on demand or per hour. SIL is used to specify, design, and verify that safety-related control systems achieve a tolerable level of risk."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:safety-function ;
    vc:slug "safety-integrity-level" ;
    vc:sourceDomain "robotics" .

ngm:scaling-laws a owl:Class ;
    rdfs:label "Scaling Laws"@en ;
    rdfs:comment "Scaling Laws are empirical power-law relationships describing how the performance of neural networks — typically measured as held-out cross-entropy loss — varies predictably as a function of model parameters (N), training data volume (D), and total compute budget (C). Foundational Kaplan et al. (2020) work established smooth, predictable loss curves across many orders of magnitude, while Hoffmann et al. (2022) Chinchilla analyses refined optimal compute allocation to roughly equal scaling of model size and training tokens. These relationships guide architectural decisions, compute budgeting, and capability forecasting for large foundation models. Scaling laws have since been extended beyond language modelling to vision transformers, multimodal architectures, and reinforcement learning from human feedback."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter-count ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-hardware,
        ngm:ai-safety ;
    vc:contrastsWith ngm:diminishing-returns,
        ngm:emergent-abilities ;
    vc:dependsOn ngm:compute-budget,
        ngm:cross-entropy-loss,
        ngm:model-training,
        ngm:training-data ;
    vc:enables ngm:capability-forecasting,
        ngm:compute-optimal-training,
        ngm:large-language-models,
        ngm:pre-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:parameter-count,
        ngm:power-law-exponent,
        ngm:token-count ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:data-efficiency,
        ngm:empirical-machine-learning,
        ngm:irreducible-loss,
        ngm:model-compression,
        ngm:power-law ;
    vc:slug "scaling-laws" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:ai-infrastructure-planning,
        ngm:foundation-models,
        ngm:neural-architecture-search ;
    vc:uses ngm:floating-point-operations,
        ngm:neural-network,
        ngm:transformer-architecture .

