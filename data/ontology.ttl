    vc:slug "scene-understanding" ;
    vc:sourceDomain "spatial-computing" .

ngm:simultaneous-localisation-and-mapping a owl:Class ;
    rdfs:label "Simultaneous Localisation and Mapping"@en ;
    rdfs:comment "Simultaneous Localisation and Mapping (SLAM) is a computational technique by which a mobile robot or autonomous agent concurrently estimates its own pose and builds a consistent map of a previously unknown environment from sequential sensor observations, solving the circular dependency between localisation (which requires a map) and mapping (which requires a known pose). SLAM algorithms process observations from sensors including LiDAR, stereo cameras, IMUs, and depth cameras using probabilistic frameworks such as particle filters, extended Kalman filters, or pose-graph optimisation to maintain joint estimates of the robot state and environment map."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:localisation,
        ngm:odometry ;
    vc:slug "simultaneous-localisation-and-mapping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:lidar,
        ngm:particle-filter .

ngm:swarm-robotics a owl:Class ;
    rdfs:label "Swarm Robotics"@en ;
    rdfs:comment "Swarm robotics employs large numbers of simple, autonomous agents that exhibit sophisticated collective behaviours through local interactions and DecentralizedControl|decentralised control without centralised coordination, inspired by biological swarms like ant colonies and bird flocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-agent-systems ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:autonomous-robot,
        ngm:multi-agent-systems ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "swarm-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:robot-sensor .

ngm:teleoperation a owl:Class ;
    rdfs:label "Teleoperation"@en ;
    rdfs:comment "Teleoperation is remote control of AutonomousRobot|robots and physical systems by human operators in real-time, enabling task execution in hazardous, distant, or inaccessible environments whilst maintaining human supervision and decision-making authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-robot ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:telepresence ;
