ngm:agentic-mycelia a owl:Class ;
    rdfs:label "Agentic Mycelia"@en ;
    rdfs:comment "Agentic Mycelia is a multi-layered framework of specialised AI agents—scene agents, transfer agents, onboarding agents, and jurisdictional agents—that collectively manage governance, identity, value exchange, and protocol translation across interconnected metaverse instances. Analogous to fungal mycelium, the network forms resilient, decentralised inter-instance communication that enables seamless asset transfer, reputation propagation, and automated ontology exchange between diverse virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nostr-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:agent-frameworks,
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:governance,
        ngm:metaverse-ontology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:privacy ;
    vc:requires ngm:interoperability,
        ngm:nostr-protocol ;
    vc:slug "agentic-mycelia" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:blockchain,
        ngm:large-language-models,
        ngm:self-sovereign-identity .

ngm:agentic-search a skos:Concept ;
    rdfs:label "Agentic Search"@en .

ngm:agentic-systems-domain a owl:Class ;
    rdfs:label "Agentic Systems Domain"@en ;
    rdfs:comment "The Agentic Systems Domain covers software agents that pursue goals over multiple steps by planning, invoking tools and acting on an environment. Its scope includes single-agent control loops, tool use, memory and the coordination of multiple agents. It is a sub-area of the Artificial Intelligence Domain that composes models from other domains into goal-directed behaviour. The boundary excludes the underlying model training, which belongs to the Machine Learning Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-agent-coordination ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation-domain ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:task-automation,
        ngm:tool-augmented-reasoning,
        ngm:workflow-orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent-memory,
        ngm:autonomous-agent,
        ngm:multi-agent-coordination,
        ngm:planning,
        ngm:tool-use ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:knowledge-representation-domain,
        ngm:natural-language-processing-domain,
        ngm:reinforcement-learning ;
    vc:slug "agentic-systems-domain" ;
    vc:sourceDomain "agentic-systems" .

