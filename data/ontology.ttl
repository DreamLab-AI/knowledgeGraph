    vc:sourceDomain "spatial-computing" .

ngm:bitrate a skos:Concept ;
    rdfs:label "Bitrate"@en .

ngm:bitstring-status-list a owl:Class ;
    rdfs:label "Bitstring Status List"@en ;
    rdfs:comment "Bitstring Status List is a W3C specification for expressing the revocation or suspension status of Verifiable Credentials through a compressed, publicly-hosted bitstring in which each credential is assigned a position index; setting that bit to 1 indicates revocation without disclosing which specific credential holder triggered the change. The mechanism is privacy-preserving because verifiers observe only a large compressed list, not individual credential identifiers. It supersedes the earlier Credential Status List 2021 specification and is designed to be bandwidth-efficient and herd-privacy-compatible."@en ;
    rdfs:subClassOf ngm:revocation-mechanism ;
    vc:enables ngm:credential-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:revocation-registry ;
    vc:slug "bitstring-status-list" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:verifiable-credential-standard ;
    vc:uses ngm:cryptographic-hash,
        ngm:verifiable-credentials .

ngm:blended-finance a owl:Class ;
    rdfs:label "Blended Finance"@en ;
    rdfs:comment "Blended finance is the strategic use of concessional public or philanthropic capital to mobilise additional private investment toward development and sustainability goals. By absorbing early-stage or disproportionate risk, the concessional tranche improves the risk-adjusted return of a project enough to attract commercial investors who would not otherwise participate. It is widely applied to fund infrastructure, climate, and social projects in markets perceived as too risky for purely commercial capital."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:capital-allocation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:finance ;
    vc:bridgesTo ngm:green-finance ;
    vc:contrastsWith ngm:impact-investing ;
    vc:enables ngm:impact-investing,
        ngm:social-impact,
        ngm:sustainable-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:capital-allocation,
        ngm:risk-management ;
    vc:implements ngm:capital-allocation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:esg,
        ngm:impact-investing,
        ngm:interest-rate ;
    vc:requires ngm:risk-management ;
    vc:slug "blended-finance" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:green-finance,
        ngm:sustainable-development ;
    vc:uses ngm:capital-allocation,
        ngm:risk-management .

