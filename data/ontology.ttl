    vc:enables ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training ;
    vc:relatedTo ngm:quantisation ;
    vc:requires ngm:large-language-models ;
    vc:requires ngm:pre-training ;
    vc:slug "lo-ra-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:lo-ra-wan a owl:Class ;
    rdfs:comment "LoRaWAN is a media-access-control protocol and network architecture for low-power wide-area networks, built on the LoRa physical layer's chirp spread-spectrum modulation. It connects battery-powered devices to gateways over distances of several kilometres at low data rates, with end-to-end encryption and adaptive data-rate management. LoRaWAN is widely used for long-range, low-throughput IoT telemetry such as cold-chain and environmental monitoring."@en ;
    rdfs:label "LoRaWAN"@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring ;
    vc:relatedTo ngm:io-t-sensor-network ;
    vc:slug "lo-ra-wan" ;
    vc:sourceDomain "infrastructure" .
