ngm:ai-regulation a owl:Class ;
    rdfs:label "AI Regulation"@en ;
    rdfs:comment "AI regulation encompasses binding laws, technical standards, and administrative rules imposed by national or supranational bodies to govern the entire lifecycle of artificial intelligence systems — from design and training through deployment and monitoring. Regulatory instruments range from risk-based frameworks such as the EU AI Act, which imposes tiered obligations proportional to application risk, to sector-specific rules in finance, healthcare, and critical infrastructure. Regulation aims to protect fundamental rights, ensure accountability, and promote systemic safety while preserving innovation capacity. Implementation translates abstract policy obligations into concrete engineering requirements including conformity assessments, audit trails, data governance documentation, and post-market surveillance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:cybersecurity-law,
        ngm:financial-regulation,
        ngm:product-liability ;
    vc:contrastsWith ngm:ai-self-regulation ;
    vc:enables ngm:ai-transparency-framework,
        ngm:algorithmic-accountability,
        ngm:public-trust-in-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-policy,
        ngm:risk-based-regulation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:algorithmic-bias,
        ngm:explainable-ai,
        ngm:gdpr ;
    vc:requires ngm:conformity-assessment,
        ngm:data-governance,
        ngm:regulatory-compliance,
        ngm:risk-assessment ;
    vc:slug "ai-regulation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-42001,
        ngm:nist-ai-rmf,
        ngm:oecd-ai-principles ;
    vc:supports ngm:ai-governance-framework,
        ngm:ai-safety,
        ngm:digital-rights,
        ngm:responsible-ai ;
    vc:uses ngm:impact-assessment,
        ngm:regulatory-sandbox .

