ngm:quantisation a owl:Class ;
    rdfs:label "Quantisation"@en ;
    rdfs:comment "Quantisation is a model compression technique that reduces the numerical precision of a neural network's weights and activations from high-precision floating-point formats used during training (typically FP32 or BF16) to lower bit-widths such as INT8, INT4, FP8, or binary representations. This precision reduction decreases memory footprint and accelerates matrix operations on hardware with native low-precision arithmetic units, enabling deployment of large models on memory-constrained or power-limited devices with minimal accuracy degradation. The two primary paradigms are post-training quantisation (PTQ), which applies precision reduction after training using a calibration dataset, and quantisation-aware training (QAT), which simulates low-precision arithmetic during the forward pass so the model adapts its weight distributions to minimise quantisation error. Advanced algorithms such as GPTQ, AWQ, and SmoothQuant extend these approaches to very large language models and diffusion models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:digital-signal-processing,
        ngm:fixed-point-arithmetic ;
    vc:contrastsWith ngm:knowledge-distillation,
        ngm:low-rank-factorisation,
        ngm:pruning ;
    vc:dependsOn ngm:floating-point-arithmetic,
        ngm:hardware-acceleration ;
    vc:enables ngm:edge-ai-accelerator,
        ngm:inference,
        ngm:large-language-model-deployment,
        ngm:on-device-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mixed-precision-quantisation,
        ngm:post-training-quantisation,
        ngm:quantisation-aware-training ;
    vc:isPartOf ngm:mlops,
        ngm:model-compression ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:large-language-model,
        ngm:model-compression-for-edge,
        ngm:neural-architecture-search,
        ngm:speculative-decoding,
        ngm:transformer ;
    vc:requires ngm:calibration-dataset,
        ngm:scale-factor ;
    vc:slug "quantisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hardware-acceleration,
        ngm:tensor-decomposition .

ngm:synthetic-data a owl:Class ;
    rdfs:label "Synthetic Data"@en ;
    rdfs:comment "Synthetic data is algorithmically generated content that preserves the statistical properties, distributional characteristics, and structural patterns of real-world datasets without containing actual personal or proprietary records. It is produced using techniques such as generative adversarial networks, variational autoencoders, diffusion models, rule-based simulators, and statistical resampling methods. Synthetic data serves to augment scarce or imbalanced training corpora, enable privacy-compliant data sharing under regulations such as GDPR, and stress-test machine-learning pipelines with rare, hazardous, or counterfactual edge-case scenarios. Quality is typically benchmarked via fidelity metrics such as Fréchet Inception Distance, train-on-synthetic-test-on-real accuracy, and statistical divergence measures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
