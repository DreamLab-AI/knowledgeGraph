    vc:slug "dialogue-state-tracking" ;
    vc:sourceDomain "ai" .

ngm:dicom a owl:Class ;
    rdfs:label "DICOM"@en ;
    rdfs:comment "DICOM (Digital Imaging and Communications in Medicine) is the international standard for storing, transmitting, and managing medical images and associated metadata. It defines both a file format that binds pixel data to rich patient, study, and acquisition attributes, and network services for exchanging images between modalities, archives, and viewing workstations. DICOM enables interoperability across radiology, cardiology, and other imaging-intensive specialities, and serves as the canonical data substrate for medical imaging artificial intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:interoperability-standard ;
    vc:bridgesTo ngm:electronic-health-record,
        ngm:hl7-fhir,
        ngm:interoperability-framework ;
    vc:enables ngm:clinical-decision-support,
        ngm:federated-learning,
        ngm:medical-imaging,
        ngm:medical-imaging-ai,
        ngm:telehealth ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:interoperability-standard ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:data-governance,
        ngm:digital-health,
        ngm:medical-imaging ;
    vc:requires ngm:data-protection,
        ngm:interoperability,
        ngm:privacy ;
    vc:slug "dicom" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:standards-body ;
    vc:supports ngm:computer-vision,
        ngm:deep-learning,
        ngm:healthcare-ai,
        ngm:image-segmentation ;
    vc:uses ngm:rest-api,
        ngm:semantic-interoperability .

ngm:digital-asset-lending a owl:Class ;
    rdfs:label "Digital Asset Lending"@en ;
    rdfs:comment "Financial services enabling cryptocurrency holders to lend their digital assets to borrowers through centralized platforms or decentralized protocols, earning interest yields while providing liquidity for trading, leverage, and other financial activities secured by collateralized positions."@en ;
