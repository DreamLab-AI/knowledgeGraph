# Green Blockchain Initiatives
blockchain:GreenBlockchainInitiatives rdf:type owl:Class ;
    rdfs:label "Green Blockchain Initiatives"@en ;
    rdfs:comment "Organisational and technological efforts reducing blockchain energy consumption through ProofOfStake, Layer2Scaling, renewable energy sourcing, and carbon offset programmes. Green initiatives address blockchain's environmental impact by transitioning from ProofOfWork consensus mechanisms consuming significant electricity to more efficient alternatives, deploying ZeroKnowledgeProof and other privacy techniques reducing computational overhead, and incentivising infrastructure operators to utilise renewable energy sources. Initiatives combine technical innovation with market-based mechanisms like CarbonCredits and sustainability certifications."@en ;
    skos:prefLabel "Green Blockchain Initiatives"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:green-blockchain-initiatives" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:green-blockchain-initiatives> ;
    vcw:contentHash "sha256-12-3b8682b4ba59" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0499" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0499" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:GreenBlockchainInitiatives rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:ProofOfStake
] .

blockchain:GreenBlockchainInitiatives rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:uses ;
    owl:someValuesFrom blockchain:Layer2Scaling
] .

# Renewable Energy Certificates
blockchain:RenewableEnergyCertificates rdf:type owl:Class ;
    rdfs:subClassOf blockchain:DigitalAsset ;
    rdfs:subClassOf blockchain:CarbonCredit ;
    rdfs:subClassOf blockchain:SustainabilityInstrument ;
    rdfs:subClassOf blockchain:EnvironmentalCommodity ;
    rdfs:label "Renewable Energy Certificates"@en ;
    rdfs:comment "Digital or blockchain-tokenized instruments that certify the generation of one megawatt-hour (MWh) of electricity from renewable energy sources, providing transparent, immutable proof of renewable energy consumption for carbon accounting, sustainability reporting, and regulatory compliance, with blockchain implementations enabling automated tracking, fractional ownership, peer-to-peer trading, and integration with smart contracts for renewable energy procurement, grid management, and carbon offset markets."@en ;
    skos:prefLabel "Renewable Energy Certificates"@en ;
