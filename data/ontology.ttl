ngm:impermanent-loss a owl:Class ;
    rdfs:label "Impermanent Loss"@en ;
    rdfs:comment "Impermanent loss is the opportunity cost incurred by a liquidity provider in an automated market maker (AMM) when the price ratio of deposited assets diverges from the ratio at deposit time, causing the provider's pool share to be worth less than simply holding the assets would have been. The loss is 'impermanent' because it reverses if prices return to the original ratio, but becomes realised upon withdrawal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:arbitrage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:liquidity-provision ;
    vc:bridgesTo ngm:market-making ;
    vc:contrastsWith ngm:liquidity-mining,
        ngm:order-book-exchange ;
    vc:dependsOn ngm:constant-product-formula ;
    vc:enables ngm:concentrated-liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:liquidity-provider ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:amm-algorithm,
        ngm:automated-market-maker,
        ngm:decentralized-finance,
        ngm:liquidity-pool,
        ngm:price-oracle,
        ngm:token-pair,
        ngm:yield-generation ;
    vc:requires ngm:arbitrage,
        ngm:liquidity-pool ;
    vc:slug "impermanent-loss" ;
    vc:sourceDomain "blockchain" .

ngm:incentive-alignment a owl:Class ;
    rdfs:label "Incentive Alignment"@en ;
    rdfs:comment "Incentive Alignment is the design principle by which blockchain protocols structure economic rewards and penalties such that individual rational behaviour converges with the collective goals of the network. When correctly engineered, participants who act in their own self-interest—validators confirming blocks, miners extending chains, token holders participating in governance—simultaneously reinforce system security, liveness, and integrity. Misaligned incentives produce attack vectors such as selfish mining, validator collusion, or governance capture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:51-attack,
        ngm:selfish-mining ;
    vc:enables ngm:tokenomics,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:reward-distribution ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:emission-schedule,
        ngm:governance-token,
        ngm:proof-of-stake ;
    vc:requires ngm:consensus-mechanism,
        ngm:mechanism-design ;
    vc:slug "incentive-alignment" ;
    vc:sourceDomain "blockchain" .

ngm:incident-reporting a owl:Class ;
    rdfs:label "Incident Reporting"@en ;
    rdfs:comment "Incident Reporting is a systematic process by which organisations detect, document, classify, and communicate adverse events, near-misses, or anomalous system behaviours to relevant stakeholders, regulatory bodies, and affected parties. In AI and digital systems contexts, it covers cybersecurity breaches, AI system failures, algorithmic harms, and data protection violations. Effective incident reporting is foundational to organisational learning, regulatory compliance, and public accountability, enabling causal analysis that drives systemic improvement. Mandatory disclosure obligations are increasingly codified in sector-specific legislation including NIS2, the EU AI Act, and financial services regulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:disclosure-requirements ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:ai-safety,
        ngm:cybersecurity ;
    vc:enables ngm:algorithmic-transparency-reports,
        ngm:compliance-monitoring,
        ngm:esg-reporting,
        ngm:organisational-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:disclosure-requirements,
