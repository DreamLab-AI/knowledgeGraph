ngm:cross-domain-bridge a owl:Class ;
    rdfs:label "Cross Domain Bridge"@en ;
    rdfs:comment "A Cross Domain Bridge is an architectural pattern, protocol, or middleware system that enables interoperability and data exchange between heterogeneous collaboration platforms, virtual environments, and organisational systems. Implementations include protocol translators (WebRTC, SIP, H.323), identity federation layers (SAML, OAuth, OpenID Connect), and data transformation services (REST, GraphQL, gRPC). Advanced bridges leverage blockchain for trustless cross-domain transactions and open standards such as OpenXR for spatial interoperability."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:avatar-interoperability,
