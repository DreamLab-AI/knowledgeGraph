ngm:sociotechnical-analysis a owl:Class ;
    rdfs:label "Sociotechnical Analysis"@en ;
    rdfs:comment "Sociotechnical analysis is a methodology that evaluates a technology by examining the interaction between its technical components and the human, organisational, and societal contexts in which it operates, rather than the artefact in isolation. Applied to AI, it traces how models, data, deployment settings, and affected communities jointly produce outcomes and harms. It is central to anticipating systemic risks that purely technical evaluation overlooks."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:sociotechnical-system ;
    vc:slug "sociotechnical-analysis" ;
    vc:sourceDomain "governance" .

ngm:sociotechnical-harm a owl:Class ;
    rdfs:label "Sociotechnical Harm"@en ;
    rdfs:comment "Sociotechnical harm is an adverse outcome that emerges from the interaction between a technical system and its social context rather than from a technical fault alone, such as representational harm, allocative discrimination, or erosion of public discourse. These harms are often diffuse, cumulative, and unevenly distributed across affected groups, making them hard to detect with conventional accuracy metrics. Identifying them requires attention to who is affected, how, and through what social mechanisms."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-in-large-language-models,
        ngm:sociotechnical-system ;
    vc:slug "sociotechnical-harm" ;
    vc:sourceDomain "governance" .

ngm:sociotechnical-risk a owl:Class ;
    rdfs:label "Sociotechnical Risk"@en ;
    rdfs:comment "Sociotechnical risk is the potential for harm arising from the interaction between a technical system and the social context in which it is built and used. In AI it covers harms that emerge from people, institutions and technology together rather than from code alone."@en ;
    rdfs:subClassOf ngm:ai-risk ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "sociotechnical-risk" ;
    vc:sourceDomain "ai" .

