        ngm:rendering-engine ;
    vc:requires ngm:interoperability ;
    vc:slug "virtual-environment-specification" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards .

ngm:virtual-land-rights a owl:Class ;
    rdfs:label "Virtual Land Rights"@en ;
    rdfs:comment "Blockchain-based ownership and property rights for digital land parcels in metaverse platforms, represented as NFTs that serve as digital deeds providing proof of ownership, development rights, and transferability of virtual real estate assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        ngm:digital-property-rights,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:nft-ownership-proof,
        ngm:real-estate-tokenization,
        ngm:virtual-location ;
    vc:requires ngm:blockchain-infrastructure ;
    vc:slug "virtual-land-rights" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:nft,
        ngm:smart-contract .

ngm:virtual-meeting a owl:Class ;
    rdfs:label "Virtual Meeting"@en ;
    rdfs:comment "A synchronous gathering of geographically distributed participants conducted through video conferencing, spatial computing, or immersive VR/AR technologies to enable remote collaboration. Virtual meetings span traditional video-call platforms with screen sharing and virtual whiteboards through to persistent 3D avatar-based spaces such as Meta Horizon Workrooms and Microsoft Mesh, which replicate physical presence cues including spatial audio and non-verbal body language."@en ;
    rdfs:subClassOf ngm:dc-communication,
        ngm:telecollaboration ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:immersive-workspaces,
        ngm:telecollaboration-and-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:social-vr,
        ngm:virtual-event-platform ;
    vc:slug "virtual-meeting" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:collaboration-platform,
        ngm:immersive-technology,
        ngm:spatial-computing .

ngm:virtual-production-vp a owl:Class ;
    rdfs:label "Virtual Production (VP)"@en ;
    rdfs:comment "Production technique blending real and virtual scenes using XR and real-time rendering for film, broadcast, and immersive content creation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-tracking-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-tracking ],
        ngm:rendering-technique,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:in-camera-vfx,
        ngm:interactive-filmmaking,
        ngm:live-compositing,
        ngm:previsualization,
        ngm:virtual-scouting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:camera-tracking,
        ngm:compositing-pipeline,
        ngm:led-volume,
        ngm:motion-capture,
        ngm:real-time-rendering,
        ngm:virtual-camera ;
    vc:isPartOf ngm:broadcast-production,
        ngm:film-production-workflow ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:camera-tracking-system,
        ngm:game-engine,
        ngm:led-display-system,
        ngm:render-engine,
        ngm:xr-hardware ;
    vc:slug "virtual-production-vp" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-scouting a owl:Class ;
    rdfs:label "Virtual Scouting"@en ;
    rdfs:comment "The process of exploring and evaluating potential filming locations or virtual production environments using digital tools — VR headsets, 360-degree cameras, LiDAR, and game engines — enabling directors and cinematographers to navigate locations remotely, compose shots, analyse lighting, and make blocking decisions without physical travel. Tools within Unreal Engine provide measurement, interaction, and real-time world-building capabilities compatible with major VR headsets, substantially reducing pre-production travel costs and carbon footprint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:photogrammetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:pre-production,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:virtual-production,
        ngm:virtual-production-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:pre-production ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:photogrammetry,
        ngm:virtual-reality ;
    vc:slug "virtual-scouting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:motion-capture,
        ngm:virtual-camera .

ngm:virtual-theater a owl:Class ;
    rdfs:label "Virtual Theater"@en ;
    rdfs:comment "A form of immersive performing arts that uses VR headsets and virtual environments to present theatrical productions, enabling audiences to experience performances as silent observers within the scene, with some productions featuring interactive narratives where story outcomes depend on audience ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-audio-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:performing-arts,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:accessibility,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:performing-arts ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:immersive-audio-technology,
        ngm:virtual-reality ;
    vc:slug "virtual-theater" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar,
        ngm:rendering-pipeline,
        ngm:spatial-audio .

ngm:virtual-tour a owl:Class ;
    rdfs:label "Virtual Tour"@en ;
    rdfs:comment "An interactive 360-degree digital representation of a physical location that enables remote exploration through web browsers or VR headsets, commonly used in real estate, museums, hospitality, and education to provide immersive walkthroughs without physical presence."@en ;
    rdfs:subClassOf ngm:immersive-experience,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-real-estate,
        ngm:education-metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin ;
    vc:slug "virtual-tour" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-li-dar,
        ngm:virtual-reality .

ngm:virtual-training a owl:Class ;
    rdfs:label "Virtual Training"@en ;
    rdfs:comment "The use of VR, AR, and simulation technologies to create immersive learning experiences for workforce development, enabling employees to practise skills, rehearse high-stakes scenarios, and learn procedures in safe, repeatable virtual environments with measurable outcomes. Empirical evidence — including Walmart's programme covering over one million employees — demonstrates 75% material retention and up to 4x focus improvement over e-learning. The global market was valued at USD 380 billion in 2024 and is projected to reach USD 1.42 trillion by 2034."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-technology ],
        ngm:ai-application,
        ngm:workforce-development ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-factory ;
    vc:requires ngm:immersive-technology,
        ngm:simulation ;
    vc:slug "virtual-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:immersive-learning,
        ngm:simulation-engine,
        ngm:virtual-environment .

ngm:virtual-transactions a owl:Class ;
    rdfs:label "Virtual Transactions"@en ;
    rdfs:comment "Virtual transactions are exchanges of value conducted entirely within digital environments, transferring virtual currency, tokens or digital goods between participants. They power in-world economies in games and metaverse platforms and rely on digital payment systems and currencies for settlement. Their integrity depends on secure accounting, fraud prevention and clear ownership semantics."@en ;
    rdfs:subClassOf ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-currency,
        ngm:digital-payment-system ;
    vc:slug "virtual-transactions" ;
    vc:sourceDomain "metaverse" .

ngm:virtual-try-on a owl:Class ;
    rdfs:label "Virtual Try-On"@en ;
    rdfs:comment "Virtual try-on is a computer vision and graphics technique that overlays clothing, accessories, or cosmetics onto an image or video of a person so they can preview how an item would look."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-generation ],
        ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:image-generation ;
    vc:slug "virtual-try-on" ;
    vc:sourceDomain "machine-learning" .

ngm:virtual-world-operation a owl:Class ;
    rdfs:label "Virtual World Operation"@en ;
    rdfs:comment "Virtual world operation is the ongoing technical and administrative running of a persistent virtual environment, including server orchestration, state synchronisation, content updates, moderation and economy management. It keeps the world available, consistent and safe for concurrent users across sessions. Operation is the runtime layer that realises the design encoded in a metaverse architecture or stack."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-architecture,
        ngm:metaverse-stack ;
    vc:slug "virtual-world-operation" ;
    vc:sourceDomain "metaverse" .

ngm:virtual-world-traversal a owl:Class ;
    rdfs:label "Virtual World Traversal"@en ;
    rdfs:comment "Virtual World Traversal is the set of techniques, interfaces, and protocols that enable users and agents to navigate between and within persistent virtual environments in the metaverse — including scene transitions, cross-world identity portability, spatial audio transitions, and continuous presence mechanics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:metaverse-technology ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:open-world,
        ngm:scene-management,
        ngm:spatial-audio,
        ngm:virtual-world,
        ngm:world-building ;
    vc:requires ngm:avatar-system,
        ngm:navigation,
        ngm:virtual-environment,
        ngm:virtual-presence ;
    vc:slug "virtual-world-traversal" ;
    vc:sourceDomain "spatial-computing" .

ngm:vision-processing a owl:Class ;
    rdfs:label "Vision Processing"@en ;
    rdfs:comment "Vision processing is the computational transformation of raw image and video data into structured representations and decisions, spanning low-level operations such as filtering and feature extraction through high-level recognition and interpretation. It is the algorithmic core of computer-vision systems and specialised applications such as medical imaging. Efficient vision processing increasingly runs on dedicated accelerators to meet real-time demands."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:medical-imaging-ai ;
    vc:slug "vision-processing" ;
    vc:sourceDomain "ai" .

ngm:visual-grounding a owl:Class ;
    rdfs:label "Visual Grounding"@en ;
    rdfs:comment "Visual grounding is the task of localising the region of an image or scene that corresponds to a natural-language expression, linking words to specific visual entities. It connects language understanding to perception, enabling models to point at, select or act on the object a user refers to. Visual grounding is foundational for vision-language models and for agents that operate graphical interfaces."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents,
        ngm:vision-language-model ;
    vc:slug "visual-grounding" ;
    vc:sourceDomain "ai" .

ngm:visual-marker a owl:Class ;
    rdfs:label "Visual Marker"@en ;
    rdfs:comment "A distinctive visual pattern or fiducial placed in physical environments to enable computer vision systems to determine position, orientation, and pose for augmented reality applications. Types include QR codes, AprilTags, ARTags, and custom image targets that serve as reference points for overlaying digital content; detection relies on camera capture, template matching, and pose estimation algorithms, often combined with SLAM or IMU sensor fusion for robust tracking."@en ;
    rdfs:subClassOf ngm:ar-technology,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:object-detection,
        ngm:slam ;
    vc:slug "visual-marker" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:pose-estimation,
        ngm:sensor-fusion .

ngm:visual-question-answering a owl:Class ;
    rdfs:label "Visual Question Answering"@en ;
    rdfs:comment "Visual question answering (VQA) is a multimodal AI task in which a system produces a natural-language answer to a free-form question posed about an image or scene. It requires jointly grounding linguistic semantics in visual content, combining object recognition, spatial reasoning, and language understanding. VQA is a benchmark capability for vision-language models and a building block for assistive and augmented-reality interfaces."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:vision-language-model ;
    vc:slug "visual-question-answering" ;
    vc:sourceDomain "ai" .

ngm:visual-representation a owl:Class ;
    rdfs:label "Visual Representation"@en ;
    rdfs:comment "A visual representation is a learned encoding of image or video content into a feature vector or embedding that captures semantic and structural properties useful for downstream tasks. Such representations, produced by convolutional or transformer-based encoders, support classification, retrieval, detection, and multimodal alignment. The quality of a visual representation determines transferability and sample efficiency across vision applications."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:reality-capture-system,
        ngm:vision-language-model ;
    vc:slug "visual-representation" ;
    vc:sourceDomain "ai" .

ngm:visualization-layer a owl:Class ;
    rdfs:label "Visualization Layer"@en ;
    rdfs:comment "Graphics and rendering systems responsible for displaying virtual environments, objects, and interfaces through advanced rendering pipelines and visual processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experiences,
        ngm:user-interface-rendering,
        ngm:visual-output ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:display-manager,
        ngm:graphics-pipeline,
        ngm:rendering-engine,
        ngm:shader-system ;
    vc:isPartOf ngm:presentation-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:display-hardware,
        ngm:gpu-resources,
        ngm:graphics-api ;
    vc:slug "visualization-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:vocabulary-services a owl:Class ;
    rdfs:label "Vocabulary Services"@en ;
    rdfs:comment "Technical infrastructure and APIs that provide programmatic access to controlled vocabularies, taxonomies, and ontologies, enabling applications to retrieve concept definitions, navigate broader/narrower hierarchies, validate terminology, and perform cross-vocabulary mapping for consistent semantic interpretation across platforms. Common interfaces include SPARQL endpoints, SKOS APIs, and REST services backed by platforms such as PoolParty or Metaphactory."@en ;
    rdfs:subClassOf ngm:knowledge-management,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:knowledge-graph,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "vocabulary-services" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:knowledge-management-system ;
    vc:uses ngm:controlled-vocabulary,
        ngm:ontology,
        ngm:skos-vocabulary .

ngm:voice-interfaces a owl:Class ;
    rdfs:label "Voice Interfaces"@en ;
    rdfs:comment "Voice interfaces are human-computer interaction systems that accept spoken input and respond with synthesised speech, chaining automatic speech recognition, natural-language understanding, dialogue management, and text-to-speech. They enable hands-free, eyes-free interaction across smart speakers, vehicles, and accessibility tools. Latency, recognition accuracy in noise, and natural turn-taking are the principal usability constraints."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots,
        ngm:natural-language-processing ;
    vc:slug "voice-interfaces" ;
    vc:sourceDomain "ai" .

ngm:vp9-codec a owl:Class ;
    rdfs:label "VP9 Codec"@en ;
    rdfs:comment "VP9 is an open, royalty-free video compression codec developed by Google as the successor to VP8, achieving roughly half the bitrate of H.264 at comparable quality. It supports resolutions up to 8K, 10/12-bit colour depth, and is widely deployed for streaming on YouTube and within WebRTC real-time communication. VP9's open licensing made it a key building block for browser-native video before AV1 succeeded it."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:av1-codec,
        ngm:screen-sharing ;
    vc:slug "vp9-codec" ;
    vc:sourceDomain "metaverse" .

ngm:vrm-format a owl:Class ;
    rdfs:label "VRM Format"@en ;
    rdfs:comment "An open file format standard for 3D humanoid avatars built on glTF, designed for cross-platform interoperability in VR, AR, and metaverse applications. It incorporates standardised humanoid rigging, facial blend-shape expressions, first-person gaze controls, and embedded licensing metadata, enabling seamless avatar portability across different virtual environments. In 2024 the VRM Consortium began collaboration with the Khronos Group to advance VRM specifications as official glTF extensions for international standardisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gltf-standard ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:avatar-interoperability,
        ngm:avatar-portability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3-d-file-format,
        ngm:gltf-standard ;
    vc:slug "vrm-format" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard,
        ngm:open-standard ;
    vc:uses ngm:3-d-model,
        ngm:avatar-standard .

ngm:w-3-c-did-working-group a owl:Class ;
    rdfs:label "W3C DID Working Group"@en ;
    rdfs:comment "The W3C working group responsible for developing the Decentralized Identifiers (DIDs) specifications. It is a standards-development group rather than a single document."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
