    vc:slug "cultural-heritage-xr-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:data-anonymization-pipeline a owl:Class ;
    rdfs:label "Data Anonymization Pipeline"@en ;
    rdfs:comment "An automated, multi-stage process that systematically removes, masks, or generalizes personally identifiable information (PII) from datasets to protect individual privacy while preserving data utility for analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:data-protection,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:privacy-preserving-analytics,
        ngm:secure-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:de-identification-module,
        ngm:generalization-engine,
        ngm:perturbation-function,
        ngm:pii-detector,
        ngm:risk-assessor,
        ngm:suppression-filter ;
    vc:isPartOf ngm:compliance-framework,
        ngm:data-governance,
        ngm:privacy-engineering ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-classification,
        ngm:privacy-policy,
        ngm:risk-assessment ;
    vc:slug "data-anonymization-pipeline" ;
    vc:sourceDomain "spatial-computing" .

ngm:data-discovery a owl:Class ;
    rdfs:label "Data Discovery"@en ;
    rdfs:comment "Data Discovery is the iterative process of locating, profiling, cataloguing, and contextualising data assets distributed across an organisation's storage systems, databases, data lakes, SaaS applications, and streaming pipelines to make them findable, understandable, and trustworthy for analytics, governance, and compliance purposes. It encompasses automated metadata extraction, schema inference, data profiling (statistical characterisation), lineage tracing (upstream/downstream dependencies), and classification (sensitivity tagging). Data Discovery is foundational to implementing Data Governance frameworks and enabling self-service analytics in data mesh and data fabric architectures."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-governance,
        ngm:metadata-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-discovery" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-management ;
    vc:uses ngm:data-lake,
        ngm:metadata-registry .

ngm:data-serialization a owl:Class ;
    rdfs:label "Data Serialization"@en ;
    rdfs:comment "Data Serialization is the process of converting structured in-memory data objects — including primitive types, collections, and complex graphs — into a byte-sequence or character-stream representation that can be stored persistently, transmitted across a network boundary, or reconstructed (deserialised) into an equivalent in-memory representation on a different machine or at a different time, potentially running different software. Serialization formats vary along axes of human readability (JSON, YAML, XML versus binary), schema enforcement (Protocol Buffers, Apache Avro with mandatory schemas versus schemaless JSON), compactness, and cross-language support, making format selection a critical engineering decision that affects system interoperability, performance, and evolvability."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:data-pipeline,
        ngm:interoperability-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:binary-encoding,
        ngm:data-format-standard,
        ngm:json,
        ngm:protocol-buffer,
        ngm:schema-registry ;
    vc:slug "data-serialization" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-storage ;
    vc:uses ngm:data-schema .

ngm:dc-servo-motor a owl:Class ;
    rdfs:label "DC Servo Motor"@en ;
    rdfs:comment "DC servo motor combines a direct-current electric motor with integrated or external feedback control electronics to enable precise position, velocity, or torque regulation."@en ;
    rdfs:subClassOf ngm:electric-motor,
        ngm:robo-actuation-and-control,
        ngm:servo-motor ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:dynamic-control,
        ngm:load-adaptation,
        ngm:precise-positioning,
        ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-electronics,
        ngm:current-driver,
        ngm:dc-motor,
        ngm:position-encoder ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:dc-power-supply,
        ngm:feedback-sensor,
        ngm:mechanical-load,
        ngm:servo-amplifier ;
    vc:slug "dc-servo-motor" ;
    vc:sourceDomain "robotics" .

ngm:decentralised-trust a owl:Class ;
    rdfs:label "Decentralised Trust"@en ;
    rdfs:comment "Decentralised trust is an architectural property of a system in which confidence in the correctness of data, identity claims, or transaction outcomes is derived from cryptographic proofs, distributed consensus, and transparent protocol rules rather than from reliance on any single central authority or intermediary. Rather than placing faith in a bank, government registry, or certificate authority, participants in a decentralised trust model verify claims independently using public-key cryptography, Merkle proofs, or zero-knowledge proofs enforced by a distributed network. The result is a system where trust is a computable property of the protocol rather than a social or legal delegation to an institution."@en ;
    rdfs:subClassOf ngm:trust ;
    vc:enables ngm:decentralised-finance,
        ngm:decentralised-identity,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:decentralisation,
        ngm:public-key-infrastructure ;
    vc:slug "decentralised-trust" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof,
        ngm:cryptographic-verification,
        ngm:distributed-consensus,
        ngm:trust-anchor .

ngm:decentralized-exchange-dex a owl:Class ;
    rdfs:label "Decentralized Exchange (DEX)"@en ;
    rdfs:comment "Peer-to-peer marketplace enabling direct token swaps and digital asset trading through smart contracts without centralized intermediaries or custodial control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
