    vc:bridgesTo ngm:financial-market,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:custodial-trading ;
    vc:enables ngm:permissionless-trading,
        ngm:self-custody,
        ngm:token-swap,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
