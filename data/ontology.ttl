ngm:bls-signature a owl:Class ;
    rdfs:label "BLS Signature"@en ;
    rdfs:comment "A BLS Signature (Boneh–Lynn–Shacham signature) is a cryptographic signature scheme built on bilinear pairings over elliptic curves that permits multiple individual signatures to be aggregated into a single constant-size signature, which can be verified against the aggregate of the corresponding public keys in a single pairing operation. This aggregation property drastically reduces bandwidth and verification cost when many parties must co-sign a message or attest to a block."@en ;
    rdfs:subClassOf ngm:digital-signature ;
    vc:enables ngm:consensus-mechanism,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:key-management,
        ngm:zero-knowledge-proof ;
    vc:slug "bls-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:knowledge-graph-publication-classifier-key-cryptography .

ngm:bootstrap-node a owl:Class ;
    rdfs:label "Bootstrap Node"@en ;
    rdfs:comment "A Bootstrap Node is a well-known, stable network entry point that newly joining peers contact to obtain their initial list of active participants in a peer-to-peer blockchain network. By providing a curated, long-lived set of peer addresses, bootstrap nodes solve the cold-start problem: without them a new client would have no means of discovering the network. They do not typically validate or store blocks themselves; their function is purely topological—seeding new participants into the gossip network so that subsequent peer discovery can proceed organically."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:blockchain-entity ;
    vc:enables ngm:blockchain-network,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:full-node,
        ngm:gossip-protocol,
        ngm:light-node,
        ngm:validator-node ;
    vc:requires ngm:cryptographic-protocol,
        ngm:distributed-system ;
    vc:slug "bootstrap-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-scalability .

ngm:bundle-adjustment a owl:Class ;
    rdfs:label "Bundle Adjustment"@en ;
    rdfs:comment "Bundle adjustment is a non-linear least-squares optimisation technique in computer vision and photogrammetry that simultaneously refines estimates of 3-D structure (point cloud positions) and camera parameters (extrinsics and intrinsics) so that reprojected 3-D points best match their observed 2-D image locations across all views. The name derives from the bundle of light rays connecting each camera centre to visible scene points; optimising the geometry tightens these bundles. It is the gold-standard global refinement step in structure-from-motion pipelines, visual SLAM, and aerial photogrammetry, producing metrically accurate 3-D reconstructions from overlapping images or video frames. Computationally it exploits the sparse block structure of the Jacobian via Schur complement elimination and is typically solved with the Levenberg-Marquardt algorithm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-vehicles ;
    vc:contrastsWith ngm:incremental-reconstruction,
        ngm:pose-graph-optimisation ;
    vc:enables ngm:3-d-reconstruction,
        ngm:dense-point-cloud,
        ngm:map-building,
        ngm:photogrammetry ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:levenberg-marquardt-algorithm,
        ngm:reprojection-error,
        ngm:schur-complement-elimination ;
    vc:isPartOf ngm:structure-from-motion,
        ngm:visual-slam ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:camera-pose-estimation,
        ngm:epipolar-geometry,
        ngm:simultaneous-localisation-and-mapping ;
    vc:requires ngm:camera-calibration,
        ngm:feature-extraction,
        ngm:feature-matching,
        ngm:ransac ;
    vc:slug "bundle-adjustment" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:ceres-solver,
        ngm:sift-features,
        ngm:sparse-matrix .

ngm:byte-pair-encoding a owl:Class ;
    rdfs:label "Byte Pair Encoding"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges the most frequent pairs of characters or character sequences to build a vocabulary, originally developed for data compression."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
