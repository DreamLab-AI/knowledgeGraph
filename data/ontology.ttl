    vc:slug "programmatic-advertising" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:data-privacy,
        ngm:identity-resolution,
        ngm:machine-learning-model .

ngm:proof-of-history a owl:Class ;
    rdfs:label "Proof of History"@en ;
    rdfs:comment "Proof of History is a cryptographic clock mechanism that timestamps transactions using a sequential, verifiable delay function (SHA-256 hash chain), establishing a tamper-evident historical record. This allows Solana validators to process transactions in parallel without requiring round-trip consensus on ordering, dramatically increasing throughput."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-based-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
