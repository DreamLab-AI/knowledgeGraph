ngm:directed-acyclic-graph a owl:Class ;
    rdfs:comment "A directed acyclic graph (DAG) is a graph whose edges have direction and which contains no directed cycles, so no path returns to its starting vertex. This structure naturally encodes ordered dependencies, enabling a topological ordering of vertices and making DAGs foundational for scheduling, dependency resolution, version histories, and certain distributed-ledger designs. The absence of cycles guarantees that dependency chains terminate, which underpins many algorithms built on top of the structure."@en ;
    rdfs:label "Directed Acyclic Graph"@en ;
    rdfs:subClassOf ngm:graph-theory ;
    vc:contrastsWith ngm:merkle-dag ;
    vc:dependsOn ngm:graph-theory ;
    vc:enables ngm:distributed-ledger ;
    vc:enables ngm:workflow-orchestration ;
    vc:hasMaturity ngmi:maturity-draft ;
