ngm:reflection-probe a owl:Class ;
    rdfs:label "Reflection Probe"@en ;
    rdfs:comment "A Reflection Probe is a spatial data structure placed in a 3D scene that captures a 360-degree image of its surroundings into a cubemap texture, which is then sampled by shaders to produce environment reflections on nearby surfaces. Probes are fundamental to physically based rendering pipelines, providing local ambient lighting and specular reflections without the cost of real-time ray tracing. They are placed by artists or computed automatically at bake time and can be blended across zones to produce continuous, plausible illumination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-management ],
        ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:photorealistic-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:scene-management ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reflection-probe" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physically-based-rendering,
        ngm:shader .

ngm:relighting a owl:Class ;
    rdfs:label "relighting"@en ;
    rdfs:comment "Relighting is a computer graphics and generative AI technique that computationally alters the illumination of an existing image or video, repositioning or replacing light sources to produce a different lighting environment without re-capturing the scene. Modern approaches use neural rendering models trained on diverse lighting conditions, enabling portrait relighting, object relighting, and scene relighting from a single input image. Open-source workflows in tools such as ComfyUI implement IC-Light and similar diffusion-based pipelines that rival or exceed proprietary solutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:comfy-ui-workflows ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-video,
        ngm:control-net,
        ngm:differentiable-rendering,
        ngm:inpainting ;
    vc:requires ngm:comfy-ui-workflows ;
    vc:slug "relighting" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diffusion-model,
        ngm:neural-rendering,
        ngm:physically-based-rendering .

ngm:remarkable a owl:Class ;
    rdfs:label "Remarkable"@en ;
    rdfs:comment "The reMarkable is an e-ink tablet designed for distraction-free writing, note-taking, and document annotation, running a Linux-based operating system that exposes SSH access and supports a rich ecosystem of open-source tools. Its platform enables handwriting recognition, LaTeX generation, AI-assisted prompt workflows, and integration with knowledge management systems such as Obsidian. The device occupies a distinct niche as a digital-analogue bridge for researchers and knowledge workers seeking pen-on-paper fidelity with machine-readable output."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-annotation,
        ngm:knowledge-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management-system ;
    vc:slug "remarkable" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:large-language-models,
        ngm:machine-learning .

ngm:reputation-based-bft a owl:Class ;
    rdfs:label "Reputation-Based BFT"@en ;
    rdfs:comment "Reputation-Based BFT is a variant of Byzantine Fault Tolerance in which each consensus participant is assigned a dynamic reputation score derived from its historical behaviour—vote accuracy, uptime, and honest message propagation—so that nodes with strong track records carry greater weight in the consensus outcome. This design allows the protocol to tolerate Byzantine actors more efficiently than pure stake-weighted schemes by penalising misbehaving validators through reputation decay rather than requiring slashing of locked collateral. It is commonly deployed in permissioned or consortium blockchain networks where participants are identified and accountable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:enables ngm:blockchain-governance,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:proof-of-authority,
        ngm:validator-set ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:slug "reputation-based-bft" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm,
        ngm:validator-node .

ngm:research-summary a owl:Class ;
    rdfs:label "RESEARCH_SUMMARY"@en ;
    rdfs:comment "A comprehensive synthesis document aggregating research findings, literature reviews, and academic insights across Metaverse, Blockchain, Artificial Intelligence, and Robotics domains. It distils empirical evidence, theoretical frameworks, mathematical foundations, algorithm comparisons, implementation guidance, and future research directions for practitioners and stakeholders working across these converging technological fields."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
