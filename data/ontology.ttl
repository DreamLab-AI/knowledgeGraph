    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-addressing,
        ngm:data-replication,
        ngm:peer-to-peer-network ;
    vc:implements ngm:arweave,
        ngm:filecoin,
        ngm:ipfs ;
    vc:isPartOf ngm:web3-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:encryption ;
    vc:requires ngm:cryptographic-hash,
        ngm:distributed-hash-table,
        ngm:node-incentivisation ;
    vc:slug "decentralised-storage" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:decentralised-application,
        ngm:non-fungible-token ;
    vc:uses ngm:erasure-coding,
