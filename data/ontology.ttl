ngm:grammar-system a owl:Class ;
    rdfs:label "Grammar System"@en ;
    rdfs:comment "Natural language processing components within metaverse platforms that interpret, process, and generate human language for user interactions, enabling AI-powered conversations with virtual avatars, real-time language translation, grammar correction, and adaptive dialogue systems that respond to u..."@en ;
