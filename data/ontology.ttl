    vc:contrastsWith ngm:zero-knowledge-proof ;
    vc:enables ngm:credential-verification ;
    vc:enables ngm:holder-binding ;
    vc:enables ngm:minimal-disclosure ;
    vc:enables ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ietf-rfc ;
    vc:implements ngm:oauth-working-group-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
