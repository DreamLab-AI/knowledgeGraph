            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        ngm:bc-cryptographic-primitive,
        ngm:public-key-infrastructure ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:credential-issuance,
        ngm:decentralised-trust,
        ngm:message-signing,
        ngm:peer-authentication,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bip-340-schnorr-keypair,
        ngm:key-rotation-policy,
        ngm:private-key,
        ngm:public-key ;
    vc:implements ngm:bip-340,
        ngm:secp256k1,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.86"^^xsd:float ;
    vc:requires ngm:hardware-security-module-optional,
