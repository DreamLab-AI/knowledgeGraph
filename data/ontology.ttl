ngm:industrial-symbiosis a owl:Class ;
    rdfs:comment "Industrial symbiosis is a collaborative approach within industrial ecology in which geographically proximate companies exchange materials, energy, water, and by-products to achieve collective environmental and economic benefits that are unattainable individually. By treating the waste or surplus of one facility as a resource input for another, industrial symbiosis operationalises circular economy principles at an industrial park or regional scale."@en ;
    rdfs:label "Industrial Symbiosis"@en ;
    rdfs:subClassOf ngm:circular-economy ;
    vc:enables ngm:resource-efficiency ;
    vc:enables ngm:waste-management ;
