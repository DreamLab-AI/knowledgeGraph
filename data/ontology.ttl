    vc:slug "solid-pod" ;
    vc:sourceDomain "infrastructure" .

ngm:spatial-computing-layer a owl:Class ;
    rdfs:label "Spatial Computing Layer"@en ;
    rdfs:comment "Computational layer linking digital and physical spaces through 3D mapping and context-aware processing for spatial awareness and interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
