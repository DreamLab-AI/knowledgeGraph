ngm:identity-portability a owl:Class ;
    rdfs:label "Identity Portability"@en ;
    rdfs:comment "Identity portability is the capacity for a user to move their digital identity, credentials, and associated reputation across platforms, services, or virtual worlds without re-establishing them from scratch. It relies on interoperable identity standards and user-controlled wallets so that authentication and verified attributes remain valid across boundaries. Portability is a cornerstone of self-sovereign identity and an open metaverse."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:enables ngm:avatar-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard ;
    vc:slug "identity-portability" ;
    vc:sourceDomain "infrastructure" .

