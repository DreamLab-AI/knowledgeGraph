    vc:requires ngm:cooling-system,
        ngm:mains-electricity ;
    vc:slug "power-supply" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:80-plus-certification,
        ngm:atx-standard ;
    vc:supports ngm:redundancy .

