ngm:licensing-requirements a owl:Class ;
    rdfs:label "Licensing Requirements"@en ;
    rdfs:comment "Licensing Requirements are the regulatory authorisation mandates imposed on virtual asset service providers by national or supranational regulators, ranging from state-level money transmitter licences in the United States to jurisdiction-specific crypto licences under EU MiCA, UK FCA, Singapore MAS, and Dubai VARA regimes. Compliance demands operational standards, minimum capital, custody controls, KYC procedures, AML programmes, and ongoing regulatory reporting, with global coverage costing major platforms tens to hundreds of millions of pounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:dependsOn ngm:blockchain,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bc-governance-and-regulation,
        ngm:blockchain ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:requires ngm:anti-money-laundering,
        ngm:regulatory-framework ;
    vc:slug "licensing-requirements" ;
    vc:sourceDomain "blockchain" .

