# Ground Robot
robotics:GroundRobot rdf:type owl:Class ;
    rdfs:subClassOf robotics:MobileRobot ;
    rdfs:subClassOf robotics:TerrestrialRobot ;
    rdfs:label "Ground Robot"@en ;
    rdfs:comment "Ground robot is a mobile robotic platform operating on terrestrial surfaces using wheeled, tracked, or legged locomotion to navigate and perform tasks in indoor, outdoor, or off-road environments. Ground robots range from small Inspection Robot platforms to large Autonomous Vehicle, serving applications in Warehouse Automation, Agriculture, Defense, and Planetary Exploration."@en ;
    skos:prefLabel "Ground Robot"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:ground-robot" ;
    owl:sameAs <urn:visionclaw:concept:robotics:ground-robot> ;
