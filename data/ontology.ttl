ngm:feature-engineering a owl:Class ;
    rdfs:label "Feature Engineering"@en ;
    rdfs:comment "The process of using domain knowledge and statistical transformations to construct, select, and encode input variables from raw data so that they better represent the underlying predictive signal for machine learning models. Techniques include polynomial expansion, normalisation, temporal feature extraction, embedding of categorical variables, and dimensionality reduction via PCA or autoencoders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dimensionality-reduction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        ngm:data-preprocessing ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:contrastsWith ngm:end-to-end-learning,
        ngm:representation-learning ;
    vc:dependsOn ngm:data-pipeline,
        ngm:domain-knowledge ;
    vc:enables ngm:machine-learning-discipline,
        ngm:model-training,
        ngm:predictive-modelling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:categorical-encoding,
        ngm:dimensionality-reduction,
        ngm:feature-selection ;
    vc:isPartOf ngm:automl,
        ngm:machine-learning-pipeline ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation,
        ngm:feature-store,
        ngm:shap-values ;
    vc:requires ngm:data-preprocessing,
        ngm:exploratory-data-analysis ;
    vc:slug "feature-engineering" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:transfer-learning ;
    vc:uses ngm:autoencoder,
        ngm:data-pipeline,
        ngm:principal-component-analysis .

ngm:force-control a owl:Class ;
    rdfs:label "Force Control"@en ;
    rdfs:comment "Force Control is the family of robotic control paradigms that regulate the contact force and/or torque exerted by a manipulator, end-effector, joint or whole-body system on its environment rather than (or in addition to) regulating Cartesian or joint position, formalised through a closed-loop rel..."@en ;
