        ngm:eu-consumer-protection-cooperation-network,
        ngm:financial-conduct-authority,
        ngm:ftc,
        ngm:ico,
        ngm:ofcom,
        ngm:opss,
        ngm:trading-standards ;
    vc:supports ngm:algorithmic-transparency,
        ngm:consumer-trust,
        ngm:digital-inclusion,
        ngm:fair-trading,
        ngm:informed-consent,
        ngm:market-efficiency,
        ngm:vulnerable-consumer-protection ;
    vc:uses ngm:algorithmic-auditing,
        ngm:collective-proceedings,
        ngm:complaint-analytics,
        ngm:dark-pattern-detection,
        ngm:enforcement-action,
        ngm:market-investigations,
        ngm:synthetic-content-detection .

ngm:controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "A Controller is a computational module in a robotic or cyber-physical system that receives sensor feedback and reference setpoints, applies a control law or learned policy, and generates actuator commands that drive the system towards desired states. Controllers range from classical linear regulators (PID, LQR) to nonlinear model-based controllers (Model Predictive Control) and data-driven approaches (neural network policies, reinforcement learning). They operate within a closed-loop feedback architecture where the difference between desired and measured states — the error signal — drives corrective action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:feedback-loop ;
    vc:slug "controller" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller .

ngm:creative-tools a owl:Class ;
    rdfs:label "Creative Tools"@en ;
    rdfs:comment "Creative Tools are AI-powered software applications that assist or augment human creative processes across modalities including image generation, music composition, video synthesis, 3D asset creation, and long-form text authoring. They typically rely on foundation models—particularly diffusion models and large language models—exposed through interactive interfaces or API endpoints. Their role is dual: serving as productivity accelerators for professional practitioners and as accessibility bridges that allow non-expert users to produce high-quality creative outputs."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-application ;
    vc:slug "creative-tools" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai .

ngm:cross-attention a owl:Class ;
    rdfs:label "Cross Attention"@en ;
    rdfs:comment "An attention mechanism where queries come from one sequence whilst keys and values come from a different sequence, enabling information flow between the encoder and decoder in sequence-to-sequence models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-key-value ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:self-attention ;
    vc:enables ngm:multimodal-ai,
        ngm:multimodal-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:query-key-value ;
    vc:slug "cross-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cross-chain-interoperability a owl:Class ;
    rdfs:label "Cross-Chain Interoperability"@en ;
    rdfs:comment "Cross-Chain Interoperability refers to the technical capacity for distinct blockchain networks to communicate, transfer assets, and share state without relying on a centralised intermediary. It encompasses atomic swaps, cross-chain messaging protocols, relay chains, bridge smart contracts, and inter-blockchain communication standards such as Cosmos IBC and Polkadot's XCMP. Achieving trustless interoperability requires solving the heterogeneous consensus problem—two chains with different finality guarantees must reach agreement on the validity of a cross-chain event—which is a non-trivial distributed systems challenge. The field is critical to the vision of a composable multi-chain ecosystem in which assets and logic can flow freely across sovereign networks."@en ;
    rdfs:subClassOf ngm:blockchain-interoperability ;
    vc:enables ngm:cross-chain-governance,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:cosmos-ibc,
        ngm:cross-chain-bridge,
        ngm:polkadot ;
    vc:slug "cross-chain-interoperability" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cross-chain-messaging,
        ngm:interoperability-protocol .

ngm:data-augmentation-strategies a owl:Class ;
    rdfs:label "Data Augmentation Strategies"@en ;
    rdfs:comment "Techniques that create modified versions of training examples to increase dataset diversity and model robustness. Data augmentation strategies apply transformations that preserve label semantics whilst introducing variation, improving generalisation and reducing overfitting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-pipeline ;
    vc:requires ngm:training-data ;
    vc:slug "data-augmentation-strategies" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:overfitting ;
    vc:uses ngm:generative-ai .

ngm:data-interoperability a owl:Class ;
    rdfs:label "Data Interoperability"@en ;
    rdfs:comment "Data Interoperability is the capability of heterogeneous systems, applications, and data sources to exchange, interpret, and act upon shared data without loss of meaning. It encompasses syntactic interoperability (common formats and protocols), semantic interoperability (shared vocabularies and ontologies), and pragmatic interoperability (agreed processes and workflows). Achieving data interoperability across distributed environments requires standards-based data formats, schema alignment, and API contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-pipeline,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:semantic-interoperability ;
    vc:requires ngm:data-format,
        ngm:data-standards ;
    vc:slug "data-interoperability" ;
    vc:sourceDomain "infrastructure" .

ngm:data-persistence a owl:Class ;
    rdfs:label "Data Persistence"@en ;
    rdfs:comment "Data Persistence is the property of data surviving beyond the lifetime of the process or session that created it, and the collection of mechanisms and design patterns — relational databases, distributed file systems, append-only event logs, object stores — that guarantee this durability. In transactional systems, persistence is formalised through the ACID properties (Atomicity, Consistency, Isolation, Durability), where durability specifically ensures committed transactions are not lost even in the event of system failure. Beyond single-node databases, distributed systems trade aspects of consistency for availability and partition tolerance as described in the CAP theorem, leading to a spectrum of persistence strategies from strongly consistent RDBMS to eventually consistent distributed key-value stores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-system ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:replication-system ;
    vc:requires ngm:database-system,
        ngm:distributed-system ;
    vc:slug "data-persistence" ;
    vc:sourceDomain "infrastructure" .

ngm:data-storage-layer a owl:Class ;
    rdfs:label "Data Storage Layer"@en ;
    rdfs:comment "Software layer managing persistent storage, retrieval, and lifecycle of digital assets, metadata, world state, user data, and transactional records in metaverse systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cache-layer ],
        ngm:data-layer,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:asset-persistence,
        ngm:content-distribution,
        ngm:data-analytics,
        ngm:user-profile-storage,
        ngm:world-state-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-storage,
        ngm:cache-layer,
        ngm:cdn-storage,
        ngm:database-system,
        ngm:object-storage-service ;
    vc:isPartOf ngm:metaverse-stack ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:backup-systems,
        ngm:network-infrastructure,
        ngm:storage-hardware ;
    vc:slug "data-storage-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:decentralised-autonomous-organisation a owl:Class ;
    rdfs:label "Decentralised Autonomous Organisation"@en ;
    rdfs:comment "A Decentralised Autonomous Organisation (DAO) is a blockchain-native organisational structure in which governance rules and treasury management are encoded as smart contracts executing on a public distributed ledger, enabling token-holder communities to propose, deliberate, and vote on decisions without recourse to centralised management. DAOs operate transparently with on-chain execution, typically combining governance tokens that confer voting rights with treasury contracts that hold and disburse funds. They are employed across DeFi protocols, investment clubs, grant programmes, and decentralised media organisations."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:on-chain-governance,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:tokenomics ;
    vc:slug "decentralised-autonomous-organisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract .

ngm:deepfakes a owl:Class ;
    rdfs:label "Deepfakes"@en ;
    rdfs:comment "AI-generated or manipulated synthetic media content that convincingly alters a person's appearance, voice, or actions using deep learning techniques such as GANs, autoencoders, and voice synthesis models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voice-cloning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-infrastructure ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:content-creation,
        ngm:entertainment-production,
        ngm:identity-deception,
        ngm:media-manipulation,
        ngm:misinformation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-manipulation,
        ngm:face-swapping,
        ngm:gesture-synthesis,
        ngm:synthetic-video-generation,
        ngm:voice-cloning ;
    vc:isPartOf ngm:ai-generated-content,
        ngm:synthetic-media ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:computational-infrastructure,
        ngm:deep-learning,
        ngm:generative-adversarial-network,
        ngm:neural-network,
        ngm:training-dataset ;
    vc:slug "deepfakes" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:design-software a owl:Class ;
    rdfs:label "Design Software"@en ;
    rdfs:comment "Software tools used to create, edit, and manage visual, spatial, or interactive design assets, including 2D vector and raster editors, 3D modelling and sculpting applications, CAD tools, motion graphics platforms, and UI/UX prototyping environments. In the spatial computing context, design software increasingly supports real-time 3D asset pipelines, procedural generation, and direct export to game engines and XR runtimes."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:3-d-content-generation,
        ngm:film-production,
        ngm:virtual-production-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-modeling,
        ngm:animation-software ;
    vc:slug "design-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-rendering-engine,
        ngm:computer-vision .

ngm:did-nostr-identity a owl:Class ;
    rdfs:label "DID Nostr Identity"@en ;
    rdfs:comment "A W3C DID Core|W3C Decentralised Identifier (did:nostr:<pubkey>) binding a VisionClaw Agentic Container|VisionClaw agent to its BIP-340 Schnorr Keypair|BIP-340 x-only public key, enabling cryptographic proof of identity, self-sovereign key management, and inter-agent trust without a c..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nostr-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bip-340-schnorr-keypair ],
        ngm:bc-network-component,
        ngm:distributed-identity ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:credential-issuance,
        ngm:cryptographic-identity,
        ngm:decentralised-trust,
        ngm:message-signing,
        ngm:self-sovereign-key-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bip-340-schnorr-keypair,
        ngm:did-resolution,
        ngm:private-key,
        ngm:public-key ;
    vc:implements ngm:bip-340,
        ngm:nostr-nip-01,
        ngm:schnorr-signature,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:requires ngm:bip-340-cryptography,
        ngm:nostr-protocol,
        ngm:w3-c-did-method ;
    vc:slug "did-nostr-identity" ;
    vc:sourceDomain "blockchain" .

ngm:display-technology a owl:Class ;
    rdfs:label "Display Technology"@en ;
    rdfs:comment "Display Technology encompasses the hardware, optical systems, and electronic components used to visually present information to human observers across a range of form factors, from flat panels and projection systems to head-mounted and retinal displays. Modern display systems span LCD, OLED, microLED, and laser projection substrates, each with distinct characteristics in brightness, contrast, colour gamut, refresh rate, and power consumption. For immersive computing applications including augmented and virtual reality, display technology must additionally address field of view, vergence-accommodation conflict, and waveguide efficiency. Advances in microdisplay resolution and optical engineering are critical enablers of lightweight, socially acceptable XR headsets."@en ;
    rdfs:subClassOf ngm:display-hardware ;
    vc:enables ngm:ar-display-device,
        ngm:foveated-rendering,
        ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:display-metrology,
        ngm:extended-reality ;
    vc:slug "display-technology" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:xr-device ;
    vc:uses ngm:optical-calibration-target,
        ngm:photorealistic-rendering .

ngm:distributed-consensus a owl:Class ;
    rdfs:label "Distributed Consensus"@en ;
    rdfs:comment "Distributed consensus is the computational problem and family of protocol solutions by which a set of processes in a distributed system agree on a single value or sequence of values despite the possibility of node failures, network delays, and Byzantine (arbitrarily malicious) behaviour. Achieving consensus requires that all non-faulty nodes agree on the same decision, that the decision is made by some non-faulty node, and that the agreed value was proposed by some participant — properties formalised as agreement, termination, and validity. In blockchain systems, distributed consensus is the mechanism by which decentralised networks agree on the canonical order of transactions without relying on a central coordinator."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:enables ngm:blockchain,
        ngm:decentralised-trust,
        ngm:distributed-ledger ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-system,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:slug "distributed-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm,
        ngm:consensus-protocol,
        ngm:fault-tolerance .

ngm:education-and-ai a owl:Class ;
    rdfs:label "Education and AI"@en ;
    rdfs:comment "Education and AI (Artificial Intelligence in Education, AIED) denotes the deployment of machine-learning systems—intelligent tutoring systems (ITS) such as Carnegie Learning Mathia at 600K+ US students across + districts, ALEKS at 25M+ cumulative users Knewton (acquired Wiley 2019 for ~after rais..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-analytics ],
        ngm:ai-application,
        ngm:applied-ai,
        ngm:conversational-ai-applications ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:accessibility-provisioning,
        ngm:differentiated-instruction,
        ngm:formative-feedback,
        ngm:mastery-learning,
        ngm:personalised-learning,
        ngm:scalable-tutoring,
        ngm:teacher-time-recovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adaptive-learning,
        ngm:ai-detection,
        ngm:ai-literacy-curriculum,
        ngm:ai-tutor,
        ngm:automated-grading,
        ngm:intelligent-tutoring-system,
        ngm:knowledge-tracing,
        ngm:learning-analytics ;
    vc:implements ngm:bayesian-knowledge-tracing,
        ngm:item-response-theory,
        ngm:retrieval-practice,
        ngm:rubric-based-assessment,
        ngm:socratic-dialogue,
        ngm:spaced-repetition,
        ngm:worked-example-generation ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-literacy,
        ngm:assessment-integrity,
        ngm:conversational-ai,
        ngm:datafication,
        ngm:ethan-mollick,
        ngm:generative-ai ;
    vc:requires ngm:assessment-framework,
        ngm:curriculum,
        ngm:large-language-models,
        ngm:pedagogical-theory,
        ngm:safeguarding-policy,
        ngm:student-data,
        ngm:teacher-oversight ;
    vc:slug "education-and-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:df-e-generative-ai-guidance,
        ngm:eu-ai-act-annex-iii,
        ngm:ib-ai-policy,
        ngm:oecd-ai-literacy-framework,
        ngm:ofqual-ai-guidance,
        ngm:unesco-ai-education-recommendation ;
    vc:supports ngm:aleks,
        ngm:carnegie-learning-mathia,
