    vc:slug "social-token-economy" ;
    vc:sourceDomain "spatial-computing" .

ngm:soft-prompt-embedding a owl:Class ;
    rdfs:label "Soft Prompt Embedding"@en ;
    rdfs:comment "Soft Prompt Embedding is a parameter-efficient fine-tuning technique in which a small set of continuous, learnable token vectors (soft prompts) are prepended to the model's input embedding sequence and optimised via gradient descent, conditioning a frozen large language model's behaviour without modifying its weights. Unlike discrete (hard) prompts composed of natural-language tokens, soft prompt embeddings exist solely in the continuous embedding space and have no direct human-interpretable form. This approach enables task-specific adaptation of large models at a fraction of the computational and storage cost of full fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:instruction-following ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:model-parameters ;
    vc:enables ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:parameter,
        ngm:token-embedding ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:prompt-engineering,
        ngm:prompt-tuning ;
    vc:requires ngm:embedding-model,
        ngm:large-language-models ;
    vc:slug "soft-prompt-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:soon-next-later-ai-futurology a owl:Class ;
    rdfs:label "Soon-Next-Later (AI futurology)"@en ;
    rdfs:comment "Soon-Next-Later is a structured futurology framework for categorising AI capability developments across three temporal horizons: Soon (0–5 years, capabilities already emerging in products), Next (5–10 years, capabilities requiring current research to mature), and Later (10+ years, speculative capabilities dependent on fundamental advances). The framework provides practitioners with a tractable planning scaffold that avoids both near-term over-hype and long-horizon dismissiveness."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:sovereign-ai-bid ;
    vc:enables ngm:ai-governance,
        ngm:ai-policy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:sam-hammond,
        ngm:social-contract ;
    vc:slug "soon-next-later-ai-futurology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:ai-risk .

ngm:sparse-mixture-of-experts a owl:Class ;
    rdfs:label "Sparse Mixture of Experts"@en ;
    rdfs:comment "An MoE variant with a trainable gating network that selects only a sparse combination of experts for each example, dramatically increasing model capacity whilst maintaining computational efficiency. Sparsely-gated MoE enables models with up to 137 billion parameters with manageable inference costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-model-architecture,
        ngm:model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:neural-network-architecture ;
    vc:enables ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:attention-mechanism,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:inference,
        ngm:training-data ;
    vc:slug "sparse-mixture-of-experts" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:spatial-anchoring a owl:Class ;
    rdfs:label "Spatial Anchoring"@en ;
    rdfs:comment "A technique for locking virtual objects to specific physical locations using environmental mapping, enabling persistent placement of digital content that maintains consistent position and orientation relative to real-world surfaces across sessions and devices through SLAM-based tracking and cloud..."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:location-based-ar ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-anchoring" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-computing-system a owl:Class ;
    rdfs:label "Spatial Computing System"@en ;
    rdfs:comment "An integrated computing platform that seamlessly merges digital content with physical environments, exemplified by Apple Vision Pro with its M2 and R1 chips, enabling interaction through eye tracking, hand gestures, and voice while displaying content on micro-OLED displays with spatial positionin..."@en ;
    rdfs:subClassOf ngm:mixed-reality-platform,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:spatial-interface ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-computing-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-coordinates a owl:Class ;
    rdfs:label "Spatial Coordinates"@en ;
    rdfs:comment "A unified reference frame system for positioning objects in three-dimensional virtual or mixed reality environments, including geographically-anchored poses (GeoPose) tied to Earth coordinates and local coordinate systems for scene-relative object placement with support for coordinate transformat..."@en ;
    rdfs:subClassOf ngm:coordinate-system,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:object-positioning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-coordinates" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking a owl:Class ;
    rdfs:label "Spatial Tracking"@en ;
    rdfs:comment "Technology that determines the position and orientation of objects in three-dimensional space using six degrees of freedom (6DoF), enabling precise tracking of headsets, controllers, and body movements through inside-out or outside-in sensor configurations."@en ;
    rdfs:subClassOf ngm:motion-tracking,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-vr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-tracking" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking-technology a owl:Class ;
    rdfs:label "Spatial Tracking Technology"@en ;
    rdfs:comment "Hardware and software systems that determine the position and orientation of physical objects, users, or devices in three-dimensional space in real time. Spatial tracking underpins head-mounted display tracking, hand and eye tracking, and room-scale boundary definition in virtual and mixed reality systems, enabling accurate registration between physical movement and virtual scene response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hand-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:mixed-reality,
        ngm:room-scale ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-tracking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:spatial-tracking-system ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "spatial-tracking-technology" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-web a owl:Class ;
    rdfs:label "Spatial Web"@en ;
    rdfs:comment "The Spatial Web is a computing paradigm that overlays machine-readable semantic information on physical locations and objects, enabling devices to understand and interact with the real world in context. It combines spatial computing, geospatial data, IoT sensors, and web standards to blur the boundary between physical and digital environments, and is regarded as a foundational layer for persistent augmented reality and metaverse experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:semantic-web,
        ngm:web3 ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:internet-of-things,
        ngm:spatial-anchor ;
    vc:slug "spatial-web" ;
    vc:sourceDomain "spatial-computing" .

ngm:stablecoin-token a owl:Class ;
    rdfs:label "Stablecoin Token"@en ;
    rdfs:comment "A Stablecoin Token is a blockchain-native fungible token engineered to maintain a stable value, typically pegged to a fiat currency, commodity, or basket of assets, through one of three principal mechanisms: fiat-collateralised reserves held by a custodian (e.g. USDC, USDT), crypto-collateralised over-collateralisation enforced by smart contracts (e.g. DAI), or algorithmic supply adjustment that mints and burns tokens to defend the peg without direct collateral. Stablecoins serve as the primary medium of exchange, unit of account, and store of value within decentralised finance ecosystems, enabling lending, borrowing, and trading without exposure to cryptocurrency price volatility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:interoperability,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:cryptocurrency,
        ngm:digital-currency,
        ngm:erc20-token,
        ngm:token-economics ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "stablecoin-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:price-oracle,
        ngm:tokenomics .

ngm:standards-organization a owl:Class ;
    rdfs:label "Standards Organization"@en ;
    rdfs:comment "Standards Organization is an artificial intelligence concept."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:artificial-intelligence ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "standards-organization" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:state-space-control a owl:Class ;
    rdfs:label "State Space Control"@en ;
    rdfs:comment "State Space Control is a modern control theory framework that describes dynamic systems as a set of first-order differential equations over an internal state vector, enabling full-state feedback design via techniques such as pole placement, LQR, and model predictive control. Unlike classical frequency-domain methods, state-space representations directly support multi-input multi-output systems, observer design, and optimal control synthesis, making them foundational for robotic and aerospace applications."@en ;
    rdfs:subClassOf ngm:feedback-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:motion-planning,
        ngm:multirotor-uav ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:state-space-and-other-approaches ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:control-system,
        ngm:control-theory,
        ngm:pid-control ;
    vc:slug "state-space-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:optimal-control .

ngm:state-synchronisation a owl:Class ;
    rdfs:label "State Synchronisation"@en ;
    rdfs:comment "State synchronisation is the process of ensuring that multiple distributed nodes or replicas of a system maintain consistent views of shared mutable state despite network partitions, concurrent updates, and node failures. It encompasses techniques including leader-based replication, consensus protocols, conflict-free replicated data types (CRDTs), and operational transformation to reconcile divergent states. State synchronisation defines the trade-off between consistency, availability, and partition tolerance as described by the CAP theorem, choosing different points on that spectrum depending on application requirements. It is fundamental to distributed databases, real-time collaboration tools, multiplayer games, and blockchain networks."@en ;
    rdfs:subClassOf ngm:distributed-system-protocol ;
    vc:enables ngm:realtime-collaboration,
        ngm:replication-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:conflict-resolution,
        ngm:distributed-consensus,
        ngm:real-time-synchronization,
        ngm:state-synchronization ;
    vc:slug "state-synchronisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:crdt,
        ngm:data-replication,
        ngm:state-machine-replication .

ngm:strategic-planning a owl:Class ;
    rdfs:label "Strategic Planning"@en ;
    rdfs:comment "Strategic Planning is an organisational process for defining long-term direction, priorities, and resource allocation to achieve goals within a given domain. In spatial computing and metaverse contexts, it encompasses technology roadmaps, governance design, and stakeholder alignment for platform development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-transformation,
        ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment ;
    vc:requires ngm:governance,
        ngm:risk-management ;
    vc:slug "strategic-planning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:stakeholder .

ngm:structured-light a owl:Class ;
    rdfs:label "Structured Light"@en ;
    rdfs:comment "Structured light is a 3D surface measurement technique that projects one or more known patterns — typically binary stripe sequences, sinusoidal fringes, or dot grids — onto a scene using a projector or laser, then captures the deformed pattern with one or more calibrated cameras. Because the geometry of the projection and capture system is precisely known, the per-pixel deformation of the projected pattern encodes depth, allowing a complete 3D point cloud or depth map of the object surface to be recovered through triangulation. Structured light systems achieve sub-millimetre to micrometre-scale depth accuracy and are widely deployed in industrial metrology, 3D scanning, face recognition, robotic guidance, and augmented reality depth sensing."@en ;
    rdfs:subClassOf ngm:depth-sensing ;
    vc:enables ngm:3-d-reconstruction,
        ngm:industrial-inspection,
        ngm:point-cloud-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:depth-sensor,
        ngm:lidar,
        ngm:stereo-camera ;
    vc:slug "structured-light" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:computer-vision,
        ngm:depth-estimation .

ngm:sustainable-technology a owl:Class ;
    rdfs:label "Sustainable Technology"@en ;
    rdfs:comment "Technology designed, deployed, and operated to minimise long-term environmental impact through energy efficiency, use of renewable energy sources, responsible lifecycle management, and reduction of waste and carbon emissions. In IT and spatial computing contexts this encompasses energy-efficient data centres, green cloud computing, virtualisation, sustainable software engineering practices, circular economy principles applied to hardware, and AI-driven optimisation of resource consumption. Sustainable technology sits at the intersection of governance, infrastructure design, and environmental accountability, and is increasingly mandated by corporate ESG commitments and governmental net-zero regulations."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-transformation,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:carbon-neutral-blockchain,
        ngm:circular-economy,
        ngm:governance,
        ngm:renewable-energy-certificates,
        ngm:sustainability ;
    vc:slug "sustainable-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:carbon-accounting,
        ngm:environmental-accounting .

ngm:swarm-robot a owl:Class ;
    rdfs:label "Swarm Robot"@en ;
    rdfs:comment "A Swarm Robot is a member of a multi-agent robotic system in which large numbers of simple, decentralised agents coordinate through local interactions to achieve complex collective behaviours without centralised control. Drawing from biological models such as ant colonies and flocking birds, swarm robotics enables robustness through redundancy, scalability, and emergent task execution across domains including environmental monitoring, logistics, and disaster response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collective-intelligence-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swarm-robotics ],
        ngm:autonomous-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:centralized-swarm-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:collective-intelligence-system,
        ngm:swarm-robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robo-navigation-and-planning,
        ngm:robo-safety-and-standards ;
    vc:slug "swarm-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:decentralized-swarm-control,
        ngm:multi-agent-systems .

ngm:tax-treatment-crypto a owl:Class ;
    rdfs:label "Tax Treatment Crypto"@en ;
    rdfs:comment "The application of domestic and international taxation principles, regulations, and compliance frameworks to transactions involving cryptocurrency and digital assets, encompassing capital gains taxation, income taxation, value-added tax treatment, and reporting obligations under frameworks such as HMRC guidance, IRS Notice 2014-21, and the OECD Crypto-Asset Reporting Framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-monitoring ],
        ngm:bc-governance-and-regulation,
        ngm:blockchain-compliance ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:regulatory-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:blockchain-governance,
        ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:financial-regulation,
        ngm:regulatory-compliance ;
    vc:requires ngm:compliance-framework,
        ngm:compliance-monitoring ;
    vc:slug "tax-treatment-crypto" ;
    vc:sourceDomain "blockchain" .

ngm:tcfd a owl:Class ;
    rdfs:label "TCFD"@en ;
    rdfs:comment "The Task Force on Climate-related Financial Disclosures (TCFD) is a disclosure framework established by the Financial Stability Board in 2015 under Mark Carney's initiative, designed to help companies and financial institutions consistently report material climate-related risks and opportunities in a format useful to investors, lenders, and insurers. The framework is structured around four thematic pillars—Governance, Strategy, Risk Management, and Metrics and Targets—and emphasises scenario analysis to disclose how different climate futures (aligned with 1.5°C, 2°C, or 4°C pathways) affect an organisation's financial position. TCFD recommendations have been incorporated into mandatory regulatory regimes in the UK, EU, New Zealand, and other jurisdictions, and serve as the conceptual foundation for the IFRS Sustainability Disclosure Standards (ISSB S2)."@en ;
    rdfs:subClassOf ngm:sustainability-reporting ;
    vc:enables ngm:environmental-sustainability,
        ngm:green-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:esg-investing,
        ngm:esg-reporting,
        ngm:risk-assessment,
        ngm:risk-management ;
    vc:slug "tcfd" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:financial-stability .

ngm:technical-architecture a owl:Class ;
    rdfs:label "Technical Architecture"@en ;
    rdfs:comment "Technical Architecture is the structured design of a system's components, their relationships, and the principles governing their evolution. It defines how hardware, software, data, and communication elements are organised to satisfy functional and non-functional requirements within a spatial computing or platform context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computing-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrastructure-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-architecture ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:distributed-system-architecture,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:infrastructure-architecture,
        ngm:network-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:software-architecture ;
    vc:requires ngm:computing-infrastructure,
        ngm:system-architecture ;
    vc:slug "technical-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:technology-stack a owl:Class ;
    rdfs:label "Technology Stack"@en ;
    rdfs:comment "The integrated set of software components, frameworks, libraries, runtime environments, and infrastructure services that together support the development and operation of a digital application or platform. In spatial computing contexts, a technology stack spans from hardware drivers and operating systems through XR runtimes, game engines, and application frameworks up to user-facing interfaces and cloud services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:system-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:runtime-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:operating-system,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:middleware,
        ngm:runtime-environment,
        ngm:system-software ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "technology-stack" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:rendering-engine .

ngm:telecollaboration-and-telepresence a owl:Class ;
    rdfs:label "Telecollaboration and Telepresence"@en ;
    rdfs:comment "Telecollaboration and Telepresence are complementary technologies enabling geographically distributed participants to share a common virtual or augmented workspace with a sense of physical co-presence. They combine real-time audiovisual communication, spatial audio, avatar embodiment, and low-latency networking to support synchronous collaborative tasks across professional, educational, and social domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-conferencing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:sc-platform-and-environment,
        ngm:telepresence ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:distributed-work,
        ngm:immersive-communication,
        ngm:robotic-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
