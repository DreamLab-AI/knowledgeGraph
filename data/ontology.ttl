ngm:inclusive-design a owl:Class ;
    rdfs:label "Inclusive Design"@en ;
    rdfs:comment "Inclusive design is a design methodology and philosophy that creates products, services, environments, and digital experiences to be usable by the widest possible range of people across diverse abilities, ages, languages, cultures, and contexts, without requiring specialised adaptations or separate versions for different user groups. It treats human diversity as a design resource rather than a problem to be accommodated, recognising that designing for people with disabilities, situational impairments, or non-standard use contexts typically produces solutions that benefit all users. The approach is distinct from universal design in emphasising process — including people with diverse characteristics as active co-designers throughout — rather than solely optimising for a single configuration serving all. Across digital, spatial, and AI-mediated systems, inclusive design establishes both participatory methods and measurable technical criteria that reduce systematic exclusion."@en ;
    rdfs:subClassOf ngm:universal-design ;
    vc:bridgesTo ngm:ai-fairness,
        ngm:algorithmic-bias,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:retrofitting,
        ngm:universal-design ;
    vc:enables ngm:assistive-technology,
        ngm:digital-equity,
        ngm:inclusive-participation,
        ngm:inclusive-xr-design,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:accessibility-standard,
        ngm:design-thinking,
        ngm:digital-technology-access-equity,
        ngm:disability-rights,
        ngm:usability ;
    vc:requires ngm:co-design,
        ngm:user-centred-design ;
    vc:slug "inclusive-design" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-accessibility-act,
        ngm:wai-aria,
        ngm:wcag ;
    vc:uses ngm:accessibility,
        ngm:human-computer-interaction,
        ngm:interaction-design,
        ngm:participatory-design,
        ngm:user-research .

ngm:inference-layer a owl:Class ;
    rdfs:label "Inference Layer"@en ;
    rdfs:comment "The Inference Layer is the stratum that executes trained models to produce predictions from new inputs. In the canonical stack it sits above the Model Layer and below the Middleware Layer, turning static artefacts into a live serving capability. It contains serving runtimes, batching and caching logic, and the request handling that delivers predictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:application-layer,
        ngm:middleware-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:model-layer ;
    vc:slug "inference-layer" ;
    vc:sourceDomain "ai" .

ngm:inflation-control a owl:Class ;
    rdfs:label "Inflation Control"@en ;
    rdfs:comment "Inflation Control encompasses the mechanisms, policies, and economic design patterns used within virtual and metaverse economies to regulate the creation, circulation, and destruction of virtual currency and digital assets. These controls prevent hyperinflation and value collapse by balancing supply-side minting with demand-side sinks. Effective inflation control underpins the long-term viability of play-to-earn ecosystems, NFT markets, and decentralised finance platforms built on virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:minting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sink-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:burning-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circulating-supply ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:creator-economy,
        ngm:digital-economy,
        ngm:play-to-earn-p2-e ;
    vc:hasMaturity ngmi:maturity-established ;
