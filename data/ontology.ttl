ngm:metrics-collection a owl:Class ;
    rdfs:label "Metrics Collection"@en ;
    rdfs:comment "Metrics collection is the practice of instrumenting software and infrastructure to gather quantitative measurements of system behaviour, such as request rates, latencies, error counts and resource utilisation, and forwarding them to a store for analysis. Collected metrics are typically aggregated as time series and queried to drive dashboards, alerting and capacity planning. It is a foundational pillar of observability alongside logging and tracing, enabling teams to detect, diagnose and prevent operational problems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instrumentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:time-series-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-series-database ],
        ngm:observability ;
    vc:dependsOn ngm:instrumentation,
        ngm:telemetry ;
    vc:enables ngm:alerting,
        ngm:performance-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:instrumentation,
        ngm:time-series-database ;
    vc:isPartOf ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-tracing,
        ngm:infrastructure,
        ngm:logging ;
    vc:requires ngm:data-pipeline,
        ngm:time-series-database ;
    vc:slug "metrics-collection" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:monitoring,
        ngm:service-level-objective ;
    vc:uses ngm:prometheus,
        ngm:telemetry .

ngm:miner a owl:Class ;
    rdfs:label "Miner"@en ;
    rdfs:comment "A Miner is a network participant in a proof-of-work blockchain who dedicates computational resources to solving cryptographic hash puzzles, competing to produce valid blocks that extend the canonical chain in exchange for a block reward (newly issued coins plus transaction fees). Miners collectively provide the computational security of the network: the cost of mounting a 51% attack is proportional to the total hash rate, which represents real-world energy and hardware expenditure. Mining can be performed individually or cooperatively within mining pools that aggregate hash power and share rewards proportionally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:validator-node ;
    vc:dependsOn ngm:blockchain-network ;
    vc:enables ngm:block-propagation,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mining-pool ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:fee-market,
        ngm:mempool,
        ngm:mining-reward ;
    vc:slug "miner" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:proof-of-work .

ngm:model-documentation a owl:Class ;
    rdfs:label "Model Documentation"@en ;
    rdfs:comment "Model documentation is the structured recording of a machine learning model's intended use, training data, performance, limitations, and ethical considerations, typically through artefacts such as model cards and datasheets. It supports transparency, accountability, and informed deployment decisions for downstream users and regulators. It is increasingly required by AI governance frameworks and procurement standards."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-transparency-index ;
    vc:slug "model-documentation" ;
    vc:sourceDomain "ai" .

ngm:model-layer a owl:Class ;
    rdfs:label "Model Layer"@en ;
    rdfs:comment "The Model Layer is the stratum that holds trained machine learning models as deployable artefacts with fixed parameters. In the canonical stack it sits above the Algorithm Layer and below the Inference Layer, packaging learned functions for use. It contains weight sets, model metadata, and the serialised representations that inference engines load."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:inference-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:algorithm-layer,
        ngm:training-layer ;
    vc:slug "model-layer" ;
    vc:sourceDomain "ai" .

ngm:multi-step-reasoning a owl:Class ;
    rdfs:label "Multi-Step Reasoning"@en ;
    rdfs:comment "Multi-step reasoning is the capacity of an AI system to solve problems that require chaining several intermediate inferences, rather than mapping an input directly to an answer in a single step. It encompasses decomposing a problem into sub-problems, maintaining and updating intermediate state, and composing partial results into a final solution. In large language models it is elicited through chain-of-thought prompting, tool use, and search over reasoning paths, and it is a primary differentiator between shallow pattern completion and genuine problem-solving competence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:working-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:task-decomposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-consistency ],
        ngm:reasoning ;
    vc:bridgesTo ngm:automated-reasoning ;
    vc:contrastsWith ngm:inference,
        ngm:pattern-matching ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:large-language-model ;
    vc:enables ngm:autonomous-agent,
        ngm:question-answering,
        ngm:reasoning-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:task-decomposition ;
    vc:isPartOf ngm:cognitive-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:llm-agents,
        ngm:mathematical-reasoning,
        ngm:planning,
        ngm:retrieval-augmented-generation ;
    vc:requires ngm:self-consistency,
        ngm:working-memory ;
    vc:slug "multi-step-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:chain-of-thought-prompting,
        ngm:tool-use,
        ngm:tree-of-thoughts .

ngm:multi-tenancy a owl:Class ;
    rdfs:label "Multi-Tenancy"@en ;
    rdfs:comment "Multi-tenancy is a software architecture in which a single instance of an application or platform serves many independent customers, called tenants, while keeping each tenant's data, configuration, and behaviour logically isolated. It maximises resource utilisation and operational efficiency by sharing compute, storage, and code across tenants, relying on isolation boundaries to preserve privacy and prevent interference. It is foundational to software-as-a-service and to shared cloud infrastructure such as container orchestration platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        ngm:cloud-computing ;
    vc:bridgesTo ngm:kubernetes ;
    vc:dependsOn ngm:security ;
    vc:enables ngm:cloud-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cloud-computing ;
    vc:isPartOf ngm:cloud-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:observability,
        ngm:privacy ;
    vc:requires ngm:privacy,
        ngm:security ;
    vc:slug "multi-tenancy" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:kubernetes,
        ngm:service-discovery ;
    vc:uses ngm:kubernetes .

ngm:music-generation a owl:Class ;
    rdfs:label "Music Generation"@en ;
    rdfs:comment "Music generation is the use of artificial intelligence to compose, arrange or synthesise musical content, producing either symbolic scores or raw audio waveforms. It applies generative models such as transformers, diffusion models and autoregressive audio networks trained on large music corpora. Outputs range from melodic and harmonic structure to full instrumental and vocal renderings conditioned on text, style or reference material."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-synthesis ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:generative-ai ;
    vc:contrastsWith ngm:music-information-retrieval ;
    vc:dependsOn ngm:generative-adversarial-network ;
    vc:enables ngm:creative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:audio-synthesis ;
    vc:implements ngm:audio-generation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:music-information-retrieval,
        ngm:variational-autoencoder ;
    vc:requires ngm:deep-learning ;
    vc:slug "music-generation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:audio-processing ;
    vc:uses ngm:diffusion-model,
        ngm:transformer .

ngm:network-bandwidth a owl:Class ;
    rdfs:label "Network Bandwidth"@en ;
    rdfs:comment "Network bandwidth is the maximum rate at which data can be transferred across a network path, typically measured in bits per second. It defines the capacity of a communication channel rather than its current utilisation or the time taken for an individual message to traverse the path. Bandwidth interacts with latency and packet loss to determine the effective throughput experienced by applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-of-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:network-infrastructure ;
    vc:dependsOn ngm:congestion-control,
        ngm:network-infrastructure ;
    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:quality-of-service ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:latency,
        ngm:network-latency,
        ngm:quality-of-service ;
    vc:requires ngm:network-infrastructure,
        ngm:network-protocol ;
    vc:slug "network-bandwidth" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:content-delivery-network .

ngm:network-interface a owl:Class ;
    rdfs:label "Network Interface"@en ;
    rdfs:comment "A network interface is the hardware or software point at which a computing device connects to a network, mediating the transmission and reception of data frames. In hardware it is realised as a network interface controller bearing a unique MAC address; in software it appears as a named, addressable endpoint that the operating system binds to a protocol stack. The interface bridges the physical and data-link layers to the network layer, allowing higher-level protocols to send and receive packets without managing the underlying medium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-layer ],
        ngm:hardware-component ;
    vc:bridgesTo ngm:network-layer ;
    vc:dependsOn ngm:operating-system ;
    vc:enables ngm:packet-switching ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:network-layer ;
    vc:implements ngm:osi-model ;
    vc:isPartOf ngm:hardware-component ;
