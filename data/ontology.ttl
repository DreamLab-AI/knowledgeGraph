    rdfs:label "Sentence Transformers"@en .
ngm:sentencepiece-tokenisation a skos:Concept ;
    rdfs:label "Sentencepiece Tokenisation"@en .
ngm:sentiment-analysis a owl:Class ;
    rdfs:comment "Sentiment Analysis is the NLP task of determining the emotional tone, attitude, or opinion expressed in text, classifying content as positive, negative, or neutral, and extracting fine-grained emotional attributes including aspect-level sentiment, emotion detection, and subjectivity classification."@en ;
