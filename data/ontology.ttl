        ngm:design-software,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:3-d-modeling,
        ngm:construction-coordination,
        ngm:facility-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:cad-capabilities,
        ngm:collaboration-tools,
        ngm:data-management ;
    vc:slug "bim-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:binary-encoding a owl:Class ;
    rdfs:label "Binary Encoding"@en ;
    rdfs:comment "A data representation format that converts information into sequences of binary digits (0s and 1s) for efficient storage, transmission, and processing, offering compact machine-friendly representations that optimize bandwidth, reduce latency, and enable cross-platform data exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-definition ],
        ngm:data-format,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:data-serialization,
        ngm:efficient-storage,
        ngm:network-transmission ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:encoding-rules,
        ngm:parser-implementation,
        ngm:schema-definition ;
    vc:slug "binary-encoding" ;
    vc:sourceDomain "spatial-computing" .

ngm:bip-327 a owl:Class ;
    rdfs:label "BIP-327"@en ;
    rdfs:comment "BIP-327 is a Bitcoin Improvement Proposal that specifies MuSig2, a two-round multi-party Schnorr signature protocol that enables a group of n signers to collaboratively produce a single aggregated Schnorr signature indistinguishable from a single-party signature. BIP-327 provides a cryptographically secure specification for key aggregation and signature combination compatible with BIP-340 Schnorr signatures and the Taproot upgrade, enabling private and efficient threshold custody and collaborative signing workflows on Bitcoin."@en ;
    rdfs:subClassOf ngm:bitcoin-improvement-proposals ;
    vc:enables ngm:multisignature,
        ngm:multisignature-wallets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-340-schnorr-keypair,
        ngm:bip-342 ;
    vc:slug "bip-327" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:schnorr-signature,
        ngm:taproot .

ngm:bitcoin-protocol a owl:Class ;
    rdfs:label "Bitcoin Protocol"@en ;
    rdfs:comment "The set of rules governing how Bitcoin transactions are formed, validated, and ordered into blocks by proof-of-work consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        ngm:bitcoin ;
    vc:enables ngm:bitcoin-script ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:consensus-protocol,
        ngm:utxo ;
    vc:slug "bitcoin-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:block-storage a owl:Class ;
    rdfs:label "Block Storage"@en ;
    rdfs:comment "Block Storage is an infrastructure storage paradigm that presents raw fixed-size blocks of data to a host operating system or hypervisor, which then manages formatting, file system placement, and I/O scheduling directly. Unlike object storage or file storage, block storage exposes a low-level disk abstraction enabling high-performance, low-latency random read/write operations suitable for databases, virtual machine boot disks, and transactional workloads. Cloud providers implement block storage as network-attached volumes (e.g., AWS EBS, GCP Persistent Disk) that can be dynamically provisioned and attached to compute instances."@en ;
    rdfs:subClassOf ngm:storage-systems ;
    vc:contrastsWith ngm:distributed-storage,
        ngm:object-storage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-storage-layer ;
    vc:slug "block-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-system,
        ngm:persistent-storage ;
    vc:uses ngm:file-system .

ngm:blockchain-anchoring a owl:Class ;
    rdfs:label "Blockchain Anchoring"@en ;
    rdfs:comment "Blockchain Anchoring is a technique for binding external data or documents to a blockchain by embedding a cryptographic hash of that data in a blockchain transaction, thereby creating a tamper-evident, timestamped proof of existence and integrity that can be independently verified by any party with access to the document and the chain. The blockchain's immutability and distributed consensus guarantee that the anchoring transaction cannot be altered retroactively, providing a trust anchor without requiring the document itself to be stored on-chain. Applications span document notarisation, supply chain provenance, audit logs, and verifiable credential revocation."@en ;
    rdfs:subClassOf ngm:blockchain-infrastructure ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:immutable-record ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-proof,
        ngm:timestamp ;
    vc:slug "blockchain-anchoring" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree .

ngm:blockchain-consensus a owl:Class ;
    rdfs:label "Blockchain Consensus"@en ;
    rdfs:comment "Blockchain Consensus refers to the family of distributed agreement protocols by which independent, potentially adversarial nodes in a blockchain network reach agreement on a single canonical version of the transaction ledger, including the ordering, validity, and finality of all blocks. These protocols must tolerate Byzantine faults — nodes that may behave maliciously or arbitrarily — and operate across open, permissionless networks without a trusted coordinator. The choice of consensus mechanism fundamentally shapes a blockchain's security model, throughput, energy consumption, and degree of decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nakamoto-consensus ],
        ngm:consensus-mechanism ;
    vc:enables ngm:finality,
        ngm:sybil-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nakamoto-consensus,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-ledger ;
    vc:slug "blockchain-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:cryptographic-hash-function .

ngm:bloom-filter a owl:Class ;
    rdfs:label "Bloom Filter"@en ;
    rdfs:comment "A Bloom Filter is a space-efficient probabilistic data structure that tests whether an element is a member of a set, accepting a controllable false-positive rate while guaranteeing zero false negatives. Invented by Burton Howard Bloom in 1970, the structure uses multiple hash functions to map elements to bit positions within a fixed-size bit array. Membership queries are answered in constant time regardless of set size, making Bloom Filters indispensable in high-throughput systems where exact lookup is prohibitively expensive. They are widely deployed in databases, networking, distributed caches, and blockchain nodes."@en ;
    rdfs:subClassOf ngm:data-structure ;
    vc:contrastsWith ngm:spatial-data-structure ;
    vc:enables ngm:latency,
        ngm:membership-inference,
        ngm:privacy-filter ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-data-structure,
        ngm:hash-function,
        ngm:probabilistic-model ;
    vc:slug "bloom-filter" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:hash-collision .

ngm:bm25 a owl:Class ;
    rdfs:label "BM25"@en ;
    rdfs:comment "BM25 (Best Match 25) is a probabilistic bag-of-words ranking function used in information retrieval to score documents against a query based on term frequency saturation, document length normalisation, and inverse document frequency weighting. Derived from the BM family of retrieval functions developed at the Robertson-Spärck Jones framework in the 1970s-1990s, BM25 extends TF-IDF by applying a saturation parameter (k1) that prevents very high term frequencies from dominating relevance scores and a length normalisation parameter (b) that adjusts for document verbosity. It remains the dominant sparse lexical retrieval baseline in modern information retrieval systems."@en ;
    rdfs:subClassOf ngm:search-algorithm ;
    vc:enables ngm:enterprise-search,
        ngm:retrieval-augmented-generation-rag ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:search-index,
        ngm:semantic-search ;
    vc:slug "bm25" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embeddings,
        ngm:natural-language-processing .

ngm:board-level-oversight a owl:Class ;
    rdfs:label "Board-Level Oversight"@en ;
    rdfs:comment "Board-Level Oversight refers to the governance responsibility of a corporate or institutional board of directors to monitor, evaluate, and guide the organisation's strategic direction, risk appetite, executive conduct, and compliance posture. It encompasses the board's duty to act as an informed check on executive management, reviewing material risks—including operational, financial, legal, reputational, and increasingly technology risks such as AI adoption—on behalf of shareholders and other stakeholders."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:boardroom,
        ngm:compliance,
        ngm:governance-framework ;
    vc:slug "board-level-oversight" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit,
        ngm:risk-management .

ngm:bolt-specifications a owl:Class ;
    rdfs:label "BOLT Specifications"@en ;
    rdfs:comment "The BOLT (Basis of Lightning Technology) specifications are the open, community-maintained set of documents defining the Lightning Network protocol, covering peer messaging, channel establishment and closure, commitment transactions, onion-routed payments, and invoice formats. By specifying the wire protocol and behaviour precisely, BOLTs ensure that independently developed Lightning implementations interoperate on a single payment network layered atop Bitcoin. They are the normative reference that makes the Lightning Network a multi-implementation open standard rather than a single product."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:lightning-network ;
    vc:slug "bolt-specifications" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:network-protocol .

ngm:browser-automation a owl:Class ;
    rdfs:label "Browser Automation"@en ;
    rdfs:comment "Browser Automation is the programmatic control of web browsers to execute tasks—navigation, form submission, data extraction, and UI interaction—without direct human input. It spans a spectrum from low-level Chrome DevTools Protocol (CDP) scripting and WebDriver-based frameworks to high-level tools such as Playwright and Puppeteer, as well as AI-driven computer-use agents that perceive and act upon rendered page content. Browser automation underpins modern software testing pipelines, robotic process automation, and agentic AI workflows that must interact with web-based services. The field has evolved rapidly with the emergence of large language model agents capable of interpreting visual page state and generating action sequences autonomously."@en ;
    rdfs:subClassOf ngm:workflow-automation ;
    vc:enables ngm:customer-service-automation,
        ngm:testing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents,
        ngm:software-testing,
        ngm:web-scraping ;
    vc:slug "browser-automation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:adversarial-testing,
        ngm:industrial-automation ;
    vc:uses ngm:testing-process .

ngm:business-process-management a owl:Class ;
    rdfs:label "Business Process Management"@en ;
    rdfs:comment "Business Process Management (BPM) is a discipline that uses methods, techniques, and software tools to discover, model, analyse, measure, improve, and automate business processes — end-to-end workflows that produce value for internal stakeholders or external customers. It combines organisational management practice with process automation technology to make organisational operations more efficient, agile, and aligned with strategic goals."@en ;
    rdfs:subClassOf ngm:enterprise-architecture ;
    vc:enables ngm:digital-transformation,
        ngm:process-automation,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-management ;
    vc:slug "business-process-management" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:service-oriented-architecture .

ngm:byzantine-fault-tolerant-system a owl:Class ;
    rdfs:label "Byzantine Fault Tolerant System"@en ;
    rdfs:comment "A Byzantine Fault Tolerant System is a distributed computing system designed to continue operating correctly even when a subset of its nodes exhibit arbitrary failures, including malicious or contradictory behaviour. It implements protocols guaranteeing safety and liveness as long as fewer than one-third of participants are faulty, underpinning consensus in blockchain and distributed ledger networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:consensus-mechanism,
        ngm:consensus-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:byzantine-fault-tolerance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-algorithm ;
    vc:slug "byzantine-fault-tolerant-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:blockchain-network .

ngm:c2-pa-content-credentials a owl:Class ;
    rdfs:label "C2PA Content Credentials"@en ;
    rdfs:comment "C2PA Content Credentials are cryptographically signed metadata manifests, defined by the C2PA technical specification, that are embedded in or bound to digital media assets to record their origin, capture conditions, AI generation provenance, and editing history. Each Content Credential is a JUMBF-structured assertion set signed using the COSE (CBOR Object Signing and Encryption) standard, anchored to the file via a hash binding that detects tampering. Verifiers — including browser extensions, social media platforms, and editing software — can retrieve and display the credential chain to users, enabling transparent provenance for photographs, video, audio, and AI-generated content."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:deepfakes ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:c2-pa-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "c2-pa-content-credentials" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-generated-content-disclosure,
        ngm:provenance-verification ;
    vc:uses ngm:digital-signature,
        ngm:provenance-tracking .

ngm:cad-software a owl:Class ;
    rdfs:label "CAD Software"@en ;
    rdfs:comment "Computer-Aided Design (CAD) software is a category of application that enables engineers, architects, and designers to create, modify, analyse, and optimise two-dimensional drawings and three-dimensional geometric models of physical artefacts and structures. CAD tools encode geometry using boundary representation (B-rep) or constructive solid geometry (CSG) methods, support parametric constraint-based modelling, and produce outputs usable in manufacturing, simulation, and visualisation pipelines."@en ;
    rdfs:subClassOf ngm:design-software ;
    vc:enables ngm:manufacturing-process,
        ngm:parametric-modeling,
        ngm:product-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:manufacturing-automation ;
    vc:slug "cad-software" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:mesh-data .

ngm:carbon-neutrality a owl:Class ;
    rdfs:label "Carbon Neutrality"@en ;
    rdfs:comment "Carbon neutrality is a state in which an entity — an organisation, product, event, or country — achieves a net-zero balance between its greenhouse gas emissions and the carbon dioxide it removes or offsets, such that its net contribution to atmospheric CO₂ concentration is zero over a defined accounting period. It is typically achieved through a combination of direct emissions reductions, procurement of renewable energy, and the purchase and retirement of independently verified carbon credits representing emissions avoided or removed elsewhere. Carbon neutrality is distinct from net-zero emissions, which generally requires deeper reductions and limits the role of offsets, and from climate positivity, which requires net negative emissions."@en ;
    rdfs:subClassOf ngm:carbon-neutrality-planning ;
    vc:enables ngm:esg-reporting,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:carbon-neutrality-verification,
        ngm:voluntary-carbon-market ;
    vc:slug "carbon-neutrality" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:carbon-credits,
        ngm:carbon-offset-programme .

ngm:carbon-offset-programme a owl:Class ;
    rdfs:label "Carbon Offset Programme"@en ;
    rdfs:comment "A carbon offset programme is a structured scheme that generates, certifies, issues, and retires carbon credits representing greenhouse gas emissions reductions or removals achieved by specific projects or activities, providing a mechanism by which organisations or individuals can compensate for their own emissions by financing equivalent climate action elsewhere. Programmes operate under standards bodies — including the Verified Carbon Standard (Verra), Gold Standard, American Carbon Registry (ACR), and Climate Action Reserve — that define methodologies for quantifying emissions impacts, require independent verification, and maintain public registries to prevent double-counting of credits. Projects include avoided deforestation (REDD+), renewable energy, methane capture, reforestation, and engineered carbon removal."@en ;
    rdfs:subClassOf ngm:carbon-offset-trading ;
    vc:enables ngm:carbon-neutrality,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:environmental-certificate,
        ngm:esg-reporting ;
    vc:slug "carbon-offset-programme" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:carbon-credits,
        ngm:carbon-offset-certificate,
        ngm:carbon-registry .

ngm:carbon-offset-trading a owl:Class ;
    rdfs:label "Carbon Offset Trading"@en ;
    rdfs:comment "The buying and selling of verified carbon credits on voluntary and compliance markets through exchanges and over-the-counter transactions, enabling price discovery, liquidity provision, and efficient allocation of climate finance to emission reduction projects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-registry ],
        ngm:environmental-trading,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:carbon-price-discovery,
        ngm:climate-finance,
        ngm:offset-liquidity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:carbon-registry,
        ngm:market-infrastructure,
        ngm:trading-platform ;
    vc:slug "carbon-offset-trading" ;
    vc:sourceDomain "spatial-computing" .

ngm:chainlink-ccip a owl:Class ;
    rdfs:label "Chainlink CCIP"@en ;
    rdfs:comment "Chainlink Cross-Chain Interoperability Protocol (CCIP) is a cross-chain messaging and token transfer standard developed by Chainlink Labs that enables smart contracts on different blockchain networks to securely send messages and transfer assets across chain boundaries, backed by a decentralised oracle network providing an independent risk management layer that monitors and validates cross-chain transactions. CCIP introduces a programmable token transfer abstraction allowing arbitrary data payloads to accompany token movements, enabling complex cross-chain application logic."@en ;
    rdfs:subClassOf ngm:cross-chain-interoperability ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge,
        ngm:oracle-network ;
    vc:slug "chainlink-ccip" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-oracle,
        ngm:chainlink-oracles,
        ngm:smart-contract .

ngm:cloth-simulation a owl:Class ;
    rdfs:label "Cloth Simulation"@en ;
    rdfs:comment "Cloth Simulation is the computational modelling of textile deformation and dynamics, representing fabric as a mesh of particles connected by spring constraints (stretch, shear, and bend) or by a continuum-mechanics model, and integrating the equations of motion to produce plausible cloth behaviour under gravity, wind, collision, and user interaction. The particle-spring model, popularised by Provot (1995), remains prevalent in real-time applications; more accurate results for offline rendering use finite-element or position-based dynamics (PBD) methods. Collision detection and response against rigid bodies and self-collision are the principal computational bottlenecks, requiring spatial acceleration structures such as bounding volume hierarchies. Cloth simulation is a sub-discipline of physically based animation used in character clothing, flag animation, curtains, and virtual fashion design within game engines, VFX pipelines, and metaverse avatar systems."@en ;
    rdfs:subClassOf ngm:physics-simulation ;
    vc:enables ngm:dynamic-character-animation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:particle-system,
        ngm:rigid-body,
        ngm:soft-body-dynamics ;
    vc:slug "cloth-simulation" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:game-development,
        ngm:simulation-software ;
    vc:uses ngm:animation-technique,
        ngm:physics-engine .

ngm:cncf a owl:Class ;
    rdfs:label "CNCF"@en ;
    rdfs:comment "The Cloud Native Computing Foundation (CNCF) is a vendor-neutral, open-source foundation established in 2015 under the Linux Foundation to steward cloud-native software projects including Kubernetes, Prometheus, Envoy, and over 150 additional hosted projects. CNCF defines cloud-native computing as building and running scalable applications in modern, dynamic environments such as public, private, and hybrid clouds using techniques including containers, microservices, and declarative APIs. The Foundation operates a Technical Oversight Committee (TOC) that governs project acceptance through sandbox, incubating, and graduated maturity stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kubernetes ],
        ngm:linux-foundation ;
    vc:enables ngm:cloud-native-applications,
        ngm:microservices-architecture,
        ngm:open-source-software ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:kubernetes,
        ngm:open-telemetry ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:microservices,
        ngm:standards-body,
        ngm:technical-standards ;
    vc:slug "cncf" ;
    vc:sourceDomain "infrastructure" .

ngm:collaboration-technology a owl:Class ;
    rdfs:label "Collaboration Technology"@en ;
    rdfs:comment "Software and hardware systems that enable multiple participants to coordinate, communicate, and jointly produce work across physical or virtual spaces. In spatial computing contexts, collaboration technology encompasses shared XR environments, co-presence avatars, spatial audio, and synchronised digital workspace tools that support telecollaboration at a distance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:collaboration,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:telecollaboration-and-telepresence ;
    vc:requires ngm:network-infrastructure,
        ngm:quality-of-service ;
    vc:slug "collaboration-technology" ;
    vc:sourceDomain "spatial-computing" .

ngm:collaborative-filtering a owl:Class ;
    rdfs:label "Collaborative Filtering"@en ;
    rdfs:comment "Collaborative filtering is a machine learning technique for building recommendation systems that generates predictions about user preferences by aggregating the behaviour or ratings of many users, without requiring explicit knowledge of item content. Memory-based approaches compute similarity between users (user-based) or items (item-based) using rating vectors; model-based approaches such as matrix factorisation decompose the user-item interaction matrix into latent factor spaces. The method operates on the assumption that users who agreed in the past will agree in the future, and is the foundational algorithm behind recommendation engines at Netflix, Spotify, and Amazon."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:hyper-personalisation,
        ngm:recommendation-engine,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:privacy-preserving-data-mining,
        ngm:recommendation-systems ;
    vc:slug "collaborative-filtering" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embeddings,
        ngm:machine-learning .

ngm:collaborative-operation a owl:Class ;
    rdfs:label "Collaborative Operation"@en ;
    rdfs:comment "Collaborative Operation - Coordinated execution of tasks between Human Operators and Robotic Systems within the same workspace, governed by safety protocols, task allocation mechanisms, and real-time communication to achieve shared objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-feedback ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:production-flexibility,
        ngm:workspace-efficiency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:human-robot-interaction,
        ngm:manufacturing-process ;
    vc:qualityScore "0.56"^^xsd:float ;
    vc:requires ngm:force-feedback,
        ngm:safety-monitoring,
        ngm:task-planning ;
    vc:slug "collaborative-operation" ;
    vc:sourceDomain "robotics" .

ngm:collective-intelligence a owl:Class ;
    rdfs:label "Collective Intelligence"@en ;
    rdfs:comment "Collective intelligence is the shared or group intelligence that emerges from the collaboration, competition, and collective decision-making of many individuals or agents, producing cognitive capacities — prediction accuracy, problem-solving breadth, creative output — that exceed what any individual participant could achieve alone. It manifests in biological systems such as ant colonies and immune networks, human social institutions, and engineered multi-agent systems, and is characterised by distributed information processing, diversity of perspective, and aggregation mechanisms."@en ;
    rdfs:subClassOf ngm:collective-intelligence-system ;
    vc:enables ngm:collective-decision-making,
        ngm:decentralised-coordination,
        ngm:emergence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-based-models,
        ngm:governance,
        ngm:multi-agent-systems ;
    vc:slug "collective-intelligence" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:knowledge-management,
        ngm:multi-agent-system .

ngm:colmap a owl:Class ;
    rdfs:label "COLMAP"@en ;
    rdfs:comment "COLMAP is an open-source general-purpose Structure-from-Motion and multi-view stereo pipeline used to reconstruct three-dimensional scenes from unordered collections of photographs. It performs feature extraction, image matching, incremental camera pose estimation, triangulation, and dense point-cloud generation. COLMAP is widely used as a preprocessing step for neural radiance fields and 3D Gaussian Splatting pipelines. Its modular architecture supports both GPU-accelerated and CPU-only execution, making it accessible across a range of hardware configurations."@en ;
    rdfs:subClassOf ngm:structure-from-motion ;
    vc:enables ngm:3-d-gaussian-splatting,
        ngm:gaussian-splatting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:photogrammetry,
        ngm:point-cloud,
        ngm:spatial-mapping ;
    vc:slug "colmap" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:computer-vision,
        ngm:gpu-computing .

ngm:common-pool-resources a owl:Class ;
    rdfs:label "Common Pool Resources"@en ;
    rdfs:comment "Natural or human-made resources that are non-excludable to a defined community but rival in consumption, meaning one actor's use diminishes availability for others. Classic examples include fisheries, groundwater, pastures, and shared spectrum; digital analogues include shared compute pools and open training datasets. Sustainable governance requires institutions that constrain extraction without full privatisation or state control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polycentric-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-governance ],
        ngm:resource-management ;
    vc:enables ngm:community-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:property-rights,
        ngm:public-goods-funding ;
    vc:requires ngm:collective-governance,
        ngm:polycentric-governance ;
    vc:slug "common-pool-resources" ;
    vc:sourceDomain "governance" .

ngm:compiler a owl:Class ;
    rdfs:label "Compiler"@en ;
    rdfs:comment "A software system that translates source code written in a high-level programming language into a lower-level representation — typically machine code, bytecode, or an intermediate representation — performing lexical analysis, syntactic parsing, semantic checking, optimisation, and code emission in a structured pipeline. Compilers are foundational to software development, enabling human-readable programs to run efficiently on hardware."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:code-generation,
        ngm:runtime-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:onnx-runtime,
        ngm:opcodes ;
    vc:slug "compiler" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-software-engineering ;
    vc:uses ngm:programming-language .

ngm:complex-systems a owl:Class ;
    rdfs:label "Complex Systems"@en ;
    rdfs:comment "Systems composed of many interacting components whose collective behaviour cannot be simply inferred from the behaviour of the individual parts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamical-systems-theory ],
        ngm:owl-thing ;
    vc:enables ngm:emergence,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:dynamical-systems-theory ;
    vc:slug "complex-systems" ;
    vc:sourceDomain "mathematics" .

ngm:compound a owl:Class ;
    rdfs:label "Compound"@en ;
    rdfs:comment "Compound is an algorithmic, autonomous interest-rate protocol built on Ethereum that enables users to supply crypto assets to liquidity pools and earn continuously accruing interest, or borrow assets against collateral at algorithmically determined rates. Interest rates adjust dynamically based on the utilisation ratio of each asset pool, removing the need for bilateral loan negotiation. Supplied assets are represented as cTokens — ERC-20 tokens that accrue interest in real time and can themselves be used as collateral or traded. Governance of protocol parameters is conducted on-chain through the COMP token and the Compound Governor Bravo smart contract system, making it one of the earliest fully decentralised autonomous lending protocols in the DeFi ecosystem."@en ;
    rdfs:subClassOf ngm:de-fi-protocol ;
    vc:contrastsWith ngm:maker-dao ;
    vc:enables ngm:automated-market-maker,
        ngm:digital-asset-lending ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compound-governor-bravo,
        ngm:decentralised-finance,
        ngm:liquidity-pool,
        ngm:yield-farming ;
    vc:slug "compound" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contracts .

ngm:computer-vision-task a owl:Class ;
    rdfs:label "Computer Vision Task"@en ;
    rdfs:comment "A Computer Vision Task is a specific computational problem solved using visual input data, encompassing image classification, object detection, semantic segmentation, instance segmentation, and pose estimation. These tasks form the building blocks of downstream vision applications such as scene understanding, autonomous navigation, and visual question answering, typically implemented via convolutional or transformer-based neural architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:autonomous-navigation,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:image-classification,
        ngm:instance-segmentation,
        ngm:object-detection,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:isPartOf ngm:computer-vision ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:multimodal-ai ;
    vc:slug "computer-vision-task" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:feature-extraction .

ngm:consensus-layer a owl:Class ;
    rdfs:label "Consensus Layer"@en ;
    rdfs:comment "The Consensus Layer is the stratum responsible for agreement on a single canonical ordering of events across distributed participants. In the canonical stack it sits directly above the Protocol Layer and below the Data Layer, converting peer-to-peer message exchange into a shared, append-only history. It contains the agreement algorithms, fork-choice rules, and finality conditions that all participants follow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-layer ],
        ngm:owl-thing ;
    vc:enables ngm:data-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:protocol-layer ;
    vc:slug "consensus-layer" ;
    vc:sourceDomain "consensus" .

ngm:constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "A Constraint is a condition, restriction, or rule that limits the set of permissible states, actions, or solutions within a computational, logical, or physical system. Constraints formalise requirements such as resource bounds, logical invariants, safety properties, and optimality criteria, and are manipulated by constraint-satisfaction and optimisation algorithms to find feasible or optimal solutions. They appear across AI planning, machine learning regularisation, smart-contract execution, and formal verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin,
        ngm:smart-contract ;
    vc:enables ngm:formal-verification,
        ngm:reasoning,
        ngm:safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:parameter,
        ngm:property,
        ngm:system ;
    vc:requires ngm:model,
        ngm:objective ;
    vc:slug "constraint" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness,
        ngm:machine-learning,
        ngm:ontology ;
    vc:uses ngm:algorithm,
        ngm:inference,
        ngm:search-algorithm .

ngm:content-authenticity a owl:Class ;
    rdfs:label "Content Authenticity"@en ;
    rdfs:comment "Content authenticity is the property of a digital asset whereby its origin, creation history, and any subsequent modifications can be cryptographically verified and traced back to an identifiable source. It encompasses technical mechanisms — including cryptographic signatures, tamper-evident manifests, and provenance metadata — that allow consumers of media to assess whether content has been created or manipulated by humans or AI systems and whether it has been altered since its stated point of capture or creation. Content authenticity is increasingly codified through standards such as C2PA (Coalition for Content Provenance and Authenticity)."@en ;
    rdfs:subClassOf ngm:content-authentication ;
    vc:contrastsWith ngm:deepfakes-and-fraudulent-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:deepfakes,
        ngm:digital-signature,
        ngm:metadata-standard ;
    vc:slug "content-authenticity" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:c2-pa,
        ngm:cryptographic-signature,
        ngm:provenance-tracking .

ngm:content-identifier a owl:Class ;
    rdfs:label "Content Identifier"@en ;
    rdfs:comment "A Content Identifier (CID) is a self-describing, cryptographically derived label used in the InterPlanetary File System and IPLD ecosystem to uniquely identify and verify content through its hash, encoding the hash function used, the hash digest, and a multicodec descriptor for the serialised data format into a compact, version-aware multihash structure."@en ;
    rdfs:subClassOf ngm:content-addressing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-storage,
        ngm:ipfs,
        ngm:ipfs-content-addressing ;
    vc:slug "content-identifier" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:ipld,
        ngm:merkle-dag,
        ngm:multihash .

ngm:content-moderation-standards a owl:Class ;
    rdfs:label "Content Moderation Standards"@en ;
    rdfs:comment "The policies, technologies, and practices used to monitor, review, and regulate user-generated content and behavior within virtual environments and metaverse platforms, addressing challenges unique to immersive spaces including harassment, hate speech, and harmful conduct that require both tradit..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:moderation-tools ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:community-trust,
        ngm:harassment-prevention,
        ngm:user-safety ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:platform-governance ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:ai-detection-systems,
        ngm:human-moderators,
        ngm:moderation-tools ;
    vc:slug "content-moderation-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:content-pipeline a owl:Class ;
    rdfs:label "Content Pipeline"@en ;
    rdfs:comment "A Content Pipeline is the end-to-end automated or semi-automated workflow that transforms raw creative assets—geometry, textures, audio, video, or data—from authoring tools into the optimised, platform-specific formats required by a runtime engine, distribution system, or media player. It encompasses ingestion, validation, processing, compression, and delivery stages with dependency tracking and incremental rebuild capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-management ],
        ngm:production-pipeline ;
    vc:enables ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:workflow-automation ;
    vc:requires ngm:asset-management ;
    vc:slug "content-pipeline" ;
    vc:sourceDomain "media" ;
    vc:supports ngm:content-creation ;
    vc:uses ngm:asset-pipeline .

ngm:context-aware-computing a owl:Class ;
    rdfs:label "Context Aware Computing"@en ;
    rdfs:comment "Context Aware Computing is a paradigm in which systems automatically adapt their behaviour based on contextual signals such as the user's location, activity, device state, social environment, and temporal cues. In spatial computing and XR applications, context awareness allows virtual overlays and services to respond intelligently to physical surroundings, enabling location-sensitive AR, adaptive user interfaces, and personalised immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:computer-vision,
        ngm:scene-understanding ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:internet-of-things,
        ngm:sensor-fusion ;
    vc:slug "context-aware-computing" ;
    vc:sourceDomain "spatial-computing" .

ngm:control-net-and-similar-spatial-conditioning-systems a owl:Class ;
    rdfs:label "ControlNet and Similar Spatial Conditioning Systems"@en ;
    rdfs:comment "ControlNet and similar spatial conditioning systems constitute a family of neural network architectures and adapter frameworks that augment large pretrained text-to-image Diffusion Models with fine-grained spatial and semantic control signals—enabling deterministic structural guidance over ge..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
