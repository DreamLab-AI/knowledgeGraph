ngm:osi-model a owl:Class ;
    rdfs:label "OSI Model"@en ;
    rdfs:comment "The OSI (Open Systems Interconnection) Model is a conceptual reference framework developed by ISO that partitions network communication functions into seven hierarchical layers: Physical, Data Link, Network, Transport, Session, Presentation, and Application. Each layer has a well-defined responsibility and communicates with the layer immediately above and below it through standardised interfaces, enabling interoperability between heterogeneous systems from different vendors. Originally published as ISO/IEC 7498-1 in 1984, the model does not describe a concrete protocol stack but provides a universal vocabulary and design template for networking protocols. It remains the canonical educational and diagnostic framework for understanding where specific protocols, devices, and services operate within a network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:application-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physical-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:presentation-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:network-architecture ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:microservices ;
    vc:contrastsWith ngm:tcp-ip-model ;
    vc:dependsOn ngm:standardisation ;
    vc:enables ngm:network-troubleshooting,
        ngm:protocol-interoperability,
        ngm:vendor-neutrality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:application-layer,
        ngm:data-link-layer,
        ngm:network-layer,
        ngm:physical-layer,
        ngm:presentation-layer,
        ngm:session-layer,
        ngm:transport-layer ;
    vc:implements ngm:separation-of-concerns ;
    vc:isPartOf ngm:network-architecture ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:firewall,
        ngm:internet-protocol,
        ngm:network-security,
        ngm:rest-api ;
    vc:requires ngm:layered-architecture,
        ngm:network-protocol ;
    vc:slug "osi-model" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec,
        ngm:iso ;
    vc:uses ngm:encapsulation,
        ngm:protocol-data-unit .

