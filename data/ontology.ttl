    vc:implements ngm:digital-services-act,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:gdpr ;
    vc:isPartOf ngm:public-policy ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:e-government,
        ngm:net-neutrality,
        ngm:privacy ;
    vc:requires ngm:digital-infrastructure,
        ngm:multi-stakeholder-governance,
