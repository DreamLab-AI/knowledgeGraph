ngm:consistency-checking a owl:Class ;
    rdfs:label "Consistency Checking"@en ;
    rdfs:comment "Consistency checking is the process of verifying that a set of statements, data items or constraints contains no contradictions and that all derivable conclusions remain mutually compatible. In knowledge representation it confirms that an ontology or knowledge base admits at least one model, while in data systems it confirms that records satisfy declared integrity rules. The technique underpins trust in automated reasoning by rejecting configurations that would license arbitrary or unsound inferences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:verification ;
    vc:enables ngm:data-integrity,
        ngm:inference,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:schema-validation,
        ngm:semantic-web ;
    vc:requires ngm:formal-verification,
        ngm:knowledge-representation ;
    vc:slug "consistency-checking" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-validation,
        ngm:quality-assurance ;
    vc:uses ngm:constraint-satisfaction,
        ngm:inference-engine,
        ngm:theorem-proving .

ngm:constitutional-ai a skos:Concept ;
