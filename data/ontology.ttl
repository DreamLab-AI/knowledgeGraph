ngm:vision-language-action-models a owl:Class ;
    rdfs:comment "Vision-language-action (VLA) models are foundation models that jointly process visual observations and natural-language instructions to produce executable action sequences for embodied agents such as robots. Extending vision-language models with an action-generation head, VLAs are trained on large datasets pairing perception and instructions with demonstrated behaviour, enabling generalisation across tasks, objects, and embodiments. They represent a convergence of multimodal learning and robotics, aiming for generalist policies that follow open-ended commands rather than executing narrowly scripted skills."@en ;
    rdfs:label "Vision-Language-Action Models"@en ;
    rdfs:subClassOf ngm:vision-language-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai ;
    vc:relatedTo ngm:robot-learning ;
    vc:slug "vision-language-action-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:imitation-learning ;
    vc:uses ngm:multimodal-ai-architecture-learning .
ngm:vision-language-model a owl:Class ;
    rdfs:comment "A Vision Language Model (VLM) is a multimodal neural architecture that jointly processes visual inputs (images or video) and natural language text, learning shared representations that enable cross-modal tasks such as image captioning, visual question answering, visual grounding, and instruction-following based on image context. VLMs typically pair a visual encoder with a large language model backbone connected by a learned projection mechanism."@en ;
    rdfs:label "Vision Language Model"@en ;
    rdfs:subClassOf ngm:multimodal-ai-architecture-models ;
    vc:enables ngm:visual-grounding ;
    vc:enables ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:multimodal-ai-architecture-reasoning ;
    vc:slug "vision-language-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:instruction-tuning ;
    vc:uses ngm:large-language-models ;
    vc:uses ngm:visual-representation .
ngm:vision-language-models a skos:Concept ;
    rdfs:label "Vision Language Models"@en .
ngm:vision-sensing a skos:Concept ;
    rdfs:label "Vision Sensing"@en .
ngm:vision-transformer a owl:Class ;
    rdfs:comment "The Vision Transformer (ViT) is a neural network architecture that applies the transformer self-attention mechanism directly to sequences of fixed-size image patches, treating each patch embedding as a token analogous to a word in natural-language processing. Introduced by Dosovitskiy et al. (2020), ViT demonstrated that pure attention-based models can match or exceed convolutional networks on image classification benchmarks when pre-trained on sufficiently large datasets."@en ;
    rdfs:label "Vision Transformer"@en ;
    rdfs:subClassOf ngm:computer-vision ;
    rdfs:subClassOf _:r22178 ;
    rdfs:subClassOf _:r22179 ;
    rdfs:subClassOf _:r22180 ;
