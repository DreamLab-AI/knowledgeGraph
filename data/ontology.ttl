ngm:squid-router a owl:Class ;
    rdfs:label "Squid Router"@en ;
    rdfs:comment "Squid Router is a cross-chain liquidity and routing protocol built on the Axelar network that allows token swaps and transfers between different blockchains in a single transaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
