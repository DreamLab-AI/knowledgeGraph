    vc:uses ngm:hyperparameter,
        ngm:model-training .

ngm:nft-marketplace a owl:Class ;
    rdfs:label "NFT Marketplace"@en ;
    rdfs:comment "A digital platform enabling the creation, listing, buying, selling, and auctioning of non-fungible tokens (NFTs). NFT marketplaces provide discovery, escrow, royalty enforcement, and settlement infrastructure for unique digital assets, typically integrating smart contracts for trustless ownership transfer and on-chain provenance tracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
