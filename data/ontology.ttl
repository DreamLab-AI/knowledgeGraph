        ngm:world-model ;
    vc:contrastsWith ngm:formal-logic,
        ngm:symbolic-reasoning ;
    vc:dependsOn ngm:knowledge-representation,
        ngm:semantic-network ;
    vc:enables ngm:conversational-ai,
        ngm:embodied-ai,
        ngm:natural-language-understanding,
        ngm:planning,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:default-logic,
        ngm:frame-semantics,
        ngm:non-monotonic-reasoning ;
    vc:isPartOf ngm:reasoning ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:automated-reasoning,
        ngm:cognitive-architecture,
        ngm:hallucination,
        ngm:retrieval-augmented-generation,
        ngm:visual-question-answering ;
    vc:requires ngm:inference,
        ngm:knowledge-base,
        ngm:world-model ;
    vc:slug "commonsense-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:explainable-ai,
        ngm:natural-language-processing ;
    vc:uses ngm:chain-of-thought,
        ngm:knowledge-graph,
        ngm:large-language-model,
        ngm:neural-symbolic-integration .

ngm:community-decision-making a owl:Class ;
