ngm:ethereum a owl:Class ;
    rdfs:label "Ethereum"@en ;
    rdfs:comment "Ethereum is an open-source, decentralised layer-1 blockchain platform conceived by Vitalik Buterin and launched in 2015, distinguished from Bitcoin by its general-purpose programmability via the Ethereum Virtual Machine (EVM), which executes Turing-complete smart contracts deployed on a shared global state. It transitioned from Proof of Work to Proof of Stake in September 2022 (the Merge), dramatically reducing energy consumption while preserving consensus security through a validator set staking Ether (ETH). Ethereum serves as the foundational settlement layer for the majority of decentralised finance (DeFi) protocols, NFT standards, DAOs, and Layer-2 rollup networks, with its fee market governed by EIP-1559's base-fee-burn mechanism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:solidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-patricia-trie ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:evm ],
        ngm:smart-contract-platform ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:digital-sovereignty,
        ngm:distributed-ledger-technology ;
    vc:contrastsWith ngm:avalanche,
        ngm:bitcoin,
        ngm:polkadot,
        ngm:solana ;
    vc:enables ngm:account-abstraction,
        ngm:dao,
        ngm:decentralised-application,
        ngm:decentralised-finance,
        ngm:nft,
        ngm:restaking,
        ngm:rollup ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ethereum-node,
        ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:evm,
        ngm:gas,
        ngm:mempool,
        ngm:merkle-patricia-trie,
        ngm:solidity ;
    vc:implements ngm:eip,
        ngm:eip-1559,
        ngm:eip-4844,
        ngm:erc20,
        ngm:erc721 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:requires ngm:consensus-mechanism,
        ngm:peer-to-peer-network,
        ngm:proof-of-stake,
        ngm:public-key-cryptography,
        ngm:validator-node ;
    vc:slug "ethereum" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:smart-contract,
        ngm:token-standard .

ngm:distributed-collaboration a owl:Class,
        skos:Concept ;
    rdfs:label "Distributed Collaboration"@en ;
    rdfs:comment "Distributed Collaboration is the set of technologies, protocols, and organisational practices that enable geographically or temporally dispersed individuals and teams to work together on shared tasks, artefacts, and decisions. It encompasses both synchronous modalities—real-time video conferencing, shared virtual workspaces, co-presence mechanisms—and asynchronous modalities such as version-controlled repositories, threaded discussion, and document co-authoring. The field draws on distributed systems theory, human-computer interaction, and organisational science to address challenges of latency, consistency, access control, and remote team coordination. In emerging spatial and AI-augmented contexts, distributed collaboration extends to avatar-based co-presence, AI-assisted meeting facilitation, and decentralised consensus workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shared-workspace ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        owl:Thing ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:distributed-systems,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:co-located-collaboration ;
    vc:dependsOn ngm:consensus-algorithm,
        ngm:latency-management-protocol ;
    vc:enables ngm:open-source-development,
        ngm:remote-work,
        ngm:telecollaboration,
        ngm:virtual-team ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-collaboration,
        ngm:shared-workspace,
        ngm:synchronous-collaboration ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-supported-cooperative-work,
        ngm:groupware ;
    vc:requires ngm:communication-protocol,
        ngm:identity-and-access-management,
        ngm:network-infrastructure ;
    vc:slug "distributed-collaboration" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:knowledge-management,
        ngm:project-management ;
    vc:uses ngm:conflict-free-replicated-data-type,
        ngm:end-to-end-encryption,
        ngm:operational-transformation,
        ngm:real-time-messaging,
        ngm:version-control .

ngm:gradient-descent a owl:Class ;
    rdfs:label "Gradient Descent"@en ;
    rdfs:comment "Gradient Descent is an iterative first-order optimisation algorithm that minimises a differentiable loss function by repeatedly updating model parameters in the direction of the negative gradient. It is the foundational optimisation strategy for training machine learning models, with variants including batch, stochastic, and mini-batch gradient descent, as well as adaptive-rate methods such as Adam and RMSProp."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-rate ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:distributed-training,
        ngm:federated-learning ;
    vc:contrastsWith ngm:evolutionary-algorithm,
        ngm:second-order-optimisation ;
    vc:dependsOn ngm:objective-function ;
    vc:enables ngm:convergence,
        ngm:fine-tuning,
        ngm:model-training,
        ngm:neural-network-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:batch-gradient-descent,
        ngm:stochastic-gradient-descent ;
    vc:implements ngm:first-order-optimisation,
        ngm:numerical-optimisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adam-optimiser,
        ngm:momentum,
        ngm:rmsprop,
        ngm:weight-initialisation ;
    vc:requires ngm:backpropagation,
        ngm:differentiable-function,
        ngm:learning-rate,
        ngm:loss-function ;
    vc:slug "gradient-descent" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:gradient,
        ngm:hyperparameter,
        ngm:mini-batch .

ngm:sc-standards-and-interop a owl:Class,
        skos:Concept ;
    rdfs:label "Standards and Interoperability"@en ;
    rdfs:comment "Taxonomy hub for open standards, file formats, APIs, and cross-platform interoperability specifications that enable spatial computing content, devices, and services to work together. This category spans industry consortia output such as OpenXR, OpenUSD, glTF, and WebXR, along with avatar portability and cross-platform identity standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-xr ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-xr-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-usd ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-format-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-file-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-platform-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gl-tf-3-d-file-format ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-file-format,
