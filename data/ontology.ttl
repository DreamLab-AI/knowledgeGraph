    rdfs:comment "An identity verification company that provides automated document and biometric checks for online onboarding and fraud prevention. Its services support know-your-customer and anti-money-laundering compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:identity-verification ;
    vc:enables ngm:biometric-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:identity-verification ;
    vc:slug "jumio" ;
    vc:sourceDomain "identity" .

