    vc:slug "trustless-coordination" ;
    vc:sourceDomain "blockchain" .

ngm:trustworthy-ai-systems a owl:Class ;
    rdfs:label "Trustworthy AI Systems"@en ;
    rdfs:comment "Trustworthy AI systems are artificial-intelligence systems designed and operated to be reliable, safe, transparent, fair, accountable, and respectful of privacy throughout their lifecycle. The concept, codified in frameworks such as the NIST AI Risk Management Framework and the EU's trustworthy-AI guidelines, integrates technical robustness with governance so that stakeholders can justifiably rely on the system's behaviour."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-transparency,
        ngm:safety-and-alignment ;
    vc:slug "trustworthy-ai-systems" ;
    vc:sourceDomain "ai" .

ngm:two-tier-distribution-model a owl:Class ;
    rdfs:label "Two-Tier Distribution Model"@en ;
    rdfs:comment "The two-tier distribution model is the architecture commonly proposed for central bank digital currencies in which the central bank issues the digital currency but commercial banks and licensed intermediaries handle distribution, wallets, and customer service. This preserves the central bank's monetary authority while leveraging existing financial institutions for onboarding, compliance, and the user-facing layer."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:cbdcs ;
    vc:slug "two-tier-distribution-model" ;
    vc:sourceDomain "blockchain" .

ngm:type-script a owl:Class ;
    rdfs:label "TypeScript"@en ;
    rdfs:comment "A statically typed superset of JavaScript developed by Microsoft that compiles to plain JavaScript and adds optional type annotations and compile-time checking."@en ;
