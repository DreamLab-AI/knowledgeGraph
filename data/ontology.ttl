        ngm:quantum-computing .

ngm:cosmos a owl:Class ;
    rdfs:label "Cosmos"@en ;
    rdfs:comment "Cosmos is an ecosystem of sovereign, application-specific blockchains that interoperate through the Inter-Blockchain Communication (IBC) protocol, coordinated by a central hub (the Cosmos Hub running the ATOM token) and built using the Cosmos SDK, a modular Go framework for constructing proof-of-stake chains. Each chain in the ecosystem runs Tendermint BFT consensus, providing instant deterministic finality, and can connect to any other IBC-enabled chain to transfer tokens and arbitrary data packets across trust boundaries without centralised bridges. The architecture decouples application logic from consensus, enabling developers to optimise each chain's parameters, validator set, and fee market independently while still participating in a shared interoperability fabric."@en ;
    rdfs:subClassOf ngm:blockchain-network ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cosmos-ibc,
        ngm:polkadot,
        ngm:tendermint,
        ngm:tendermint-consensus ;
    vc:slug "cosmos" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:deterministic-finality,
        ngm:proof-of-stake .

ngm:cost-function a owl:Class ;
    rdfs:label "Cost Function"@en ;
    rdfs:comment "A cost function is a scalar-valued mathematical function that quantifies the discrepancy between the current and desired states of a robotic system, or the total resource expenditure of a planned trajectory, providing the objective that control and planning algorithms minimise. In motion planning, cost functions encode factors such as path length, joint torque, collision risk, and time; in reinforcement learning they appear inverted as reward functions whose maximisation drives policy learning. The choice and design of the cost function critically shapes the behaviour of the optimised system, and poorly specified costs can lead to reward hacking or physically unrealisable trajectories."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:motion-planning,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:reward-function ;
    vc:slug "cost-function" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning .

ngm:creative-ai a owl:Class ;
    rdfs:label "Creative AI"@en ;
    rdfs:comment "Creative AI refers to artificial intelligence systems designed to generate, augment, or evaluate creative artefacts including images, music, text, video, and interactive experiences. Drawing on generative models such as diffusion models, large language models, and generative adversarial networks, these systems can produce novel content that mimics or extends human creative practice. They are increasingly deployed in professional creative pipelines, raising concurrent questions about authorship, copyright, and the economic displacement of human creators. Creative AI represents a convergence of machine learning research and aesthetic domains traditionally reserved for human agency."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:enables ngm:content-creation,
        ngm:digital-content-creation,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-art-categorization,
        ngm:creative-media-domain,
        ngm:creative-software ;
    vc:slug "creative-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:large-language-models .

ngm:creator-royalty-token a owl:Class ;
    rdfs:label "Creator Royalty Token"@en ;
    rdfs:comment "Token granting its holder a share of ongoing from creative works, enabling automated royalty distribution and fractional ownership of intellectual property income streams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ownership-record ],
        ngm:bc-token-and-asset,
        ngm:virtual-economy ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:automated-royalty-distribution,
        ngm:creator-compensation,
        ngm:fan-investment,
        ngm:ip-monetization,
        ngm:revenue-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ip-rights-metadata,
        ngm:ownership-record,
        ngm:revenue-distribution-logic,
        ngm:royalty-smart-contract ;
    vc:isPartOf ngm:creator-economy,
        ngm:intellectual-property-system,
        ngm:virtual-economy ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:digital-wallet,
        ngm:royalty-tracking-system,
        ngm:smart-contract ;
    vc:slug "creator-royalty-token" ;
    vc:sourceDomain "blockchain" .

ngm:cross-border-settlement a owl:Class ;
    rdfs:label "Cross-Border Settlement"@en ;
    rdfs:comment "Cross-border settlement is the process of finalising the transfer of funds or assets between counterparties in different jurisdictions, including currency conversion, compliance checks, and the irrevocable discharge of obligations across correspondent banking chains, central bank systems, or emerging blockchain-based rails. It encompasses the full lifecycle from trade initiation to finality across multiple legal, regulatory, and technical environments."@en ;
    rdfs:subClassOf ngm:cross-border-payments ;
    vc:dependsOn ngm:atomic-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:cbdc-cross-border-settlement,
        ngm:correspondent-banking ;
    vc:slug "cross-border-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cross-border-payment-transparency,
        ngm:fsb-cross-border-payments-roadmap .

ngm:cryptographic-algorithm a owl:Class ;
    rdfs:label "Cryptographic Algorithm"@en ;
    rdfs:comment "A Cryptographic Algorithm is a precisely defined mathematical procedure that transforms data to achieve security properties—confidentiality, integrity, authentication, or non-repudiation—based on computational hardness assumptions. The class encompasses symmetric ciphers, asymmetric (public-key) schemes, hash functions, digital signature algorithms, and zero-knowledge proof systems, each providing different security guarantees and performance characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:cryptography ;
    vc:enables ngm:digital-signature,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:requires ngm:key-management ;
    vc:slug "cryptographic-algorithm" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:zero-knowledge-proof .

ngm:custody a owl:Class ;
    rdfs:label "Custody"@en ;
    rdfs:comment "The holding and safekeeping of assets and the keys that control them, defining who has the authority to move funds on behalf of an owner."@en ;
