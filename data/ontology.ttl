ngm:universal-manifest a owl:Class ;
    rdfs:label "Universal Manifest"@en ;
    rdfs:comment "A standardized metadata document describing identifiers, permissions, relationships, and provenance of a user's digital assets and identities across platforms, enabling cross-platform portability and interoperability."@en ;
    rdfs:subClassOf ngm:spatial-computing ;
    vc:enables ngm:asset-interoperability,
        ngm:avatar-portability,
        ngm:cross-platform-identity,
        ngm:decentralized-ownership,
        ngm:permissioned-access ;
    vc:hasPart ngm:asset-registry,
        ngm:identity-credentials,
        ngm:permission-grants,
        ngm:provenance-record,
        ngm:relationship-graph ;
    vc:isPartOf ngm:asset-management-system,
        ngm:interoperability-framework ;
    vc:maturity "emerging" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-signature,
        ngm:decentralized-identifier,
        ngm:metadata-schema,
        ngm:verifiable-credential ;
    vc:slug "universal-manifest" ;
    vc:sourceDomain "spatial-computing" .

