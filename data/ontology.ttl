    vc:sourceDomain "governance" .

ngm:io-t a owl:Class ;
    rdfs:label "IoT"@en ;
    rdfs:comment "The Internet of Things (IoT) is the networked ecosystem of physical devices — from industrial sensors to consumer appliances — embedded with processors, software, and communication hardware that enables them to collect, exchange, and act upon data without direct human intervention. IoT extends digital connectivity and data processing capabilities to the physical world at scale."@en ;
    rdfs:subClassOf ngm:internet-of-things ;
    vc:enables ngm:industrial-automation,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
