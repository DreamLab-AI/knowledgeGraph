    vc:dependsOn ngm:adversary-model ;
    vc:enables ngm:cybersecurity,
        ngm:risk-mitigation,
        ngm:security-architecture,
        ngm:security-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:threat-surface-map,
        ngm:trust-boundary ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:regulatory-compliance,
        ngm:threat-surface-map ;
    vc:requires ngm:asset-inventory,
        ngm:data-flow-diagram ;
    vc:slug "threat-model" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:mitre-attck,
        ngm:nist-cybersecurity-framework ;
    vc:uses ngm:attack-vector,
        ngm:cvss,
        ngm:risk-assessment,
        ngm:vulnerability .

ngm:transaction-validation a owl:Class ;
    rdfs:label "Transaction Validation"@en ;
    rdfs:comment "Transaction validation is the process by which network participants check that a blockchain transaction conforms to the protocol rules before accepting it. It ensures only valid transactions enter the ledger by verifying signatures, input availability, and compliance with consensus rules."@en ;
