ngm:active-learning a owl:Class ;
    rdfs:label "Active Learning"@en ;
    rdfs:comment "Machine learning paradigm where algorithms actively select which unlabeled examples from large data pools to query for human annotation rather than passively accepting randomly labeled datasets, optimizing informativeness through query strategies (uncertainty sampling selecting least-confident pr..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:acquisition-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evaluation-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-strategy ],
        ngm:ai-technique,
        ngm:data-efficient-learning,
        ngm:interactive-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:cost-effective-annotation,
