        ngm:consistency-model ;
    vc:slug "replication-protocol" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:eventual-consistency,
        ngm:strong-consistency ;
    vc:uses ngm:gossip-protocol,
        ngm:quorum .

ngm:reranker a owl:Class ;
    rdfs:label "Reranker"@en ;
    rdfs:comment "A reranker is a second-stage scoring model in information retrieval and retrieval-augmented generation pipelines that reorders a set of candidate documents or passages — initially retrieved by a fast first-stage retriever such as a dense vector index — using a more computationally intensive cross-encoder or LLM-based relevance model that jointly encodes the query and each candidate together, producing a higher-precision relevance score than bi-encoder similarity alone. Rerankers trade retrieval speed for ranking quality, operating on a reduced candidate set (typically 50-200 passages) rather than the full corpus, thereby making deep transformer inference tractable at query time."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:language-model,
        ngm:machine-learning-discipline-technique ;
    vc:slug "reranker" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding-model,
        ngm:large-language-models,
        ngm:natural-language-processing .

ngm:reserve-requirements a owl:Class ;
    rdfs:label "Reserve Requirements"@en ;
    rdfs:comment "Reserve requirements are central-bank rules obliging commercial banks to hold a minimum fraction of their deposit liabilities as reserves, either as vault cash or as balances at the central bank. By constraining the proportion of deposits banks may lend, they influence credit creation, money supply and bank liquidity. They are a classic monetary-policy instrument, though many modern central banks now rely more on interest-rate tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fractional-reserve-banking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:banking-regulation ],
        ngm:monetary-policy ;
    vc:bridgesTo ngm:basel-iii ;
    vc:contrastsWith ngm:interest-rate-policy,
        ngm:open-market-operations ;
    vc:dependsOn ngm:central-banking ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fractional-reserve-banking ;
    vc:implements ngm:monetary-policy ;
    vc:isPartOf ngm:monetary-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fractional-reserve-banking,
        ngm:liquidity,
        ngm:quantitative-easing ;
    vc:requires ngm:banking-regulation ;
    vc:slug "reserve-requirements" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:financial-stability,
        ngm:liquidity ;
    vc:uses ngm:central-banking .

ngm:reverse-logistics a owl:Class ;
    rdfs:label "Reverse Logistics"@en ;
    rdfs:comment "Reverse logistics encompasses all operations related to the reuse, processing, and management of products and materials flowing backward through the supply chain from the consumer or end-of-life point toward the manufacturer or recycler. It includes product returns, refurbishment, remanufacturing, recycling, and responsible disposal, and is a key operational component of circular economy strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:warehouse-management-system ],
        ngm:logistics ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:logistics ;
    vc:dependsOn ngm:logistics-management,
