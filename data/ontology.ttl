ngm:l-402-protocol a owl:Class ;
    rdfs:label "L402 Protocol"@en ;
    rdfs:comment "L402 Protocol is a web-native payment authentication specification that combines HTTP 402 status responses, [[Lightning Network]] BOLT11 invoices, and cryptographic macaroon tokens to enable pay-per-request access control for APIs and web resources. A server responding with 402 embeds a Lightning invoice and a partially-constructed macaroon; the client pays the invoice, receives the payment preimage, and embeds that preimage as a macaroon caveat to form a valid bearer credential. The protocol enables metered, machine-to-machine micropayments without requiring user accounts, subscriptions, or traditional payment rails, making it well-suited to AI agent infrastructure, streaming data services, and censorship-resistant content monetisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        ngm:l-402 ;
    vc:bridgesTo ngm:ai-agent,
        ngm:autonomous-agent,
        ngm:web-of-trust ;
    vc:contrastsWith ngm:api-key-authentication,
        ngm:oauth ;
    vc:dependsOn ngm:bitcoin,
        ngm:cryptographic-hash-function ;
    vc:enables ngm:api,
        ngm:machine-to-machine-payments,
        ngm:micropayment,
        ngm:pay-per-request ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:http,
        ngm:payment-channel ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:web-monetisation ;
    vc:requires ngm:lightning-network,
        ngm:payment-preimage ;
    vc:slug "l-402-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:access-control,
        ngm:api-monetisation,
        ngm:content-monetisation ;
    vc:uses ngm:bearer-token,
        ngm:hash-time-locked-contract,
        ngm:http .

