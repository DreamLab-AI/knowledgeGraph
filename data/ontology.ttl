ngm:tron-blockchain a owl:Class ;
    rdfs:comment "Tron is a public, high-throughput layer-1 blockchain launched in 2018 that uses a delegated proof-of-stake consensus mechanism to achieve low transaction fees and fast block times, positioning itself as an alternative settlement layer for content and payments. It has become one of the largest hosts of USD-pegged stablecoin transfers, particularly Tether (USDT), owing to its low fees relative to Ethereum. Its EVM-compatible virtual machine allows Ethereum smart contracts to be ported to the network with minimal modification."@en ;
    rdfs:label "Tron Blockchain"@en ;
    rdfs:subClassOf ngm:layer-1-blockchain ;
