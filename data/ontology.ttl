            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:decentralized-exchange,
        ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constant-product-formula,
        ngm:liquidity ;
    vc:isPartOf ngm:automated-market-maker,
        ngm:token-economy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:price-oracle,
        ngm:reserve-asset,
        ngm:smart-contract ;
    vc:slug "token-bonding-curve" ;
    vc:sourceDomain "spatial-computing" .

ngm:token-generation a owl:Class ;
    rdfs:label "Token Generation"@en ;
    rdfs:comment "Token generation is the autoregressive process by which a language model produces output tokens one at a time, sampling from a probability distribution over the vocabulary conditioned on the input context and all previously generated tokens. Each forward pass through the model produces logits over the vocabulary; a sampling strategy — greedy decoding, temperature sampling, top-k, or nucleus sampling — selects the next token, which is appended to the context for the subsequent step. Token generation is the primary inference workload of large language models and determines output quality, latency, and throughput."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:contrastsWith ngm:encoder-model ;
    vc:dependsOn ngm:gpu-acceleration,
        ngm:tokenisation,
        ngm:transformer ;
    vc:enables ngm:ai-agent,
        ngm:conversational-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoding-algorithm,
        ngm:logit-computation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dynamic-batching,
        ngm:inference-engine,
        ngm:speculative-decoding ;
    vc:slug "token-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:code-generation,
        ngm:large-language-model,
        ngm:text-generation ;
    vc:uses ngm:autoregressive-model,
        ngm:kv-cache,
        ngm:sampling-strategy .

ngm:token-metadata a owl:Class ;
    rdfs:label "Token Metadata"@en ;
    rdfs:comment "Token metadata is the structured descriptive data associated with a blockchain token, typically including attributes such as name, description, image references, traits, and provenance. For non-fungible tokens it is commonly stored as a JSON document referenced by a tokenURI and often hosted on decentralised storage such as IPFS to preserve immutability and addressability."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nft-minting,
        ngm:non-fungible-token-nft ;
    vc:slug "token-metadata" ;
    vc:sourceDomain "blockchain" .

ngm:tokenizer a owl:Class ;
    rdfs:label "Tokenizer"@en ;
    rdfs:comment "A tokenizer is the component that converts raw text into the discrete units (tokens) a language model processes, and back again. Modern tokenizers use subword algorithms such as byte-pair encoding, WordPiece, or unigram language models to balance vocabulary size against sequence length, representing common words as single tokens and rare words as compositions of smaller pieces. The tokenizer defines the model's vocabulary and directly affects context-window usage, multilingual fairness, handling of code and numbers, and ultimately the cost and capability of the system."@en ;
    rdfs:subClassOf ngm:tokenization ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:slug "tokenizer" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:transformer .

ngm:traffic-management a owl:Class ;
    rdfs:label "Traffic Management"@en ;
    rdfs:comment "Traffic management is the set of techniques for controlling the flow of data across a network to optimise performance, fairness, and reliability. It encompasses traffic shaping, rate limiting, prioritisation, congestion control, and load distribution, applied at routers, gateways, and application proxies. By regulating how bandwidth is allocated and how bursts are smoothed, traffic management upholds quality-of-service guarantees, protects services from overload, and improves overall utilisation of finite network capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rate-limiting ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:dependsOn ngm:monitoring ;
    vc:enables ngm:graceful-degradation,
        ngm:quality-of-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rate-limiting,
        ngm:traffic-shaping ;
    vc:isPartOf ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-protocol,
        ngm:smart-city,
        ngm:throughput ;
    vc:slug "traffic-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:high-availability,
        ngm:load-balancer,
        ngm:service-level-agreement ;
    vc:uses ngm:bandwidth-adaptation,
        ngm:congestion-control .

ngm:transaction-throughput a owl:Class ;
    rdfs:label "Transaction Throughput"@en ;
    rdfs:comment "Transaction throughput is the rate at which a system processes and finalises transactions, commonly expressed as transactions per second, and is a primary measure of a blockchain network's capacity and scalability. It is shaped by block size, block interval, consensus mechanism, and execution efficiency, and it trades off against decentralisation and security in protocol design. Improving throughput is a central goal of layer-2 solutions and sharding."@en ;
    rdfs:subClassOf ngm:scalability ;
    vc:contrastsWith ngm:latency ;
    vc:dependsOn ngm:block-size,
        ngm:consensus-mechanism ;
    vc:enables ngm:blockchain-transaction,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:performance,
        ngm:scalability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:sidechain,
        ngm:state-channel,
        ngm:transaction-finality ;
    vc:slug "transaction-throughput" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:optimistic-rollup,
        ngm:sharding,
        ngm:zk-rollup .

ngm:transfer-function a owl:Class ;
    rdfs:label "Transfer Function"@en ;
    rdfs:comment "A transfer function is the Laplace-domain (continuous-time) or Z-domain (discrete-time) ratio of output to input for a linear time-invariant (LTI) system with zero initial conditions, expressed as a ratio of polynomials whose roots yield the poles and zeros that determine the system's frequency response, stability, and transient behaviour. Transfer functions provide a frequency-domain characterisation of systems ranging from electronic filters and mechanical actuators to feedback control loops."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:contrastsWith ngm:state-estimation ;
    vc:enables ngm:feedback-control,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bode-plot,
        ngm:control-system,
        ngm:kalman-filter ;
    vc:slug "transfer-function" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-signal-processing,
        ngm:signal-processing .

ngm:trapdoor-function a owl:Class ;
    rdfs:label "Trapdoor Function"@en ;
    rdfs:comment "A trapdoor function is a one-way function that is easy to compute in the forward direction but computationally infeasible to invert, except for a party holding a secret piece of information called the trapdoor. This asymmetry between forward computation and inversion underpins public-key cryptography, where the public key enables encryption or verification and the private trapdoor enables decryption or signing. Candidate trapdoor functions rest on conjectured hard problems such as integer factorisation and the discrete logarithm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptographic-primitive ;
    vc:contrastsWith ngm:hash-function ;
    vc:enables ngm:digital-signature,
        ngm:encryption,
        ngm:rsa ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:asymmetric-encryption,
        ngm:public-key-cryptography ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptography,
        ngm:key-generation ;
    vc:slug "trapdoor-function" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:key-exchange ;
    vc:uses ngm:cryptographic-primitive .

ngm:true-negative a owl:Class ;
    rdfs:label "True Negative"@en ;
    rdfs:comment "A true negative is an outcome in binary classification where the model correctly predicts the negative class for an instance that is genuinely negative. It is one of the four cells of the confusion matrix and contributes to metrics such as specificity and accuracy. Counting true negatives is essential for evaluating how well a classifier avoids false alarms on negative cases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classification ],
        ngm:confusion-matrix ;
    vc:bridgesTo ngm:statistical-inference ;
    vc:contrastsWith ngm:false-positive,
        ngm:true-positive ;
    vc:enables ngm:specificity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:classification ;
    vc:isPartOf ngm:confusion-matrix ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:precision,
        ngm:recall,
        ngm:sensitivity,
        ngm:threshold-selection ;
    vc:slug "true-negative" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:supervised-learning ;
    vc:uses ngm:evaluation-metric,
        ngm:model-evaluation .

ngm:trust-over-ip-stack a owl:Class ;
    rdfs:label "Trust over IP Stack"@en ;
    rdfs:comment "The Trust over IP (ToIP) Stack is a four-layer architecture developed by the Trust Over IP Foundation that provides a complete framework for decentralised digital trust, combining technical protocols (verifiable credentials, DID-based peer-to-peer messaging, verifiable data registries) with governance frameworks at each layer to enable interoperable, privacy-preserving identity and credential exchange across organisational and jurisdictional boundaries. The stack mirrors the TCP/IP model by separating technical interoperability concerns from governance and policy concerns at corresponding layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:w3-c-verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        ngm:trust-framework ;
    vc:enables ngm:credential-verification,
        ngm:decentralised-trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralized-identifiers,
        ngm:verifiable-data-registry,
        ngm:w3-c-verifiable-credentials ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity-framework,
        ngm:trust-over-ip-foundation ;
    vc:slug "trust-over-ip-stack" ;
    vc:sourceDomain "governance" .

ngm:turing-machine a owl:Class ;
    rdfs:label "Turing Machine"@en ;
    rdfs:comment "A Turing machine is an abstract model of computation consisting of an infinite tape, a read-write head, a finite set of states and a transition function that, given the current state and the symbol under the head, prescribes a symbol to write, a direction to move and a next state. Introduced by Alan Turing, it formalises the notion of an effective procedure and serves as the canonical definition of what is computable. The Church-Turing thesis holds that any function computable by any reasonable mechanism is computable by a Turing machine."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finite-state-machine ],
        ngm:automata-theory ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:finite-state-machine ;
    vc:dependsOn ngm:automata-theory ;
    vc:enables ngm:algorithm ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:finite-state-machine ;
    vc:implements ngm:algorithm ;
    vc:isPartOf ngm:automata-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:finite-state-machine,
        ngm:state-machine ;
    vc:requires ngm:algorithm ;
    vc:slug "turing-machine" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:automata-theory ;
    vc:supports ngm:algorithm ;
    vc:uses ngm:finite-state-machine .

ngm:type-script a owl:Class ;
    rdfs:label "TypeScript"@en ;
    rdfs:comment "TypeScript is a statically typed superset of JavaScript developed and maintained by Microsoft that adds optional type annotations, interfaces, generics, and compile-time type checking to the JavaScript language. Source code is transpiled by the TypeScript compiler (tsc) to plain JavaScript, making it compatible with any JavaScript runtime or browser without requiring runtime changes. The type system enables large-scale application development by surfacing errors at development time, improving editor tooling such as intelligent autocompletion, safe refactoring, and inline documentation. TypeScript has become the dominant choice for enterprise front-end and Node.js back-end development, underpinning major frameworks such as Angular, NestJS, and Deno."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:type-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:java-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node-js ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interface ],
        ngm:programming-language ;
    vc:bridgesTo ngm:api-design,
        ngm:large-language-model ;
    vc:contrastsWith ngm:java-script ;
    vc:dependsOn ngm:ecmascript,
        ngm:npm ;
    vc:enables ngm:refactoring,
        ngm:software-engineering,
        ngm:static-analysis,
        ngm:web-application ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:interface,
        ngm:type-system ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:requires ngm:java-script,
        ngm:node-js ;
    vc:slug "type-script" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ecma-international,
        ngm:microsoft ;
    vc:supports ngm:re-act ;
    vc:uses ngm:language-server-protocol .

ngm:ultra-wideband a owl:Class ;
    rdfs:label "Ultra Wideband"@en ;
    rdfs:comment "Ultra Wideband (UWB) is a short-range radio technology that transmits data using pulses spread across a very wide frequency spectrum (typically 3.1–10.6 GHz, bandwidth exceeding 500 MHz), enabling precise time-of-flight ranging and centimetre-accurate indoor positioning. Unlike narrowband technologies, UWB's broad spectrum allocation provides high resistance to multipath interference and coexistence with other radio systems. It is standardised under IEEE 802.15.4z and used in applications from secure device pairing to spatial-computing anchor systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:euclidean-distance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fourier-transform ],
        ngm:wireless-communication ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:wireless-communication ;
    vc:dependsOn ngm:data-management ;
    vc:enables ngm:access-control,
        ngm:security ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:euclidean-distance,
        ngm:fourier-transform ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:signal-processing ;
    vc:requires ngm:encryption ;
    vc:slug "ultra-wideband" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:distributed-collaboration ;
    vc:uses ngm:numerical-methods,
        ngm:statistical-analysis .

ngm:unique-identifier a owl:Class ;
    rdfs:label "Unique Identifier"@en ;
    rdfs:comment "A unique identifier is a value assigned to an object, entity, or record so that it can be distinguished unambiguously from all others within a defined scope. Identifiers may be globally unique, such as universally unique identifiers, or unique within a namespace, such as a serial number combined with an issuer prefix. In supply chains, unique identifiers underpin serialisation, traceability, and data exchange across organisations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:namespace ],
        ngm:identification ;
    vc:enables ngm:supply-chain-provenance,
        ngm:traceability,
        ngm:tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:serialisation ;
    vc:implements ngm:identification ;
    vc:isPartOf ngm:data-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-model,
        ngm:serialisation ;
    vc:requires ngm:identification,
        ngm:namespace ;
    vc:slug "unique-identifier" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:gs1 ;
    vc:supports ngm:traceability ;
    vc:uses ngm:barcode,
        ngm:rfid .

ngm:unlinkability a owl:Class ;
    rdfs:label "Unlinkability"@en ;
    rdfs:comment "Unlinkability is a privacy property that prevents an adversary from determining whether two or more items of interest, such as messages, transactions or sessions, are related to the same entity. It is a core goal of privacy-enhancing technologies and is achieved through techniques such as pseudonym rotation, mixing, blinding and zero-knowledge constructions. Unlinkability protects against profiling and correlation while still permitting legitimate use of a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pseudonymity ],
        ngm:privacy-enhancing-technologies ;
    vc:bridgesTo ngm:tor ;
    vc:contrastsWith ngm:surveillance ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:data-protection,
        ngm:privacy,
        ngm:pseudonymity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-protection,
        ngm:privacy ;
    vc:isPartOf ngm:privacy,
        ngm:privacy-enhancing-technologies ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:differential-privacy,
        ngm:privacy-enhancing-technologies,
        ngm:pseudonymity ;
    vc:requires ngm:cryptography,
        ngm:pseudonymity ;
    vc:slug "unlinkability" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:differential-privacy,
        ngm:identity-management ;
    vc:uses ngm:cryptography,
        ngm:onion-routing,
        ngm:zero-knowledge-proof .

ngm:urdf a owl:Class ;
    rdfs:label "URDF"@en ;
    rdfs:comment "Unified Robot Description Format (URDF) is an XML-based schema used within the Robot Operating System (ROS) ecosystem to fully specify a robot's physical structure, including its kinematic chain of links and joints, collision geometries, inertial properties, and sensor placements. URDF files serve as the authoritative model consumed by simulation environments such as Gazebo, motion planners, and visualisation tools like RViz, enabling consistent robot representation across software components. Each joint element declares its type (fixed, revolute, prismatic, continuous) along with axis, limits, and damping parameters, while link elements reference mesh geometry and material definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:gazebo-simulator,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint,
        ngm:robot-link ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "urdf" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-kinematics,
        ngm:robot-operating-system .

ngm:uri-canonicaliser a owl:Class ;
    rdfs:label "URI Canonicaliser"@en ;
    rdfs:comment "The canonical URI minting and resolution engine implementing the VisionClaw Agentic Container|VisionClaw urn:visionclaw: grammar (ADR-013, R1–R3 rules) for stable, content-addressed, and scope-bearing identifiers, enabling deterministic roundtrip serialisation and cryptographic verification o..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-340 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressing ],
        ngm:identity-systems,
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:content-addressing,
        ngm:deterministic-serialisation,
        ngm:tamper-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-addressing,
        ngm:cryptographic-hash-function ;
    vc:implements ngm:w3-c-did-core ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:requires ngm:bip-340,
        ngm:json-data-interchange-format-serialisation,
        ngm:sha-256 ;
    vc:slug "uri-canonicaliser" ;
    vc:sourceDomain "infrastructure" .

ngm:user-interface-design a owl:Class ;
    rdfs:label "User Interface Design"@en ;
    rdfs:comment "User interface design is the discipline of shaping the visual and interactive surfaces through which people operate digital products, determining layout, controls, typography, colour and feedback. It translates user goals and information structure into coherent, learnable and aesthetically consistent screens and interactions. As a sibling of interaction design and a contributor to overall user experience, it balances usability, accessibility and brand expression."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interaction-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:visual-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:design-systems ],
        ngm:interface-design ;
    vc:bridgesTo ngm:human-centred-design ;
    vc:contrastsWith ngm:graphical-user-interface ;
    vc:enables ngm:accessibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:design-systems,
        ngm:visual-design ;
    vc:implements ngm:user-experience-design ;
    vc:isPartOf ngm:user-experience-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:user-interface ;
    vc:requires ngm:interaction-design ;
    vc:slug "user-interface-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:usability,
        ngm:user-experience ;
    vc:uses ngm:information-architecture,
        ngm:prototyping .

ngm:validation-rules a owl:Class ;
    rdfs:label "Validation Rules"@en ;
    rdfs:comment "Defined constraints that data or input must satisfy to be accepted, used to enforce correctness, consistency and integrity before processing or storage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint ],
        ngm:data-management ;
    vc:enables ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:constraint ;
    vc:slug "validation-rules" ;
    vc:sourceDomain "data" .

ngm:value a owl:Class ;
    rdfs:label "Value"@en ;
    rdfs:comment "In the AI domain, a principle, preference, or objective that guides the behaviour and optimisation targets of an intelligent system. Values encode what outcomes a system should pursue or avoid, underpinning alignment research, reward function design, and ethical AI. They range from measurable utility metrics to abstract normative principles such as fairness, human dignity, and autonomy."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-fairness,
        ngm:ai-governance,
        ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-ethics,
        ngm:democratic-values,
        ngm:human-centred-values,
        ngm:value-alignment ;
    vc:slug "value" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-preference,
        ngm:preference-learning,
        ngm:reward-function .

ngm:vertex-buffer a owl:Class ;
    rdfs:label "Vertex Buffer"@en ;
    rdfs:comment "A vertex buffer is a region of GPU-accessible memory that stores the attributes of a mesh's vertices, such as positions, normals, texture coordinates and colours, in a contiguous layout for the graphics pipeline to consume. By uploading geometry once and referencing it across many draw calls, vertex buffers minimise CPU-to-GPU transfer and enable high-throughput rendering. They are bound to the input-assembler stage and described by a vertex layout that maps buffer bytes to shader inputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:rendering-pipeline ;
    vc:bridgesTo ngm:computer-graphics ;
    vc:enables ngm:vertex-shader ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:rendering-pipeline ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:shader ;
    vc:requires ngm:gpu,
        ngm:rendering-pipeline ;
    vc:slug "vertex-buffer" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:rasterization,
        ngm:vertex-shader ;
    vc:uses ngm:gpu,
        ngm:rasterization .

ngm:virtual-assistant a owl:Class ;
    rdfs:label "Virtual Assistant"@en ;
    rdfs:comment "A virtual assistant is a software agent that interprets natural-language requests and performs tasks or retrieves information on behalf of a user through conversational interaction. It combines speech recognition or text understanding, intent recognition, dialogue management and task execution to mediate between the user and underlying services, devices or knowledge sources. Virtual assistants range from voice-driven smart-speaker agents to text-based assistants embedded in applications, increasingly powered by large language models for open-ended reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dialogue-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-recognition ],
        ngm:conversational-ai ;
    vc:enables ngm:human-computer-interaction,
        ngm:task-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:voice-user-interface ;
    vc:isPartOf ngm:conversational-ai ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agent,
        ngm:chatbot ;
    vc:requires ngm:dialogue-system,
        ngm:intent-recognition,
        ngm:natural-language-understanding ;
    vc:slug "virtual-assistant" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:automation ;
    vc:uses ngm:large-language-model,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:speech-synthesis .

ngm:virtual-presence a owl:Class ;
    rdfs:label "Virtual Presence"@en ;
    rdfs:comment "The psychological experience of being there within a virtual place or situation, encompassing spatial presence (sense of location), social presence (connection with others), and self-presence (embodiment in virtual form), achieved through telepresence technologies and immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:telepresence ;
    vc:enables ngm:immersive-experience,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:extended-reality ;
    vc:requires ngm:avatar,
        ngm:virtual-reality ;
    vc:slug "virtual-presence" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptic-feedback,
        ngm:spatial-audio .

ngm:virtual-society a owl:Class ;
    rdfs:label "Virtual Society"@en ;
    rdfs:comment "An organised social structure emerging within virtual worlds and metaverse platforms, comprising the norms, governance mechanisms, economic systems, communities, and social interactions of persistent digital environments. Virtual societies exhibit properties analogous to physical societies — ownership, law, culture, and commerce — mediated through digital platforms, avatars, and blockchain-based economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-commerce ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:avatar,
        ngm:community-governance,
        ngm:virtual-economy,
        ngm:virtual-world ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-metaverse-commerce,
        ngm:decentralized-governance,
        ngm:virtual-world-platform ;
    vc:slug "virtual-society" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:community-standards,
        ngm:virtual-currency,
        ngm:virtual-environment .

ngm:virtual-world-platform a owl:Class ;
    rdfs:label "Virtual World Platform"@en ;
    rdfs:comment "A software ecosystem that enables users to create, explore, and interact within persistent 3D virtual environments. It encompasses both centralised platforms — such as Roblox (214 million monthly active users) and Fortnite — controlled by platform operators, and blockchain-based decentralised platforms — such as Decentraland and The Sandbox — where users hold genuine ownership of digital assets and participate in on-chain governance. The metaverse market hosting these platforms is valued at USD 103.6 billion and projected to reach USD 507.8 billion by 2030."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world-building ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        ngm:digital-platform,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:social-vr,
        ngm:virtual-asset-trading,
        ngm:virtual-event ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:virtual-economy,
        ngm:virtual-world-building ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-platform,
        ngm:virtual-world-infrastructure ;
    vc:slug "virtual-world-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:vr-rendering-engine .

ngm:visual-design a owl:Class ;
    rdfs:label "Visual Design"@en ;
    rdfs:comment "Visual design is the practice of shaping the appearance of interfaces and artefacts through the deliberate arrangement of typography, colour, imagery, space and composition to communicate meaning and guide attention. It establishes visual hierarchy, consistency and aesthetic quality so that products are both legible and emotionally resonant. As a core part of user experience and interaction design, visual design translates structure and intent into perceivable form, increasingly across spatial and immersive media."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interaction-design ],
        ngm:user-experience ;
    vc:bridgesTo ngm:interaction-design,
        ngm:spatial-computing ;
    vc:enables ngm:usability,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:information-architecture,
        ngm:user-interface ;
    vc:isPartOf ngm:user-experience ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:interaction-design ;
    vc:requires ngm:information-architecture,
        ngm:interaction-design ;
    vc:slug "visual-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:user-experience ;
    vc:uses ngm:information-architecture,
        ngm:user-interface .

ngm:voice-activity-detection a owl:Class ;
    rdfs:label "Voice Activity Detection"@en ;
    rdfs:comment "The automated process of classifying audio frames as containing human speech or non-speech (silence, background noise, music) in order to segment an audio stream before downstream processing. Voice activity detection (VAD) reduces computational load on speech-sensitive systems by forwarding only speech-active segments to recognition, enhancement, or analysis modules. Modern VAD systems use neural classifiers trained on diverse acoustic conditions to achieve robust detection under noise, reverberation, and overlapping sounds. It is a foundational pre-processing stage in speech pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-suppression ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:speaker-recognition,
        ngm:speech-recognition ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:speaker-diarisation,
        ngm:speaker-recognition,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-frame-classification,
        ngm:noise-suppression ;
    vc:isPartOf ngm:speech-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:noise-robustness,
        ngm:telephony,
        ngm:voice-assistant ;
    vc:requires ngm:audio-processing,
        ngm:feature-extraction ;
    vc:slug "voice-activity-detection" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:efficiency,
        ngm:privacy ;
    vc:uses ngm:neural-network,
        ngm:signal-processing .

ngm:vote-escrow-model a owl:Class ;
    rdfs:label "Vote-Escrow Model"@en ;
    rdfs:comment "The vote-escrow model is a DeFi tokenomics mechanism in which holders of a governance token lock their tokens for a chosen duration — typically up to four years — in exchange for a non-transferable vote-escrow token (such as veCRV in Curve Finance) that grants proportional governance voting power and fee-sharing rights, with voting weight decaying linearly as the lock approaches expiry, aligning token holder incentives with long-term protocol health by penalising short-term speculation. The model was pioneered by Curve Finance and subsequently adopted across dozens of DeFi protocols, spawning meta-governance layers such as Convex Finance that aggregate and direct veToken voting power."@en ;
    rdfs:subClassOf ngm:tokenomics ;
    vc:enables ngm:liquidity-mining,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:convex-finance,
        ngm:token-economics,
        ngm:tokenomics-governance ;
    vc:slug "vote-escrow-model" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:governance-token,
        ngm:on-chain-governance .

ngm:w-3-c-verifiable-credentials-data-model a owl:Class ;
    rdfs:label "W3C Verifiable Credentials Data Model"@en ;
    rdfs:comment "The W3C Verifiable Credentials Data Model (VCDM) is a W3C Recommendation that defines a standardised, machine-readable data model for expressing and cryptographically verifying claims about subjects on the Web. It establishes a three-party trust triangle comprising an issuer that creates and signs credentials, a holder that stores and presents them, and a verifier that checks their authenticity and validity. Credentials are expressed as JSON or JSON-LD documents and may be signed using proof mechanisms such as Data Integrity Proofs or JWT/SD-JWT, enabling selective disclosure and privacy-preserving presentation. The model underpins decentralised identity systems and Self-Sovereign Identity architectures by separating identity assertion from centralised identity providers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-ld ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-identity-wallet ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:saml ;
    vc:enables ngm:digital-identity-wallet,
        ngm:privacy-preserving-authentication,
        ngm:selective-disclosure,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-status,
        ngm:credential-subject,
        ngm:verifiable-presentation ;
    vc:implements ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitstring-status-list,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:trust-registry ;
    vc:requires ngm:cryptographic-proof,
        ngm:decentralised-identifiers,
        ngm:json-data-interchange-format-ld ;
    vc:slug "w-3-c-verifiable-credentials-data-model" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:digital-signature,
        ngm:json-data-interchange-format-web-token,
        ngm:linked-data-proofs .

ngm:watchtower a owl:Class ;
    rdfs:label "Watchtower"@en ;
    rdfs:comment "A watchtower is a third-party service in payment-channel networks such as the Lightning Network that monitors the blockchain on a client's behalf and reacts to fraudulent channel-closure attempts. When a counterparty broadcasts a revoked, outdated channel state, the watchtower submits a penalty (justice) transaction that claims the cheater's funds, allowing the honest party to remain offline safely. Watchtowers store encrypted justice transactions indexed by transaction hints so they learn nothing about channel contents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:lightning-network ;
    vc:contrastsWith ngm:centralised-finance ;
    vc:dependsOn ngm:blockchain,
        ngm:nonce ;
    vc:enables ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hash-function ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "watchtower" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:lightning,
        ngm:payment-channel ;
    vc:uses ngm:encryption,
        ngm:lnd .

ngm:wearable-computing-platform a owl:Class ;
    rdfs:label "Wearable Computing Platform"@en ;
    rdfs:comment "Hardware and software ecosystems for body-worn computing devices including smartwatches, smart glasses, fitness trackers, and XR headsets, providing operating systems, development frameworks, and connectivity infrastructure for continuous personal computing and metaverse interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:xr-headset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wearable-device-integration ],
        ngm:computing-platform,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:wearable-device-integration,
        ngm:xr-headset ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "wearable-computing-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:sensor-fusion .

ngm:web-application-firewall a owl:Class ;
    rdfs:label "Web Application Firewall"@en ;
    rdfs:comment "A web application firewall is a security control that inspects and filters HTTP and HTTPS traffic between clients and a web application to detect and block application-layer attacks. Operating at layer seven, it applies signature, rule and behavioural policies to mitigate threats such as injection, cross-site scripting and automated abuse that traditional network firewalls cannot see. It is commonly deployed as a reverse proxy, an inline appliance or a cloud service in front of the protected application."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reverse-proxy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reverse-proxy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        ngm:network-security ;
    vc:bridgesTo ngm:api-gateway,
        ngm:content-delivery-network ;
    vc:contrastsWith ngm:firewall ;
    vc:enables ngm:network-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:access-control,
        ngm:reverse-proxy ;
    vc:isPartOf ngm:cybersecurity,
        ngm:network-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:firewall,
        ngm:intrusion-detection-system,
        ngm:load-balancer ;
    vc:requires ngm:http,
        ngm:reverse-proxy ;
    vc:slug "web-application-firewall" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cybersecurity,
        ngm:intrusion-detection-system ;
    vc:uses ngm:access-control,
        ngm:http .

ngm:web-id-profile a owl:Class ;
    rdfs:label "WebID Profile"@en ;
    rdfs:comment "A WebID Profile is an RDF document accessible at a dereferenceable HTTP URI that describes a person or agent, linking their identity to cryptographic keys, social contacts, and access control preferences, thereby enabling decentralised authentication and authorisation on the web without a centralised identity provider. The profile uses vocabularies such as FOAF and vCard to express identity attributes, and the WebID-TLS and WebID-OIDC protocols use it to authenticate agents by verifying control of the URI through certificate or token proofs. WebID Profiles are a foundational component of the Solid decentralised web platform, where they serve as the entry point for discovering a user's data pods and access control rules. They embody the self-sovereign principle that identity should be controlled by the individual rather than delegated to a platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solid ],
        ngm:digital-identity ;
    vc:enables ngm:decentralized-identity-did,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:personal-data-store,
        ngm:solid-pod,
        ngm:verifiable-credentials,
        ngm:w3-c-did-core ;
    vc:requires ngm:rdf,
        ngm:solid ;
    vc:slug "web-id-profile" ;
    vc:sourceDomain "infrastructure" .

ngm:web-scraping a owl:Class ;
    rdfs:label "Web Scraping"@en ;
    rdfs:comment "Web scraping is the automated extraction of structured data from websites by programmatically fetching HTML documents and parsing their content to capture specific fields, tables, or text. It encompasses tools ranging from simple HTTP request libraries to headless browser automation frameworks capable of executing JavaScript and interacting with dynamic single-page applications. Web scraping is widely used to construct training datasets for machine learning models, to aggregate pricing and market intelligence, and to archive public information. Its practice intersects with legal questions around terms of service compliance, copyright, and personal data protection under GDPR and equivalent regulations."@en ;
    rdfs:subClassOf ngm:data-pipeline ;
    vc:enables ngm:machine-learning-discipline-pipeline,
        ngm:training-dataset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-scrapers,
        ngm:browser-automation,
        ngm:data-processing,
        ngm:training-data ;
    vc:slug "web-scraping" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-use-and-browser-agents,
        ngm:etl-pipeline .

ngm:weight-decay a owl:Class ;
    rdfs:label "Weight Decay"@en ;
    rdfs:comment "A regularisation technique that adds a penalty proportional to the L2 norm of model weights to the loss function, discouraging large weight magnitudes and thereby limiting model complexity. Weight decay prevents overfitting, promotes simpler generalisable solutions, and in optimisers such as AdamW is implemented directly in the weight update step rather than via loss augmentation."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning-discipline-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:dropout ;
    vc:enables ngm:regularisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:training ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "weight-decay" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:optimiser .

ngm:witness-data a owl:Class ;
    rdfs:label "Witness Data"@en ;
    rdfs:comment "Witness data is the portion of a Bitcoin transaction that contains the signatures and scripts proving authorisation to spend inputs, separated from the core transaction body by Segregated Witness. Moving this data into a distinct structure fixes transaction malleability and allows witness bytes to be discounted when computing block weight. Witness data is also the field where inscriptions such as Ordinals embed arbitrary content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:script ],
        ngm:transaction ;
    vc:bridgesTo ngm:ordinals ;
    vc:contrastsWith ngm:block-size ;
    vc:enables ngm:ordinals,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-signature,
        ngm:script ;
    vc:isPartOf ngm:blockchain,
        ngm:transaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:ordinals,
        ngm:taproot ;
    vc:requires ngm:transaction ;
    vc:slug "witness-data" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:block-size ;
    vc:uses ngm:merkle-tree .

ngm:world-building a owl:Class ;
    rdfs:label "World Building"@en ;
    rdfs:comment "The creative and technical process of designing, constructing, and populating coherent virtual environments — including geography, architecture, atmosphere, lore, and rules — for use in games, virtual reality, film, and metaverse platforms. World building integrates procedural generation, 3D modelling, level design, environmental storytelling, and real-time rendering to produce navigable, persistent virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:design-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse,
        ngm:virtual-production-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:metaverse-architecture ;
    vc:requires ngm:3-d-modeling,
        ngm:design-software ;
    vc:slug "world-building" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-content-generation,
        ngm:game-engine .

ngm:zk-sync a owl:Class ;
    rdfs:label "zkSync"@en ;
    rdfs:comment "zkSync is an Ethereum layer-2 scaling network developed by Matter Labs that uses zero-knowledge rollup technology to settle transactions on Ethereum with validity proofs. Its main network, zkSync Era, is a zk-rollup with an EVM-compatible execution environment, allowing many Ethereum smart contracts and tools to be used with minimal changes. By posting succinct proofs that each batch of transactions is valid, the network achieves Ethereum-level settlement security without an optimistic challenge period. zkSync is part of a broader effort to scale Ethereum through zero-knowledge cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
