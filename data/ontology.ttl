        ngm:synthetic-data,
        ngm:training-and-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:physics-engine,
        ngm:sensor-model,
        ngm:state-machine ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:requires ngm:computational-model,
        ngm:high-performance-computing,
        ngm:real-time-computing ;
    vc:slug "simulation" ;
    vc:sourceDomain "spatial-computing" ;
