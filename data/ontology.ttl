    vc:requires ngm:encryption ;
    vc:slug "api-key-authentication" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:authorization ;
    vc:uses ngm:token .

