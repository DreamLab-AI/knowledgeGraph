        ngm:oracle-network,
        ngm:zero-knowledge-proof .

ngm:cross-chain-governance a owl:Class ;
    rdfs:label "Cross-Chain Governance"@en ;
    rdfs:comment "Cross-Chain Governance is a coordination framework and set of protocols that enable governance proposals, voting outcomes, and policy updates to propagate and be enforced across multiple heterogeneous blockchain networks without requiring a single trusted intermediary. It extends on-chain governance mechanisms — token-weighted voting, quadratic voting, time-locked execution — to multi-chain environments using interoperability layers such as IBC (Inter-Blockchain Communication), cross-chain message-passing bridges, or relay networks. Achieving consistent governance state across chains requires solving distributed consensus problems while preserving each chain's sovereignty. The field sits at the intersection of blockchain interoperability, distributed systems coordination, and decentralised decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-chain-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-consensus ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:multi-stakeholder-governance ;
    vc:contrastsWith ngm:centralised-governance,
        ngm:off-chain-governance,
        ngm:on-chain-governance ;
    vc:dependsOn ngm:cross-chain-bridge,
        ngm:fraud-proof,
        ngm:relay-network ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:protocol-upgrades,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cosmos-ibc,
        ngm:optimistic-rollup,
        ngm:polkadot-parachains,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:blockchain-interoperability,
        ngm:cross-chain-messaging,
        ngm:distributed-consensus,
        ngm:smart-contract ;
    vc:slug "cross-chain-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:governance-token,
        ngm:on-chain-voting,
        ngm:time-lock .

ngm:crypto-wallet a owl:Class ;
    rdfs:label "Crypto Wallet"@en ;
    rdfs:comment "A crypto wallet is software or hardware that manages the private keys controlling blockchain assets and enables users to sign transactions, hold tokens, and interact with decentralised applications. Wallets may be custodial or non-custodial, hot or cold, and increasingly serve as the identity and access layer for Web3. They do not store assets themselves but the cryptographic keys that authorise control over on-chain balances."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:web3 ;
    vc:slug "crypto-wallet" ;
    vc:sourceDomain "blockchain" .

ngm:cryptocurrency-token a owl:Class ;
    rdfs:label "Cryptocurrency Token"@en ;
    rdfs:comment "A programmable digital asset implemented via smart contracts on a blockchain platform, categorised into utility tokens (access rights), security tokens (equity or debt instruments), governance tokens (protocol voting rights), and non-fungible tokens (NFTs, unique digital ownership). Token behaviour and interoperability are defined by standards such as ERC-20, ERC-721, and ERC-1155."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wrapped-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-identity,
        ngm:finance,
        ngm:supply-chain ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:cryptocurrency ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-ledger ;
    vc:enables ngm:decentralized-autonomous-organization,
        ngm:liquidity-provision,
        ngm:staking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fungible-token,
        ngm:governance-token,
        ngm:non-fungible-token,
        ngm:security-token,
        ngm:utility-token,
        ngm:wrapped-token ;
    vc:implements ngm:erc-1155 ;
    vc:isPartOf ngm:decentralized-finance,
        ngm:token-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
