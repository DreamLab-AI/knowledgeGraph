    vc:enables ngm:compliance-verification,
        ngm:global-metaverse-operations ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:binding-corporate-rules,
        ngm:standard-contractual-clauses,
        ngm:transfer-impact-assessment ;
