ngm:friction a owl:Class ;
    rdfs:label "Friction"@en ;
    rdfs:comment "Friction - The resistive force generated when surfaces slide or attempt to slide relative to one another, characterised by Coulomb friction (kinetic and static coefficients) and viscous damping, significantly impacting Joint Efficiency, Motor Performance, and Motion Accuracy in roboti..."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics,
        ngm:robotics ;
    skos:broader ngm:robo-actuation-and-control,
        ngm:robotics ;
    vc:enables ngm:energy-efficiency-calculation,
        ngm:model-based-control,
        ngm:wear-prediction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:energy-dissipation,
        ngm:joint-mechanics ;
    vc:qualityScore "0.54"^^xsd:float ;
    vc:requires ngm:friction-coefficient-estimation,
        ngm:lubrication-management ;
    vc:slug "friction" ;
    vc:sourceDomain "robotics" .

