    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:ImmersiveExperience
] .

# Virtual Production Pipeline
mv:VirtualProductionPipeline a owl:Class ;
    rdfs:subClassOf mv:VirtualProduction ;
    rdfs:label "Virtual Production Pipeline"@en ;
    rdfs:comment "The end-to-end workflow for creating film and television content using real-time rendering, LED volumes, motion capture, and game engine technology, integrating pre-visualization, on-set virtual environments, and in-camera visual effects to replace traditional post-production VFX processes."@en ;
    skos:prefLabel "Virtual Production Pipeline"@en ;
    dcterms:identifier "MV-10138" ;
    dcterms:subject "mv" .

mv:VirtualProductionPipeline rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:LEDVolume
] .

