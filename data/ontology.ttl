    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AISafety vcw:bridgesTo artificial-intelligence:AutonomousRobot .

artificial-intelligence:AISafety vcw:bridgesTo artificial-intelligence:SmartContract .

