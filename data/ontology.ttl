ngm:account-abstraction a owl:Class ;
    rdfs:label "Account Abstraction"@en ;
    rdfs:comment "A paradigm shift in ereum account architecture standardized through ERC-4337 (March 2023) enabling smart contract wallets with programmable transaction validation logic, decoupled gas payment mechanisms, and flexible account recovery, eliminating the distinction between externally owned accounts ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngmi:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-protocol-and-consensus,
        ngm:smart-contract ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:account-recovery,
        ngm:batch-operations,
        ngm:gasless-transactions,
        ngm:programmable-validation,
        ngm:session-keys,
        ngm:social-recovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:account-factory,
        ngm:bundler,
        ngm:entry-point-contract,
        ngm:paymaster-contract,
        ngm:signature-aggregator,
        ngm:user-operation ;
    vc:implements ngm:account-model,
        ngm:erc-4337,
        ngm:gas-sponsorship,
        ngm:user-operation-mempool ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:evm,
        ngm:gas-abstraction,
        ngm:signature-verification,
        ngm:smart-contract,
        ngmi:ethereum ;
    vc:slug "account-abstraction" ;
    vc:sourceDomain "blockchain" .

ngm:adversarial-attacks a owl:Class ;
    rdfs:label "Adversarial Attacks"@en ;
    rdfs:comment "Adversarial Attacks are malicious techniques that exploit vulnerabilities in machine learning models by deliberately crafting deceptive input data to cause incorrect predictions, misclassifications, or unintended behaviors, often through subtle perturbations imperceptible to humans but significan..."@en ;
    rdfs:subClassOf ngm:ai-security-threats,
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-evasion,
        ngm:system-manipulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:crafted-perturbations,
        ngm:knowledge-of-target-model ;
    vc:slug "adversarial-attacks" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:age-verification a owl:Class ;
    rdfs:label "Age Verification"@en ;
    rdfs:comment "Age verification is a set of technical and procedural mechanisms used to confirm that a user meets a minimum age threshold before accessing restricted digital content or services. It encompasses document-based checks, biometric estimation, and privacy-preserving cryptographic proofs. Regulatory frameworks such as the UK Online Safety Act mandate age verification for platforms hosting harmful content. The field balances effective enforcement against privacy risks and the potential exclusion of legitimate users."@en ;
    rdfs:subClassOf ngm:compliance-verification ;
    vc:enables ngm:content-moderation,
        ngm:parental-controls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:data-protection,
        ngm:digital-identity,
        ngm:gdpr ;
    vc:slug "age-verification" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:online-safety-act-2023,
        ngm:uk-online-safety-act .

ngm:agent-event-stream a owl:Class ;
    rdfs:label "Agent Event Stream"@en ;
    rdfs:comment "A real-time telemetry stream (surface S6) that emits ActivityStream|ActivityStreams-based JSON-LD events for agent lifecycle events (birth, startup, activity, completion, error, termination) via WebSocket, Nostr relay, or message queue, enabling external monitoring systems, dashboards, and or..."@en ;
