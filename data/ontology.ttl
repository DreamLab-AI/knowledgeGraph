# Cylindrical Robot
robotics:CylindricalRobot rdf:type owl:Class ;
    rdfs:subClassOf robotics:IndustrialRobot ;
    rdfs:subClassOf robotics:CoordinateRobots ;
    rdfs:subClassOf robotics:FixedBaseManipulator ;
    rdfs:label "Cylindrical Robot"@en ;
    rdfs:comment "Cylindrical robot employs one rotary joint (azimuth) and two prismatic joints (radial and vertical) that produce a cylindrical workspace, enabling efficient reach over rectangular work envelopes. This architecture, simpler and more affordable than six-axis articulated robots, has historically dominated Assembly Automation and Material Handling applications where reach and vertical lift are primary requirements."@en ;
    skos:prefLabel "Cylindrical Robot"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:cylindrical-robot" ;
    owl:sameAs <urn:visionclaw:concept:robotics:cylindrical-robot> ;
    vcw:contentHash "sha256-12-6af8998e3bc5" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "RB-0134" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.95"^^xsd:decimal ;
