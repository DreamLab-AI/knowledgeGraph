ngm:rdma a owl:Class ;
    rdfs:comment "Remote Direct Memory Access (RDMA) is a networking capability that lets one computer read from or write to the memory of another without involving either machine's operating system or CPU on the data path. By bypassing kernel buffering and copying, RDMA delivers very low latency and high throughput, which is essential for the collective communication patterns of large-scale distributed training. It is exposed through fabrics such as InfiniBand and RoCE and underpins high-performance computing clusters."@en ;
    rdfs:label "Rdma"@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    rdfs:subClassOf ngm:networking ;
    skos:broader ngm:infra-network-and-comms ;
