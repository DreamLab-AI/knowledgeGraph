        ngm:generative-ai,
        ngm:natural-language-processing,
        ngm:raster-graphics .

ngm:immersive-entertainment a owl:Class ;
    rdfs:label "Immersive Entertainment"@en ;
    rdfs:comment "Entertainment experiences leveraging VR, AR, and mixed reality technologies to create interactive, participatory content that transforms audiences from passive spectators into active participants within gaming, theme parks, live events, and digital experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
