        ngm:resampling,
        ngm:sigma-point-sampling .

ngm:bip-340 a owl:Class ;
    rdfs:label "BIP-340"@en ;
    rdfs:comment "BIP-340 is the Bitcoin Improvement Proposal that standardises Schnorr signatures for use on the Bitcoin network, using the secp256k1 elliptic curve. It defines a 64-byte signature scheme that is provably secure in the random oracle model and enables key and signature aggregation through protocols such as MuSig2. BIP-340 is a prerequisite for Taproot (BIP-341) and introduces substantial efficiency and privacy improvements over the legacy ECDSA scheme. The specification includes a deterministic signing algorithm and rigorous test vectors to facilitate cross-implementation compatibility."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:bip-340-schnorr-keypair,
        ngm:bip-341,
        ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:schnorr-signature ;
    vc:slug "bip-340" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-improvement-proposals .

ngm:blockchain-provenance a owl:Class ;
    rdfs:label "Blockchain Provenance"@en ;
    rdfs:comment "Blockchain Provenance is the application of distributed ledger technology to record and verify the complete historical lineage of an asset, document, or data artefact, such that its origin, custody chain, and transformations are cryptographically authenticated and tamper-resistant. Each provenance event is anchored as an immutable transaction on-chain, enabling any party to independently reconstruct and audit the full lifecycle of the item without relying on a central authority."@en ;
    rdfs:subClassOf ngm:blockchain-technology ;
    vc:enables ngm:audit-trail,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-integrity,
        ngm:immutability,
        ngm:provenance-tracking ;
    vc:slug "blockchain-provenance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:merkle-tree,
        ngm:smart-contract .

ngm:bolt a owl:Class ;
    rdfs:label "BOLT"@en ;
    rdfs:comment "BOLT, the Basis of Lightning Technology, is the set of specifications that define how Lightning Network implementations interoperate. The documents cover channels, routing, and messaging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
