ngm:smpte-st-2128 a owl:Class ;
    rdfs:label "SMPTE ST 2128"@en ;
    rdfs:comment "SMPTE ST 2128 is a standard from the Society of Motion Picture and Television Engineers in the area of professional media and video signalling. It forms part of the SMPTE family of broadcast and production standards."@en ;
