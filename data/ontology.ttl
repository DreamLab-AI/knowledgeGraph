    vc:bridgesTo ngm:artificial-intelligence-ethics,
        ngm:governance ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:federated-identity ;
    vc:dependsOn ngm:blockchain,
        ngm:distributed-ledger-technology ;
    vc:enables ngm:privacy-preserving-authentication,
        ngm:self-sovereign-identity,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decentralised-identifier,
        ngm:digital-wallet,
        ngm:verifiable-credential ;
    vc:implements ngm:openid-connect,
        ngm:w3c-did-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:hyperledger-indy,
        ngm:selective-disclosure ;
    vc:requires ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:slug "identity-management" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-24760,
