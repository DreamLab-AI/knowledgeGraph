ngm:verifiable-credential-vc a owl:Class ;
    rdfs:label "Verifiable Credential (VC)"@en ;
    rdfs:comment "A W3C standard for tamper-evident credentials that can be cryptographically verified, containing claims made by an issuer about a subject, enabling trustable digital attestations without requiring direct communication with the issuer."@en ;
    rdfs:subClassOf ngm:spatial-computing ;
    vc:enables ngm:privacy-preserving-verification,
        ngm:selective-disclosure,
        ngm:trustable-attestations,
        ngm:verifiable-presentations ;
    vc:hasPart ngm:claim,
        ngm:credential-metadata,
        ngm:credential-schema,
        ngm:cryptographic-proof,
        ngm:issuer-signature ;
    vc:isPartOf ngm:self-sovereign-identity-ssi,
        ngm:trust-infrastructure ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:decentralized-identity-did,
        ngm:digital-signature,
        ngm:identity-wallet,
        ngm:public-key-infrastructure ;
    vc:slug "verifiable-credential-vc" ;
    vc:sourceDomain "spatial-computing" .

