    vc:slug "cooling-system" ;
    vc:sourceDomain "computing" .

ngm:coordinate-transformation a owl:Class ;
    rdfs:label "Coordinate Transformation"@en ;
    rdfs:comment "A coordinate transformation is a mathematical mapping that converts the representation of a point, vector, or geometric object from one coordinate system or reference frame to another, preserving geometric relationships while expressing them in a new basis. In robotics and computer graphics, transformations are represented as homogeneous matrices, quaternions, or dual quaternions encoding rotation, translation, and scaling operations."@en ;
    rdfs:subClassOf ngm:coordinate-system ;
    vc:enables ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:kinematics,
        ngm:reference-frames,
        ngm:rigid-body-dynamics ;
    vc:slug "coordinate-transformation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:quaternion-math .

ngm:coordination-protocol a owl:Class ;
    rdfs:label "Coordination Protocol"@en ;
    rdfs:comment "A Coordination Protocol is a formally specified set of rules, message formats, and interaction sequences that govern how distributed agents or system components communicate and synchronise their actions to achieve a common objective. It defines the obligations, permissions, and commitments of each participant at each state of an interaction, ensuring predictable collective behaviour despite independent agent decision-making."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:multi-agent-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:coordination-mechanisms ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-protocol ;
    vc:slug "coordination-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:interoperability ;
    vc:uses ngm:message-passing .

ngm:creative-media-domain a owl:Class ;
    rdfs:label "Creative Media Domain"@en ;
    rdfs:comment "A cross-cutting domain encompassing AI-enabled creative content generation, including generative art, synthetic media, procedural content creation, AI-assisted design, computational creativity, and the intersection of artificial intelligence with artistic and media production workflows."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ai-augmented-creativity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "creative-media-domain" ;
    vc:sourceDomain "spatial-computing" .

ngm:credential-issuance a owl:Class ;
    rdfs:label "Credential Issuance"@en ;
    rdfs:comment "Credential issuance is the process by which an authoritative entity — an issuer — creates, signs, and delivers a structured attestation about a subject's attributes, qualifications, or identity to that subject or to a designated holder. In the W3C Verifiable Credentials model, issuance involves binding claims to a subject's decentralised identifier using the issuer's cryptographic key, producing a tamper-evident credential that the holder can present to verifiers without returning to the issuer. The issuance process encompasses schema selection, claim population, signature generation, and delivery, and may be implemented with varying degrees of issuer privacy, holder binding strength, and revocability."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:enables ngm:credential-verification,
        ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:digital-identity ;
    vc:slug "credential-issuance" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:credential-schema,
        ngm:cryptographic-signature,
        ngm:decentralized-identifiers,
        ngm:verifiable-credentials .

ngm:cross-chain-governance a owl:Class ;
    rdfs:label "Cross-Chain Governance"@en ;
    rdfs:comment "Cross-Chain Governance is a coordination framework and set of protocols that enable governance proposals, voting outcomes, and policy updates to propagate and be enforced across multiple heterogeneous blockchain networks without requiring a single trusted intermediary. It extends on-chain governance mechanisms — token-weighted voting, quadratic voting, time-locked execution — to multi-chain environments using interoperability layers such as IBC (Inter-Blockchain Communication), cross-chain message passing bridges, or relay networks. Achieving consistent governance state across chains requires solving distributed consensus problems whilst preserving each chain's sovereignty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-chain-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-interoperability ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:on-chain-governance ;
    vc:requires ngm:blockchain-interoperability,
        ngm:cross-chain-messaging ;
    vc:slug "cross-chain-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:smart-contract .

ngm:cross-validation a owl:Class ;
    rdfs:label "Cross-Validation"@en ;
    rdfs:comment "Cross-validation is a statistical resampling technique for evaluating machine learning model performance by partitioning available data into complementary training and validation subsets, training the model on each partition in turn, and averaging the resulting error estimates. It provides a less optimistic and more generalisable estimate of out-of-sample predictive performance than a single train–test split."@en ;
    rdfs:subClassOf ngm:ai-machine-learning ;
    vc:contrastsWith ngm:annotated-training-data ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:benign-overfitting,
        ngm:convolutional-neural-network ;
    vc:slug "cross-validation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:applied-machine-learning .

ngm:cryptocurrency-token a owl:Class ;
    rdfs:label "Cryptocurrency Token"@en ;
    rdfs:comment "A programmable digital asset implemented via smart contracts on a blockchain platform, categorised into utility tokens (access rights), security tokens (equity or debt instruments), governance tokens (protocol voting rights), and non-fungible tokens (NFTs, unique digital ownership). Token behaviour and interoperability are defined by standards such as ERC-20, ERC-721, and ERC-1155."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fungible-token,
        ngm:governance-token,
        ngm:utility-token ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:token-economics ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "cryptocurrency-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:erc-20,
        ngm:erc-721,
        ngm:token-standard .

ngm:cryptographic-layer a owl:Class ;
    rdfs:label "Cryptographic Layer"@en ;
    rdfs:comment "The Cryptographic Layer is the stratum that provides confidentiality, integrity, and authenticity primitives to the layers above. It sits above the Hardware Layer, which supplies entropy and acceleration, and below identity, consensus, and security strata that depend on its guarantees. It contains ciphers, hash functions, signature schemes, and key management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-layer ],
        ngm:owl-thing ;
    vc:enables ngm:consensus-layer,
        ngm:identity-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware-layer ;
    vc:slug "cryptographic-layer" ;
    vc:sourceDomain "cryptographic" .

ngm:cryptographic-signing a owl:Class ;
    rdfs:label "Cryptographic Signing"@en ;
    rdfs:comment "Cryptographic signing is the process of producing a verifiable proof of authorship and integrity over a message or document using a private key, such that anyone holding the corresponding public key can confirm the signature without being able to forge it. It underpins authentication, non-repudiation, software-supply-chain integrity, and blockchain transaction authorisation. Signing schemes include RSA, ECDSA, EdDSA, and Schnorr, each defining how a hash of the message is transformed under the signer's secret key into a compact, publicly verifiable signature."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:key-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol ;
    vc:slug "cryptographic-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:public-key-cryptography .

ngm:cryptographic-system a owl:Class ;
    rdfs:label "Cryptographic System"@en ;
    rdfs:comment "An integrated framework of mathematical algorithms, protocols, and mechanisms designed to provide information security properties including confidentiality, integrity, authentication, and non-repudiation in adversarial environments. Blockchain cryptographic systems enable trustless operation through mathematical guarantees rather than trusted intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-network,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
