    vc:sourceDomain "spatial-computing" .

ngm:immersive-experiences a owl:Class ;
    rdfs:label "Immersive Experiences"@en ;
    rdfs:comment "Digital interactions utilising VR, AR, and mixed reality technologies to create engaging, interactive environments that generate a sense of presence and participation, spanning gaming, education, enterprise collaboration, and consumer applications within metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
