ngm:attention-mechanism a owl:Class ;
    rdfs:label "Attention Mechanism"@en ;
    rdfs:comment "An Attention Mechanism is a neural network component that enables models to dynamically weight the relevance of different input positions when producing each output element, computing weighted combinations based on learned similarity scores. Originally introduced for sequence-to-sequence machine translation, self-attention and multi-head attention are now the core computational primitives of transformer architectures, enabling parallel processing of sequences and capturing long-range dependencies that recurrent models struggle with."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:neural-network-component ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai ;
    vc:slug "attention-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network .

ngm:financial-regulation a owl:Class ;
    rdfs:label "Financial Regulation"@en ;
    rdfs:comment "Financial Regulation comprises the rules, statutes, supervisory frameworks, and oversight bodies that govern financial markets, institutions, and digital asset ecosystems. In blockchain and DLT contexts, it encompasses anti-money laundering (AML) obligations, know-your-customer (KYC) requirements, securities classification of tokens, stablecoin frameworks, and central bank digital currency (CBDC) governance. Regulatory approaches differ substantially across jurisdictions, creating compliance complexity for cross-border decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:securities-regulation,
