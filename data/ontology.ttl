ngm:environmental-mapping a owl:Class ;
    rdfs:label "Environmental Mapping"@en ;
    rdfs:comment "Environmental mapping is the computational process of constructing spatial representations of a physical environment from sensor data, enabling autonomous agents or robots to understand, navigate, and interact with their surroundings. It encompasses techniques that transform raw sensory inputs—such as lidar point clouds, camera imagery, and depth data—into structured geometric or semantic maps used for path planning and obstacle avoidance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:localization,
