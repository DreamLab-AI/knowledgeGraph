        ngm:metaverse-interoperability,
        ngm:real-time-rendering,
        ngm:web-3-d-visualization ;
    vc:hasPart ngm:animation-rig,
        ngm:camera-definition,
        ngm:geometric-mesh,
        ngm:lighting-environment,
        ngm:lod-specification,
        ngm:material-system,
        ngm:normal-map,
        ngm:pbr-workflow,
        ngm:polygon-topology,
        ngm:scene-hierarchy,
        ngm:skeletal-bone,
        ngm:texture-map,
        ngm:uv-coordinate,
        ngm:vertex-attribute ;
    vc:implements ngm:extension-mechanism,
        ngm:mesh-lod,
        ngm:non-destructive-editing,
        ngm:pbr-materials,
        ngm:progressive-loading,
        ngm:scene-composition,
        ngm:scene-graph-format,
        ngm:skeletal-animation,
        ngm:version-control ;
