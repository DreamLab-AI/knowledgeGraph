        ngm:role-based-access-control ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:privacy-by-design,
        ngm:zero-trust-architecture ;
    vc:requires ngm:authentication,
        ngm:identity-management,
        ngm:technical-standards ;
    vc:slug "policy-engine" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:open-policy-agent,
        ngm:xacml ;
    vc:supports ngm:audit-logging,
