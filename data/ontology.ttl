    rdfs:label "Industrial Internet Of Things"@en .

ngm:industrial-robotics a owl:Class ;
    rdfs:label "Industrial Robotics"@en ;
    rdfs:comment "Industrial robotics is the application of programmable, reprogrammable robots to manufacturing tasks including assembly, welding, material handling, painting and inspection, operating within structured production environments to improve consistency, throughput and safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
