ngm:small-modular-reactors a owl:Class ;
    rdfs:label "Small Modular Reactors"@en ;
    rdfs:comment "Small modular reactors (SMRs) are nuclear fission reactors with an electrical output typically under 300 MWe whose components are factory-fabricated as standardised modules and assembled on site. Their smaller scale, passive safety features, and modular construction aim to lower capital cost and deployment time relative to gigawatt-scale plants. They are an emerging low-carbon power-infrastructure option, including for energy-intensive data centres."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power,
        ngm:sustainability ;
    vc:slug "small-modular-reactors" ;
    vc:sourceDomain "infrastructure" .

ngm:small-world-network a skos:Concept ;
    rdfs:label "Small World Network"@en .

ngm:smart-bft a owl:Class ;
    rdfs:label "SMaRT-BFT"@en ;
    rdfs:comment "SMaRT-BFT is a Byzantine fault tolerant consensus approach built on the SMaRt (State Machine Replication) library, used to order transactions deterministically across a fixed set of validating nodes. It tolerates up to f faulty replicas out of 3f+1 total while guaranteeing safety and liveness under partial synchrony. It is commonly deployed in permissioned ledgers where validator identity is known and high throughput with finality is required."@en ;
    rdfs:subClassOf ngm:consensus-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-as-a-service,
        ngm:byzantine-fault-tolerance,
        ngm:consortium-blockchain ;
    vc:slug "smart-bft" ;
    vc:sourceDomain "blockchain" .

ngm:smart-building a skos:Concept ;
