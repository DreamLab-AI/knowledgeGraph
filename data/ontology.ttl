        ngm:smart-contract ;
    vc:slug "virtual-economy-domain" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptocurrency,
        ngm:tokenization .

ngm:virtual-environment-specification a owl:Class ;
    rdfs:label "Virtual Environment Specification"@en ;
    rdfs:comment "Technical standards and requirements documents that define the parameters, capabilities, and constraints of virtual environments, including rendering requirements, interaction models, physics simulation rules, and interoperability protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
