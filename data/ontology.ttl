ngm:rest-api a owl:Class ;
    rdfs:label "REST API"@en ;
    rdfs:comment "A REST API (Representational State Transfer Application Programming Interface) is a web service interface conforming to Roy Fielding's six architectural constraints — client–server separation, statelessness, cacheability, uniform interface, layered system, and optional code-on-demand — originally formalised in his 2000 doctoral dissertation. Resources are uniquely addressed by URIs, manipulated through standard HTTP verbs (GET, POST, PUT, PATCH, DELETE), and represented in negotiated formats such as JSON or XML. The uniform interface constraint — encompassing resource identification, manipulation through representations, self-descriptive messages, and hypermedia as the engine of application state (HATEOAS) — is the defining characteristic that separates REST from earlier RPC and SOAP-based architectures. REST APIs have become the dominant integration surface across cloud platforms, AI model serving, microservices ecosystems, and public developer APIs precisely because they align with existing HTTP infrastructure including caches, proxies, load balancers, and API gateways."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uri ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:federated-learning,
        ngm:llm-inference-api,
        ngm:model-serving ;
    vc:contrastsWith ngm:g-rpc,
        ngm:graph-ql,
        ngm:websocket ;
    vc:enables ngm:api-economy,
        ngm:cloud-native,
        ngm:microservices-architecture,
        ngm:service-oriented-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:hateoas,
        ngm:http,
        ngm:open-api-specification ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:api-design,
        ngm:stateless-protocol ;
    vc:requires ngm:uri ;
    vc:slug "rest-api" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-gateway,
        ngm:content-negotiation,
        ngm:rate-limiting ;
    vc:uses ngm:json-data-interchange-format,
        ngm:oauth-2-0,
        ngm:tls,
        ngm:xml .

