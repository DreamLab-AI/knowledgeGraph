ngm:dc-telepresence a owl:Class,
        skos:Concept ;
    rdfs:label "Telepresence"@en ;
    rdfs:comment "Telepresence is the distributed-collaboration taxonomy hub covering technologies that create a convincing sense of physical co-presence across remote locations — spanning robotic telepresence, haptic-feedback telepresence, virtual-reality telepresence, and social presence theory. It is a peer category to Workspace Tools and Communication Technology within the distributed collaboration domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:teleoperation-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
