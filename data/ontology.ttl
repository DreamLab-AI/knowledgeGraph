ngm:decentralised-governance a owl:Class ;
    rdfs:label "Decentralised Governance"@en ;
    rdfs:comment "A model of collective decision-making in which authority is distributed across participants rather than concentrated in a central body, often implemented through on-chain voting, token-weighted proposals, and smart contracts that execute decisions automatically once thresholds are met."@en ;
