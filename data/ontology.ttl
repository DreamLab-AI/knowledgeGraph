ngm:proximity-sensor a owl:Class ;
    rdfs:label "Proximity Sensor"@en ;
    rdfs:comment "An electronic device that detects the presence or distance of nearby objects without physical contact, using capacitive, inductive, ultrasonic, optical, or magnetic principles. Proximity sensors are foundational to robotic collision avoidance, autonomous navigation, and spatial mapping in both physical and hybrid physical-digital environments."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:autonomous-navigation,
        ngm:robot-safety,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-sensor,
        ngm:robotic-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:lidar,
        ngm:sensor-fusion ;
    vc:slug "proximity-sensor" ;
    vc:sourceDomain "robotics" .

ngm:psychoacoustics a owl:Class ;
    rdfs:label "Psychoacoustics"@en ;
    rdfs:comment "Psychoacoustics is the scientific study of how humans perceive sound, relating physical properties of acoustic signals such as frequency, intensity and timing to subjective sensations of pitch, loudness, timbre and spatial location. It characterises perceptual phenomena including auditory masking, critical bands and localisation cues, and explains the limits and biases of the human auditory system. Its findings underpin perceptual audio coding, spatial audio rendering and hearing-aid design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        ngm:perception ;
    vc:dependsOn ngm:cognitive-science,
        ngm:perception ;
    vc:enables ngm:audio-codec,
        ngm:immersive-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ambisonics,
        ngm:audio-system ;
    vc:requires ngm:perception,
        ngm:signal-processing ;
    vc:slug "psychoacoustics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:audio-spatialization,
        ngm:spatial-audio ;
    vc:uses ngm:signal-processing .

ngm:public-policy a owl:Class ;
    rdfs:label "Public Policy"@en ;
    rdfs:comment "Public policy is the set of decisions, principles, and courses of action that governments and public institutions adopt to address societal problems and pursue collective goals. It encompasses the formulation, adoption, implementation, and evaluation of measures spanning law, regulation, spending, and service delivery, informed by evidence and shaped by competing interests and values. In digital contexts it determines how states govern technology, data, infrastructure, and rights."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decision-making ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:digital-governance ;
    vc:enables ngm:accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:policy,
        ngm:regulation ;
    vc:isPartOf ngm:governance,
        ngm:governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-governance,
        ngm:governance,
        ngm:policy,
        ngm:regulation ;
    vc:requires ngm:decision-making,
        ngm:stakeholder-engagement ;
    vc:slug "public-policy" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:transparency ;
    vc:uses ngm:decision-making .

ngm:push-notification a owl:Class ;
    rdfs:label "Push Notification"@en ;
    rdfs:comment "A push notification is a server-initiated message delivered to a client device or application without an explicit client request, enabling real-time alerts about events, state changes, or incoming communications. It relies on persistent connections or platform push services that maintain a delivery channel even when the application is backgrounded. It is a foundational primitive for presence, messaging, and event-driven user engagement."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-provider,
        ngm:presence-indicator ;
    vc:slug "push-notification" ;
    vc:sourceDomain "infrastructure" .

ngm:quadratic-programming a owl:Class ;
    rdfs:label "Quadratic Programming"@en ;
    rdfs:comment "Quadratic programming (QP) is a class of mathematical optimisation problems in which a quadratic objective function is minimised subject to linear equality and inequality constraints. It is a convex optimisation problem when the quadratic term is positive semidefinite, admitting efficient and globally optimal solvers. QP is foundational to model-based control, trajectory optimisation, and constrained robotic motion generation."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:model-based-control ;
    vc:slug "quadratic-programming" ;
    vc:sourceDomain "robotics" .

ngm:qubit a skos:Concept ;
    rdfs:label "Qubit"@en .

ngm:quorum-mechanism a owl:Class ;
    rdfs:label "Quorum Mechanism"@en ;
    rdfs:comment "A quorum mechanism is a governance rule that requires a minimum threshold of participation or stake to be reached before a vote or decision is considered valid and binding. In on-chain governance it guards against capture by small, motivated minorities and ensures decisions reflect sufficient stakeholder engagement. Quorum thresholds are often expressed as a fraction of total voting power or eligible participants."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delegate-democracy,
        ngm:on-chain-voting ;
    vc:slug "quorum-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:random-forest a owl:Class ;
    rdfs:label "Random Forest"@en ;
    rdfs:comment "A random forest is an ensemble learning method that constructs many decision trees and aggregates their predictions, typically by majority vote for classification or averaging for regression. Each tree is trained on a bootstrap sample of the data and considers a random subset of features at each split, which decorrelates the trees and reduces variance. The resulting model is robust, resistant to overfitting, and provides built-in estimates of feature importance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:decision-tree ;
    vc:bridgesTo ngm:supervised-learning ;
    vc:contrastsWith ngm:boosting,
        ngm:neural-network ;
    vc:dependsOn ngm:cross-validation ;
    vc:enables ngm:feature-importance,
        ngm:interpretability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:supervised-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:decision-tree,
        ngm:feature-importance ;
    vc:requires ngm:model-training ;
    vc:slug "random-forest" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:feature-engineering ;
    vc:uses ngm:bagging,
        ngm:decision-tree,
        ngm:feature-selection .

ngm:random-search a owl:Class ;
    rdfs:label "Random Search"@en ;
    rdfs:comment "Random search is a hyperparameter-optimisation method that samples hyperparameter configurations at random from specified distributions over the search space, rather than evaluating a fixed grid. For a given evaluation budget it often outperforms grid search because it explores more distinct values of the most influential hyperparameters. It is simple, parallelisable, and a strong baseline for automated tuning."@en ;
    rdfs:subClassOf ngm:hyperparameter-optimisation ;
    vc:contrastsWith ngm:bayesian-optimisation,
        ngm:grid-search ;
    vc:dependsOn ngm:machine-learning,
        ngm:search-space ;
    vc:enables ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:hyperparameter-tuning ;
    vc:isPartOf ngm:hyperparameter-optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:monte-carlo-methods,
        ngm:stochastic-optimisation ;
    vc:slug "random-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-selection ;
    vc:uses ngm:sampling,
        ngm:search-space .

ngm:ray-marching a owl:Class ;
    rdfs:label "Ray Marching"@en ;
    rdfs:comment "Ray Marching is a rendering technique in which a ray is incrementally stepped through a scene, evaluating a signed distance field (SDF) at each step to determine proximity to geometry. The step size adapts to the SDF value (sphere tracing), enabling efficient rendering of implicit surfaces, volumetric effects, soft shadows, and ambient occlusion that are impractical with triangle-based rasterisation. It is widely implemented in GPU shader programs and is foundational to procedural 3D scene generation in real-time and offline contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:rendering-technique,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:rasterization,
        ngm:ray-tracing ;
    vc:enables ngm:global-illumination,
        ngm:procedural-generation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:gpu-compute,
        ngm:shader ;
    vc:slug "ray-marching" ;
    vc:sourceDomain "spatial-computing" .

ngm:rb-0029-inverse-kinematics a owl:Class ;
    rdfs:label "rb 0029 inverse kinematics"@en ;
    rdfs:comment "Inverse kinematics (IK) is the computational process of determining the joint angles or actuator lengths required to place a robot's end-effector at a desired position and orientation in task space. Unlike forward kinematics, IK is typically under-determined or over-determined and requires iterative numerical solvers, analytical solutions, or Jacobian-based methods; it is a foundational component of motion planning, manipulation, and trajectory execution in robotic systems."@en ;
    rdfs:subClassOf ngm:kinematics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0028-forward-kinematics ;
    vc:enables ngm:motion-planning,
        ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:manipulator-arm,
        ngm:rb-0021-robot-kinematics,
        ngm:rb-0023-degrees-of-freedom ;
    vc:slug "rb-0029-inverse-kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0030-jacobian-matrix,
        ngm:rb-0031-singularity .

ngm:rb-0048-pid-controller a owl:Class ;
    rdfs:label "rb 0048 pid controller"@en ;
    rdfs:comment "A PID (Proportional-Integral-Derivative) controller is the most widely deployed feedback control algorithm in robotics and industrial automation. It computes a control output as the weighted sum of three terms: the proportional term (reacts to the current error magnitude), the integral term (eliminates steady-state error by accumulating past errors), and the derivative term (anticipates future error by responding to the rate of change). PID controllers are used in robot joint position and velocity loops, temperature regulation, and process control, often augmented with feed-forward terms to improve performance under known dynamics."@en ;
    rdfs:subClassOf ngm:control-theory,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0062-model-predictive-control ;
    vc:dependsOn ngm:rb-0072-encoder ;
    vc:enables ngm:rb-0054-position-control,
        ngm:rb-0055-velocity-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:rb-0047-feedback-control,
        ngm:rb-0060-optimal-control,
        ngm:rb-0063-sliding-mode-control ;
    vc:slug "rb-0048-pid-controller" ;
    vc:sourceDomain "robotics" .

ngm:rb-0052-collision-avoidance a owl:Class ;
    rdfs:label "rb 0052 collision avoidance"@en ;
    rdfs:comment "Collision avoidance in robotics is the capability of a robot system to detect and react to obstacles — including other robots, infrastructure, and human operators — so as to prevent physical contact that could cause damage or injury. It encompasses both reactive techniques (e.g. potential field methods, velocity obstacles) and proactive planning approaches that embed free-space constraints into the trajectory from the outset. It is a prerequisite for safe autonomous navigation and collaborative operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0049-motion-planning ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:dependsOn ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:obstacle-avoidance,
        ngm:rb-0092-protective-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0049-motion-planning,
        ngm:rb-0066-robot-sensor ;
    vc:slug "rb-0052-collision-avoidance" ;
    vc:sourceDomain "robotics" .

ngm:rb-0053-force-control a owl:Class ;
    rdfs:label "rb 0053 force control"@en ;
    rdfs:comment "Force control is a robot control paradigm in which the controller regulates the interaction force between the end-effector and its environment, rather than purely tracking a desired position trajectory. By closing the loop on measured contact forces from a force-torque sensor, the robot can perform compliant tasks such as surface grinding, peg-in-hole insertion, and human-robot handover without requiring precise environmental models. The main architectures are impedance control, admittance control, and hybrid position/force control, each suited to different environment stiffness regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0047-feedback-control ],
        ngm:control-system,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0056-impedance-control,
        ngm:rb-0057-admittance-control,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0047-feedback-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0053-force-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0103-collaborative-operation a owl:Class ;
    rdfs:label "rb 0103 collaborative operation"@en ;
    rdfs:comment "Collaborative operation is a mode of robotic system use in which a robot and one or more human operators work together within a shared workspace, as defined in ISO/TS 15066 and ISO 10218. It encompasses the specific operating conditions, safety functions, and interaction patterns that govern the coexistence of humans and robots without a fixed separating safeguard. The concept underpins cobot deployment strategies including hand guiding, speed and separation monitoring, power and force limiting, and safety-rated monitored stop."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0104-hand-guiding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0091-safety-rated-monitored-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0105-speed-and-separation-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0094-power-and-force-limiting ],
        ngm:collaborative-systems-modality-operation,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0104-hand-guiding,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:rb-0007-collaborative-robot ;
    vc:requires ngm:rb-0089-risk-assessment,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0094-power-and-force-limiting ;
    vc:slug "rb-0103-collaborative-operation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:real-time-synchronization a owl:Class ;
    rdfs:label "Real-time Synchronization"@en ;
    rdfs:comment "Real-time synchronization is the class of distributed systems techniques that maintain consistent, up-to-date shared state across multiple nodes or clients within latency bounds tight enough to support interactive or time-critical applications. Unlike eventual consistency systems that tolerate temporary divergence, real-time synchronization protocols propagate and reconcile state changes fast enough that all participants perceive a coherent shared reality, typically within milliseconds. It underpins collaborative editing, multiplayer simulation, digital twin mirroring, and live sensor data aggregation."@en ;
    rdfs:subClassOf ngm:distributed-system ;
    vc:enables ngm:digital-twin,
        ngm:multi-user-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:network-synchronization,
        ngm:real-time-digital-twin-synchronization,
        ngm:state-synchronization ;
    vc:slug "real-time-synchronization" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:web-socket-protocol .

ngm:real-time-translation a owl:Class ;
    rdfs:label "Real-time Translation"@en ;
    rdfs:comment "Real-time translation is the automatic conversion of spoken or written language content into one or more target languages with latency low enough to sustain live human communication, defined operationally as end-to-end processing delay below milliseconds for speech-to-speech pipelines and below 5..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automatic-speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-corpus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-machine-translation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
