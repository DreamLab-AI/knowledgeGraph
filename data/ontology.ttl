    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:unsupervised-learning ;
    vc:isPartOf ngm:representation-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:feature-engineering,
        ngm:principal-component-analysis,
        ngm:signal-processing ;
    vc:slug "sparse-representation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-compression,
        ngm:pruning ;
    vc:uses ngm:dimensionality-reduction,
        ngm:feature-selection .

ngm:spatial-coordinates a owl:Class ;
    rdfs:label "Spatial Coordinates"@en ;
    rdfs:comment "A unified reference frame system for positioning objects in three-dimensional virtual or mixed reality environments, including geographically-anchored poses (GeoPose) tied to Earth coordinates and local coordinate systems for scene-relative object placement with support for coordinate transformat..."@en ;
