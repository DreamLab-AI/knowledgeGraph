ngm:smart-contract-layer a owl:Class ;
    rdfs:label "Smart Contract Layer"@en ;
    rdfs:comment "The Smart Contract Layer is the stratum that holds self-executing programmes whose logic runs deterministically against agreed state. In the canonical stack it sits above the Middleware Layer and below the Application Layer, turning a shared ledger into a programmable platform. It contains contract code, virtual machine execution semantics, and the state these contracts read and write."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:middleware-layer ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:application-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:consensus-layer,
        ngm:middleware-layer ;
    vc:slug "smart-contract-layer" ;
    vc:sourceDomain "blockchain" .

ngm:smart-contract-resolution a skos:Concept ;
    rdfs:label "Smart Contract Resolution"@en .

ngm:smart-contract-standards a skos:Concept ;
    rdfs:label "Smart Contract Standards"@en .

ngm:smart-contract-testing a skos:Concept ;
    rdfs:label "Smart Contract Testing"@en .

ngm:smart-contract-vault a skos:Concept ;
    rdfs:label "Smart Contract Vault"@en .

ngm:smart-contract-verification a skos:Concept ;
    rdfs:label "Smart Contract Verification"@en .

ngm:smart-contract-vulnerability a skos:Concept ;
    rdfs:label "Smart Contract Vulnerability"@en .

ngm:smart-contracts-on-bitcoin a skos:Concept ;
    rdfs:label "Smart Contracts On Bitcoin"@en .

