    rdfs:label "Content Authoring System"@en .
ngm:content-based-filtering a owl:Class ;
    rdfs:comment "A recommendation technique that suggests items by matching the attributes of items a user has previously engaged with — such as text features, genres, tags, or learned embeddings — against the attributes of candidate items, building a per-user preference profile in feature space; it requires no data about other users, handles new items gracefully, and offers explainable suggestions, but tends to over-specialise, recommending only items similar to what the user already knows."@en ;
    rdfs:label "Content-Based Filtering"@en ;
    rdfs:subClassOf ngm:recommendation-systems ;
    vc:contrastsWith ngm:collaborative-systems-modality-filtering ;
