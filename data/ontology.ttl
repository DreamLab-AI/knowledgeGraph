        ngm:lens-distortion-correction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feature-detection ;
    vc:isPartOf ngm:optical-calibration-target ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fiducial-marker,
        ngm:homography ;
    vc:slug "checkerboard-pattern" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:camera-calibration,
        ngm:pose-estimation ;
    vc:uses ngm:computer-vision,
        ngm:feature-detection .

ngm:clearing a owl:Class ;
    rdfs:label "Clearing"@en ;
    rdfs:comment "Clearing is the post-trade process of confirming, matching and managing the obligations arising from a transaction in the interval between execution and settlement. A clearing house, often acting as a central counterparty, novates trades and nets exposures, calculating the net obligations of each party and managing counterparty credit risk through margin and default funds. Clearing reduces systemic risk and operational burden in securities, derivatives and payment markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trade-execution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:clearing-house ],
        ngm:financial-market-infrastructure ;
    vc:bridgesTo ngm:financial-infrastructure ;
    vc:contrastsWith ngm:settlement ;
    vc:dependsOn ngm:clearing-house ;
    vc:enables ngm:settlement,
        ngm:trade-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:trade-execution ;
    vc:isPartOf ngm:financial-market-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:custody,
        ngm:payment-system ;
    vc:requires ngm:clearing-house,
        ngm:risk-management ;
    vc:slug "clearing" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:capital-markets,
        ngm:payment-processing ;
    vc:uses ngm:clearing-house .

ngm:clearing-and-settlement a owl:Class ;
    rdfs:label "Clearing And Settlement"@en ;
    rdfs:comment "Clearing and settlement are the post-trade processes that finalise a financial transaction: clearing reconciles, nets and confirms the obligations between counterparties, while settlement effects the actual transfer of securities and funds to discharge those obligations. Central counterparties and securities depositories reduce counterparty risk by interposing themselves and managing margin. The integrity of these processes underpins the stability of payment and securities markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:securities-settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-system ],
        ngm:financial-infrastructure ;
    vc:dependsOn ngm:payment-system ;
    vc:enables ngm:cross-border-settlement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:payment-settlement,
        ngm:securities-settlement,
        ngm:settlement ;
    vc:implements ngm:settlement ;
