ngm:3-gpp a owl:Class ;
    rdfs:label "3GPP"@en ;
    rdfs:comment "The 3rd Generation Partnership Project (3GPP) is a global consortium of regional telecommunications standards bodies that develops and maintains versioned technical specifications governing mobile communication systems, from UMTS (3G) through LTE (4G) to NR (5G) and the emerging 6G framework. Operating through working groups (RAN, SA, CT), it produces Releases that introduce new radio access technologies, core network architectures, and service-layer capabilities. 3GPP specifications are the foundational technical substrate for the global cellular infrastructure serving billions of devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spectrum-allocation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radio-access-network ],
        ngm:standards-body ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:digital-twin,
        ngm:spatial-computing ;
    vc:enables ngm:internet-of-things,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization,
        ngm:network-slicing,
        ngm:vehicle-to-everything ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:5g-core-network,
        ngm:5g-new-radio,
        ngm:radio-access-network ;
    vc:implements ngm:5-g-connectivity,
        ngm:5-g-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:etsi,
        ngm:ieee,
        ngm:itu-r,
        ngm:network-architecture,
        ngm:telecommunications ;
    vc:requires ngm:spectrum-allocation ;
    vc:slug "3-gpp" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:low-latency .

ngm:5-g a owl:Class ;
    rdfs:label "5G"@en ;
    rdfs:comment "5G (Fifth Generation) is the latest generation of mobile cellular network technology, standardised by 3GPP from Release 15 onwards, characterised by peak data rates exceeding 20 Gbps, radio latencies below 1 ms, and support for up to one million connected devices per square kilometre. It introduces three primary use-case families: enhanced mobile broadband (eMBB), ultra-reliable low-latency communications (URLLC), and massive machine-type communications (mMTC). 5G underpins advances in spatial computing, autonomous vehicles, industrial automation, and IoT at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-oriented-architecture ],
        ngm:telecommunications ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:4g-lte,
        ngm:6g ;
    vc:enables ngm:5-g-connectivity,
        ngm:autonomous-vehicle,
        ngm:industrial-io-t,
        ngm:multi-access-edge-computing,
        ngm:network-slicing,
        ngm:private-5g-network,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:5g-core,
        ngm:5g-new-radio,
        ngm:service-oriented-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:5-g-network,
        ngm:internet-of-things,
        ngm:mobile-edge-computing ;
    vc:requires ngm:massive-mimo ;
    vc:slug "5-g" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:itu-r ;
    vc:uses ngm:beamforming,
        ngm:cloud-native,
        ngm:network-function-virtualization .

ngm:adversarial-testing a owl:Class ;
    rdfs:label "Adversarial Testing"@en ;
    rdfs:comment "A testing methodology that deliberately attempts to cause AI system failures through adversarial inputs, edge cases, and challenging scenarios in order to identify robustness issues, safety vulnerabilities, and alignment failures before deployment. It encompasses both explicitly adversarial prompts and implicitly problematic queries, drawing on red-teaming practices and formalised by NIST AI 100-2."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-model ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:cybersecurity,
        ngm:digital-twin ;
    vc:contrastsWith ngm:unit-testing ;
    vc:dependsOn ngm:benchmark-dataset,
        ngm:model-evaluation ;
    vc:enables ngm:bias-detection-methods ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:nist-ai-rmf,
        ngm:security-testing ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:adversarial-training,
        ngm:ai-governance,
        ngm:safety-evaluation ;
    vc:requires ngm:machine-learning-discipline-model,
        ngm:threat-model ;
    vc:slug "adversarial-testing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-safety,
        ngm:responsible-ai,
        ngm:robustness ;
    vc:uses ngm:adversarial-examples,
        ngm:prompt-injection,
        ngm:red-teaming .

ngm:adversarial-training a owl:Class ;
    rdfs:label "Adversarial Training"@en ;
    rdfs:comment "Adversarial training is a robustness technique that augments model training with adversarially perturbed examples generated to maximise the model's loss. By solving an inner maximisation that crafts worst-case inputs within a bounded perturbation set and an outer minimisation over model parameters, it teaches models to resist adversarial attacks. It improves robustness against perturbations at the cost of additional computation and sometimes reduced clean accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-augmentation ],
        ngm:model-training ;
    vc:enables ngm:robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-augmentation,
        ngm:gradient-descent ;
    vc:implements ngm:model-robustness ;
    vc:isPartOf ngm:model-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:generative-adversarial-network,
        ngm:overfitting,
        ngm:security ;
    vc:requires ngm:adversarial-attack,
        ngm:supervised-learning ;
    vc:slug "adversarial-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network .

ngm:agent-communication-language a owl:Class ;
    rdfs:label "Agent Communication Language"@en ;
    rdfs:comment "An Agent Communication Language (ACL) is a formal, standardised message format and semantics that lets autonomous software agents exchange information, requests and commitments independently of their internal implementation. ACLs define performatives (speech acts such as inform, request and propose), a content language and an ontology reference so that interacting agents share a common interpretation of messages. Established examples include FIPA-ACL and KQML."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-passing ],
        ngm:multi-agent-system ;
    vc:bridgesTo ngm:interoperability-protocol ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:message-passing ;
    vc:implements ngm:fipa ;
    vc:isPartOf ngm:multi-agent-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-integration,
        ngm:linked-data,
        ngm:network-protocol ;
    vc:requires ngm:ontology,
        ngm:semantic-interoperability ;
    vc:slug "agent-communication-language" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:fipa ;
    vc:supports ngm:decision-making ;
    vc:uses ngm:api .

ngm:ai-risk a owl:Class ;
    rdfs:label "AI Risk"@en ;
    rdfs:comment "The potential for AI systems to cause adverse effects on individuals, groups, organizations, communities, or society, arising from technical failures, security vulnerabilities, biased outcomes, privacy violations, or unintended consequences of system design, deployment, or operation. AI risks span from immediate operational failures to long-term catastrophic scenarios requiring proactive identification, assessment, and mitigation strategies."@en ;
