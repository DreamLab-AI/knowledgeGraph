ngm:virtual-world-platform a owl:Class ;
    rdfs:label "Virtual World Platform"@en ;
    rdfs:comment "A software ecosystem that enables users to create, explore, and interact within persistent 3D virtual environments. It encompasses both centralised platforms — such as Roblox (214 million monthly active users) and Fortnite — controlled by platform operators, and blockchain-based decentralised platforms — such as Decentraland and The Sandbox — where users hold genuine ownership of digital assets and participate in on-chain governance. The metaverse market hosting these platforms is valued at USD 103.6 billion and projected to reach USD 507.8 billion by 2030."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world-building ],
        ngm:digital-platform,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:social-vr,
        ngm:virtual-asset-trading,
        ngm:virtual-event ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:virtual-economy,
        ngm:virtual-world-building ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-platform,
        ngm:virtual-world-infrastructure ;
    vc:slug "virtual-world-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:vr-rendering-engine .

