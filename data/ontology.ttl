        ngm:signal-processing ;
    vc:uses ngm:matrix-factorisation .

ngm:anomaly-detection a owl:Class ;
    rdfs:label "Anomaly Detection"@en ;
    rdfs:comment "Anomaly detection is a machine learning and statistical discipline concerned with identifying observations, sequences, or structural patterns that deviate significantly from a learned or assumed norm, signalling potential faults, threats, or novel phenomena. It operates across three principal modes: point anomaly detection (a single observation is outlying relative to the full dataset), contextual anomaly detection (an observation is anomalous given its local context, such as a transaction at an unusual time of day), and collective anomaly detection (a subsequence or group of observations is jointly anomalous relative to expected behaviour). The field draws on statistical modelling, machine learning, and signal processing to serve applications ranging from fraud detection and network intrusion detection to industrial fault monitoring, medical diagnostics, and log analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        ngm:machine-learning-discipline ;
    vc:bridgesTo ngm:network-security,
        ngm:sensor-data ;
    vc:contrastsWith ngm:classification,
        ngm:supervised-learning ;
    vc:dependsOn ngm:data-preprocessing,
        ngm:feature-engineering ;
    vc:enables ngm:cybersecurity,
        ngm:fraud-detection,
        ngm:intrusion-detection-system,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collective-anomaly-detection,
        ngm:contextual-anomaly-detection,
        ngm:point-anomaly-detection ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:change-point-detection,
        ngm:concept-drift,
        ngm:model-monitoring,
        ngm:outlier-detection,
        ngm:time-series-forecasting ;
    vc:requires ngm:data-preprocessing,
        ngm:feature-engineering,
        ngm:statistical-modelling,
        ngm:threshold-calibration ;
    vc:slug "anomaly-detection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:autoencoder,
        ngm:deep-learning,
        ngm:graph-neural-networks,
        ngm:machine-learning-discipline,
        ngm:pattern-recognition,
        ngm:transformer-architecture .

ngm:ai-infrastructure a owl:Class ;
    rdfs:label "AI Infrastructure"@en ;
    rdfs:comment "AI Infrastructure is the integrated ensemble of hardware, software, data systems, and operational tooling required to develop, train, deploy, monitor, and govern artificial intelligence and machine learning workloads at scale. It spans physical compute resources such as GPU and TPU clusters, networking fabrics, and storage systems through to cloud-managed AI platforms, model-serving runtimes, data pipelines, and MLOps toolchains. Unlike general-purpose computing infrastructure, AI Infrastructure is specifically optimised for tensor operations, distributed parallel training, high-throughput vector data ingestion, and low-latency inference serving. It constitutes the production backbone that determines the cost, velocity, reliability, and scalability of AI system development cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
