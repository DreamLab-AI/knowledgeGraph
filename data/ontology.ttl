        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:inference-serving ;
    vc:dependsOn ngm:ai-model,
        ngm:ai-model-development ;
    vc:enables ngm:ai-inference,
        ngm:generative-ai,
