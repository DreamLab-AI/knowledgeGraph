ngm:interaction-control a owl:Class ;
    rdfs:label "Interaction Control"@en ;
    rdfs:comment "A robotics control paradigm that explicitly manages contact forces and compliant behaviour when a robot interacts with its environment or human collaborators. Interaction control encompasses impedance control, admittance control, and force control strategies that allow robots to operate safely during physical contact, adapting stiffness, damping, and inertia in response to sensed forces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impedance-control ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:force-control,
        ngm:impedance-control ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:motion-control,
        ngm:robot-safety ;
    vc:requires ngm:control-system,
        ngm:robot-sensor ;
    vc:slug "interaction-control" ;
    vc:sourceDomain "robotics" .

ngm:interactive-learning a owl:Class ;
    rdfs:label "Interactive Learning"@en ;
    rdfs:comment "A machine learning paradigm in which a model interactively queries a user, oracle, or environment to obtain labels or feedback for the most informative examples, iteratively improving performance while minimising annotation cost. Interactive learning encompasses active learning, online learning, and human-in-the-loop approaches that tighten the loop between model uncertainty and human input."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:human-in-the-loop-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:semi-supervised-learning ;
    vc:slug "interactive-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:active-learning,
        ngm:data-annotation .

ngm:interface-standards a owl:Class ;
    rdfs:label "Interface Standards"@en ;
    rdfs:comment "Technical specifications and protocols that define how metaverse components, systems, and services communicate and interoperate, encompassing XR device interfaces, data exchange formats, and cross-platform communication requirements."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:technical-standard ;
    vc:enables ngm:cross-platform-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "interface-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:international-financial-architecture a owl:Class ;
    rdfs:label "International Financial Architecture"@en ;
    rdfs:comment "The international financial architecture is the framework of institutions, rules, standards, and cooperative arrangements that govern cross-border finance, monetary relations, and the management of global financial stability. It comprises multilateral institutions such as the International Monetary Fund, standard-setting bodies including the Financial Stability Board and the Bank for International Settlements, and the conventions governing exchange rates, capital flows, and crisis resolution. Its purpose is to coordinate macroprudential policy, contain systemic risk, and provide mechanisms for surveillance, liquidity provision, and orderly adjustment across the global financial system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:financial-stability-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        ngm:financial-system ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:monetary-policy ;
    vc:dependsOn ngm:central-banking ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:financial-stability-board,
        ngm:imf ;
    vc:implements ngm:macroprudential-policy ;
    vc:isPartOf ngm:financial-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bank-for-international-settlements,
        ngm:financial-stability,
        ngm:systemic-risk ;
    vc:requires ngm:financial-regulation ;
    vc:slug "international-financial-architecture" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:cross-border-payments ;
    vc:uses ngm:financial-regulation,
        ngm:macroprudential-policy .

ngm:interoperability-standards a owl:Class ;
    rdfs:label "Interoperability Standards"@en ;
    rdfs:comment "Interoperability standards are formally agreed specifications — including data formats, interface definitions, communication protocols, and semantic models — that enable independently developed systems, networks, and platforms to exchange information and cooperate without bespoke integration work. They are produced by recognised standards bodies, industry consortia, or open working groups, and cover layers from physical connectivity through data serialisation to application-level semantics. Adoption is typically enforced through regulatory mandate, market pressure, or certification programmes. Effective interoperability standards reduce vendor lock-in, lower integration costs, and are foundational to distributed architectures including the web, decentralised identity, and cross-chain blockchain communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-body ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-specification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-format-standard ],
        ngm:standards ;
    vc:bridgesTo ngm:ai-model-interoperability,
        ngm:cross-chain-communication,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:proprietary-protocol,
        ngm:vendor-lock-in ;
    vc:enables ngm:data-exchange,
        ngm:federated-system,
        ngm:interoperability,
        ngm:open-ecosystem ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-specification,
        ngm:data-format-standard,
        ngm:standards-conformance-testing ;
    vc:implements ngm:communication-protocols,
        ngm:open-standards,
        ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:application-programming-interface,
        ngm:data-portability,
        ngm:middleware ;
    vc:requires ngm:governance,
        ngm:standards-body ;
    vc:slug "interoperability-standards" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:iso,
        ngm:w3-c ;
    vc:supports ngm:digital-identity,
        ngm:distributed-systems,
        ngm:network-protocol ;
    vc:uses ngm:ontology,
        ngm:schema-definition .

ngm:intersectional-fairness a owl:Class ;
    rdfs:label "Intersectional Fairness"@en ;
    rdfs:comment "Intersectional Fairness is an approach to algorithmic fairness that evaluates bias and discrimination across subgroups defined by combinations of multiple protected attributes—such as race, gender, age, and disability—recognising that individuals with intersecting marginalised identities may experience unique harms not captured by single-attribute analysis. Rooted in Crenshaw's (1989) intersectionality theory, it requires auditing model performance across all cross-attribute subgroup combinations, demanding both statistical rigour and sufficient sample sizes for rare intersectional groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:fairness-accuracy-tradeoffs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:disparate-impact,
        ngm:explainability,
        ngm:responsible-ai ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-metrics ;
    vc:slug "intersectional-fairness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-ethics,
        ngm:ai-governance ;
    vc:uses ngm:fairness-auditing-tools,
        ngm:fairness-constraints .

