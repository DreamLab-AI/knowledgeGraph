    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:linear-algebra ;
    vc:slug "linear" ;
    vc:sourceDomain "metaverse" .

ngm:link-preview a owl:Class ;
    rdfs:label "Link Preview"@en ;
    rdfs:comment "Link Preview is a web infrastructure technique that fetches and parses Open Graph metadata, title, description, and thumbnail from a target URL to generate a rich card preview for display in social feeds, chat applications, or note-taking tools. APIs and Python libraries such as linkpreview and URLMeta automate this extraction, enabling knowledge graphs and collaborative platforms to surface contextual summaries alongside raw hyperlinks."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:social-media,
        ngm:user-interface ;
    vc:slug "link-preview" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:semantic-web .

ngm:liquid-network a owl:Class ;
    rdfs:label "Liquid Network"@en ;
    rdfs:comment "The Liquid Network is a Bitcoin sidechain developed by Blockstream that provides faster settlement and confidential transactions for exchanges, traders and institutions. Bitcoin is moved onto the network by locking it on the main chain and issuing an equivalent pegged asset, Liquid Bitcoin, which can later be redeemed. The network is operated by a federation of functionaries who produce blocks and manage the peg, trading some decentralisation for performance and privacy features."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:blockchain-domain ;
    vc:enables ngm:asset-issuance,
        ngm:confidential-transactions ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin,
        ngm:federation ;
    vc:slug "liquid-network" ;
    vc:sourceDomain "liquid-network" .

ngm:list-of-agent-projects a owl:Class ;
    rdfs:label "List Of Agent Projects"@en ;
    rdfs:comment "A curated catalogue of open-source and commercial autonomous agent frameworks and projects, spanning general-purpose agents (AutoGPT, BabyAGI, CAMEL), coding agents (GPT Engineer, SWE-Agent), productivity agents, research agents, and DIY framework scaffolds (CrewAI, MetaGPT, AutoGen). The list provides practitioners with an entry point into the rapidly expanding agentic AI ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agentic-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agentic-ai,
        ngm:autonomous-agent ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:reinforcement-learning ;
    vc:slug "list-of-agent-projects" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models,
        ngm:tool-use .

ngm:litecoin a owl:Class ;
    rdfs:label "Litecoin"@en ;
    rdfs:comment "Litecoin is a peer-to-peer cryptocurrency created in 2011 by Charlie Lee as an early fork of the Bitcoin codebase. It was designed for faster confirmation, using a target block time of around 2.5 minutes, and it uses the Scrypt hashing algorithm for proof-of-work in place of Bitcoin's SHA-256. It is often described as a lighter complement to Bitcoin and has served as a testing ground for protocol changes such as Segregated Witness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:blockchain-domain ;
    vc:enables ngm:digital-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:proof-of-work,
        ngm:scrypt ;
    vc:slug "litecoin" ;
    vc:sourceDomain "litecoin" .

ngm:lnd a owl:Class ;
    rdfs:label "LND"@en ;
    rdfs:comment "The Lightning Network Daemon, a widely used implementation of a Bitcoin Lightning Network node that manages payment channels and routes off-chain payments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:lightning-network,
        ngm:payment-channel ;
    vc:slug "lnd" ;
    vc:sourceDomain "blockchain" .

ngm:lock-and-mint-mechanism a owl:Class ;
    rdfs:label "Lock and Mint Mechanism"@en ;
    rdfs:comment "Cross-chain asset transfer protocol where tokens are locked in a smart contract on the source chain and equivalent wrapped tokens are minted on the destination chain, maintaining a 1:1 backing ratio."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-oracle ],
        ngm:bc-network-component,
        ngm:de-fi-protocol ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cross-chain-bridge ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain-oracle ;
    vc:slug "lock-and-mint-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:log-seq-spring-thing a owl:Class ;
    rdfs:label "Log Seq Spring Thing"@en ;
    rdfs:comment "Log Seq Spring Thing is a project workstream and AI hacking initiative that connects Logseq-based knowledge graph authoring with VisionFlow, exploring how networked thought can be published, visualised, and extended through AI-assisted tooling. It serves as a bridge between personal knowledge management workflows and semantic web infrastructure."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management,
        ngm:linked-data,
        ngm:semantic-web ;
    vc:slug "log-seq-spring-thing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:m-t5 a owl:Class ;
    rdfs:label "mT5"@en ;
    rdfs:comment "mT5 (Multilingual T5) is a massively multilingual pre-trained text-to-text transformer model developed by Google Research, covering 101 languages through pre-training on the mC4 multilingual Common Crawl corpus. It extends the T5 architecture's unified text-to-text framework to multilingual settings, treating all NLP tasks as sequence-to-sequence problems. mT5 enables strong cross-lingual transfer and zero-shot performance on low-resource languages, making it a foundational model for multilingual NLP applications including translation, question answering, and information retrieval."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
