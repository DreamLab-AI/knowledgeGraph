        ngm:motion-model,
        ngm:odometry,
        ngm:sensor-model .

ngm:mobile-robot a owl:Class ;
    rdfs:label "Mobile Robot"@en ;
    rdfs:comment "A mobile robot is an autonomous or semi-autonomous electromechanical system equipped with a locomotion mechanism — wheels, tracks, legs, rotors, or thrusters — that enables it to navigate within or across physical environments without being fixed to a stationary base. Mobile robots integrate sensing, actuation, and computation to perceive their surroundings, plan feasible paths, and execute goal-directed motion, distinguishing them from fixed industrial manipulators. They span a wide spectrum of embodiments including ground vehicles (UGVs), aerial vehicles (UAVs/drones), underwater vehicles (AUVs), and legged walkers, unified by the capability to self-relocate in service of a task. Defined formally by ISO 8373:2021 as a robot able to travel under its own control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-suite ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simultaneous-localisation-and-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:locomotion ],
        ngm:robot ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:manipulator ;
    vc:dependsOn ngm:embedded-systems,
        ngm:localisation ;
    vc:enables ngm:autonomous-navigation,
        ngm:last-mile-delivery,
        ngm:search-and-rescue-robotics,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:locomotion,
        ngm:onboard-computer,
        ngm:power-supply,
        ngm:sensor-suite ;
    vc:isPartOf ngm:multi-robot-systems,
        ngm:robotics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:legged-robot,
        ngm:swarm-robotics,
        ngm:unmanned-aerial-vehicle ;
    vc:requires ngm:motion-planning,
        ngm:obstacle-avoidance,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-8373-2021 ;
    vc:uses ngm:computer-vision,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:robot-operating-system .

ngm:model-predictive-control a owl:Class ;
    rdfs:label "Model Predictive Control"@en ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced control strategy in which an explicit mathematical model of the controlled process is used to predict future system outputs over a receding finite-horizon window, and a constrained optimisation problem is solved at each control step to compute the optimal input sequence. Only the first element of the computed sequence is applied, after which the horizon shifts forward and the optimisation repeats with an updated state estimate, creating an implicit closed-loop feedback mechanism. MPC handles multi-input multi-output (MIMO) systems, hard inequality constraints on both states and inputs, and competing cost objectives within a single unified formulation, making it applicable across process control, autonomous vehicles, robotics, and energy management. Its ability to anticipate constraint violations before they occur distinguishes it fundamentally from classical reactive controllers such as PID."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cost-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-identification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        ngm:optimal-control ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-network ;
    vc:contrastsWith ngm:pid-control,
        ngm:state-space-control ;
    vc:dependsOn ngm:feedback-control,
        ngm:linear-algebra,
        ngm:quadratic-programming ;
    vc:enables ngm:autonomous-driving,
        ngm:energy-management,
        ngm:robot-control,
        ngm:trajectory-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cost-function,
        ngm:prediction-horizon,
        ngm:receding-horizon ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-planning,
        ngm:reinforcement-learning,
        ngm:whole-body-control ;
    vc:requires ngm:dynamic-model,
        ngm:optimisation,
        ngm:state-estimation,
        ngm:system-identification ;
    vc:slug "model-predictive-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:quadratic-programming,
        ngm:state-space-model .

ngm:neural-network-latent-space a owl:Class ;
    rdfs:label "Neural Network Latent Space"@en ;
    rdfs:comment "A neural network latent space is a continuous, lower-dimensional manifold that a neural network learns to construct from high-dimensional input data, representing the data's underlying generative factors as geometric relationships between points. Encoder networks compress inputs into latent vectors that capture semantically meaningful structure, while decoder networks reconstruct outputs from those vectors; the resulting geometry encodes similarity such that interpolation along geodesics yields semantically coherent transitions. Architectures including variational autoencoders, generative adversarial networks, and diffusion models exploit structured latent spaces to enable sampling, conditional generation, and disentangled attribute control through vector arithmetic operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dimensionality-reduction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encoder-decoder-architecture ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:scene-understanding ;
    vc:contrastsWith ngm:knowledge-representation,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:deep-neural-network,
        ngm:training-data ;
    vc:enables ngm:disentangled-representation,
        ngm:generative-ai,
        ngm:image-synthesis,
        ngm:style-transfer,
        ngm:text-to-image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder-network,
        ngm:encoder ;
    vc:implements ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:variational-autoencoders ;
    vc:isPartOf ngm:generative-model,
        ngm:representation-learning ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embedding,
        ngm:principal-component-analysis ;
    vc:requires ngm:dimensionality-reduction,
        ngm:encoder-decoder-architecture ;
    vc:slug "neural-network-latent-space" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:embedding-model,
        ngm:variational-inference .

ngm:orchestration a owl:Class ;
    rdfs:label "Orchestration"@en ;
    rdfs:comment "The automated coordination, scheduling, and lifecycle management of containerised workloads, microservices, and distributed agents across heterogeneous infrastructure. In the context of metaverse and telecollaboration systems, orchestration—exemplified by Kubernetes—ensures that compute-intensive rendering, AI inference, and real-time communication services scale elastically and recover automatically from failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scheduler ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:ai-inference,
        ngm:multi-agent-systems ;
    vc:dependsOn ngm:infrastructure-as-code,
        ngm:observability ;
    vc:enables ngm:auto-scaling,
        ngm:continuous-deployment,
        ngm:distributed-systems,
        ngm:fault-tolerance,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:control-plane,
        ngm:scheduler,
        ngm:service-mesh ;
    vc:isPartOf ngm:cloud-native ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:container,
        ngm:digital-infrastructure,
        ngm:networking ;
    vc:slug "orchestration" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:high-availability,
        ngm:latency ;
    vc:uses ngm:kubernetes,
        ngm:load-balancing .

ngm:procedural-generation a owl:Class ;
    rdfs:label "Procedural Generation"@en ;
    rdfs:comment "Procedural Generation is the algorithmic creation of digital content — including terrain, geometry, textures, vegetation, buildings, soundscapes, quests, and narrative elements — using mathematical functions, noise algorithms, grammars, and rule-based systems rather than entirely manual authoring. It enables scalable world-building by deriving arbitrarily large, varied outputs from compact parametric seeds, making it foundational to games, simulation, virtual environments, and generative design workflows. Modern procedural generation incorporates machine-learning-guided heuristics alongside classical stochastic sampling, bridging traditional algorithmic design with contemporary AI-driven content synthesis. The technique trades artist-authoring effort for computational cost while preserving statistical variety and stylistic coherence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voronoi-diagram ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:generative-ai,
        ngm:latent-diffusion,
        ngm:style-transfer ;
    vc:enables ngm:procedural-terrain,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:noise-function,
        ngm:voronoi-diagram,
        ngm:wave-function-collapse ;
    vc:implements ngm:parametric-design-methodology,
        ngm:stochastic-modelling ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computational-creativity,
        ngm:content-creation,
        ngm:generative-design,
        ngm:metaverse-content-pipeline ;
    vc:requires ngm:game-engine,
        ngm:rendering-pipeline ;
    vc:slug "procedural-generation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:open-world-game,
        ngm:simulation,
        ngm:virtual-world ;
    vc:uses ngm:3-d-content-generation,
        ngm:noise-function-library,
        ngm:spatial-index .

ngm:reward-function a owl:Class ;
    rdfs:label "Reward Function"@en ;
    rdfs:comment "A mathematical formulation in reinforcement learning that maps state-action pairs to scalar values, guiding AI agent behaviour toward desired outcomes through feedback signals; central to policy optimisation, agent training, and objective specification in machine learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-signal ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:action-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environment-model ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:reinforcement-learning,
        ngm:robotics ;
    vc:contrastsWith ngm:heuristic-function,
