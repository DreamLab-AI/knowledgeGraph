        ngm:monetary-sovereignty ;
    vc:slug "monetary-policy-implementation" ;
    vc:sourceDomain "economics" ;
    vc:uses ngm:cbdc-frameworks,
        ngm:payment-system,
        ngm:stablecoin .

ngm:network-synchronization a owl:Class ;
    rdfs:label "Network Synchronization"@en ;
    rdfs:comment "Network Synchronization is the process by which blockchain nodes align their local chain state with the canonical ledger through block propagation, header-first sync, and fork resolution protocols. It governs initial block download, peer discovery, and the ongoing receipt of new blocks and transactions via gossip, ensuring all honest participants converge on an identical view of the distributed ledger despite network partitions and latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:distributed-data-structure,
        ngm:eclipse-attack,
        ngm:network-topology,
        ngm:transaction-pool ;
    vc:requires ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "network-synchronization" ;
    vc:sourceDomain "blockchain" .

ngm:nominated-proof-of-stake a owl:Class ;
    rdfs:label "Nominated Proof of Stake"@en ;
    rdfs:comment "Nominated Proof of Stake (NPoS) is a consensus mechanism variant in which token holders nominate a set of validator candidates; an election algorithm selects the active validator set to maximise stake distribution while satisfying security constraints. Elected validators produce and finalise blocks, while nominators share both block rewards and slashing penalties, aligning incentives across the broader token holder community."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:pure-proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:blockchain-governance,
        ngm:deterministic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:polkadot-parachains ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "nominated-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm .

ngm:north-england-innovation-corridor a owl:Class ;
    rdfs:label "North England Innovation Corridor"@en ;
    rdfs:comment "The collaborative technology and innovation ecosystem spanning Manchester, Leeds, Liverpool, Sheffield, and Newcastle that constitutes the Northern Powerhouse. The corridor links world-class research universities, NHS trusts, advanced manufacturing facilities, and digital startups through coordinated investment, shared infrastructure, and regional development frameworks aimed at closing the productivity gap between North and South England."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manchester-tech-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liverpool-smart-cities ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leeds-digital-hub ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:newcastle-ai-and-health-innovation ],
        [ a owl:Restriction ;
