ngm:quantum-computation-paradigm a owl:Class ;
    rdfs:label "Quantum Computation Paradigm"@en ;
    rdfs:comment "A paradigm of computation that exploits quantum-mechanical phenomena—superposition, entanglement, and interference—to perform certain calculations exponentially faster than classical computers. Quantum computing holds particular relevance for cryptography, optimisation, simulation of molecular systems, and potentially accelerating machine learning workloads, though near-term devices remain limited by qubit decoherence and error rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-error-correction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantum-error-correction ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain ;
    vc:contrastsWith ngm:classical-computing,
        ngm:cryptography ;
    vc:dependsOn ngm:quantum-mechanics,
        ngm:superconductivity ;
    vc:enables ngm:combinatorial-optimisation,
        ngm:encryption,
        ngm:quantum-key-distribution,
        ngm:scientific-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:quantum-circuit,
        ngm:quantum-error-correction,
        ngm:quantum-gate,
        ngm:qubit ;
    vc:implements ngm:grovers-algorithm,
        ngm:shors-algorithm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:distributed-systems,
        ngm:machine-learning-discipline ;
    vc:requires ngm:quantum-error-correction ;
    vc:slug "quantum-computation-paradigm" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:post-quantum-cryptography,
        ngm:quantum-machine-learning .

ngm:rlhf a owl:Class ;
    rdfs:label "RLHF"@en ;
    rdfs:comment "Reinforcement Learning from Human Feedback (RLHF) is a training methodology that aligns large language models and other AI systems with human preferences by first collecting human comparison judgements between model outputs, training a reward model on those judgements, and then optimising the language model policy against the reward model using reinforcement learning — typically Proximal Policy Optimisation with a KL-divergence penalty to prevent reward hacking. RLHF enables models to be steered towards outputs that human annotators prefer for helpfulness, harmlessness, and honesty, going beyond what is achievable with supervised fine-tuning on static demonstration data alone. The technique was popularised by OpenAI's InstructGPT work and underlies the alignment pipeline of models such as ChatGPT, Claude, and Gemini. Variants including Direct Preference Optimisation, Constitutional AI, and RLAIF (Reinforcement Learning from AI Feedback) extend or simplify the original three-stage pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximal-policy-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        ngm:ai-alignment ;
    vc:bridgesTo ngm:crowdsourcing,
        ngm:data-annotation,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:direct-preference-optimisation,
        ngm:supervised-fine-tuning ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:harmlessness,
        ngm:instruction-following ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai-training-methodology,
        ngm:instruct-gpt,
        ngm:policy-gradient-methods,
        ngm:reward-hacking ;
    vc:requires ngm:human-feedback,
        ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning,
        ngm:reward-model,
        ngm:supervised-fine-tuning ;
    vc:slug "rlhf" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-annotation,
        ngm:kl-divergence,
        ngm:large-language-model,
        ngm:preference-data .

ngm:robot-dynamics a owl:Class ;
    rdfs:label "Robot Dynamics"@en ;
    rdfs:comment "Robot Dynamics is the branch of classical and computational mechanics that characterises the forces, torques, inertias, and energy flows governing the motion of robotic mechanisms. It distinguishes between forward dynamics—determining joint accelerations and Cartesian trajectories from applied actuator forces and torques—and inverse dynamics—computing the actuator effort required to produce a prescribed motion trajectory. The discipline provides the theoretical foundation for model-based control laws (such as computed-torque and feedback-linearisation controllers), physics-based simulation, and the design of energy-efficient manipulators and legged robots. Accurate dynamic models are indispensable for high-speed manipulation, safe human-robot collaboration, compliant actuation, and whole-body control of mobile robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inertia-tensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:newton-euler-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:digital-twin,
