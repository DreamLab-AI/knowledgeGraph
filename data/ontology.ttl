vf:verifiable-credential-surface a owl:Class ;
    rdfs:label "Verifiable Credential Surface"@en ;
    rdfs:comment "A standardised [[JSON-LD 1.1]] surface (S3) for issuing and storing [[W3C Verifiable Credentials 2.0|W3C VC 2.0]] credentials signed by agents' [[DID Nostr Identity|did:nostr]] DIDs using [[Schnorr Signature|Schnorr signatures]] over [[JCS Canonicalisation|JCS-canonicalised]] payloads, enabling verifiable attestations of agent capabilities, work completions, and claims that are independently auditable without central authorities."@en ;
    rdfs:subClassOf vf:blockchain ;
    vc:authorityScore "0.94"^^xsd:float ;
    vc:enables <urn:visionflow:linked:blockchain-verification>,
        <urn:visionflow:linked:capability-attestation>,
        <urn:visionflow:linked:decentralised-trust>,
        <urn:visionflow:linked:verifiable-claims>,
        <urn:visionflow:linked:work-completion-proof> ;
    vc:hasPart <urn:visionflow:linked:credential-indexing>,
        <urn:visionflow:linked:credential-issuance>,
        <urn:visionflow:linked:credential-verification>,
        <urn:visionflow:linked:jcs-canonicalisation>,
        <urn:visionflow:linked:schnorr-proof> ;
    vc:implements <urn:visionflow:linked:rfc-8785-canonical-json>,
        <urn:visionflow:linked:w3-c-proof-types>,
        <urn:visionflow:linked:w3-c-verifiable-credentials-2-0> ;
    vc:maturity "established" ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:requires <urn:visionflow:linked:did-resolution>,
        <urn:visionflow:linked:json-ld-1-1>,
        <urn:visionflow:linked:schnorr-signatures>,
        <urn:visionflow:linked:sha-256-hashing>,
        <urn:visionflow:linked:w3-c-vc-2-0-standard> ;
    vc:slug "verifiable-credential-surface" ;
    vc:sourceDomain "blockchain" .

