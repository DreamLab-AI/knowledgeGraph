    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:collision-detection,
        ngm:physically-based-rendering ;
    vc:uses ngm:physics-simulation,
        ngm:rigid-body-dynamics .

ngm:polar-robot a owl:Class ;
    rdfs:label "Polar Robot"@en ;
    rdfs:comment "A Polar Robot (also called a spherical robot) is an industrial robot configuration with a rotary base joint that provides 360-degree horizontal rotation, an elevated rotary shoulder joint that tilts the arm up and down, and a linear telescoping arm that extends and retracts radially—producing a spherical working envelope defined in spherical coordinates (radius, polar angle, azimuth). This geometry provides a large workspace volume relative to the physical footprint of the arm and was historically common in early industrial automation for tasks such as die casting and forging, though articulated arm designs have largely supplanted it in modern applications due to superior dexterity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        ngm:industrial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:collaborative-systems-modality-robot ;
    vc:dependsOn ngm:robot-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:robot-actuator,
        ngm:robot-joint ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cylindrical-robot,
        ngm:delta-robot,
        ngm:robot-hardware,
        ngm:scara-robot ;
    vc:slug "polar-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-kinematics .

ngm:policy-update-magnitude a owl:Class ;
    rdfs:label "Policy Update Magnitude"@en ;
    rdfs:comment "Policy Update Magnitude is a measure of how much a reinforcement learning agent's policy changes between successive gradient update steps, typically quantified as the KL divergence between the old and new policy distributions or as the Euclidean norm of the parameter change vector. Controlling this magnitude is essential to training stability: excessively large updates can cause catastrophic performance collapse, whilst excessively small updates slow convergence. Algorithms such as Proximal Policy Optimisation (PPO) and Trust Region Policy Optimisation (TRPO) impose explicit constraints on policy update magnitude to balance exploration, exploitation, and stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:reinforcement-learning ;
    vc:enables ngm:reinforcement-learning-from-human-feedback ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:reinforcement-learning-algorithm ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:loss-function,
        ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning-algorithm,
        ngm:reward-function ;
    vc:requires ngm:gradient-descent,
        ngm:reinforcement-learning ;
    vc:slug "policy-update-magnitude" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-clipping,
        ngm:learning-rate-schedule .

ngm:pool-share a owl:Class ;
    rdfs:label "Pool Share"@en ;
    rdfs:comment "A proof-of-work unit submitted by an individual miner to a mining pool server demonstrating that the miner performed a bounded amount of computational work toward finding a valid block hash. Pool shares have a lower difficulty target than the network block target, allowing the pool to credit each contributor proportional work units and distribute block rewards fairly, regardless of which specific miner finds the winning nonce."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:mining-reward ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:mining,
        ngm:mining-pool ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-protocol,
        ngm:cryptocurrency ;
    vc:requires ngm:consensus-mechanism,
        ngm:proof-of-work ;
    vc:slug "pool-share" ;
    vc:sourceDomain "blockchain" .

ngm:portable-document-format-standard a owl:Class ;
    rdfs:label "Portable Document Format Standard"@en ;
    rdfs:comment "Portable Document Format: an ISO-standardised file format (ISO 32000) that encodes documents with fixed layout, fonts, graphics, and metadata in a device-independent, platform-agnostic representation. In AI and knowledge-graph contexts, PDFs serve as primary carriers of academic papers, technical specifications, and legal documents that are ingested via extraction pipelines for training, retrieval-augmented generation, and knowledge-base construction."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-base,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:natural-language-processing ;
    vc:slug "portable-document-format-standard" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:documentation-standards,
        ngm:knowledge-management .

ngm:postquantum-cryptography a owl:Class ;
    rdfs:label "Postquantum Cryptography"@en ;
    rdfs:comment "Postquantum Cryptography (PQC) is the class of cryptographic algorithms designed to remain secure against adversaries equipped with large-scale quantum computers, replacing public-key schemes such as RSA and elliptic-curve cryptography that are broken by Shor's algorithm. PQC families include lattice-based, hash-based, code-based, and isogeny-based constructions, several of which NIST standardised in 2024 (e.g. CRYSTALS-Kyber, CRYSTALS-Dilithium)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:contrastsWith ngm:asymmetric-encryption,
        ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography ;
    vc:enables ngm:censorship-resistance,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-application,
        ngm:digital-signature-verification,
        ngm:quantum-computation-paradigm,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:cryptographic-key-management ;
    vc:slug "postquantum-cryptography" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cyber-security-and-cryptography,
        ngm:cybersecurity-standard ;
