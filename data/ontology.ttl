    vc:slug "patent" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:compliance-framework,
        ngm:conformity-assessment .

ngm:pay-pal a owl:Class ;
    rdfs:label "PayPal"@en ;
    rdfs:comment "PayPal is a multinational financial technology company that operates one of the world's largest online payment platforms, enabling consumers and merchants to send, receive, and hold funds across more than 200 markets. Founded in 1998 and spun off from eBay in 2015, it provides digital wallets, payment processing infrastructure, buy-now-pay-later credit products, and cryptocurrency custody services. PayPal's two-sided network connects hundreds of millions of consumer accounts to tens of millions of merchant integrations, making it a foundational layer of global e-commerce payments. In 2023 the company launched PayPal USD (PYUSD), a regulated US dollar stablecoin issued on public blockchains, extending its reach into programmable money and digital asset settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        ngm:payment-network ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:apple-pay,
        ngm:square,
        ngm:stripe ;
    vc:dependsOn ngm:banking-infrastructure,
        ngm:card-network ;
    vc:enables ngm:cross-border-payment,
        ngm:digital-asset,
        ngm:merchant-services,
        ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:buy-now-pay-later,
        ngm:digital-wallet,
        ngm:payment-processing,
        ngm:venmo ;
    vc:isPartOf ngm:e-commerce,
        ngm:fintech ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-currency,
        ngm:remittance ;
    vc:requires ngm:anti-money-laundering,
        ngm:identity-verification,
        ngm:payment-network ;
    vc:slug "pay-pal" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-regulation,
        ngm:pci-dss ;
    vc:supports ngm:open-banking,
        ngm:stablecoin ;
    vc:uses ngm:fraud-detection,
        ngm:machine-learning,
        ngm:tokenisation .

ngm:pegasus a owl:Class ;
    rdfs:label "PEGASUS"@en ;
