    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:CryptographicSignature
] .

blockchain:ByzantineFaultTolerance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:MessageAuthentication
] .

blockchain:ByzantineFaultTolerance rdfs:subClassOf [
