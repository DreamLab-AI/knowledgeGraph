ngm:semantic-segmentation a owl:Class ;
    rdfs:label "Semantic Segmentation"@en ;
    rdfs:comment "Semantic Segmentation is the computer vision task of assigning a class label to every pixel in an image, partitioning the image into semantically meaningful regions without distinguishing between individual object instances. Architectures such as FCN, U-Net, and DeepLab produce dense pixel-wise predictions enabling scene understanding in autonomous driving, medical imaging, and satellite analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder-decoder-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
