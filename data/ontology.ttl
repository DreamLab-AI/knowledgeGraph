ngm:decentralized-key-storage a owl:Class ;
    rdfs:comment "Decentralized key storage is the practice of distributing a cryptographic key across multiple independent holders or locations so that no single party ever possesses the whole key, and no single point of compromise or failure can expose or destroy it. Typically realised with Shamir secret sharing or threshold cryptography, the key is split into shares such that a defined quorum reconstructs or jointly uses it while any smaller subset reveals nothing. This is distinct from decentralised data storage — which spreads arbitrary files across a network such as IPFS — because the object being protected is the secret itself and the security goal is quorum-controlled reconstruction rather than content availability."@en ;
    rdfs:label "Decentralized Key Storage"@en ;
    rdfs:subClassOf ngm:key-management ;
    rdfs:subClassOf _:r7451 ;
    vc:contrastsWith ngm:decentralized-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:requires ngm:cryptographic-key ;
    vc:slug "decentralized-key-storage" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:shamir-secret-sharing ;
    vc:uses ngm:threshold-cryptography .
ngm:decentralized-ownership a skos:Concept ;
    rdfs:label "Decentralized Ownership"@en .
ngm:decentralized-storage a owl:Class ;
    rdfs:comment "A distributed storage infrastructure that distributes data across peer-to-peer networks rather than centralised data centres, enabling data persistence, redundancy, and access without single points of failure, often incentivised by cryptographic token mechanisms."@en ;
    rdfs:label "Decentralized Storage"@en ;
    rdfs:subClassOf ngm:data-management ;
