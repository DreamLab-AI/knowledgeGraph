ngm:dwpose a owl:Class ;
    rdfs:label "DWPose"@en ;
    rdfs:comment "DWPose is a whole-body 2D human pose estimation model developed by IDEA-Research that detects 133 keypoints spanning body, hands, face, and feet using a two-stage teacher-student knowledge distillation scheme. Its skeletal conditioning maps are widely used to drive spatial-conditioning systems such as ControlNet in diffusion-based image and video generation pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:keypoint-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        ngm:computer-vision,
        ngm:pose-estimation ;
    vc:enables ngm:action-recognition,
        ngm:character-animation,
        ngm:control-net-and-similar-spatial-conditioning-systems,
        ngm:gesture-recognition,
        ngm:image-generation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:human-body-model,
        ngm:keypoint-detection,
        ngm:knowledge-distillation,
        ngm:skeleton-map ;
    vc:implements ngm:computer-vision,
        ngm:knowledge-distillation,
        ngm:pose-estimation ;
    vc:qualityScore "0.9"^^xsd:float ;
