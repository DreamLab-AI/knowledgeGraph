ngm:decentralised-application a owl:Class ;
    rdfs:label "Decentralised Application"@en ;
    rdfs:comment "A decentralised application (dApp) is software whose backend logic runs on a decentralised peer-to-peer network, typically as smart contracts on a blockchain, rather than on centrally controlled servers. It combines on-chain contracts for trustless state and logic with off-chain front ends and storage. dApps are a defining component of Web3, enabling permissionless, censorship-resistant services such as exchanges, lending and marketplaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:distributed-system ;
    vc:bridgesTo ngm:digital-governance,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:centralised-application ;
    vc:dependsOn ngm:decentralised-storage,
        ngm:peer-to-peer-network,
        ngm:token-standard ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance,
        ngm:non-fungible-token,
        ngm:permissionless-access ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:frontend-interface,
        ngm:smart-contract,
        ngm:wallet-integration ;
    vc:implements ngm:open-source-software,
        ngm:web3-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance,
        ngm:token-economy,
        ngm:web3 ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:cryptocurrency-wallet ;
    vc:slug "decentralised-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum,
        ngm:ipfs,
        ngm:oracle .

ngm:erc-1155 a owl:Class ;
    rdfs:label "ERC-1155"@en ;
    rdfs:comment "ERC-1155 is an Ethereum multi-token standard (formalised as EIP-1155) that enables a single smart contract to manage an arbitrary number of token types — fungible, non-fungible, and semi-fungible — each identified by a uint256 token ID with per-address per-ID balance tracking. Pioneered by Witek Radomski of Enjin in 2018, it introduced safeBatchTransferFrom for atomic multi-token transfers in a single transaction, significantly reducing gas costs relative to deploying separate ERC-20 or ERC-721 contracts for each asset type. The standard's onERC1155Received and onERC1155BatchReceived hooks enforce safe-transfer guarantees on receiver contracts, preventing tokens from being permanently locked. It is widely adopted across blockchain gaming, NFT marketplaces, and on-chain economies requiring a mixture of consumable items and unique collectibles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        ngm:token-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:erc-20,
        ngm:erc-4626,
        ngm:erc-721 ;
    vc:enables ngm:blockchain-gaming,
        ngm:decentralised-finance,
        ngm:digital-asset-marketplace,
        ngm:nft,
        ngm:semi-fungible-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-1155,
        ngm:ethereum-improvement-proposal ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:account-abstraction,
        ngm:opensea,
        ngm:openzeppelin,
        ngm:token-metadata-uri ;
    vc:requires ngm:ethereum,
        ngm:gas-fee,
        ngm:solidity ;
    vc:slug "erc-1155" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-foundation ;
    vc:uses ngm:batch-processing,
        ngm:ethereum-virtual-machine,
        ngm:ipfs,
        ngm:smart-contract .

ngm:iso-iec-42001 a owl:Class ;
    rdfs:label "ISO IEC 42001"@en ;
    rdfs:comment "ISO/IEC 42001:2023 is the first international management system standard specifically designed for artificial intelligence, published by ISO/IEC Joint Technical Committee 1, Subcommittee 42, establishing requirements for an AI Management System (AIMS) that organisations use to responsibly develop, provide, or use AI-based products and services. It follows the Annex SL high-level structure shared with ISO 9001 and ISO 27001, enabling seamless integration with existing management frameworks through a Plan-Do-Check-Act cycle covering context, leadership, planning, support, operation, performance evaluation, and improvement. The normative Annex A provides a reference control set addressing data governance, transparency, human oversight, algorithmic accountability, and AI supply-chain management, from which organisations select controls according to their risk profile. Certification by accredited third-party audit bodies offers independent assurance of AI governance maturity and serves as a documented compliance aid for regulations such as the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:eu-ai-act,
        ngm:nist-ai-rmf ;
    vc:contrastsWith ngm:ieee-7000,
        ngm:iso-iec-23894 ;
    vc:enables ngm:ai-supply-chain-management,
        ngm:continuous-improvement,
        ngm:third-party-audit ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-management-system,
        ngm:plan-do-check-act ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:compliance-framework,
        ngm:iso-9001,
        ngm:iso-iec-27001,
        ngm:iso-iec-27701 ;
    vc:requires ngm:ai-system-impact-assessment,
        ngm:data-governance,
        ngm:human-oversight ;
    vc:slug "iso-iec-42001" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ai-governance-framework,
        ngm:iso-iec-jtc1-sc42 ;
    vc:supports ngm:ai-risk-management,
        ngm:algorithmic-accountability,
        ngm:responsible-ai,
        ngm:transparency .

ngm:json-data-interchange-format-ld a owl:Class ;
    rdfs:label "JSON-LD"@en ;
    rdfs:comment "JSON-LD (JSON for Linking Data) is a W3C Recommendation (first published 2014, revised 1.1 in 2020) that defines a lightweight Linked Data serialisation syntax layered on top of JSON. A @context document maps compact JSON keys to full RDF IRIs, enabling any conformant JSON document to be interpreted as an RDF graph without abandoning existing JSON tooling. JSON-LD is the canonical syntax for W3C Verifiable Credentials, Schema.org structured data embedded in HTML, and the ActivityPub social protocol, making it the most widely deployed Linked Data technology on the open web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format ],
        ngm:linked-data ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:search-engine-optimisation ;
    vc:contrastsWith ngm:json-data-interchange-format-schema,
        ngm:rdf-xml,
        ngm:turtle ;
    vc:enables ngm:data-integrity,
