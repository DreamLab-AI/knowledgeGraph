ngm:supply-chain-risk-management a owl:Class ;
    rdfs:comment "Supply chain risk management is the systematic identification, assessment, mitigation, and monitoring of risks that arise from an organisation's network of suppliers, vendors, and logistics dependencies. It addresses disruption, quality, financial, geopolitical, cyber, and integrity risks across multiple tiers of suppliers, including the software supply chain. Practitioners apply frameworks such as the NIST risk management approach, conduct vendor due diligence, and use artefacts like the software bill of materials to gain visibility. The goal is resilient, continuous operation in the face of upstream uncertainty and threats."@en ;
    rdfs:label "Supply Chain Risk Management"@en ;
    rdfs:subClassOf ngm:risk-management-framework ;
    rdfs:subClassOf _:r20218 ;
    rdfs:subClassOf _:r20219 ;
    rdfs:subClassOf _:r20220 ;
    rdfs:subClassOf _:r20221 ;
