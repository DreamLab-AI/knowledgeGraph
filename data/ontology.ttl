ngm:rb-0030-jacobian-matrix a owl:Class ;
    rdfs:label "rb 0030 jacobian matrix"@en ;
    rdfs:comment "The Jacobian matrix is a mathematical mapping that relates joint-space velocities to Cartesian end-effector velocities for a robotic manipulator. It is central to differential kinematics, velocity control, force-torque transformation, and singularity analysis; its pseudo-inverse enables computation of joint velocities from desired Cartesian motions in inverse kinematics."@en ;
    rdfs:subClassOf ngm:kinematics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0053-force-control,
        ngm:rb-0060-optimal-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0028-forward-kinematics,
        ngm:rb-0029-inverse-kinematics,
        ngm:rb-0031-singularity,
        ngm:rb-0032-manipulability ;
    vc:slug "rb-0030-jacobian-matrix" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0021-robot-kinematics,
        ngm:rb-0023-degrees-of-freedom .

ngm:rb-0067-force-torque-sensor a owl:Class ;
    rdfs:label "rb 0067 force torque sensor"@en ;
    rdfs:comment "A force-torque sensor (FT sensor) is a transducer mounted at a robot's wrist or tool centre point that simultaneously measures all six components of mechanical load: three orthogonal forces (Fx, Fy, Fz) and three orthogonal torques (Tx, Ty, Tz). These measurements enable the robot controller to monitor contact forces in real time, supporting force-controlled assembly, surface-following tasks, human-robot contact detection, and safety-critical power-and-force limiting under ISO/TS 15066. FT sensors are the primary feedback device for impedance and admittance control strategies."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:force-torque-sensor ;
    vc:enables ngm:rb-0053-force-control,
        ngm:rb-0056-impedance-control,
        ngm:rb-0057-admittance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:rb-0070-tactile-sensing,
        ngm:rb-0094-power-and-force-limiting ;
    vc:slug "rb-0067-force-torque-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:cobot-safety-levels,
        ngm:rb-0066-robot-sensor .

ngm:rb-0072-encoder a owl:Class ;
    rdfs:label "rb 0072 encoder"@en ;
    rdfs:comment "An encoder in robotics is a proprioceptive transducer that converts the angular or linear position of a joint or actuator shaft into a digital electrical signal, providing the position and velocity feedback essential for closed-loop control. Encoders are categorised as incremental (providing relative position pulses) or absolute (outputting a unique code for each position), with absolute rotary encoders being preferred in safety-critical collaborative robot applications due to their power-loss resilience. High-resolution encoders directly determine robot accuracy, repeatability, and the fidelity of safety functions such as speed limitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        ngm:proprioceptive-sensor,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rotary-encoder ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:slug "rb-0072-encoder" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0047-feedback-control,
        ngm:rb-0054-position-control,
        ngm:rb-0093-speed-limitation ;
    vc:uses ngm:rb-0066-robot-sensor .

ngm:regulatory-frameworks a owl:Class ;
    rdfs:label "Regulatory Frameworks"@en ;
    rdfs:comment "Regulatory frameworks are structured, hierarchical systems comprising primary legislation, secondary rules, supervisory authorities, and enforcement mechanisms that collectively govern conduct within a defined sector or jurisdiction. They establish who is subject to regulation, what obligations and prohibitions apply, how compliance is monitored, and what sanctions are available for breach. Frameworks may be rules-based, principles-based, or risk-based in design, and typically span multiple tiers from international treaties and standards through to national law and sector-specific codes of practice. Modern frameworks increasingly address cross-border, technology-mediated activities, creating interoperability requirements between national and supranational regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-requirements ],
        ngm:regulation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:data-protection,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:co-regulation,
        ngm:self-regulation ;
    vc:dependsOn ngm:legal-system,
        ngm:standards ;
    vc:enables ngm:accountability,
        ngm:consumer-protection,
        ngm:market-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-obligations,
        ngm:enforcement-mechanisms,
        ngm:regulatory-requirements,
        ngm:supervisory-authority ;
    vc:implements ngm:international-agreements,
        ngm:policy ;
    vc:isPartOf ngm:governance,
        ngm:policy-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:risk-management,
        ngm:transparency ;
    vc:requires ngm:compliance,
        ngm:data-governance,
        ngm:risk-assessment ;
    vc:slug "regulatory-frameworks" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-standards,
        ngm:oecd-guidelines ;
    vc:supports ngm:interoperability,
        ngm:trust .

ngm:relayer a owl:Class ;
    rdfs:label "Relayer"@en ;
    rdfs:comment "Infrastructure operator that facilitates cross-chain message passing by monitoring source chains for events, generating cryptographic proofs of state, and submitting verified transactions to destination chains."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-interoperability ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:message-passing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "relayer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:light-client .

ngm:remote-work a owl:Class ;
    rdfs:label "Remote Work"@en ;
    rdfs:comment "Remote work is a work arrangement in which employees perform their professional duties from locations outside the traditional employer premises — including home offices, co-working spaces, or while travelling — using digital communication, collaboration, and productivity tools to maintain output and team cohesion. It encompasses fully remote models, hybrid arrangements that blend in-office and remote days, and asynchronous-first organisational cultures that decouple productive work from synchronous physical presence. The practice spans individual contributor roles through entire distributed organisations and intersects deeply with workforce management, digital infrastructure provisioning, cybersecurity policy, and organisational design. Remote work has become a core dimension of modern knowledge-work governance, influencing talent acquisition geographically, commercial real estate demand, and the architecture of digital workplace platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:distributed-work ;
    vc:bridgesTo ngm:ai-meeting-assistant,
        ngm:virtual-reality-workspace,
        ngm:zero-trust-security ;
    vc:contrastsWith ngm:collocated-work,
        ngm:open-plan-office ;
    vc:dependsOn ngm:broadband-internet,
        ngm:cloud-storage,
        ngm:project-management-software ;
    vc:enables ngm:asynchronous-collaboration,
        ngm:distributed-collaboration,
        ngm:global-talent-acquisition,
        ngm:work-life-integration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-team-collaboration,
        ngm:hybrid-work,
        ngm:knowledge-management,
        ngm:organisational-design,
        ngm:remote-collaboration,
        ngm:telecollaboration,
        ngm:workforce-management ;
    vc:requires ngm:digital-communication-infrastructure,
        ngm:endpoint-security,
        ngm:identity-and-access-management ;
    vc:slug "remote-work" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:asynchronous-communication,
        ngm:cloud-computing,
        ngm:collaboration-platform,
        ngm:digital-workplace-platform,
        ngm:video-conferencing,
        ngm:virtual-private-network .

ngm:rfid a owl:Class ;
    rdfs:label "RFID"@en ;
    rdfs:comment "Radio-Frequency Identification (RFID) is a wireless technology that uses electromagnetic fields to automatically identify and track tags attached to objects. Tags contain electronically stored information and can be read without requiring line of sight, enabling automated data capture across distances from a few centimetres to several metres."@en ;
    rdfs:subClassOf ngm:communication-network ;
    vc:bridgesTo ngm:blockchain-provenance,
        ngm:smart-contract ;
    vc:contrastsWith ngm:barcode,
        ngm:qr-code ;
    vc:enables ngm:asset-tracking,
        ngm:food-safety,
        ngm:inventory-management,
        ngm:pharmaceutical-supply-chain,
        ngm:supply-chain-visibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:rfid-antenna,
        ngm:rfid-reader,
        ngm:rfid-tag ;
    vc:isPartOf ngm:automatic-identification-and-data-capture,
        ngm:internet-of-things ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:logistics,
        ngm:network-communication,
        ngm:sensor-network ;
    vc:requires ngm:backscatter-communication,
        ngm:electromagnetic-spectrum ;
    vc:slug "rfid" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:epc-global-gen2,
        ngm:gs1-epc,
        ngm:iso-18000 ;
    vc:uses ngm:communication-infrastructure,
        ngm:near-field-communication,
        ngm:ultra-high-frequency-radio .

ngm:robot-actuator a owl:Class ;
    rdfs:label "Robot Actuator"@en ;
    rdfs:comment "A robot actuator is an electromechanical, pneumatic, hydraulic, or shape-memory device that converts stored or supplied energy into controlled mechanical motion, forming the effector substrate through which a robotic system exerts forces and displacements on its environment. Actuators are the physical implementation layer between a robot's control system and its mechanical structure, determining the speed, force, precision, and compliance characteristics achievable by the overall system. Modern robot actuators range from high-torque servo motors and linear voice-coil drives to soft pneumatic bellows and piezoelectric micro-actuators, each presenting distinct trade-offs in power density, bandwidth, back-drivability, and safety. The selection and design of actuators is a primary determinant of robot morphology, task capability, and energy efficiency across manipulation, locomotion, and human-collaborative applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:position-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electric-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hydraulic-cylinder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pneumatic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-electronics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:embedded-systems,
        ngm:hardware-component,
        ngm:machine-learning ;
    vc:contrastsWith ngm:passive-mechanism,
        ngm:robot-sensor ;
    vc:dependsOn ngm:feedback-control,
        ngm:motor-driver ;
    vc:enables ngm:compliant-motion,
        ngm:force-torque-control,
        ngm:robot-locomotion,
        ngm:robot-motion-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:electric-motor,
        ngm:gear-transmission,
        ngm:hydraulic-cylinder,
        ngm:piezoelectric-actuator,
        ngm:pneumatic-actuator ;
    vc:implements ngm:direct-drive-actuation,
        ngm:series-elastic-actuation ;
    vc:isPartOf ngm:robot-joint,
        ngm:robotic-manipulator ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:exoskeleton,
        ngm:soft-robotics ;
    vc:requires ngm:position-sensor,
        ngm:power-electronics,
        ngm:robot-controller ;
    vc:slug "robot-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61800,
        ngm:iso-9283 ;
    vc:supports ngm:human-robot-interaction,
        ngm:robot-end-effector ;
    vc:uses ngm:encoder,
        ngm:pid-control .

ngm:scope-1-emissions a owl:Class ;
    rdfs:label "Scope 1 Emissions"@en ;
    rdfs:comment "Scope 1 emissions are direct greenhouse gas (GHG) emissions from sources that are owned or controlled by a reporting organisation, as defined by the GHG Protocol Corporate Standard. They include combustion of fuels in owned vehicles, boilers, and furnaces; process emissions from chemical or physical reactions in production; and fugitive emissions from refrigerant leaks, methane from waste operations, and similar inadvertent releases. Scope 1 emissions are denominated in CO2-equivalent (CO2e) tonnes and represent the most controllable category of an organisation's carbon footprint."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:bridgesTo ngm:carbon-capture-utilisation-and-storage,
        ngm:supply-chain-decarbonisation ;
    vc:contrastsWith ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:carbon-trading,
        ngm:esg-reporting,
        ngm:net-zero-target-setting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fugitive-emissions,
        ngm:mobile-combustion-emissions,
        ngm:process-emissions,
        ngm:stationary-combustion-emissions ;
    vc:isPartOf ngm:corporate-carbon-footprint,
        ngm:ghg-inventory ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-border-adjustment-mechanism,
        ngm:emission-factors,
        ngm:ghg-protocol,
        ngm:kyoto-protocol,
        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:requires ngm:operational-control-boundary,
        ngm:third-party-assurance ;
    vc:slug "scope-1-emissions" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:corporate-sustainability-reporting-directive,
        ngm:ifrs-s2,
        ngm:iso-14064 ;
    vc:uses ngm:activity-data,
        ngm:carbon-footprint-measurement,
        ngm:environmental-accounting,
        ngm:mass-balance-method .

ngm:self-regulation a owl:Class ;
    rdfs:label "Self-Regulation"@en ;
    rdfs:comment "An arrangement in which an industry or professional community sets and enforces its own rules of conduct, typically through codes of practice, member oversight, and industry-led standards rather than direct state legislation; effectiveness depends on incentive alignment, credible enforcement, and public accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:enforcement-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:ai-governance,
        ngm:data-governance,
        ngm:distributed-governance ;
    vc:contrastsWith ngm:command-and-control-regulation,
        ngm:statutory-regulation ;
    vc:dependsOn ngm:peer-oversight,
        ngm:standards-body,
        ngm:trade-association ;
    vc:enables ngm:consumer-protection,
        ngm:industry-coordination,
        ngm:market-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:code-of-conduct,
        ngm:enforcement-mechanism,
        ngm:industry-standard ;
    vc:implements ngm:co-regulation,
