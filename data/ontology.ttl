    vc:relatedTo ngm:machine-learning-discipline ;
    vc:relatedTo ngm:statistical-modelling ;
    vc:slug "probabilistic-modelling" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bayesian-inference ;
    vc:uses ngm:monte-carlo-simulation .
ngm:probabilistic-programming a owl:Class ;
    rdfs:comment "Probabilistic programming is a paradigm in which statistical models are expressed as programs that include random variables and conditioning statements, with inference performed automatically by the language runtime. It lets practitioners specify generative models declaratively while delegating the mechanics of Bayesian inference, such as sampling or variational optimisation, to the system. This separation of model specification from inference enables rapid iteration on complex probabilistic models across science and machine learning."@en ;
    rdfs:label "Probabilistic Programming"@en ;
    rdfs:subClassOf ngm:probabilistic-model ;
