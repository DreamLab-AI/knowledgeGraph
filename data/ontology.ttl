    vc:slug "payment-gateway" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:api-gateway,
        ngm:digital-wallet,
        ngm:encryption .

ngm:platform-service a owl:Class ;
    rdfs:label "Platform Service"@en ;
    rdfs:comment "A managed cloud or middleware service exposed via APIs that provides reusable capabilities—such as authentication, storage, rendering, or notification—to applications built on top of a platform. Platform services abstract infrastructure complexity, enabling developers to compose higher-order virtual world and spatial computing features without managing underlying infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
