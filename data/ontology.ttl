    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "learning-module" ;
    vc:sourceDomain "spatial-computing" .

ngm:lidar-scanning a owl:Class ;
    rdfs:label "Lidar Scanning"@en ;
    rdfs:comment "Light Detection and Ranging technology that creates precise 3D spatial maps by emitting laser pulses and measuring return times, enabling accurate environment capture for VR/AR applications, metaverse development, and spatial computing."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:spatial-mapping-technology ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:digital-twin-creation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "lidar-scanning" ;
    vc:sourceDomain "robotics" .

ngm:liquidity-provider a owl:Class ;
    rdfs:label "Liquidity Provider"@en ;
    rdfs:comment "A liquidity provider is an entity — individual, institution, or automated protocol participant — that deposits assets into a trading venue or liquidity pool to enable others to execute trades, receiving fee income or other incentives in return. In decentralised finance, liquidity providers supply token pairs to automated market makers, receiving LP tokens representing their proportional pool share."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:impermanent-loss,
        ngm:yield-farming ;
    vc:slug "liquidity-provider" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:lp-token .

ngm:logic a owl:Class ;
    rdfs:label "Logic"@en ;
    rdfs:comment "The systematic study of valid inference and reasoning, concerned with the principles that distinguish correct from incorrect arguments. It underpins mathematics, philosophy, and computer science."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "logic" ;
    vc:sourceDomain "mathematics" .

ngm:logic-programming a owl:Class ;
    rdfs:label "Logic Programming"@en ;
    rdfs:comment "Logic Programming is a programming paradigm in which computation is expressed as logical inference over a set of facts and rules written in formal logic. Programs describe what is true rather than how to compute, and an inference engine derives answers by applying resolution and unification. Prolog is the canonical language; descendant systems include Datalog, Answer Set Programming, and constraint logic programming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:ai-technique,
        ngm:programming-paradigm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:expert-systems,
        ngm:formal-verification,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:knowledge-base,
        ngm:natural-language-processing,
        ngm:semantic-web,
        ngm:software-engineering,
        ngm:symbolic-ai ;
    vc:requires ngm:knowledge-representation,
        ngm:reasoning ;
    vc:slug "logic-programming" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:database-query .

ngm:low-latency-computing a owl:Class ;
    rdfs:label "Low-Latency Computing"@en ;
    rdfs:comment "Low-latency computing is an architectural discipline concerned with minimising the end-to-end delay between a request and its response, typically targeting sub-millisecond to single-digit-millisecond budgets. It combines hardware proximity, kernel-bypass networking, lock-free data structures, cache-aware memory layouts, and predictable scheduling to eliminate sources of jitter. Application domains include high-frequency trading, real-time multiplayer rendering, industrial control, telecommunications signalling, and interactive AI inference, where tail latency rather than average throughput is the governing performance metric."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:network-protocol ;
    vc:slug "low-latency-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing .

ngm:lp-token a owl:Class ;
    rdfs:label "LP Token"@en ;
    rdfs:comment "An LP (Liquidity Provider) token is a fungible cryptographic token minted by a decentralised exchange or liquidity pool smart contract to represent a depositor's proportional ownership stake in a pool's combined assets, accrued fees, and associated yield. LP tokens serve as receipts that can be redeemed to withdraw the underlying liquidity position at any time."@en ;
    rdfs:subClassOf ngm:token-standard ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:liquidity-provider,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:impermanent-loss ;
    vc:slug "lp-token" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:liquidity-pool,
        ngm:smart-contract .

ngm:machine-to-machine-payments a owl:Class ;
    rdfs:label "Machine to Machine Payments"@en ;
    rdfs:comment "Machine to Machine Payments (M2M Payments) refers to automated financial transactions initiated and settled between autonomous devices, software agents, or AI systems without direct human involvement in each individual transaction. These payments enable IoT devices, autonomous vehicles, robots, and AI agents to pay for resources, services, or data on a per-use or streaming basis, forming the economic layer of the machine economy. M2M payments typically require programmable money, low transaction fees, high throughput, and reliable settlement guarantees, properties that have driven interest in blockchain-based payment channels, stablecoins, and central bank digital currencies as settlement rails."@en ;
    rdfs:subClassOf ngm:digital-payment-system ;
    vc:enables ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-finance,
        ngm:agentic-internet,
        ngm:autonomous-agent ;
    vc:slug "machine-to-machine-payments" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-payments ;
    vc:uses ngm:lightning-network,
        ngm:micropayments,
        ngm:smart-contract .

ngm:markov-decision-process a owl:Class ;
    rdfs:label "Markov Decision Process"@en ;
    rdfs:comment "A mathematical framework for modelling sequential decision-making where outcomes are partly random and partly under the control of a decision maker."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:markov-chain ;
    vc:enables ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:markov-chain,
        ngm:probability-theory ;
    vc:slug "markov-decision-process" ;
    vc:sourceDomain "mathematics" .

ngm:material-science a owl:Class ;
    rdfs:label "Material Science"@en ;
    rdfs:comment "The interdisciplinary study of the structure, properties, processing, and performance of materials, linking their atomic arrangement to observable behaviour."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:material-system,
        ngm:quantum-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "material-science" ;
    vc:sourceDomain "general" .

ngm:medical-imaging-ai a owl:Class ;
    rdfs:label "Medical Imaging AI"@en ;
    rdfs:comment "Medical Imaging AI encompasses artificial intelligence systems designed to analyse, interpret, and enhance medical images including radiological scans, pathology slides, and other diagnostic imaging modalities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radiology-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pathology-ai ],
        ngm:ai-application,
        ngm:vision-processing ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:healthcare-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:pathology-ai,
        ngm:radiology-ai ;
    vc:isPartOf ngm:medical-ai ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "medical-imaging-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network .

ngm:merkle-dag a owl:Class ;
    rdfs:label "Merkle DAG"@en ;
    rdfs:comment "A Merkle Directed Acyclic Graph (DAG) is a data structure combining Merkle tree hash-linking with a generalised directed acyclic graph topology, allowing nodes to have multiple parents and enabling content-addressed, tamper-evident storage of arbitrary graph-shaped data. Unlike a binary Merkle tree, each node's cryptographic hash is derived from all its children, forming a unique, immutable identifier for any subgraph."@en ;
    rdfs:subClassOf ngm:content-addressing,
        ngm:data-structure ;
    vc:enables ngm:distributed-storage,
        ngm:ipfs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger-technology,
        ngm:merkle-tree ;
    vc:slug "merkle-dag" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-hash-function .

ngm:message-broker a owl:Class ;
    rdfs:label "Message Broker"@en ;
    rdfs:comment "A message broker is an intermediary software component that translates messages between disparate messaging protocols and routes them between producers and consumers, decoupling the two sides of a communication so that neither needs direct knowledge of the other. It typically provides guaranteed delivery, message queuing, routing rules, protocol translation, and persistence semantics."@en ;
    rdfs:subClassOf ngm:middleware ;
    vc:enables ngm:event-streaming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:apache-kafka,
        ngm:event-driven-architecture ;
    vc:slug "message-broker" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:message-queue,
        ngm:publish-subscribe-pattern .

ngm:metadata-repository a owl:Class ;
    rdfs:label "Metadata Repository"@en ;
    rdfs:comment "Storage systems that centralise metadata from diverse data sources, providing unified access to technical, business, and operational metadata for data discovery, cataloguing, lineage tracking, and governance across enterprise environments."@en ;
    rdfs:subClassOf ngm:data-management,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:data-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metadata-repository" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-and-spatial-risks a owl:Class ;
    rdfs:label "Metaverse and Spatial Risks"@en ;
    rdfs:comment "Metaverse and Spatial Risks encompass the range of harms and hazards that arise specifically from spatially embodied, real-time virtual interactions — including harassment and abuse that mimics physical-world dynamics, miscommunication amplified by latency and avatar fidelity limitations, digital addiction, physical health impacts from prolonged immersive use, privacy violations through biometric data collection, and regulatory gaps as legislation lags behind technology deployment. These risks require multi-layered mitigation combining technical safeguards, governance frameworks, and international regulatory coordination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-safety ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:privacy,
        ngm:user-safety ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:metaverse-liability-model,
        ngm:risk-management ;
    vc:requires ngm:content-moderation,
        ngm:regulatory-framework ;
    vc:slug "metaverse-and-spatial-risks" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-application a owl:Class ;
    rdfs:label "Metaverse Application"@en ;
    rdfs:comment "A software application designed to operate within or alongside a metaverse platform, providing users with persistent virtual experiences including social interaction, commerce, entertainment, education, and collaboration. Metaverse applications leverage real-time 3D rendering, avatar systems, spatial audio, and interoperability standards to deliver presence-rich, cross-platform functionality within shared virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:distributed-collaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:metaverse-architecture ;
    vc:requires ngm:avatar,
        ngm:metaverse-platform ;
    vc:slug "metaverse-application" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:game-engine,
        ngm:spatial-audio .

ngm:metaverse-ontology-schema a owl:Class ;
    rdfs:label "Metaverse Ontology Schema"@en ;
    rdfs:comment "A formal OWL 2 ontology framework defining the complete taxonomic structure, semantic relationships, axioms, and reasoning rules for metaverse concepts, enabling automated classification, consistency validation, and interoperability across virtual world implementations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:namespace-declarations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:owl-class-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-triple-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validation-constraints ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:automated-reasoning,
        ngm:knowledge-graph-construction,
        ngm:ontology-based-data-access,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:axiom-rules,
        ngm:inference-rules,
        ngm:namespace-declarations,
        ngm:owl-class-hierarchy,
        ngm:property-definitions,
        ngm:validation-constraints ;
    vc:isPartOf ngm:knowledge-representation-system,
        ngm:semantic-web-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:owl-2-reasoner,
        ngm:rdf-triple-store,
        ngm:sparql-endpoint ;
    vc:slug "metaverse-ontology-schema" ;
    vc:sourceDomain "spatial-computing" .

ngm:mobile-robotics a owl:Class ;
    rdfs:label "Mobile Robotics"@en ;
    rdfs:comment "Mobile robotics is the field concerned with designing and programming robots that autonomously locomote through unstructured or semi-structured environments — using wheeled, legged, aerial, or aquatic platforms — by integrating perception, localisation, mapping, and motion planning to achieve task-oriented navigation goals without continuous human tele-operation."@en ;
    rdfs:subClassOf ngm:robot ;
    vc:enables ngm:autonomous-vehicle,
        ngm:logistics-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:navigation,
        ngm:reinforcement-learning-for-robotics ;
    vc:slug "mobile-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:path-planning,
        ngm:sensor-fusion .

ngm:model-capacity a owl:Class ;
    rdfs:label "Model Capacity"@en ;
    rdfs:comment "The measure of a machine learning model's ability to represent a wide variety of functions, determined by parameter count, architecture depth and width, and representational power. Models with insufficient capacity underfit the data; those with excessive capacity risk overfitting. Capacity is formally bounded by concepts such as the Vapnik–Chervonenkis dimension, and is managed in practice through regularisation, pruning, and architecture search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:overfitting,
        ngm:regularisation,
        ngm:underfitting ;
    vc:requires ngm:neural-network,
        ngm:training-data ;
    vc:slug "model-capacity" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:money a owl:Class ;
    rdfs:label "Money"@en ;
    rdfs:comment "A medium of exchange, unit of account, and store of value accepted within an economic system, encompassing physical currency, digital money, cryptocurrencies, and virtual currency forms that facilitate economic activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fiat-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-money ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:central-bank-digital-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptocurrency ],
        ngm:bc-token-and-asset,
        ngm:cryptocurrency ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:cross-border-payments,
        ngm:debt,
        ngm:economic-exchange,
        ngm:price-discovery,
        ngm:savings ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:central-bank-digital-currency,
        ngm:cryptocurrency,
        ngm:digital-money,
        ngm:fiat-currency,
        ngm:stablecoin ;
    vc:isPartOf ngm:value-transfer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:acceptance-network,
        ngm:issuing-authority,
        ngm:liquidity,
        ngm:trust ;
    vc:slug "money" ;
    vc:sourceDomain "blockchain" .

ngm:motion-capture-rig a owl:Class ;
    rdfs:label "Motion Capture Rig"@en ;
    rdfs:comment "Physical hardware or software system capturing human motion for animation or simulation through cameras, markers, sensors, and tracking infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration-target ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu-sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-markers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-solver-software ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:animation-retargeting,
        ngm:biomechanical-analysis,
        ngm:performance-capture,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:calibration-target,
        ngm:data-processing-unit,
        ngm:imu-sensors,
        ngm:motion-markers,
        ngm:optical-cameras,
        ngm:tracking-volume ;
    vc:isPartOf ngm:reality-capture-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:camera-calibration,
        ngm:high-speed-networking,
        ngm:motion-solver-software,
        ngm:synchronized-timing ;
    vc:slug "motion-capture-rig" ;
    vc:sourceDomain "spatial-computing" .

ngm:multi-signature a owl:Class ;
    rdfs:label "Multi-Signature"@en ;
    rdfs:comment "Multi-Signature (multisig) is a cryptographic access-control scheme requiring that a transaction or operation be authorised by a threshold number of independent private keys from a defined set before it is considered valid. Commonly expressed as m-of-n (e.g. 2-of-3), multisig eliminates single points of failure in key custody and enforces shared governance over digital assets or smart contracts. It is foundational to institutional cryptocurrency custody, DAO treasury management, and hardware-secure wallet architectures. Multisig schemes may be implemented at the protocol layer, at the script level (as in Bitcoin P2SH), or at the application layer via smart contracts."@en ;
    rdfs:subClassOf ngm:signature-scheme ;
    vc:enables ngm:dao-governance,
        ngm:multi-sig-governance,
        ngm:multi-signature-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ecdsa,
        ngm:schnorr-signature,
        ngm:threshold-signature-scheme ;
    vc:slug "multi-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-keys,
        ngm:smart-contract .

ngm:multi-view-stereo a owl:Class ;
    rdfs:label "Multi-View Stereo"@en ;
    rdfs:comment "Multi-View Stereo (MVS) is a computer vision technique that reconstructs dense 3D geometry from a set of overlapping 2D images captured from multiple camera positions. It extends traditional stereo matching by leveraging consistency across many viewpoints to estimate depth and surface detail at high resolution. MVS is a foundational component of photogrammetry pipelines, producing point clouds and textured meshes from photograph collections."@en ;
    rdfs:subClassOf ngm:photogrammetry ;
    vc:enables ngm:3-d-scanning,
        ngm:point-cloud-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:point-cloud-processing ;
    vc:slug "multi-view-stereo" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:depth-estimation,
        ngm:stereo-vision,
        ngm:structure-from-motion .

ngm:multimodal a owl:Class ;
    rdfs:label "multimodal"@en ;
    rdfs:comment "Multimodal AI refers to artificial intelligence systems that process, fuse, and generate content across multiple data modalities—including text, images, audio, video, and 3D—within a unified model architecture. Multimodal systems learn cross-modal alignments through joint embedding spaces, enabling capabilities such as image captioning, visual question answering, text-to-image synthesis, and real-time audio-visual understanding that single-modality models cannot achieve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-research-area,
        ngm:multimodal-ai ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:image-generation,
        ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:speech-recognition ;
    vc:requires ngm:computer-vision,
        ngm:large-language-models ;
    vc:slug "multimodal" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:multimodal-understanding a owl:Class ;
    rdfs:label "Multimodal Understanding"@en ;
    rdfs:comment "Multimodal Understanding is an AI research area concerned with systems that jointly process and reason over multiple sensory modalities — including text, images, audio, video, and structured data — producing unified semantic representations. It underpins vision-language models, audio-visual reasoning, and multi-sensor scene interpretation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-and-voice ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:natural-language-understanding,
        ngm:scene-understanding,
        ngm:speech-and-voice ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-technique,
        ngm:generative-ai,
        ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:slug "multimodal-understanding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:multimodal-ai,
        ngm:transformer .

ngm:multisignature-wallets a owl:Class ;
    rdfs:label "Multisignature Wallets"@en ;
    rdfs:comment "Multisignature wallets are cryptocurrency custody arrangements requiring m-of-n cryptographic signatures before a transaction can be authorised, distributing key control across multiple independent parties or devices. They eliminate single points of failure in private key management, making them a standard security architecture for institutional digital asset custody and shared treasury governance. The underlying cryptographic mechanism uses threshold signing schemes such as ECDSA or Schnorr aggregation."@en ;
    rdfs:subClassOf ngm:blockchain-entity ;
    vc:enables ngm:blockchain-governance,
        ngm:cold-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency-storage ;
    vc:slug "multisignature-wallets" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:bls-signature,
        ngm:cryptographic-key-management .

ngm:natural-interaction a owl:Class ;
    rdfs:label "Natural Interaction"@en ;
    rdfs:comment "Natural Interaction describes human-computer interaction modalities that leverage innate human capabilities—speech, gesture, gaze, touch, and whole-body movement—rather than requiring users to learn abstract symbolic interfaces such as keyboards or command-line syntax. The goal is to reduce cognitive translation costs and make technology accessible to a broader range of users by aligning the interaction channel with the way humans naturally communicate and manipulate objects in the physical world. Natural interaction is foundational to spatial computing, mixed reality, and embodied AI systems where traditional 2D pointing devices are ergonomically or practically unsuitable."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:embodied-ai,
        ngm:spatial-computing,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:gesture-recognition,
        ngm:haptic-feedback,
        ngm:speech-recognition ;
    vc:slug "natural-interaction" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:conversational-ai,
        ngm:hand-tracking,
        ngm:multimodal-ai .

ngm:network-hash-rate a owl:Class ;
    rdfs:label "Network Hash Rate"@en ;
    rdfs:comment "The aggregate computational power (measured in hashes per second) expended by all miners participating in a proof-of-work blockchain at a given time. A higher network hash rate increases attack cost for a 51% attack and triggers upward difficulty adjustments to maintain target block times; conversely, drops in hash rate trigger downward adjustments."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:nakamoto-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:block-reward,
        ngm:difficulty-adjustment,
        ngm:mining-pool,
        ngm:proof-of-work,
        ngm:selfish-mining ;
    vc:slug "network-hash-rate" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:mining .

ngm:network-performance-metrics a owl:Class ;
    rdfs:label "Network Performance Metrics"@en ;
    rdfs:comment "Network Performance Metrics are quantitative measures used to characterise the operational quality of a communication network, encompassing latency, throughput, packet loss rate, jitter, and availability. These metrics are collected continuously from network devices, links, and endpoints to support quality-of-service enforcement, capacity planning, fault detection, and SLA compliance verification. They underpin all layers of network management from physical links to application-level experience."@en ;
    rdfs:subClassOf ngm:quality-of-service ;
    vc:enables ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:edge-computing,
        ngm:internet-infrastructure,
        ngm:latency ;
    vc:slug "network-performance-metrics" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:latency-management-protocol,
        ngm:real-time-monitoring .

ngm:network-quality-metric a owl:Class ;
    rdfs:label "Network Quality Metric"@en ;
    rdfs:comment "A quantitative measure used to characterise the performance and reliability of a network connection for real-time interactive applications, encompassing parameters such as latency (round-trip time), jitter, packet loss rate, available bandwidth, and connection stability. These metrics directly determine the feasibility of synchronised multi-user experiences in spatial computing environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking-technology ],
        ngm:sc-content-and-assets ;
