    vc:uses ngm:nostr ;
    vc:uses ngm:schnorr-signature ;
    vc:uses ngm:secp256k1 .
ngm:did-nostr-identity a owl:Class ;
    rdfs:comment "A W3C DID Core|W3C Decentralised Identifier (did:nostr:<pubkey>) binding a VisionClaw Agentic Container|VisionClaw agent to its BIP-340 Schnorr Keypair|BIP-340 x-only public key, enabling cryptographic proof of identity, self-sovereign key management, and inter-agent trust without a c..."@en ;
    rdfs:label "DID Nostr Identity"@en ;
    rdfs:subClassOf ngm:distributed-identity ;
    rdfs:subClassOf ngm:network-component ;
