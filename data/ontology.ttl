ngm:ai-fairness a owl:Class ;
    rdfs:label "AI Fairness"@en ;
    rdfs:comment "AI Fairness refers to the principle and practice of ensuring artificial intelligence systems produce equitable outcomes without bias or discrimination based on protected characteristics such as race, gender, age, or socioeconomic status."@en ;
    rdfs:subClassOf ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:equitable-ai-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "ai-fairness" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:bias-detection-methods a owl:Class ;
    rdfs:label "Bias Detection Methods"@en ;
    rdfs:comment "Bias Detection Methods are systematic analytical techniques for identifying algorithmic bias in AI systems through statistical hypothesis testing, fairness audits, counterfactual analysis, intersectional evaluation, and causal inference. These methods examine model predictions across protected demographic groups to detect disparate impacts, unequal error rates, and discriminatory patterns, producing bias audit reports that document severity, affected populations, and regulatory compliance status."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-auditing-tools ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:disparate-impact ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:algorithmic-bias,
        ngm:disparate-impact,
        ngm:fairness-auditing-tools,
        ngm:fairness-metrics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:algorithmic-accountability,
        ngm:bias-in-large-language-models ;
    vc:slug "bias-detection-methods" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-audit,
        ngm:ai-fairness,
        ngm:explainable-ai,
        ngm:responsible-ai .

ngm:crdt a owl:Class ;
    rdfs:label "CRDT"@en ;
    rdfs:comment "Conflict-free Replicated Data Types (CRDTs) are a family of data structures with mathematically proven convergence guarantees that allow multiple distributed replicas to be independently modified without requiring coordination, locks, or a consensus protocol, and which automatically merge to a si..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eventual-consistency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vector-clocks ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:or-set ],
        ngm:dc-protocol-and-infra,
        ngm:infra-network-and-comms ;
    skos:broader ngm:dc-protocol-and-infra,
        ngm:infra-network-and-comms ;
    vc:enables ngm:coordination-free-computing,
        ngm:local-first-software,
        ngm:multi-datacenter-replication,
        ngm:offline-first-collaboration,
        ngm:optimistic-replication,
        ngm:partition-tolerant-databases,
        ngm:peer-to-peer-synchronisation,
        ngm:real-time-collaborative-editing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:causal-history-graph,
        ngm:causal-ordering,
        ngm:delta-state,
        ngm:g-counter,
        ngm:g-set,
        ngm:lww-element-set,
        ngm:or-set,
        ngm:replicated-growable-array,
        ngm:semilattice-merge-function,
        ngm:tombstone-record,
        ngm:unique-identifier,
        ngm:vector-clocks,
        ngm:version-vector ;
    vc:implements ngm:associativity,
        ngm:causal-broadcast,
        ngm:commutativity,
