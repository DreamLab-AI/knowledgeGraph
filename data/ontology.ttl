ngm:path-tracing a owl:Class ;
    rdfs:comment "Path tracing is a physically based rendering algorithm that estimates the rendering equation by stochastically sampling complete light-transport paths from the camera through a scene to light sources. It uses Monte Carlo integration over recursive ray bounces to compute unbiased estimates of global illumination, including soft shadows, indirect lighting, and caustics. Image noise decreases as the square root of the number of samples, making convergence and denoising central practical concerns."@en ;
    rdfs:label "Path Tracing"@en ;
    rdfs:subClassOf ngm:physically-based-rendering ;
    rdfs:subClassOf _:r16173 ;
