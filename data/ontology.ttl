    vc:isPartOf ngm:asymmetric-key-pair,
        ngm:cryptographic-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:cryptographic-keys,
        ngm:hardware-security-module,
        ngm:hierarchical-deterministic-wallet,
        ngm:mnemonic-seed-phrase ;
    vc:requires ngm:cryptographically-secure-random-number-generator,
