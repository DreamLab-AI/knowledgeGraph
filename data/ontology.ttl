    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:network-architecture ;
    vc:slug "collaboration-tools" ;
    vc:sourceDomain "distributed-systems" .

ngm:collaborative-robotics a skos:Concept ;
    rdfs:label "Collaborative Robotics"@en .

ngm:collaborative-systems-modality-robotics a owl:Class ;
    rdfs:label "Collaborative Robotics"@en ;
    rdfs:comment "Collaborative Robotics is the engineering discipline concerned with designing, deploying, and operating robotic systems — particularly collaborative robots (cobots) — that share workspace and tasks with human workers without requiring physical barriers, relying instead on force-torque sensing, speed-and-separation monitoring, and power-and-force limiting to maintain safety under ISO 10218 and ISO/TS 15066. Unlike traditional industrial robots that operate in guarded cages, cobots are designed with compliant joints, rounded profiles, and real-time collision-detection to enable direct physical cooperation with humans on assembly, inspection, and logistics tasks. The discipline integrates mechanical design, control theory, human-robot interaction research, and regulatory compliance to enable safe human-robot co-presence in shared workspaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impedance-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cobot-safety-levels ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        ngm:collaborative-systems-modality-robot ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:digital-twin ;
    vc:contrastsWith ngm:autonomous-mobile-robot,
        ngm:industrial-robot ;
    vc:enables ngm:assistive-robotics,
        ngm:flexible-manufacturing,
        ngm:human-robot-teaming,
        ngm:manufacturing-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cobot-safety-levels,
        ngm:end-effector,
        ngm:force-torque-sensor,
        ngm:impedance-control ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-robot-interaction,
        ngm:imitation-learning,
        ngm:robot-programming ;
    vc:requires ngm:real-time-control,
        ngm:risk-assessment,
        ngm:robot-safety ;
    vc:slug "collaborative-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning,
        ngm:motion-planning,
        ngm:tactile-sensing .

ngm:collective-governance a owl:Class ;
    rdfs:label "Collective Governance"@en ;
    rdfs:comment "A system of rules, norms, and decision-making processes through which a group of stakeholders jointly determines how shared resources, organisations, or platforms are managed. It distributes authority among participants rather than concentrating it in a single administrator, seeking legitimacy through inclusive participation and transparent deliberation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordination-mechanisms ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-action ],
        ngm:community-governance ;
    vc:enables ngm:dao-governance,
        ngm:polycentric-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-decision-making,
        ngm:community-decision-making ;
    vc:requires ngm:collective-action,
        ngm:coordination-mechanisms ;
    vc:slug "collective-governance" ;
    vc:sourceDomain "governance" .

ngm:collision-detection-system a owl:Class ;
    rdfs:label "Collision Detection System"@en ;
    rdfs:comment "A computational subsystem that continuously tests whether geometric objects in a simulation or physical environment intersect or are about to intersect, enabling physics engines, robotics planners, and interactive applications to respond to contact events. It combines spatial partitioning structures with narrow-phase geometry tests to balance accuracy against performance."@en ;
    rdfs:subClassOf ngm:collision-detection ;
    vc:enables ngm:collision-avoidance,
        ngm:haptic-feedback ;
    vc:hasMaturity ngmi:maturity-draft ;
