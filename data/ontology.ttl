ngm:process-automation a owl:Class ;
    rdfs:label "Process Automation"@en ;
    rdfs:comment "Process automation is the use of technology to perform repetitive business, operational, or industrial tasks with minimal human intervention, replacing manual steps in workflows with software execution, robotic systems, or rule-based logic engines. It spans a spectrum from simple macro-based automation of individual tasks through robotic process automation (RPA) that mimics user interface interactions, to intelligent automation that integrates machine learning models for decision-making in unstructured data contexts. The goal is to increase throughput, reduce errors, lower labour costs, and free human workers for higher-value activities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intelligent-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:workflow-engine ],
