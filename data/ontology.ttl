ngm:land-economics a owl:Class ;
    rdfs:label "Land Economics"@en ;
    rdfs:comment "Land Economics is the economic framework governing virtual land ownership, valuation, development, and transaction within metaverse environments, characterised by artificial scarcity, spatial positioning premiums, and speculative markets. It encompasses primary sales, secondary peer-to-peer trading, rental systems, platform taxation models, and zoning policies that together determine how virtual parcels accumulate and lose value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
