        ngm:social-choice-theory ;
    vc:uses ngm:shapley-value .

ngm:cqrs a owl:Class ;
    rdfs:label "CQRS"@en ;
    rdfs:comment "Command Query Responsibility Segregation (CQRS) is a software architecture pattern that separates the model used to update state (commands) from the model used to read state (queries). By using distinct write and read paths, systems can independently optimise, scale, and secure each side, often pairing the write model with event sourcing. It is commonly applied in high-throughput, complex-domain systems where read and write workloads diverge."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:data-layer ;
    vc:slug "cqrs" ;
    vc:sourceDomain "infrastructure" .

ngm:creator-royalties a owl:Class ;
    rdfs:label "Creator Royalties"@en ;
    rdfs:comment "Creator royalties are automatic, programmable payments directed to the original creator of a digital asset — typically an NFT — each time that asset is resold on a secondary market. Encoded in smart contract logic or enforced through marketplace policy, royalties provide creators with a fraction of every subsequent transaction price, extending their economic participation beyond the initial sale. The mechanism is foundational to sustainable creator economies on blockchain platforms, though enforcement remains contested between on-chain protocol enforcement and off-chain marketplace compliance. Debate centres on whether royalty obligations can be made non-bypassable at the token-transfer level or rely on voluntary marketplace co-operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nft ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:digital-rights-management ;
    vc:bridgesTo ngm:creator-monetization,
        ngm:digital-ownership ;
    vc:contrastsWith ngm:marketplace ;
    vc:dependsOn ngm:nft-marketplace,
        ngm:on-chain-governance,
        ngm:token-transfer ;
    vc:enables ngm:creator-economy,
        ngm:marketplace,
        ngm:programmable-money ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:intellectual-property-rights-framework,
        ngm:royalty-distribution,
        ngm:secondary-market ;
    vc:requires ngm:blockchain,
        ngm:nft,
        ngm:smart-contract ;
    vc:slug "creator-royalties" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:eip-2981,
        ngm:token-standard .

