    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:CryptographicPrimitive vcw:bridgesTo blockchain:AIAgentSystem .

# Token Standard
blockchain:TokenStandard rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Token Standard"@en ;
    rdfs:comment "Technical specification defining rules, interfaces, and functions that smart contract tokens must implement to ensure interoperability within a blockchain ecosystem. Standards like ERC-20 (fungible tokens) and ERC-721 (NFTs) establish common APIs for token transfers, balance queries, approvals, and metadata, enabling seamless integration across wallets, exchanges, and dApps."@en ;
    skos:prefLabel "Token Standard"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:token-standard" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:token-standard> ;
    vcw:contentHash "sha256-12-6aa019292d8f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-7005" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-7005" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:TokenStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:SmartContract
] .

blockchain:TokenStandard rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:Fungibility
] .

# Cryptographic Keys
blockchain:CryptographicKeys rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Cryptography ;
    rdfs:label "Cryptographic Keys"@en ;
    rdfs:comment "Strings of data used in cryptographic algorithms to encrypt, decrypt, sign, or verify data, serving as the secret parameters that transform plaintext to ciphertext and vice versa. Keys can be symmetric (single shared key) or asymmetric (public-private key pairs), with security depending on key length, randomness, and proper management."@en ;
    skos:prefLabel "Cryptographic Keys"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:cryptographic-keys" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:cryptographic-keys> ;
    vcw:contentHash "sha256-12-523109541c81" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
