        ngm:mutual-tls .

ngm:multi-agent-systems a owl:Class ;
    rdfs:label "Multi-Agent Systems"@en ;
    rdfs:comment "Multi-agent systems (MAS) are computational architectures in which multiple autonomous agents—each with their own perception, memory, reasoning, and action capabilities—interact within a shared environment to accomplish tasks that benefit from parallelisation, specialisation, or distributed coordination. Each agent operates according to local decision logic (reactive, deliberative, or hybrid) while collectively producing emergent global behaviour through communication, negotiation, and coordination protocols. In contemporary AI, MAS are realised through networks of LLM-backed agents orchestrated by frameworks that manage inter-agent messaging, tool invocation, and task decomposition. Mechanism-design principles, game theory, and classical distributed-AI theory inform how modern agentic systems handle conflict, incentive alignment, and safety in open-ended agent populations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordination-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:concurrency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-communication-language ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:digital-twin ;
    vc:contrastsWith ngm:monolithic-ai,
        ngm:single-agent-systems ;
    vc:dependsOn ngm:game-theory,
        ngm:mechanism-design ;
    vc:enables ngm:agentic-ai,
        ngm:collective-intelligence,
        ngm:emergent-behavior,
        ngm:task-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-communication-language,
        ngm:autonomous-agent,
        ngm:coordination-protocol ;
    vc:implements ngm:belief-desire-intention ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:explainability ;
    vc:requires ngm:concurrency,
        ngm:distributed-computing ;
    vc:slug "multi-agent-systems" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:fipa ;
    vc:supports ngm:reinforcement-learning,
        ngm:robotics,
        ngm:swarm-intelligence ;
    vc:uses ngm:agent-frameworks,
        ngm:large-language-models,
        ngm:message-passing,
        ngm:orchestration .

ngm:random-number-generation a owl:Class ;
    rdfs:label "Random Number Generation"@en ;
    rdfs:comment "The process of generating unpredictable and statistically random values for cryptographic operations, serving as a critical security primitive for key generation, nonces, and protocol initialization; distinguishes between true randomness from physical entropy sources (TRNG) and pseudo-randomness from deterministic algorithms seeded with entropy (CSPRNG)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:random-number-generator ],
        [ a owl:Restriction ;
