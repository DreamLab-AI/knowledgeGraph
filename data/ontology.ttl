ngm:preference-aggregation a owl:Class ;
    rdfs:label "Preference Aggregation"@en ;
    rdfs:comment "The process of combining individual preferences, rankings, or utility functions from multiple stakeholders into a collective or social preference ordering for decision-making purposes. Preference aggregation methods range from simple majority voting to sophisticated social choice mechanisms, each making different assumptions about preference structure and interpersonal comparability. Arrow's impossibility theorem establishes fundamental limits on consistent aggregation. The field is central to voting theory, mechanism design, and collaborative governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:social-choice-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:voting-mechanism ],
        ngm:governance ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:individual-decision-making ;
    vc:dependsOn ngm:data-collection ;
    vc:enables ngm:consensus-mechanism,
        ngm:policy-formation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:collective-decision-making,
        ngm:democratic-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:game-theory,
        ngm:mechanism-design ;
    vc:requires ngm:social-choice-theory,
        ngm:voting-mechanism ;
    vc:slug "preference-aggregation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:fairness,
        ngm:transparency ;
    vc:uses ngm:ranking-algorithm,
        ngm:utility-function .

