    vc:relatedTo ngm:virtual-identity,
        ngm:virtual-land-rights ;
    vc:slug "virtual-location" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:metaverse-navigation-systems,
        ngm:portal-system .

ngm:virtual-reality-applications a owl:Class ;
    rdfs:label "Virtual Reality Applications"@en ;
    rdfs:comment "Software programmes and use-case deployments that leverage virtual reality technology to deliver immersive, interactive experiences for domains including healthcare, education, enterprise training, entertainment, and social interaction, running on dedicated VR hardware or spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
