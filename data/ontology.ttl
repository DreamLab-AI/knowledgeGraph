        ngm:impact-certificates,
        ngm:welfare-economics ;
    vc:requires ngm:identity-verification,
        ngm:mechanism-design,
        ngm:on-chain-governance ;
    vc:slug "public-goods-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao,
