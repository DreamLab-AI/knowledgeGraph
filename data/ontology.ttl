    vc:slug "v-llm" ;
    vc:sourceDomain "ai" .

ngm:validation-report a owl:Class ;
    rdfs:label "VALIDATION_REPORT"@en ;
    rdfs:comment "A Validation Report is a systematic assessment document verifying ontology compliance, data quality, and structural integrity across knowledge graphs and semantic systems. It checks that class hierarchies, relation targets, definition coverage, and maturity fields meet specified quality thresholds, producing actionable findings for enrichment pipelines."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
