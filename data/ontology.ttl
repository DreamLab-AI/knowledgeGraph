ngm:sparse-autoencoders a owl:Class ;
    rdfs:label "Sparse Autoencoders"@en ;
    rdfs:comment "Sparse autoencoders are neural networks trained to reconstruct their input through a wide hidden layer subject to a sparsity penalty, so that only a small number of latent units activate for any given input. In mechanistic interpretability they are applied to the activations of large language models to decompose dense, polysemantic representations into more monosemantic, human-interpretable features. They have become a leading tool for understanding what concepts a model internally represents."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:safety-and-alignment ;
    vc:slug "sparse-autoencoders" ;
    vc:sourceDomain "ai" .

ngm:sparse-mixture-of-experts a owl:Class ;
    rdfs:label "Sparse Mixture of Experts"@en ;
    rdfs:comment "An MoE variant with a trainable gating network that selects only a sparse combination of experts for each example, dramatically increasing model capacity whilst maintaining computational efficiency. Sparsely-gated MoE enables models with up to 137 billion parameters with manageable inference costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
