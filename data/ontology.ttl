ngm:economic-growth a owl:Class ;
    rdfs:label "Economic Growth"@en ;
    rdfs:comment "Economic Growth is the increase over time in the value of goods and services produced by an economy, typically measured as the rise in real gross domestic product. It is driven by accumulation of capital, growth in the labour force, and improvements in productivity from technology and innovation. Sustained growth is a primary objective of economic policy and a frequently cited benefit of technology adoption."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:innovation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
