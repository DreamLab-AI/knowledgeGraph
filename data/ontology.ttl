    vc:supports ngm:cbdc-cross-border-settlement,
        ngm:central-bank-digital-currency-cbdc,
        ngm:financial-inclusion,
        ngm:macroprudential-policy .

ngm:inflation-control a owl:Class ;
    rdfs:label "Inflation Control"@en ;
    rdfs:comment "Inflation Control encompasses the mechanisms, policies, and economic design patterns used within virtual and metaverse economies to regulate the creation, circulation, and destruction of virtual currency and digital assets. These controls prevent hyperinflation and value collapse by balancing supply-side minting with demand-side sinks. Effective inflation control underpins the long-term viability of play-to-earn ecosystems, NFT markets, and decentralised finance platforms built on virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
