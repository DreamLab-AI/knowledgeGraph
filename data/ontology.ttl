    vc:slug "decentralized-finance" ;
    vc:sourceDomain "blockchain" .
ngm:decentralized-finance-de-fi a owl:Class ;
    rdfs:comment "Decentralized Finance (DeFi) is an open, permissionless financial ecosystem built on public blockchain networks—principally ereum but increasingly on Layer 2 Networks (Arbitrum, Optimism, Base) and rival Layer 1s (Solana, Avalanche, BNB Chain)—that replicates and extends traditional finan..."@en ;
    rdfs:label "Decentralized Finance (DeFi)"@en ;
