ngm:albert a owl:Class ;
    rdfs:label "ALBERT"@en ;
    rdfs:comment "A Lite BERT: a parameter-efficient transformer variant that uses factorised embedding parameterisation and cross-layer parameter sharing to achieve 18x fewer parameters than BERT-large whilst matching or exceeding its performance on NLP benchmarks such as GLUE, SQuAD, and RACE."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:ro-berta ;
