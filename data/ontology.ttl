        ngm:identity-verification ;
    vc:slug "e-contract-arbitration" ;
    vc:sourceDomain "spatial-computing" .

ngm:eba a owl:Class ;
    rdfs:label "EBA"@en ;
    rdfs:comment "The European Banking Authority (EBA) is an independent EU regulatory agency established in 2011 to ensure consistent prudential regulation and supervision across the European banking sector. It develops binding technical standards and guidelines that national supervisors must implement, conducts EU-wide stress tests to assess banking system resilience, and plays a central role in developing anti-money laundering supervisory frameworks. The EBA's remit has expanded into digital finance, including technical standards for crypto-asset service providers under the MiCA Regulation and guidelines on ICT risk management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stress-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convergence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technical-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:national-competent-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prudential-regulation ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:ecb,
        ngm:esma ;
    vc:dependsOn ngm:basel-accords ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:regulatory-compliance,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:convergence,
        ngm:stress-testing,
        ngm:technical-standards ;
    vc:implements ngm:capital-requirements-regulation,
        ngm:operational-resilience ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:mi-ca-regulation,
        ngm:regulatory-framework ;
    vc:requires ngm:national-competent-authority,
        ngm:prudential-regulation ;
    vc:slug "eba" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:european-commission ;
    vc:supports ngm:consumer-protection,
        ngm:financial-stability,
        ngm:systemic-risk .

ngm:eccv a owl:Class ;
    rdfs:label "ECCV"@en ;
    rdfs:comment "ECCV, the European Conference on Computer Vision, is a biennial premier venue for research in computer vision and pattern recognition, held in alternating years with ICCV to provide the community with annual high-quality publication opportunities. Founded in 1990, it attracts thousands of submissions covering topics from low-level image processing and 3D reconstruction to high-level scene understanding and video analysis. ECCV proceedings published through Springer LNCS constitute one of the most-cited bodies of literature in artificial intelligence. Acceptance at ECCV carries high prestige, signalling rigorous peer review and methodological significance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-recognition ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:icml,
        ngm:neur-ips ;
    vc:enables ngm:benchmarks,
        ngm:model-evaluation-results ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:academic-conference,
        ngm:computer-vision ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cvpr,
        ngm:iccv,
        ngm:iclr,
        ngm:vision-language-model ;
    vc:requires ngm:image-recognition ;
    vc:slug "eccv" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:autonomous-driving,
        ngm:medical-image-analysis ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:object-detection,
        ngm:semantic-segmentation,
        ngm:transformer-architecture .

ngm:edge-detection a owl:Class ;
    rdfs:label "Edge Detection"@en ;
    rdfs:comment "Edge detection is a computer vision technique that identifies points in a digital image where brightness changes sharply, marking the boundaries of objects, surfaces and textures. It typically computes image gradients and applies thresholding to produce a binary or magnitude map of edges. As a low-level feature operator it underpins higher-level tasks such as segmentation, object detection and shape analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        ngm:feature-detection ;
    vc:bridgesTo ngm:computer-vision ;
    vc:contrastsWith ngm:image-segmentation ;
    vc:dependsOn ngm:convolution ;
    vc:enables ngm:image-segmentation,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:feature-detection ;
    vc:isPartOf ngm:image-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:machine-vision ;
    vc:requires ngm:image-processing ;
    vc:slug "edge-detection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:feature-extraction ;
    vc:uses ngm:convolution,
        ngm:gradient .

ngm:edge-orchestration a owl:Class ;
    rdfs:label "Edge Orchestration"@en ;
    rdfs:comment "The process of dynamically coordinating, allocating, and balancing computational tasks between edge nodes and cloud infrastructure to optimize latency, resource utilization, and quality of experience for immersive metaverse applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
