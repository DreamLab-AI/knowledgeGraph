ngm:impedance-control a owl:Class ;
    rdfs:label "Impedance Control"@en ;
    rdfs:comment "A robot control strategy that dynamically modulates mechanical compliance (stiffness, damping, and inertia) to regulate the dynamic relationship between force and motion at the robot end-effector, enabling compliant and safe interaction with objects, surfaces, and humans without requiring explicit force feedback in all configurations."@en ;
