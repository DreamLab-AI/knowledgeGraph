    vc:sourceDomain "artificial-intelligence" .

vf:ai-augmented-software-engineering a owl:Class ;
    rdfs:label "AI-Augmented Software Engineering"@en ;
    rdfs:comment "[Generated from Gartner emerging tech analysis]"@en ;
