ngm:cdn a owl:Class ;
    rdfs:label "CDN"@en ;
    rdfs:comment "A Content Delivery Network (CDN) is a geographically distributed network of proxy servers and data centres that caches and serves web content from locations physically close to end users, reducing latency, relieving origin server load, and improving resilience against traffic spikes and denial-of-service attacks. CDNs operate through anycast routing, edge caching policies, and real-time traffic steering algorithms to deliver optimal user experience across diverse network conditions."@en ;
    rdfs:subClassOf ngm:content-delivery-network ;
    vc:enables ngm:bandwidth-optimization,
        ngm:latency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:content-delivery-network-cdn,
        ngm:internet-infrastructure ;
    vc:slug "cdn" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:network-protocol,
        ngm:network-security .

ngm:ce-marking a owl:Class ;
    rdfs:label "CE Marking"@en ;
    rdfs:comment "CE marking is a mandatory conformity mark indicating that a product placed on the European Economic Area market meets the applicable EU health, safety, and environmental protection requirements. For machinery and robots it signals compliance with directives such as the Machinery Regulation, the EMC Directive, and relevant harmonised standards, often supported by a declaration of conformity and technical file. It matters because it is a legal precondition for market access and embeds robot safety standards into commercial deployment."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard ;
    vc:slug "ce-marking" ;
    vc:sourceDomain "robotics" .

ngm:chainlink a owl:Class ;
    rdfs:label "Chainlink"@en ;
    rdfs:comment "Chainlink is a decentralised oracle network and middleware layer that enables smart contracts on any blockchain to securely access off-chain data, computation, and cross-chain interoperability services. Founded in 2017 by Sergey Nazarov and Steve Ellis, it operates a network of independent node operators who retrieve, aggregate, and deliver external data — including price feeds, verifiable randomness, API responses, and event outcomes — to on-chain smart contracts, solving the oracle problem that prevents blockchains from natively interacting with real-world information. Its native token (LINK) provides cryptoeconomic incentives and collateral for node operators, whilst its Off-Chain Reporting protocol reduces on-chain costs through peer-to-peer consensus. Beyond data feeds, Chainlink has expanded into cross-chain messaging (CCIP), on-chain automation, and verifiable computation, positioning itself as general-purpose decentralised infrastructure for the entire blockchain ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chainlink-oracles ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chainlink-ccip ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:blockchain-oracle ;
    vc:bridgesTo ngm:enterprise-data-integration,
        ngm:internet-of-things,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:api3,
        ngm:band-protocol,
        ngm:pyth-network ;
    vc:dependsOn ngm:cryptoeconomics,
        ngm:smart-contract,
        ngm:staking ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:enterprise-smart-contracts,
        ngm:on-chain-automation,
        ngm:verifiable-randomness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chainlink-automation,
        ngm:chainlink-ccip,
        ngm:chainlink-functions,
        ngm:chainlink-oracles,
        ngm:chainlink-vrf ;
    vc:isPartOf ngm:decentralized-finance-de-fi ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-messaging,
        ngm:decentralized-autonomous-organisation ;
    vc:requires ngm:cryptographic-signature,
        ngm:ethereum,
        ngm:peer-to-peer-network ;
    vc:slug "chainlink" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:defi-protocol,
        ngm:non-fungible-token,
        ngm:tokenization ;
    vc:uses ngm:decentralized-computing,
        ngm:off-chain-reporting,
        ngm:threshold-signature .

ngm:chainlink-ccip a owl:Class ;
    rdfs:label "Chainlink CCIP"@en ;
    rdfs:comment "Chainlink Cross-Chain Interoperability Protocol (CCIP) is a cross-chain messaging and token transfer standard developed by Chainlink Labs that enables smart contracts on different blockchain networks to securely send messages and transfer assets across chain boundaries, backed by a decentralised oracle network providing an independent risk management layer that monitors and validates cross-chain transactions. CCIP introduces a programmable token transfer abstraction allowing arbitrary data payloads to accompany token movements, enabling complex cross-chain application logic."@en ;
    rdfs:subClassOf ngm:cross-chain-interoperability ;
    vc:bridgesTo ngm:swift-messaging,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:cross-chain-bridge,
        ngm:ibc-protocol,
        ngm:layerzero,
        ngm:wormhole ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-defi,
        ngm:cross-chain-messaging,
        ngm:programmable-token-transfer,
        ngm:tokenised-real-world-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:commit-store,
        ngm:offramp-contract,
        ngm:onramp-contract,
        ngm:risk-management-network ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:decentralised-finance,
        ngm:oracle-network,
        ngm:token-bridge ;
    vc:requires ngm:evm-compatible-blockchain,
        ngm:link-token ;
    vc:slug "chainlink-ccip" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-oracle,
        ngm:chainlink-oracles,
        ngm:decentralised-oracle-network,
        ngm:merkle-tree,
        ngm:smart-contract .

ngm:chatbot a owl:Class ;
    rdfs:label "Chatbot"@en ;
    rdfs:comment "A software application designed to simulate conversation with human users, processing natural-language input through rule-based, retrieval-based, or generative mechanisms to produce contextually appropriate responses. Modern chatbots are predominantly built on large language models, enabling open-domain dialogue, multi-turn context tracking, and task execution across text and voice interfaces. They serve as the primary user-facing layer of conversational AI systems, integrating intent recognition, dialogue management, and response generation into a coherent interaction loop. Deployment contexts range from narrow-domain customer support and virtual assistants to general-purpose AI agents capable of reasoning, tool use, and multi-step problem solving."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intent-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:conversational-ai ;
    vc:bridgesTo ngm:api-gateway,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:ai-agent,
        ngm:rule-based-system ;
    vc:dependsOn ngm:knowledge-base,
        ngm:language-model ;
    vc:enables ngm:customer-service-automation,
        ngm:question-answering,
        ngm:virtual-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:context-window,
        ngm:intent-recognition,
        ngm:response-generation ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:named-entity-recognition,
        ngm:sentiment-analysis,
        ngm:text-classification ;
    vc:requires ngm:dialogue-management,
        ngm:intent-recognition,
        ngm:natural-language-processing ;
    vc:slug "chatbot" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:multi-turn-conversation,
        ngm:personalisation ;
    vc:uses ngm:large-language-models,
        ngm:retrieval-augmented-generation,
        ngm:speech-recognition,
        ngm:transformer-architecture .

ngm:cloud-security a skos:Concept ;
    rdfs:label "Cloud Security"@en .

ngm:cncf a owl:Class ;
    rdfs:label "CNCF"@en ;
    rdfs:comment "The Cloud Native Computing Foundation (CNCF) is a vendor-neutral, open-source foundation established in 2015 under the Linux Foundation to steward cloud-native software projects including Kubernetes, Prometheus, Envoy, and over 150 additional hosted projects. CNCF defines cloud-native computing as building and running scalable applications in modern, dynamic environments such as public, private, and hybrid clouds using techniques including containers, microservices, and declarative APIs. The Foundation operates a Technical Oversight Committee (TOC) that governs project acceptance through sandbox, incubating, and graduated maturity stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kubernetes ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-telemetry ],
        ngm:linux-foundation ;
    vc:enables ngm:cloud-native-applications,
        ngm:microservices-architecture,
        ngm:open-source-software ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:kubernetes,
        ngm:open-telemetry ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:microservices,
        ngm:standards-body,
        ngm:technical-standards ;
    vc:slug "cncf" ;
    vc:sourceDomain "infrastructure" .

ngm:collaboration-tools a owl:Class ;
    rdfs:label "Collaboration Tools"@en ;
    rdfs:comment "Software that supports people working together on shared tasks or documents, including communication, coordination and concurrent editing features."@en ;
