ngm:combinatorial-optimisation a owl:Class ;
    rdfs:comment "Combinatorial optimisation is the study of finding an optimal object from a finite but typically enormous set of discrete candidate solutions. Problems are defined over discrete structures such as graphs, permutations and integer assignments, and many are NP-hard, meaning no known algorithm solves all instances efficiently. Practical approaches combine exact methods, approximation algorithms and metaheuristics to obtain good solutions within acceptable time bounds."@en ;
    rdfs:label "Combinatorial Optimisation"@en ;
    rdfs:subClassOf ngm:mathematical-optimisation ;
    rdfs:subClassOf ngm:optimisation ;
