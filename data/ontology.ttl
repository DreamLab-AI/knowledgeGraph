ngm:digital-signal-processor a owl:Class ;
    rdfs:label "Digital Signal Processor"@en ;
    rdfs:comment "A digital signal processor (DSP) is a specialised microprocessor architecture optimised for the high-throughput numerical operations of digital signal processing, such as multiply-accumulate, filtering and fast transforms. DSPs feature hardware support for fixed and floating-point arithmetic, parallel datapaths and efficient memory access to process audio, sensor and communication signals in real time at low power. They are a core building block of audio systems, embedded devices and spatial computing hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:microcontroller ],
        ngm:audio-system ;
    vc:enables ngm:audio-codec,
        ngm:head-related-transfer-function,
        ngm:microphone-array ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:microcontroller ;
    vc:implements ngm:binaural-audio ;
    vc:isPartOf ngm:audio-system,
        ngm:embedded-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:energy-efficiency,
        ngm:sensor-fusion ;
    vc:slug "digital-signal-processor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:audio-codec,
        ngm:spatial-audio,
        ngm:speech-recognition ;
    vc:uses ngm:digital-signal-processing,
        ngm:signal-processing .

