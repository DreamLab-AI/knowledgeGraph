ngm:proof-of-spacetime a owl:Class ;
    rdfs:label "Proof Of Spacetime"@en ;
    rdfs:comment "Proof of Spacetime (PoSt) is a cryptographic consensus mechanism in which a participant repeatedly proves that it has continuously stored a specific set of data over a period of time, rather than expending computation as in proof of work. Used by decentralised storage networks such as Filecoin, it combines storage proofs with time-based challenges so that providers cannot reclaim space without losing the ability to answer. This ties block production and rewards to verifiable, useful storage capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:proof-of-reserves ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:decentralized-storage ;
    vc:enables ngm:decentralized-storage,
        ngm:file-storage ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptographic-proof ;
    vc:implements ngm:consensus-mechanism,
        ngm:decentralized-storage ;
    vc:isPartOf ngm:consensus-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus,
        ngm:ipfs,
        ngm:replication ;
    vc:requires ngm:cryptographic-proof ;
    vc:slug "proof-of-spacetime" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:block-reward,
        ngm:filecoin ;
    vc:uses ngm:cryptographic-proof,
        ngm:verifiable-computation .

ngm:proof-of-work-energy-consumption a owl:Class ;
    rdfs:label "Proof-of-Work Energy Consumption"@en ;
    rdfs:comment "Proof-of-work energy consumption is the electricity used by miners performing the computational hashing that secures proof-of-work blockchains such as Bitcoin. Because security scales with aggregate hashpower, energy use rises with price and competition, making it a central environmental and policy concern. It is tracked by indices that estimate network-wide power draw and carbon footprint."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-environmental-issues,
        ngm:cbeci ;
    vc:slug "proof-of-work-energy-consumption" ;
    vc:sourceDomain "blockchain" .

ngm:proof-system a owl:Class ;
    rdfs:label "Proof System"@en ;
    rdfs:comment "A Proof System is a formal cryptographic or logical framework that enables a prover to convince a verifier that a statement is true, often without revealing the underlying witness or private data. Modern cryptographic proof systems include zero-knowledge proofs, interactive proof systems, and SNARKs, which are foundational to privacy-preserving authentication and blockchain scalability. They provide mathematical guarantees of soundness and completeness under well-defined computational assumptions."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:zero-knowledge-proof ;
    vc:slug "proof-system" ;
    vc:sourceDomain "infrastructure" .

ngm:property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "In the context of AI systems and ontological engineering, a Property is a named attribute or characteristic that describes a measurable or observable quality of an entity, concept, or system component. Properties may be data properties (mapping an individual to a literal value such as a number or string) or object properties (relating an individual to another individual within the knowledge graph). In AI safety and governance contexts, properties such as fairness, robustness, and interpretability are the formal targets of evaluation and certification requirements."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ontology-structure ;
