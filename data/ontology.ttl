# Cryptographic Primitive
blockchain:CryptographicPrimitive rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Cryptography ;
    rdfs:label "Cryptographic Primitive"@en ;
    rdfs:comment "The fundamental building blocks of cryptography upon which more complex cryptographic algorithms, protocols, and systems are constructed. Primitives include hash functions, encryption algorithms, digital signatures, message authentication codes, and key exchange protocols, each providing specific security properties but requiring combination in security protocols to address multiple security requirements."@en ;
    skos:prefLabel "Cryptographic Primitive"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:cryptographic-primitive" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:cryptographic-primitive> ;
    vcw:contentHash "sha256-12-050f770fd6d2" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-7004" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-7004" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
