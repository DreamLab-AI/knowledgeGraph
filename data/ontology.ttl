        ngm:large-scale-pretrained-foundation-model,
        ngm:multimodal-ai-architecture-reasoning,
        ngm:protein-structure-prediction,
        ngm:speech-recognition ;
    vc:uses ngm:flash-attention,
        ngm:kv-cache,
        ngm:multi-head-attention,
        ngm:rotary-position-embedding,
        ngm:scaled-dot-product-attention .

ngm:caching a owl:Class ;
    rdfs:label "Caching"@en ;
    rdfs:comment "Caching is the technique of storing copies of frequently accessed data or computed results in a faster, closer storage tier so that subsequent requests can be served without repeating the expensive original operation. It trades additional memory or storage for reduced latency and lower load on backend systems, governed by policies for placement, expiry and invalidation. Caches appear at every layer of a system, from CPU registers and operating systems to content delivery networks and application-level stores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:performance-optimization ;
    vc:bridgesTo ngm:content-delivery-network ;
    vc:contrastsWith ngm:in-memory-computing ;
    vc:dependsOn ngm:memory-management ;
    vc:enables ngm:latency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:content-delivery-network ;
    vc:isPartOf ngm:performance-optimization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:distributed-systems,
        ngm:edge-computing,
        ngm:load-balancing ;
    vc:slug "caching" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:scalability,
        ngm:throughput ;
    vc:uses ngm:memory-management,
        ngm:state-management .

ngm:confidential-computing a owl:Class ;
    rdfs:label "Confidential Computing"@en ;
    rdfs:comment "A hardware-based security paradigm that protects data in use by isolating computation within trusted execution environments (TEEs) backed by processor security extensions (Intel SGX, AMD SEV, ARM TrustZone). It extends encryption from data at rest and in transit to data actively being processed, preventing access even by privileged software, hypervisors, or cloud providers. Key AI applications include secure model training, private inference, and TEE-protected federated learning aggregation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:remote-attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-enclave ],
        ngm:hardware-security ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin ;
    vc:contrastsWith ngm:transport-layer-security ;
    vc:dependsOn ngm:amd-sev,
        ngm:arm-trust-zone,
        ngm:intel-sgx ;
    vc:enables ngm:federated-learning,
        ngm:privacy-preserving-machine-learning,
        ngm:private-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:remote-attestation,
        ngm:secure-enclave,
        ngm:trusted-execution-environment ;
    vc:implements ngm:zero-trust-architecture ;
    vc:isPartOf ngm:cloud-security ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-security,
        ngm:cybersecurity,
        ngm:data-security ;
    vc:requires ngm:memory-encryption ;
    vc:slug "confidential-computing" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:confidential-computing-consortium ;
    vc:supports ngm:gdpr-compliance,
        ngm:hardware-security-module ;
    vc:uses ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation .

ngm:constitutional-ai-training-methodology-language-model-family a owl:Class ;
    rdfs:label "Constitutional AI Language Model Family"@en ;
    rdfs:comment "Anthropic Claude is a family of large language models developed by Anthropic PBC, designed around Constitutional AI principles that prioritise safety, helpfulness, and honesty. The model series spans Claude Instant, Claude 2, Claude 3 (Haiku, Sonnet, Opus), and Claude 3.5, with each generation advancing reasoning, coding, and multilingual capabilities. Claude is distinguished by its long context windows (up to 200k tokens in Claude 3) and its training methodology that emphasises harmlessness through RLHF and Constitutional AI feedback loops."@en ;
    rdfs:subClassOf ngm:proprietary-large-language-models ;
    vc:contrastsWith ngm:gemini-multimodal-language-model,
        ngm:instruction-following-conversational-ai-system ;
    vc:dependsOn ngm:deep-learning,
