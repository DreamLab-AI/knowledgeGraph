    vc:slug "interoperability-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cross-chain-messaging,
        ngm:digital-asset-ecosystem,
        ngm:spatial-computing .

ngm:iso-ts-15066 a owl:Class ;
    rdfs:label "ISO TS 15066"@en ;
    rdfs:comment "ISO/TS 15066:2016 is an ISO Technical Specification that supplements ISO 10218-1 and ISO 10218-2 by providing detailed guidance and biomechanical data for the safety of collaborative robot applications in which industrial robots and human workers share a common workspace without a physical separating guard. It defines four collaboration modes — safety-rated monitored stop, hand guiding, speed and separation monitoring, and power and force limiting — along with body-part-specific pain thresholds that govern permissible contact forces and pressures. The specification is a foundational reference for cobot risk assessment and CE marking under the EU Machinery Directive."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:iso-10218,
        ngm:robot-safety ;
    vc:slug "iso-ts-15066" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:collaborative-robot ;
    vc:supports ngm:force-control,
        ngm:human-robot-interaction .

ngm:json-schema a owl:Class ;
    rdfs:label "JSON Schema"@en ;
    rdfs:comment "JSON Schema is an IETF-standardised declarative vocabulary for annotating and validating the structure, data types, required fields, and value constraints of JSON documents. It enables machine-readable contracts between API producers and consumers by expressing rules such as property types, enumerated values, pattern matching, minimum/maximum boundaries, and composition via allOf, anyOf, and oneOf combiners. JSON Schema is widely used in REST API description languages, configuration file validation, and as the basis for verifiable credential schemas in decentralised identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json ],
        ngm:ai-technique,
        ngm:data-format-standard ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:credential-schema,
        ngm:rest-api ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-format,
        ngm:json-ld ;
    vc:requires ngm:json ;
    vc:slug "json-schema" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:latent-diffusion a owl:Class ;
    rdfs:label "Latent Diffusion"@en ;
    rdfs:comment "Latent Diffusion Models (LDMs) are a class of generative models that perform the iterative denoising diffusion process in the compressed latent space of a pre-trained variational autoencoder (VAE), rather than directly in pixel space. This design reduces the computational cost of training and inference by an order of magnitude whilst retaining perceptual quality, because the VAE encodes high-dimensional image data into a compact, semantically rich latent representation. LDMs are conditioned on text, image, or other modalities via cross-attention mechanisms inside a U-Net backbone, enabling text-to-image synthesis and image-to-image translation at practical compute budgets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-autoencoders ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:latent-space ;
    vc:requires ngm:diffusion-model,
        ngm:variational-autoencoders ;
    vc:slug "latent-diffusion" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:machine-learning-framework a owl:Class ;
    rdfs:label "Machine Learning Framework"@en ;
    rdfs:comment "Software libraries and development environments such as TensorFlow and PyTorch that provide tools, APIs, and abstractions for building, training, and deploying machine learning models used in metaverse AI applications."@en ;
    rdfs:subClassOf ngm:ai-development-tools,
        ngm:ai-infrastructure ;
    vc:enables ngm:ai-model-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "machine-learning-framework" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:monitoring-system a owl:Class ;
    rdfs:label "Monitoring System"@en ;
    rdfs:comment "A monitoring system is an integrated platform that continuously collects, aggregates, and evaluates signals from target environments — including software services, physical infrastructure, AI models, or financial markets — to detect anomalies, assess health, and trigger alerts or automated responses. It encompasses data-collection agents, time-series storage, visualisation dashboards, and alerting pipelines. Monitoring systems form a foundational layer of operational reliability for modern distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:enables ngm:ai-monitoring,
        ngm:compliance-monitoring,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-pipeline,
        ngm:monitoring-dashboard ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "monitoring-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-analytics,
        ngm:open-telemetry,
        ngm:predictive-analytics .

ngm:network-architecture a owl:Class ;
    rdfs:label "Network Architecture"@en ;
    rdfs:comment "The structural design of a neural network, specifying the arrangement of layers, connection patterns, activation functions, skip connections, normalisation methods, and attention mechanisms. Key architectures include feedforward networks, CNNs, RNNs, transformers, and graph neural networks; Neural Architecture Search automates discovery of optimal configurations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:attention-mechanism,
        ngm:neural-network-layer ;
    vc:implements ngm:neural-network,
        ngm:transformers ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:model-weights ;
    vc:slug "network-architecture" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:network-connectivity a owl:Class ;
    rdfs:label "Network Connectivity"@en ;
    rdfs:comment "Network Connectivity describes the ability of computing nodes, devices, or systems to establish, maintain, and exchange data across communication links, whether within a local area network, wide area network, or across heterogeneous internet topologies. It encompasses the physical layer (cables, wireless signals), logical addressing, routing protocols, and transport-layer reliability guarantees that together enable end-to-end data delivery. In distributed and blockchain contexts, network connectivity is a prerequisite for peer discovery, transaction propagation, and consensus participation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:edge-computing,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-infrastructure,
        ngm:network-topology ;
    vc:requires ngm:network-protocol ;
    vc:slug "network-connectivity" ;
    vc:sourceDomain "blockchain" .

ngm:power-supply a owl:Class ;
    rdfs:label "Power Supply"@en ;
    rdfs:comment "A power supply unit (PSU) is an internal hardware component that converts alternating current (AC) from mains electricity into regulated low-voltage direct current (DC) required by computing equipment's internal components including motherboard, CPU, GPU, and storage devices."@en ;
    rdfs:subClassOf ngm:hardware-component,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:continuous-operation,
        ngm:system-reliability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "power-supply" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:infrastructure .

ngm:procedural-generation a owl:Class ;
    rdfs:label "Procedural Generation"@en ;
    rdfs:comment "Procedural Generation is the algorithmic creation of content — including terrain, textures, vegetation, buildings, and narrative elements — using mathematical functions, noise algorithms, and rule-based systems rather than manual authoring. It is foundational to scalable world-building in games and metaverse platforms, enabling vast, varied environments from compact seed parameters."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:procedural-terrain,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:generative-ai ;
    vc:slug "procedural-generation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-content-generation,
        ngm:noise-function-library .

ngm:quantum-computing a owl:Class ;
    rdfs:label "Quantum Computing"@en ;
    rdfs:comment "A paradigm of computation that exploits quantum-mechanical phenomena—superposition, entanglement, and interference—to perform certain calculations exponentially faster than classical computers. Quantum computing holds particular relevance for cryptography, optimisation, simulation of molecular systems, and potentially accelerating machine learning workloads, though near-term devices remain limited by qubit decoherence and error rates."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:cryptography ;
    vc:enables ngm:encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:distributed-systems,
        ngm:machine-learning ;
    vc:slug "quantum-computing" ;
    vc:sourceDomain "infrastructure" .

ngm:robot-kinematics a owl:Class ;
    rdfs:label "Robot Kinematics"@en ;
    rdfs:comment "Robot Kinematics is the mathematical study of the geometry of robot motion—comprising forward kinematics (mapping joint parameters to end-effector pose) and inverse kinematics (computing joint configurations that achieve a desired pose)—without regard to the forces or torques that produce that motion. It is foundational to robot programming, trajectory planning, and the design of manipulation systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:service-robot,
        ngm:surgical-robot ;
    vc:slug "robot-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:self-attention a owl:Class ;
    rdfs:label "Self Attention"@en ;
    rdfs:comment "An attention mechanism where every token in a sequence attends to every other token in the same sequence, allowing the model to capture intra-sequence dependencies."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:transformer ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:reinforcement-learning ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism ;
    vc:slug "self-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:sensor-data a owl:Class ;
    rdfs:label "Sensor Data"@en ;
    rdfs:comment "Sensor data comprises the raw or pre-processed digital measurements produced by physical transducers—including cameras, LiDAR scanners, inertial measurement units (IMUs), ultrasonic rangers, and microphones—that encode observable properties of the environment such as geometry, colour, acceleration, and sound. In robotic and autonomous systems, sensor data forms the primary input to perception pipelines responsible for state estimation, object detection, and scene understanding. Data quality characteristics including frame rate, resolution, noise floor, and synchronisation latency directly constrain the capabilities of downstream algorithms such as SLAM, sensor fusion, and learned perception models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:camera,
        ngm:imu,
        ngm:lidar ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "sensor-data" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:perception-system .

ngm:single-sign-on a owl:Class ;
    rdfs:label "Single Sign-On"@en ;
    rdfs:comment "Single Sign-On (SSO) is an authentication scheme that allows a user to authenticate once to a central identity provider and obtain delegated access tokens that grant entry to multiple related but independent service providers without re-entering credentials. Common protocol implementations include SAML 2.0, OAuth 2.0 with OpenID Connect, and Kerberos, each varying in how assertions are encoded and transported. SSO reduces credential exposure, simplifies user lifecycle management, and is a foundational component of enterprise identity and access management (IAM) platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-standards ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:federated-credential-exchange ;
    vc:requires ngm:authentication,
        ngm:authentication-standards ;
    vc:slug "single-sign-on" ;
    vc:sourceDomain "infrastructure" .

ngm:structure-from-motion a owl:Class ;
    rdfs:label "Structure-from-Motion"@en ;
    rdfs:comment "Structure-from-Motion (SfM) is a photogrammetric pipeline that simultaneously estimates three-dimensional scene structure and camera motion parameters from an unordered set of overlapping two-dimensional images. Feature detection and matching across images (typically using descriptors such as SIFT or ORB) establishes correspondences, which are fed into bundle adjustment to jointly optimise point-cloud coordinates and camera extrinsics and intrinsics. SfM is foundational in photogrammetry, autonomous navigation, and AR/VR asset creation, producing dense or sparse 3D reconstructions from passive imagery alone."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:depth-estimation,
        ngm:point-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:slam,
        ngm:visual-odometry ;
    vc:slug "structure-from-motion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision .

ngm:trustworthy-ai a owl:Class ;
    rdfs:label "Trustworthy AI"@en ;
    rdfs:comment "Trustworthy AI refers to artificial intelligence systems that are designed, developed, and deployed in accordance with a structured set of properties including lawfulness, ethical soundness, robustness, fairness, transparency, and accountability, ensuring they operate reliably and safely in their intended context. The concept is codified in frameworks such as the EU High-Level Expert Group's guidelines on Trustworthy AI and operationalised through the EU AI Act's risk-tiered obligations. Trustworthy AI requires meaningful human oversight mechanisms, explainable decision processes, bias monitoring, and documented accountability chains across the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:responsible-ai ;
    vc:requires ngm:explainable-ai,
        ngm:human-oversight ;
    vc:slug "trustworthy-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness,
        ngm:transparency .

ngm:web3 a owl:Class ;
    rdfs:label "Web3"@en ;
    rdfs:comment "Web3 is a blockchain-anchored paradigm for the decentralised web, first coined by ereum co-founder Gavin Wood in his April 2014 essay \"DApps: What Web 3.0 Looks Like\", that reconceives the internet as a zero-trust interaction system eliminating the need to trust any individual institution or plat..."@en ;
