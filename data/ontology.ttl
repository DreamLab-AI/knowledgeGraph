    vc:contrastsWith ngm:centralised-learning,
        ngm:data-pooling ;
    vc:dependsOn ngm:distributed-computing,
        ngm:noise-mechanisms ;
    vc:enables ngm:collaborative-systems-modality-learning,
        ngm:data-minimisation,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:trusted-execution-environment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:membership-inference,
        ngm:model-inversion,
        ngm:responsible-ai ;
