    vc:relatedTo ngm:model-performance ;
    vc:slug "inference-cost-efficiency" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:inference-economics a owl:Class ;
    rdfs:comment "The study of costs, margins, and pricing strategies associated with running AI model inference, including token pricing and provider profitability."@en ;
    rdfs:label "Inference Economics"@en ;
    rdfs:subClassOf ngm:data ;
