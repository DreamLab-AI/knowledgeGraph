        <urn:visionflow:linked:schema-org>,
        <urn:visionflow:linked:sparql>,
        <urn:visionflow:linked:trans-e>,
        vf:algorithmic-bias-and-variance ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
