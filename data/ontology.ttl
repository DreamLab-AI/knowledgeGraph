ngm:monetary-sovereignty a owl:Class ;
    rdfs:label "Monetary Sovereignty"@en ;
    rdfs:comment "A nation's authority to control its monetary policy, currency issuance, and financial systems, increasingly challenged by digital currencies and defended through initiatives like Central Bank Digital Currencies (CBDCs) that assert state control over the evolving digital economy."@en ;
