ngm:event-loop a owl:Class ;
    rdfs:comment "An event loop is a programming construct that waits for and dispatches events or messages within a single-threaded execution model, repeatedly polling a queue of pending tasks and invoking their associated handlers. It is the engine of asynchronous, non-blocking programming, allowing a program to perform I/O and respond to many concurrent events without spawning a thread per operation. Event loops underpin runtime environments, user-interface frameworks, and high-concurrency network servers."@en ;
    rdfs:label "Event Loop"@en ;
    rdfs:subClassOf ngm:concurrency ;
    rdfs:subClassOf ngm:execution-model ;
    rdfs:subClassOf _:r10058 ;
    rdfs:subClassOf _:r10059 ;
