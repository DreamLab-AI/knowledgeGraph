ngm:algorithmic-auditing a owl:Class ;
    rdfs:label "Algorithmic Auditing"@en ;
    rdfs:comment "Algorithmic auditing is the systematic evaluation of automated decision-making systems to assess their fairness, accuracy, transparency, and compliance with ethical and legal standards. It involves independent or internal review of training data, model architectures, outputs, and operational impacts. The discipline has emerged as a response to concerns about bias, discrimination, and opacity in AI-driven systems. Audits may be prospective, examining systems before deployment, or retrospective, investigating outcomes in production. Results are used to inform regulation, remediation, and public accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:ai-governance ;
    vc:bridgesTo ngm:data-governance,
        ngm:security-audit ;
    vc:contrastsWith ngm:black-box-ai,
        ngm:self-certification ;
    vc:enables ngm:accountability,
        ngm:regulatory-compliance,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eu-ai-act-regulatory-instrument,
        ngm:nist-ai-rmf ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:algorithmic-accountability,
        ngm:algorithmic-bias ;
    vc:requires ngm:audit-trail,
        ngm:transparency ;
    vc:slug "algorithmic-auditing" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-42001 ;
    vc:supports ngm:accountability,
        ngm:ai-governance-framework,
        ngm:ai-regulation ;
    vc:uses ngm:bias-detection-methods,
        ngm:counterfactual-analysis,
        ngm:explainable-ai,
        ngm:statistical-testing .

ngm:apache-kafka a owl:Class ;
    rdfs:label "Apache Kafka"@en ;
    rdfs:comment "Apache Kafka is an open-source distributed event streaming platform originally developed at LinkedIn and donated to the Apache Software Foundation in 2011. It provides a high-throughput, low-latency, fault-tolerant publish-subscribe messaging system built around an immutable, ordered, partitioned commit log. Kafka decouples producers and consumers of data streams, enabling real-time data pipelines, event-driven architectures, and stream processing applications at scale across thousands of nodes handling trillions of events per day."@en ;
    rdfs:subClassOf ngm:distributed-system ;
    vc:dependsOn ngm:distributed-architecture,
        ngm:software-infrastructure ;
    vc:enables ngm:data-lake,
        ngm:etl-pipeline,
        ngm:machine-learning-discipline-pipeline,
        ngm:microservices-architecture,
        ngm:real-time ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-integration,
        ngm:data-pipeline,
        ngm:distributed-systems,
        ngm:event-driven-architecture,
        ngm:real-time-processing ;
    vc:slug "apache-kafka" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:monitoring-dashboard ;
    vc:uses ngm:batch-processing,
        ngm:data-processing,
        ngm:distributed-computing .

