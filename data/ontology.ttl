        ngm:high-level-synthesis ;
    vc:slug "fpga" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:autonomous-robot,
        ngm:digital-twin,
        ngm:edge-ai ;
    vc:uses ngm:partial-reconfiguration .

ngm:gpt a owl:Class ;
    rdfs:label "GPT"@en ;
    rdfs:comment "Generative Pre-trained Transformer: an autoregressive language model that uses transformer decoder architecture and is pre-trained on large text corpora using next-token prediction. GPT models learn rich representations through unsupervised pre-training and are subsequently fine-tuned for diverse downstream NLP tasks, demonstrating that scale and the language modelling objective yield powerful transfer learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:ai-safety,
        ngm:multimodal-ai ;
    vc:contrastsWith ngm:bert,
        ngm:encoder-decoder-architecture ;
    vc:dependsOn ngm:large-language-models,
        ngm:neural-scaling-laws,
        ngm:unsupervised-learning ;
    vc:enables ngm:code-generation,
        ngm:conversational-ai,
        ngm:few-shot-learning,
        ngm:natural-language-processing,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:feed-forward-network,
        ngm:self-attention-layer ;
    vc:implements ngm:causal-language-modelling,
        ngm:decoder-only-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatgpt,
        ngm:fine-tuning,
        ngm:prompt-engineering ;
    vc:slug "gpt" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
