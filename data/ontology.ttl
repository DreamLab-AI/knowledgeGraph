ngm:compliance-management a owl:Class ;
    rdfs:label "Compliance Management"@en ;
    rdfs:comment "Compliance Management is the systematic process by which organisations identify, assess, implement, and monitor adherence to applicable laws, regulations, standards, and internal policies. It encompasses the full lifecycle of obligation tracking, control design, evidence collection, and reporting to demonstrate that operational activities conform to required norms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
