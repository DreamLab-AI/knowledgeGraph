    vc:requires ngm:kalman-filter,
        ngm:sensor-fusion ;
    vc:slug "tele-157-predictive-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:tele-252-dao-governance-telecollaboration a owl:Class ;
    rdfs:label "TELE-252-dao-governance-telecollaboration"@en ;
    rdfs:comment "DAO governance for telecollaboration is the use of decentralised autonomous organisation mechanisms, such as token-weighted or membership voting, to coordinate decisions and resource allocation within distributed collaborative communities."@en ;
