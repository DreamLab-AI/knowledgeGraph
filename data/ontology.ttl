ngm:metaverse-application-platform a owl:Class ;
    rdfs:label "Metaverse Application Platform"@en ;
    rdfs:comment "Development environments and SDKs built on engines like Unity and Unreal that provide tools, APIs, and frameworks for creating immersive 3D applications, virtual worlds, and blockchain-integrated experiences for the metaverse."@en ;
