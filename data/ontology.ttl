        ngm:benchmark-standard,
        ngm:computational-neuroscience,
        ngm:deep-learning,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:slug "neur-ips" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-ethics,
        ngm:fairness-in-machine-learning,
        ngm:open-science .

ngm:raft a owl:Class ;
    rdfs:label "Raft"@en ;
    rdfs:comment "Raft is a distributed consensus algorithm designed explicitly for understandability, introduced by Diego Ongaro and John Ousterhout at USENIX ATC 2014 as a more comprehensible alternative to the Paxos family of protocols. Raft decomposes the consensus problem into three relatively independent sub-problems: leader election, log replication, and safety. A Raft cluster maintains a replicated log of commands through a strong leader that serialises all writes; followers replicate the leader's log entries and redirect client requests. Leader election uses randomised timeouts to avoid split votes. Raft has become the dominant consensus algorithm in modern distributed systems infrastructure, underpinning etcd, CockroachDB, TiKV, Consul, and many other widely deployed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistent-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:consensus-algorithm ;
    vc:bridgesTo ngm:blockchain-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerant-system,
        ngm:paxos ;
    vc:enables ngm:distributed-ledger-technology,
        ngm:distributed-system-architecture,
        ngm:fault-tolerance-system,
        ngm:high-availability,
        ngm:linearizability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:crash-fault-tolerance,
        ngm:leader-election,
        ngm:log-replication ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-protocol,
        ngm:raft-consensus,
        ngm:state-machine-replication ;
    vc:requires ngm:persistent-storage,
        ngm:quorum ;
    vc:slug "raft" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:cockroachdb,
        ngm:consul,
        ngm:etcd ;
    vc:uses ngm:data-replication,
        ngm:distributed-system,
        ngm:heartbeat-mechanism,
        ngm:quorum,
        ngm:remote-procedure-call .

ngm:random-number-generator a owl:Class ;
    rdfs:label "Random Number Generator"@en ;
    rdfs:comment "A random number generator (RNG) produces sequences of numbers that lack predictable pattern, either through deterministic algorithms seeded from an initial state (pseudo-random) or from physical entropy sources (true random). RNGs are essential to stochastic sampling, Monte Carlo methods, simulation, and cryptographic key generation. Quality is judged by statistical uniformity, period length, and, for security uses, unpredictability."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:particle-filter,
        ngm:sampling ;
    vc:slug "random-number-generator" ;
    vc:sourceDomain "infrastructure" .

ngm:recommendation-systems a owl:Class ;
    rdfs:label "Recommendation Systems"@en ;
    rdfs:comment "Recommendation Systems are information filtering systems that predict a user's preference for items—products, content, services—and surface the most relevant items from a large catalogue. They are categorised into collaborative filtering (leveraging the behaviour of similar users), content-based filtering (matching item attributes to user profiles), and hybrid approaches that combine both. Modern large-scale recommendation systems employ deep learning architectures, embedding models, and two-tower neural networks trained on implicit feedback signals such as clicks, watch-time, and purchases. Recommendation systems are among the highest-impact machine learning applications in commercial technology, driving substantial fractions of revenue at platforms such as Netflix, Amazon, YouTube, and Spotify, while also raising significant concerns about filter bubbles, engagement maximisation harms, and algorithmic amplification of misinformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-filtering ],
        ngm:machine-learning-discipline ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:digital-services-act ;
    vc:contrastsWith ngm:information-retrieval,
        ngm:search-engine ;
    vc:dependsOn ngm:deep-learning,
        ngm:vector-database ;
    vc:enables ngm:content-discovery,
        ngm:hyper-personalisation,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:candidate-generation,
        ngm:collaborative-systems-modality-filtering,
        ngm:content-based-filtering ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-amplification,
        ngm:filter-bubble,
        ngm:machine-learning-discipline-model,
        ngm:recommendation-engine ;
    vc:requires ngm:feature-engineering,
        ngm:implicit-feedback ;
    vc:slug "recommendation-systems" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:embedding-model,
        ngm:graph-neural-network,
        ngm:machine-learning-discipline-pipeline,
        ngm:matrix-factorisation,
        ngm:nearest-neighbor-search,
        ngm:two-tower-neural-network .

ngm:relayer a owl:Class ;
    rdfs:label "Relayer"@en ;
    rdfs:comment "Infrastructure operator that facilitates cross-chain message passing by monitoring source chains for events, generating cryptographic proofs of state, and submitting verified transactions to destination chains. Relayers provide non-custodial connectivity for interoperability protocols such as IBC, LayerZero, and Chainlink CCIP without holding user assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
