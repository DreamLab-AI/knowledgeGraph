ngm:waterfall-model a owl:Class ;
    rdfs:label "Waterfall Model"@en ;
    rdfs:comment "The waterfall model is a sequential software development methodology in which progress flows downward through distinct phases such as requirements, design, implementation, verification, and maintenance. Each phase is completed and signed off before the next begins, producing extensive documentation at every gate. It offers predictability and clear milestones but assumes requirements are stable and discovered early, which limits its ability to absorb change."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:requirements-engineering ],
        ngm:project-management ;
    vc:contrastsWith ngm:agile-methodology,
        ngm:devops ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:project-management,
        ngm:software-development ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:project-management,
        ngm:quality-assurance,
        ngm:software-development ;
    vc:requires ngm:requirements-engineering,
        ngm:software-architecture ;
    vc:slug "waterfall-model" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:risk-management ;
    vc:uses ngm:quality-assurance,
        ngm:software-testing .

ngm:wearable-robotics a owl:Class ;
    rdfs:label "Wearable Robotics"@en ;
    rdfs:comment "Wearable robotics encompasses powered mechanical systems worn on or attached to the human body to augment, assist or restore physical capability. These devices, including exoskeletons and powered orthoses, sense the wearer's intent and motion and deliver coordinated actuation in real time to support movement, reduce effort or rehabilitate impaired function. The field integrates biomechanics, control engineering, sensing and human-robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biomechanics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:prosthetics,
        ngm:soft-robotics ;
    vc:dependsOn ngm:robotics ;
    vc:enables ngm:assistive-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator,
        ngm:force-sensor,
        ngm:sensor ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:exoskeleton,
        ngm:robo-human-robot-interaction ;
    vc:requires ngm:biomechanics,
        ngm:kinematics ;
    vc:slug "wearable-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:haptics,
        ngm:sensor-fusion .

ngm:web-access-control a owl:Class ;
    rdfs:label "Web Access Control"@en ;
    rdfs:comment "Web Access Control (WAC) is a decentralised authorisation system for web resources that uses RDF-based access control lists to specify which agents may read, write, append, or control linked-data resources identified by URIs. It is a core mechanism in the Solid ecosystem, letting individuals govern access to their personal data pods using WebID-based identity. WAC decouples authorisation from any central server, aligning with self-sovereign data principles."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:solid ;
    vc:slug "web-access-control" ;
    vc:sourceDomain "security" .

ngm:web-rtc-w-3-c-specification a owl:Class ;
    rdfs:label "WebRTC W3C Specification"@en ;
    rdfs:comment "A W3C specification defining WebRTC, an API enabling real-time peer-to-peer audio, video and data communication between browsers. It defines the JavaScript interfaces for media and data transport."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "web-rtc-w-3-c-specification" ;
    vc:sourceDomain "standards" .

ngm:web-services a owl:Class ;
    rdfs:label "Web Services"@en ;
    rdfs:comment "Web services are software components that expose machine-to-machine functionality over a network using standardised protocols and data formats. They enable interoperable application integration across heterogeneous platforms by defining contracts (interface descriptions), message envelopes, and transport bindings independent of the implementing technology. Web services encompass both the older SOAP/WSDL stack and lightweight RESTful styles, and underpin service-oriented and microservice architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soap ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:api,
        ngm:service-oriented-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:soap,
        ngm:web-services-description-language ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-specification,
        ngm:microservices,
        ngm:rest ;
    vc:slug "web-services" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:interoperability ;
    vc:uses ngm:http,
        ngm:xml .

ngm:web-xr-api a owl:Class ;
    rdfs:label "WebXR API"@en ;
    rdfs:comment "A W3C web standard providing browser-native interfaces for rendering stereoscopic 3D content and handling spatial input from XR headsets and controllers, enabling AR/VR experiences without native application installation. WebXR supersedes the earlier WebVR specification and is implemented across Chromium-based browsers and Firefox."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-headset ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:interoperability ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:xr-hardware,
        ngm:xr-headset ;
    vc:slug "web-xr-api" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:web-technology .

ngm:web3-wallet a owl:Class ;
    rdfs:label "Web3 Wallet"@en ;
    rdfs:comment "A Web3 wallet is a software or hardware tool that manages a user's cryptographic key material and lets them hold blockchain assets, sign transactions and authenticate to decentralised applications. Unlike a custodial account, it places control of the private key with the user, who proves ownership and authorises state changes by signing locally. Web3 wallets typically expose an injected provider or connection protocol that bridges a browser or mobile app to one or more blockchain networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-custody ],
        ngm:cryptocurrency-wallet ;
    vc:contrastsWith ngm:custodial-exchange ;
    vc:enables ngm:de-fi,
        ngm:nft,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hardware-wallet,
        ngm:non-custodial-wallet,
        ngm:wallet ;
    vc:requires ngm:key-management,
        ngm:self-custody ;
    vc:slug "web3-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:ethereum,
        ngm:multisig-wallet ;
    vc:uses ngm:private-key,
        ngm:public-key,
        ngm:seed-phrase .

ngm:weights-and-biases a owl:Class ;
    rdfs:label "Weights and Biases"@en ;
    rdfs:comment "Weights & Biases (W&B) is a machine-learning experiment-tracking and MLOps platform that logs metrics, hyperparameters, model checkpoints, datasets, and system telemetry to enable reproducible and comparable training runs. It provides dashboards, artifact versioning, hyperparameter sweeps, and model-registry features that integrate with common training frameworks. W&B is widely adopted for managing and visualising the lifecycle of deep-learning experiments."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:machine-learning-discipline ;
    vc:slug "weights-and-biases" ;
    vc:sourceDomain "ai" .

ngm:whistleblower-protection a owl:Class ;
    rdfs:label "Whistleblower Protection"@en ;
    rdfs:comment "Whistleblower protection comprises legal and procedural safeguards that shield individuals who report wrongdoing, safety risks, or legal violations from retaliation such as dismissal, demotion, or harassment. In the AI-governance context, it empowers employees of AI developers to disclose information about unmitigated risks from frontier models to regulators or the public. Such provisions appear in legislation like California's frontier-AI safety bills, creating accountability channels beyond internal controls."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:california-ai-bill,
        ngm:regulatory-compliance ;
    vc:slug "whistleblower-protection" ;
    vc:sourceDomain "governance" .

ngm:wireless-hart a owl:Class ;
    rdfs:label "WirelessHART"@en ;
    rdfs:comment "WirelessHART is an open wireless communication standard for industrial process automation, built on the IEEE 802.15.4 physical layer and using time-synchronised, self-organising mesh networking with channel hopping for reliability. It extends the HART field-device protocol to wireless sensor networks in plants, providing deterministic, secure, low-power monitoring and control. Centrally managed by a network manager, it prioritises robustness against interference in harsh RF environments."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ieee-802-15-4,
        ngm:io-t-sensor-network ;
    vc:slug "wireless-hart" ;
    vc:sourceDomain "infrastructure" .

ngm:xml-schema-definition a owl:Class ;
    rdfs:label "Xml Schema Definition"@en ;
    rdfs:comment "XML Schema Definition (XSD) is a W3C-recommended language for describing and constraining the structure, content and data types of XML documents. An XSD declares permitted elements, attributes, ordering, cardinality and strongly typed values, enabling validators to confirm that an instance document conforms to an agreed contract. It supersedes the older Document Type Definition (DTD) by adding namespace awareness, a rich built-in type system and support for derivation, making it foundational to many enterprise, document and messaging standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xml ],
        ngm:data-schema ;
    vc:bridgesTo ngm:schema-registry ;
    vc:contrastsWith ngm:owl,
        ngm:rdf ;
    vc:dependsOn ngm:xml ;
    vc:enables ngm:data-validation,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:data-schema ;
    vc:isPartOf ngm:xml ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-schema,
        ngm:graph-ql,
        ngm:schema ;
    vc:requires ngm:xml ;
    vc:slug "xml-schema-definition" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:data-serialization,
        ngm:soap ;
    vc:uses ngm:xml .

ngm:yield-aggregator a owl:Class ;
    rdfs:label "Yield Aggregator"@en ;
    rdfs:comment "A yield aggregator is a decentralised-finance protocol that automatically routes deposited assets across multiple yield-bearing strategies — such as lending markets, liquidity pools, and staking — to maximise returns while compounding rewards on the user's behalf. By pooling capital and automating strategy selection, reward harvesting, and reinvestment, aggregators reduce gas costs and operational complexity for individual depositors. Modern aggregators frequently expose tokenised vault shares conforming to standards such as ERC-4626, making positions composable with the wider DeFi ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:decentralised-finance ;
    vc:dependsOn ngm:liquidity-mining ;
    vc:enables ngm:yield-farming,
        ngm:yield-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-pool,
        ngm:vault ;
    vc:implements ngm:erc-4626 ;
    vc:isPartOf ngm:de-fi,
        ngm:decentralised-finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:total-value-locked ;
    vc:slug "yield-aggregator" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:composability ;
    vc:uses ngm:automated-market-maker,
        ngm:lending-protocol,
        ngm:smart-contract,
        ngm:staking .

ngm:zero-convolution a skos:Concept ;
    rdfs:label "Zero Convolution"@en .

ngm:zero-knowledge-machine-learning a owl:Class ;
    rdfs:label "Zero-Knowledge Machine Learning"@en ;
    rdfs:comment "Cryptographic techniques enabling verification that a machine learning model executed correctly on specific inputs without revealing model weights, training data, or private inputs. ZKML bridges zero-knowledge proofs and machine learning, allowing on-chain verification of off-chain AI inference with privacy guarantees."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:ai-technique,
        ngm:machine-learning-discipline ;
    vc:dependsOn ngm:zero-knowledge-proof ;
    vc:enables ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "zero-knowledge-machine-learning" ;
    vc:sourceDomain "blockchain" .

ngm:3-d-generation a owl:Class ;
    rdfs:label "3D Generation"@en ;
    rdfs:comment "3D Generation refers to the automated or semi-automated creation of three-dimensional geometry, appearance, and scene representations using machine learning models, procedural algorithms, or hybrid approaches. Techniques include text-to-3D, image-to-3D, and scene-level generation via neural radiance fields, Gaussian splatting, diffusion models, and large multi-modal networks. The field aims to dramatically reduce the time and skill threshold required to produce photorealistic or stylised 3D content for gaming, film, spatial computing, e-commerce, digital twins, and robotics simulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-to-3-d ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mesh-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:novel-view-synthesis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-3-d-generation ],
        ngm:3-d-content-generation,
        ngm:computer-vision,
        ngm:generative-model ;
    vc:enables ngm:3-d-content-creation,
        ngm:digital-twin-generation,
        ngm:game-asset-generation,
        ngm:scene-generation,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:mesh-generation,
        ngm:neural-3-d-generation,
        ngm:novel-view-synthesis,
        ngm:text-to-3-d ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:3-d-reconstruction,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:image-generation,
        ngm:robotics ;
    vc:requires ngm:differentiable-rendering,
        ngm:gpu-compute,
        ngm:objaverse ;
    vc:slug "3-d-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:clip,
        ngm:diffusion-model,
        ngm:gaussian-splatting,
        ngm:implicit-neural-representation,
        ngm:ne-rf,
        ngm:score-distillation-sampling,
        ngm:triplane .

ngm:3-d-modeling-software a owl:Class ;
    rdfs:label "3D Modeling Software"@en ;
    rdfs:comment "3D Modeling Software is a category of applications that provide tools for constructing, editing, and organising three-dimensional geometric representations of objects and scenes, typically via polygon mesh editing, subdivision surfaces, NURBS curves, sculpting, or parametric operations. These applications underpin virtually all digital content creation workflows for games, film, architecture, product design, and XR environments. They commonly integrate texturing, rigging, animation, and basic rendering capabilities alongside the core modelling toolkit."@en ;
    rdfs:subClassOf ngm:3-d-modeling ;
    vc:enables ngm:3-d-asset,
        ngm:3-d-content-creation,
        ngm:animation-rig ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bim-software,
        ngm:cad-software,
        ngm:game-engine ;
    vc:slug "3-d-modeling-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-file-format,
        ngm:physically-based-rendering,
        ngm:shader .

ngm:academy-software-foundation a owl:Class ;
    rdfs:label "Academy Software Foundation"@en ;
    rdfs:comment "The Academy Software Foundation (ASWF) is a neutral, vendor-independent organisation, hosted under the Linux Foundation and founded with the Academy of Motion Picture Arts and Sciences, that develops and stewards open-source software for the motion picture and broader media industries. It provides shared governance, infrastructure and funding for foundational projects in visual effects, animation and digital content creation, such as OpenColorIO, OpenEXR, OpenVDB, OpenTimelineIO and MaterialX. Its goal is sustainable, interoperable open-source tooling across the production pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-source-software ],
        ngm:standards-organization ;
    vc:enables ngm:asset-pipeline,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:open-source-software ;
    vc:isPartOf ngm:linux-foundation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:film-production,
        ngm:usd ;
    vc:slug "academy-software-foundation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:animation,
        ngm:digital-content-creation,
        ngm:visual-effects ;
    vc:uses ngm:governance,
        ngm:open-source .

ngm:accessibility-audit-tool a owl:Class ;
    rdfs:label "Accessibility Audit Tool"@en ;
    rdfs:comment "An automated software utility that verifies compliance with accessibility standards (such as WCAG) in XR environments, identifying barriers for users with disabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-testing ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:compliance-verification,
        ngm:inclusive-design,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-testing,
        ngm:compliance-dashboard ;
    vc:isPartOf ngm:quality-assurance ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:accessibility-standards,
        ngm:testing ;
    vc:slug "accessibility-audit-tool" ;
    vc:sourceDomain "spatial-computing" .

ngm:accessibility-tree a owl:Class ;
    rdfs:label "Accessibility Tree"@en ;
    rdfs:comment "The Accessibility Tree is a structured, platform-independent semantic representation of a user interface that browsers and native application runtimes construct in parallel with the visual render tree, exposing each element's role, name, description, state, and value to platform accessibility APIs and programmatic automation clients. Derived from the Document Object Model by filtering out presentational and layout-only nodes, it is the authoritative conduit through which screen readers, braille displays, switch-access devices, voice-control systems, and AI browser agents perceive and interact with software interfaces without parsing raw pixels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-html ],
        ngm:human-computer-interaction,
        ngm:user-interface-model ;
    vc:enables ngm:assistive-technology,
        ngm:autonomous-task-execution,
        ngm:browser-automation,
        ngm:computer-use-and-browser-agents ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accessible-name,
        ngm:aria-role,
        ngm:aria-state,
        ngm:focus-management ;
    vc:implements ngm:core-accessibility-api-mappings,
        ngm:wcag-2-2 ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:chrome-devtools-protocol,
        ngm:computer-use-and-browser-agents,
        ngm:platform-accessibility-api ;
    vc:requires ngm:document-object-model,
        ngm:semantic-html,
        ngm:wai-aria ;
    vc:slug "accessibility-tree" ;
    vc:sourceDomain "ai" .

ngm:accessible-design a owl:Class ;
    rdfs:label "Accessible Design"@en ;
    rdfs:comment "Accessible Design is the practice of creating virtual environments and interactions usable by people with diverse disabilities, incorporating universal design principles from conception through implementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology-integration ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:inclusive-design,
        ngm:universal-design ;
    vc:enables ngm:inclusive-participation,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:assistive-technology-integration,
        ngm:user-research ;
    vc:slug "accessible-design" ;
    vc:sourceDomain "spatial-computing" .

ngm:accessible-experience a owl:Class ;
    rdfs:label "Accessible Experience"@en ;
    rdfs:comment "An Accessible Experience is a virtual environment or application delivering equivalent functionality and engagement to users with disabilities through multimodal access pathways, assistive technology integration, and Accessible Design principles, ensuring feature parity across visual, auditory, motor, and cognitive modalities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology-support ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessible-design ],
        ngm:sc-governance-and-safety,
        ngm:sc-interaction ;
    skos:broader ngm:sc-governance-and-safety,
        ngm:sc-interaction ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:telecollaboration,
        ngm:user-experience ;
    vc:contrastsWith ngm:inaccessible-design ;
