    rdfs:label "User Interface Architecture"@en ;
    rdfs:comment "The structural design and organization of user interface components, interaction patterns, and navigation systems that enable users to interact with metaverse platforms and virtual environments across different devices and modalities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
