ngm:sustainability-domain a owl:Class ;
    rdfs:label "Sustainability Domain"@en ;
    rdfs:comment "The Sustainability Domain classifies concepts concerning the environmental, social and economic effects of systems over their full lifecycle. It covers resource consumption, emissions, circularity and the measurement of long-term viability. As a top-level subject axis it provides criteria by which designs in other domains are assessed against ecological and societal limits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-footprint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circular-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:energy-efficiency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        ngm:owl-thing ;
    vc:enables ngm:emissions-reduction,
        ngm:resource-optimisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:carbon-footprint,
        ngm:circular-economy,
        ngm:energy-efficiency,
        ngm:life-cycle-assessment,
        ngm:resource-consumption ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-management-domain ;
    vc:slug "sustainability-domain" ;
    vc:sourceDomain "sustainability" .

