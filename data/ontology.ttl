        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-data ],
        ngm:ai-application,
        ngm:asset-health-management,
        ngm:condition-based-maintenance ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:asset-life-extension,
