ngm:blockchain-analytics-platform a owl:Class ;
    rdfs:comment "A blockchain analytics platform is software that ingests, clusters, and analyses on-chain transaction data to trace fund flows, attribute addresses to entities, and assess risk. Platforms such as Chainalysis and Elliptic apply heuristics, machine learning, and labelled datasets to support anti-money-laundering, sanctions screening, and investigations. They are central tooling for exchange compliance teams, regulators, and law-enforcement agencies."@en ;
    rdfs:label "Blockchain Analytics Platform"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
