    vc:slug "image-processing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning .

ngm:inclusive-design a owl:Class ;
    rdfs:label "Inclusive Design"@en ;
    rdfs:comment "Inclusive design is a design methodology and philosophy that creates products, services, environments, and digital experiences to be usable by the widest possible range of people across diverse abilities, ages, languages, cultures, and contexts, without requiring specialised adaptations or separate versions for different user groups. It treats human diversity as a design resource rather than a problem to be accommodated, recognising that designing for people with disabilities, situational impairments, or non-standard use contexts typically produces solutions that benefit all users. The approach is distinct from universal design in emphasising process — including people with diverse characteristics as active co-designers throughout — rather than solely optimising for a single configuration serving all."@en ;
    rdfs:subClassOf ngm:universal-design ;
    vc:enables ngm:inclusive-participation,
        ngm:inclusive-xr-design,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility-standard,
        ngm:equity ;
    vc:slug "inclusive-design" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:accessibility,
        ngm:human-computer-interaction,
        ngm:interaction-design .

ngm:inference-layer a owl:Class ;
    rdfs:label "Inference Layer"@en ;
    rdfs:comment "The Inference Layer is the stratum that executes trained models to produce predictions from new inputs. In the canonical stack it sits above the Model Layer and below the Middleware Layer, turning static artefacts into a live serving capability. It contains serving runtimes, batching and caching logic, and the request handling that delivers predictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:middleware-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:model-layer ;
    vc:slug "inference-layer" ;
    vc:sourceDomain "inference" .

ngm:inflation a owl:Class ;
    rdfs:label "Inflation"@en ;
    rdfs:comment "The scheduled or dynamic increase in token supply within a blockchain network, used to fund validator rewards, incentivise participation, and manage monetary policy. Inflation rate parameters are typically encoded in the protocol and may be adjusted via governance, directly affecting token holder purchasing power and long-term economic security."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
