ngm:question-answering a owl:Class ;
    rdfs:label "Question Answering"@en ;
    rdfs:comment "Question Answering (QA) is the NLP task of automatically generating accurate answers to natural language questions posed by users, either by extracting answers from text passages (extractive QA) or generating free-form responses (generative QA). QA systems employ reading comprehension models, retrieval-augmented generation, and knowledge reasoning to power applications including search engines, virtual assistants, and customer support."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-retrieval ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:enterprise-search,
        ngm:knowledge-management ;
    vc:contrastsWith ngm:document-retrieval,
        ngm:text-summarization ;
    vc:dependsOn ngm:machine-learning,
        ngm:text-corpus ;
    vc:enables ngm:dialogue-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:virtual-assistant ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:extractive-qa,
        ngm:generative-qa,
        ngm:open-domain-qa ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fact-verification,
        ngm:multi-hop-reasoning,
        ngm:visual-question-answering ;
    vc:requires ngm:information-retrieval,
        ngm:language-model,
        ngm:natural-language-processing,
        ngm:reading-comprehension ;
    vc:slug "question-answering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:embedding,
        ngm:knowledge-graph,
        ngm:transformer .

ngm:robot-dynamics a owl:Class ;
    rdfs:label "Robot Dynamics"@en ;
    rdfs:comment "Robot Dynamics is the branch of classical and computational mechanics that characterises the forces, torques, inertias, and energy flows governing the motion of robotic mechanisms. It distinguishes between forward dynamics—determining joint accelerations and Cartesian trajectories from applied actuator forces and torques—and inverse dynamics—computing the actuator effort required to produce a prescribed motion trajectory. The discipline provides the theoretical foundation for model-based control laws (such as computed-torque and feedback-linearisation controllers), physics-based simulation, and the design of energy-efficient manipulators and legged robots. Accurate dynamic models are indispensable for high-speed manipulation, safe human-robot collaboration, compliant actuation, and whole-body control of mobile robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:digital-twin,
        ngm:reinforcement-learning ;
    vc:enables ngm:motion-planning,
        ngm:robot-control,
        ngm:robot-simulation,
        ngm:trajectory-optimisation,
        ngm:whole-body-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:forward-dynamics,
        ngm:inverse-dynamics,
        ngm:lagrangian-mechanics,
        ngm:newton-euler-algorithm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:contact-mechanics,
        ngm:optimal-control,
        ngm:robot-safety,
        ngm:state-estimation ;
    vc:requires ngm:differential-equations,
        ngm:inertia-tensor,
        ngm:kinematics,
        ngm:rigid-body-mechanics ;
    vc:slug "robot-dynamics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:compliant-actuation,
        ngm:human-robot-interaction,
        ngm:legged-locomotion ;
    vc:uses ngm:denavit-hartenberg-parameters,
        ngm:jacobian-matrix,
        ngm:spatial-algebra .

ngm:scene-understanding a owl:Class ;
    rdfs:label "Scene Understanding"@en ;
    rdfs:comment "Scene Understanding is the high-level semantic interpretation of visual and sensor data to comprehend the structure, context, objects, relationships, and dynamics of an environment. It encompasses object detection and recognition, spatial layout inference, activity recognition, contextual reasoning, and semantic scene categorisation, enabling autonomous and interactive systems to make contextually appropriate decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
