ngm:audit-logging a owl:Class ;
    rdfs:label "Audit Logging"@en ;
    rdfs:comment "Audit logging is the systematic, tamper-evident recording of security-relevant events, user actions, and system operations to an immutable or append-only store, enabling retrospective forensic analysis, regulatory compliance, and incident response. Each log entry captures who performed an action, what was performed, when, from where, and the outcome, providing an authoritative chain of evidence. Audit logs are distinct from general application logs by their integrity guarantees and structured, queryable format."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-timestamping ],
        ngm:audit-log ;
    vc:bridgesTo ngm:blockchain-immutability,
        ngm:data-provenance ;
    vc:contrastsWith ngm:application-logging ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:log-integrity-verification ;
    vc:enables ngm:algorithmic-auditing,
        ngm:compliance-verification,
        ngm:forensic-analysis,
        ngm:incident-response,
        ngm:non-repudiation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-record,
        ngm:log-entry ;
    vc:isPartOf ngm:identity-and-access-management,
        ngm:security-information-and-event-management ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:information-security ;
    vc:requires ngm:access-control,
        ngm:append-only-storage,
        ngm:trusted-timestamping ;
    vc:slug "audit-logging" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-sp-800-92 ;
    vc:supports ngm:audit-trail,
        ngm:compliance-framework,
        ngm:compliance-monitoring,
        ngm:regulatory-reporting,
        ngm:zero-trust-architecture .

ngm:calibration a owl:Class ;
    rdfs:label "Calibration"@en ;
    rdfs:comment "Calibration is the systematic process of establishing, verifying, and correcting the quantitative relationship between a measurement instrument's or computational model's output and a known reference standard, encompassing intrinsic parameter estimation (gain, offset, nonlinearity, bias), extrinsic parameter determination (spatial pose and orientation relative to a reference frame), and inter-device consistency alignment. In physical systems it removes systematic error between raw sensor readings and true physical quantities; in machine learning it aligns predicted probability distributions to empirical frequencies. Calibration is a prerequisite for metrically accurate perception, reliable closed-loop control, trustworthy probabilistic inference, and coherent multi-modal data fusion across robotics, spatial computing, and AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reference-standard ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:model-calibration,
        ngm:probabilistic-calibration,
        ngm:uncertainty-quantification ;
    vc:contrastsWith ngm:validation,
        ngm:verification ;
    vc:dependsOn ngm:least-squares,
        ngm:optimisation ;
    vc:enables ngm:augmented-reality,
        ngm:pose-estimation,
        ngm:robot-control,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:camera-calibration,
        ngm:extrinsic-calibration,
        ngm:imu-calibration,
        ngm:temporal-calibration ;
    vc:isPartOf ngm:quality-assurance,
        ngm:sensor-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:kinematic-calibration,
        ngm:sensor-noise,
        ngm:systematic-error ;
    vc:requires ngm:error-model,
        ngm:ground-truth,
        ngm:reference-standard ;
    vc:slug "calibration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-driving,
        ngm:medical-imaging,
        ngm:robotic-manipulation ;
    vc:uses ngm:checkerboard-pattern,
        ngm:fiducial-marker,
        ngm:imu,
        ngm:lidar .

ngm:collaborative-systems-modality-robot a owl:Class ;
    rdfs:label "Collaborative Robot"@en ;
    rdfs:comment "Collaborative Robot (cobot) - A lightweight robotic arm engineered to operate safely alongside human workers, combining force/torque sensing, reduced kinetic energy, and speed limitations to enable Human-Robot Collaboration in shared manufacturing and assembly environments. Cobots are distinguished from traditional industrial robots by their intrinsic safety mechanisms, ease of programming, and ability to share workspace with humans without physical guarding barriers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection-system ],
        ngm:industrial-robot ;
