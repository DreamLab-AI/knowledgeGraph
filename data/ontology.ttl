        ngm:scenario-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:covariates,
        ngm:evaluation-metric,
        ngm:forecast-horizon,
        ngm:interval-forecast,
        ngm:lookback-window,
        ngm:point-forecast,
