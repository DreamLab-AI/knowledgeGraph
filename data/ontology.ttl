ngm:data-lineage-tracking a owl:Class ;
    rdfs:comment "Data lineage tracking is the automated capture and maintenance of provenance metadata as data is created, transformed and moved across pipelines and platforms. It instruments transformations and queries to build a continuously updated lineage graph rather than a static map. Often expressed using provenance vocabularies such as PROV-O, it underpins reproducibility, trust and governance in data fabric architectures."@en ;
    rdfs:label "Data Lineage Tracking"@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-fabric-architecture ;
    vc:relatedTo ngm:provenance-ontology-prov-o ;
    vc:slug "data-lineage-tracking" ;
    vc:sourceDomain "data" .
ngm:data-link-layer a owl:Class ;
    rdfs:comment "The data link layer is the second layer of the OSI model, responsible for node-to-node data transfer across a single physical link and for framing raw bits from the physical layer into structured frames. It provides addressing through hardware (MAC) addresses, error detection, and media access control that arbitrates shared transmission media. By presenting a reliable link to the network layer above, it abstracts away the imperfections of the underlying physical medium."@en ;
    rdfs:label "Data Link Layer"@en ;
    rdfs:subClassOf ngm:osi-model ;
    rdfs:subClassOf _:r6935 ;
    rdfs:subClassOf _:r6936 ;
