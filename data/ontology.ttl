ngm:cryptographic-signature a owl:Class ;
    rdfs:label "Cryptographic Signature"@en ;
    rdfs:comment "A cryptographic signature is a mathematical construction that allows a signing party to attach an unforgeable, verifiable proof of origin and integrity to a message or transaction, providing both authenticity and non-repudiation. Signatures are computed from the message content and the signer's private key using an asymmetric cryptographic algorithm; any party possessing the corresponding public key can independently verify the signature without learning the private key. Common schemes include ECDSA, Ed25519, and RSA-PSS, each with distinct performance and security profiles relevant to their deployment context."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ed25519 ;
    vc:slug "cryptographic-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-function,
        ngm:public-key-cryptography .

ngm:dao a owl:Class ;
    rdfs:label "DAO"@en ;
    rdfs:comment "Decentralised Autonomous Organisation operating through transparent code-based rules and distributed governance rather than hierarchical management, enabling community coordination at scale."@en ;
