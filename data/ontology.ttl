    vc:requires ngm:narrative-content,
        ngm:sensory-feedback ;
    vc:slug "emotional-immersion" ;
    vc:sourceDomain "spatial-computing" .

ngm:endpoint-detection-and-response a owl:Class ;
    rdfs:label "Endpoint Detection and Response"@en ;
    rdfs:comment "Endpoint Detection and Response (EDR) is a cybersecurity technology that continuously records endpoint activity, detects suspicious or malicious behaviour, and provides investigation and response capabilities on hosts such as laptops, servers and workstations. Lightweight agents stream rich telemetry to an analytics backend that applies behavioural detection, threat intelligence and anomaly models to surface and contain threats that bypass preventive controls. EDR enables analysts to investigate incidents, isolate compromised hosts and remediate threats, and increasingly feeds extended detection and response and managed services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:threat-detection ;
    vc:enables ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
        ngm:telemetry ;
    vc:isPartOf ngm:cybersecurity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-breach,
        ngm:siem,
        ngm:soar,
        ngm:vulnerability-management ;
    vc:requires ngm:monitoring ;
    vc:slug "endpoint-detection-and-response" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:security-operations-centre,
        ngm:zero-trust-architecture ;
    vc:uses ngm:anomaly-detection,
        ngm:threat-intelligence .

ngm:epidemiological-modelling a owl:Class ;
    rdfs:label "Epidemiological Modelling"@en ;
    rdfs:comment "Epidemiological modelling is the use of mathematical and computational models to describe how infectious diseases spread through populations over time. Compartmental models partition a population into states such as susceptible, infected, and recovered, and use differential equations to govern transitions between them, while network and agent-based models capture heterogeneous contact structures. These models inform forecasting, intervention design, and public-health policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-equations ],
        ngm:computational-modelling ;
    vc:bridgesTo ngm:network-analysis,
        ngm:public-health ;
    vc:dependsOn ngm:computational-modelling ;
    vc:enables ngm:public-health,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:differential-equations ;
    vc:isPartOf ngm:computational-modelling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agent-based-modelling,
        ngm:graph-theory,
        ngm:time-series-forecasting ;
    vc:slug "epidemiological-modelling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:public-health ;
    vc:uses ngm:agent-based-modelling,
        ngm:differential-equations,
        ngm:simulation .

ngm:erc-20-votes a owl:Class ;
    rdfs:label "ERC-20 Votes"@en ;
    rdfs:comment "An extension pattern building on the ERC-20 fungible token standard to track voting power and historical balances for on-chain governance. It associates token holdings with delegated voting rights."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
