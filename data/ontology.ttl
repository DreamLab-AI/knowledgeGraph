ngm:adapter-tuning a owl:Class ;
    rdfs:comment "A parameter-efficient fine-tuning technique that adapts a frozen pre-trained neural network to new tasks by inserting small trainable modules — adapters — between or alongside its layers, typically bottleneck feed-forward blocks or low-rank projections, so that task-specific behaviour is learned in a fraction of a percent of the original parameter count; adapters preserve the base model's weights, allow many tasks to share one backbone through swappable modules, and underpin methods from Houlsby adapters to LoRA and ControlNet-style conditioning branches."@en ;
    rdfs:label "Adapter Tuning"@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cross-modal-conditioning ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning ;
    vc:relatedTo ngm:lo-ra-do-ra-etc ;
    vc:slug "adapter-tuning" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:adaptive-authentication a skos:Concept ;
    rdfs:label "Adaptive Authentication"@en .
ngm:adaptive-behaviour a owl:Class ;
    rdfs:comment "Adaptive behaviour refers to the capacity of an agent, system, or organism to modify its actions, strategies, or responses in real time based on feedback from its environment, internal state, or prior experience. In computational and robotics contexts, it describes dynamic adjustment of policies or control laws to optimise performance under changing conditions. The concept underpins reinforcement learning, autonomous agents, and self-organising systems."@en ;
    rdfs:label "Adaptive Behaviour"@en ;
    rdfs:subClassOf ngm:agent ;
