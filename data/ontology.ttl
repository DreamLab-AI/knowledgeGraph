    vc:sourceDomain "artificial-intelligence" .

ngm:humanoid-robot a owl:Class ;
    rdfs:label "Humanoid Robot"@en ;
    rdfs:comment "A humanoid robot is an autonomous or semi-autonomous mechanical system whose overall morphology, kinematic chain, and sensorimotor organisation deliberately mirrors the human body plan: a vertical torso supported on two bipedal legs, bilateral upper limbs terminating in multi-fingered end-effecto..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:series-elastic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tactile-sensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:whole-body-control ],
        ngm:bipedal-robot,
        ngm:embodied-agent,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
