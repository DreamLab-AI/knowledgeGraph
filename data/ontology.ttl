    vc:enables ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-camera" ;
    vc:sourceDomain "spatial-computing" .

ngm:infrared-sensor a owl:Class ;
    rdfs:label "InfraredSensor"@en ;
    rdfs:comment "An optoelectronic sensor device that detects electromagnetic radiation in the infrared spectrum (wavelengths approximately 700 nanometers to 1 millimeter) to measure heat emission, enable proximity detection, support autonomous navigation, or facilitate object recognition in robotic systems, empl..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-amplifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:gesture-recognition,
        ngm:line-following,
        ngm:navigation-control,
        ngm:obstacle-avoidance,
        ngm:presence-detection,
        ngm:thermal-inspection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analog-digital-converter,
        ngm:iremitter,
        ngm:irreceiver,
        ngm:lens-assembly,
        ngm:optical-filter,
        ngm:signal-amplifier ;
    vc:qualityScore "0.5"^^xsd:float ;
