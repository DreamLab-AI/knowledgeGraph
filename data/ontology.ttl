ngm:emissions-reporting a owl:Class ;
    rdfs:comment "Emissions reporting is the structured disclosure of an organisation's greenhouse gas output across defined scopes and reporting periods, typically following standards such as the GHG Protocol. It converts underlying carbon accounting data into public or regulatory filings that stakeholders and auditors can verify. Frameworks such as the Crypto Climate Accord require signatories to publish emissions reporting to demonstrate progress toward stated climate commitments."@en ;
    rdfs:label "Emissions Reporting"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    rdfs:subClassOf _:r9653 ;
