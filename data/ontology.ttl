ngm:3-d-scanning a owl:Class ;
    rdfs:label "3D Scanning"@en ;
    rdfs:comment "3D Scanning is the process of capturing the three-dimensional shape, and optionally the colour and texture, of real-world objects, people, or environments using hardware such as structured-light scanners, time-of-flight LiDAR, photogrammetry rigs, or depth cameras, producing digital point clouds or meshes that represent the physical source. The resulting data feeds into digital preservation, reverse engineering, visual-effects production, quality inspection, and spatial computing pipelines. Accuracy, resolution, and scan volume are the primary quality axes that distinguish scanning technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mesh-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensor ],
        ngm:3-d-reconstruction ;
    vc:bridgesTo ngm:medical-imaging,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:neural-radiance-field,
        ngm:structure-from-motion ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:digital-heritage,
        ngm:digital-twin-creation,
        ngm:point-cloud-processing,
        ngm:reverse-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mesh-generation,
        ngm:point-cloud ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-perception,
        ngm:gaussian-splatting,
        ngm:simultaneous-localisation-and-mapping ;
    vc:requires ngm:calibration,
        ngm:depth-sensor ;
    vc:slug "3-d-scanning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:building-information-modelling,
        ngm:quality-inspection ;
    vc:uses ngm:3-d-li-dar,
        ngm:photogrammetry,
        ngm:structured-light,
        ngm:time-of-flight-sensor .

ngm:academic-research a owl:Class ;
    rdfs:label "Academic Research"@en ;
    rdfs:comment "Academic research is the systematic, disciplined inquiry conducted within universities and research institutions to generate, validate, and disseminate new knowledge. It proceeds through formulating questions, reviewing prior literature, designing and executing studies under the scientific method, and subjecting findings to peer review before publication. Its outputs include papers, datasets, and theories that are cited and built upon by the wider scholarly community. Governance norms such as reproducibility, transparency, and research integrity distinguish it from informal or commercial knowledge production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reproducibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scientific-method ],
        ngm:governance ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:open-access ;
    vc:enables ngm:knowledge-graph,
        ngm:open-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:peer-review,
        ngm:reproducibility ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:academia,
        ngm:reproducibility,
        ngm:scientific-method ;
    vc:requires ngm:scientific-method ;
    vc:slug "academic-research" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance ;
    vc:uses ngm:peer-review,
        ngm:scientific-method .

ngm:account-model a owl:Class ;
    rdfs:label "Account Model"@en ;
    rdfs:comment "The Account Model is a balance-based ledger paradigm in which each address maintains a persistent balance that is updated in-place when transactions execute. Unlike the UTXO model, accounts hold state across transactions, simplifying smart contract programming while introducing challenges around replay protection and nonce management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-identity ;
    vc:contrastsWith ngm:utxo-model ;
    vc:dependsOn ngm:merkle-patricia-trie,
        ngm:state-root ;
    vc:enables ngm:decentralised-application,
        ngm:smart-contract,
        ngm:token-standard,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nonce ;
    vc:implements ngm:ledger ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-transaction,
        ngm:cryptographic-keys,
        ngm:double-spending,
        ngm:externally-owned-account,
        ngm:transaction-fee ;
    vc:requires ngm:nonce,
        ngm:public-key-cryptography,
        ngm:transaction,
        ngm:wallet ;
    vc:slug "account-model" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:gas-mechanism .

ngm:admittance-control a owl:Class ;
    rdfs:label "Admittance Control"@en ;
    rdfs:comment "Force control strategy where robotic systems respond to external forces by producing proportional motion governed by virtual admittance parameters (mass, damping, stiffness), enabling compliant physical interaction with uncertain or variable environments by regulating position/velocity trajectori..."@en ;
