ngm:behavioural-feedback-loop a owl:Class ;
    rdfs:label "Behavioural Feedback Loop"@en ;
    rdfs:comment "Recurring cycle where user actions influence environment responses which in turn modify subsequent user behavior through adaptive learning and reinforcement mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavior-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:adaptive-experience,
        ngm:behavioral-learning,
        ngm:dynamic-adjustment,
        ngm:personalized-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:action-detection,
        ngm:adaptive-reinforcement,
        ngm:behavior-analysis,
        ngm:environment-response ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ai-model,
        ngm:real-time-processing,
        ngm:state-management,
        ngm:user-tracking ;
    vc:slug "behavioural-feedback-loop" ;
    vc:sourceDomain "spatial-computing" .

