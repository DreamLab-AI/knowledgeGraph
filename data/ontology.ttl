vf:spatial-calibration a owl:Class ;
    rdfs:label "Spatial Calibration"@en ;
    rdfs:comment "The process of aligning virtual coordinate frames with physical world references in AR/VR systems, including camera calibration for video see-through displays and optical calibration for see-through displays, ensuring accurate registration of digital content with the real environment."@en ;
    rdfs:subClassOf vf:ar-registration ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables <urn:visionflow:linked:accurate-ar-alignment> ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-calibration" ;
    vc:sourceDomain "spatial-computing" .

vf:spatial-coordinates a owl:Class ;
    rdfs:label "Spatial Coordinates"@en ;
    rdfs:comment "A unified reference frame system for positioning objects in three-dimensional virtual or mixed reality environments, including geographically-anchored poses (GeoPose) tied to Earth coordinates and local coordinate systems for scene-relative object placement with support for coordinate transformation between systems."@en ;
    rdfs:subClassOf vf:coordinate-system ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables <urn:visionflow:linked:object-positioning> ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-coordinates" ;
    vc:sourceDomain "spatial-computing" .

vf:spatial-index a owl:Class ;
    rdfs:label "Spatial Index"@en ;
    rdfs:comment "Data structure optimized for efficient storage, retrieval, and querying of 3D spatial objects within virtual worlds using hierarchical geometric partitioning."@en ;
