ngm:consistency-model a owl:Class ;
    rdfs:label "Consistency Model"@en ;
    rdfs:comment "A consistency model is a contract between a distributed data store and its clients that specifies the guarantees about the visibility and ordering of reads and writes across replicas. It defines which outcomes of concurrent operations are permissible, ranging from strong models like linearizability that behave as a single up-to-date copy, to weak models like eventual consistency that allow temporary divergence. The chosen model shapes application correctness, performance, and the achievable balance among consistency, availability, and partition tolerance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:strong-consistency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:replication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linearizability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eventual-consistency ],
        ngm:distributed-data-structure ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:partition-tolerance ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:replication-protocol ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:eventual-consistency,
        ngm:linearizability,
        ngm:strong-consistency ;
    vc:isPartOf ngm:distributed-data-structure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:partition-tolerance,
