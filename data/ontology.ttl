        ngm:remote-teamwork ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:co-editing,
        ngm:conflict-resolution,
        ngm:presence-awareness,
        ngm:real-time-synchronisation,
        ngm:shared-state ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-systems-domain,
        ngm:networking-domain ;
    vc:slug "distributed-collaboration-domain" ;
    vc:sourceDomain "distributed-collaboration" .

