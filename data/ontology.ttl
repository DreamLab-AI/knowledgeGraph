ngm:standards-body a owl:Class ;
    rdfs:label "Standards Body"@en ;
    rdfs:comment "A standards body is a formal organisation that develops, publishes, and maintains technical specifications, protocols, and reference implementations through structured, consensus-based processes involving multiple stakeholders. Such bodies define interoperability requirements that enable products and services from different vendors to work together reliably, and they may operate at national, regional, or international scope. Governance structures typically include member organisations, technical working groups, public review periods, and intellectual-property licensing frameworks (e.g. royalty-free or FRAND). Well-known examples include ISO, IEC, IEEE, W3C, IETF, NIST, Khronos Group, and the Open Geospatial Consortium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-licence-instrument ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:ai-safety-framework,
        ngm:blockchain-protocol,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:de-facto-standard,
        ngm:proprietary-specification ;
    vc:dependsOn ngm:stakeholder-participation,
        ngm:technical-expertise ;
    vc:enables ngm:interoperability,
        ngm:open-standard,
        ngm:vendor-neutrality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:specification-document,
        ngm:standards-conformance-testing ;
    vc:implements ngm:open-governance ;
    vc:isPartOf ngm:governance-ecosystem,
        ngm:regulatory-framework ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:certification-scheme,
        ngm:governance,
        ngm:industry-consortium,
        ngm:policy-framework ;
    vc:requires ngm:consensus-process,
        ngm:intellectual-property-licence-instrument ;
    vc:slug "standards-body" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:api-specification,
        ngm:data-format,
        ngm:protocol-specification .

ngm:token-standard a owl:Class ;
    rdfs:label "Token Standard"@en ;
    rdfs:comment "Technical specification defining rules, interfaces, and functions that smart contract tokens must implement to ensure interoperability within a blockchain ecosystem, exemplified by ERC-20 (fungible tokens), ERC-721 (NFTs), and ERC-1155 (multi-token), establishing common APIs for transfers, balance queries, approvals, and metadata across wallets, exchanges, and decentralised applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-1155 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-20 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-721 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:data-schema,
        ngm:digital-asset-standards ;
    vc:contrastsWith ngm:central-bank-digital-currency-cbdc,
        ngm:native-token ;
    vc:dependsOn ngm:blockchain,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:enables ngm:de-fi,
        ngm:decentralized-exchange,
        ngm:token-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:erc-1155,
        ngm:erc-20,
        ngm:erc-721 ;
    vc:implements ngm:fungibility ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:token-metadata,
        ngm:wallet ;
    vc:requires ngm:application-binary-interface,
        ngm:smart-contract ;
    vc:slug "token-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:supports ngm:governance-token,
        ngm:nft,
        ngm:stablecoin ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:event-log .

ngm:explainability a owl:Class ;
    rdfs:label "Explainability"@en ;
    rdfs:comment "The extent to which an AI system's decision-making processes, outputs, and behaviors can be understood and articulated in human-comprehensible terms, enabling stakeholders to grasp how and why specific outcomes were produced."@en ;
