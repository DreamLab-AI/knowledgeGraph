ngm:rdfs a skos:Concept ;
    rdfs:label "Rdfs"@en .

ngm:re-act-pattern a owl:Class ;
    rdfs:label "ReAct Pattern"@en ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting and agent-control pattern in which a language model interleaves explicit reasoning traces with action steps such as tool calls, observing the results before reasoning again. This loop lets the model decompose tasks, gather information, and self-correct rather than answering in a single pass. It is a foundational design for tool-using LLM agents."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:function-calling ;
    vc:slug "re-act-pattern" ;
    vc:sourceDomain "ai" .

ngm:re-lu-activation a owl:Class ;
    rdfs:label "ReLU Activation"@en ;
    rdfs:comment "The Rectified Linear Unit (ReLU) is a nonlinear activation function defined as f(x) = max(0, x), outputting the input directly when positive and zero otherwise. Its simplicity, sparse activation, and non-saturating gradient for positive inputs make it the default activation in most deep neural networks, mitigating the vanishing-gradient problem. Variants such as Leaky ReLU and GELU address its dead-neuron limitation."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai,
        ngm:generative-adversarial-networks ;
    vc:slug "re-lu-activation" ;
    vc:sourceDomain "ai" .

ngm:react a skos:Concept ;
    rdfs:label "React"@en .

ngm:reactive-programming a skos:Concept ;
    rdfs:label "Reactive Programming"@en .

ngm:reactive-systems a skos:Concept ;
    rdfs:label "Reactive Systems"@en .

ngm:read-receipts a owl:Class ;
    rdfs:label "Read Receipts"@en ;
    rdfs:comment "Read receipts are delivery-confirmation signals that indicate whether a message has been seen by its recipient, typically displayed as a checkmark, avatar, or timestamp. They provide senders with visibility into message consumption, reducing uncertainty in asynchronous communication. Their use in distributed collaboration can improve follow-up timing but must be balanced against recipient privacy expectations."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:message-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:instant-messaging,
        ngm:typing-indicators ;
    vc:slug "read-receipts" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:ready-player-me a owl:Class ;
    rdfs:label "Ready Player Me"@en ;
    rdfs:comment "Ready Player Me (RPM) is a cross-application avatar platform that enables users to create a single personalised 3D humanoid avatar and deploy it across hundreds of games, social VR environments, and virtual worlds via an open SDK and REST API. Founded in 2021 by Wolf3D, it provides a browser-based avatar creator, glTF-compliant avatar meshes, morph-target facial animation, and an OAuth-based identity layer so that the same avatar persona persists across compatible applications. By decoupling avatar creation from any single platform, RPM acts as a shared identity infrastructure for the emerging spatial internet, addressing avatar fragmentation across [[Metaverse]] ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oauth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rest-api ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:digital-twin,
        ngm:nft,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:metahuman-creator,
        ngm:vroid-studio ;
    vc:dependsOn ngm:cloud-storage,
        ngm:digital-identity ;
    vc:enables ngm:avatar-interoperability,
        ngm:cross-platform-identity,
        ngm:social-vr ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:avatar,
        ngm:avatar-creator,
        ngm:morph-target ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:avatar-platform,
        ngm:avatar-sdk,
        ngm:open-metaverse-interoperability,
        ngm:wolf3d ;
    vc:requires ngm:gltf,
        ngm:oauth,
        ngm:rest-api ;
    vc:slug "ready-player-me" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:augmented-reality,
        ngm:metaverse,
        ngm:virtual-reality ;
    vc:uses ngm:3d-scanning,
        ngm:facial-recognition,
        ngm:physically-based-rendering,
        ngm:skeletal-animation .

ngm:real-analysis a skos:Concept ;
