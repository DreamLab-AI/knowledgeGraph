    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:parameter-count ;
    vc:slug "model-width" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:monocular-camera a owl:Class ;
    rdfs:label "Monocular Camera"@en ;
    rdfs:comment "A Monocular Camera is a single-lens imaging sensor that captures 2D intensity or colour frames from a single viewpoint, serving as a primary perceptual modality in robotics, autonomous vehicles, and computer vision systems. Unlike stereo or depth cameras, it lacks intrinsic depth measurement capability, requiring computational techniques such as structure-from-motion, visual odometry, or learned depth estimation to recover 3D scene geometry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:camera,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:contrastsWith ngm:lidar,
        ngm:stereo-camera ;
    vc:enables ngm:object-detection,
        ngm:scene-understanding,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:depth-estimation,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping,
        ngm:structure-from-motion ;
    vc:requires ngm:camera-calibration,
        ngm:camera-parameters ;
    vc:slug "monocular-camera" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:feature-extraction .

ngm:multi-party-transactions a owl:Class ;
    rdfs:label "Multi Party Transactions"@en ;
    rdfs:comment "Blockchain transactions involving more than two participants that use atomic swap protocols, adaptor signatures, and hash timelock contracts (HTLCs) to ensure all parties complete their exchanges simultaneously or the entire transaction is reversed, preventing partial completion losses."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-transaction ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:cross-chain-trading ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "multi-party-transactions" ;
    vc:sourceDomain "blockchain" .

ngm:named-entity a owl:Class ;
    rdfs:label "Named Entity"@en ;
    rdfs:comment "A Named Entity is a real-world object or concept denoted by a proper noun—typically a person, organisation, location, geopolitical entity, date, time expression, monetary value, or product—that can be identified and classified within text by a named-entity recognition system. Named entities form the primary subjects, objects, and contextual anchors of factual statements, making their accurate identification a prerequisite for downstream information-extraction, relation-extraction, question-answering, and knowledge-graph construction tasks. The boundary and category of a named entity are determined by an annotation schema and domain ontology, so the same text span may be categorised differently across biomedical, legal, and news domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:knowledge-base,
        ngm:knowledge-graph,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:feature-engineering,
        ngm:pattern-recognition,
        ngm:token,
        ngm:transformer,
        ngm:vocabulary ;
    vc:requires ngm:named-entity-recognition,
        ngm:natural-language-processing ;
    vc:slug "named-entity" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:conditional-random-field,
        ngm:tokenization .

ngm:national-competent-authority a owl:Class ;
    rdfs:label "National Competent Authority"@en ;
    rdfs:comment "A body designated by an EU Member State under the AI Act — encompassing market surveillance authorities, notifying authorities, and data protection authorities — responsible for supervising provider and deployer compliance with the Act's requirements, enforcing penalties, and coordinating with the AI Office on cross-border and GPAI model matters."@en ;
