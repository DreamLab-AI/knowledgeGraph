            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reference-architecture ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:digital-twin ;
    vc:contrastsWith ngm:iso-iec-30141 ;
    vc:enables ngm:data-provenance,
        ngm:identity-management,
