ngm:hash-time-locked-contract a owl:Class ;
    rdfs:label "Hash Time-Locked Contract"@en ;
    rdfs:comment "A Hash Time-Locked Contract (HTLC) is a type of smart contract that conditionally releases funds to a recipient only if they present a valid cryptographic preimage satisfying a specified hash condition within a defined time window; if the condition remains unmet before the timeout expires, the funds automatically revert to the sender. HTLCs combine two complementary mechanisms—a hashlock, which binds settlement to knowledge of a secret, and a timelock, which enforces a bounded settlement window—to achieve trustless atomicity across one or more blockchain ledgers. They are foundational to payment channel networks such as the Lightning Network and to cross-chain atomic swap protocols, enabling conditional payment routing without custodial intermediaries or mutual trust. As a composable on-chain primitive, HTLCs underpin a wide range of decentralised finance and interoperability constructs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:cryptography,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:custodial-exchange,
        ngm:point-time-locked-contract,
        ngm:trusted-third-party ;
    vc:dependsOn ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:enables ngm:atomic-swap,
        ngm:cross-chain-interoperability,
        ngm:lightning-network,
        ngm:micropayments,
        ngm:payment-channel,
        ngm:trustless-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:atomic-swap,
        ngm:conditional-payment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adaptor-signature,
        ngm:cross-chain-bridge,
        ngm:de-fi,
        ngm:payment-system,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:timelock ;
    vc:slug "hash-time-locked-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:public-key-cryptography,
        ngm:script,
        ngm:sha-256 .

ngm:hyperledger-fabric a owl:Class ;
    rdfs:label "Hyperledger Fabric"@en ;
    rdfs:comment "Permissioned blockchain framework enabling enterprise consortia to build modular, confidential distributed-ledger systems through private channels, chaincode (smart contracts), pluggable consensus mechanisms, and membership service providers enforcing identity and access control."@en ;
