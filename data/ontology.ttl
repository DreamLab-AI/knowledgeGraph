    vc:slug "resource-allocation" ;
    vc:sourceDomain "blockchain" .

ngm:rest a owl:Class ;
    rdfs:label "REST"@en ;
    rdfs:comment "REST is an architectural style for distributed systems that uses stateless requests over HTTP and a uniform interface based on resources and standard methods."@en ;
