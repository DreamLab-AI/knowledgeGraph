        ngm:fatf-recommendation-16,
        ngm:ivms-101,
        ngm:money-laundering-regulations,
        ngm:transfer-of-funds-regulation ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cbdc-frameworks,
        ngm:decentralised-identity,
        ngm:digital-identity,
        ngm:gdpr,
        ngm:mi-ca-regulation,
