ngm:capacity-planning a owl:Class ;
    rdfs:label "Capacity Planning"@en ;
    rdfs:comment "Capacity planning is the process of determining the production, infrastructure, or service capacity required by an organisation to meet changing demand over a defined time horizon, balancing the cost of over-provisioned resources against the risk of under-provisioned systems that cannot meet service-level objectives. In technology contexts, capacity planning encompasses compute, storage, network bandwidth, and human resources, employing demand forecasting models, utilisation metrics, and growth projections to derive procurement and scaling roadmaps. In manufacturing, the same principles apply to machine-hours, floor space, and workforce shifts."@en ;
    rdfs:subClassOf ngm:cloud-infrastructure ;
    vc:bridgesTo ngm:carbon-aware-computing,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:reactive-scaling ;
    vc:dependsOn ngm:infrastructure-as-code,
        ngm:observability ;
    vc:enables ngm:cloud-computing,
        ngm:resource-optimisation,
        ngm:scalability,
        ngm:service-level-objective ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autoscaling,
        ngm:cloud-native,
        ngm:kubernetes,
        ngm:scalability-pattern ;
    vc:requires ngm:performance-monitoring,
        ngm:workload-management ;
    vc:slug "capacity-planning" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cost-optimisation,
        ngm:finops,
        ngm:site-reliability-engineering ;
    vc:uses ngm:demand-forecasting,
        ngm:queuing-theory,
        ngm:time-series-analysis,
        ngm:utilisation-monitoring .

ngm:character-model a owl:Class ;
    rdfs:label "Character Model"@en ;
    rdfs:comment "A 3D digital representation of a character consisting of a polygonal mesh, textures, and materials, designed with clean topology optimized for animation and real-time rendering, serving as the foundation for rigging, skinning, and character animation workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
