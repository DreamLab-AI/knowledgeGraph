ngm:kernel-fusion a owl:Class ;
    rdfs:comment "Kernel fusion is a compiler and runtime optimisation that merges several adjacent GPU or accelerator operations into a single executable kernel. By combining elementwise, reduction and other operators, it eliminates intermediate memory writes, reduces kernel-launch overhead and improves arithmetic intensity. It is a key technique for accelerating deep-learning training and inference on memory-bandwidth-bound hardware."@en ;
    rdfs:label "Kernel Fusion"@en ;
    rdfs:subClassOf ngm:gpu-acceleration ;
    rdfs:subClassOf _:r13018 ;
