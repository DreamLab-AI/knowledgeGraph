ngm:constant-product-formula a owl:Class ;
    rdfs:label "Constant Product Formula"@en ;
    rdfs:comment "The constant product formula is the pricing rule used by many automated market makers in which the product of the two pooled token reserves is held constant during trades."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:automated-market-maker ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool ;
    vc:slug "constant-product-formula" ;
    vc:sourceDomain "blockchain" .

ngm:constraint-based-design a owl:Class ;
    rdfs:label "Constraint Based Design"@en ;
    rdfs:comment "Constraint based design is an engineering and AI approach in which the solution space is defined by a set of explicit constraints — physical, functional, regulatory, or performance bounds — that any valid design must satisfy. Solvers or optimisation algorithms explore the constrained space to find feasible and optimal configurations. The method is foundational to generative design tools, parametric modelling, robotics motion planning, and cyber-physical system validation."@en ;
    rdfs:subClassOf ngm:ai-system-component,
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
