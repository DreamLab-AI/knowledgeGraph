mv:SymbolicObjectLibrary a owl:Class ;
    rdfs:subClassOf mv:DigitalAsset ;
    rdfs:label "Symbolic Object Library"@en ;
    rdfs:comment "A collection or repository of standardized 3D digital objects, assets, and components designed for use across metaverse platforms, including models, textures, animations, and interactive elements that can be shared and reused in virtual environments."@en ;
