        ngm:user-interface ;
    vc:slug "communication-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:middleware,
        ngm:rest-api .

ngm:complex-systems a owl:Class ;
    rdfs:label "Complex Systems"@en ;
    rdfs:comment "Systems composed of many interacting components whose collective behaviour cannot be simply inferred from the behaviour of the individual parts; characterised by nonlinearity, emergence, self-organisation, and feedback dynamics across scales."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamical-systems-theory ],
        ngm:systems-theory ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-systems,
        ngm:ecology,
        ngm:economics ;
    vc:contrastsWith ngm:linear-systems,
