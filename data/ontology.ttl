ngm:electronic-health-record a owl:Class ;
    rdfs:label "Electronic Health Record"@en ;
    rdfs:comment "An electronic health record (EHR) is a longitudinal digital record of a patient's health information maintained across care episodes and, increasingly, across providers. It consolidates demographics, diagnoses, medications, results and clinical notes into a structured, queryable store that supports care delivery, decision support and analytics. EHRs depend on interoperability standards and strong privacy controls to be shared safely between systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clinical-decision-support ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-privacy ],
        ngm:healthcare-records ;
    vc:bridgesTo ngm:telemedicine ;
    vc:dependsOn ngm:privacy-by-design ;
    vc:enables ngm:clinical-decision-support,
        ngm:telemedicine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:clinical-decision-support ;
    vc:isPartOf ngm:healthcare-records ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hipaa,
        ngm:medical-imaging ;
    vc:requires ngm:data-privacy,
