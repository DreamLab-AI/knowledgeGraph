ngm:data-warehouse a owl:Class ;
    rdfs:comment "A data warehouse is a centralised analytical repository that integrates cleansed, structured data from multiple operational sources into a subject-oriented, historical model optimised for querying and reporting. It supports business intelligence through schemas such as star and snowflake and columnar storage for fast aggregation. It is a core data-engineering asset enabling consistent enterprise analytics."@en ;
    rdfs:label "Data Warehouse"@en ;
    rdfs:subClassOf ngm:data-management ;
