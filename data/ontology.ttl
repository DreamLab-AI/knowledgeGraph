    vc:bridgesTo ngm:artificial-intelligence,
        ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:enables ngm:autonomous-system,
        ngm:cyber-physical-system,
        ngm:model-predictive-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conference-on-decision-and-control,
        ngm:ieee-control-systems-magazine,
        ngm:ieee-transactions-on-automatic-control ;
    vc:isPartOf ngm:ieee ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:model-based-control,
        ngm:networked-control-system,
