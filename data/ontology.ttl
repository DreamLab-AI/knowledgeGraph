ngm:fca-consumer-duty a owl:Class ;
    rdfs:label "FCA Consumer Duty"@en ;
    rdfs:comment "The FCA Consumer Duty is a regulatory standard set by the UK Financial Conduct Authority requiring financial firms to deliver good outcomes for retail customers. It mandates that firms act in good faith, avoid foreseeable harm, support customers in pursuing their financial objectives, and demonstrate fair value, clear communications, and adequate support. The Duty raises the bar above prior 'treating customers fairly' expectations and applies across products, pricing, and service channels."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:call-centres,
        ngm:securities-regulation ;
    vc:slug "fca-consumer-duty" ;
    vc:sourceDomain "governance" .

ngm:feature-map a owl:Class ;
    rdfs:label "Feature Map"@en ;
    rdfs:comment "A feature map (or activation map) is the output produced when a convolutional filter is applied across an input in a convolutional neural network, encoding the spatial response of a learned feature. Each channel of a feature map highlights where a particular pattern, such as an edge or texture, occurs in the input. Stacks of feature maps form the intermediate representations that deeper layers compose into higher-level concepts."@en ;
    rdfs:subClassOf ngm:convolutional-neural-network ;
    vc:contrastsWith ngm:attention-mechanism,
        ngm:pooling-layer ;
    vc:dependsOn ngm:backpropagation,
        ngm:deep-learning ;
    vc:enables ngm:feature-detection,
        ngm:feature-extraction,
        ngm:interpretability,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel,
        ngm:filter-kernel,
        ngm:receptive-field,
        ngm:spatial-activation ;
    vc:isPartOf ngm:convolutional-neural-network,
        ngm:feature-pyramid-network ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:feature-pyramid-network,
        ngm:grad-cam,
        ngm:spatial-hierarchy,
        ngm:tensor ;
    vc:slug "feature-map" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:attention-mechanism,
        ngm:image-recognition,
        ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:uses ngm:activation-function,
        ngm:convolution,
        ngm:tensor .

ngm:federated-query a owl:Class ;
    rdfs:label "Federated Query"@en ;
    rdfs:comment "A federated query is a single query that is decomposed and executed across multiple autonomous, distributed data sources, with partial results combined into a unified answer without first consolidating the data into one store. In the semantic-web context, SPARQL federation evaluates sub-queries against several remote endpoints, joining their bindings transparently to the requester. It enables integrated access to heterogeneous, independently governed datasets while leaving each source in place. Effective federation depends on source description, query planning, and distributed join optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        ngm:data-integration ;
    vc:bridgesTo ngm:semantic-web ;
    vc:enables ngm:data-federation,
        ngm:knowledge-graph,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:graph-database ;
    vc:requires ngm:sparql-endpoint ;
    vc:slug "federated-query" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-virtualization,
        ngm:wikidata ;
    vc:uses ngm:rdf,
        ngm:sparql,
        ngm:sparql-endpoint .

ngm:federated-system a owl:Class ;
    rdfs:label "Federated System"@en ;
    rdfs:comment "A federated system is a distributed architecture composed of autonomous, independently operated nodes or servers that cooperate under shared protocols while retaining local control over their own data and policies. Unlike fully centralised systems, federation distributes authority across multiple operators, and unlike fully decentralised peer-to-peer networks, it relies on a finite set of identifiable, semi-trusted servers. This model underpins federated social networks, messaging, and consortium-style trust arrangements."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consortium-blockchain,
        ngm:fedimint ;
    vc:slug "federated-system" ;
    vc:sourceDomain "infrastructure" .

ngm:file-format a skos:Concept ;
    rdfs:label "File Format"@en .

ngm:filtration a owl:Class ;
    rdfs:label "Filtration"@en ;
    rdfs:comment "In probability theory, a filtration is an increasing family of sigma-algebras indexed by time that formally represents the accumulation of information available up to each instant. It models what is knowable at each point as a stochastic process unfolds, with each sigma-algebra containing all events whose outcomes are determined by then. Filtrations are fundamental to defining adapted processes, martingales, and conditional expectations in stochastic analysis and mathematical finance."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model,
        ngm:stochastic-process ;
    vc:slug "filtration" ;
    vc:sourceDomain "data" .

ngm:financial-intelligence a owl:Class ;
    rdfs:label "Financial Intelligence"@en ;
    rdfs:comment "Financial intelligence is the collection, analysis, and dissemination of information about financial flows and transactions to detect, investigate, and disrupt illicit activity such as money laundering, terrorist financing, and sanctions evasion. In the blockchain context it applies graph analytics and transaction tracing across public ledgers to attribute addresses, cluster wallets, and surface suspicious patterns. It feeds compliance functions, law-enforcement investigations, and regulatory reporting, bridging on-chain data with off-chain identity and risk signals. Financial intelligence units and private analytics providers are its principal practitioners."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:blockchain-analytics ;
    vc:bridgesTo ngm:fatf-travel-rule,
        ngm:predictive-analytics ;
    vc:enables ngm:anti-money-laundering,
        ngm:fraud-detection,
        ngm:sanctions-screening ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:regtech ;
    vc:requires ngm:data-fusion,
        ngm:know-your-customer ;
    vc:slug "financial-intelligence" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:regulatory-compliance,
        ngm:suspicious-activity-report ;
    vc:uses ngm:blockchain-analytics,
        ngm:chainalysis,
        ngm:graph-analytics,
        ngm:transaction-monitoring .

ngm:financial-reporting a owl:Class ;
    rdfs:label "Financial Reporting"@en ;
    rdfs:comment "Financial reporting is the structured disclosure of an organisation's financial position, performance, and cash flows to stakeholders through standardised statements and supporting notes. It rests on recognised accounting frameworks and audit assurance to provide a faithful, comparable, and verifiable view of economic activity. In blockchain and decentralised contexts, financial reporting extends to on-chain transparency, proof-of-reserves attestations, and the accounting treatment of digital assets and tokenised value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:proof-of-reserves ;
    vc:dependsOn ngm:compliance ;
    vc:enables ngm:transparency,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit,
        ngm:disclosure ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:regulatory-compliance,
        ngm:taxation,
        ngm:tokenomics ;
    vc:requires ngm:audit,
        ngm:compliance,
        ngm:regulatory-compliance ;
    vc:slug "financial-reporting" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:transparency,
        ngm:treasury-management ;
    vc:uses ngm:disclosure,
        ngm:proof-of-reserves .

ngm:financial-transactions a owl:Class ;
    rdfs:label "Financial Transactions"@en ;
    rdfs:comment "Financial Transactions are records of the transfer of monetary value or digital assets between parties, executed through centralised payment systems, blockchain networks, or Layer-2 protocols such as the Lightning Network. Within spatial computing and metaverse contexts, financial transactions underpin virtual economies, in-world purchases, NFT trades, and cross-platform value exchange, requiring robust settlement, fraud detection, and regulatory compliance mechanisms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:de-fi-services,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:financial-services,
        ngm:lightning-network ;
    vc:slug "financial-transactions" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:cryptocurrency,
        ngm:smart-contract .

ngm:food-safety-blockchain a owl:Class ;
    rdfs:label "Food Safety Blockchain"@en ;
    rdfs:comment "Food Safety Blockchain is the application of distributed ledger technology to establish immutable, multi-party farm-to-fork audit trails that enable near-instantaneous contamination source identification and surgical product recalls. By recording each Critical Tracking Event—harvest, cooling, packing, shipment, receipt—as a cryptographically linked on-chain entry, the approach reduces trace-back from days to seconds, minimises the volume of food unnecessarily recalled, and provides regulators and consumers with verifiable provenance data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consortium-blockchain ],
        ngm:blockchain-application ;
    vc:enables ngm:audit-trail,
        ngm:provenance-tracking,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:data-provenance,
        ngm:pharmaceutical-traceability,
        ngm:supply-chain-blockchain ;
    vc:requires ngm:consortium-blockchain ;
    vc:slug "food-safety-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hyperledger-fabric,
        ngm:internet-of-things,
        ngm:permissioned-blockchain,
        ngm:smart-contracts .

ngm:force-torque-control a owl:Class ;
    rdfs:label "Force Torque Control"@en ;
    rdfs:comment "Force-torque control is a robot control strategy that regulates the contact forces and moments a manipulator exerts on its environment, rather than commanding position alone. It uses force-torque sensing, typically at the wrist or in the joints, within a feedback loop so that the robot can maintain a desired contact force or yield compliantly to external loads. This is essential for tasks involving physical contact, such as assembly, polishing, and safe interaction with people."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuators ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:force-control ;
    vc:bridgesTo ngm:haptics ;
    vc:contrastsWith ngm:admittance-control ;
    vc:dependsOn ngm:motion-control ;
    vc:enables ngm:robot-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feedback-control ;
    vc:implements ngm:impedance-control ;
    vc:isPartOf ngm:robot-control ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:impedance-control,
        ngm:robotic-arm ;
    vc:requires ngm:actuators ;
    vc:slug "force-torque-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:manipulation ;
    vc:uses ngm:end-effector,
        ngm:feedback-control .

ngm:forensic-analysis a owl:Class ;
    rdfs:label "Forensic Analysis"@en ;
    rdfs:comment "Forensic analysis is the disciplined investigation of digital systems and data to reconstruct events, attribute actions and preserve evidence to an evidentiary standard. In security it follows an incident to determine how a breach occurred, what was affected and who was responsible, maintaining a defensible chain of custody throughout. It draws on log analysis, memory and disk examination, and timeline reconstruction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:incident-response ;
    vc:bridgesTo ngm:root-cause-analysis ;
    vc:contrastsWith ngm:threat-detection ;
    vc:dependsOn ngm:audit-trail ;
    vc:enables ngm:root-cause-analysis,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:incident-response ;
    vc:isPartOf ngm:incident-response ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:cybersecurity,
        ngm:root-cause-analysis,
        ngm:threat-detection ;
    vc:requires ngm:audit-trail,
        ngm:incident-response ;
