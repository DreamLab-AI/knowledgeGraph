ngm:open-metaverse a skos:Concept ;
    rdfs:label "Open Metaverse"@en .

ngm:open-metaverse-interoperability-group a owl:Class ;
    rdfs:label "Open Metaverse Interoperability Group"@en ;
    rdfs:comment "The Open Metaverse Interoperability Group (OMI) is a community-driven body that develops open protocols and schemas for moving identity, avatars, and virtual objects between independent virtual worlds. It produces specifications for portable avatars, glTF extensions, and cross-platform identity so that metaverse experiences are not locked into single proprietary platforms. Its work aims to make virtual environments composable and interoperable rather than walled gardens."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "open-metaverse-interoperability-group" ;
    vc:sourceDomain "metaverse" .

ngm:open-policy-agent a skos:Concept ;
    rdfs:label "Open Policy Agent"@en .

ngm:open-source-sustainability a skos:Concept ;
    rdfs:label "Open Source Sustainability"@en .

ngm:open-standards a owl:Class ;
    rdfs:label "Open Standards"@en ;
    rdfs:comment "Open standards are publicly available, transparently developed technical specifications whose adoption is not contingent on royalties or proprietary licences, enabling any party to implement them independently. They are produced through open, consensus-driven processes—typically stewarded by recognised standards bodies such as W3C, IEEE, ISO, or IETF—and their normative texts are accessible to the public. By decoupling specification from implementation, open standards promote interoperability, vendor diversity, and long-term ecosystem resilience. They are foundational to the internet, the web, spatial computing, AI model exchange, and distributed collaboration infrastructures."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:federated-learning,
        ngm:onnx-standard ;
    vc:contrastsWith ngm:closed-specification,
        ngm:proprietary-standard ;
    vc:dependsOn ngm:intellectual-property-rights,
        ngm:open-source ;
    vc:enables ngm:gl-tf,
        ngm:interoperability,
        ngm:khronos-open-xr,
        ngm:vendor-neutrality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:conformance-testing,
        ngm:reference-implementation,
        ngm:specification ;
    vc:implements ngm:frand-licensing,
        ngm:royalty-free-licensing ;
    vc:isPartOf ngm:standards-ecosystem ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:api-design,
        ngm:open-data,
        ngm:protocol ;
    vc:requires ngm:consensus-process,
        ngm:open-governance ;
    vc:slug "open-standards" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:iso,
        ngm:khronos-group,
        ngm:w3c ;
    vc:supports ngm:digital-sovereignty,
        ngm:technology-transfer ;
    vc:uses ngm:request-for-comments,
        ngm:technical-committee .

ngm:openai-research-organisation-api a owl:Class ;
    rdfs:label "OpenAI API"@en ;
    rdfs:comment "The OpenAI API is a hosted programming interface that gives developers access to OpenAI's models for text generation, reasoning, embeddings, image generation, speech, and tool use over HTTP. Exposing capabilities through endpoints such as chat completions, responses, and embeddings, it abstracts model hosting, scaling, and inference behind a usage-priced REST interface with structured outputs, function calling, and streaming. Its conventions have become a de facto standard widely emulated by other providers and compatible open-source serving stacks."@en ;
    rdfs:subClassOf ngm:api ;
    vc:enables ngm:llm-application-framework,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:rest-api ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpt ;
    vc:slug "open-ai-api" ;
    vc:sourceDomain "ai" .

ngm:opentelemetry a skos:Concept ;
    rdfs:label "Opentelemetry"@en .

ngm:optical-sensors a owl:Class ;
    rdfs:label "Optical Sensors"@en ;
    rdfs:comment "Optical Sensors are devices that detect and convert light, across visible, infrared, or other wavelengths, into electrical signals for measurement or imaging. They include cameras, photodiodes, depth sensors, and structured-light or time-of-flight units used to capture scene geometry and motion. In capture and recognition systems they provide the primary visual input from which 3D structure, pose, and identity are inferred."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-performance-capture,
        ngm:human-capture-and-recognition ;
    vc:slug "optical-sensors" ;
    vc:sourceDomain "robotics" .

ngm:optical-systems a owl:Class ;
    rdfs:label "Optical Systems"@en ;
    rdfs:comment "Optical Systems are arrangements of lenses, mirrors, waveguides, and combiners that direct and form light to project or relay images. In display hardware they govern how rendered content is delivered to the eye, including focus, field of view, and image clarity. Augmented- and virtual-reality headsets depend on compact optical systems such as pancake lenses and waveguide combiners to merge virtual imagery with the real world."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-display-device,
        ngm:display-hardware ;
    vc:slug "optical-systems" ;
    vc:sourceDomain "metaverse" .

ngm:optimisation-algorithm a skos:Concept ;
    rdfs:label "Optimisation Algorithm"@en .

ngm:optimistic-governance a owl:Class ;
    rdfs:label "Optimistic Governance"@en ;
    rdfs:comment "Optimistic Governance is a DAO decision-making pattern in which proposals are assumed approved and can execute unless challenged within a defined dispute window. It reduces voting fatigue and gas costs by requiring active participation only to veto or contest actions rather than to ratify every routine decision. Disputes are resolved by escalation to a vote or an arbitration mechanism, trading some upfront scrutiny for operational efficiency."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:governance-token ;
    vc:slug "optimistic-governance" ;
    vc:sourceDomain "blockchain" .

ngm:optimization a skos:Concept ;
    rdfs:label "Optimization"@en .

ngm:outpainting a owl:Class ;
    rdfs:label "Outpainting"@en ;
    rdfs:comment "Outpainting is a generative AI technique that extends an existing image beyond its original canvas boundaries by synthesising new, contextually consistent pixel content in the surrounding regions. A masked version of the source image—padded with blank or noise-filled regions—is fed to a conditioned image generation model (typically a latent diffusion model) which fills the extended area while respecting the style, lighting, and semantic content of the original. Outpainting is widely used in content creation pipelines for widening aspect ratios, reconstructing damaged artwork borders, and generating panoramic background extensions for virtual production and 3D scene authoring."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:image-generation,
        ngm:inpainting ;
    vc:slug "outpainting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:latent-diffusion .

ngm:owl-2-web-ontology-language a owl:Class ;
    rdfs:label "OWL 2 Web Ontology Language"@en ;
    rdfs:comment "A World Wide Web Consortium standard for representing ontologies on the web, providing formal semantics based on description logic for classes, properties and individuals. It extends earlier web ontology work with richer modelling features and defined reasoning profiles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:owl ;
    vc:enables ngm:reasoning,
        ngm:semantic-reasoning-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:description-logic,
        ngm:rdf ;
    vc:slug "owl-2-web-ontology-language" ;
    vc:sourceDomain "standards" .

ngm:ownership-token a owl:Class ;
    rdfs:label "Ownership Token"@en ;
    rdfs:comment "An Ownership Token is a blockchain token that represents and confers title to an underlying asset, whether digital or real-world. Typically implemented as a non-fungible or semi-fungible token, holding it in a wallet constitutes provable control of the represented item, and transferring it transfers ownership. Ownership tokens enable trading, collateralization, and programmable rights over digital goods and tokenized property."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-goods,
        ngm:digital-real-estate ;
    vc:slug "ownership-token" ;
    vc:sourceDomain "blockchain" .

ngm:oxford-university a skos:Concept ;
    rdfs:label "Oxford University"@en .

ngm:parallel-corpus a owl:Class ;
    rdfs:label "Parallel Corpus"@en ;
    rdfs:comment "A Parallel Corpus is a collection of texts paired with their translations in one or more other languages, aligned at the sentence or segment level. It provides the supervised training signal for statistical and neural machine-translation systems by exemplifying how meaning maps across languages. The size, quality, and domain coverage of a parallel corpus strongly influence the accuracy of trained translation models."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:real-time-translation,
        ngm:translation ;
    vc:slug "parallel-corpus" ;
    vc:sourceDomain "ai" .

ngm:participant-consent a owl:Class ;
    rdfs:label "Participant Consent"@en ;
    rdfs:comment "Participant Consent is the explicit, informed agreement obtained from individuals before their voice, image, or data are recorded or processed. In meeting and communication contexts it is both an ethical norm and a legal requirement under many wiretapping and data-protection regimes, often necessitating clear notice and an opportunity to decline. Capturing and recording consent state is a prerequisite for lawful recording and downstream processing."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:meeting-recording ;
    vc:slug "participant-consent" ;
    vc:sourceDomain "governance" .

ngm:participant-coordination a owl:Class ;
    rdfs:label "Participant Coordination"@en ;
    rdfs:comment "The synchronization and management of multiple users interacting within shared virtual environments, requiring real-time pose tracking, coordinate system alignment, and collaborative state management to enable seamless multi-user experiences."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:multi-user-systems ;
    vc:enables ngm:shared-virtual-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participant-coordination" ;
    vc:sourceDomain "spatial-computing" .

ngm:participation-framework a owl:Class ;
    rdfs:label "Participation Framework"@en ;
    rdfs:comment "A structured approach to designing stakeholder engagement processes that establish goals, principles, mods, and mechanisms for involving citizens, communities, or users in decision-making, governance, and collaborative activities."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:governance-framework ;
    vc:enables ngm:inclusive-decision-making ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participation-framework" ;
    vc:sourceDomain "spatial-computing" .

ngm:participatory-policy-making a owl:Class ;
    rdfs:label "Participatory Policy Making"@en ;
    rdfs:comment "A governance approach that involves citizens and stakeholders directly in the formulation, design, and eof public policies through mechanisms such as citizen advisory boards, deliberative assemblies, and digital participation platforms."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:democratic-governance ;
    vc:enables ngm:policy-legitimacy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participatory-policy-making" ;
    vc:sourceDomain "spatial-computing" .

ngm:pathfinding a owl:Class ;
    rdfs:label "Pathfinding"@en ;
    rdfs:comment "Pathfinding is the computation of a route between two points in a graph or space, often the shortest or lowest-cost route. It is widely used in games, robotics, and navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-structure ],
        ngm:search-algorithm ;
    vc:enables ngm:navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-structure ;
    vc:slug "pathfinding" ;
    vc:sourceDomain "ai" .

ngm:pathology-ai a owl:Class ;
    rdfs:label "Pathology AI"@en ;
    rdfs:comment "Artificial intelligence systems for automated analysis of histopathology slides, cytology specimens, and other pathological images. Pathology AI performs tasks including cancer detection and grading, biomarker quantification, and morphological analysis using whole-slide imaging pipelines and deep learning architectures tailored for gigapixel images at multi-scale resolution."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:medical-imaging-ai ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:image-segmentation ;
    vc:enables ngm:medical-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:healthcare-analytics,
        ngm:radiology-ai ;
    vc:slug "pathology-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning .

ngm:payment-token a owl:Class ;
    rdfs:label "Payment Token"@en ;
    rdfs:comment "A Payment Token is a cryptocurrency token whose primary purpose is to serve as a medium of exchange and store of value for peer-to-peer and merchant payments, distinguished from utility tokens (access rights) and security tokens (equity/asset claims). Examples include Bitcoin, Litecoin, and CBDC-backed digital currencies."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:cryptocurrency-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:governance-token,
        ngm:stablecoin,
        ngm:utility-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:decentralized-finance-de-fi ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:cryptocurrency,
        ngm:digital-currency,
        ngm:lightning-network,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "payment-token" ;
    vc:sourceDomain "blockchain" .

ngm:peer-to-peer-trading a owl:Class ;
    rdfs:label "Peer-to-Peer Trading"@en ;
    rdfs:comment "Peer-to-peer trading is the direct exchange of assets between two parties without a centralised intermediary holding or matching the order. On blockchains it is typically mediated by smart contracts that escrow assets and enforce settlement atomically, removing custodial risk. It enables markets for tokens, NFTs, and goods to operate trustlessly through code rather than a central exchange."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barter-system,
        ngm:nft-swapping ;
    vc:slug "peer-to-peer-trading" ;
    vc:sourceDomain "blockchain" .

ngm:permissioned-network a owl:Class ;
    rdfs:label "Permissioned Network"@en ;
    rdfs:comment "A Permissioned Network is a distributed ledger architecture in which participation—whether as a validator, transaction submitter, or read-only observer—is restricted to entities that have been explicitly authorised by a governing body or membership protocol. Unlike public blockchains, nodes must satisfy identity verification, legal agreement, or technical credentialing requirements before joining, enabling stronger privacy guarantees, higher throughput, and deterministic finality than open networks while sacrificing censorship resistance. Permissioned networks are the dominant choice for enterprise and consortium deployments such as trade finance, healthcare data exchange, and central-bank digital currency infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:knowledge-graph-publication-classifier-blockchain ;
    vc:enables ngm:blockchain-compliance,
        ngm:blockchain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:validator-node ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:distributed-ledger-technology,
        ngm:private-blockchain ;
    vc:requires ngm:access-control,
        ngm:identity-management ;
    vc:slug "permissioned-network" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:smart-contract .

ngm:perpetual-futures a owl:Class ;
    rdfs:label "Perpetual Futures"@en ;
    rdfs:comment "Perpetual futures are derivative contracts that track an underlying asset's price without an expiry or settlement date. A periodic funding-rate payment between long and short holders tethers the contract price to the spot index, replacing the convergence that expiry provides in traditional futures. They are a dominant instrument in crypto derivatives markets, enabling leveraged directional exposure that can be held indefinitely."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:d-yd-x,
        ngm:gmx ;
    vc:slug "perpetual-futures" ;
    vc:sourceDomain "blockchain" .

ngm:pervasive-computing a owl:Class ;
    rdfs:label "Pervasive Computing"@en ;
    rdfs:comment "Pervasive computing — also termed ubiquitous computing — is a paradigm in which computational capability is embedded throughout the physical environment and integrated seamlessly into everyday objects and infrastructure, such that computation becomes a background utility rather than a discrete user activity. Coined by Mark Weiser at Xerox PARC in 1991, the vision encompasses context-aware, networked devices that sense, process, and communicate without explicit user interaction. It is the conceptual precursor to the Internet of Things and ambient intelligence."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:enables ngm:context-aware-computing,
        ngm:internet-of-things,
        ngm:wearable-computing-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:context-awareness,
        ngm:sociotechnical-system ;
    vc:slug "pervasive-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:io-t-sensor-network .

ngm:photorealistic-telepresence a owl:Class ;
    rdfs:label "Photorealistic Telepresence"@en ;
    rdfs:comment "Photorealistic telepresence is remote real-time communication in which participants appear as lifelike, volumetrically accurate representations rather than video tiles or stylised avatars. It reconstructs a person's appearance and motion using techniques such as neural avatars and 3D Gaussian splatting, rendering them convincingly in a shared spatial scene. The goal is a sense of co-presence that closely matches being physically together."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:ai-avatars ;
    vc:slug "photorealistic-telepresence" ;
    vc:sourceDomain "metaverse" .

ngm:physics-based-animation a owl:Class ;
    rdfs:label "Physics-Based Animation"@en ;
    rdfs:comment "Animation technique that computes object motion through real-time simulation of physical forces, gravity, collisions, and dynamics to create realistic movement and interactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:animation-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-simulation-engine ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:real-time-rendering ;
    vc:enables ngm:cloth-simulation,
        ngm:dynamic-character-animation,
        ngm:particle-systems,
        ngm:ragdoll-physics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collision-detection-system,
        ngm:constraint-solver,
        ngm:force-integrator,
        ngm:physics-simulation-engine ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-transform-system,
        ngm:animation-controller,
        ngm:physics-engine ;
    vc:slug "physics-based-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:plan-and-execute a owl:Class ;
    rdfs:label "Plan and Execute"@en ;
    rdfs:comment "Plan and execute is an agentic reasoning strategy in which an LLM-based agent first generates a multi-step plan for a task and then carries out each step, optionally re-planning when steps fail or new information appears. Separating planning from execution improves coherence on long-horizon tasks compared with purely reactive, single-step prompting. It is a common control pattern for autonomous and computer-use agents."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "plan-and-execute" ;
    vc:sourceDomain "ai" .

ngm:plan-and-execute-pattern a owl:Class ;
    rdfs:label "Plan and Execute Pattern"@en ;
    rdfs:comment "The plan-and-execute pattern is an agent-architecture design in which a dedicated planner component produces a structured task plan that an executor component then realises step by step using tools. Formalising the strategy as a reusable pattern lets agent frameworks separate high-level reasoning from low-level tool invocation, enabling re-planning and observability. It is widely implemented through function-calling pipelines in LLM agent frameworks."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:function-calling ;
    vc:slug "plan-and-execute-pattern" ;
    vc:sourceDomain "ai" .

ngm:play-to-earn-p2-e a owl:Class ;
    rdfs:label "Play-to-Earn (P2E)"@en ;
    rdfs:comment "Economic model and gameplay process where users gain real-world value through virtual participation, task completion, and reward distribution mechanisms that convert in-game achievements into tradeable assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
