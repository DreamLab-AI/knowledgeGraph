    rdfs:comment "SafeSnap is a tool that connects off-chain Snapshot governance votes to on-chain execution through a Gnosis Safe and the Reality.eth oracle. It lets DAOs enact decisions without paying gas to vote."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:snapshot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reality-eth ],
        ngm:dao-governance ;
    vc:enables ngm:decentralized-autonomous-organization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:reality-eth,
        ngm:snapshot ;
    vc:slug "safe-snap" ;
    vc:sourceDomain "defi" .

