ngm:gradient-compression a owl:Class ;
    rdfs:comment "A family of communication-efficiency techniques for distributed and federated machine learning that reduce the volume of gradient data exchanged between workers during training, using quantisation to fewer bits, sparsification of small-magnitude entries, or low-rank decomposition, usually combined with error-feedback so the accumulated compression error is reapplied and convergence is preserved."@en ;
    rdfs:label "Gradient Compression"@en ;
