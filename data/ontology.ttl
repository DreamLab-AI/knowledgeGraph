ngm:reverse-logistics a owl:Class ;
    rdfs:comment "Reverse logistics encompasses all operations related to the reuse, processing, and management of products and materials flowing backward through the supply chain from the consumer or end-of-life point toward the manufacturer or recycler. It includes product returns, refurbishment, remanufacturing, recycling, and responsible disposal, and is a key operational component of circular economy strategies."@en ;
    rdfs:label "Reverse Logistics"@en ;
    rdfs:subClassOf ngm:logistics ;
    rdfs:subClassOf _:r18208 ;
