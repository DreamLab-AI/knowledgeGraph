    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "co-ap" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems ;
    vc:uses ngm:rest-api .
ngm:co-creation a owl:Class ;
    rdfs:comment "Co-creation is a collaborative process in which two or more parties, including end users, jointly generate a product, design or piece of content rather than one party producing it for passive consumption by the others. It emphasises shared authorship and iterative feedback across the creative process, and is a common pattern in participatory design, open-source development and collaborative virtual environments. Co-creation is enabled by tools that support simultaneous, shared editing and by design methodologies that structure participant input."@en ;
    rdfs:label "Co-creation"@en ;
    rdfs:subClassOf ngm:collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:collaboration ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:slug "co-creation" ;
    vc:sourceDomain "distributed-collaboration" .
