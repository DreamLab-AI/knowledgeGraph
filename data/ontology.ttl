        ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:compliance,
        ngm:digital-identity ;
    vc:requires ngm:biometric-authentication,
        ngm:identity-verification,
        ngm:kyc ;
    vc:slug "digital-onboarding" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:anti-money-laundering,
        ngm:user-experience .

ngm:digital-repository a owl:Class ;
