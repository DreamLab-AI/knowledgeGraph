ngm:container-orchestration a owl:Class ;
    rdfs:label "Container Orchestration"@en ;
    rdfs:comment "Container orchestration is the automated management of the deployment, scaling, networking, and lifecycle of containerised workloads across a cluster of machines. An orchestrator continuously reconciles the observed state of the cluster with a declarative desired state, handling scheduling, health checking, self-healing, and rolling updates. It abstracts the underlying hosts into a single pool of compute, enabling resilient, horizontally scalable services without manual intervention."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:containerisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:auto-scaling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-discovery ],
        ngm:orchestration ;
    vc:dependsOn ngm:distributed-computing ;
    vc:enables ngm:fault-tolerance,
