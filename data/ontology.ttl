        <urn:visionflow:linked:self-sovereign-key-management> ;
    vc:hasPart <urn:visionflow:linked:bip-340-schnorr-keypair>,
        <urn:visionflow:linked:did-resolution>,
        vf:private-key,
        vf:public-key ;
