ngm:state-change a owl:Class ;
    rdfs:label "State Change"@en ;
    rdfs:comment "A State Change is the transition from one defined configuration or status to another within a system, component, or entity, representing how systems evolve through discrete or continuous modifications to their properties. State changes are fundamental to distributed systems, blockchain ledgers (where account balances and smart-contract storage are updated atomically), digital twins (where physical sensor readings update virtual representations), and agentic AI systems (where goal statuses transition through planning and execution). Formal modelling of state changes enables audit trails, causality analysis, and consistency guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-synchronization ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:state-machine,
        ngm:state-machine-replication,
        ngm:state-synchronization ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:digital-twin,
        ngm:distributed-systems,
        ngm:smart-contract,
        ngm:state-estimation ;
    vc:slug "state-change" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:event,
        ngm:event-driven-architecture,
        ngm:transaction .

ngm:style-guide a owl:Class ;
    rdfs:label "Style Guide"@en ;
    rdfs:comment "A Style Guide is a normative document specifying authoring conventions — voice, tone, markup syntax, citation format, and structural patterns — for consistent content creation within a knowledge graph or publication system. In the NarrativeGoldmine context it captures Logseq markdown conventions, UK English preferences, and the analytical-conversational register used throughout the graph."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-graph-construction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:semantic-web-standards,
        ngm:software-engineering ;
    vc:slug "style-guide" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-standard ;
    vc:supports ngm:knowledge-graph,
        ngm:ontology .

ngm:suggested-reading-order a owl:Class ;
    rdfs:label "Suggested Reading Order"@en ;
    rdfs:comment "Suggested Reading Order is a curated navigation guide that sequences the principal pages of the NarrativeGoldmine knowledge graph into a coherent pedagogical path. It maps the intended conceptual dependencies — from foundational web technologies through decentralisation, digital assets, spatial computing, and AI — enabling readers to build understanding progressively across the graph's interconnected topic areas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-of-the-art-in-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-web ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:adoption-of-convergent-technologies,
        ngm:convergence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:blockchain,
        ngm:semantic-web,
        ngm:spatial-computing,
        ngm:state-of-the-art-in-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-identity,
        ngm:update-cycle ;
    vc:slug "suggested-reading-order" ;
    vc:sourceDomain "infrastructure" .

ngm:summary a owl:Class ;
    rdfs:label "SUMMARY"@en ;
    rdfs:comment "The metaverse represents a convergent technological paradigm combining virtual reality, augmented reality, and extended reality to create persistent, 3D virtual shared environments enabling user interaction, economic transactions, and social collaboration. This digital infrastructure integrates blockchain-based assets, smart contracts, and decentralised identity systems to support genuine digital ownership, interoperability, and governance across platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:extended-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:extended-reality,
        ngm:virtual-reality ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:metaverse ;
    vc:slug "summary" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:smart-contracts,
        ngm:spatial-computing .

ngm:surface-marine-robot a owl:Class ;
    rdfs:label "Surface Marine Robot"@en ;
    rdfs:comment "A Surface Marine Robot, also known as an Unmanned Surface Vehicle (USV), is an autonomous or remotely operated robotic platform that operates on the surface of bodies of water—oceans, lakes, rivers, and coastal zones. It performs tasks including hydrographic survey, environmental monitoring, maritime patrol, search-and-rescue support, and data relay without requiring an onboard crew, thereby reducing operational cost and human risk in hazardous or remote marine environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:marine-robot ;
    vc:contrastsWith ngm:aerial-robot,
        ngm:underwater-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:inspection-robot,
        ngm:remotely-operated-vehicle-rov ;
    vc:requires ngm:motion-planning,
        ngm:navigation-system ;
    vc:slug "surface-marine-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:lidar,
        ngm:perception-system .

ngm:synchronous-execution a owl:Class ;
    rdfs:label "Synchronous Execution"@en ;
    rdfs:comment "Synchronous Execution is a computational execution model in which operations are performed sequentially, with each call blocking the invoking thread until a result is returned before the next operation begins. This model provides deterministic, predictable control flow and simplifies error handling, making it well-suited for transactional operations, authentication flows, and ACID-compliant database interactions, though it constrains throughput and scalability under high-concurrency workloads."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:execution-model ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:asynchronous-execution,
        ngm:event-driven-architecture ;
    vc:enables ngm:state-machine-replication,
        ngm:transaction-confirmation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:state-machine,
        ngm:transaction-finality,
        ngm:transaction-processing ;
    vc:slug "synchronous-execution" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract-execution .

ngm:task-adaptation a owl:Class ;
    rdfs:label "Task Adaptation"@en ;
    rdfs:comment "The process of specialising a pre-trained or general-purpose machine learning model to perform well on a specific downstream task by adjusting its parameters, architecture, or inference behaviour. Task adaptation encompasses techniques such as fine-tuning, instruction tuning, prompt engineering, and parameter-efficient methods (LoRA, adapters) that bridge the gap between a model's pre-training distribution and the requirements of a target application."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:federated-learning ;
    vc:dependsOn ngm:machine-learning-model,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:enables ngm:machine-learning-pipeline,
        ngm:task-specific-head ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:hyperparameter ;
    vc:slug "task-adaptation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:instruction-tuning,
        ngm:prompt-engineering .

ngm:tc-0002-collaborative-document-editing a owl:Class ;
    rdfs:label "tc 0002 collaborative document editing"@en ;
    rdfs:comment "Collaborative Document Editing - Real-time or asynchronous shared editing technology enabling multiple distributed users to simultaneously create, modify, and comment on digital documents with live synchronization and version control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
