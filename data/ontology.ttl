ngm:resource-efficiency a owl:Class ;
    rdfs:label "Resource Efficiency"@en ;
    rdfs:comment "Resource efficiency is the practice of producing the same output or value while consuming fewer material, energy, or computational inputs. It encompasses minimising waste, reusing by-products, and optimising processes so that resources deliver maximum useful work. In sustainability and industrial contexts it is a primary lever for reducing cost and environmental footprint."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-symbiosis,
