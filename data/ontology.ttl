        ngm:real-time-processing ;
    vc:slug "apache-kafka" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:monitoring-dashboard ;
    vc:uses ngm:batch-processing,
        ngm:data-processing,
        ngm:distributed-computing .

ngm:asic a owl:Class ;
    rdfs:label "ASIC"@en ;
    rdfs:comment "An Application-Specific Integrated Circuit (ASIC) is a custom integrated circuit designed and fabricated to perform a specific function or narrow set of functions with maximum efficiency, in contrast to general-purpose processors such as CPUs and GPUs that are optimised for programmable flexibility. ASICs achieve superior performance-per-watt and cost efficiency at volume compared to programmable alternatives by eliminating logic that would support unused instruction sets or configurations. They are central to cryptocurrency mining, AI inference acceleration, networking hardware, and consumer electronics where power, cost, and performance constraints demand purpose-built silicon."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:contrastsWith ngm:fpga,
        ngm:gpu-compute ;
    vc:enables ngm:hardware-acceleration,
        ngm:inference-hardware,
        ngm:neural-processing-unit ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:hardware-component ;
    vc:slug "asic" ;
    vc:sourceDomain "infrastructure" .

ngm:audio-processing-system a owl:Class ;
    rdfs:label "Audio Processing System"@en ;
    rdfs:comment "An Audio Processing System is a hardware or software subsystem responsible for capturing, transforming, and rendering audio signals within spatial computing environments. It encompasses digital signal processing, spatial audio rendering (binaural, ambisonics, HRTF), noise cancellation, speech recognition integration, and real-time mixing for immersive presence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-spatialization ],
