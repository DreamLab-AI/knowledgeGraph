    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "neural-networking" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:distributed-computing,
        ngm:real-time ;
    vc:uses ngm:deep-learning,
        ngm:neural-network .

ngm:neural-xr-interfaces a owl:Class ;
    rdfs:label "Neural XR Interfaces"@en ;
    rdfs:comment "Direct neural input modalities for spatial computing systems, ranging from non-invasive EMG wristbands and EEG headsets to invasive brain-computer interfaces. Bridges neurotechnology with XR interaction paradigms, enabling thought-driven navigation, selection, and manipulation in virtual and augmented environments."@en ;
