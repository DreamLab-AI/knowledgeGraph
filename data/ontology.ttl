ngm:operator-fusion a owl:Class ;
    rdfs:label "Operator Fusion"@en ;
    rdfs:comment "Operator fusion is a compiler optimisation that combines several consecutive operations in a neural network computation graph into a single fused kernel. By merging operations such as a matrix multiply with its bias addition and activation function, fusion avoids writing intermediate tensors back to memory, reducing memory bandwidth pressure and kernel launch overhead. It is a core technique in machine learning compilers and inference runtimes for improving throughput and latency on accelerators. Fusion trades increased kernel complexity for fewer round trips to global memory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compiler ],
        ngm:model-optimization ;
    vc:contrastsWith ngm:model-optimization ;
    vc:dependsOn ngm:memory-bandwidth ;
    vc:enables ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hardware-acceleration ;
    vc:implements ngm:hardware-acceleration ;
    vc:isPartOf ngm:compiler ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:memory-bandwidth,
        ngm:neural-network ;
    vc:requires ngm:compiler ;
    vc:slug "operator-fusion" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:inference ;
    vc:uses ngm:gpu,
        ngm:onnx .

ngm:optimisation-algorithm a owl:Class ;
    rdfs:label "Optimisation Algorithm"@en ;
    rdfs:comment "An optimisation algorithm is a systematic procedure for finding the values of decision variables that minimise or maximise an objective function, optionally subject to constraints. It spans first-order gradient methods, second-order Newton-type methods, derivative-free and metaheuristic search, and convex programming solvers, each trading convergence speed, robustness, and assumptions about the objective. In machine learning, optimisation algorithms drive model training by iteratively reducing a loss function, making them the engine that turns data and architecture into fitted parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        ngm:mathematical-optimisation ;
    vc:dependsOn ngm:loss-function,
        ngm:objective-function ;
    vc:enables ngm:deep-learning,
        ngm:hyperparameter-optimisation,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gradient-descent,
        ngm:stochastic-gradient-descent ;
    vc:implements ngm:convex-optimisation ;
    vc:isPartOf ngm:mathematical-optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:genetic-algorithm,
        ngm:hyperparameter-tuning,
        ngm:simulated-annealing ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent ;
    vc:slug "optimisation-algorithm" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:statistics .

ngm:order-book-exchange a owl:Class ;
    rdfs:label "Order Book Exchange"@en ;
    rdfs:comment "An order book exchange is a trading venue that matches buy and sell orders through a central limit order book, an ordered record of outstanding bids and asks at each price level. A matching engine pairs incoming orders against resting liquidity according to price-time priority, executing trades and updating the book in real time. This model, dominant in traditional equities, futures, and centralised cryptocurrency exchanges, contrasts with automated market makers that price trades algorithmically against pooled liquidity rather than against discrete counter-orders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        ngm:market-microstructure ;
    vc:bridgesTo ngm:decentralized-exchange ;
    vc:contrastsWith ngm:automated-market-maker,
        ngm:decentralized-exchange,
        ngm:liquidity-mining ;
    vc:dependsOn ngm:market-microstructure ;
    vc:enables ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:financial-system ;
    vc:requires ngm:latency,
        ngm:liquidity ;
    vc:slug "order-book-exchange" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:latency .

ngm:pairwise-comparison a owl:Class ;
    rdfs:label "Pairwise Comparison"@en ;
    rdfs:comment "Pairwise comparison is a method of evaluation in which items are judged two at a time, with each judgement expressing which of the two is preferred or superior on some criterion. Because relative judgements are easier and more reliable for humans than absolute scoring, pairwise comparison is widely used to elicit preferences and to construct rankings from many such local decisions. Statistical models such as the Bradley-Terry model convert collections of pairwise outcomes into latent strength or quality scores. In machine learning it is the dominant feedback format for training reward models and aligning language models with human preferences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:preference-learning ;
    vc:dependsOn ngm:human-feedback ;
    vc:enables ngm:preference-learning,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bradley-terry-model ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimisation,
        ngm:reward-model ;
    vc:requires ngm:human-feedback,
        ngm:preference-learning ;
    vc:slug "pairwise-comparison" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:recommendation-system,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:uses ngm:bradley-terry-model,
        ngm:probability-distribution .

ngm:parametric-insurance a owl:Class ;
    rdfs:label "Parametric Insurance"@en ;
    rdfs:comment "Parametric insurance is a form of coverage that pays a predetermined amount when a measurable trigger event crosses a defined threshold, rather than indemnifying assessed losses. Because payouts depend on objective parameters such as rainfall, wind speed, earthquake magnitude, or flight delay, claims can be settled automatically without loss adjustment. On blockchains, parametric insurance is implemented through smart contracts that consume oracle data to verify triggers and disburse funds, enabling fast, transparent, and trust-minimised settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:decentralized-finance ;
    vc:bridgesTo ngm:supply-chain ;
    vc:contrastsWith ngm:insurance ;
    vc:dependsOn ngm:blockchain-oracle,
        ngm:oracle ;
    vc:enables ngm:arbitrage ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:decentralized-finance,
        ngm:insurance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:de-fi,
        ngm:liquidity-pool,
        ngm:token-economics ;
    vc:requires ngm:smart-contract ;
    vc:slug "parametric-insurance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:de-fi ;
    vc:uses ngm:blockchain-oracle,
        ngm:smart-contract .

ngm:patch-management a owl:Class ;
    rdfs:label "Patch Management"@en ;
    rdfs:comment "Patch management is the systematic process of acquiring, testing, prioritising, and deploying software updates across an organisation's systems to remediate vulnerabilities and defects. It tracks asset inventory and known vulnerabilities, schedules and stages patches to balance risk against operational disruption, and verifies that fixes are applied. Effective patch management is a core control for reducing the window during which known exploits can be used."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:configuration-management ],
        ngm:vulnerability-management ;
    vc:bridgesTo ngm:cybersecurity ;
    vc:contrastsWith ngm:incident-response ;
    vc:dependsOn ngm:vulnerability ;
    vc:enables ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:incident-response ;
    vc:implements ngm:vulnerability-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:vulnerability,
        ngm:vulnerability-management ;
