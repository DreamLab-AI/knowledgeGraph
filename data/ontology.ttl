ngm:ieee-802-15-4 a owl:Class ;
    rdfs:label "IEEE 802.15.4"@en ;
    rdfs:comment "IEEE 802.15.4 is a low-rate wireless personal area network (LR-WPAN) standard that specifies the physical layer (PHY) and medium access control (MAC) sublayer for short-range, low-power, low-data-rate wireless communication, operating primarily in the 2.4 GHz ISM band at up to 250 kbps. It serves as the foundational radio layer for higher-level IoT protocols including Zigbee, Thread, WirelessHART, and 6LoWPAN, enabling battery-powered sensor and actuator networks with multi-year device lifetimes."@en ;
    rdfs:subClassOf ngm:ieee-802-x ;
    vc:contrastsWith ngm:ieee-802-11 ;
    vc:enables ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:matter-protocol,
        ngm:thread-protocol,
        ngm:wireless-hart,
        ngm:zigbee ;
    vc:slug "ieee-802-15-4" ;
    vc:sourceDomain "infrastructure" .

ngm:infrastructure-architecture a owl:Class ;
    rdfs:label "Infrastructure Architecture"@en ;
    rdfs:comment "The foundational technical framework supporting metaverse platforms, comprising cloud computing, edge networks, distributed systems, and computing power networks that enable scalable, low-latency delivery of immersive virtual experiences."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud,
        ngm:technical-architecture ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrastructure-architecture" ;
    vc:sourceDomain "infrastructure" .

ngm:instance-segmentation a owl:Class ;
    rdfs:label "Instance Segmentation"@en ;
    rdfs:comment "A computer vision task that extends object detection by predicting precise pixel-level masks for each individual object instance, jointly performing detection and segmentation to delineate the exact boundaries of distinct objects. Architectures such as Mask R-CNN, YOLACT, and SOLOv2 enable fine-grained object localisation essential for robotics manipulation, autonomous driving, and medical image analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:computer-vision,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:panoptic-segmentation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task ;
    vc:requires ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:slug "instance-segmentation" ;
    vc:sourceDomain "spatial-computing" .

ngm:knowledge-distillation-for-edge a owl:Class ;
    rdfs:label "Knowledge Distillation for Edge"@en ;
    rdfs:comment "Model compression technique that transfers learned representations from large, accurate teacher neural networks to compact student models optimised for edge deployment, achieving 20-30x size reduction while retaining 97%+ of accuracy through soft-target training, temperature scaling, and layer-wise representation matching."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:edge-ai-system,
        ngm:on-device-learning,
        ngm:tiny-ml ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:edge-computing,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:neural-network-quantisation ;
    vc:slug "knowledge-distillation-for-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning,
        ngm:neural-network,
        ngm:transfer-learning .

ngm:learning-rate-schedule a owl:Class ;
    rdfs:label "Learning Rate Schedule"@en ;
    rdfs:comment "A systematic strategy for varying the learning rate hyperparameter during model training, either according to a fixed rule (step decay, cosine annealing, exponential decay) or adaptively in response to training signals. Learning rate schedules improve convergence and final model performance by applying higher rates early for rapid progress and lower rates during fine-tuning, thereby reducing the risk of overshooting loss minima."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:training-and-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-framework,
        ngm:neural-network ;
    vc:requires ngm:deep-learning,
        ngm:machine-learning ;
    vc:slug "learning-rate-schedule" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:training .

ngm:legal-compliance a owl:Class ;
    rdfs:label "Legal Compliance"@en ;
    rdfs:comment "Legal compliance in the context of AI systems encompasses the organisational processes, controls, and evidence required to demonstrate adherence to applicable legislation, regulatory requirements, technical standards, and contractual obligations across the full lifecycle of AI development, deployment, and operation. Key legal instruments include the EU AI Act (risk-based product safety regulation), the GDPR (lawful processing and data subject rights for personal data used in training and inference), sector-specific financial regulations, and product liability laws. Compliance obligations are operationalised through risk assessments, technical documentation, conformity procedures, and ongoing monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
