ngm:noise-protocol a owl:Class ;
    rdfs:label "Noise Protocol"@en ;
    rdfs:comment "The Noise Protocol Framework is a toolkit for building secure cryptographic handshake protocols based on Diffie-Hellman key agreement. Rather than a single fixed protocol, it defines a set of composable handshake patterns from which designers select to obtain specific authentication, confidentiality, and forward-secrecy properties. Its simplicity and clear security properties have made it the basis for transport security in messaging and peer-to-peer systems."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:signal-protocol ;
    vc:slug "noise-protocol" ;
    vc:sourceDomain "security" .

ngm:non-interactive-proof a owl:Class ;
    rdfs:label "Non Interactive Proof"@en ;
    rdfs:comment "A Non-Interactive Proof (NIP) is a cryptographic proof system in which the prover transmits a single message to the verifier, without any back-and-forth challenge-response rounds, allowing verification of a claim without ongoing interaction. Non-interactive proofs are typically constructed from interactive protocols via the Fiat-Shamir heuristic, replacing the verifier's random challenge with a hash of the prover's first message, binding the proof to the statement. The resulting proof string can be broadcast publicly, stored on-chain, or verified asynchronously by any party possessing the verification key. Non-interactive zero-knowledge proofs (NIZKs) additionally guarantee that the proof reveals nothing beyond the truth of the statement, and form the foundation of [[ZK-SNARK]] and [[ZK-STARKs]] schemes used in blockchain privacy and scalability applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:cryptographic-proof ;
    vc:bridgesTo ngm:zero-knowledge-machine-learning ;
    vc:contrastsWith ngm:interactive-proof-system ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:cryptographic-primitive ;
    vc:enables ngm:zero-knowledge-rollup,
        ngm:zk-snarks,
        ngm:zk-starks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-proof,
        ngm:cryptographic-verification ;
    vc:implements ngm:cryptographic-proof-system,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bulletproofs,
        ngm:cryptographic-proofs,
        ngm:interactive-proof-system,
        ngm:stark ;
    vc:slug "non-interactive-proof" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cryptographic-security,
        ngm:privacy-preserving-blockchain ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:zk-snark .

