    vc:slug "central-bank-digital-currency-cbdc" ;
    vc:sourceDomain "infrastructure" .

ngm:centralised-finance a owl:Class ;
    rdfs:label "Centralised Finance"@en ;
    rdfs:comment "Centralised Finance (CeFi) is a model of financial service provision in which a trusted intermediary custodies user assets and operates the order books, matching engines and settlement rails on behalf of participants. In the cryptocurrency context it denotes exchanges and lending platforms that hold customer funds in pooled wallets and enforce identity verification, in contrast to non-custodial, smart-contract-mediated alternatives. CeFi platforms offer familiar account models, fiat on-ramps and regulatory compliance at the cost of counterparty trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiat-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        ngm:finance ;
    vc:bridgesTo ngm:traditional-finance ;
    vc:contrastsWith ngm:decentralised-finance,
        ngm:self-regulation ;
    vc:dependsOn ngm:authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:global-digital-finance,
        ngm:stablecoin,
        ngm:tokenomics ;
    vc:requires ngm:compliance,
        ngm:fiat-currency ;
    vc:slug "centralised-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:centralised-exchange,
        ngm:custodial-wallet,
        ngm:kyc .

ngm:chainlink a owl:Class ;
    rdfs:label "Chainlink"@en ;
    rdfs:comment "Chainlink is a decentralised oracle network and middleware layer that enables smart contracts on any blockchain to securely access off-chain data, computation, and cross-chain interoperability services. Founded in 2017 by Sergey Nazarov and Steve Ellis, it operates a network of independent node operators who retrieve, aggregate, and deliver external data — including price feeds, verifiable randomness, API responses, and event outcomes — to on-chain smart contracts, solving the oracle problem that prevents blockchains from natively interacting with real-world information. Its native token (LINK) provides cryptoeconomic incentives and collateral for node operators, whilst its Off-Chain Reporting protocol reduces on-chain costs through peer-to-peer consensus. Beyond data feeds, Chainlink has expanded into cross-chain messaging (CCIP), on-chain automation, and verifiable computation, positioning itself as general-purpose decentralised infrastructure for the entire blockchain ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chainlink-oracles ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chainlink-ccip ],
        ngm:blockchain-oracle ;
    vc:bridgesTo ngm:internet-of-things,
        ngm:traditional-finance ;
    vc:dependsOn ngm:cryptoeconomics,
        ngm:smart-contract,
        ngm:staking ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:enterprise-smart-contracts ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chainlink-ccip,
        ngm:chainlink-oracles ;
    vc:isPartOf ngm:decentralized-finance-de-fi ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-messaging,
        ngm:decentralized-autonomous-organization ;
    vc:requires ngm:cryptographic-signature,
        ngm:ethereum,
        ngm:peer-to-peer-network ;
    vc:slug "chainlink" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:defi-protocol,
        ngm:non-fungible-token,
        ngm:tokenization ;
    vc:uses ngm:off-chain-reporting,
        ngm:threshold-signature-scheme .

ngm:challenge-response-protocol a owl:Class ;
    rdfs:label "Challenge-Response Protocol"@en ;
    rdfs:comment "A challenge-response protocol is an authentication protocol in which a verifier issues an unpredictable challenge and the claimant must return a response computed from a shared secret or private key, proving knowledge of the credential without transmitting it. Because each challenge is fresh, typically a random nonce, a valid response cannot be reused, defeating replay attacks. The pattern underpins many authentication mechanisms including CHAP, HMAC-based schemes, and public-key signature challenges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:authentication-protocol ;
    vc:contrastsWith ngm:zero-knowledge-proof ;
    vc:enables ngm:identity-verification,
        ngm:mutual-authentication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cryptographic-protocol,
        ngm:nonce ;
    vc:implements ngm:authentication-protocol ;
    vc:isPartOf ngm:authentication-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:kerberos ;
    vc:slug "challenge-response-protocol" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:authentication-standards ;
    vc:supports ngm:authentication,
        ngm:passwordless-authentication ;
    vc:uses ngm:digital-signature,
        ngm:encryption .

ngm:chaos-theory a owl:Class ;
    rdfs:label "Chaos Theory"@en ;
    rdfs:comment "Chaos theory is the study of deterministic dynamical systems whose long-term behaviour is highly sensitive to initial conditions, making them practically unpredictable despite obeying fixed deterministic rules. It characterises phenomena such as strange attractors, bifurcations, and the exponential divergence of nearby trajectories measured by Lyapunov exponents. It matters because it explains how simple nonlinear rules can produce complex, aperiodic behaviour, bridging deterministic dynamics and apparent randomness in physical, biological, and economic systems."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:emergence,
        ngm:self-organisation ;
    vc:slug "chaos-theory" ;
    vc:sourceDomain "data" .

ngm:climate-action a owl:Class ;
    rdfs:label "Climate Action"@en ;
    rdfs:comment "Climate action refers to coordinated efforts to mitigate climate change by reducing greenhouse-gas emissions and to adapt human and natural systems to its impacts. It spans policy, finance, technology and behaviour, from decarbonising energy and transport to protecting ecosystems and building resilience against extreme weather. Frameworks such as the Paris Agreement set the shared goal of limiting global warming, and pathways toward net zero translate that goal into concrete reductions across economies and supply chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-neutrality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:renewable-energy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decarbonisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decarbonisation ],
        ngm:environmental-sustainability ;
    vc:dependsOn ngm:renewable-energy ;
    vc:enables ngm:carbon-neutrality,
        ngm:net-zero ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-neutrality,
        ngm:decarbonisation ;
    vc:isPartOf ngm:sustainable-development ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint,
        ngm:circular-economy,
        ngm:climate-change ;
    vc:requires ngm:decarbonisation,
        ngm:renewable-energy ;
    vc:slug "climate-action" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:paris-agreement ;
    vc:supports ngm:esg,
        ngm:sustainability ;
    vc:uses ngm:carbon-accounting,
        ngm:lifecycle-assessment .

