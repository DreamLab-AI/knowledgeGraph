    vc:enables ngm:dijkstra-algorithm,
        ngm:discrete-event-simulation,
        ngm:heuristic-search,
        ngm:pathfinding,
        ngm:priority-scheduling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-structure,
        ngm:graph-search ;
    vc:requires ngm:data-structure ;
    vc:slug "priority-queue" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:event-driven-architecture,
        ngm:optimization-algorithm,
        ngm:task-scheduling ;
    vc:uses ngm:dynamic-programming,
        ngm:graph-search .

ngm:process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "A coordinated sequence of activities, state changes, and events that transforms inputs into outputs to achieve a specific goal or outcome."@en ;
