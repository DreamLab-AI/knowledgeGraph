    vc:slug "virtual-transactions" ;
    vc:sourceDomain "metaverse" .

ngm:virtual-try-on a owl:Class ;
    rdfs:label "Virtual Try-On"@en ;
    rdfs:comment "Virtual try-on is a computer vision and graphics technique that overlays clothing, accessories, or cosmetics onto an image or video of a person so they can preview how an item would look."@en ;
