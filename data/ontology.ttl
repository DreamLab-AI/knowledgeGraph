ngm:precision-agriculture a owl:Class ;
    rdfs:comment "Precision agriculture is a farming-management approach that uses sensing, geolocation, and data analytics to observe and respond to variability within fields at fine spatial resolution. It applies inputs such as water, fertiliser, and pesticide only where and when needed, improving yield and reducing waste. It integrates IoT sensors, satellite and drone imagery, and increasingly autonomous ground robots."@en ;
    rdfs:label "Precision Agriculture"@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
