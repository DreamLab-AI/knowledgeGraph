ngm:smart-contract-audit a owl:Class ;
    rdfs:comment "A smart contract audit is a structured security review of on-chain contract code that seeks to identify vulnerabilities, logic errors and economic flaws before deployment to an immutable ledger. Auditors combine manual code review with static analysis, automated scanners and, where warranted, formal verification to assess correctness against the intended specification. Because deployed contracts often custody substantial value and cannot easily be patched, auditing is a critical control in the blockchain and decentralised finance lifecycle."@en ;
    rdfs:label "Smart Contract Audit"@en ;
    rdfs:subClassOf ngm:security-audit ;
    rdfs:subClassOf _:r19451 ;
    rdfs:subClassOf _:r19452 ;
    rdfs:subClassOf _:r19453 ;
    rdfs:subClassOf _:r19454 ;
    rdfs:subClassOf _:r19455 ;
