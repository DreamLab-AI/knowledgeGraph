ngm:innovation-diffusion a owl:Class ;
    rdfs:label "Innovation Diffusion"@en ;
    rdfs:comment "Innovation diffusion is the process by which a new technology, practice or idea spreads through a population over time. It is studied with adoption curves that describe how successive groups take up an innovation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
