ngm:plutocracy a skos:Concept ;
    rdfs:label "Plutocracy"@en .

ngm:plutocratic-voting a owl:Class ;
    rdfs:label "Plutocratic Voting"@en ;
    rdfs:comment "Plutocratic voting is a governance model in which voting power is proportional to the quantity of tokens, shares, or stake an actor holds, so that wealthier participants exert correspondingly greater influence over collective decisions. It is the default in most token-based on-chain governance systems, where one token equals one vote. While simple and Sybil-resistant by construction, it concentrates control among large holders and can entrench incumbent interests."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:delegation ],
        ngm:governance ;
    vc:bridgesTo ngm:decentralization ;
    vc:contrastsWith ngm:conviction-voting,
        ngm:quadratic-voting ;
    vc:dependsOn ngm:token-weighted-voting ;
    vc:enables ngm:dao-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:on-chain-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collective-decision-making,
        ngm:governance,
        ngm:sybil-resistance,
        ngm:tokenomics,
        ngm:voting-mechanism ;
    vc:requires ngm:delegation ;
    vc:slug "plutocratic-voting" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-autonomous-organization ;
    vc:uses ngm:governance-token .

ngm:pneumatic-motor a owl:Class ;
    rdfs:label "Pneumatic Motor"@en ;
    rdfs:comment "A Pneumatic Motor is an actuator that converts the energy stored in compressed air into continuous rotational mechanical motion, producing torque and speed proportional to the supply pressure and airflow rate. Pneumatic motors are characterised by high power-to-weight ratios, inherent overload protection through stall behaviour, and suitability for hazardous environments where electrical motors would pose ignition risks. They are widely used in industrial tooling, material handling equipment, and mobile robotics applications requiring lightweight, spark-free drive systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:torque ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pneumatic-actuator ],
        ngm:pneumatic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:hydraulic-motor,
