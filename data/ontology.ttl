ngm:tc-0080-team-coordination a owl:Class ;
    rdfs:label "TC-0080-Team-Coordination"@en ;
    rdfs:comment "Team coordination is the management of dependencies between people, tasks and resources so that members of a group act in a consistent and timely way towards shared objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
