ngm:fatf-40-recommendations a owl:Class ;
    rdfs:label "FATF 40 Recommendations"@en ;
    rdfs:comment "The FATF 40 Recommendations are the international standards on combating money laundering, terrorist financing, and proliferation financing issued by the Financial Action Task Force. They define a comprehensive framework covering customer due diligence, beneficial-ownership transparency, suspicious-transaction reporting, supervision, and international cooperation. National regimes implement them to achieve compliance assessed through FATF mutual evaluations."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:regulatory-compliance ;
    vc:slug "fatf-40-recommendations" ;
    vc:sourceDomain "blockchain" .

ngm:federated-social-networks a owl:Class ;
    rdfs:label "Federated Social Networks"@en ;
    rdfs:comment "Federated social networks are distributed communication platforms composed of independently operated servers that interoperate via shared open protocols, allowing users on different instances to follow, mention, and exchange content across administrative boundaries without centralised ownership. The model contrasts with siloed proprietary networks by enabling user data portability, operator sovereignty, and community-driven moderation policies."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:contrastsWith ngm:social-network-graph ;
    vc:enables ngm:data-privacy,
        ngm:social-network-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:interoperability-standard ;
    vc:slug "federated-social-networks" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:activity-pub,
        ngm:distributed-system-protocol .

ngm:federation-surface a owl:Class ;
    rdfs:label "Federation Surface"@en ;
    rdfs:comment "A standardised JSON-LD 1.1 encoding surface (S1–S11) that exposes agent state, credentials, events, and work metadata in a queryable, linkable format, enabling federated consumption by heterogeneous external systems (monitoring dashboards, compliance audits, blockchain oracles, knowledge grap..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-ld-1-1-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w-3-c-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-data-interchange-format-ld-context ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linked-data-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:uri-canonicaliser ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressing ],
        ngm:infra-network-and-comms,
        ngm:middleware-layer ;
