ngm:node-graph-visual-programming-interface a owl:Class ;
    rdfs:label "Node-Graph Visual Programming Interface"@en ;
    rdfs:comment "A paradigm of graphical programming in which computational logic is authored by connecting discrete functional nodes via edges rather than writing textual code. Node-based interfaces lower the barrier to complex workflow construction, making them prevalent in AI pipeline tools (e.g., ComfyUI, Flowise), creative software (shader editors, compositing), and knowledge-graph visualisation environments."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:user-interface ;
    vc:enables ngm:knowledge-graph,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph-construction ;
    vc:slug "node-graph-visual-programming-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:user-interface-architecture ;
    vc:uses ngm:data-visualisation .

