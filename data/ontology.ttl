ngm:validator-set a owl:Class ;
    rdfs:label "Validator Set"@en ;
    rdfs:comment "A validator set is the collection of nodes in a proof-of-stake or delegated consensus blockchain that are authorised to propose, attest, and finalise new blocks in each epoch. Validators are typically selected through staking—locking collateral that is subject to slashing penalties for misbehaviour—ensuring economic alignment with protocol security. The composition of the validator set changes at epoch boundaries based on delegation, unbonding, and slashing events, and its size determines the trade-off between decentralisation and consensus latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:validator-node ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:delegated-proof-of-stake,
        ngm:epoch ;
    vc:requires ngm:consensus-mechanism,
        ngm:proof-of-stake ;
    vc:slug "validator-set" ;
    vc:sourceDomain "blockchain" .

