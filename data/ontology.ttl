    vc:dependsOn ngm:internet-protocol,
        ngm:packet-switching ;
    vc:enables ngm:application-layer,
        ngm:integration-layer,
        ngm:protocol-layer,
        ngm:session-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:congestion-control,
        ngm:connection-management,
        ngm:error-detection-and-correction,
        ngm:flow-control,
        ngm:segmentation-and-reassembly ;
    vc:implements ngm:quic-protocol,
