    vc:slug "state-of-the-art-in-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:state-space-models a owl:Class ;
    rdfs:label "State Space Models"@en ;
    rdfs:comment "State space models are sequence models that maintain a hidden state evolving over time according to linear dynamics, used as an alternative to attention for long sequences. Recent deep learning variants make the dynamics input-dependent to capture context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:state-space-model ;
    vc:enables ngm:generative-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:neural-network ;
    vc:slug "state-space-models" ;
    vc:sourceDomain "deep-learning" .

ngm:stewart-platform a owl:Class ;
    rdfs:label "Stewart Platform"@en ;
    rdfs:comment "A Stewart Platform (also known as a Gough-Stewart platform) is a type of parallel manipulator consisting of six variable-length prismatic actuators (struts) connecting a fixed base plate to a moveable top plate via universal or spherical joints, enabling six degrees of freedom—three translational and three rotational—within a compact, high-stiffness mechanical structure. First described by V.E. Gough in 1954 for tyre testing and later analysed by D. Stewart in 1965 for flight simulation, the architecture is characterised by high load-bearing capacity, positional accuracy, and mechanical rigidity compared to serial manipulators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:parallel-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:robot-joint ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:robot-singularity,
        ngm:surgical-robot ;
    vc:requires ngm:kinematics,
        ngm:motion-planning,
        ngm:robot-dynamics ;
    vc:slug "stewart-platform" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-control,
        ngm:robot-kinematics .

ngm:storytelling a owl:Class ;
    rdfs:label "Storytelling"@en ;
    rdfs:comment "The craft and practice of structuring narrative content to communicate meaning, emotion, and experience to an audience. In spatial computing and metaverse contexts, storytelling encompasses interactive narrative design, world-building, and immersive experience creation that leverage real-time 3D environments to place participants inside the story."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
