ngm:distributed-training a owl:Class ;
    rdfs:label "Distributed Training"@en ;
    rdfs:comment "Distributed training is a machine learning paradigm that partitions computation, data, and model parameters across multiple processors, accelerators, or networked nodes so that training jobs too large or too slow for a single device can complete at scale. The four primary parallelism axes are data parallelism (each worker processes a distinct data shard and aggregates gradients), model parallelism (layers assigned to different devices), tensor parallelism (individual weight matrices sharded across devices), and pipeline parallelism (the forward pass staged across devices as a micro-batch pipeline). These strategies are composed into multi-dimensional schemes — commonly called 3D parallelism — that balance compute, memory, and communication trade-offs for workloads ranging from fine-tuning to pre-training frontier models with hundreds of billions of parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pipeline-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-parallelism ],
        ngm:cat-ai-infrastructure ;
    skos:broader ngm:cat-ai-infrastructure ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:contrastsWith ngm:federated-learning ;
    vc:dependsOn ngm:collective-communication,
        ngm:distributed-computing,
        ngm:mixed-precision-training ;
    vc:enables ngm:foundation-model,
        ngm:large-language-model-training,
        ngm:model-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-parallelism,
        ngm:model-parallelism,
        ngm:pipeline-parallelism,
        ngm:tensor-parallelism ;
    vc:implements ngm:gradient-checkpointing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:checkpoint-recovery,
        ngm:megatron-lm ;
    vc:requires ngm:gpu-compute,
        ngm:gradient-synchronisation ;
    vc:slug "distributed-training" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:uses ngm:jax,
        ngm:python-pytorch-deep-learning-stack .

ngm:financial-stability a owl:Class ;
    rdfs:label "Financial Stability"@en ;
    rdfs:comment "Financial stability is the condition in which the financial system — encompassing banks, capital markets, payment infrastructure, insurers, and non-bank intermediaries — can absorb shocks, maintain the orderly allocation of capital, and continue to perform its core functions of credit intermediation, risk transfer, and payment settlement without requiring extraordinary public support. It is a macroprudential objective distinct from the microprudential health of individual institutions, focusing instead on the resilience and interconnectedness of the system as a whole. Threats to financial stability include excessive leverage, maturity mismatches, procyclical asset valuations, contagion through counterparty networks, and confidence crises that trigger self-fulfilling runs. International bodies such as the Financial Stability Board (FSB), the Bank for International Settlements (BIS), the International Monetary Fund (IMF), and national central banks monitor systemic risk indicators and coordinate macroprudential policy responses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capital-adequacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stress-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:macroprudential-policy ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:crypto-regulation,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:systemic-risk ;
    vc:dependsOn ngm:central-banking,
        ngm:deposit-insurance,
        ngm:lender-of-last-resort ;
    vc:enables ngm:economic-growth,
        ngm:payment-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:macroprudential-policy,
        ngm:stress-testing,
        ngm:systemic-risk-monitoring ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:financial-regulation,
        ngm:prudential-supervision,
        ngm:stablecoin ;
    vc:requires ngm:capital-adequacy,
        ngm:compliance-framework,
        ngm:liquidity-management ;
    vc:slug "financial-stability" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:financial-stability-board .

ngm:high-performance-computing a owl:Class ;
    rdfs:label "High-Performance Computing"@en ;
    rdfs:comment "High-Performance Computing (HPC) refers to the use of aggregated computational resources — clusters, supercomputers, and massively parallel systems — to solve problems requiring sustained compute throughput, memory bandwidth, or I/O rates far beyond those achievable on commodity servers. HPC systems combine specialised processors (CPUs, GPUs, FPGAs, TPUs), high-speed interconnects (InfiniBand, NVLink), parallel file systems, and workload-management software to execute scientific simulations, large-scale machine learning training, genomics, climate modelling, and computational fluid dynamics at peta- or exascale performance."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:computing-hardware ;
    vc:enables ngm:blockchain-analytics,
        ngm:deep-learning,
        ngm:machine-learning-discipline-infrastructure,
        ngm:neur-ips ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-hardware,
        ngm:ai-infrastructure,
        ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:edge-computing ;
    vc:slug "high-performance-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:batch-processing,
        ngm:cuda,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:parallel-processing,
        ngm:tpu .

ngm:inference-engine a owl:Class ;
    rdfs:label "Inference Engine"@en ;
    rdfs:comment "An Inference Engine is a specialised software runtime optimised for executing trained machine learning models in production environments, transforming input data into predictions, classifications, embeddings, or generated content with primary objectives of minimising latency, maximising throughput, and efficiently utilising hardware accelerators such as GPUs, TPUs, and NPUs. Inference engines apply techniques including operator fusion, kernel auto-tuning, mixed-precision quantisation, and memory layout optimisation to close the performance gap between a training-time model representation and optimal hardware utilisation. They typically accept models in portable interchange formats such as ONNX or TensorRT engine plans, decoupling model architecture from the serving runtime, and are deployed within MLOps pipelines to serve AI applications at production scale. Modern inference engines address both traditional deep learning models (CNNs, transformers for classification and detection) and large language model serving, where techniques such as continuous batching, paged KV-cache management, and speculative decoding are critical to economic viability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:operator-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dynamic-batching ],
        ngm:inference ;
    vc:contrastsWith ngm:eager-execution,
        ngm:training-framework ;
    vc:dependsOn ngm:gpu-computing,
