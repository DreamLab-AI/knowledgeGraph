    vc:slug "ethereum-attestation-service" ;
    vc:sourceDomain "blockchain" .
ngm:ethereum-smart-contract-platform-classic a owl:Class ;
    rdfs:comment "A proof-of-work blockchain that continued the original Ethereum chain after the 2016 DAO hard fork, preserving the unaltered transaction history. It maintains the principle that the ledger should not be reversed by social intervention."@en ;
    rdfs:label "Ethereum Classic"@en ;
