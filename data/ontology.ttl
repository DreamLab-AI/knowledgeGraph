        ngm:real-time-gross-settlement ;
    vc:isPartOf ngm:financial-infrastructure ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:correspondent-banking,
        ngm:systemic-risk,
        ngm:tokenization ;
    vc:requires ngm:clearing,
        ngm:liquidity,
        ngm:risk-management ;
    vc:slug "settlement" ;
    vc:sourceDomain "finance" .

ngm:symmetric-encryption a owl:Class ;
    rdfs:label "Symmetric Encryption"@en ;
    rdfs:comment "A cryptographic method using a single shared secret key for both encryption and decryption, requiring secure key exchange between parties before communication. Provides high-throughput confidentiality for data at rest and in transit, making it the standard approach for bulk data encryption across security, infrastructure, and distributed-systems domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:initialization-vector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-authentication-code ],
        [ a owl:Restriction ;
