    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:smart-building,
        ngm:smart-grid ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:citizen-engagement,
