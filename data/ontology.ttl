    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:vibe-coding a owl:Class ;
    rdfs:label "Vibe Coding"@en ;
    rdfs:comment "Vibe Coding is an AI-assisted software development practice in which developers direct large language models or AI coding tools (such as Cursor, Aider, or Copilot) with high-level intent rather than writing all code manually. The practitioner retains system-level design authority whilst delegating implementation of discrete, scoped tasks to the AI, requiring disciplined use of version control, structured context documents, and iterative refinement cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        ngm:infra-software-engineering,
        ngm:software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
