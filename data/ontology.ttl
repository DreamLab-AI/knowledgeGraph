ngm:kto a owl:Class ;
    rdfs:label "KTO"@en ;
    rdfs:comment "KTO (Kahneman-Tversky Optimization) is a method for aligning language models that learns from binary good or bad feedback on individual outputs rather than paired preference comparisons. Drawing on prospect theory, it defines a utility-based loss that down-weights losses relative to gains, simplifying data collection compared with preference-pair methods. It is an alternative to direct preference optimization in the post-training alignment toolkit."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimization,
        ngm:model-training ;
    vc:slug "kto" ;
    vc:sourceDomain "ai" .

