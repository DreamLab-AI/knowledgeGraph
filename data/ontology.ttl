        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:verifiable-credentials,
        ngm:w3-c-did-core .

ngm:incentive-mechanism a owl:Class ;
    rdfs:label "Incentive Mechanism"@en ;
    rdfs:comment "An incentive mechanism is a designed system of rewards and penalties that aligns the self-interested behaviour of participants with a desired collective outcome. In distributed systems and blockchain networks it uses tokens, fees and slashing to motivate honest participation, resource provision and protocol-conformant behaviour. Drawing on game theory and mechanism design, it makes cooperation the rational strategy even among mutually distrustful actors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:mechanism-design ;
    vc:bridgesTo ngm:token-economics ;
    vc:contrastsWith ngm:game-theory ;
    vc:enables ngm:consensus-mechanism,
        ngm:staking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proof-of-stake ;
    vc:isPartOf ngm:mechanism-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:staking ;
    vc:requires ngm:smart-contract ;
    vc:slug "incentive-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain ;
    vc:uses ngm:game-theory,
        ngm:token-economics .

ngm:information-asymmetry a owl:Class ;
    rdfs:label "Information Asymmetry"@en ;
    rdfs:comment "Information asymmetry is a condition in which one party to a transaction or interaction possesses more or better information than another, distorting decisions and market outcomes. It gives rise to adverse selection and moral hazard, and motivates institutions such as signalling, screening, disclosure rules, and reputation systems. It is a foundational concept in microeconomics and is increasingly relevant to AI systems whose training data and outputs can encode hidden biases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sanctions-screening ],
        ngm:economic-mechanism ;
    vc:bridgesTo ngm:bias-in-large-language-models,
        ngm:data-governance,
        ngm:explainability,
        ngm:oracle,
        ngm:smart-contract ;
    vc:contrastsWith ngm:efficient-market-hypothesis ;
    vc:dependsOn ngm:economics,
        ngm:game-theory ;
    vc:enables ngm:principal-agent-problem ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adverse-selection ;
    vc:implements ngm:reputation-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:transaction-cost-economics,
        ngm:transparency,
        ngm:trust ;
    vc:requires ngm:sanctions-screening,
        ngm:signalling ;
    vc:slug "information-asymmetry" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:contract-theory,
        ngm:market-microstructure ;
    vc:uses ngm:auction-theory,
        ngm:mechanism-design .

ngm:interpolation a owl:Class ;
    rdfs:label "Interpolation"@en ;
    rdfs:comment "Interpolation is the construction of new data points within the range of a discrete set of known points, producing a continuous function that passes through or near the samples. Methods range from simple linear and nearest-neighbour schemes to higher-order polynomial, spline and barycentric formulations, each trading smoothness against computational cost and overshoot. In spatial computing and graphics it underpins resampling, shading, animation between keyframes, and the reconstruction of continuous fields from sparse measurements."@en ;
    rdfs:subClassOf ngm:numerical-methods ;
    vc:bridgesTo ngm:rasterization ;
    vc:contrastsWith ngm:extrapolation ;
    vc:enables ngm:keyframe-animation,
        ngm:texture-mapping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:linear-interpolation,
        ngm:spline ;
    vc:implements ngm:curve-fitting ;
    vc:isPartOf ngm:numerical-methods ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:shader,
        ngm:signal-processing ;
    vc:requires ngm:numerical-analysis ;
    vc:slug "interpolation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:animation,
        ngm:rendering ;
    vc:uses ngm:approximation,
        ngm:sampling .

ngm:investment-management a owl:Class ;
    rdfs:label "Investment Management"@en ;
    rdfs:comment "The professional discipline and supporting technological infrastructure for allocating, monitoring, and optimising portfolios of digital and traditional financial assets. In the blockchain and DeFi context, investment management encompasses on-chain portfolio tools, automated yield strategies, risk modelling, and governance-token-weighted decision frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
