ngm:adversarial-attack a owl:Class ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "An Adversarial Attack is a deliberate attempt to manipulate an AI system by crafting malicious inputs or exploiting model vulnerabilities to cause misclassification, extract confidential information, degrade performance, or subvert intended behaviour. Attack classes include evasion, poisoning, model extraction, inversion, and backdoor, across white-box, black-box, and grey-box threat models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backdoor-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:membership-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-poisoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-inversion ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-risk-management,
        ngm:cybersecurity ;
    vc:contrastsWith ngm:certified-defense,
        ngm:robustness,
        ngm:safety-fine-tuning ;
    vc:enables ngm:adversarial-robustness,
        ngm:red-team-testing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backdoor-attack,
        ngm:data-poisoning,
        ngm:evasion-attack,
        ngm:membership-inference,
        ngm:model-extraction,
        ngm:model-inversion ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-training,
        ngm:ai-safety,
        ngm:ai-security-threat,
        ngm:computer-vision,
        ngm:differential-privacy ;
    vc:requires ngm:machine-learning-model,
        ngm:threat-model ;
    vc:slug "adversarial-attack" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:gradient-based-optimization,
        ngm:perturbation .

ngm:ai-deployment a owl:Class ;
    rdfs:label "AI Deployment"@en ;
    rdfs:comment "The phase of the AI lifecycle in which a developed and validated artificial intelligence system is integrated into operational environments, made available to end users, and transitioned from development to production use, encompassing activities such as system integration, infrastructure provisioning, release management, user training, documentation delivery, and the establishment of operational support structures to ensure reliable, safe, and effective system functioning in real-world conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-performance ],
        ngm:ai-lifecycle ;
    vc:bridgesTo ngm:governance,
        ngm:security ;
    vc:contrastsWith ngm:ai-development ;
    vc:dependsOn ngm:ai-development,
        ngm:human-oversight ;
    vc:enables ngm:ai-monitoring,
        ngm:ai-system-use-by-ai-users-and-ai-operators ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:canary-deployment,
        ngm:infrastructure-provisioning,
        ngm:release-management ;
    vc:implements ngm:mlops ;
    vc:isPartOf ngm:ai-lifecycle ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fda-software-as-medical-device,
        ngm:iso-iec-25010 ;
    vc:requires ngm:deployment-infrastructure,
        ngm:model-performance,
        ngm:operational-procedures,
        ngm:risk-management ;
    vc:slug "ai-deployment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:iso-iec-42001-2023,
