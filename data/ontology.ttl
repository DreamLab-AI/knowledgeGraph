vf:ms-phi-models a owl:Class ;
    rdfs:label "MS Phi models"@en ;
    rdfs:comment "MS Phi models is Microsoft Research's family of small language models (SLMs) demonstrating that carefully curated, textbook-quality synthetic training data can achieve state-of-the-art performance at parameter counts one to two orders of magnitude smaller than frontier large language models, establishing a new paradigm in which data quality dominates data quantity as the primary driver of emergent reasoning capability across the full capability spectrum from Python code generation through mathematical chain-of-thought reasoning, multimodal vision-speech-text integration, and agentic tool-use. The series spans eight distinct model generations released between June 2023 and April 2025: Phi-1 (1.3B parameters, June 2023, Python code generation trained on GPT-4-synthesised textbook chapters and exercises, achieving HumanEval pass@1 50.6% matching CodeLLaMA-34B at 26× fewer parameters); Phi-1.5 (1.3B, September 2023, extending to natural language commonsense reasoning through \"synthetic fables\" — short educational narratives encoding causal and common-sense inference, MMLU 46.1%); Phi-2 (2.7B, December 2023, outperforming LLaMA-2-70B on ARC / WinoGrande / HellaSwag / PIQA reasoning benc"@en ;
    rdfs:subClassOf vf:foundation-models,
        vf:general-purpose-ai-model,
        vf:generative-ai,
        vf:generative-model,
        vf:large-language-models,
        vf:proprietary-large-language-models ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:ai-deployment,
        vf:code-generation,
        vf:context-aware-computing,
        vf:edge-ai-system,
        vf:edge-computing,
        vf:microsoft-copilot,
        vf:multimodal-understanding,
        vf:on-device-learning,
        vf:reasoning ;
    vc:hasPart vf:adapter-modules,
        vf:attention-head,
        vf:attention-mechanism,
        vf:fine-tuning,
        vf:instruction-tuning,
        vf:knowledge-distillation,
        vf:mixture-of-experts,
        vf:multi-head-attention,
        vf:multimodal-ai ;
    vc:implements vf:direct-preference-optimization,
        vf:full-fine-tuning,
        vf:instruction-tuning,
        vf:knowledge-distillation,
        vf:parameter-efficient-fine-tuning,
        vf:qlo-ra,
        vf:safety-fine-tuning,
        vf:supervised-fine-tuning ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires vf:compute-infrastructure,
        vf:continued-pre-training,
        vf:curriculum-learning,
        vf:evaluation-benchmarks-and-leaderboards,
        vf:model-training,
        vf:pre-training,
        vf:training-and-fine-tuning ;
    vc:slug "ms-phi-models" ;
    vc:sourceDomain "artificial-intelligence" .

