    vc:sourceDomain "security" .
ngm:zero-downtime-deployment a owl:Class ;
    rdfs:comment "Zero Downtime Deployment is a release strategy that updates a running service without interrupting user-facing availability. It relies on patterns such as rolling updates, blue-green switchovers, or canary releases combined with health checks and load-balancer draining so that traffic only reaches instances ready to serve it. Achieving it requires backward-compatible changes, graceful connection shutdown, and idempotent operations across the transition."@en ;
    rdfs:label "Zero Downtime Deployment"@en ;
    rdfs:subClassOf ngm:continuous-deployment ;
    rdfs:subClassOf _:r22628 ;
