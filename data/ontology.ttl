ngm:authorised-representative a owl:Class ;
    rdfs:label "Authorised Representative"@en ;
    rdfs:comment "A natural or legal person located or established in the EU who has received and accepted a written mandate from a non-EU provider of an AI system or general-purpose AI model to perform regulatory tasks on its behalf, including maintaining technical documentation, cooperating with market surveillance authorities, and serving as the primary EU contact point under the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
