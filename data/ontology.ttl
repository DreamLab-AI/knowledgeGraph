# Model Context Protocol
artificial-intelligence:ModelContextProtocol rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:AgentCommunicationProtocol ;
    rdfs:subClassOf artificial-intelligence:JSONRPCProtocol ;
    rdfs:label "Model Context Protocol"@en ;
    rdfs:comment "The Model Context Protocol (MCP) is an open standard published by Anthropic in November 2024 that defines a JSON-RPC 2.0-based client–server protocol for connecting Large Language Model inference hosts (MCP clients) to external capability providers (MCP servers), exposing tools, resources, and prompts in a uniform interface that allows any compliant LLM application to discover and invoke heterogeneous external services — databases, file systems, APIs, agent memory stores — without bespoke integration code, forming the primary tool-surface interface within VisionClaw Agentic Container for agent-to-environment interaction."@en ;
    skos:prefLabel "Model Context Protocol"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-context-protocol" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-context-protocol> ;
    vcw:contentHash "sha256-12-4f8b2d6e9a1c" ;
    vcw:qualityScore "0.7"^^xsd:decimal ;
    vcw:legacyTermId "AI-model-context-protocol" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.85"^^xsd:decimal ;
    dcterms:identifier "AI-model-context-protocol" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

