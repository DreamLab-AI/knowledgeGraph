ngm:serious-incident a owl:Class ;
    rdfs:label "Serious Incident"@en ;
    rdfs:comment "Under EU AI Act Article 3(44), a Serious Incident is any incident or malfunctioning of an AI system that directly or indirectly causes death, serious health damage, serious disruption of critical infrastructure, or serious infringement of fundamental rights. Such incidents trigger mandatory reporting obligations for providers and deployers of high-risk AI systems and GPAI models with systemic risk, enabling rapid regulatory response and market surveillance under Article 73."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:market-surveillance-authority ],
        ngm:sc-governance-and-safety,
        ngm:spatial-embodiment-harm-taxonomy ;
