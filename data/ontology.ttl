ngm:inclusive-growth a owl:Class ;
    rdfs:label "Inclusive Growth"@en ;
    rdfs:comment "AI should benefit people and planet by augmenting human capabilities, enhancing creativity, advancing inclusion of underrepresented populations, reducing economic, social and geographical inequalities, and protecting natural environments, thereby invigorating inclusive growth, sustainable develop..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-enforcement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:infra-legal-and-regulatory,
        ngm:policy-enforcement ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:harmful-bias ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:sustainable-development,
        ngm:well-being ;
    vc:requires ngm:ai-governance,
        ngm:policy-enforcement ;
    vc:slug "inclusive-growth" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:fairness,
        ngm:financial-inclusion .

