ngm:model-capacity a owl:Class ;
    rdfs:comment "The measure of a machine learning model's ability to represent a wide variety of functions, determined by parameter count, architecture depth and width, and representational power. Models with insufficient capacity underfit the data; those with excessive capacity risk overfitting. Capacity is formally bounded by concepts such as the Vapnik–Chervonenkis dimension, and is managed in practice through regularisation, pruning, and architecture search."@en ;
    rdfs:label "Model Capacity"@en ;
    rdfs:subClassOf ngm:ai-technique ;
    rdfs:subClassOf _:r14499 ;
    rdfs:subClassOf _:r14500 ;
    skos:broader ngm:ai-technique ;
