ngm:glossary-index a owl:Class ;
    rdfs:label "Glossary Index"@en ;
    rdfs:comment "A centralized terminology reference system that aggregates, defines, and cross-references all metaverse concepts with their synonyms, abbreviations, and semantic relationships, serving as the human-readable interface to the formal ontology schema."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse-ontology-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:term-definitions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:category-hierarchies ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:skos-vocabulary ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:knowledge-organization-system ;
    vc:enables ngm:consistency-checking,
        ngm:learning-resources,
        ngm:semantic-search,
        ngm:terminology-lookup ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:category-hierarchies,
        ngm:cross-references,
        ngm:synonym-mappings,
        ngm:term-definitions,
        ngm:usage-examples ;
    vc:isPartOf ngm:documentation-system,
        ngm:knowledge-management-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:metaverse-ontology-schema,
        ngm:multi-language-support,
        ngm:skos-vocabulary ;
    vc:slug "glossary-index" ;
    vc:sourceDomain "spatial-computing" .

