ngm:meta-llama-model-family-index a owl:Class ;
    rdfs:label "LlamaIndex"@en ;
    rdfs:comment "LlamaIndex (formerly GPT Index) is an open-source data framework and Python library that provides the abstractions and tooling needed to connect large language models with external data sources through structured indexing, retrieval, and query pipelines, primarily enabling production-grade retrieval-augmented generation (RAG) applications. It handles the full pipeline from document ingestion and chunking, through embedding and vector storage, to query decomposition, retrieval, reranking, and response synthesis, providing high-level abstractions over underlying LLMs, embedding models, and vector databases. LlamaIndex is positioned as the data orchestration complement to LangChain's agent orchestration focus, with particular strength in structured data retrieval and multi-document reasoning."@en ;
    rdfs:subClassOf ngm:agent-frameworks ;
    vc:enables ngm:knowledge-graph-construction,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
