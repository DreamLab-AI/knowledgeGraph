ngm:computation-graph a owl:Class ;
    rdfs:comment "A Computation Graph is a directed graph in which nodes represent operations or variables and edges represent the flow of data (typically tensors) between them. It is the central abstraction in modern machine learning frameworks, where a model's forward pass is expressed as a graph and gradients are computed by traversing it in reverse via automatic differentiation. Graphs may be built statically ahead of execution or dynamically as code runs, and they enable optimisation, scheduling and hardware acceleration."@en ;
    rdfs:label "Computation Graph"@en ;
    rdfs:subClassOf ngm:directed-acyclic-graph ;
    rdfs:subClassOf _:r5039 ;
    rdfs:subClassOf _:r5040 ;
