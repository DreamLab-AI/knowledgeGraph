ngm:research-and-development a owl:Class ;
    rdfs:label "Research and Development"@en ;
    rdfs:comment "Research and development (R&D) is the systematic, investigative activity undertaken to create new knowledge and to apply it in novel products, processes and services. It spans basic research that expands understanding, applied research that targets specific problems, and experimental development that turns findings into working technology. R&D is the principal engine of innovation and long-term competitive advantage in technology-intensive fields."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scientific-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scientific-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prototyping ],
        ngm:innovation ;
    vc:bridgesTo ngm:technology-transfer ;
    vc:dependsOn ngm:scientific-research ;
    vc:enables ngm:innovation,
        ngm:technology-transfer ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:engineering-design,
        ngm:prototyping,
        ngm:scientific-research ;
    vc:isPartOf ngm:innovation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collaboration,
        ngm:knowledge-transfer ;
    vc:requires ngm:scientific-research ;
    vc:slug "research-and-development" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:innovation ;
    vc:uses ngm:academic-research,
        ngm:prototyping .

ngm:safety-standard a owl:Class ;
    rdfs:label "Safety Standard"@en ;
    rdfs:comment "A safety standard is a normative document — published by a standards body, industry consortium, or regulatory authority — that defines requirements, processes, and verification methods for ensuring that a system, product, or environment achieves an acceptable level of risk to human life, health, and property. Safety standards range from generic functional safety frameworks such as IEC 61508 and ISO 26262 to domain-specific codes covering robotics, medical devices, aviation, and industrial machinery, and they typically specify hazard analysis methods, safety integrity levels, design constraints, and evidence of compliance."@en ;
    rdfs:subClassOf ngm:compliance-standards ;
    vc:enables ngm:compliance-framework,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:risk-assessment,
        ngm:robot-safety ;
    vc:slug "safety-standard" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-risk-management ;
    vc:uses ngm:iec-61508,
        ngm:iso-26262 .

ngm:sensor-networks a owl:Class ;
    rdfs:label "Sensor Networks"@en ;
    rdfs:comment "Sensor networks are distributed collections of sensor nodes that collect, process and communicate measurements about their environment."@en ;
    rdfs:subClassOf ngm:sensors ;
    vc:enables ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "sensor-networks" ;
    vc:sourceDomain "robotics" .

ngm:software-defined-networking a owl:Class ;
    rdfs:label "Software-Defined Networking"@en ;
    rdfs:comment "Software-defined networking (SDN) is a network architecture that decouples the control plane, which decides how traffic is routed, from the data plane, which forwards packets, centralising control logic in a programmable software controller. By exposing the network through open interfaces, SDN allows traffic flows and policies to be configured dynamically and programmatically rather than device-by-device. This abstraction enables automation, virtualisation and centralised orchestration of network behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-network ],
        ngm:network-architecture ;
    vc:bridgesTo ngm:network-slicing ;
    vc:contrastsWith ngm:network-architecture ;
    vc:dependsOn ngm:api ;
    vc:enables ngm:cloud-computing,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:virtual-network ;
    vc:implements ngm:network-slicing ;
    vc:isPartOf ngm:network-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:virtual-network ;
    vc:slug "software-defined-networking" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:infrastructure ;
    vc:uses ngm:api .

ngm:software-development-process a owl:Class ;
    rdfs:label "Software Development Process"@en ;
    rdfs:comment "The structured set of methodologies, workflows, and best practices governing how software — including AI and machine learning systems — is conceived, built, tested, deployed, and maintained. For AI systems this encompasses data-centric workflows, experiment tracking, model validation protocols, MLOps pipelines, and cross-functional collaboration between data scientists, engineers, and domain experts across the full model lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:code-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-deployment ],
