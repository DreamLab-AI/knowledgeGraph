ngm:schema-definition a owl:Class ;
    rdfs:label "Schema Definition"@en ;
    rdfs:comment "A Schema Definition is a formal, machine-readable specification of the structure, data types, constraints, and relationships that govern a dataset, message format, document, or knowledge representation, serving as a contract between data producers and consumers. Schema languages include W3C XML Schema Definition (XSD), JSON Schema (for JSON documents), OWL/RDFS (for ontologies over RDF graphs), SHACL and ShEx (for RDF graph shape constraints), Protocol Buffers and Apache Avro (for binary-serialised messages), OpenAPI (for REST API request/response bodies), and GraphQL SDL (for graph API types). A schema definition enables automated validation, code generation, documentation, and inter-system interoperability; in knowledge-graph contexts, the schema defines classes, properties, cardinality constraints, and axioms that allow OWL-based reasoning over the graph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:namespace ],
        ngm:data-format-standard ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:enables ngm:code-generation,
        ngm:knowledge-graph,
        ngm:linked-data,
        ngm:semantic-web-linked-data-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:api-contract,
        ngm:data-governance,
        ngm:json-data-interchange-format-schema,
        ngm:knowledge-representation,
        ngm:ontology ;
    vc:requires ngm:data-type,
        ngm:namespace ;
    vc:slug "schema-definition" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:w3-c ;
    vc:supports ngm:contract-testing,
        ngm:data-schema,
        ngm:owl-class-hierarchy,
        ngm:schema-registry ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:protocol-buffer,
        ngm:rdf,
        ngm:sparql,
        ngm:xml-schema-definition .

ngm:scope-2-emissions a owl:Class ;
    rdfs:label "Scope 2 Emissions"@en ;
    rdfs:comment "Scope 2 Emissions are the indirect greenhouse gas emissions attributable to an organisation arising from the generation of purchased or acquired electricity, steam, heat, or cooling consumed in its operations, as defined by the GHG Protocol Corporate Standard. Although the physical emissions occur at the power plant or thermal facility, they are accounted for by the purchasing organisation because its demand drives that generation, making Scope 2 the primary decarbonisation lever for energy-intensive organisations such as data centres and manufacturers."@en ;
    rdfs:subClassOf ngm:environmental-sustainability ;
    vc:bridgesTo ngm:24-7-carbon-free-energy ;
    vc:contrastsWith ngm:location-based-accounting,
        ngm:market-based-accounting ;
    vc:enables ngm:carbon-aware-computing,
        ngm:carbon-neutrality-planning,
        ngm:carbon-neutrality-verification,
        ngm:decarbonisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:corporate-sustainability-reporting-directive ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint,
        ngm:esg-reporting,
        ngm:ghg-protocol,
        ngm:grid-electricity,
        ngm:scope-1-emissions,
        ngm:scope-3-emissions ;
    vc:slug "scope-2-emissions" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ghg-protocol-corporate-standard,
        ngm:iso-14064 ;
    vc:supports ngm:power-purchase-agreement,
        ngm:renewable-energy,
        ngm:renewable-energy-certificates,
        ngm:sustainability-reporting .

ngm:sensor-calibration a owl:Class ;
    rdfs:label "Sensor Calibration"@en ;
    rdfs:comment "Sensor calibration is the process of determining and correcting systematic measurement errors in sensing devices by comparing their outputs against known reference values or through geometric constraint solving, yielding intrinsic parameter models and extrinsic transformation matrices that map raw sensor readings to physically meaningful quantities. It is a prerequisite for sensor fusion, perception pipelines, and any application requiring quantitatively accurate environmental measurements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reprojection-error ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reference-standard ],
        ngm:calibration ;
    vc:bridgesTo ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:sensor ;
    vc:dependsOn ngm:sensor ;
    vc:enables ngm:autonomous-driving-perception,
        ngm:localization,
        ngm:robot-perception,
        ngm:sensor-fusion,
        ngm:slam,
        ngm:visual-inertial-odometry ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:calibration,
        ngm:extrinsic-calibration ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:imu,
        ngm:lidar ;
    vc:requires ngm:reference-standard,
        ngm:reprojection-error ;
    vc:slug "sensor-calibration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:3-d-reconstruction,
        ngm:autonomous-navigation ;
    vc:uses ngm:allan-variance,
        ngm:calibration-target,
        ngm:camera-intrinsics,
        ngm:coordinate-transformation,
        ngm:levenberg-marquardt-algorithm,
        ngm:optimisation .

ngm:sequencer a owl:Class ;
    rdfs:label "Sequencer"@en ;
    rdfs:comment "A sequencer is a component in a blockchain rollup or layer-2 system that receives user transactions, orders them into a canonical sequence, and produces blocks or batches for execution and settlement. By fixing transaction order off-chain before posting to the base layer, the sequencer enables fast confirmations and low fees. Sequencer design directly governs liveness, fairness, and the centralisation risk of a rollup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:layer-2-scaling ;
    vc:bridgesTo ngm:data-availability ;
    vc:contrastsWith ngm:validator ;
    vc:dependsOn ngm:data-availability,
        ngm:ethereum ;
    vc:enables ngm:censorship-resistance,
        ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rollup ;
    vc:implements ngm:fraud-proof ;
    vc:isPartOf ngm:rollup ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralization,
        ngm:mev ;
    vc:requires ngm:ethereum ;
    vc:slug "sequencer" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:arbitrum,
        ngm:optimism ;
    vc:uses ngm:optimistic-rollup .

ngm:softmax-function a owl:Class ;
    rdfs:label "Softmax Function"@en ;
    rdfs:comment "The softmax function is a normalising transformation that maps a vector of real-valued scores (logits) into a probability distribution, where each output lies in the open interval (0, 1) and the outputs sum to one. It exponentiates each input and divides by the sum of all exponentials, amplifying larger scores while preserving rank order. Softmax is ubiquitous in machine learning as the final layer of multi-class classifiers and as the normalisation step inside attention mechanisms, and it pairs naturally with the cross-entropy loss whose gradient simplifies to the difference between predicted and target distributions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:activation-function ;
    vc:bridgesTo ngm:transformer ;
    vc:dependsOn ngm:neural-network ;
    vc:enables ngm:attention-mechanism,
        ngm:classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cross-entropy-loss ;
    vc:implements ngm:cross-entropy-loss ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:classification,
        ngm:deep-learning ;
    vc:requires ngm:activation-function ;
    vc:slug "softmax-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:transformer ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:spatial-anchor a owl:Class ;
    rdfs:label "Spatial Anchor"@en ;
    rdfs:comment "Coordinate reference that binds a virtual object's pose to a stable location in physical space, enabling persistent AR placement and physical-virtual registration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tracking-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gps ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistence-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:visual-marker ],
        ngm:ar-scene-graph,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:persistent-ar-placement,
        ngm:physical-virtual-registration,
        ngm:shared-ar-experiences ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:coordinate-system,
        ngm:gps,
        ngm:pose-estimation,
        ngm:visual-marker ;
    vc:isPartOf ngm:ar-scene-graph,
        ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:coordinate-transformation,
        ngm:persistence-layer,
        ngm:tracking-system ;
    vc:slug "spatial-anchor" ;
    vc:sourceDomain "spatial-computing" .

ngm:speech-synthesis a owl:Class ;
    rdfs:label "SpeechSynthesis"@en ;
    rdfs:comment "Speech synthesis, or text-to-speech (TTS), is the artificial generation of human speech from text or linguistic representations using computational models that map phonetic, prosodic, and acoustic features to waveform output. Modern neural TTS systems use end-to-end deep learning pipelines—typically a text front-end, an acoustic model (Tacotron, FastSpeech, or diffusion-based), and a neural vocoder (WaveNet, HiFi-GAN, Vocos)—to produce speech that is perceptually natural, expressive, and stylistically controllable. Speech synthesis underpins screen readers, virtual assistants, navigation systems, voice cloning tools, and interactive conversational agents, and its quality is now at or approaching human parity on standard benchmarks for many languages."@en ;
    rdfs:subClassOf ngm:text-to-speech ;
    vc:enables ngm:speech-and-voice,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:voice-cloning ;
    vc:slug "speech-synthesis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:surveillance-capitalism a owl:Class ;
    rdfs:label "Surveillance Capitalism"@en ;
    rdfs:comment "Surveillance Capitalism is an economic logic, theorised by Shoshana Zuboff (2019), in which human experience is unilaterally claimed as a free raw material to be translated into behavioural data, processed by machine intelligence into prediction products, and sold in behavioural futures markets to business customers who seek to influence human behaviour. The model originated in digital advertising — Google's repurposing of surplus behavioural data from search to predict and influence click-through — and has since colonised social media, IoT devices, retail analytics, health apps, and smart-city infrastructure. Unlike industrial capitalism's exploitation of natural resources, surveillance capitalism exploits human behaviour and psyche as its primary resource, generating epistemic asymmetries between platform owners and the surveilled population and challenging the foundational conditions for autonomous selfhood, democratic deliberation, and market competition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioral-analytics ],
        ngm:platform-economy ;
    vc:bridgesTo ngm:io-t,
        ngm:smart-city ;
    vc:contrastsWith ngm:data-sovereignty,
        ngm:digital-rights,
        ngm:privacy-preserving-computation ;
    vc:dependsOn ngm:network-effects,
        ngm:platform-economy ;
    vc:enables ngm:algorithmic-accountability,
        ngm:social-media-platform-infrastructure,
        ngm:targeted-advertising ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavioral-futures-markets,
        ngm:behavioral-surplus,
        ngm:prediction-products ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-society,
        ngm:digital-society-surveillance,
        ngm:epistemic-asymmetry,
        ngm:political-polarisation ;
    vc:requires ngm:behavioral-analytics,
        ngm:data-collection,
        ngm:machine-learning ;
    vc:slug "surveillance-capitalism" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:consent-management,
        ngm:digital-markets-act,
        ngm:gdpr ;
    vc:uses ngm:data-brokers,
        ngm:telemetry,
        ngm:third-party-cookies .

ngm:sybil-attack a owl:Class ;
    rdfs:label "Sybil Attack"@en ;
    rdfs:comment "A Sybil Attack is a network security threat in which a single adversary creates a large number of pseudonymous identities to gain disproportionate influence over a peer-to-peer system. In blockchain and distributed ledger contexts it can subvert reputation systems, distort consensus voting, facilitate eclipse attacks, and undermine proof-of-stake weighting. Countermeasures include proof-of-work, stake-weighted voting, identity verification, and peer diversity requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:identity-management,
        ngm:network-topology ;
    vc:enables ngm:denial-of-service,
        ngm:double-spending,
        ngm:eclipse-attack,
        ngm:routing-attack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:consensus-mechanism,
        ngm:decentralized-identity,
        ngm:selfish-mining ;
    vc:requires ngm:peer-to-peer-network,
        ngm:pseudonymous-identity ;
    vc:slug "sybil-attack" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:reputation-system .

ngm:task-decomposition a owl:Class ;
    rdfs:label "Task Decomposition"@en ;
    rdfs:comment "Task decomposition is the process of breaking a complex goal into smaller, ordered sub-tasks that can be planned, delegated, and executed independently. In AI agent systems it lets a model or orchestrator turn an open-ended request into a tractable plan, often assigning sub-tasks to specialised agents or tools. Effective decomposition improves reliability, parallelism, and the ability to recover from partial failure."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-agent-system,
        ngm:cli-multi-agent-systems ;
    vc:slug "task-decomposition" ;
    vc:sourceDomain "ai" .

ngm:tensor-flow a owl:Class ;
    rdfs:label "TensorFlow"@en ;
    rdfs:comment "An open-source machine learning framework developed by Google for building and deploying numerical computation and deep learning models across CPUs, GPUs and specialised accelerators, using a dataflow graph paradigm with automatic differentiation and a high-level Keras API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tensor-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python-programming-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:keras ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-flow-lite ],
        ngm:deep-learning-framework ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:mobile-computing ;
    vc:contrastsWith ngm:jax,
        ngm:py-torch ;
    vc:enables ngm:backpropagation,
        ngm:distributed-training,
        ngm:edge-inference,
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:keras,
        ngm:tensor-flow-lite ;
    vc:implements ngm:computational-graph ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:scikit-learn ;
    vc:requires ngm:automatic-differentiation,
