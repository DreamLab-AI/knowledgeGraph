        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:floating-point-arithmetic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pruning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:paged-attention ],
        ngm:mlops ;
    vc:bridgesTo ngm:ai-infrastructure ;
    vc:enables ngm:edge-deployment,
        ngm:low-latency,
        ngm:mobile-ai,
        ngm:on-device-inference,
        ngm:real-time-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:flash-attention,
        ngm:gguf-format,
        ngm:knowledge-distillation,
        ngm:kv-cache,
        ngm:mixture-of-experts-architecture,
        ngm:paged-attention,
        ngm:pruning,
        ngm:quantisation,
        ngm:speculative-decoding ;
    vc:implements ngm:graph-optimisation,
        ngm:kernel-fusion,
        ngm:post-training-quantisation,
        ngm:structured-sparsity,
        ngm:virtual-memory-management ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:auto-ml,
        ngm:hyperparameter-optimisation,
        ngm:mlops,
        ngm:neural-architecture-search,
        ngm:transformers ;
    vc:requires ngm:calibration,
        ngm:cuda,
        ngm:floating-point-arithmetic,
        ngm:gpu-compute,
        ngm:memory-hierarchy,
        ngm:transformer-architecture ;
    vc:slug "model-optimisation-and-performance" ;
    vc:sourceDomain "artificial-intelligence" ;
