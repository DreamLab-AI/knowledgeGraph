ngm:electric-actuator a owl:Class ;
    rdfs:label "Electric Actuator"@en ;
    rdfs:comment "Electric actuator converts electrical energy into controlled mechanical motion through electromagnetic forces, providing the primary means of actuation in modern robots."@en ;
