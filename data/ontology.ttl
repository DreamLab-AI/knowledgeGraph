ngm:sbti a owl:Class ;
    rdfs:label "SBTi"@en ;
    rdfs:comment "The Science Based Targets initiative (SBTi) is a body that defines and validates corporate greenhouse-gas reduction targets against climate science, specifically the goal of limiting warming to 1.5C. It publishes sector-specific methodologies and independently certifies that company targets are consistent with the Paris Agreement. SBTi validation has become a widely referenced benchmark in ESG reporting."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:science-based-targets ;
    vc:slug "sbti" ;
    vc:sourceDomain "supply-chain" .

ngm:scalable-deployment a owl:Class ;
    rdfs:label "Scalable Deployment"@en ;
    rdfs:comment "Scalable deployment is the practice of releasing and operating software so that capacity can grow or shrink with demand without redesign. It relies on stateless services, horizontal scaling, load balancing, container orchestration, and infrastructure-as-code to add resources elastically. It is essential for systems such as digital twins that must serve fluctuating workloads reliably."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-framework,
        ngm:digital-twin-infrastructure ;
    vc:slug "scalable-deployment" ;
    vc:sourceDomain "infrastructure" .

ngm:scene-design a owl:Class ;
    rdfs:label "Scene Design"@en ;
    rdfs:comment "Scene design is the process of composing and arranging the spatial, visual, and behavioural elements of a virtual or augmented environment. It encompasses layout of geometry, lighting, materials, cameras, and interactive objects within a scene graph. It is a foundational creative activity in metaverse, game, and immersive-media authoring."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authoring-tool,
        ngm:etsi-domain-creative-media ;
    vc:slug "scene-design" ;
    vc:sourceDomain "metaverse" .

ngm:scene-optimization a owl:Class ;
    rdfs:label "Scene Optimization"@en ;
    rdfs:comment "Scene Optimization is the set of techniques applied to 3D environments to reduce computational and bandwidth overhead while preserving perceptual fidelity, encompassing polygon reduction, texture compression and atlasing, draw call batching, occlusion culling, and level-of-detail management. These techniques are essential for achieving real-time frame rates on resource-constrained XR hardware and for supporting large concurrent user counts in metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-management ],
        ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:scene-management ;
    vc:slug "scene-optimization" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:level-of-detail,
        ngm:occlusion-culling .

