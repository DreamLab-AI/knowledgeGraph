ngm:ordinals a owl:Class ;
    rdfs:label "Ordinals"@en ;
    rdfs:comment "A scheme for numbering individual satoshis by order of issuance and transfer, allowing arbitrary data to be inscribed onto specific satoshis on the Bitcoin blockchain."@en ;
