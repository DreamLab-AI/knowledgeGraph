ngm:client-side-dco a owl:Class ;
    rdfs:label "Client side DCO"@en ;
    rdfs:comment "Client-side Dynamic Creative Optimisation (DCO) is an approach where personalised advertising content is generated and matched on the user's device rather than on centralised servers. Using locally maintained preference hashes and decentralised distribution protocols (such as Nostr), the system delivers contextually relevant content without exposing personal identity data to advertisers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:decentralised-web,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:multimodal ;
    vc:enables ngm:hyper-personalisation,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:edge-computing ;
    vc:slug "client-side-dco" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hardware-and-edge,
        ngm:latent-space,
        ngm:nostr-protocol .

