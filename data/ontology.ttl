    vc:bridgesTo ngm:ai-infrastructure ;
    vc:enables ngm:cost-effective-llm-serving,
        ngm:edge-deployment,
        ngm:low-latency-apis,
        ngm:mobile-ai,
        ngm:on-device-inference,
        ngm:real-time-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:flash-attention,
