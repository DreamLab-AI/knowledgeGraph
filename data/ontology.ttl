# Physical Layer
infrastructure:PhysicalLayer rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:ArchitecturalLayer ;
    rdfs:label "Physical Layer"@en ;
    rdfs:comment "Foundational layer encompassing hardware, networking infrastructure, and physical computing resources. Provides the tangible substrate upon which all higher-level software layers execute, including processors, memory, storage devices, and communication channels."@en ;
    skos:prefLabel "Physical Layer"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:physical-layer" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:physical-layer> ;
    vcw:contentHash "sha256-12-000000000000" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "NGM-physical-layer" ;
    vcw:ontologyStatus "stub" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-physical-layer" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T14:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:ProcessingHardware
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:MemorySystems
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:StorageDevices
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:NetworkHardware
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:PowerDistribution
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:Computation
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:DataStorage
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:SignalTransmission
] .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:ResourceProvisioning
] .

infrastructure:PhysicalLayer vcw:bridgesTo infrastructure:InfrastructureLayer .

infrastructure:PhysicalLayer vcw:bridgesTo infrastructure:NetworkLayer .

infrastructure:PhysicalLayer rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom infrastructure:InfrastructureLayer
] .

