        ngm:emotional-immersion,
        ngm:sensory-immersion ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:content-quality,
        ngm:display-technology,
        ngm:interaction-mechanism ;
    vc:slug "immersion" ;
    vc:sourceDomain "spatial-computing" .

ngm:impact-assessment a skos:Concept ;
    rdfs:label "Impact Assessment"@en .

ngm:industrial-inspection a owl:Class ;
    rdfs:label "Industrial Inspection"@en ;
    rdfs:comment "Industrial inspection is the systematic examination of manufactured parts, assemblies, infrastructure, and production processes to verify conformance with quality specifications, detect defects, and identify safety or structural hazards before product deployment or during operational service. It encompasses both non-destructive testing methods (ultrasonic, eddy-current, X-ray, thermographic) and machine vision approaches that use computer vision algorithms to automate defect classification at production speeds. AI-driven industrial inspection replaces or augments human visual inspectors with deep learning models trained on labelled defect images, enabling consistent sub-millimetre defect detection at scale."@en ;
    rdfs:subClassOf ngm:quality-assurance ;
    vc:enables ngm:manufacturing-automation,
        ngm:predictive-maintenance,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-io-t,
        ngm:precision-manufacturing,
        ngm:runtime-inspection ;
    vc:slug "industrial-inspection" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:computer-vision-system,
        ngm:inspection-robot .

ngm:industrial-iot a skos:Concept ;
    rdfs:label "Industrial IoT"@en .

ngm:industrial-symbiosis a owl:Class ;
    rdfs:label "Industrial Symbiosis"@en ;
    rdfs:comment "Industrial symbiosis is a collaborative approach within industrial ecology in which geographically proximate companies exchange materials, energy, water, and by-products to achieve collective environmental and economic benefits that are unattainable individually. By treating the waste or surplus of one facility as a resource input for another, industrial symbiosis operationalises circular economy principles at an industrial park or regional scale."@en ;
    rdfs:subClassOf ngm:circular-economy ;
    vc:enables ngm:resource-efficiency,
        ngm:waste-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:e-waste,
        ngm:sustainability ;
    vc:slug "industrial-symbiosis" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:life-cycle-assessment,
        ngm:material-flow-analysis .

ngm:informed-decision-making a owl:Class ;
    rdfs:label "Informed decision-making"@en ;
    rdfs:comment "Informed decision-making is a cognitive and organisational process in which choices are grounded in accurate, relevant, and timely evidence rather than intuition, habit, or incomplete information. It encompasses the collection, analysis, and interpretation of data, the surfacing of relevant context through knowledge management systems, and the mitigation of cognitive biases that distort judgement. In digital and AI-augmented environments, informed decision-making is increasingly supported by decision support tools, predictive analytics, and transparent reasoning systems that make the basis of recommendations auditable."@en ;
    rdfs:subClassOf ngm:decision-support ;
    vc:enables ngm:distributed-decision-making,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-analytics,
        ngm:knowledge-management,
        ngm:transparent-decision-making ;
    vc:slug "informed-decision-making" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:transparency ;
    vc:uses ngm:knowledge-graph,
        ngm:predictive-analytics .

ngm:infrared-led-illuminator a owl:Class ;
    rdfs:label "Infrared Led Illuminator"@en ;
    rdfs:comment "LED-based infrared light sources integrated into or used alongside VR/AR headsets to provide illumination for tracking systems, featuring compact form factors, low power consumption, and wavelengths optimised for camera sensor detection."@en ;
    rdfs:subClassOf ngm:infrared-illuminator,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:hand-tracking-enhancement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-led-illuminator" ;
    vc:sourceDomain "spatial-computing" .

ngm:infrared-light-source a owl:Class ;
    rdfs:label "Infrared Light Source"@en ;
    rdfs:comment "Emission devices providing infrared wavelength light for VR/AR tracking applications, encompassing LEDs, illuminators, and integrated headset components that enable eye tracking, position detection, and hand gesture recognition in extended reality systems."@en ;
    rdfs:subClassOf ngm:sc-interaction,
        ngm:tracking-hardware ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:foveated-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-light-source" ;
    vc:sourceDomain "spatial-computing" .

ngm:initial-coin-offering a skos:Concept ;
    rdfs:label "Initial Coin Offering"@en .

ngm:inspection-robot a owl:Class ;
    rdfs:label "Inspection Robot"@en ;
    rdfs:comment "A specialised robotic system designed to autonomously examine physical structures, components, or manufactured products for defects, faults, or deviations from specification. Inspection robots combine computer vision, sensor fusion, and AI-driven anomaly detection to replace or augment manual quality-assurance processes in hazardous or high-throughput environments."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:collaborative-systems-modality-robot,
        ngm:mobile-robot ;
    vc:slug "inspection-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:sensor-fusion .

ngm:integration-testing a owl:Class ;
    rdfs:label "Integration Testing"@en ;
    rdfs:comment "Integration testing is a software verification phase that exercises the interfaces and interactions between combined components or systems, rather than units in isolation. It detects defects in data contracts, protocols, timing, and configuration that emerge only when modules are wired together. Sitting between unit and system testing, it is essential for catching interface mismatches before end-to-end and acceptance stages."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compatibility-process,
        ngm:testing-process ;
    vc:slug "integration-testing" ;
    vc:sourceDomain "infrastructure" .

ngm:intelligent-automation a owl:Class ;
    rdfs:label "Intelligent Automation"@en ;
    rdfs:comment "Intelligent automation is the combination of process automation with artificial intelligence so that workflows can handle unstructured inputs, make context-dependent decisions, and adapt over time. It extends rule-based robotic process automation with machine learning, natural language processing, and computer vision to automate tasks that previously required human judgement. It is widely applied to back-office operations, customer service, and document-intensive processes."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:robotic-process-automation ;
    vc:slug "intelligent-automation" ;
    vc:sourceDomain "ai" .

ngm:intelligent-tutoring-system a owl:Class ;
    rdfs:label "Intelligent Tutoring System"@en ;
    rdfs:comment "An AI-powered software system that delivers personalised instruction by modelling a learner's knowledge state, selecting appropriate pedagogical strategies, and adapting content difficulty in real time without requiring a human instructor. Intelligent tutoring systems integrate domain knowledge, learner models, and tutoring strategies to provide one-on-one instructional support at scale."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:enables ngm:adaptive-learning,
        ngm:curriculum-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:large-language-models ;
    vc:slug "intelligent-tutoring-system" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning-discipline,
        ngm:natural-language-processing,
        ngm:reinforcement-learning .

ngm:internet-protocol a skos:Concept ;
    rdfs:label "Internet Protocol"@en .

ngm:iso-13482 a owl:Class ;
    rdfs:label "ISO 13482"@en ;
    rdfs:comment "ISO 13482 is the international standard specifying safety requirements for personal care robots—autonomous or semi-autonomous robots designed to perform tasks that directly assist humans in daily life, including mobility assistance, physical assistance, and person-carrier applications. Published in 2014, the standard defines risk assessment methodologies, protective measure requirements, and verification procedures tailored to the unique hazards of robots operating in close physical proximity to vulnerable populations such as the elderly and disabled. It complements the industrial robot safety standard ISO 10218 and is increasingly referenced in regulatory frameworks for assistive and service robotics."@en ;
    rdfs:subClassOf ngm:functional-safety ;
    vc:enables ngm:autonomous-system,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:assistive-robotics,
        ngm:cobot-safety-levels,
        ngm:iso-10218,
        ngm:robot-safety,
        ngm:service-robot ;
    vc:slug "iso-13482" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0088-iso-13482-compliance,
        ngm:risk-assessment .

ngm:iso-13849 a owl:Class ;
    rdfs:label "ISO 13849"@en ;
    rdfs:comment "An ISO standard on safety of machinery, specifying safety-related parts of control systems. It provides requirements and guidance for the design of such parts to achieve required performance levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:iso ;
    vc:slug "iso-13849" ;
    vc:sourceDomain "standards" .

ngm:joint-encoder a owl:Class ;
    rdfs:label "Joint Encoder"@en ;
    rdfs:comment "A joint encoder is a sensor mounted at a robot joint that measures angular or linear position, and often velocity, of that joint. It provides the proprioceptive feedback required for closed-loop position and motion control of articulated mechanisms. Encoders may be optical, magnetic or capacitive and are typically classed as incremental or absolute."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:proprioceptive-sensor ;
    vc:slug "joint-encoder" ;
    vc:sourceDomain "robotics" .

ngm:json-data-interchange-format-ld-context a owl:Class ;
    rdfs:label "JSON-LD Context"@en ;
    rdfs:comment "A JSON-LD Context is the machine-readable document or inline object that maps the shorthand terms and prefixes used in a JSON-LD document to their fully qualified IRIs in a target vocabulary or ontology. It serves as the bridge between the compact, human-readable JSON representation and the globally unambiguous RDF data model, enabling semantic interoperability across disparate systems. Contexts may be embedded inline within a document, referenced by URL, or composed from multiple context documents. The JSON-LD 1.1 specification extends context capabilities with scoped contexts, type-scoped and property-scoped contexts, and protected terms that resist accidental overriding. Correct context design is foundational to knowledge graph compilation and Linked Data publication."@en ;
    rdfs:subClassOf ngm:json-data-interchange-format-ld ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:linked-data,
        ngm:rdf,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "json-ld-context" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ontology,
        ngm:schema-registry ;
    vc:uses ngm:json-data-interchange-format-ld-1-1,
        ngm:sparql .

ngm:kademlia-dht a owl:Class ;
    rdfs:label "Kademlia DHT"@en ;
    rdfs:comment "Kademlia DHT is a distributed hash table protocol introduced by Petar Maymounkov and David Mazières in 2002 that organises participating nodes into a structured peer-to-peer overlay network using XOR metric distances between 160-bit node identifiers, enabling efficient O(log n) key-value lookup, storage, and routing with provable convergence guarantees. Each node maintains a routing table of k-buckets covering progressively finer-grained regions of the identifier space, and uses iterative or recursive RPC-based lookups to locate the nodes closest to a target key in at most O(log n) network hops. Kademlia's XOR metric is the defining technical innovation that enables symmetric routing—every lookup converges along the same path regardless of direction—making it the most widely deployed DHT protocol underlying BitTorrent, Ethereum, IPFS, and numerous other decentralised systems."@en ;
    rdfs:subClassOf ngm:distributed-hash-table ;
    vc:enables ngm:filecoin,
        ngm:ipfs,
        ngm:libp2p ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-system,
        ngm:distributed-system-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "kademlia-dht" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-systems .

ngm:keccak-256 a owl:Class ;
    rdfs:label "Keccak-256"@en ;
    rdfs:comment "A 256-bit cryptographic hash function based on the Keccak sponge construction, selected as the SHA-3 standard and used natively in Ethereum for address derivation, transaction hashing, and smart contract storage. It differs from NIST SHA-3 in padding and offers strong collision resistance and preimage resistance properties."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-cryptographic-primitive ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:preimage-resistance,
        ngm:sha-256 ;
    vc:slug "keccak-256" ;
    vc:sourceDomain "blockchain" .

ngm:key-management-system a owl:Class ;
    rdfs:label "Key Management System"@en ;
    rdfs:comment "A key management system (KMS) is a service or appliance that generates, stores, rotates, distributes and revokes cryptographic keys over their full lifecycle. It enforces access policies and isolates key material, often backed by hardware security modules, so that applications can perform cryptographic operations without directly handling private keys. A KMS is foundational to secure identity, encryption and digital-asset custody."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:custody-infrastructure,
        ngm:decentralized-identifiers ;
    vc:slug "key-management-system" ;
    vc:sourceDomain "security" .

ngm:khronos-open-xr a owl:Class ;
    rdfs:label "Khronos OpenXR"@en ;
    rdfs:comment "Khronos OpenXR is an open, royalty-free standard that defines a common application interface for virtual and augmented reality devices, decoupling XR applications from specific runtimes and hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-xr ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:open-xr ;
    vc:slug "khronos-open-xr" ;
    vc:sourceDomain "metaverse" .

ngm:knowledge-organization-system a owl:Class ;
    rdfs:label "Knowledge Organization System"@en ;
    rdfs:comment "A Knowledge Organization System (KOS) is any formal scheme used to organise, classify, and relate concepts within a domain — including thesauri, classification schemes, ontologies, taxonomies, and controlled vocabularies. KOS structures enable semantic interoperability by providing shared conceptual frameworks that allow heterogeneous systems to exchange and interpret information consistently. In AI infrastructure they underpin knowledge graphs, semantic search, and entity disambiguation in large language model pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        ngm:ai-infrastructure ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:controlled-vocabulary,
        ngm:ontology ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:knowledge-organization ;
    vc:slug "knowledge-organization-system" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:labelled-dataset a skos:Concept ;
    rdfs:label "Labelled Dataset"@en .

ngm:latent-diffusion-model a skos:Concept ;
    rdfs:label "Latent Diffusion Model"@en .

ngm:layer-2-networks a owl:Class ;
    rdfs:label "Layer 2 Networks"@en ;
    rdfs:comment "Layer 2 Networks are secondary protocols constructed atop a base blockchain (Layer 1) that execute transactions off the main chain, batching or compressing them before posting commitments back to Layer 1 for final settlement and security. They address the fundamental scalability trilemma by separating execution from consensus, enabling higher throughput and lower fees without compromising the decentralisation or security guarantees of the underlying chain. Primary architectural families include optimistic rollups, zero-knowledge rollups, state channels, and sidechains, each making different trade-offs between latency, data availability, and trust assumptions. Settlement finality and fraud or validity proof mechanisms determine the trust model and the withdrawal period users must endure before funds are considered unconditionally settled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:layer-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rollup ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:payment-infrastructure ;
    vc:contrastsWith ngm:layer-1,
        ngm:plasma,
        ngm:sharding ;
    vc:enables ngm:decentralised-finance,
        ngm:micropayments,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rollup,
        ngm:sidechains,
        ngm:state-channels,
        ngm:validium ;
    vc:implements ngm:optimistic-rollup,
        ngm:zk-rollup ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-lightning-network,
        ngm:blockchain-interoperability,
        ngm:blockchain-scaling,
        ngm:ethereum,
        ngm:sequencer ;
    vc:requires ngm:data-availability,
        ngm:layer-1,
        ngm:smart-contracts ;
    vc:slug "layer-2-networks" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proofs,
        ngm:fraud-proofs,
        ngm:merkle-trees,
        ngm:zero-knowledge-proofs .

ngm:layer-2-protocol a skos:Concept ;
    rdfs:label "Layer 2 Protocol"@en .

ngm:learning-module a owl:Class ;
    rdfs:label "Learning Module"@en ;
    rdfs:comment "Self-contained educational units within VR and metaverse training systems that provide structured learning experiences, including interactive simulations, assessments, and collaborative activities designed for specific skill development objectives."@en ;
    rdfs:subClassOf ngm:educational-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:structured-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "learning-module" ;
    vc:sourceDomain "spatial-computing" .

ngm:light-field-display a owl:Class ;
    rdfs:label "Light Field Display"@en ;
    rdfs:comment "A Light Field Display is an output device that reproduces the full four-dimensional light field of a scene, emitting rays of light in directions that recreate the optical properties of real objects without requiring the viewer to wear special glasses. Unlike conventional stereoscopic displays, light field displays support motion parallax, correct focus cues, and multiple simultaneous viewer perspectives. They are a key enabling technology for glasses-free holographic telepresence and high-fidelity volumetric visualisation in collaborative settings."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:holographic-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:photorealistic-telepresence,
        ngm:volumetric-video ;
    vc:slug "light-field-display" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:lnd a owl:Class ;
    rdfs:label "LND"@en ;
    rdfs:comment "LND (Lightning Network Daemon) is a production-grade, open-source implementation of a Bitcoin Lightning Network node developed by Lightning Labs. It manages the full lifecycle of payment channels — from on-chain funding and cooperative or force-close settlement to off-chain routing of multi-hop payments — exposing a gRPC and REST API that downstream wallets, exchanges, and applications consume. LND implements the BOLT (Basis of Lightning Technology) protocol specifications and employs Hash Time-Locked Contracts (HTLCs) to ensure atomic, trust-minimised payment routing across a peer-to-peer mesh of channels anchored to the Bitcoin base layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:layer-2-protocol ;
    vc:contrastsWith ngm:c-lightning,
        ngm:eclair ;
    vc:enables ngm:atomic-swap,
        ngm:keysend,
        ngm:micropayment,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel-graph,
        ngm:lncli,
        ngm:watchtower ;
    vc:implements ngm:bolt-protocol,
        ngm:hash-time-locked-contract ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:loop,
        ngm:pool,
        ngm:taproot-assets ;
    vc:requires ngm:bitcoin,
        ngm:bitcoind,
        ngm:lightning-network,
        ngm:payment-channel ;
    vc:slug "lnd" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gossip-protocol,
        ngm:grpc,
        ngm:macaroon-authentication,
        ngm:onion-routing .

ngm:local-explanation a owl:Class ;
    rdfs:label "Local Explanation"@en ;
    rdfs:comment "Interpretability techniques that explain individual model predictions for specific instances, providing insight into why a particular input produced a given output without necessarily characterising the model's global behaviour. Methods such as LIME and SHAP generate feature-attribution scores scoped to the neighbourhood of a single query point."@en ;
    rdfs:subClassOf ngm:model-interpretability ;
    vc:bridgesTo ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:global-explanation ;
    vc:enables ngm:accountability,
        ngm:fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:explainable-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "local-explanation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feature-importance .

ngm:logistics a owl:Class ;
    rdfs:label "Logistics"@en ;
    rdfs:comment "Logistics is the planning, execution, and control of the efficient movement and storage of goods, services, and related information between points of origin and consumption. It encompasses transportation, warehousing, inventory management, order fulfilment, and reverse flows, with the objective of meeting demand at the required service level and lowest total cost. Logistics is a constituent function of supply-chain management and is increasingly mediated by sensor data, real-time tracking, and optimisation algorithms that coordinate multimodal networks under uncertainty."@en ;
    rdfs:subClassOf ngm:process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:reverse-logistics ;
    vc:slug "logistics" ;
    vc:sourceDomain "supply-chain" .

ngm:lora a skos:Concept ;
    rdfs:label "Lora"@en .

ngm:low-latency-networking a skos:Concept ;
    rdfs:label "Low Latency Networking"@en .

ngm:machine-to-machine-payments a owl:Class ;
    rdfs:label "Machine to Machine Payments"@en ;
    rdfs:comment "Machine to Machine Payments (M2M Payments) refers to automated financial transactions initiated and settled between autonomous devices, software agents, or AI systems without direct human involvement in each individual transaction. These payments enable IoT devices, autonomous vehicles, robots, and AI agents to pay for resources, services, or data on a per-use or streaming basis, forming the economic layer of the machine economy. M2M payments typically require programmable money, low transaction fees, high throughput, and reliable settlement guarantees, properties that have driven interest in blockchain-based payment channels, stablecoins, and central bank digital currencies as settlement rails."@en ;
    rdfs:subClassOf ngm:digital-payment-system ;
    vc:enables ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-finance,
        ngm:agentic-internet,
        ngm:autonomous-agent ;
    vc:slug "machine-to-machine-payments" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-payments ;
    vc:uses ngm:lightning-network,
        ngm:micropayments,
        ngm:smart-contract .

ngm:manufacturing-process a owl:Class ;
    rdfs:label "Manufacturing Process"@en ;
    rdfs:comment "A manufacturing process is a structured sequence of physical transformations — including machining, assembly, forming, joining, heat treatment, surface finishing, and inspection — applied to raw materials or sub-components to produce finished goods meeting specified tolerances, material properties, and functional requirements. Manufacturing processes are characterised by their tooling, cycle time, throughput, waste profile, and quality control mechanisms."@en ;
    rdfs:subClassOf ngm:industrial-automation ;
    vc:enables ngm:logistics-automation,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-inspection ;
    vc:slug "manufacturing-process" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:industrial-robot,
        ngm:quality-assurance,
        ngm:sensor .

ngm:market-making a owl:Class ;
    rdfs:label "Market Making"@en ;
    rdfs:comment "Market making is the practice of continuously quoting firm bid and ask prices for a financial asset or token, providing counterparty liquidity to traders who wish to buy or sell without waiting for a natural matching order. A market maker earns the bid-ask spread as compensation for bearing inventory risk and adverse-selection risk from better-informed traders. In traditional venues the function is performed by designated dealers or algorithmic trading firms managing limit-order books; in decentralised finance it is automated by liquidity-pool protocols that replace human quoting with deterministic pricing curves. The activity is fundamental to functional markets because it converts latent supply and demand into observable, executable prices through continuous [[Price Discovery]]."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:liquidity-provision ;
    vc:bridgesTo ngm:automated-market-maker,
        ngm:decentralised-exchange,
        ngm:smart-contract ;
    vc:contrastsWith ngm:high-frequency-trading,
        ngm:order-taking ;
    vc:enables ngm:market-liquidity,
        ngm:price-discovery,
        ngm:trade-execution ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bid-ask-spread,
        ngm:inventory-risk,
        ngm:quote-refresh ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:adverse-selection,
        ngm:algorithmic-trading,
        ngm:arbitrage,
        ngm:market-microstructure ;
    vc:requires ngm:capital-allocation,
        ngm:risk-management ;
    vc:slug "market-making" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:hedging,
        ngm:limit-order,
        ngm:order-book .

ngm:material-science a owl:Class ;
    rdfs:label "Material Science"@en ;
    rdfs:comment "Material Science is the interdisciplinary field that studies the structure, properties, processing, and performance of matter across all classes — metals, ceramics, polymers, semiconductors, and composites — connecting atomic-scale arrangement to macroscopic behaviour. It integrates principles from physics, chemistry, and engineering to enable the rational design of materials with tailored properties. Computational methods including density functional theory, molecular dynamics simulation, and machine-learning-driven property prediction increasingly complement experimental synthesis and characterisation. The field underpins virtually every technology sector, from microelectronics and energy storage to biomedical implants and advanced manufacturing."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:quantum-computing,
        ngm:supply-chain ;
    vc:contrastsWith ngm:materials-engineering ;
    vc:dependsOn ngm:chemistry,
        ngm:experimental-physics ;
    vc:enables ngm:additive-manufacturing,
        ngm:battery-technology,
        ngm:material-system,
        ngm:nanotechnology,
        ngm:semiconductor-manufacturing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:crystallography,
        ngm:materials-characterisation,
        ngm:materials-processing,
        ngm:thermodynamics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:condensed-matter-physics,
        ngm:engineering-discipline,
        ngm:materials-informatics,
        ngm:nanoscience,
        ngm:surface-science ;
    vc:requires ngm:computational-chemistry,
        ngm:quantum-mechanics,
        ngm:thermodynamics ;
    vc:slug "material-science" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-driven-discovery,
        ngm:machine-learning,
        ngm:simulation .

ngm:matrix-factorisation a owl:Class ;
    rdfs:label "Matrix Factorisation"@en ;
    rdfs:comment "Matrix factorisation is a family of techniques that decompose a matrix into a product of lower-dimensional factor matrices, revealing latent structure in the data. In machine learning it is widely used for collaborative-filtering recommendation, where a sparse user-item rating matrix is approximated by user and item embedding factors. Variants include singular value decomposition, non-negative matrix factorisation, and low-rank adaptation methods."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyper-personalisation,
        ngm:lo-ra-do-ra-etc ;
    vc:slug "matrix-factorisation" ;
    vc:sourceDomain "ai" .

ngm:matter-protocol a owl:Class ;
    rdfs:label "Matter Protocol"@en ;
    rdfs:comment "Matter is a royalty-free smart-home connectivity standard developed by the Connectivity Standards Alliance to provide a common application layer enabling devices from different manufacturers to interoperate over IP networks. Built on top of Thread and Wi-Fi for transport, Matter defines a unified data model, secure commissioning, and local control that removes dependence on proprietary vendor clouds. It is backed by Apple, Google, Amazon, and Samsung, and aims to resolve the fragmentation that historically forced consumers into single-ecosystem smart-home purchases."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol ;
    vc:slug "matter-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:thread-protocol,
        ngm:zigbee .

ngm:metadata-repository a owl:Class ;
    rdfs:label "Metadata Repository"@en ;
    rdfs:comment "Storage systems that centralise metadata from diverse data sources, providing unified access to technical, business, and operational metadata for data discovery, cataloguing, lineage tracking, and governance across enterprise environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:data-management ;
    vc:enables ngm:data-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metadata-repository" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-application a owl:Class ;
    rdfs:label "Metaverse Application"@en ;
    rdfs:comment "A software application designed to operate within or alongside a metaverse platform, providing users with persistent virtual experiences including social interaction, commerce, entertainment, education, and collaboration. Metaverse applications leverage real-time 3D rendering, avatar systems, spatial audio, and interoperability standards to deliver presence-rich, cross-platform functionality within shared virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:distributed-collaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:metaverse-architecture ;
    vc:requires ngm:avatar,
        ngm:metaverse-platform ;
    vc:slug "metaverse-application" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:game-engine,
        ngm:spatial-audio .

ngm:metaverse-ontology-schema a owl:Class ;
    rdfs:label "Metaverse Ontology Schema"@en ;
    rdfs:comment "A formal OWL 2 ontology framework defining the complete taxonomic structure, semantic relationships, axioms, and reasoning rules for metaverse concepts, enabling automated classification, consistency validation, and interoperability across virtual world implementations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
