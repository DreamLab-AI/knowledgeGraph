    vc:slug "world-building" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-content-generation,
        ngm:game-engine .

ngm:xr-device a owl:Class ;
    rdfs:label "XR Device"@en ;
    rdfs:comment "Hardware equipment designed to create or enhance extended reality experiences, encompassing virtual reality headsets, augmented reality glasses, mixed reality displays, haptic feedback systems, and motion tracking sensors that enable immersive interaction with digital content."@en ;
