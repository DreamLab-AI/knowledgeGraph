            owl:someValuesFrom ngm:gpu-compute ],
        ngm:text-to-image-generation ;
    vc:bridgesTo ngm:spatial-computing,
        ngm:virtual-production ;
    vc:contrastsWith ngm:adobe-firefly,
        ngm:dall-e-3,
        ngm:stable-diffusion-image-model ;
    vc:enables ngm:concept-art,
