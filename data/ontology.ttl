    vc:contrastsWith ngm:procedural-content ;
    vc:dependsOn ngm:inference-infrastructure,
        ngm:prompt-engineering ;
    vc:enables ngm:metaverse-content-pipeline,
        ngm:personalised-learning,
        ngm:procedural-generation ;
    vc:hasMaturity ngmi:maturity-established ;
