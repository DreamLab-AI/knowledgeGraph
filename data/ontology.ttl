ngm:embedding a owl:Class ;
    rdfs:label "Embedding"@en ;
    rdfs:comment "An embedding is a learned mapping from discrete or high-dimensional objects—such as words, sentences, images, graphs, or code—into a continuous, low-dimensional vector space, such that semantically or functionally similar inputs are mapped to geometrically proximate vectors. Embeddings are fundamental to modern machine learning, enabling downstream tasks including similarity search, classification, clustering, and retrieval through compact, transferable representations."@en ;
    rdfs:subClassOf ngm:representation-learning ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feature-extraction,
        ngm:latent-space ;
    vc:slug "embedding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:dimensionality-reduction,
        ngm:encoder,
        ngm:neural-network .

ngm:enterprise-token-standards a owl:Class ;
