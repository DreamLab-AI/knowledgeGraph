ngm:data-mesh a owl:Class ;
    rdfs:label "Data Mesh"@en ;
    rdfs:comment "Data Mesh is a socio-technical paradigm for large-scale analytical data architecture, coined by Zhamak Dehghani (2020), that decentralises data ownership to domain-aligned teams who treat their analytical datasets as first-class products accessible via standardised interfaces. It rests on four principles: domain-oriented decentralised data ownership, data as a product, self-serve data infrastructure as a platform, and federated computational governance. Unlike monolithic data lakes or warehouses governed by a central data engineering team, a Data Mesh distributes accountability so that the teams who generate data also maintain its quality, documentation, and SLAs as discoverable data products. The model draws on domain-driven design and microservices thinking applied to analytical rather than operational data flows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-registry ],
        ngm:data-governance-framework ;
    vc:bridgesTo ngm:federated-learning,
        ngm:platform-engineering ;
    vc:contrastsWith ngm:data-fabric-architecture,
        ngm:data-warehouse ;
    vc:enables ngm:data-analytics,
        ngm:data-democratisation,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-domain,
        ngm:data-product,
        ngm:federated-computational-governance,
        ngm:self-serve-data-platform ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:data-governance,
        ngm:data-lineage ;
    vc:requires ngm:data-contract,
        ngm:domain-driven-design,
        ngm:schema-registry ;
    vc:slug "data-mesh" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-lake,
        ngm:event-driven-architecture ;
    vc:uses ngm:api-gateway,
        ngm:data-pipeline,
        ngm:microservices-architecture,
        ngm:policy-as-code .

ngm:decentralization a owl:Class ;
    rdfs:label "Decentralization"@en ;
    rdfs:comment "The architectural property of distributing control, data storage, and decision-making across many independent network participants rather than concentrating them in a single authority. In blockchain systems, decentralisation is achieved through open participation, distributed consensus, and cryptographic enforcement of rules, providing censorship resistance, fault tolerance, and permissionless access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:51-attack ;
    vc:enables ngm:blockchain-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:decentralization-layer,
        ngm:decentralized-storage,
        ngm:longest-chain-rule ;
    vc:requires ngm:consensus-mechanism,
        ngm:node ;
    vc:slug "decentralization" ;
    vc:sourceDomain "blockchain" .

ngm:decentralized-application a owl:Class ;
    rdfs:label "Decentralized Application"@en ;
    rdfs:comment "A decentralized application (dApp) is a software application whose backend logic runs on a blockchain or peer-to-peer network rather than on centralised servers controlled by a single entity, ensuring that no single party can unilaterally modify, censor, or shut down the application. The on-chain components — typically smart contracts — enforce business logic and state transitions transparently, while user-facing frontends may remain conventional web or mobile interfaces that communicate with the blockchain via wallet connectors. dApps inherit the censorship resistance and trustlessness of their underlying blockchain while exposing usability challenges related to transaction costs, latency, and key management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        ngm:blockchain-application ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:centralized-application,
        ngm:traditional-web-application ;
    vc:dependsOn ngm:evm,
        ngm:ipfs,
        ngm:smart-contract-platform ;
    vc:enables ngm:blockchain-governance,
        ngm:dao,
        ngm:decentralized-finance-de-fi,
        ngm:non-fungible-token,
        ngm:tokenized-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:oracle,
        ngm:smart-contract,
        ngm:wallet-connector ;
    vc:implements ngm:censorship-resistance,
        ngm:trustless-execution ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:de-fi,
        ngm:web3 ;
    vc:requires ngm:blockchain-network,
        ngm:consensus-mechanism,
        ngm:cryptographic-wallet ;
    vc:slug "decentralized-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:account-abstraction,
        ngm:blockchain,
        ngm:layer-2-scaling .

ngm:decision-support a owl:Class ;
    rdfs:label "Decision Support"@en ;
    rdfs:comment "Decision Support refers to the class of information systems, analytical frameworks, and AI-augmented tools designed to improve the quality, speed, and consistency of human or automated decision-making by surfacing relevant data, models, and recommendations at the point of choice. Modern decision support systems integrate structured data from enterprise systems with unstructured signals from documents, sensor streams, and language models to present synthesised options with associated confidence levels and risk profiles. They range from simple rule-based dashboards to sophisticated agentic pipelines that autonomously gather evidence, run simulations, and present ranked courses of action. The field spans domains including clinical medicine, financial trading, military command, supply chain management, and public policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recommendation-engine ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:clinical-governance,
        ngm:financial-risk-management ;
    vc:contrastsWith ngm:fully-automated-decision-making,
        ngm:unaided-expert-judgement ;
    vc:dependsOn ngm:machine-learning-inference,
        ngm:real-time-data-pipeline ;
    vc:enables ngm:distributed-decision-making,
        ngm:evidence-based-policy,
        ngm:strategic-planning ;
