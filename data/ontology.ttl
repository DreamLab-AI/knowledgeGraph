ngm:proprietary-specification a owl:Class ;
    rdfs:label "Proprietary Specification"@en ;
    rdfs:comment "A proprietary specification is a technical specification controlled by a single vendor or consortium that retains exclusive rights over its definition, evolution and use. Access may require licensing, non-disclosure or membership, and the owner can change it unilaterally. It contrasts with an open standard governed by a neutral body under royalty-free or fair terms, and it tends to increase the risk of vendor lock-in for adopters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-rights ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:licensing ],
        ngm:technical-standard ;
    vc:contrastsWith ngm:open-standard ;
    vc:dependsOn ngm:intellectual-property-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
