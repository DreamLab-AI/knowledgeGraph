ngm:common-crawl a owl:Class ;
    rdfs:label "Common Crawl"@en ;
    rdfs:comment "Common Crawl is a California 501(c)3 non-profit organisation founded in 2008 by Gil Elbaz that maintains a petabyte-scale, freely accessible archive of web crawl data stored on Amazon S3 under the AWS Open Data Sponsorship Programme. The dataset — distributed as WARC, WAT, and WET files — underpins virtually every major open pre-training corpus including C4, FineWeb, RedPajama, Dolma, and DCLM, and has been cited by the Mozilla Foundation (2024) as essential to the emergence of modern generative AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deduplication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:open-data,
        ngm:training-data ;
    vc:contrastsWith ngm:curated-datasets,
        ngm:synthetic-data ;
    vc:enables ngm:foundation-models,
        ngm:large-language-models,
        ngm:model-training,
        ngm:pre-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:url-index,
        ngm:warc-files,
        ngm:wat-files,
        ngm:wet-files ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:bias-in-large-language-models,
        ngm:copyright,
        ngm:data-governance,
        ngm:information-retrieval,
        ngm:natural-language-processing ;
