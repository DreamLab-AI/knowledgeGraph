ngm:jailbreaking a owl:Class ;
    rdfs:label "Jailbreaking"@en ;
    rdfs:comment "Jailbreaking of large language models (LLMs) is the practice of crafting inputs—prompts, instruction sequences, encoded payloads, or multi-turn conversational strategies—that cause a model to produce outputs that circumvent its safety training, content policies, or alignment objectives."@en ;
    rdfs:subClassOf ngm:adversarial-machine-learning,
        ngm:prompt-engineering ;
    vc:enables ngm:adversarial-evaluation,
        ngm:harmful-content-generation,
        ngm:policy-circumvention,
        ngm:red-teaming ;
    vc:hasPart ngm:ascii-art-attack,
        ngm:best-of-n-jailbreaking,
        ngm:crescendo-attack,
        ngm:low-resource-language-attack,
        ngm:many-shot-jailbreaking,
        ngm:persona-attack,
        ngm:prompt-injection,
        ngm:skeleton-key-attack ;
    vc:implements ngm:constitutional-ai,
        ngm:constitutional-classifiers,
        ngm:guardrails-ai,
        ngm:llama-guard,
        ngm:rlhf ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-internet,
        ngm:agents,
        ngm:ai-companies,
        ngm:ai-liability,
        ngm:anthropic-claude,
        ngm:chat-gpt,
        ngm:cli-multi-agent-systems ;
    vc:requires ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:safety-training,
        ngm:transformer-architecture ;
    vc:slug "jailbreaking" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:aisi,
        ngm:eu-ai-act,
        ngm:mitre-atlas,
        ngm:nist-ai-rmf ;
    vc:supports ngm:ai-governance,
        ngm:ai-red-teaming,
        ngm:ai-regulation,
        ngm:content-moderation ;
    vc:uses ngm:classifier-models,
        ngm:ensemble-methods,
        ngm:prompt-engineering,
        ngm:transfer-learning .

