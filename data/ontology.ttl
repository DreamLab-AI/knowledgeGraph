ngm:compute-governance a owl:Class ;
    rdfs:label "Compute Governance"@en ;
    rdfs:comment "Compute governance is the set of policies, controls, and oversight mechanisms applied to the large-scale computing hardware used to train and deploy advanced AI systems. Because frontier AI capability is tightly coupled to access to specialised accelerators, governing compute offers a measurable, supply-chain-anchored lever for AI policy. Mechanisms include export controls, usage reporting thresholds, and on-chip verification of training runs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:export-controls ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semiconductor-supply-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:international-cooperation ],
        ngm:ai-governance ;
    vc:bridgesTo ngm:infrastructure,
        ngm:security,
        ngm:supply-chain ;
    vc:contrastsWith ngm:algorithmic-governance,
        ngm:data-governance ;
    vc:dependsOn ngm:cloud-computing,
        ngm:gpu-cluster,
        ngm:hardware-security-module ;
    vc:enables ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:export-controls ;
    vc:implements ngm:ai-policy,
        ngm:export-controls ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
