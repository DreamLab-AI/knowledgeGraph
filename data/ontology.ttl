    vc:requires ngm:multi-party-computation ;
    vc:slug "trusted-setup" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain ;
    vc:uses ngm:kzg-commitment ;
    vc:uses ngm:polynomial-commitment .
ngm:trusted-setup-ceremony a owl:Class ;
    rdfs:comment "A trusted setup ceremony is a one-time, multi-party procedure used to generate the public parameters required by certain zero-knowledge proof systems, such as zk-SNARKs, in which participants jointly compute the parameters while each contributes and then destroys a private random value, known as toxic waste. The scheme remains secure provided at least one participant honestly destroys their contribution, so ceremonies are typically run with many independent participants across jurisdictions to make full collusion implausible. Protocols such as Zcash have run public, auditable trusted setup ceremonies to generate the parameters underlying their privacy-preserving transactions."@en ;
    rdfs:label "Trusted Setup Ceremony"@en ;
    rdfs:subClassOf ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:zero-knowledge-proof ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:relatedTo ngm:privacy-preserving-blockchain ;
    vc:relatedTo ngm:zcash ;
    vc:slug "trusted-setup-ceremony" ;
    vc:sourceDomain "blockchain" .
ngm:trusted-third-party a owl:Class ;
    rdfs:comment "A trusted third party (TTP) is an intermediary that two or more parties rely upon to facilitate, witness, or settle an interaction without each party having to trust the other directly. Examples include certificate authorities, escrow agents, custodians, and clearing houses. Blockchain systems are largely motivated by the goal of minimising or eliminating trusted third parties, replacing institutional trust with cryptographic verification and decentralised consensus."@en ;
    rdfs:label "Trusted Third Party"@en ;
    rdfs:subClassOf ngm:security ;
    rdfs:subClassOf _:r21411 ;
