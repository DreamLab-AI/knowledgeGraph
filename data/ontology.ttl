        ngm:model-weights ;
    vc:slug "ai-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:ai-model,
        ngm:ai-model-architecture,
        ngm:gpu-acceleration,
        ngm:quantisation,
        ngm:tensor-parallelism .

