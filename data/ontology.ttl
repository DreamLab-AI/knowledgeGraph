ngm:kqml a owl:Class ;
    rdfs:label "Kqml"@en ;
    rdfs:comment "KQML, the Knowledge Query and Manipulation Language, is an early agent communication language and protocol for exchanging information and knowledge among software agents. It defines a set of performatives, message types grounded in speech-act theory, that express the intent of a communication such as ask, tell, subscribe or achieve. KQML influenced later standards including the FIPA Agent Communication Language."@en ;
    rdfs:subClassOf ngm:agent-communication-language ;
    vc:bridgesTo ngm:multi-agent-system ;
    vc:contrastsWith ngm:fipa-acl ;
    vc:dependsOn ngm:ontology ;
    vc:enables ngm:inter-agent-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:agent-communication-language ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fipa-acl,
        ngm:inter-agent-communication,
        ngm:ontology ;
    vc:slug "kqml" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:multi-agent-system ;
    vc:uses ngm:ontology .

ngm:lang-chain a owl:Class ;
    rdfs:label "LangChain"@en ;
    rdfs:comment "LangChain is an open-source Python and TypeScript framework for composing Large Language Model applications as chains of modular components — prompt templates, LLM wrappers, output parsers, memory stores, retrieval augmented generation pipelines, and tool-calling agents — providing a unified ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lang-graph ],
        [ a owl:Restriction ;
