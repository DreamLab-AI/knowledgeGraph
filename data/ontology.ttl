    vc:sourceDomain "governance" ;
    vc:supports ngm:api-specification,
        ngm:data-format,
        ngm:protocol-specification .

ngm:differential-privacy a owl:Class ;
    rdfs:label "Differential Privacy"@en ;
    rdfs:comment "Differential Privacy is a mathematical framework providing provable privacy guarantees by adding carefully calibrated noise to data queries or model outputs, ensuring that the presence or absence of any single individual's data has negligible impact on analysis results. The epsilon (ε) parameter quantifies the privacy budget, with smaller values indicating stronger guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-budget-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensitivity-analysis ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin ;
    vc:contrastsWith ngm:data-anonymisation,
        ngm:k-anonymity ;
    vc:enables ngm:federated-edge-learning,
        ngm:privacy-by-design,
        ngm:privacy-preserving-machine-learning,
        ngm:private-data-release ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:exponential-mechanism,
        ngm:gaussian-mechanism,
        ngm:laplace-mechanism,
        ngm:privacy-budget-management ;
    vc:implements ngm:privacy-mechanism ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation ;
    vc:requires ngm:noise-addition,
        ngm:sensitivity-analysis ;
    vc:slug "differential-privacy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-minimisation,
        ngm:data-protection,
        ngm:gdpr-compliance ;
    vc:uses ngm:composition-theorem,
        ngm:machine-learning-discipline,
        ngm:stochastic-gradient-descent .

ngm:formal-verification a owl:Class ;
    rdfs:label "Formal Verification"@en ;
    rdfs:comment "Formal verification is the application of mathematical proof techniques — including model checking, theorem proving, abstract interpretation, and satisfiability-modulo-theories (SMT) solving — to rigorously establish that a hardware or software system satisfies a specified set of correctness, safety, or security properties under all possible inputs and execution paths. Unlike testing, which can only expose defects in sampled executions, formal verification provides exhaustive, machine-checkable guarantees by reasoning over the entire state space or by constructing logical proofs relative to a formal specification. The discipline encompasses hardware circuit verification, operating-system kernel correctness proofs, smart-contract auditing, neural-network robustness certification, and protocol security analysis, and is increasingly mandated in safety-critical and regulated industries where defects carry life-critical or large financial consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-specification ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:neural-network-verification ;
    vc:contrastsWith ngm:runtime-monitoring,
        ngm:software-testing ;
    vc:dependsOn ngm:formal-methods,
        ngm:mathematical-logic ;
    vc:enables ngm:ai-safety,
        ngm:certified-robustness,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:abstract-interpretation,
        ngm:model-checking,
        ngm:smt-solving,
        ngm:theorem-proving ;
    vc:implements ngm:hoare-logic,
        ngm:type-theory ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:interpretability,
        ngm:static-analysis ;
    vc:requires ngm:formal-specification,
        ngm:temporal-logic ;
    vc:slug "formal-verification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-risk-management,
        ngm:cryptographic-protocol,
        ngm:hardware-design,
        ngm:smart-contract ;
    vc:uses ngm:proof-assistant,
        ngm:satisfiability-solver .

ngm:motion-capture a owl:Class ;
