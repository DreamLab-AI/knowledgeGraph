        ngm:ecb-digital-euro-regulation,
        ngm:ecb-digital-euro-regulation-proposal ;
    vc:slug "digital-euro" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:european-parliament .

ngm:digital-marketing a owl:Class ;
    rdfs:label "Digital Marketing"@en ;
    rdfs:comment "Digital Marketing encompasses the strategies and technologies used to promote products and services through digital channels, including search engines, social media, email, and immersive platforms. In spatial computing and metaverse contexts, digital marketing extends to in-world advertising, NFT-based brand activations, virtual experiential campaigns, and personalised AR overlays that contextualise commercial messages within physical environments."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:blockchain ;
    vc:enables ngm:e-commerce,
        ngm:loyalty-programs ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "digital-marketing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-content,
        ngm:recommendation-engine .

ngm:digital-platform a owl:Class ;
    rdfs:label "Digital Platform"@en ;
    rdfs:comment "A Digital Platform is a software-mediated environment that enables interaction, transaction, and value exchange between multiple user groups, often exploiting network effects to grow. In spatial computing and Web3 contexts, digital platforms host virtual experiences, marketplaces, and decentralised applications, frequently integrating blockchain infrastructure for ownership and governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-ecosystem ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-asset-ecosystem ;
