        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-rendering,
        ngm:interactive-visualization,
        ngm:virtual-environment-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:material-definition,
        ngm:mesh-data,
        ngm:texture-mapping ;
    vc:slug "3-d-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:activation-function a owl:Class ;
    rdfs:label "Activation Function"@en ;
    rdfs:comment "An Activation Function is a non-linear mathematical transformation applied to a neuron's weighted input sum, enabling neural networks to learn complex, non-linear mappings. Common variants include Sigmoid, Tanh, ReLU, Leaky ReLU, and GELU; the choice of activation function critically affects gradient flow, convergence speed, and model expressivity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-technique,
        ngm:neural-network-component ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:neural-network-layer ;
    vc:requires ngm:backpropagation ;
    vc:slug "activation-function" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:adversarial-attack a owl:Class ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "An Adversarial Attack is a deliberate attempt to manipulate an AI system by crafting malicious inputs or exploiting model vulnerabilities to cause misclassification, extract confidential information, degrade performance, or subvert intended behaviour. Attack classes include evasion, poisoning, model extraction, inversion, and backdoor, across white-box, black-box, and grey-box threat models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:robustness,
        ngm:safety-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:computer-vision ;
    vc:slug "adversarial-attack" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:adversarial-robustness a owl:Class ;
    rdfs:label "Adversarial Robustness"@en ;
    rdfs:comment "The capability of an AI system to maintain correct and consistent behaviour when subjected to adversarial examples—inputs intentionally crafted with small, often imperceptible perturbations designed to cause misclassification or incorrect outputs. Defensive strategies include adversarial training, randomised smoothing, and ensemble methods, each offering different trade-offs between certified guarantees and computational cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:attack-vector,
        ngm:vulnerability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:resilience,
        ngm:risk ;
    vc:requires ngm:ai-safety,
        ngm:security ;
    vc:slug "adversarial-robustness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:adversarial-testing a owl:Class ;
    rdfs:label "Adversarial Testing"@en ;
    rdfs:comment "A testing methodology that deliberately attempts to cause AI system failures through adversarial inputs, edge cases, and challenging scenarios in order to identify robustness issues, safety vulnerabilities, and alignment failures before deployment. It encompasses both explicitly adversarial prompts and implicitly problematic queries, drawing on red-teaming practices and formalised by NIST AI 100-2."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        ngm:ai-governance-and-ethics,
        ngm:ai-safety ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:digital-twin ;
    vc:requires ngm:machine-learning-model ;
    vc:slug "adversarial-testing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:robustness ;
    vc:uses ngm:red-teaming .

ngm:ai-trustworthiness a owl:Class ;
    rdfs:label "AI Trustworthiness"@en ;
    rdfs:comment "The degree to which an AI system demonstrates characteristics that warrant confidence and reliance, encompassing transparency, explainability, fairness, accountability, robustness, reliability, safety, security, and privacy throughout its lifecycle."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-assurance-ai-0102,
        ngm:responsible-ai-ai-0033 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:governance-framework-ai-0035,
        ngm:risk-management-ai-0062 ;
    vc:slug "ai-trustworthiness" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:audit-log a owl:Class ;
    rdfs:label "Audit Log"@en ;
    rdfs:comment "An audit log is an immutable, chronologically ordered record of discrete events that captures who performed an action, what action was performed, on which resource, at what time, and from where, providing an authoritative evidence trail for security investigation, regulatory compliance, and forensic analysis. Each log entry is typically structured with a timestamp, actor identity, event type, affected object identifier, outcome status, and contextual metadata. Audit logs are foundational to accountability in information systems, distinguishing themselves from operational logs by their emphasis on human-actionable accountability rather than system diagnostics."@en ;
    rdfs:subClassOf ngm:audit-trail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-logging,
        ngm:compliance-audit-trail,
        ngm:data-integrity ;
    vc:slug "audit-log" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:access-control,
        ngm:compliance-framework,
        ngm:information-security ;
    vc:uses ngm:cryptographic-hash,
        ngm:event-sourcing .

ngm:bitcoin-etf a owl:Class ;
    rdfs:label "Bitcoin ETF"@en ;
    rdfs:comment "A Bitcoin ETF (Bitcoin Exchange-Traded Fund) is a regulated, exchange-listed pooled investment vehicle providing investors fungible share-based exposure to the spot price of Bitcoin (or, in the case of futures-based variants, to rolling CME Bitcoin futures contracts) through traditional broke..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-custody ],
