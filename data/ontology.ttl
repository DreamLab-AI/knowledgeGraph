ngm:merkle-proof a owl:Class ;
    rdfs:label "Merkle Proof"@en ;
    rdfs:comment "A cryptographic proof of inclusion or exclusion that demonstrates whether a specific data element is part of a Merkle tree, requiring only O(log n) sibling hashes rather than the full data set. Merkle proofs underpin light-client verification in blockchain systems and enable simplified payment verification (SPV) without downloading the entire chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:data-integrity,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:zero-knowledge-proof ;
    vc:enables ngm:blockchain-scalability,
        ngm:cryptographic-security,
        ngm:light-client,
        ngm:simplified-payment-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proof-of-inclusion,
        ngm:vector-commitment ;
    vc:isPartOf ngm:block-header,
        ngm:blockchain-transaction ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:block-header,
        ngm:blockchain-transaction,
        ngm:cryptographic-commitment,
        ngm:patricia-trie ;
    vc:requires ngm:merkle-tree ;
    vc:slug "merkle-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-node,
        ngm:cross-chain-bridge ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:merkle-root,
        ngm:merkle-tree,
        ngm:sha-256 .

ngm:predictive-maintenance a owl:Class ;
    rdfs:label "Predictive Maintenance"@en ;
    rdfs:comment "Predictive Maintenance (PdM) is a condition-based maintenance strategy that uses continuous or periodic monitoring of physical asset health signals—vibration, temperature, acoustic emission, current draw, oil particle count, ultrasound, and corrosion metrics—combined with machine learning inf..."@en ;
