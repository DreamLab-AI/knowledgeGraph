ngm:decentralisation a owl:Class ;
    rdfs:label "Decentralisation"@en ;
    rdfs:comment "Decentralisation is the architectural and governance principle of distributing authority, control, computation, or data storage across multiple independent nodes or actors rather than concentrating it in a single entity. In technical systems it manifests as distributed ledgers, peer-to-peer networks, and federated protocols that eliminate single points of failure and censorship. In governance it refers to transferring decision-making power from central authorities to local or community actors. The degree of decentralisation exists on a spectrum and involves trade-offs between efficiency, security, scalability, and resilience."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nakamoto-coefficient ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:edge-computing,
        ngm:federated-learning,
        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:centralisation,
        ngm:federated-architecture ;
    vc:enables ngm:censorship-resistance,
        ngm:decentralised-finance,
        ngm:decentralised-identity,
        ngm:permissionless-innovation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:nakamoto-coefficient,
        ngm:sybil-resistance ;
    vc:implements ngm:distributed-ledger-technology,
        ngm:peer-to-peer-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:network-topology,
        ngm:open-source-software,
        ngm:self-sovereign-identity ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:cryptographic-hash-function,
        ngm:incentive-mechanism ;
    vc:slug "decentralisation" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain-governance,
        ngm:dao,
        ngm:decentralized-governance,
        ngm:fault-tolerance .

ngm:decentralized-identity-foundation a owl:Class ;
    rdfs:label "Decentralized Identity Foundation"@en ;
    rdfs:comment "The Decentralized Identity Foundation (DIF) is an open industry consortium founded in 2017 that develops interoperable specifications, protocols, and reference implementations for decentralised digital identity systems. It produces foundational work items including the Presentation Exchange specification, the Decentralized Web Node (DWN) protocol for identity-linked personal data storage, the DIDComm messaging protocol, and the Sidetree protocol family for scalable DID method implementations. DIF operates as a coordination layer complementing W3C standards bodies, bridging specification gaps between DID methods, verifiable credential formats, and identity wallet implementations. Its outputs are adopted in major identity frameworks including the European Union Digital Identity (EUDI) Wallet Architecture Reference Framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:didcomm ],
        ngm:standards-body ;
    vc:bridgesTo ngm:ai-identity-verification,
        ngm:eudi-wallet ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:federated-identity ;
    vc:enables ngm:decentralized-identifier,
        ngm:did-document,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decentralized-web-node,
        ngm:didcomm,
        ngm:presentation-exchange,
        ngm:sidetree-protocol ;
    vc:implements ngm:did-core,
        ngm:verifiable-credentials-data-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:trust-framework,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:slug "decentralized-identity-foundation" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:openid-foundation,
        ngm:world-wide-web-consortium ;
    vc:supports ngm:digital-identity,
        ngm:identity,
        ngm:privacy-preserving-computation .

ngm:deflationary-token a owl:Class ;
    rdfs:label "Deflationary Token"@en ;
    rdfs:comment "A Deflationary Token is a cryptocurrency or blockchain token whose total circulating supply decreases over time through one or more programmatic burning mechanisms—such as transaction fee burns, scheduled buyback-and-burn events, or protocol-level token destruction—creating supply-side scarcity intended to exert upward price pressure and incentivise long-term holding."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:inflationary-token,
        ngm:native-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:token-economics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:governance-token,
        ngm:token-economics,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "deflationary-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:burning-mechanism,
        ngm:supply-cap .

ngm:digital-services-act a owl:Class ;
    rdfs:label "Digital Services Act"@en ;
    rdfs:comment "A comprehensive EU regulation establishing a legal framework for digital services accountability, content moderation requirements, platform transparency obligations, and user protection measures across online intermediaries, marketplaces, and social platforms, with implications for metaverse and virtual world governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reporting-mechanisms ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-transparency ],
        ngm:digital-regulation ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:metaverse,
        ngm:telecollaboration ;
    vc:contrastsWith ngm:digital-markets-act,
        ngm:gdpr ;
    vc:enables ngm:content-transparency,
        ngm:illegal-content-removal,
        ngm:minor-protection,
        ngm:platform-accountability,
        ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:notice-and-action-mechanism,
        ngm:trusted-flaggers-regime,
        ngm:very-large-online-platform-obligations ;
    vc:implements ngm:data-access-rights,
        ngm:platform-governance ;
    vc:isPartOf ngm:eu-digital-single-market ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:online-safety,
        ngm:recommendation-algorithms ;
    vc:requires ngm:algorithmic-transparency,
