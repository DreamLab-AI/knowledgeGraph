    vc:slug "tensor-flow" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:convolutional-neural-network,
        ngm:neural-network,
        ngm:recurrent-neural-network,
        ngm:transfer-learning ;
    vc:uses ngm:gpu-computing,
        ngm:tensor-processing-unit .

ngm:time-synchronisation a owl:Class ;
    rdfs:label "Time Synchronisation"@en ;
    rdfs:comment "Time synchronisation is the process of coordinating the clocks of networked devices to a shared reference time so that distributed computations, transactions, events, and audit logs share a consistent and ordered temporal frame. It is realised through layered protocols including the Network Time Protocol (NTP / RFC 5905), which delivers millisecond-level accuracy over wide-area networks via a stratum hierarchy anchored to atomic or GPS reference clocks, and the Precision Time Protocol (PTP / IEEE 1588-2019), which exploits hardware timestamping in network interface cards and PTP-aware switches to achieve sub-microsecond accuracy on local and carrier-grade networks. Accurate time synchronisation is foundational to distributed consensus algorithms, cryptographic certificate validation, financial transaction sequencing, telecommunications frequency synchronisation, and industrial real-time control; conversely, clock skew and drift are root causes of ordering anomalies, replay attacks, split-brain conditions, and regulatory non-compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:cryptographic-protocol ;
    vc:contrastsWith ngm:logical-clock,
        ngm:vector-clock ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:timestamp ;
    vc:enables ngm:audit-logging,
        ngm:consensus-protocol,
        ngm:digital-certificate,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:network-time-protocol,
        ngm:precision-time-protocol ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:edge-computing,
        ngm:latency,
        ngm:network-synchronization ;
    vc:requires ngm:network-protocol ;
    vc:slug "time-synchronisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:itu-t ;
    vc:supports ngm:blockchain,
        ngm:industrial-automation,
        ngm:real-time .

ngm:turtle a owl:Class ;
    rdfs:label "Turtle"@en ;
    rdfs:comment "Turtle (Terse RDF Triple Language) is a W3C-standardised serialisation syntax for expressing RDF graphs in a compact, human-readable plain-text form. It extends Notation3 (N3) by providing a concise prefix-based shorthand for IRIs, support for blank nodes, and literal datatypes, enabling structured linked-data documents to be authored and exchanged without the verbosity of RDF/XML."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:namespace ],
        ngm:data-serialization ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:json-data-interchange-format,
        ngm:xml ;
    vc:enables ngm:ontology-engineering,
        ngm:semantic-web-linked-data-standard,
        ngm:triple-store ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:rdf-data-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:json-data-interchange-format-ld,
        ngm:n-quads,
        ngm:n-triples,
        ngm:rdf,
        ngm:rdf-xml,
        ngm:sparql ;
    vc:requires ngm:namespace,
        ngm:unicode ;
    vc:slug "turtle" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:knowledge-graph,
        ngm:linked-data,
        ngm:shacl ;
    vc:uses ngm:iri,
        ngm:owl .

ngm:volumetric-capture a owl:Class ;
    rdfs:label "Volumetric Capture"@en ;
    rdfs:comment "Volumetric Capture is the acquisition process that records a subject or environment in three spatial dimensions over time, using arrays of cameras, depth sensors, structured-light projectors, or LiDAR to produce a fully navigable 4D (space + time) representation. The captured data — typically as dense point-cloud sequences, multi-view video, or neural radiance fields — can be rendered from any arbitrary viewpoint and replayed freely in time, enabling photorealistic holographic telepresence, immersive sports and entertainment broadcasting, and real-time digital-twin creation. It sits at the convergence of photogrammetry, computer vision, and real-time graphics pipelines, demanding tightly calibrated hardware rigs and specialised compression and streaming infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-compression ],
        ngm:photogrammetry ;
    vc:bridgesTo ngm:gaussian-splatting,
        ngm:machine-learning ;
    vc:contrastsWith ngm:360-video ;
    vc:dependsOn ngm:computer-vision,
        ngm:mesh-reconstruction ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:holographic-telepresence,
        ngm:immersive-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:light-field-display,
        ngm:motion-capture,
        ngm:real-time-rendering ;
    vc:requires ngm:multi-camera-rig,
        ngm:real-time-rendering,
        ngm:video-compression ;
    vc:slug "volumetric-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:mixed-reality,
        ngm:spatial-computing,
        ngm:virtual-production ;
    vc:uses ngm:camera-calibration,
        ngm:depth-sensing,
        ngm:lidar,
        ngm:neural-radiance-field,
        ngm:photogrammetry,
        ngm:point-cloud,
        ngm:structured-light .

ngm:webgpu a owl:Class ;
    rdfs:label "WebGPU"@en ;
    rdfs:comment "WebGPU is a modern web standard and API that exposes the capabilities of contemporary graphics processing units to web applications for both rendering and general-purpose computation. It provides a low-overhead, explicit interface modelled on native APIs such as Vulkan, Metal and Direct3D 12, succeeding WebGL. WebGPU enables high-performance graphics, compute shaders, and GPU-accelerated machine learning directly in the browser."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wgsl ],
        ngm:graphics-api ;
    vc:bridgesTo ngm:vulkan ;
    vc:contrastsWith ngm:vulkan ;
