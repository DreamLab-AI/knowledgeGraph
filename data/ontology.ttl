ngm:liquid-cooling a owl:Class ;
    rdfs:label "Liquid Cooling"@en ;
    rdfs:comment "Liquid cooling is a thermal-management technique that removes heat from compute hardware using a circulating liquid coolant, which has far higher heat capacity than air. Implementations include direct-to-chip cold plates and full immersion in dielectric fluid, both enabling higher power densities and lower energy overhead. It is increasingly essential for cooling dense GPU clusters used in AI training and high-performance computing."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:sustainability ;
    vc:slug "liquid-cooling" ;
    vc:sourceDomain "infrastructure" .

