            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:normalising-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
