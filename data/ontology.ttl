        ngm:self-instruct .

ngm:iso-10218 a owl:Class ;
    rdfs:label "ISO 10218"@en ;
    rdfs:comment "ISO 10218 is a two-part international safety standard published by the International Organisation for Standardisation specifying mandatory requirements for the design, construction, and safeguarding of industrial robots and robotic systems. Part 1 (ISO 10218-1) governs the robot unit itself, requiring manufacturers to implement safety-rated monitored stop, speed and force limitation, workspace monitoring, and control-reliable safety stop circuits before market placement. Part 2 (ISO 10218-2) governs robot system integration into workcells, requiring formal risk assessments per ISO 12100, safety control architecture documentation per ISO 13849 performance levels, and comprehensive declarations of conformity by system integrators. Together the two parts form the normative safety foundation for industrial robotics globally and are the prerequisite for CE marking of robot workcells in European markets under the EU Machinery Directive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-10218-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-integrity-level ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:bridgesTo ngm:ai-safety,
        ngm:autonomous-systems ;
    vc:dependsOn ngm:iso-12100,
        ngm:iso-13849 ;
    vc:enables ngm:ce-marking,
        ngm:collaborative-robot-deployment,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:iso-10218-1,
        ngm:iso-10218-2 ;
    vc:implements ngm:eu-machinery-directive ;
    vc:isPartOf ngm:machinery-safety-standards ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ansi-ria-r15-06,
        ngm:human-robot-interaction,
        ngm:iec-62061,
        ngm:iso-ts-15066,
        ngm:robot-workcell ;
    vc:requires ngm:functional-safety,
        ngm:risk-assessment,
        ngm:safety-integrity-level ;
    vc:slug "iso-10218" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:collaborative-systems-modality-robot,
        ngm:industrial-automation,
        ngm:robot-safety .

