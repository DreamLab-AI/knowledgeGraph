ngm:filecoin a owl:Class ;
    rdfs:label "Filecoin"@en ;
    rdfs:comment "Filecoin is a decentralised storage network and blockchain protocol developed by Protocol Labs that creates a peer-to-peer marketplace for file storage and retrieval, using cryptographic proofs—Proof of Replication (PoRep) and Proof of Spacetime (PoSt)—to verifiably demonstrate that storage providers are dedicating physical disk space to client data over time. Storage providers earn FIL tokens by fulfilling storage deals and continuously proving their commitments on-chain, while clients pay FIL to store data with economic guarantees backed by the provider's staked collateral. Built on top of IPFS (InterPlanetary File System) for content-addressed data retrieval, Filecoin provides the economic incentive layer designed to make decentralised storage commercially viable, and has since expanded via the Filecoin Virtual Machine (FVM) to support programmable storage deals and decentralised autonomous organisations governing shared datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:decentralized-storage ;
    vc:bridgesTo ngm:ai-dataset-management,
        ngm:machine-learning-infrastructure ;
    vc:contrastsWith ngm:arweave,
        ngm:centralised-cloud-storage,
        ngm:storj ;
    vc:enables ngm:data-dao,
        ngm:decentralized-application,
        ngm:nft-storage,
        ngm:web3-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proof-of-work,
        ngm:token-economics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:decentralized-autonomous-organisation,
        ngm:distributed-storage,
        ngm:peer-to-peer-network ;
    vc:requires ngm:cryptographic-proof,
        ngm:smart-contract,
        ngm:staking ;
    vc:slug "filecoin" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:content-addressed-storage,
        ngm:ipfs,
        ngm:libp2p,
        ngm:proof-of-replication,
        ngm:proof-of-spacetime .

ngm:flash-loan a owl:Class ;
    rdfs:label "Flash Loan"@en ;
    rdfs:comment "A flash loan is an uncollateralised loan mechanism in decentralised finance that exists entirely within a single blockchain transaction: the borrower receives an arbitrary amount of an asset, executes arbitrary on-chain operations with it, and repays the loan plus a fee within the same atomic transaction, with the entire sequence reverting if repayment fails. Because atomicity guarantees that funds never leave the lending pool without being returned, no collateral is needed; default is technically impossible since a failed repayment causes the transaction to revert as if the loan never occurred. Flash loans enable capital-efficient arbitrage, liquidation, collateral swaps, and self-liquidation operations that would otherwise require significant upfront capital."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:bridgesTo ngm:algorithmic-trading,
        ngm:financial-derivatives ;
    vc:contrastsWith ngm:collateralised-loan,
        ngm:traditional-unsecured-loan ;
    vc:dependsOn ngm:lending-protocol,
        ngm:price-oracle ;
    vc:enables ngm:arbitrage,
        ngm:collateral-swap,
        ngm:digital-asset-lending,
        ngm:liquidity-provision,
        ngm:mev,
        ngm:self-liquidation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:decentralised-finance,
        ngm:decentralized-exchange,
        ngm:oracle-manipulation,
        ngm:transaction,
        ngm:twap-oracle ;
    vc:requires ngm:blockchain-atomicity,
        ngm:evm-compatible-chain ;
    vc:slug "flash-loan" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-settlement,
        ngm:callback-function,
        ngm:evm-transaction,
        ngm:liquidity-pool,
        ngm:smart-contract,
        ngm:smart-contract-execution .

ngm:gas-fee a owl:Class ;
    rdfs:label "Gas Fee"@en ;
    rdfs:comment "A gas fee is the payment a user must make to compensate the network validators or miners for the computational resources consumed when processing a transaction or executing a smart contract on a blockchain. On Ethereum-compatible networks, 'gas' is an abstract unit measuring the computational effort required by an operation; the fee is calculated as gas units consumed multiplied by a price per unit (the gas price), denominated in the network's native currency. Following EIP-1559 on Ethereum, gas fees split into a protocol-set base fee — which is burned, permanently removing supply — and an optional priority tip paid directly to the block proposer. Gas fees serve the dual purpose of economically compensating validators and acting as a spam-prevention mechanism by making resource-intensive computation costly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:native-token ],
        ngm:transaction-fee ;
    vc:bridgesTo ngm:mechanism-design,
        ngm:microeconomics,
        ngm:tokenomics ;
    vc:contrastsWith ngm:feeless-blockchain,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:gas-limit,
        ngm:gas-price,
        ngm:network-congestion ;
    vc:enables ngm:block-production,
        ngm:spam-prevention,
        ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-1559 ;
    vc:isPartOf ngm:blockchain-network,
        ngm:ethereum ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:base-fee,
        ngm:miner-extractable-value,
        ngm:priority-fee ;
    vc:requires ngm:consensus-mechanism,
        ngm:native-token ;
    vc:slug "gas-fee" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:layer-2-scaling,
        ngm:non-fungible-token ;
    vc:uses ngm:mempool,
        ngm:smart-contract .

ngm:git a owl:Class ;
    rdfs:label "Git"@en ;
    rdfs:comment "Git is a distributed version control system that tracks changes to files and coordinates work across multiple contributors. It was created by Linus Torvalds for Linux kernel development and has become the dominant source-control system in modern software engineering."@en ;
