    vc:supports ngm:anti-money-laundering .

ngm:bid-ask-spread a owl:Class ;
    rdfs:label "Bid Ask Spread"@en ;
    rdfs:comment "The bid-ask spread is the difference between the highest price a buyer is willing to pay (the bid) and the lowest price a seller will accept (the ask) for an asset at a given moment. It is a core measure of market liquidity and an implicit transaction cost borne by traders who cross the spread. Narrow spreads indicate liquid, competitive markets, while wide spreads reflect thin liquidity, volatility, or elevated risk for liquidity providers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:price-discovery ],
        ngm:market-microstructure ;
    vc:bridgesTo ngm:finance ;
    vc:dependsOn ngm:liquidity ;
    vc:enables ngm:liquidity,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
