        <urn:visionflow:linked:consent-mechanism>,
        <urn:visionflow:linked:identity-evidence>,
        <urn:visionflow:linked:trusted-issuer> ;
    vc:slug "identity-verification" ;
    vc:sourceDomain "security" .

