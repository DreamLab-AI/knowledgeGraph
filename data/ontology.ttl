ngm:mathematical-logic a owl:Class ;
    rdfs:label "Mathematical Logic"@en ;
    rdfs:comment "Mathematical logic is the branch of mathematics that studies formal systems, proof, computability and the foundations of mathematics using rigorous symbolic methods. It encompasses subfields such as model theory, proof theory, set theory and recursion theory, and provides the formal underpinnings for reasoning about truth, provability and decidability. Mathematical logic is foundational to theoretical computer science, automated reasoning and the formal semantics of programming languages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-science ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:set-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference ],
        ngm:logic ;
    vc:contrastsWith ngm:machine-learning ;
    vc:dependsOn ngm:logic,
        ngm:set-theory ;
    vc:enables ngm:automated-reasoning,
        ngm:formal-methods,
        ngm:theorem-proving ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:inference,
        ngm:set-theory ;
    vc:isPartOf ngm:computer-science,
        ngm:logic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inference,
        ngm:knowledge-base ;
    vc:requires ngm:computer-science ;
    vc:slug "mathematical-logic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:description-logic,
        ngm:knowledge-representation ;
    vc:uses ngm:inference,
        ngm:reasoning .

ngm:meta-learning a owl:Class ;
    rdfs:label "Meta-Learning"@en ;
    rdfs:comment "Meta-Learning, colloquially described as 'learning to learn', is the study and design of machine learning systems that improve their own learning algorithms or initialisation through experience across multiple tasks, enabling rapid adaptation to new tasks with minimal data. Rather than learning a task directly, a meta-learning algorithm learns a prior or inductive bias that facilitates fast generalisation. Key paradigms include model-agnostic meta-learning (MAML), which optimises for a parameter initialisation that is close to good solutions for many tasks, and metric-based approaches such as prototypical networks that learn a task-agnostic embedding space. Meta-learning is central to few-shot learning, continual learning, and automated machine learning research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:drug-discovery,
        ngm:large-language-model ;
    vc:contrastsWith ngm:reinforcement-learning,
        ngm:supervised-learning ;
    vc:enables ngm:automated-machine-learning,
        ngm:continual-learning,
        ngm:few-shot-learning,
        ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-agnostic-meta-learning,
        ngm:prototypical-networks ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:in-context-learning,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:requires ngm:gradient-descent,
        ngm:training-dataset ;
    vc:slug "meta-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:neural-network .

ngm:mi-ca-regulation a owl:Class ;
    rdfs:label "MiCA Regulation"@en ;
    rdfs:comment "The Markets in Crypto-Assets (MiCA) Regulation (EU 2023/1114) is the European Union's comprehensive legislative framework governing the issuance, offering, and trading of crypto-assets, including asset-referenced tokens, e-money tokens, and utility tokens. Adopted in June 2023 and phasing in through December 2024, MiCA establishes authorisation requirements for crypto-asset service providers (CASPs), disclosure obligations analogous to prospectus rules, and prudential standards for stablecoin issuers, creating the world's first complete statutory crypto-asset regime across a major economic bloc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        ngm:financial-regulation ;
    vc:contrastsWith ngm:digital-regulation,
        ngm:securities-regulation ;
    vc:enables ngm:digital-asset-market,
        ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analytics,
        ngm:blockchain-compliance,
        ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:ethereum-smart-contract-platform,
        ngm:stablecoin-regulation ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:compliance-framework,
        ngm:regulatory-compliance ;
    vc:slug "mi-ca-regulation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-commission,
        ngm:regulatory-framework .

ngm:modular-arithmetic a owl:Class ;
    rdfs:label "Modular Arithmetic"@en ;
    rdfs:comment "Modular arithmetic performs integer arithmetic that wraps around a fixed modulus, so numbers are treated as equivalent if they differ by a multiple of that modulus."@en ;
