ngm:embeddings a owl:Class ;
    rdfs:label "Embeddings"@en ;
    rdfs:comment "Embeddings are dense, low-dimensional vector representations of discrete objects—words, sentences, images, code, graphs, or arbitrary entities—learned by neural networks such that geometric relationships in the vector space correspond to semantic or functional relationships between the original objects. The core property is that semantically similar inputs map to nearby vectors, enabling tasks like similarity search, clustering, and retrieval to be performed as efficient geometric operations. Embeddings are the foundational representation layer of modern deep learning, underpinning language models, recommendation systems, search engines, and retrieval-augmented generation pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-prompt-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:machine-learning-technique ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-model,
        ngm:soft-prompt-embedding,
        ngm:token-embedding ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "embeddings" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:natural-language-processing,
        ngm:transformer .

ngm:erc-721 a owl:Class ;
    rdfs:label "ERC-721"@en ;
    rdfs:comment "ERC-721 is the Ethereum token standard that defines the interface for non-fungible tokens (NFTs), where each token is uniquely identified by a uint256 token ID and an associated owner address recorded on-chain. Unlike ERC-20 fungible tokens, which are interchangeable, each ERC-721 token is distinct and cannot be exchanged equivalently for another. The standard defines a minimal interface including ownership transfer, approval delegation, and balance queries, plus an optional metadata extension that associates each token with a URI resolving to off-chain JSON metadata including name, description, and image. ERC-721 is the foundational standard for digital art, collectibles, gaming items, and tokenised real-world assets on Ethereum."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:nft-marketplace,
        ngm:nft-minting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:erc-20,
        ngm:nft,
        ngm:token-standard ;
    vc:slug "erc-721" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:extended-reality-xr a owl:Class ;
    rdfs:label "Extended Reality (XR)"@en ;
    rdfs:comment "Umbrella term encompassing all immersive technologies including Augmented Reality (AR), Virtual Reality (VR), and Mixed Reality (MR), representing the full spectrum from entirely physical to entirely virtual environments and all hybrid states between."@en ;
