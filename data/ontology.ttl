    vc:uses ngm:machine-learning-discipline .
ngm:ai-assisted-ontology-elicitation-method a owl:Class ;
    rdfs:comment "A structured methodology for collaboratively building and refining formal knowledge representations by conducting iterative dialogues with AI systems. In these conversations, AI agents interpret, critique, and extend ontological schemas, producing machine-readable linked-data artefacts such as OWL classes and JSON-LD graphs that document both the resulting ontology and the reasoning process that produced it."@en ;
    rdfs:label "AI-Assisted Ontology Elicitation Method"@en ;
    rdfs:subClassOf ngm:software-engineering ;
    vc:enables ngm:interoperability ;
