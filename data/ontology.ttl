ngm:shamir-secret-sharing a owl:Class ;
    rdfs:label "Shamir Secret Sharing"@en ;
    rdfs:comment "Shamir secret sharing splits a secret into shares so that any threshold number of them reconstructs it while fewer reveal nothing, using polynomial interpolation over a finite field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:modular-arithmetic ],
        ngm:cryptography-domain ;
