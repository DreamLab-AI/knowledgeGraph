ngm:force-sensor a owl:Class ;
    rdfs:comment "A force sensor is a transducer that measures the magnitude (and sometimes direction) of an applied mechanical force or torque, typically by converting strain in an elastic element into an electrical signal. Single-axis load cells and multi-axis force-torque sensors give robots haptic awareness of contact and interaction forces. Such measurements are essential for compliant manipulation, assembly, and safe physical human-robot interaction."@en ;
    rdfs:label "Force Sensor"@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control ;
    vc:relatedTo ngm:hydraulic-actuator ;
    vc:slug "force-sensor" ;
    vc:sourceDomain "robotics" .
ngm:force-to-motion-mapping a skos:Concept ;
    rdfs:label "Force To Motion Mapping"@en .
ngm:force-torque-control a owl:Class ;
    rdfs:comment "Force-torque control is a robot control strategy that regulates the contact forces and moments a manipulator exerts on its environment, rather than commanding position alone. It uses force-torque sensing, typically at the wrist or in the joints, within a feedback loop so that the robot can maintain a desired contact force or yield compliantly to external loads. This is essential for tasks involving physical contact, such as assembly, polishing, and safe interaction with people."@en ;
    rdfs:label "Force Torque Control"@en ;
    rdfs:subClassOf ngm:force-control ;
    rdfs:subClassOf _:r10668 ;
    rdfs:subClassOf _:r10669 ;
