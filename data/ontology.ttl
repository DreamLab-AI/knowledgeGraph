ngm:quorum-system a owl:Class ;
    rdfs:label "Quorum System"@en ;
    rdfs:comment "A quorum system is a collection of subsets of a distributed set of replicas, where any two subsets are guaranteed to intersect, used to coordinate read and write operations so that consistency is preserved despite failures. By requiring operations to gather acknowledgements from a quorum rather than every replica, the system tolerates a bounded number of faulty or unreachable nodes while still ensuring that conflicting operations observe one another. Quorum systems are foundational to distributed consensus, replicated databases, and Byzantine fault-tolerant protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:distributed-consensus ;
    vc:bridgesTo ngm:fault-tolerance ;
    vc:contrastsWith ngm:raft-consensus ;
    vc:enables ngm:byzantine-fault-tolerant-system,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism ;
    vc:isPartOf ngm:distributed-consensus,
        ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-consensus,
        ngm:voting-mechanism ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:fault-tolerance ;
    vc:slug "quorum-system" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:pbft,
        ngm:raft-consensus ;
    vc:uses ngm:voting-mechanism .

ngm:rabbitmq a owl:Class ;
    rdfs:label "Rabbitmq"@en ;
    rdfs:comment "RabbitMQ is an open-source message broker that implements the Advanced Message Queuing Protocol (AMQP) and related messaging standards, routing messages between producers and consumers through exchanges, bindings, and queues. It supports flexible routing topologies, message acknowledgement, durability, and clustering for high availability. RabbitMQ is widely used to decouple services and enable reliable asynchronous communication in distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reliability ],
        ngm:message-broker ;
    vc:contrastsWith ngm:apache-kafka ;
    vc:enables ngm:asynchronous-messaging,
