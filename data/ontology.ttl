ngm:data-sovereignty a owl:Class ;
    rdfs:label "Data Sovereignty"@en ;
    rdfs:comment "Data sovereignty is the legal and political principle that digital data is subject to the laws, governance structures, and enforcement jurisdiction of the nation, region, or community in which it originates or is processed. It encompasses requirements such as data localisation (mandating that data remain physically within specified geographic boundaries), restrictions on cross-border data flows, and the right of governments or communities to compel access for regulatory, security, or cultural-preservation purposes. Data sovereignty directly shapes cloud architecture decisions, AI training dataset curation, federated system design, and multinational data-sharing agreements. It intersects with — yet is conceptually distinct from — privacy rights, data protection law, and cybersecurity, being principally concerned with jurisdictional control rather than individual rights."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:data-governance ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:cloud-portability,
        ngm:data-free-flow ;
    vc:dependsOn ngm:data-residency,
        ngm:encryption ;
    vc:enables ngm:indigenous-data-sovereignty,
        ngm:national-ai-strategy,
        ngm:sovereign-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-protection,
        ngm:gdpr ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:cross-border-data-flows,
        ngm:cybersecurity ;
    vc:requires ngm:data-localisation,
        ngm:jurisdiction,
        ngm:regulatory-compliance ;
    vc:slug "data-sovereignty" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-27701 ;
    vc:supports ngm:digital-autonomy,
        ngm:national-security,
        ngm:privacy ;
    vc:uses ngm:confidential-computing,
        ngm:federated-learning,
        ngm:homomorphic-encryption .

ngm:data-storage a owl:Class ;
    rdfs:label "Data Storage"@en ;
    rdfs:comment "Data storage encompasses the systems, technologies, and architectures used to capture, retain, and retrieve digital information for ongoing and future use. It includes file, block, and object storage paradigms alongside the hardware and software infrastructure ensuring data persistence, accessibility, availability, and protection against loss or corruption."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:cloud-computing,
        ngm:distributed-file-system ;
    vc:contrastsWith ngm:in-memory-computing ;
    vc:enables ngm:backup-and-recovery,
        ngm:data-analytics,
        ngm:data-persistence,
        ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:block-storage,
        ngm:file-storage,
        ngm:network-attached-storage,
        ngm:object-storage,
        ngm:storage-area-network ;
    vc:implements ngm:data-encryption-at-rest,
        ngm:data-redundancy,
        ngm:storage-architecture ;
    vc:isPartOf ngm:data-centre-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:file-system,
        ngm:storage-media ;
    vc:slug "data-storage" ;
    vc:sourceDomain "infrastructure" ;
