ngm:synthetic-data a owl:Class ;
    rdfs:label "Synthetic Data"@en ;
    rdfs:comment "Synthetic data is algorithmically generated content that preserves the statistical properties, distributional characteristics, and structural patterns of real-world datasets without containing actual personal or proprietary records. It is produced using techniques such as generative adversarial networks, variational autoencoders, diffusion models, rule-based simulators, and statistical resampling methods. Synthetic data serves to augment scarce or imbalanced training corpora, enable privacy-compliant data sharing under regulations such as GDPR, and stress-test machine-learning pipelines with rare, hazardous, or counterfactual edge-case scenarios. Quality is typically benchmarked via fidelity metrics such as Fréchet Inception Distance, train-on-synthetic-test-on-real accuracy, and statistical divergence measures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:digital-twin,
        ngm:simulation-environment ;
    vc:contrastsWith ngm:anonymisation,
        ngm:real-world-data ;
    vc:dependsOn ngm:data-pipeline,
        ngm:model-evaluation ;
    vc:enables ngm:data-augmentation,
        ngm:federated-learning,
        ngm:model-training,
        ngm:privacy-preserving-machine-learning,
        ngm:sim-to-real-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:bias-in-ai,
        ngm:data-governance,
        ngm:differential-privacy,
        ngm:machine-learning-discipline ;
    vc:requires ngm:generative-model,
        ngm:statistical-distribution ;
    vc:slug "synthetic-data" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-system,
        ngm:drug-discovery,
        ngm:robotics ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:large-language-model,
        ngm:variational-autoencoder .

ngm:text-to-image a owl:Class ;
    rdfs:label "Text-to-Image"@en ;
    rdfs:comment "A generative AI capability that synthesises visual imagery from natural language textual descriptions. Systems such as diffusion models iteratively denoise latent representations conditioned on text embeddings, enabling creation of photorealistic and artistic images from prompts without requiring explicit pixel-level instructions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
