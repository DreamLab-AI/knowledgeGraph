ngm:target-tracking a owl:Class ;
    rdfs:comment "Target tracking is a computational and signal-processing discipline concerned with estimating the state — typically position, velocity, and orientation — of one or more moving objects over time from sequences of noisy sensor observations. It encompasses algorithms such as Kalman filters, particle filters, and multi-hypothesis trackers, applied across radar, sonar, computer vision, and LiDAR modalities. Applications span aerospace surveillance, autonomous vehicle perception, robotic manipulation, sports analytics, and augmented reality. Modern deep-learning-based trackers jointly perform detection and tracking, achieving robust performance in complex, cluttered environments."@en ;
    rdfs:label "Target Tracking"@en ;
    rdfs:subClassOf ngm:object-detection-and-tracking ;
    vc:enables ngm:anomaly-detection ;
