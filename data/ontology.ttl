ngm:shared-virtual-world a owl:Class ;
    rdfs:label "Shared Virtual World"@en ;
    rdfs:comment "A persistent, synchronous three-dimensional digital environment where unlimited users interact simultaneously through avatars, featuring continuous data persistence for identity, assets, and social relationships across sessions while supporting real-time rendering and cross-platform access."@en ;
