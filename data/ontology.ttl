    vc:slug "etsi-domain-ai-data-mgmt" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-human-interface-ux a owl:Class ;
    rdfs:label "ETSI_Domain_Human_Interface___UX"@en ;
    rdfs:comment "An ETSI subdomain focusing on user experience design, usability engineering, and interaction paradigms optimising satisfaction, efficiency, and accessibility in immersive digital environments. It covers design principles, usability testing, accessibility compliance, inclusive UX design, and AI-driven adaptive interfaces aligned with ISO 9241-110 dialogue principles and ETSI GR ARF 010 specifications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-experience,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:etsi-domain-human-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inclusive-xr-design ;
    vc:requires ngm:accessibility-standards,
        ngm:virtual-environment ;
    vc:slug "etsi-domain-human-interface-ux" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-immersive a owl:Class ;
    rdfs:label "Etsi Domain Immersive"@en ;
    rdfs:comment "The ETSI technical domain addressing standardisation of immersive technologies including virtual reality, augmented reality, and mixed reality systems, encompassing network requirements, quality of experience metrics, and interoperability specifications for XR applications."@en ;
    rdfs:subClassOf ngm:etsi,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:interoperability-standard,
        ngm:metaverse-classification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:extended-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:slug "etsi-domain-immersive" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:etsi-domain-immersive-experiences .

ngm:etsi-domain-infrastructure a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure"@en ;
    rdfs:comment "An ETSI governance domain governing the foundational systems, networks, and computational resources enabling Metaverse platforms at scale. It encompasses network infrastructure, cloud and edge computing, data centres, content delivery, latency management, and hardware abstraction, providing reliable, performant, and secure technical foundations for distributed virtual environment operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:networking-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network-cdn ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency-management-protocol ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-architecture-stack,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-delivery-network-cdn,
        ngm:edge-computing,
        ngm:latency-management-protocol,
        ngm:networking-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-infrastructure-data,
        ngm:etsidomain-classification ;
    vc:slug "etsi-domain-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-reality-capture a owl:Class ;
    rdfs:label "ETSI_Domain_Reality_Capture"@en ;
    rdfs:comment "An ETSI standardisation domain enabling digital reconstruction of physical environments and objects through 3D scanning, photogrammetry, sensor fusion, depth sensing, and motion capture to create semantically labelled digital twins for metaverse and immersive applications. Governed by ETSI GS ARF 004-6 and GR ARF 010, this domain defines interoperability requirements for real-time mesh generation, volumetric video coding (ISO V3C/V-PCC), and integration with scene management and digital twin platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture-rig ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:photogrammetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reality-capture-system ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:motion-capture-rig,
        ngm:photogrammetry,
        ngm:reality-capture-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "etsi-domain-reality-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:lidar,
        ngm:point-cloud .

ngm:evaluation-layer a owl:Class ;
    rdfs:label "Evaluation Layer"@en ;
    rdfs:comment "The Evaluation Layer is the cross-cutting stratum that measures the quality, safety, and performance of system components against defined criteria. It sits alongside training and inference, drawing on their outputs to produce judgements that feed governance and research strata. It contains benchmarks, metrics, test harnesses, and the scoring procedures that quantify behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-layer ],
        ngm:owl-thing ;
    vc:enables ngm:governance-layer,
        ngm:research-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:inference-layer,
        ngm:model-layer ;
    vc:slug "evaluation-layer" ;
    vc:sourceDomain "evaluation" .

ngm:event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A significant occurrence at a specific point in time that represents a change in system state, triggers a process, or carries information between components."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud,
        ngm:temporal-entity ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:complex-event-processing,
        ngm:event-sourcing,
        ngm:reactive-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "event" ;
    vc:sourceDomain "infrastructure" .

ngm:event-streaming a owl:Class ;
    rdfs:label "Event Streaming"@en ;
    rdfs:comment "Event streaming is a data-processing paradigm in which records of events are captured, stored as an ordered, append-only log, and continuously delivered to consumers in real time. Platforms such as Apache Kafka and Pulsar implement it to decouple producers from consumers and enable scalable, replayable data pipelines. It underpins real-time analytics, event-driven microservices, and the ingestion side of modern data architectures."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:message-broker,
        ngm:metadata-management ;
    vc:slug "event-streaming" ;
    vc:sourceDomain "data" .

ngm:excalidraw a owl:Class ;
    rdfs:label "Excalidraw"@en ;
    rdfs:comment "Excalidraw is an open-source, browser-based collaborative whiteboard and diagramming application characterised by its distinctive hand-drawn visual aesthetic, which renders all shapes, lines, and text in a sketchy style designed to encourage low-fidelity ideation rather than polished production diagrams. The tool stores diagrams in a human-readable JSON format and supports real-time multiplayer collaboration, end-to-end encrypted sharing, and an extensive library of reusable shapes, making it widely used for software architecture sketching, workshop facilitation, and technical communication."@en ;
    rdfs:subClassOf ngm:collaborative-whiteboard ;
    vc:enables ngm:ai-diagram-tools,
        ngm:shared-whiteboards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:human-computer-interface,
        ngm:knowledge-graph ;
    vc:slug "excalidraw" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diagrams-as-code,
        ngm:open-source-software .

ngm:execution-model a owl:Class ;
    rdfs:label "Execution Model"@en ;
    rdfs:comment "An execution model is the abstract specification of how a computing system interprets, schedules, and carries out instructions or computations, defining the rules governing ordering, concurrency, memory access, and resource allocation. It forms the semantic foundation atop which programming languages, runtimes, and hardware platforms are designed, ensuring consistent and predictable behaviour across implementations."@en ;
    rdfs:subClassOf ngm:programming-paradigm ;
    vc:enables ngm:runtime-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:slug "execution-model" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:software-architecture ;
    vc:uses ngm:compiler,
        ngm:virtual-machine .

ngm:existential-ai-risk a owl:Class ;
    rdfs:label "Existential AI Risk"@en ;
    rdfs:comment "Existential AI risk is the possibility that advanced artificial intelligence could cause human extinction or a permanent, drastic curtailment of humanity's potential. It is a focus of long-term AI safety research and policy debate."@en ;
    rdfs:subClassOf ngm:existential-risk ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "existential-ai-risk" ;
    vc:sourceDomain "ai-safety" .

ngm:exoskeleton a owl:Class ;
    rdfs:label "Exoskeleton"@en ;
    rdfs:comment "An exoskeleton is a wearable robotic structure that augments or supports human movement by applying forces in parallel with the wearer's limbs, used for assistance, rehabilitation and load support."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:exoskeleton-robot ;
    vc:enables ngm:assistive-robotics,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:sensor-fusion ;
    vc:slug "exoskeleton" ;
    vc:sourceDomain "robotics" .

ngm:experience-layer a owl:Class ;
    rdfs:label "Experience Layer"@en ;
    rdfs:comment "User-facing architectural layer responsible for rendering immersive content, managing user interactions, and delivering cohesive UX/UI across metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interaction-manager ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-interface ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience,
        ngm:natural-interaction,
        ngm:presence,
        ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:immersive-interface,
        ngm:interaction-manager,
        ngm:presence-system,
        ngm:rendering-engine,
        ngm:ux-framework ;
    vc:isPartOf ngm:compute-layer,
        ngm:user-interface-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:audio-system,
        ngm:graphics-pipeline,
        ngm:haptic-feedback,
        ngm:input-system ;
    vc:slug "experience-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:experiment-tracking a owl:Class ;
    rdfs:label "Experiment Tracking"@en ;
    rdfs:comment "Experiment tracking is the practice of recording the configuration, code, data, and results of machine learning experiments so they can be compared and reproduced. It is a part of MLOps."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:mlops ;
    vc:enables ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:model-training ;
    vc:slug "experiment-tracking" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:export-controls a owl:Class ;
    rdfs:label "Export Controls"@en ;
    rdfs:comment "Export controls are government-imposed legal restrictions on the cross-border transfer of specified goods, software, technology, and technical knowledge, typically for national-security, foreign-policy, or non-proliferation reasons. In the AI domain they increasingly govern advanced semiconductors, high-performance compute, and associated design tools, restricting which jurisdictions and entities may receive cutting-edge hardware. Compliance regimes such as the US EAR and the Wassenaar Arrangement define controlled-item lists, licensing requirements, and end-use screening."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:competition-in-ai ;
    vc:slug "export-controls" ;
    vc:sourceDomain "governance" .

ngm:extended-producer-responsibility a owl:Class ;
    rdfs:label "Extended Producer Responsibility"@en ;
    rdfs:comment "Extended Producer Responsibility (EPR) is an environmental policy principle that makes manufacturers financially and operationally responsible for the entire lifecycle of their products, especially the take-back, recycling, and final disposal stages. By internalising end-of-life costs, EPR incentivises producers to design for durability, repairability, and recyclability. It is implemented through schemes such as packaging levies, electronic-waste recovery obligations, and deposit-return systems."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:sustainability ;
    vc:slug "extended-producer-responsibility" ;
    vc:sourceDomain "governance" .

ngm:facial-action-coding-system a owl:Class ;
    rdfs:label "Facial Action Coding System"@en ;
    rdfs:comment "The Facial Action Coding System (FACS) is a comprehensive taxonomy for describing visible facial movements by decomposing expressions into discrete Action Units, each corresponding to the activation of one or more facial muscles. Developed by Ekman and Friesen, it provides an objective, anatomically grounded vocabulary that maps muscle activity to coded units independent of emotional interpretation. FACS is widely used in affective computing, animation, and behavioural research to detect and synthesise facial expressions."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
