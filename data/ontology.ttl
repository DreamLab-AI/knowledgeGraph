    vc:slug "lies-damn-lies-and-statistics" ;
    vc:sourceDomain "infrastructure" .

ngm:lime a owl:Class ;
    rdfs:label "LIME"@en ;
    rdfs:comment "Local Interpretable Model-agnostic Explanations, a technique that explains individual predictions of any machine learning model by fitting a simple interpretable model to perturbed samples around the instance of interest."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:model-interpretability ;
    vc:enables ngm:explainable-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:machine-learning ;
    vc:slug "lime" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:limited-risk-ai a owl:Class ;
    rdfs:label "Limited Risk AI"@en ;
    rdfs:comment "Under the EU AI Act (Article 50), Limited Risk AI denotes systems subject only to transparency obligations—primarily chatbots and deepfake generators—where providers must inform users they are interacting with AI or label synthetic content as artificially generated. These systems face no conformity assessment, but non-compliance attracts fines of up to €7.5 million or 1.5% of global annual turnover."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:bias ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance,
        ngm:regulatory-framework ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:generative-ai,
        ngm:synthetic-media ;
    vc:requires ngm:transparency ;
    vc:slug "limited-risk-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:linear a owl:Class ;
    rdfs:label "Linear"@en ;
    rdfs:comment "Linear refers to relationships, mappings or systems whose output is proportional to and additive in their input, a property exploited heavily in graphics colour spaces and numerical methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
