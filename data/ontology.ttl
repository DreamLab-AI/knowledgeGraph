ngm:fatf-travel-rule a owl:Class ;
    rdfs:label "FATF Travel Rule"@en ;
    rdfs:comment "The FATF Travel Rule (Recommendation 16 extended to virtual assets) requires Virtual Asset Service Providers (VASPs) to collect, verify, and transmit originator and beneficiary identity information alongside cryptocurrency transactions that meet or exceed a jurisdictional threshold, typically USD/EUR 1,000. Issued by the Financial Action Task Force, it extends the longstanding wire-transfer obligation — rooted in the FATF 40 Recommendations and aligned with SWIFT messaging norms — to crypto-asset transfers, obligating sending VASPs to share identifying data with receiving VASPs before or simultaneously with the transfer. Compliance demands interoperability protocols, counterparty discovery infrastructure, and shared data standards such as IVMS 101 between exchanges, custodians, and wallet providers across different jurisdictions. The rule has been progressively transposed into national and regional law, including the EU Transfer of Funds Regulation, UK Money Laundering Regulations, and Singapore Payment Services Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ivms-101 ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credential-vc,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:decentralised-exchange,
        ngm:privacy-coin,
        ngm:wallet ;
    vc:enables ngm:financial-intelligence,
        ngm:transaction-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fatf-recommendation-16 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bc-0456-virtual-asset-service-providers,
        ngm:compliance-framework,
        ngm:sanctions-screening,
        ngm:transfer-of-funds-regulation,
        ngm:virtual-asset ;
    vc:requires ngm:anti-money-laundering,
        ngm:digital-identity,
        ngm:ivms-101,
        ngm:know-your-customer ;
    vc:slug "fatf-travel-rule" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:fatf,
        ngm:financial-action-task-force ;
    vc:uses ngm:public-key-infrastructure,
        ngm:travel-rule-protocol,
        ngm:trisa .

ngm:fido2 a owl:Class ;
    rdfs:label "FIDO2"@en ;
    rdfs:comment "FIDO2 is an open authentication standard developed by the FIDO Alliance and W3C that enables passwordless, phishing-resistant authentication using public-key cryptography. It consists of two components: the W3C Web Authentication API (WebAuthn), which defines the browser and platform interface for creating and using public key credentials, and the Client to Authenticator Protocol (CTAP2), which defines the communication between a platform and an external authenticator such as a hardware security key or passkey-capable device. FIDO2 credentials are bound to a specific relying party origin, making them immune to phishing, and private keys never leave the authenticator device, eliminating the credential theft risk associated with password databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-authn ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:relying-party ],
        ngm:authentication-standards ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:digital-identity-wallet ;
    vc:contrastsWith ngm:authentication,
        ngm:password-authentication ;
    vc:enables ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:passkey,
        ngm:passwordless-authentication,
        ngm:phishing-resistant-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:web-authn ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:identity-management,
        ngm:trusted-platform-module,
        ngm:zero-trust-architecture ;
    vc:requires ngm:relying-party,
        ngm:verification ;
    vc:slug "fido2" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance,
        ngm:w3-c ;
    vc:uses ngm:challenge-response-protocol,
        ngm:digital-signature,
        ngm:hardware-security-module,
        ngm:public-key-cryptography,
        ngm:web-standard .

ngm:formal-methods a owl:Class ;
    rdfs:label "Formal Methods"@en ;
    rdfs:comment "Formal methods are mathematically rigorous techniques for the specification, development, and verification of software and hardware systems. They use formal logic, set theory, and automata to express system requirements precisely and to prove that an implementation satisfies them. In blockchain and smart-contract engineering, formal methods are applied to prove the absence of classes of bugs and to guarantee that contract behaviour matches its intended specification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:theorem-proving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-checking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:formal-specification ],
        ngm:formal-verification ;
    vc:bridgesTo ngm:program-analysis,
        ngm:smart-contract ;
    vc:dependsOn ngm:mathematical-logic ;
    vc:enables ngm:formal-verification,
        ngm:program-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:formal-specification,
        ngm:model-checking,
        ngm:theorem-proving ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:formal-verification ;
    vc:slug "formal-methods" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:smart-contract,
        ngm:type-system ;
    vc:uses ngm:mathematical-logic,
        ngm:temporal-logic .

ngm:gs-1-standards a owl:Class ;
    rdfs:label "GS1 Standards"@en ;
    rdfs:comment "GS1 Standards constitute a globally adopted, open framework of identification keys, data carriers (barcodes and RFID tags), and messaging formats that uniquely and unambiguously identify physical and digital entities — products, logistics units, locations, assets, and services — across entire supply chain ecosystems. Governed by GS1, a neutral non-profit organisation with national member organisations in over 115 countries, the standards define how identifiers are structured (e.g. GTIN, GLN, SSCC), how they are encoded for machine reading (EAN/UPC, GS1-128, QR, DataMatrix, EPC/RFID), and how master and transactional data are shared between trading partners via EDI and web services. GS1 Standards form the interoperability backbone of global retail, healthcare, logistics, foodservice, and increasingly digital product passport and IoT applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gs1-digital-link ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standards ],
        ngm:standards ;
    vc:bridgesTo ngm:linked-data,
        ngm:semantic-web-linked-data-standard,
        ngm:verifiable-credentials ;
    vc:enables ngm:digital-product-passport,
        ngm:inventory-management,
        ngm:supply-chain,
        ngm:traceability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:global-location-number,
        ngm:global-trade-item-number,
        ngm:gs1-digital-link,
        ngm:serial-shipping-container-code ;
    vc:implements ngm:electronic-data-interchange,
        ngm:gs1-epcis ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:iso-standards,
        ngm:synchronisation ;
    vc:requires ngm:data-governance,
        ngm:open-standards ;
    vc:slug "gs-1-standards" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:gs1 ;
    vc:supports ngm:internet-of-things,
        ngm:interoperability,
        ngm:regulatory-compliance ;
    vc:uses ngm:barcode,
        ngm:qr-code,
        ngm:rfid .

ngm:hardware-abstraction-layer a owl:Class ;
    rdfs:label "Hardware Abstraction Layer"@en ;
    rdfs:comment "A Hardware Abstraction Layer (HAL) is a software layer that presents a uniform, hardware-independent interface to upper software layers — operating systems, middleware, or application code — while encapsulating the vendor-specific, register-level details of physical devices in the implementation beneath it. By isolating hardware dependencies behind a stable API, the HAL enables the same kernel or application binary to run on different processor architectures, microcontroller families, or peripheral configurations without source-code changes. HALs appear throughout the software stack: in embedded microcontroller SDKs (STM32 HAL, Arduino abstraction), in operating-system kernels (Windows HAL.dll), in robotic middleware (ROS Hardware Interface), and in graphics stacks (Vulkan's hardware abstraction over GPU vendors). The HAL pattern is a foundational principle of portable, maintainable system software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:application-programming-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:driver-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:device-drivers ],
        ngm:hardware-abstraction ;
    vc:bridgesTo ngm:graphics-api,
        ngm:middleware ;
    vc:contrastsWith ngm:bare-metal-programming ;
    vc:dependsOn ngm:architecture,
        ngm:system-on-chip ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:operating-system,
        ngm:platform-independence,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:application-programming-interface,
        ngm:device-drivers ;
    vc:implements ngm:architecture,
        ngm:separation-of-concerns ;
    vc:isPartOf ngm:embedded-systems,
        ngm:operating-system ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:middleware ;
    vc:requires ngm:driver-software,
        ngm:firmware ;
    vc:slug "hardware-abstraction-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:gpu-compute,
        ngm:real-time-operating-system,
        ngm:robot-operating-system ;
    vc:uses ngm:middleware-layer,
        ngm:system-software .

ngm:hyper-personalisation a owl:Class ;
    rdfs:label "Hyper personalisation"@en ;
