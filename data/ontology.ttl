ngm:control-systems-domain a owl:Class ;
    rdfs:label "Control Systems Domain"@en ;
    rdfs:comment "The Control Systems Domain classifies concepts concerning the regulation of dynamic systems towards desired behaviour using feedback and actuation. It covers modelling, stability, controller design and the sensing that closes the loop. As a sub-domain of the Robotics Domain it provides the theory by which physical and computational processes are kept on target despite disturbance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-methods-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stability ],
        ngm:robotics-domain ;
    vc:enables ngm:autonomous-operation,
        ngm:process-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:controller-design,
        ngm:feedback-loop,
        ngm:pid-control,
        ngm:stability,
        ngm:state-estimation ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:formal-methods-domain ;
    vc:slug "control-systems-domain" ;
    vc:sourceDomain "control-systems" .

ngm:coordination-layer a owl:Class ;
    rdfs:label "Coordination Layer"@en ;
    rdfs:comment "The Coordination Layer is the cross-cutting stratum that orchestrates the work of multiple agents or services toward a shared objective. It sits above control and integration concerns and below the application goals it serves. It contains schedulers, workflow engines, consensus on task assignment, and the protocols that keep distributed actors aligned."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:integration-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        ngm:owl-thing ;
    vc:enables ngm:agent-layer,
        ngm:application-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:integration-layer ;
    vc:slug "coordination-layer" ;
    vc:sourceDomain "coordination" .

ngm:creator-monetization a owl:Class ;
    rdfs:label "Creator Monetization"@en ;
    rdfs:comment "Creator Monetization refers to the suite of mechanisms, platforms, and economic models through which independent content creators convert their creative output and audience relationships into sustainable revenue streams. These mechanisms span advertising revenue sharing, subscription and membership tiers, merchandise and physical goods, live events, licensing, and on-chain token-based models including NFTs and creator coins. The field has been shaped by the shift from broadcast media to participatory digital platforms, enabling individuals rather than corporations to capture value from cultural production. Web3 infrastructure is expanding the design space by enabling programmable royalties and direct fan-ownership of creative works."@en ;
    rdfs:subClassOf ngm:creator-economy ;
    vc:enables ngm:digital-marketplace,
        ngm:multi-party-royalties,
        ngm:non-fungible-token-nft ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:nft-marketplace,
        ngm:platform-economy ;
    vc:slug "creator-monetization" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:creator-royalty-token,
        ngm:royalty-distribution,
        ngm:smart-royalty-contract .

ngm:credential-definition a owl:Class ;
    rdfs:label "Credential Definition"@en ;
    rdfs:comment "A credential definition is an on-ledger or registry artefact, published by a credential issuer, that binds a credential schema to the issuer's cryptographic public keys and signing parameters. It specifies the attributes a credential will contain and the cryptographic material verifiers use to validate signatures and zero-knowledge proofs derived from issued credentials. Central to decentralised-identity ecosystems such as those built on AnonCreds, a credential definition lets a holder prove possession of an issuer-signed credential, selectively disclosing only chosen attributes."@en ;
    rdfs:subClassOf ngm:verifiable-credential-standard ;
    vc:enables ngm:decentralized-identity,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:identity-provider ;
    vc:slug "credential-definition" ;
    vc:sourceDomain "identity" ;
    vc:uses ngm:digital-signature .

ngm:cross-encoder-reranking a owl:Class ;
    rdfs:label "Cross-Encoder Reranking"@en ;
    rdfs:comment "Cross-Encoder Reranking is a two-stage information retrieval technique in which a cross-encoder transformer model receives a query and a candidate document concatenated as a single input sequence, performs full bidirectional self-attention across both, and outputs a relevance score used to re-order an initial candidate set retrieved by a faster but less accurate first-stage retriever. It typically yields substantially higher ranking quality than bi-encoder first-stage retrieval at the cost of higher computational latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-search ],
        ngm:information-retrieval ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cosine-similarity ;
    vc:requires ngm:semantic-search ;
    vc:slug "cross-encoder-reranking" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:rag-pipeline ;
    vc:uses ngm:embedding-model .

ngm:cross-metaverse-commerce a owl:Class ;
    rdfs:label "Cross Metaverse Commerce"@en ;
    rdfs:comment "Economic activities and transactions that span multiple metaverse platforms and virtual worlds, enabled by interoperability standards, blockchain-based digital assets, and unified digital identity systems that allow users to buy, sell, trade, and transfer value seamlessly across different virtual..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        ngm:sc-platform-and-environment,
        ngm:virtual-economy ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:asset-portability,
        ngm:cross-platform-trading,
        ngm:virtual-market-integration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:digital-wallet,
        ngm:interoperability-standard ;
    vc:slug "cross-metaverse-commerce" ;
    vc:sourceDomain "spatial-computing" .

ngm:cross-platform-compatibility a owl:Class ;
    rdfs:label "Cross-Platform Compatibility"@en ;
    rdfs:comment "Cross-platform compatibility is the property of a software system, application, or digital asset that allows it to function correctly and consistently across multiple operating systems, hardware architectures, runtime environments, or device categories without requiring separate implementations. Achieving this property typically involves adherence to open standards, abstraction layers, and rigorous testing regimes that surface divergent behaviour across target environments. In immersive and extended-reality contexts it extends to ensuring that 3D content, avatars, and application logic behave equivalently across headsets, smartphones, and desktop viewers."@en ;
    rdfs:subClassOf ngm:interoperability ;
    vc:enables ngm:cross-platform-identity,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compatibility-standards,
        ngm:cross-platform-interoperability,
        ngm:interoperability-standard ;
    vc:slug "cross-platform-compatibility" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:accessibility ;
    vc:uses ngm:compatibility-process,
        ngm:open-standard .

ngm:crypto-climate-accord a owl:Class ;
    rdfs:label "Crypto Climate Accord"@en ;
    rdfs:comment "The Crypto Climate Accord is a private-sector initiative launched in 2021 to decarbonise the cryptocurrency and blockchain industry, modelled on the Paris Climate Agreement. It commits signatory companies and projects to achieving net-zero greenhouse-gas emissions from electricity consumption by 2030 and to developing open-source accounting standards and tools for measuring and reporting crypto energy use."@en ;
    rdfs:subClassOf ngm:esg ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.82"^^xsd:float ;
    vc:relatedTo ngm:blockchain-energy-consumption,
        ngm:carbon-credits,
        ngm:proof-of-stake,
        ngm:renewable-energy ;
    vc:slug "crypto-climate-accord" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:esg-compliant-blockchain,
        ngm:renewable-energy-tracking .

ngm:cryptographic-infrastructure a owl:Class ;
    rdfs:label "Cryptographic Infrastructure"@en ;
    rdfs:comment "Cryptographic infrastructure is the ensemble of hardware, software, protocols, and institutional processes that provision, manage, and operate cryptographic primitives at scale across a computing environment. It encompasses key generation and distribution, certificate authorities, hardware security modules, and the policies governing their lifecycle. As a foundational layer, it underpins secure communications, digital identity, and data integrity across both centralised and decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:cryptographic-algorithm ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cryptographic-hash-function,
        ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:cryptographic-signing,
        ngm:digital-signature ;
    vc:slug "cryptographic-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:cryptographic-library a owl:Class ;
    rdfs:label "Cryptographic Library"@en ;
    rdfs:comment "A cryptographic library is a software package that implements cryptographic primitives and protocols — encryption, hashing, signing, key exchange, and random-number generation — behind a programming interface that application developers can use without reimplementing the underlying mathematics. Well-designed libraries such as OpenSSL, libsodium, BoringSSL, and the Rust RustCrypto suite emphasise constant-time implementations, safe defaults, and resistance to misuse. The correctness and side-channel resistance of these libraries is critical, since flaws propagate to every application that depends on them."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature,
        ngm:encryption,
        ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:key-management ;
    vc:slug "cryptographic-library" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:public-key-cryptography .

ngm:cryptographic-proof-system a owl:Class ;
    rdfs:label "Cryptographic Proof System"@en ;
    rdfs:comment "A cryptographic proof system is a formal protocol allowing one party (a prover) to convince another party (a verifier) of the truth of a statement without revealing any information beyond the validity of that statement. These systems provide mathematical guarantees of soundness, completeness, and, in zero-knowledge variants, zero information leakage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:commitment-scheme ],
        ngm:cryptographic-protocol ;
    vc:enables ngm:authentication,
        ngm:cryptographic-proofs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:commitment-scheme,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "cryptographic-proof-system" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:zk-snarks,
        ngm:zk-starks .

ngm:cryptographic-proofs a owl:Class ;
    rdfs:label "Cryptographic Proofs"@en ;
    rdfs:comment "Cryptographic proofs are mathematical constructions that allow one party to convince another of the truth of a statement with cryptographic certainty, often without revealing the underlying data. They include proofs of knowledge, membership proofs, proofs of computation, and zero-knowledge proofs, and rely on primitives such as hash functions, commitments, and elliptic-curve operations. Cryptographic proofs underpin blockchain validity, verifiable computation, privacy-preserving authentication, and data-availability guarantees, letting verifiers trust outcomes they did not themselves compute."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:data-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:merkle-tree ;
    vc:slug "cryptographic-proofs" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:hash-function,
        ngm:zero-knowledge-proof .

ngm:curve-finance a owl:Class ;
    rdfs:label "Curve Finance"@en ;
    rdfs:comment "Curve Finance is a decentralised exchange protocol on Ethereum and other chains, launched in 2020, specialising in efficient trading between assets expected to hold similar values, such as stablecoins and wrapped tokens. It uses an automated market maker with a bonding curve designed to minimise slippage and impermanent loss for like-valued assets. Liquidity providers earn trading fees and additional rewards, and the protocol's CRV token is used in a vote-escrow governance model that directs liquidity incentives. Curve has been a significant venue for stablecoin liquidity within decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-market-maker ],
        ngm:decentralised-finance-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automated-market-maker,
        ngm:ethereum,
        ngm:stablecoin ;
    vc:slug "curve-finance" ;
    vc:sourceDomain "curve-finance" .

ngm:customer-data-platform a owl:Class ;
    rdfs:label "Customer Data Platform"@en ;
    rdfs:comment "A software system that consolidates customer data from multiple sources into a unified, persistent profile that other marketing and analytics systems can access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        ngm:data-management ;
    vc:enables ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-integration ;
    vc:slug "customer-data-platform" ;
    vc:sourceDomain "general" .

ngm:customer-experience a owl:Class ;
    rdfs:label "Customer Experience"@en ;
    rdfs:comment "Customer experience (CX) is the holistic perception a customer forms of an organisation across every interaction and touchpoint throughout the customer lifecycle, from initial awareness through purchase, post-sale service, and eventual advocacy or churn. It encompasses emotional, cognitive, sensory, and behavioural dimensions of customer engagement and is recognised as a primary competitive differentiator in markets where product parity is high. Organisations systematically measure and engineer CX through journey mapping, voice-of-customer programmes, service design, and data-driven personalisation."@en ;
    rdfs:subClassOf ngm:user-experience ;
    vc:enables ngm:customer-service-automation,
        ngm:hyper-personalisation,
        ngm:loyalty-programs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:customer-support,
        ngm:digital-twin-of-the-customer ;
    vc:slug "customer-experience" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:behavioral-analytics,
        ngm:predictive-personalization,
        ngm:sentiment-analysis .

ngm:cylindrical-robot a owl:Class ;
    rdfs:label "Cylindrical Robot"@en ;
    rdfs:comment "Cylindrical robot employs one rotary joint (azimuth) and two prismatic joints (radial and vertical) that produce a cylindrical workspace, enabling efficient reach over rectangular work envelopes."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-actuation-and-control,
        ngm:robo-robot-type ;
    vc:enables ngm:component-assembly,
        ngm:depalletising,
        ngm:palletising,
        ngm:pick-and-place ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:azimuth-drive,
        ngm:end-effector-mount,
        ngm:radial-actuator,
        ngm:vertical-actuator ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:base-support,
        ngm:prismatic-actuators,
        ngm:rotary-joint ;
    vc:slug "cylindrical-robot" ;
    vc:sourceDomain "robotics" .

ngm:data-access-interface a owl:Class ;
    rdfs:label "Data Access Interface"@en ;
    rdfs:comment "A Data Access Interface is a formalised contract—such as a REST API, GraphQL endpoint, or SPARQL query service—that mediates structured access to data stores, registries, or knowledge graphs. It enforces authentication, authorisation, and schema validation, decoupling data consumers from underlying storage implementations. In metaverse and spatial computing contexts, data access interfaces expose asset repositories, user identity records, and scene graphs to applications and AI agents."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-governance,
        ngm:data-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:digital-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-access-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-agent-system,
        ngm:data-registry ;
    vc:uses ngm:digital-identity .

ngm:data-mesh a owl:Class ;
    rdfs:label "Data Mesh"@en ;
    rdfs:comment "Data Mesh is a socio-technical paradigm for large-scale analytical data architecture, coined by Zhamak Dehghani (2020), that decentralises data ownership to domain-aligned teams who treat their analytical datasets as first-class products accessible via standardised interfaces. It rests on four principles: domain-oriented decentralised data ownership, data as a product, self-serve data infrastructure as a platform, and federated computational governance. Unlike monolithic data lakes or warehouses governed by a central data engineering team, a Data Mesh distributes accountability so that the teams who generate data also maintain its quality, documentation, and SLAs as discoverable data products. The model draws on domain-driven design and microservices thinking applied to analytical rather than operational data flows."@en ;
    rdfs:subClassOf ngm:data-governance-framework ;
    vc:enables ngm:data-analytics,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-fabric-architecture,
        ngm:data-governance,
        ngm:federated-learning ;
    vc:slug "data-mesh" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-lake,
        ngm:event-driven-architecture ;
    vc:uses ngm:api-gateway,
        ngm:data-pipeline,
        ngm:microservices-architecture .

ngm:data-protection-law a owl:Class ;
    rdfs:label "Data Protection Law"@en ;
    rdfs:comment "The body of law governing how personal data may be collected, processed, stored and shared, and the rights afforded to individuals over their personal information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:data-protection ;
    vc:enables ngm:data-privacy,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-protection ;
    vc:slug "data-protection-law" ;
    vc:sourceDomain "governance" .

ngm:decentralised-decision-making a owl:Class ;
    rdfs:label "Decentralised Decision-Making"@en ;
    rdfs:comment "Decentralised Decision-Making is a governance paradigm in which authority to make binding choices is distributed across multiple autonomous actors — individuals, nodes, or smart contracts — rather than concentrated in a single hierarchical centre, typically relying on voting mechanisms, consensus protocols, or market-based coordination to aggregate preferences and resolve conflicts. In blockchain and DAO contexts, decentralised decision-making is operationalised through on-chain proposal-and-vote cycles, token-weighted or quadratic voting, and cryptographically enforced execution of outcomes via smart contracts. The paradigm spans organisational theory, political science, distributed systems, and mechanism design, with implementations ranging from holocratic corporations to fully autonomous protocol governance."@en ;
    rdfs:subClassOf ngm:decentralized-governance ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:dao,
        ngm:liquid-democracy,
        ngm:mechanism-design ;
    vc:slug "decentralised-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:governance-token,
        ngm:quadratic-voting,
        ngm:snapshot-voting .

ngm:decentralised-exchange a owl:Class ;
    rdfs:label "Decentralised Exchange"@en ;
    rdfs:comment "A trading venue that allows users to swap digital assets directly through smart contracts, without a central operator holding custody of funds or matching orders off-chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:exchange-mechanism ;
    vc:enables ngm:permissionless-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:slug "decentralised-exchange" ;
    vc:sourceDomain "blockchain" .

ngm:decentralised-storage a owl:Class ;
    rdfs:label "Decentralised Storage"@en ;
    rdfs:comment "Storage systems that distribute data across many independent nodes rather than a single central provider, often using content addressing and cryptographic verification to ensure integrity and availability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:distributed-systems ;
    vc:enables ngm:provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-hash ;
    vc:slug "decentralised-storage" ;
    vc:sourceDomain "distributed-systems" .

ngm:deep-speed a owl:Class ;
    rdfs:label "DeepSpeed"@en ;
    rdfs:comment "DeepSpeed is an open-source deep learning optimisation library developed by Microsoft Research that enables training and inference of extremely large neural network models through ZeRO (Zero Redundancy Optimizer) memory partitioning, pipeline parallelism, and mixed-precision arithmetic. It reduces the per-device memory footprint of model states by partitioning optimiser states, gradients, and parameters across data-parallel devices."@en ;
    rdfs:subClassOf ngm:distributed-training ;
    vc:enables ngm:large-language-model-training,
        ngm:model-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:hugging-face-accelerate,
        ngm:pipeline-parallelism ;
    vc:slug "deep-speed" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gradient-checkpointing,
        ngm:mixed-precision-training .

ngm:dense-passage-retrieval a owl:Class ;
    rdfs:label "Dense Passage Retrieval"@en ;
    rdfs:comment "Dense Passage Retrieval (DPR) is an information retrieval approach in which both queries and document passages are encoded into dense continuous vector representations using dual-encoder neural networks, enabling similarity search via dot-product or cosine distance rather than sparse lexical matching. It substantially outperforms traditional BM25 retrieval on semantic matching tasks and forms the retriever component of open-domain question-answering and retrieval-augmented generation systems."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "dense-passage-retrieval" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding,
        ngm:transformer,
        ngm:vector-database .

ngm:development-platform a owl:Class ;
    rdfs:label "Development Platform"@en ;
    rdfs:comment "A Development Platform is an integrated suite of tools, APIs, runtimes, and infrastructure services that enables engineers and creators to build, test, and deploy applications. In spatial computing contexts, development platforms provide SDKs for XR hardware, scene-graph editors, physics engines, and asset pipelines supporting OpenXR and Universal Scene Description (USD). They abstract hardware heterogeneity and supply governance tooling for collaborative multi-stakeholder development."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:digital-infrastructure ;
    vc:enables ngm:digital-twin,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "development-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:collaboration,
        ngm:digital-fabrication ;
    vc:uses ngm:computer-vision,
        ngm:open-xr .

ngm:did-method a owl:Class ;
    rdfs:label "DID Method"@en ;
    rdfs:comment "A specification that defines how a particular type of decentralised identifier is created, resolved, updated, and deactivated. Each method describes the syntax and operations for DIDs anchored to a specific system such as a blockchain or registry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identity ],
        ngm:decentralized-identity ;
    vc:enables ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:decentralized-identity ;
    vc:slug "did-method" ;
    vc:sourceDomain "identity" .

ngm:digital-art a owl:Class ;
    rdfs:label "Digital Art"@en ;
    rdfs:comment "Digital art encompasses visual, interactive, and generative artworks created, stored, and distributed using digital technologies as primary medium or tool. It spans a wide range of practices—from pixel painting and vector illustration to algorithmically generated pieces, interactive installations, and AI-synthesised imagery. The form has been transformed by NFT infrastructure, which introduced scarcity and provenance guarantees to inherently copyable digital objects. Digital art sits at the intersection of technological capability and aesthetic intent, continuously expanding as new computational tools emerge."@en ;
    rdfs:subClassOf ngm:creative-media-domain ;
    vc:enables ngm:content-creation,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-art-application,
        ngm:digital-ownership,
        ngm:nft ;
    vc:slug "digital-art" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:agentic-metaverse-for-global-creatives ;
    vc:uses ngm:creative-ai,
        ngm:creative-software,
        ngm:image-generation .

