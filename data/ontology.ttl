    vc:uses ngm:rb-0067-force-torque-sensor .
ngm:rb-0021-robot-kinematics a owl:Class ;
    rdfs:comment "Robot kinematics is the study of the geometry and motion of robot mechanisms — particularly manipulator arms — without regard to the forces or torques that cause motion. It encompasses forward kinematics (computing end-effector pose from joint configurations), inverse kinematics (computing joint configurations for a desired end-effector pose), Jacobian analysis relating joint velocities to Cartesian velocities, and singularity analysis. Kinematic models are foundational inputs to motion planning, trajectory generation, and control law design."@en ;
    rdfs:label "rb 0021 robot kinematics"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22919 ;
    rdfs:subClassOf _:r22920 ;
    rdfs:subClassOf _:r22921 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning ;
    vc:enables ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-kinematics ;
    vc:hasPart ngm:inverse-kinematics ;
    vc:hasPart ngm:rb-0030-jacobian-matrix ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom ;
    vc:relatedTo ngm:rb-0031-singularity ;
    vc:slug "rb-0021-robot-kinematics" ;
    vc:sourceDomain "robotics" .
ngm:rb-0022-robot-dynamics a owl:Class ;
    rdfs:comment "Robot dynamics is the study of the relationship between the forces and torques applied to a robot's joints and links and the resulting motion of the robot. It encompasses forward dynamics (computing accelerations from applied torques), inverse dynamics (computing required torques to achieve a desired motion), and the derivation of equations of motion via Newton-Euler or Lagrangian formulations. Dynamic models are essential for model-based controllers such as computed-torque control, optimal control, and trajectory optimisation."@en ;
    rdfs:label "rb 0022 robot dynamics"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot-dynamics ;
    rdfs:subClassOf _:r22922 ;
    rdfs:subClassOf _:r22923 ;
    rdfs:subClassOf _:r22924 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:newton-euler-dynamics ;
    vc:relatedTo ngm:rb-0030-jacobian-matrix ;
    vc:relatedTo ngm:rigid-body-dynamics ;
    vc:requires ngm:rb-0021-robot-kinematics ;
    vc:requires ngm:rb-0041-inertia ;
    vc:requires ngm:rb-0043-torque ;
    vc:slug "rb-0022-robot-dynamics" ;
    vc:sourceDomain "robotics" .
ngm:rb-0023-degrees-of-freedom a owl:Class ;
    rdfs:comment "Degrees of Freedom (DOF) in robotics denotes the number of independent parameters required to fully specify the configuration of a robot mechanism. Each revolute or prismatic joint contributes one DOF; a 6-DOF manipulator can achieve arbitrary position and orientation in three-dimensional space. The number of DOF constrains the robot's reachable workspace, its dexterity, and the complexity of its kinematic and dynamic models."@en ;
    rdfs:label "rb 0023 degrees of freedom"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22925 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0026-robot-joint ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0021-robot-kinematics ;
    vc:relatedTo ngm:rb-0024-workspace ;
    vc:relatedTo ngm:rb-0031-singularity ;
    vc:relatedTo ngm:rb-0037-dexterity ;
    vc:slug "rb-0023-degrees-of-freedom" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0028-forward-kinematics ;
    vc:supports ngm:rb-0029-inverse-kinematics ;
    vc:supports ngm:rb-0036-resolution .
ngm:rb-0024-workspace a owl:Class ;
    rdfs:comment "The workspace of a robot manipulator is the total volume of space that the end-effector can reach, given the joint range limits of all links. The reachable workspace encompasses every point the tool-centre-point (TCP) can attain in at least one orientation, while the dexterous workspace is the subset reachable in all possible orientations. Workspace volume, shape, and dexterity distribution are primary design criteria for robot selection and cell layout, and must account for self-collisions, payload, and safety exclusion zones."@en ;
    rdfs:label "rb 0024 workspace"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics ;
    vc:dependsOn ngm:rb-0026-robot-joint ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:manipulator-arm ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom ;
    vc:relatedTo ngm:rb-0031-singularity ;
    vc:relatedTo ngm:rb-0033-payload ;
    vc:relatedTo ngm:rb-0037-dexterity ;
    vc:relatedTo ngm:rb-0095-safety-zone ;
    vc:slug "rb-0024-workspace" ;
    vc:sourceDomain "robotics" .
ngm:rb-0026-robot-joint a owl:Class ;
    rdfs:comment "A robot joint is a mechanical articulation connecting two adjacent robot links that permits one or more degrees of relative motion—translational (prismatic) or rotational (revolute). Robot joints are the fundamental kinematic elements that determine a manipulator's workspace and degrees of freedom; their dynamic properties, including inertia, backlash, and compliance, critically influence both control precision and safe interaction with the environment."@en ;
    rdfs:label "rb 0026 robot joint"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot ;
    rdfs:subClassOf _:r22926 ;
    rdfs:subClassOf _:r22927 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0021-robot-kinematics ;
    vc:enables ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0072-encoder ;
    vc:hasPart ngm:robot-actuator ;
    vc:isPartOf ngm:rb-0027-robot-link ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance ;
    vc:relatedTo ngm:rb-0039-stiffness ;
    vc:relatedTo ngm:rb-0040-backlash ;
    vc:relatedTo ngm:rb-0041-inertia ;
    vc:slug "rb-0026-robot-joint" ;
    vc:sourceDomain "robotics" .
ngm:rb-0027-robot-link a owl:Class ;
    rdfs:comment "A robot link is a rigid (or semi-rigid) structural body that forms one segment of a robot's kinematic chain, connecting adjacent joints and transmitting forces and torques between them. Links define the geometry of the robot's workspace by their length, mass, and inertial properties, and together with joints they constitute the Denavit-Hartenberg representation used in forward and inverse kinematics. Link stiffness, material choice, and mass distribution directly affect dynamic performance, vibration characteristics, and safety in human-robot interaction."@en ;
    rdfs:label "rb 0027 robot link"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot ;
    rdfs:subClassOf _:r22928 ;
    rdfs:subClassOf _:r22929 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint ;
    vc:hasPart ngm:robot-link ;
    vc:isPartOf ngm:robot ;
    vc:isPartOf ngm:robot-kinematics ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:inertia ;
    vc:relatedTo ngm:kinematics ;
    vc:relatedTo ngm:rb-0039-stiffness ;
    vc:relatedTo ngm:rigid-body ;
    vc:slug "rb-0027-robot-link" ;
    vc:sourceDomain "robotics" .
ngm:rb-0028-forward-kinematics a owl:Class ;
    rdfs:comment "Forward kinematics (FK) is the mathematical process of computing the position and orientation of a robot's end effector in Cartesian space given a known set of joint angles or displacements. Using a chain of homogeneous transformation matrices (typically expressed using Denavit-Hartenberg parameters), FK provides a unique, computationally deterministic mapping from joint space to task space. It is used in motion planning, visualisation, and safety monitoring to determine where the robot tool tip is at any instant, and underpins workspace analysis, collision checking, and trajectory verification."@en ;
    rdfs:label "rb 0028 forward kinematics"@en ;
    rdfs:subClassOf ngm:kinematics ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22930 ;
    rdfs:subClassOf _:r22931 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0029-inverse-kinematics ;
    vc:enables ngm:rb-0049-motion-planning ;
    vc:enables ngm:rb-0052-collision-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0021-robot-kinematics ;
    vc:relatedTo ngm:rb-0024-workspace ;
    vc:relatedTo ngm:rb-0030-jacobian-matrix ;
    vc:relatedTo ngm:rb-0031-singularity ;
    vc:requires ngm:rb-0026-robot-joint ;
    vc:requires ngm:rb-0072-encoder ;
    vc:slug "rb-0028-forward-kinematics" ;
    vc:sourceDomain "robotics" .
ngm:rb-0029-inverse-kinematics a owl:Class ;
    rdfs:comment "Inverse kinematics (IK) is the computational process of determining the joint angles or actuator lengths required to place a robot's end-effector at a desired position and orientation in task space. Unlike forward kinematics, IK is typically under-determined or over-determined and requires iterative numerical solvers, analytical solutions, or Jacobian-based methods; it is a foundational component of motion planning, manipulation, and trajectory execution in robotic systems."@en ;
    rdfs:label "rb 0029 inverse kinematics"@en ;
    rdfs:subClassOf ngm:kinematics ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0028-forward-kinematics ;
    vc:enables ngm:motion-planning ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:end-effector ;
    vc:relatedTo ngm:manipulator-arm ;
    vc:relatedTo ngm:rb-0021-robot-kinematics ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom ;
    vc:slug "rb-0029-inverse-kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0030-jacobian-matrix ;
    vc:uses ngm:rb-0031-singularity .
ngm:rb-0030-jacobian-matrix a owl:Class ;
    rdfs:comment "The Jacobian matrix is a mathematical mapping that relates joint-space velocities to Cartesian end-effector velocities for a robotic manipulator. It is central to differential kinematics, velocity control, force-torque transformation, and singularity analysis; its pseudo-inverse enables computation of joint velocities from desired Cartesian motions in inverse kinematics."@en ;
    rdfs:label "rb 0030 jacobian matrix"@en ;
    rdfs:subClassOf ngm:kinematics ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0053-force-control ;
    vc:enables ngm:rb-0060-optimal-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0028-forward-kinematics ;
    vc:relatedTo ngm:rb-0029-inverse-kinematics ;
    vc:relatedTo ngm:rb-0031-singularity ;
    vc:relatedTo ngm:rb-0032-manipulability ;
    vc:slug "rb-0030-jacobian-matrix" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0021-robot-kinematics ;
    vc:uses ngm:rb-0023-degrees-of-freedom .
ngm:rb-0031-singularity a owl:Class ;
    rdfs:comment "A kinematic singularity is a robot configuration in which the Jacobian matrix loses rank, causing the manipulator to lose one or more degrees of freedom in Cartesian space. At a singularity, certain end-effector motions become unachievable regardless of joint velocity magnitudes, and inverse kinematics solutions either vanish or require unbounded joint speeds. Singularity avoidance and singularity-robust inverse kinematics (via damped least-squares) are critical for safe, continuous robot motion, particularly near workspace boundaries and for wrist configurations of six-axis arms."@en ;
    rdfs:label "rb 0031 singularity"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22932 ;
    rdfs:subClassOf _:r22933 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0037-dexterity ;
    vc:dependsOn ngm:differential-kinematics ;
    vc:dependsOn ngm:rb-0029-inverse-kinematics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom ;
    vc:relatedTo ngm:rb-0024-workspace ;
    vc:relatedTo ngm:rb-0032-manipulability ;
    vc:relatedTo ngm:robot-singularity ;
    vc:requires ngm:rb-0021-robot-kinematics ;
    vc:requires ngm:rb-0030-jacobian-matrix ;
    vc:slug "rb-0031-singularity" ;
    vc:sourceDomain "robotics" .
ngm:rb-0032-manipulability a owl:Class ;
    rdfs:comment "Manipulability is a scalar or ellipsoid measure of a robotic manipulator's capacity to move and exert forces in arbitrary directions from a given joint configuration. Introduced by Tsuneo Yoshikawa, the manipulability measure w = sqrt(det(J·Jᵀ)) quantifies how far a configuration is from kinematic singularity: higher values indicate greater dexterity, while w = 0 indicates a singular configuration where motion in at least one direction is lost. Manipulability is used in motion planning, redundancy resolution, and task-space control to avoid singular regions."@en ;
    rdfs:label "rb 0032 manipulability"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot-kinematics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0031-singularity ;
    vc:dependsOn ngm:rb-0021-robot-kinematics ;
    vc:dependsOn ngm:rb-0023-degrees-of-freedom ;
    vc:dependsOn ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0024-workspace ;
    vc:relatedTo ngm:rb-0037-dexterity ;
    vc:slug "rb-0032-manipulability" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0029-inverse-kinematics ;
    vc:supports ngm:rb-0049-motion-planning .
ngm:rb-0033-payload a owl:Class ;
    rdfs:comment "Payload in robotics refers to the maximum mass that a robot can carry or manipulate while maintaining its specified performance characteristics, including accuracy, repeatability, and speed. Payload capacity is a fundamental design parameter for robot arms, mobile robots, and drones, directly constraining the tools, parts, or cargo the robot can handle. It is typically quoted at the wrist or end-effector mounting face and may vary with configuration and speed; dynamic payload accounts for inertial forces during acceleration."@en ;
    rdfs:label "rb 0033 payload"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:dependsOn ngm:rb-0039-stiffness ;
    vc:enables ngm:end-effector ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0034-repeatability ;
    vc:relatedTo ngm:rb-0035-accuracy ;
    vc:relatedTo ngm:rb-0041-inertia ;
    vc:relatedTo ngm:rb-0043-torque ;
    vc:slug "rb-0033-payload" ;
    vc:sourceDomain "robotics" .
ngm:rb-0034-repeatability a owl:Class ;
    rdfs:comment "Repeatability is a key performance metric of robot manipulators that quantifies the closeness of agreement between successive commanded returns to the same target position or pose, measured under identical conditions. It is formally defined in ISO 9283 as the radius of a sphere enclosing a specified percentage of attained positions from repeated attempts. Repeatability is distinct from accuracy — a robot may be highly repeatable but systematically offset from the commanded target — and is critical for applications such as assembly, welding, and precision manufacturing."@en ;
    rdfs:label "rb 0034 repeatability"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:rb-0021-robot-kinematics ;
    vc:dependsOn ngm:rb-0047-feedback-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0036-resolution ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:calibration ;
    vc:relatedTo ngm:performance-metrics ;
    vc:relatedTo ngm:precision ;
    vc:slug "rb-0034-repeatability" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .
ngm:rb-0035-accuracy a owl:Class ;
    rdfs:comment "Robot accuracy is the closeness of agreement between a robot's commanded pose and its actual achieved pose, measured as the mean positional or orientational error across multiple repeated commanded positions. Defined in ISO 9283, it encompasses pose accuracy, path accuracy, and static compliance accuracy, and is distinct from repeatability, which measures the spread of repeated attempts at the same pose rather than deviation from the commanded value."@en ;
    rdfs:label "rb 0035 accuracy"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robo-actuation-and-control ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:accuracy ;
    vc:contrastsWith ngm:rb-0034-repeatability ;
    vc:contrastsWith ngm:rb-0036-resolution ;
    vc:dependsOn ngm:rb-0048-pid-controller ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:calibration ;
    vc:relatedTo ngm:precision ;
    vc:relatedTo ngm:rb-0021-robot-kinematics ;
    vc:relatedTo ngm:rb-0029-inverse-kinematics ;
    vc:slug "rb-0035-accuracy" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .
ngm:rb-0036-resolution a owl:Class ;
    rdfs:comment "Resolution, as defined by ISO 8373, is the smallest increment of motion or measurement that a robot system can distinguish or command. For manipulators it typically refers to the minimum step size achievable in Cartesian or joint space; for sensors it denotes the smallest detectable change in the measured quantity. Resolution is distinct from accuracy and repeatability, and it places a fundamental lower bound on the precision of both positioning and perception tasks."@en ;
    rdfs:label "rb 0036 resolution"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0026-robot-joint ;
    vc:dependsOn ngm:rb-0040-backlash ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom ;
    vc:relatedTo ngm:rb-0034-repeatability ;
    vc:relatedTo ngm:rb-0035-accuracy ;
    vc:relatedTo ngm:rb-0072-encoder ;
    vc:slug "rb-0036-resolution" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0032-manipulability ;
    vc:supports ngm:rb-0054-position-control .
ngm:rb-0037-dexterity a owl:Class ;
    rdfs:comment "Dexterity, in robotics, is the ability of a manipulator to achieve a broad range of end-effector orientations and positions within its workspace, particularly in the vicinity of a given point, without encountering kinematic singularities. It is quantified by measures such as the Jacobian condition number, manipulability ellipsoid volume, or isotropy index. High dexterity enables a robot arm to approach objects from many angles, reconfigure during a task, and avoid joint limits — properties critical for assembly, surgery, and unstructured manipulation tasks."@en ;
    rdfs:label "rb 0037 dexterity"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0029-inverse-kinematics ;
    vc:dependsOn ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom ;
    vc:relatedTo ngm:rb-0024-workspace ;
    vc:relatedTo ngm:rb-0031-singularity ;
    vc:relatedTo ngm:rb-0032-manipulability ;
    vc:slug "rb-0037-dexterity" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:end-effector ;
    vc:supports ngm:manipulation .
ngm:rb-0038-compliance a owl:Class ;
    rdfs:comment "In robotics, compliance is the mechanical property of a robot joint or end-effector describing its tendency to yield under applied forces or torques, quantified as the inverse of stiffness. Compliant behaviour is essential for safe human-robot interaction, allowing robots to absorb contact forces without rigid collision, and is actively exploited in impedance and admittance control strategies to achieve gentle, force-sensitive manipulation."@en ;
    rdfs:label "rb 0038 compliance"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0039-stiffness ;
    vc:enables ngm:human-robot-interaction ;
    vc:enables ngm:rb-0053-force-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint ;
    vc:relatedTo ngm:rb-0041-inertia ;
    vc:relatedTo ngm:rb-0056-impedance-control ;
    vc:relatedTo ngm:rb-0057-admittance-control ;
    vc:slug "rb-0038-compliance" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-safety .
ngm:rb-0039-stiffness a owl:Class ;
    rdfs:comment "Stiffness, in robotics, is the ratio of applied force (or torque) to the resulting displacement (or angular deflection) of a robot link, joint, or end-effector. High stiffness yields precise positioning at the cost of storing large elastic energy that can be hazardous in contact; low stiffness (compliance) absorbs impact and is preferred in human-robot collaboration. Variable-stiffness actuation and impedance control allow robots to modulate stiffness dynamically, trading accuracy against safety depending on task context."@en ;
    rdfs:label "rb 0039 stiffness"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0027-robot-link ;
    vc:enables ngm:force-control ;
    vc:enables ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control ;
    vc:relatedTo ngm:impedance-control ;
    vc:relatedTo ngm:inertia ;
    vc:relatedTo ngm:rigid-body-dynamics ;
    vc:relatedTo ngm:robot-dynamics ;
    vc:slug "rb-0039-stiffness" ;
    vc:sourceDomain "robotics" .
ngm:rb-0040-backlash a owl:Class ;
    rdfs:comment "Backlash in robotics is the lost motion in a mechanical transmission — the angular or linear displacement of the output element when the input reverses direction without producing corresponding output movement, caused by clearance gaps between mating gear teeth or other drive components. Backlash degrades positional accuracy and repeatability, introduces nonlinearity into the control loop, and can cause oscillation or chattering in feedback control systems. Minimising backlash is critical for precision robot joints, and it is typically reduced through the use of preloaded gear pairs, harmonic drives, or cycloidal transmissions."@en ;
    rdfs:label "rb 0040 backlash"@en ;
    rdfs:subClassOf ngm:backlash ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0034-repeatability ;
    vc:contrastsWith ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:actuator ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint ;
    vc:relatedTo ngm:rb-0038-compliance ;
    vc:relatedTo ngm:rb-0039-stiffness ;
    vc:relatedTo ngm:rb-0043-torque ;
    vc:relatedTo ngm:rb-0047-feedback-control ;
    vc:slug "rb-0040-backlash" ;
    vc:sourceDomain "robotics" .
ngm:rb-0041-inertia a owl:Class ;
    rdfs:comment "In robotics, inertia refers to the resistance of a robot's links and payload to changes in motion, quantified by the inertia tensor for rotational dynamics and mass for translational dynamics. Accurate inertia modelling is essential for dynamic control, trajectory planning, and compliance with power-and-force-limiting safety requirements, because high inertia directly increases the impact forces during unintended contact."@en ;
    rdfs:label "rb 0041 inertia"@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0033-payload ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics ;
    vc:relatedTo ngm:rb-0043-torque ;
    vc:relatedTo ngm:rb-0045-acceleration ;
    vc:relatedTo ngm:rigid-body-dynamics ;
    vc:relatedTo ngm:robot-dynamics ;
    vc:slug "rb-0041-inertia" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0064-computed-torque-control ;
    vc:supports ngm:rb-0094-power-and-force-limiting .
ngm:rb-0043-torque a owl:Class ;
    rdfs:comment "Torque is the rotational force applied about a joint axis, expressed in Newton-metres (N·m). In robot dynamics, joint torques are the primary control inputs that drive links through desired trajectories; torque limits constrain the feasible workspace and influence payload capacity, and torque sensing enables compliant and force-controlled interaction."@en ;
    rdfs:label "rb 0043 torque"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:dependsOn ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0041-inertia ;
    vc:relatedTo ngm:rb-0044-velocity ;
    vc:relatedTo ngm:rb-0045-acceleration ;
    vc:relatedTo ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0043-torque" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator ;
    vc:uses ngm:servo-motor .
ngm:rb-0044-velocity a owl:Class ;
    rdfs:comment "In robotics, velocity refers to the time-derivative of position, encompassing both linear velocity (metres per second) at the end-effector or a body-frame point, and angular velocity (radians per second) describing rotational rate. Velocity is the central quantity in differential kinematics: the Jacobian matrix maps joint-space velocity vectors to Cartesian task-space velocities. Velocity limits are safety-critical parameters in collaborative robot standards (ISO/TS 15066) where end-effector speed directly determines permissible human contact force."@en ;
    rdfs:label "rb 0044 velocity"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf ngm:robot-kinematics ;
    rdfs:subClassOf _:r22934 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning ;
    vc:enables ngm:rb-0055-velocity-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics ;
    vc:relatedTo ngm:rb-0030-jacobian-matrix ;
    vc:relatedTo ngm:rb-0043-torque ;
    vc:relatedTo ngm:rb-0045-acceleration ;
    vc:requires ngm:rb-0021-robot-kinematics ;
    vc:slug "rb-0044-velocity" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0093-speed-limitation .
ngm:rb-0045-acceleration a owl:Class ;
    rdfs:comment "In robotics, acceleration is the rate of change of velocity with respect to time, expressed for each joint (joint-space acceleration) or for the robot's end-effector (task-space acceleration), measured in rad/s² or m/s² respectively. Acceleration profiles govern the dynamic forces and torques that a manipulator must generate, coupling directly into Newton-Euler equations of motion. Limiting acceleration is central to safety (reducing impact forces) and to trajectory smoothness in collaborative applications."@en ;
    rdfs:label "rb 0045 acceleration"@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics ;
    vc:dependsOn ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics ;
    vc:relatedTo ngm:rb-0041-inertia ;
    vc:relatedTo ngm:rb-0043-torque ;
    vc:relatedTo ngm:rb-0044-velocity ;
    vc:slug "rb-0045-acceleration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0051-trajectory-planning ;
    vc:supports ngm:rb-0094-power-and-force-limiting .
ngm:rb-0047-feedback-control a owl:Class ;
    rdfs:comment "A closed-loop control strategy in which sensor measurements of a system's output are continuously compared to a reference setpoint, and the resulting error signal drives corrective actuator commands. Feedback control is the foundational mechanism for stable, accurate robotic motion, enabling autonomous robots and telerobotic systems to compensate for disturbances, model uncertainty, and environmental variation."@en ;
    rdfs:label "rb 0047 feedback control"@en ;
    rdfs:subClassOf ngm:closed-loop-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22935 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:adaptive-control ;
    vc:enables ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robotics-control ;
    vc:relatedTo ngm:teleoperation ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "rb-0047-feedback-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:pid-control ;
    vc:uses ngm:robot-sensor .
ngm:rb-0048-pid-controller a owl:Class ;
    rdfs:comment "A PID (Proportional-Integral-Derivative) controller is the most widely deployed feedback control algorithm in robotics and industrial automation. It computes a control output as the weighted sum of three terms: the proportional term (reacts to the current error magnitude), the integral term (eliminates steady-state error by accumulating past errors), and the derivative term (anticipates future error by responding to the rate of change). PID controllers are used in robot joint position and velocity loops, temperature regulation, and process control, often augmented with feed-forward terms to improve performance under known dynamics."@en ;
    rdfs:label "rb 0048 pid controller"@en ;
    rdfs:subClassOf ngm:control-theory ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0062-model-predictive-control ;
    vc:dependsOn ngm:rb-0072-encoder ;
    vc:enables ngm:rb-0054-position-control ;
    vc:enables ngm:rb-0055-velocity-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:feedback-control ;
    vc:relatedTo ngm:rb-0047-feedback-control ;
    vc:relatedTo ngm:rb-0060-optimal-control ;
    vc:relatedTo ngm:rb-0063-sliding-mode-control ;
    vc:slug "rb-0048-pid-controller" ;
    vc:sourceDomain "robotics" .
ngm:rb-0049-motion-planning a owl:Class ;
    rdfs:comment "Motion planning is the computational process of determining a sequence of valid robot configurations or control inputs that moves a robot from an initial state to a goal state while satisfying constraints such as obstacle avoidance, joint limits, and dynamic feasibility. It bridges high-level task specification and low-level actuation, encompassing path planning, trajectory optimisation, and task-and-motion planning (TAMP). Sampling-based methods (RRT, PRM) and optimisation-based approaches are the dominant paradigms, increasingly augmented by learning-based techniques for dynamic and uncertain environments."@en ;
    rdfs:label "rb 0049 motion planning"@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    rdfs:subClassOf ngm:robotics ;
    rdfs:subClassOf _:r22936 ;
    rdfs:subClassOf _:r22937 ;
    rdfs:subClassOf _:r22938 ;
    skos:broader ngm:robo-navigation-and-planning ;
    skos:broader ngm:robotics ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:path-planning ;
    vc:hasPart ngm:rb-0051-trajectory-planning ;
    vc:hasPart ngm:rb-0052-collision-avoidance ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation ;
    vc:relatedTo ngm:obstacle-avoidance ;
    vc:relatedTo ngm:task-planning ;
    vc:slug "rb-0049-motion-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0021-robot-kinematics ;
    vc:uses ngm:rrt-algorithm .
ngm:rb-0051-trajectory-planning a owl:Class ;
    rdfs:comment "Trajectory planning is the process of computing a time-parametrised path — specifying position, velocity, and acceleration profiles — that moves a robot from a start configuration to a goal while satisfying kinematic and dynamic constraints, joint limits, and task requirements. It extends path planning by assigning timing to waypoints, enabling smooth, jerk-limited motions suitable for real-time execution by a robot controller."@en ;
    rdfs:label "rb 0051 trajectory planning"@en ;
    rdfs:subClassOf ngm:motion-planning ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    rdfs:subClassOf _:r22939 ;
    rdfs:subClassOf _:r22940 ;
    rdfs:subClassOf _:r22941 ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0044-velocity ;
    vc:relatedTo ngm:rb-0045-acceleration ;
    vc:relatedTo ngm:rb-0052-collision-avoidance ;
    vc:requires ngm:rb-0021-robot-kinematics ;
    vc:requires ngm:rb-0022-robot-dynamics ;
    vc:requires ngm:rb-0049-motion-planning ;
    vc:slug "rb-0051-trajectory-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:optimal-control ;
    vc:uses ngm:rb-0048-pid-controller .
ngm:rb-0052-collision-avoidance a owl:Class ;
    rdfs:comment "Collision avoidance in robotics is the capability of a robot system to detect and react to obstacles — including other robots, infrastructure, and human operators — so as to prevent physical contact that could cause damage or injury. It encompasses both reactive techniques (e.g. potential field methods, velocity obstacles) and proactive planning approaches that embed free-space constraints into the trajectory from the outset. It is a prerequisite for safe autonomous navigation and collaborative operation."@en ;
    rdfs:label "rb 0052 collision avoidance"@en ;
    rdfs:subClassOf ngm:motion-planning ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    rdfs:subClassOf _:r22942 ;
    rdfs:subClassOf _:r22943 ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:dependsOn ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:obstacle-avoidance ;
    vc:relatedTo ngm:rb-0092-protective-stop ;
    vc:relatedTo ngm:rb-0095-safety-zone ;
    vc:relatedTo ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0049-motion-planning ;
    vc:requires ngm:rb-0066-robot-sensor ;
    vc:slug "rb-0052-collision-avoidance" ;
    vc:sourceDomain "robotics" .
ngm:rb-0053-force-control a owl:Class ;
    rdfs:comment "Force control is a robot control paradigm in which the controller regulates the interaction force between the end-effector and its environment, rather than purely tracking a desired position trajectory. By closing the loop on measured contact forces from a force-torque sensor, the robot can perform compliant tasks such as surface grinding, peg-in-hole insertion, and human-robot handover without requiring precise environmental models. The main architectures are impedance control, admittance control, and hybrid position/force control, each suited to different environment stiffness regimes."@en ;
    rdfs:label "rb 0053 force control"@en ;
    rdfs:subClassOf ngm:control-system ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22944 ;
    rdfs:subClassOf _:r22945 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance ;
    vc:relatedTo ngm:rb-0056-impedance-control ;
    vc:relatedTo ngm:rb-0057-admittance-control ;
    vc:relatedTo ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0047-feedback-control ;
    vc:requires ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0053-force-control" ;
    vc:sourceDomain "robotics" .
ngm:rb-0054-position-control a owl:Class ;
    rdfs:comment "Position control is a robot control strategy in which the primary objective is to drive each joint or end-effector to a desired spatial configuration, using closed-loop feedback from encoders or resolvers to minimise position error. It forms the foundation for precise manipulation tasks and is typically implemented via PID controllers, and may be combined with force or impedance control for compliant operation in contact-rich environments."@en ;
    rdfs:label "rb 0054 position control"@en ;
    rdfs:subClassOf ngm:motion-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22946 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0053-force-control ;
    vc:relatedTo ngm:rb-0055-velocity-control ;
    vc:relatedTo ngm:rb-0056-impedance-control ;
    vc:requires ngm:rb-0051-trajectory-planning ;
    vc:slug "rb-0054-position-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0091-safety-rated-monitored-stop ;
    vc:uses ngm:rb-0047-feedback-control ;
    vc:uses ngm:rb-0048-pid-controller ;
    vc:uses ngm:rb-0072-encoder .
ngm:rb-0055-velocity-control a owl:Class ;
    rdfs:comment "Velocity control is a robot control strategy in which joint or Cartesian velocities are the primary commanded quantities, with a feedback controller (typically PID-based) continuously correcting deviations between desired and measured velocities. It is used for smooth trajectory following, compliant interaction with soft contacts, and speed-and-separation monitoring safety functions that require real-time speed capping. Velocity control is distinct from position control — it does not inherently resist positional drift — and from torque control, which acts at the force level."@en ;
    rdfs:label "rb 0055 velocity control"@en ;
    rdfs:subClassOf ngm:motion-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22947 ;
    rdfs:subClassOf _:r22948 ;
    rdfs:subClassOf _:r22949 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0092-protective-stop ;
    vc:enables ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:position-control ;
    vc:relatedTo ngm:torque-control ;
    vc:relatedTo ngm:velocity ;
    vc:relatedTo ngm:velocity-control ;
    vc:requires ngm:encoder ;
    vc:requires ngm:feedback-control ;
    vc:requires ngm:pid-controller ;
    vc:slug "rb-0055-velocity-control" ;
    vc:sourceDomain "robotics" .
ngm:rb-0056-impedance-control a owl:Class ;
    rdfs:comment "Impedance control is a robot interaction-control strategy that regulates the dynamic relationship between end-effector force and motion by imposing a desired mechanical impedance (mass, damping, stiffness) on the robot's behaviour at the point of contact. Rather than commanding precise positions or forces independently, impedance control allows compliant, safe physical interaction with humans or uncertain environments by shaping the robot's apparent mechanical response. It is fundamental to collaborative robotics, enabling robots to yield to external forces in a controlled manner without requiring an explicit force setpoint."@en ;
    rdfs:label "rb 0056 impedance control"@en ;
    rdfs:subClassOf ngm:interaction-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22950 ;
    rdfs:subClassOf _:r22951 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance ;
    vc:relatedTo ngm:rb-0053-force-control ;
    vc:relatedTo ngm:rb-0057-admittance-control ;
    vc:requires ngm:rb-0067-force-torque-sensor ;
    vc:requires ngm:rb-0072-encoder ;
    vc:slug "rb-0056-impedance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0007-collaborative-robot ;
    vc:supports ngm:rb-0094-power-and-force-limiting .
ngm:rb-0057-admittance-control a owl:Class ;
    rdfs:comment "Admittance control is an interaction-control strategy in which a robot measures contact forces and torques and converts them into corresponding desired motion (position or velocity) using a virtual mass-spring-damper model. It is the dual of impedance control: the robot senses force input and renders motion output, enabling compliant, safe physical human-robot interaction in collaborative tasks."@en ;
    rdfs:label "rb 0057 admittance control"@en ;
    rdfs:subClassOf ngm:interaction-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22952 ;
    rdfs:subClassOf _:r22953 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control ;
    vc:relatedTo ngm:rb-0041-inertia ;
    vc:relatedTo ngm:rb-0053-force-control ;
    vc:relatedTo ngm:rb-0056-impedance-control ;
    vc:requires ngm:force-control ;
    vc:requires ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0057-admittance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction ;
    vc:supports ngm:rb-0094-power-and-force-limiting .
ngm:rb-0060-optimal-control a owl:Class ;
    rdfs:comment "Optimal control is a branch of control theory that computes control inputs minimising (or maximising) a performance criterion — such as energy consumption, time, or tracking error — subject to system dynamics and constraints. In robotics, optimal control underpins trajectory optimisation, model predictive control, and reinforcement learning-based policy synthesis."@en ;
    rdfs:label "rb 0060 optimal control"@en ;
    rdfs:subClassOf ngm:control-theory ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0064-computed-torque-control ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0047-feedback-control ;
    vc:relatedTo ngm:rb-0062-model-predictive-control ;
    vc:relatedTo ngm:reinforcement-learning ;
    vc:slug "rb-0060-optimal-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0022-robot-dynamics ;
    vc:uses ngm:rb-0030-jacobian-matrix .
ngm:rb-0061-nonlinear-control a owl:Class ;
    rdfs:comment "Nonlinear control encompasses control strategies designed for systems whose dynamics cannot be adequately described by linear differential equations. In robotics, virtually all manipulators and mobile platforms exhibit nonlinear behaviour due to inertia coupling, Coriolis terms, gravity loading, and joint friction. Nonlinear control techniques—including computed-torque control, sliding-mode control, feedback linearisation, Lyapunov-based methods, and model predictive control—explicitly account for these nonlinearities to achieve stable, high-performance trajectory tracking across the full operating envelope."@en ;
    rdfs:label "rb 0061 nonlinear control"@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    rdfs:subClassOf _:r22954 ;
    rdfs:subClassOf _:r22955 ;
    rdfs:subClassOf _:r22956 ;
    rdfs:subClassOf _:r22957 ;
    rdfs:subClassOf _:r22958 ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0048-pid-controller ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0062-model-predictive-control ;
    vc:hasPart ngm:rb-0063-sliding-mode-control ;
    vc:hasPart ngm:rb-0064-computed-torque-control ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control ;
    vc:relatedTo ngm:rb-0047-feedback-control ;
    vc:relatedTo ngm:rb-0060-optimal-control ;
    vc:requires ngm:rb-0021-robot-kinematics ;
    vc:requires ngm:rb-0022-robot-dynamics ;
    vc:slug "rb-0061-nonlinear-control" ;
    vc:sourceDomain "robotics" .
ngm:rb-0062-model-predictive-control a owl:Class ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced optimal control strategy that uses an explicit mathematical model of the plant to predict future system behaviour over a finite receding horizon, then solves an optimisation problem at each control step to determine the input sequence that minimises a cost function subject to state and input constraints. Only the first element of the computed sequence is applied before the optimisation is repeated. In robotics, MPC enables constraint-aware trajectory tracking, force regulation, and whole-body motion planning that classical PID controllers cannot achieve."@en ;
    rdfs:label "rb 0062 model predictive control"@en ;
    rdfs:subClassOf ngm:optimal-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0048-pid-controller ;
    vc:contrastsWith ngm:rb-0063-sliding-mode-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:dependsOn ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0049-motion-planning ;
    vc:enables ngm:rb-0056-impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0060-optimal-control ;
    vc:relatedTo ngm:rb-0061-nonlinear-control ;
    vc:relatedTo ngm:state-space-control ;
    vc:slug "rb-0062-model-predictive-control" ;
    vc:sourceDomain "robotics" .
ngm:rb-0063-sliding-mode-control a owl:Class ;
    rdfs:comment "Sliding Mode Control (SMC) is a nonlinear robust control technique that drives system states onto a predefined sliding surface in state space and then maintains them on that surface using discontinuous (switching) control actions. Once on the sliding manifold, the system dynamics become insensitive to matched disturbances and parameter uncertainties, making SMC highly robust for robot manipulators with uncertain dynamics, friction, and external loads. A key challenge is chattering — high-frequency oscillation caused by the switching law — which is addressed through boundary layer methods and higher-order SMC variants."@en ;
    rdfs:label "rb 0063 sliding mode control"@en ;
    rdfs:subClassOf ngm:control-theory ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0062-model-predictive-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0053-force-control ;
    vc:enables ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control ;
    vc:relatedTo ngm:rb-0048-pid-controller ;
    vc:relatedTo ngm:rb-0061-nonlinear-control ;
    vc:relatedTo ngm:robust-control ;
    vc:slug "rb-0063-sliding-mode-control" ;
    vc:sourceDomain "robotics" .
ngm:rb-0064-computed-torque-control a owl:Class ;
    rdfs:comment "Computed torque control (CTC) is a model-based robot control strategy that uses the full inverse dynamics model of a manipulator to compute the joint torques required to follow a desired trajectory. By cancelling the nonlinear dynamics — including Coriolis, centripetal, and gravitational terms — CTC transforms the closed-loop system into a set of independent linear double-integrators, enabling simple PD outer-loop controllers to achieve high-accuracy tracking. Its effectiveness depends on the fidelity of the dynamic model and is sensitive to parameter uncertainty."@en ;
    rdfs:label "rb 0064 computed torque control"@en ;
    rdfs:subClassOf ngm:model-based-control ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0056-impedance-control ;
    vc:relatedTo ngm:rb-0061-nonlinear-control ;
    vc:relatedTo ngm:rb-0062-model-predictive-control ;
    vc:slug "rb-0064-computed-torque-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0043-torque ;
    vc:uses ngm:rb-0048-pid-controller .
ngm:rb-0065-visual-servoing a owl:Class ;
    rdfs:comment "Visual servoing is a robot control technique that uses real-time visual feedback from a camera to regulate the motion of a robot toward a goal configuration. Image-based visual servoing (IBVS) minimises an image-feature error directly, while position-based visual servoing (PBVS) reconstructs 3-D pose from vision before computing Cartesian control signals. The approach is widely used in manipulation, assembly, and tracking tasks where precise end-effector placement relative to a visually perceived target is required."@en ;
    rdfs:label "rb 0065 visual servoing"@en ;
    rdfs:subClassOf ngm:feedback-control ;
    rdfs:subClassOf ngm:robo-perception ;
    rdfs:subClassOf _:r22959 ;
    rdfs:subClassOf _:r22960 ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:object-detection ;
    vc:relatedTo ngm:pose-estimation ;
    vc:relatedTo ngm:rb-0064-computed-torque-control ;
    vc:requires ngm:rb-0030-jacobian-matrix ;
    vc:requires ngm:rb-0047-feedback-control ;
    vc:slug "rb-0065-visual-servoing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision ;
    vc:uses ngm:feature-extraction ;
    vc:uses ngm:rb-0068-vision-system .
ngm:rb-0066-robot-sensor a owl:Class ;
    rdfs:comment "A robot sensor is a transducer or measurement device integrated into or used by a robot system to acquire information about the robot's own state or its surrounding environment. Robot sensors span proprioceptive types — such as encoders, IMUs, and force-torque sensors — and exteroceptive types such as vision systems, LiDAR, radar, and proximity sensors. The data they provide forms the perceptual basis for control, motion planning, and safety functions."@en ;
    rdfs:label "rb 0066 robot sensor"@en ;
    rdfs:subClassOf ngm:robo-perception ;
    rdfs:subClassOf _:r22961 ;
    rdfs:subClassOf _:r22962 ;
    rdfs:subClassOf _:r22963 ;
    rdfs:subClassOf _:r22964 ;
    rdfs:subClassOf _:r22965 ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:sensor ;
    vc:enables ngm:rb-0052-collision-avoidance ;
    vc:enables ngm:rb-0105-speed-and-separation-monitoring ;
    vc:hasMaturity ngmi:maturity-emerging ;
