# Distributed Authentication Architecture
infrastructure:DistributedAuthenticationArchitecture rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:IdentityManagement ;
    rdfs:label "Distributed Authentication Architecture"@en ;
    rdfs:comment "A decentralised identity authentication and management framework leveraging blockchain technology and self-sovereign identity (SSI) principles to enable secure, privacy-preserving user authentication across multiple metaverse platforms without relying on centralised credential storage."@en ;
    skos:prefLabel "Distributed Authentication Architecture"@en ;
