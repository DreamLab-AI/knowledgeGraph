        ngm:software-architecture,
        ngm:software-testing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agile-software-development,
        ngm:open-source-development,
        ngm:technical-debt ;
    vc:requires ngm:programming-paradigm ;
    vc:slug "software-development" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:digital-transformation,
        ngm:software-supply-chain ;
    vc:uses ngm:continuous-integration,
        ngm:programming-language,
        ngm:software-development-process,
        ngm:version-control .

ngm:state-estimation a owl:Class ;
    rdfs:label "State Estimation"@en ;
    rdfs:comment "State Estimation is the computational discipline of inferring the latent, unobservable internal state of a dynamical system — such as position, velocity, orientation, and joint angles — from a sequence of noisy, incomplete sensor measurements, using probabilistic inference frameworks. Core algorithms include the Kalman Filter and its nonlinear extensions (EKF, UKF), particle filters, and factor-graph optimisation methods that maintain a belief distribution over state variables over time. The field underpins autonomous navigation, robotic manipulation, aerospace guidance systems, and any cyber-physical system that must act on estimated rather than directly observed quantities. Modern formulations unify Bayesian filtering, maximum-a-posteriori smoothing, and deep-learning-based perception to achieve robust estimation under sensor failure, model mismatch, and adversarial environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:particle-filter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kalman-filter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:extended-kalman-filter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:factor-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:probabilistic-inference ;
    vc:bridgesTo ngm:deep-learning,
        ngm:digital-twin ;
    vc:contrastsWith ngm:open-loop-control ;
    vc:dependsOn ngm:bayesian-inference,
        ngm:linear-algebra,
        ngm:stochastic-processes ;
    vc:enables ngm:autonomous-system,
        ngm:navigation,
        ngm:robot-control,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:extended-kalman-filter,
        ngm:factor-graph,
        ngm:kalman-filter,
        ngm:particle-filter ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:path-planning,
        ngm:robot-dynamics,
        ngm:signal-processing ;
    vc:requires ngm:imu,
        ngm:probabilistic-model,
        ngm:sensor-fusion,
        ngm:system-dynamics ;
    vc:slug "state-estimation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:gps,
        ngm:lidar,
        ngm:visual-odometry,
        ngm:wheel-odometry .

ngm:stochastic-gradient-descent a owl:Class ;
    rdfs:label "Stochastic Gradient Descent"@en ;
    rdfs:comment "Stochastic Gradient Descent (SGD) is an iterative optimisation algorithm that updates model parameters by computing gradients from randomly sampled mini-batches rather than the full training dataset, trading gradient accuracy for computational efficiency and the ability to escape shallow local minima. SGD and its adaptive variants (Adam, RMSprop, AdaGrad) are the primary training algorithms for deep neural networks across vision, language, and reinforcement learning domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mini-batch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:gradient-descent ;
    vc:bridgesTo ngm:distributed-computing,
        ngm:scientific-computing ;
    vc:contrastsWith ngm:batch-gradient-descent,
        ngm:second-order-optimisation ;
    vc:dependsOn ngm:automatic-differentiation,
        ngm:computational-graph ;
    vc:enables ngm:deep-learning,
        ngm:federated-learning,
        ngm:large-language-model,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:learning-rate-schedule,
        ngm:mini-batch ;
    vc:implements ngm:first-order-optimisation ;
    vc:isPartOf ngm:model-training ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adam-optimiser,
        ngm:hyperparameter-optimisation,
        ngm:reinforcement-learning,
        ngm:transfer-learning ;
    vc:requires ngm:backpropagation,
        ngm:learning-rate,
        ngm:loss-function ;
    vc:slug "stochastic-gradient-descent" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computer-vision,
        ngm:natural-language-processing ;
    vc:uses ngm:gpu-computing,
        ngm:machine-learning-discipline .

ngm:sybil-resistance a owl:Class ;
    rdfs:label "Sybil Resistance"@en ;
    rdfs:comment "Sybil resistance is a security property of distributed and decentralised networks that constrains the ability of a single adversary to gain disproportionate influence by fabricating multiple pseudonymous or fake identities. The property is foundational to any permissionless system where voting power, reputation, resource allocation, or participation rights are tied to the concept of a unique participant. Mechanisms achieving sybil resistance range from resource-binding consensus protocols — proof-of-work and proof-of-stake — to cryptographic proof-of-personhood schemes and social trust-graph analysis, each balancing security guarantees against privacy requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:51-attack,
        ngm:eclipse-attack,
        ngm:sybil-attack ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:public-key-cryptography ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:decentralised-governance,
        ngm:quadratic-voting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:humanity-attestation,
        ngm:proof-of-personhood,
        ngm:reputation-system,
        ngm:verifiable-credential-vc,
        ngm:web-of-trust ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-proof,
        ngm:identity-verification ;
    vc:slug "sybil-resistance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:biometric-authentication,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:trust-graph,
        ngm:zero-knowledge-proof .

ngm:avatar-system a owl:Class ;
