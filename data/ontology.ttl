ngm:threat-surface-map a owl:Class ;
    rdfs:label "Threat Surface Map"@en ;
    rdfs:comment "A comprehensive security visualization and inventory framework that identifies, catalogs, and models all potential attack vectors, vulnerability exposure points, and threat entry paths across network, application, data, identity, and infrastructure layers of a system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-model ],
        ngm:metaverse-and-spatial-risks,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:compliance-verification,
        ngm:incident-response,
        ngm:penetration-testing,
        ngm:risk-assessment,
        ngm:security-audit,
        ngm:security-posture-management ;
    vc:hasMaturity ngmi:maturity-draft ;
