# AR Technology
spatial-computing:ARTechnology rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ExtendedReality ;
    rdfs:label "AR Technology"@en ;
    rdfs:comment "AR Technology encompasses the hardware, software, and algorithmic systems enabling real-time digital content overlay on physical environments. Core components include AR Registration, Computer Vision, 3D Rendering Engines, and Sensor Input fusion, spanning applications from mobile filters to enterprise industrial systems requiring precise spatial anchoring and persistent content management."@en ;
    skos:prefLabel "AR Technology"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:ar-technology" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:ar-technology> ;
