ngm:layer-zero a owl:Class ;
    rdfs:label "LayerZero"@en ;
    rdfs:comment "LayerZero is a cross-chain interoperability protocol that allows smart contracts on different blockchains to send messages to one another. It uses a configurable security model in which an oracle delivers block headers and an independent relayer delivers transaction proofs, with a message accepted only when the two agree. This separation is intended to avoid reliance on a single intermediary chain for verifying cross-chain communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:relayer ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:bridge,
        ngm:distributed-systems,
        ngm:interoperability ;
    vc:contrastsWith ngm:axelar,
        ngm:ibc,
        ngm:polkadot-xcm,
        ngm:wormhole ;
    vc:dependsOn ngm:evm-compatible-blockchain,
        ngm:oracle-network ;
    vc:enables ngm:cross-chain-governance,
        ngm:cross-chain-messaging,
        ngm:omnichain-application,
        ngm:token-bridge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cross-chain-interoperability,
        ngm:message-passing-interface ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:fungible-token ;
    vc:requires ngm:oracle,
        ngm:relayer,
        ngm:smart-contract ;
    vc:slug "layer-zero" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cross-chain-liquidity,
        ngm:defi-protocol,
        ngm:nft-bridging ;
    vc:uses ngm:block-header,
        ngm:light-node,
        ngm:transaction .

ngm:ldap a owl:Class ;
    rdfs:label "LDAP"@en ;
    rdfs:comment "The Lightweight Directory Access Protocol (LDAP) is an open, vendor-neutral application protocol for accessing and maintaining distributed directory information services over an IP network, standardised in RFC 4511 (2006) as a simplification of the X.500 Directory Access Protocol. LDAP organises directory entries in a hierarchical tree structure (Directory Information Tree, DIT) where entries contain typed attribute-value pairs conforming to object class schemas, and supports operations for search, add, modify, delete, compare, and bind (authentication). It serves as the foundational protocol for enterprise identity management, enabling centralised authentication, authorisation, and user attribute storage across heterogeneous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:active-directory,
        ngm:oauth-2-0,
        ngm:saml ;
    vc:contrastsWith ngm:kerberos,
        ngm:scim ;
    vc:enables ngm:access-control,
        ngm:authentication,
        ngm:identity-management,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:directory-service,
        ngm:federated-identity,
        ngm:identity-and-access-management ;
    vc:requires ngm:tcp-ip,
        ngm:tls ;
    vc:slug "ldap" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:enterprise-architecture,
        ngm:multi-factor-authentication,
        ngm:zero-trust-architecture .

ngm:learning-module a owl:Class ;
    rdfs:label "Learning Module"@en ;
    rdfs:comment "Self-contained educational units within VR and metaverse training systems that provide structured learning experiences, including interactive simulations, assessments, and collaborative activities designed for specific skill development objectives."@en ;
    rdfs:subClassOf ngm:educational-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
