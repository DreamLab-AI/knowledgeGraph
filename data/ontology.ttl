    vc:slug "ground-truth-labels" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:machine-learning-model ;
    vc:uses ngm:data-annotation .

ngm:imitation-learning a owl:Class ;
    rdfs:label "Imitation Learning"@en ;
    rdfs:comment "Imitation Learning (IL), also termed Learning from Demonstration (LfD) or Programming by Demonstration (PbD), is the sequential-decision-making paradigm in which an autonomous agent acquires a policy π(a|s) mapping observations to actions by mimicking expert demonstrations rather than by maximisi..."@en ;
