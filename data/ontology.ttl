        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:collision-detection,
        ngm:configuration-space ;
    vc:slug "rrt-algorithm" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:collision-detection,
        ngm:nearest-neighbor-search .

ngm:safety-fine-tuning a owl:Class ;
    rdfs:label "Safety Fine Tuning"@en ;
    rdfs:comment "Safety Fine Tuning is a specialised training stage applied after general capability training to reduce harmful outputs and align model behaviour with safety principles. It employs safety-curated datasets, RLHF, and constitutional AI objectives to harden models against adversarial misuse and emergent misalignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        ngm:ai-alignment,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:governance,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:adversarial-attack,
        ngm:jailbreaking ;
    vc:dependsOn ngm:human-feedback,
        ngm:reward-model ;
    vc:enables ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:constitutional-ai-training-methodology,
        ngm:direct-preference-optimisation,
        ngm:supervised-fine-tuning ;
