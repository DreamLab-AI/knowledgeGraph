ngm:change-management a owl:Class ;
    rdfs:label "Change Management"@en ;
    rdfs:comment "Change Management is the structured discipline of guiding organisations, teams, and individuals through transitions in technology, process, or culture to achieve desired outcomes whilst minimising disruption and resistance. It encompasses planning, communication, training, stakeholder alignment, and feedback loops that collectively ensure adoption of new working methods. In technology contexts it also covers the formal control of modifications to systems and infrastructure to reduce risk. Effective change management is widely recognised as a critical determinant of whether digital transformation initiatives deliver their intended value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impact-assessment ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration,
        ngm:infrastructure ;
    vc:contrastsWith ngm:technical-debt ;
    vc:enables ngm:ai-adoption,
        ngm:continuous-improvement,
        ngm:workforce-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:impact-assessment ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-transformation,
        ngm:enterprise-architecture,
        ngm:human-factors,
        ngm:organisational-resilience,
        ngm:stakeholder-engagement ;
    vc:slug "change-management" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance,
        ngm:risk-management ;
    vc:uses ngm:audit-trail,
        ngm:compliance-monitoring,
        ngm:risk-assessment .

ngm:character-rigging a owl:Class ;
    rdfs:label "Character Rigging"@en ;
    rdfs:comment "The process of creating a hierarchical skeleton of interconnected bones and joints within a 3D character model, along with control systems and deformation rules, enabling animators to manipulate the mesh through inverse kinematics and forward kinematics for realistic movement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:skinning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:character-model ],
        ngm:animation-technique,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:character-animation,
        ngm:motion-capture,
        ngm:skeletal-animation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:character-model,
        ngm:skinning ;
    vc:slug "character-rigging" ;
    vc:sourceDomain "spatial-computing" .

ngm:cloud-platform a owl:Class ;
    rdfs:label "Cloud Platform"@en ;
    rdfs:comment "A cloud platform is an integrated suite of managed infrastructure, runtime services, and developer tooling delivered over the internet that enables organisations to build, deploy, scale, and operate applications without owning physical hardware. Cloud platforms abstract away operational complexity through pay-as-you-go pricing, elastic scaling, and managed service lifecycles, spanning IaaS, PaaS, and SaaS delivery models. The dominant hyperscale providers — Amazon Web Services, Microsoft Azure, and Google Cloud Platform — offer hundreds of services covering compute, storage, networking, databases, AI/ML, security, and observability, forming the primary substrate for modern enterprise and AI workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:container-orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:microservices-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtualisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technology-infrastructure-domain-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serverless-architecture ],
        ngm:cloud-infrastructure ;
    vc:bridgesTo ngm:foundation-model,
        ngm:inference-infrastructure ;
    vc:contrastsWith ngm:edge-computing ;
    vc:dependsOn ngm:data-centre,
        ngm:internet-protocol ;
    vc:enables ngm:cloud-native-applications,
        ngm:continuous-integration,
        ngm:devops,
        ngm:machine-learning-discipline-infrastructure,
        ngm:machine-learning-discipline-platform,
        ngm:platform-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:container-orchestration,
        ngm:microservices-architecture,
        ngm:platform-layer,
        ngm:platform-service,
        ngm:serverless-architecture,
        ngm:technology-infrastructure-domain-component ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:platform-governance,
