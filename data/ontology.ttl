    vc:enables ngm:asset-life-extension,
        ngm:carbon-footprint-measurement,
        ngm:maintenance-cost-optimisation,
        ngm:operational-reliability,
        ngm:safety-assurance,
        ngm:unplanned-downtime-reduction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
        ngm:cmms-integration,
        ngm:digital-twin,
        ngm:fault-classification,
        ngm:health-index,
        ngm:iio-t-sensors,
        ngm:remaining-useful-life-estimation,
