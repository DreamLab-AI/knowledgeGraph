ngm:quantum-ai a owl:Class ;
    rdfs:label "Quantum AI"@en ;
    rdfs:comment "Quantum AI is a research area at the intersection of quantum computing and artificial intelligence, applying quantum mechanical phenomena — superposition, entanglement, and interference — to accelerate or qualitatively improve machine learning algorithms, combinatorial optimisation, and probabilistic inference. Quantum circuits can in principle represent exponentially large state spaces with polynomial resources, offering potential speed-ups for specific learning and search tasks beyond classical limits. The field encompasses variational quantum algorithms, quantum neural networks, quantum-enhanced sampling, and the use of quantum hardware as accelerators within classical AI pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-computation-paradigm ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:deep-learning,
        ngm:optimization-algorithm ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:compute-infrastructure,
        ngm:cryptography,
        ngm:neural-network,
        ngm:post-quantum-cryptography,
        ngm:quantum-network-node ;
