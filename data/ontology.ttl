        ngm:object-manipulation,
        ngm:sim-to-real-transfer,
        ngm:teleoperation ;
    vc:requires ngm:contact-mechanics,
        ngm:robot-kinematics,
        ngm:robot-perception ;
    vc:slug "robot-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
