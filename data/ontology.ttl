    vc:uses ngm:api-gateway,
        ngm:data-pipeline,
        ngm:kubernetes,
        ngm:version-control .

ngm:cross-platform-interoperability a owl:Class ;
    rdfs:label "Cross-Platform Interoperability"@en ;
    rdfs:comment "The capability for heterogeneous blockchain networks, software platforms, and distributed systems to communicate, exchange data, and transfer value seamlessly without centralized intermediaries. Achieved through standardized protocols, light-client verification, and message-passing frameworks that eliminate trusted third parties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
