        ngm:slam-toolbox .

ngm:high-frequency-trading a owl:Class ;
    rdfs:label "High-Frequency Trading"@en ;
    rdfs:comment "High-frequency trading (HFT) is a form of automated electronic trading characterised by very high order submission rates, extremely short holding periods and a reliance on minimising latency to gain advantage. HFT firms use co-located servers, optimised networking and algorithmic strategies to react to market signals in microseconds, often acting as market makers or capturing fleeting price discrepancies. It is a dominant participant in modern equity, futures and foreign-exchange markets and a central subject of market microstructure research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:market-microstructure ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:mev ;
    vc:contrastsWith ngm:market-making ;
    vc:dependsOn ngm:latency ;
    vc:enables ngm:liquidity,
        ngm:market-making ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:market-microstructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:order-book,
        ngm:quantitative-finance,
        ngm:risk-management ;
    vc:requires ngm:latency ;
    vc:slug "high-frequency-trading" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:order-book .

ngm:horizontal-scalability a owl:Class ;
    rdfs:label "Horizontal Scalability"@en ;
    rdfs:comment "Horizontal scalability is the capacity of a system to increase throughput by adding more independent nodes rather than upgrading a single machine (vertical scaling). It relies on partitioning work and state so that load can be distributed across commodity servers behind a balancer. Horizontal scaling underpins cloud-native and distributed architectures because it offers near-linear, fault-tolerant growth."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:distributed-systems ;
    vc:slug "horizontal-scalability" ;
    vc:sourceDomain "infrastructure" .

ngm:inclusive-design a owl:Class ;
    rdfs:label "Inclusive Design"@en ;
    rdfs:comment "Inclusive design is a design methodology and philosophy that creates products, services, environments, and digital experiences to be usable by the widest possible range of people across diverse abilities, ages, languages, cultures, and contexts, without requiring specialised adaptations or separate versions for different user groups. It treats human diversity as a design resource rather than a problem to be accommodated, recognising that designing for people with disabilities, situational impairments, or non-standard use contexts typically produces solutions that benefit all users. The approach is distinct from universal design in emphasising process — including people with diverse characteristics as active co-designers throughout — rather than solely optimising for a single configuration serving all. Across digital, spatial, and AI-mediated systems, inclusive design establishes both participatory methods and measurable technical criteria that reduce systematic exclusion."@en ;
    rdfs:subClassOf ngm:universal-design ;
    vc:bridgesTo ngm:ai-fairness,
        ngm:algorithmic-bias,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:retrofitting,
        ngm:universal-design ;
    vc:enables ngm:assistive-technology,
        ngm:digital-technology-access-equity,
        ngm:inclusive-participation,
        ngm:inclusive-xr-design,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:accessibility-standard,
        ngm:design-thinking,
        ngm:digital-technology-access-equity,
        ngm:disability-rights,
        ngm:usability ;
    vc:requires ngm:co-design,
        ngm:user-centred-design ;
    vc:slug "inclusive-design" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:wai-aria,
        ngm:wcag-2-2 ;
    vc:uses ngm:accessibility,
        ngm:human-computer-interaction,
        ngm:interaction-design,
        ngm:participatory-design,
        ngm:user-research .

ngm:instrumentation a owl:Class ;
    rdfs:label "Instrumentation"@en ;
    rdfs:comment "Instrumentation is the practice of adding code, agents, or probes to software and systems so that they emit measurable signals — metrics, logs, traces, and events — about their internal behaviour and performance. It is the foundational producer of telemetry that downstream observability and monitoring tooling consumes. Without instrumentation a system is opaque; with it, operators gain insight into how the system actually runs in production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-tracing ],
        ngm:observability ;
    vc:enables ngm:anomaly-detection,
        ngm:real-time-monitoring,
        ngm:telemetry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:distributed-tracing,
        ngm:logging,
        ngm:metrics ;
    vc:isPartOf ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:devops,
        ngm:monitoring ;
    vc:requires ngm:code-profiling ;
    vc:slug "instrumentation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:alerting,
        ngm:root-cause-analysis,
        ngm:site-reliability-engineering ;
    vc:uses ngm:standards .

ngm:intellectual-property-rights a owl:Class ;
    rdfs:label "Intellectual Property Rights"@en ;
    rdfs:comment "Intellectual property rights are the legally recognised exclusive entitlements granted to creators and owners over the products of human intellect, such as inventions, literary and artistic works, designs, symbols and names. They include patents, copyright, trademarks and trade secrets, each conferring time-bounded or perpetual control over use, reproduction and commercial exploitation. In blockchain contexts these rights are increasingly represented, transferred and enforced through tokenisation and on-chain licensing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:licensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation ],
        ngm:governance ;
    vc:bridgesTo ngm:smart-contract ;
    vc:contrastsWith ngm:creative-commons,
        ngm:open-source ;
    vc:dependsOn ngm:licensing,
        ngm:regulation ;
    vc:enables ngm:licensing,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:non-fungible-token,
        ngm:patent,
        ngm:tokenization ;
    vc:requires ngm:licensing,
        ngm:regulation ;
    vc:slug "intellectual-property-rights" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-rights-management,
        ngm:non-fungible-token,
        ngm:tokenization ;
    vc:uses ngm:digital-rights-management,
        ngm:smart-contract .

ngm:interoperability-framework a owl:Class ;
    rdfs:label "Interoperability Framework"@en ;
    rdfs:comment "Coordinated set of standards and specifications enabling interaction between heterogeneous systems in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-documentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-integration-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:universal-manifest ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technical-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardization-bodies ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:scalable-architecture,
        ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-format,
        ngm:data-integration-interface,
        ngm:metadata-standard,
        ngm:technical-standards,
        ngm:universal-manifest ;
    vc:isPartOf ngm:metaverse-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:standardization-bodies,
        ngm:technical-documentation ;
    vc:slug "interoperability-framework" ;
    vc:sourceDomain "infrastructure" .

ngm:iosco a owl:Class ;
    rdfs:label "IOSCO"@en ;
    rdfs:comment "The International Organisation of Securities Commissions (IOSCO) is the principal global standard-setting body for securities and capital markets regulation, founded in 1983 and headquartered in Madrid, with membership spanning national securities regulators and self-regulatory organisations from over 130 jurisdictions. IOSCO develops and publishes Objectives and Principles of Securities Regulation, Recommendations, and targeted policy reports adopted by member regulators to promote fair, efficient, and transparent capital markets, protect investors, and reduce systemic risk. Its remit has expanded to cover digital asset markets, crypto-asset intermediaries, decentralised finance, and AI-driven algorithmic trading, making it a central node in the global financial regulatory architecture alongside the Financial Stability Board and Basel Committee."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-enforcement ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:algorithmic-trading,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:bis,
        ngm:fatf ;
    vc:enables ngm:capital-markets,
        ngm:cross-border-regulatory-cooperation,
        ngm:market-surveillance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:securities-regulation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:basel-committee,
        ngm:digital-asset-market,
        ngm:financial-stability-board,
        ngm:g20,
        ngm:imf,
        ngm:systemic-risk ;
    vc:requires ngm:information-sharing,
        ngm:regulatory-enforcement ;
    vc:slug "iosco" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:financial-regulation ;
    vc:supports ngm:financial-stability,
        ngm:investor-protection,
        ngm:market-integrity,
        ngm:securities-regulation ;
    vc:uses ngm:fsap,
        ngm:multilateral-memorandum-of-understanding .

ngm:iot-device a owl:Class ;
    rdfs:label "IoT Device"@en ;
    rdfs:comment "An IoT device is a networked physical object embedding sensing, processing and communication capabilities that allows it to collect, exchange and act on data over a network. Such devices range from simple sensors and actuators to complex embedded systems, and typically operate under tight power, compute and bandwidth constraints. They form the edge of the Internet of Things, feeding data to gateways, edge nodes and cloud services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        ngm:internet-of-things ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:edge-computing ;
    vc:dependsOn ngm:firewall ;
    vc:enables ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:sensor ;
    vc:implements ngm:embedded-system ;
    vc:isPartOf ngm:internet-of-things ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:embedded-system,
        ngm:internet-protocol ;
    vc:requires ngm:bandwidth ;
    vc:slug "iot-device" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:interoperability ;
    vc:uses ngm:mqtt,
        ngm:network-protocol .

ngm:least-privilege a owl:Class ;
    rdfs:label "Least Privilege"@en ;
    rdfs:comment "Least privilege is a security principle stating that every user, process or component should be granted only the minimum access rights necessary to perform its function, and no more. By limiting permissions to what is strictly required, the principle reduces the attack surface and confines the damage that a compromised account or faulty component can cause. It is a cornerstone of access control and underpins modern approaches such as zero-trust architecture and defence in depth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authorization ],
        ngm:access-control ;
    vc:bridgesTo ngm:endpoint-security ;
    vc:contrastsWith ngm:privilege-escalation ;
    vc:dependsOn ngm:access-control ;
    vc:enables ngm:access-control,
        ngm:defense-in-depth ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authorization,
        ngm:defense-in-depth,
        ngm:identity-and-access-management ;
    vc:requires ngm:authentication,
        ngm:authorization ;
    vc:slug "least-privilege" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:identity-and-access-management,
        ngm:role-based-access-control ;
    vc:uses ngm:role-based-access-control .

ngm:legal-compliance a owl:Class ;
    rdfs:label "Legal Compliance"@en ;
    rdfs:comment "Legal compliance is the systematic set of organisational processes, technical controls, governance structures, and documented evidence through which an entity demonstrates adherence to applicable legislation, regulatory requirements, technical standards, and contractual obligations across the full lifecycle of its products, services, and operations. In AI and digital systems contexts, it spans intersecting regimes including data protection law, sector-specific financial and healthcare regulation, product liability, intellectual property, and dedicated AI legislation such as the EU AI Act. Compliance is operationalised through risk classification, conformity assessment procedures, mandatory documentation, appointed accountability roles, and continuous monitoring programmes. It functions as the bridge between abstract legal obligations and concrete engineering and operational practice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-documentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:federated-learning,
        ngm:privacy-enhancing-technologies,
        ngm:smart-contract ;
    vc:contrastsWith ngm:self-regulation ;
    vc:enables ngm:market-access,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-regulation,
        ngm:data-protection,
        ngm:regulatory-compliance ;
