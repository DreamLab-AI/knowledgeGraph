    vc:relatedTo ngm:economics ;
    vc:slug "robin-hanson-ai-sceptic-economist" ;
    vc:sourceDomain "infrastructure" .
ngm:roblox a owl:Class ;
    rdfs:comment "Roblox is an online platform and storefront that lets users create, publish and play user-generated 3D experiences. It combines a game engine, an authoring environment and a social and economic layer, with creators building experiences that other users can enter as customisable avatars. An in-platform virtual currency underpins a creator economy in which developers monetise their experiences. Roblox is frequently cited as a consumer-scale realisation of metaverse concepts, blending gaming, social interaction and user-generated content."@en ;
    rdfs:label "Roblox"@en ;
    rdfs:subClassOf ngm:metaverse-platform ;
