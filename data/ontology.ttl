        ngm:real-time-control,
        ngm:robotics ;
    vc:uses ngm:colcon-build-system,
        ngm:gazebo-simulator .

ngm:scenario-analysis a owl:Class ;
    rdfs:label "Scenario Analysis"@en ;
    rdfs:comment "Scenario analysis is a structured method for exploring how a system behaves under a set of plausible alternative futures rather than a single forecast. It defines coherent scenarios over key drivers and evaluates outcomes, risks, and decisions across each. It is widely used in financial planning, climate disclosure, and operational risk to stress-test strategies against uncertainty."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment,
        ngm:time-series-forecasting ;
    vc:slug "scenario-analysis" ;
    vc:sourceDomain "data" .

ngm:screen-recording a owl:Class ;
    rdfs:label "Screen Recording"@en ;
    rdfs:comment "Screen recording is the capture of pixel-level output from a computer display — including cursor movement, application windows, and system UI — encoded into a video stream for later playback, streaming, or analysis. It combines display capture with optional audio recording and may include region selection, frame-rate control, hardware-accelerated encoding, and metadata tagging."@en ;
    rdfs:subClassOf ngm:screen-capture ;
    vc:bridgesTo ngm:accessibility ;
    vc:contrastsWith ngm:live-streaming,
        ngm:screenshot ;
    vc:enables ngm:compliance-monitoring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audio-capture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:application-window-capture,
