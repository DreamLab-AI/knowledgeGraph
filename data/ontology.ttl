        ngm:digital-identity,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:coinbase,
        ngm:decentralised-exchange,
        ngm:kraken ;
    vc:dependsOn ngm:blockchain,
        ngm:smart-contract ;
    vc:enables ngm:decentralised-finance,
        ngm:derivatives-trading,
        ngm:spot-trading,
        ngm:staking ;
    vc:hasMaturity ngmi:maturity-established ;
