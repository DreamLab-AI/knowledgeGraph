ngm:account-abstraction a owl:Class ;
    rdfs:label "Account Abstraction"@en ;
    rdfs:comment "A paradigm shift in ereum account architecture standardized through ERC-4337 (March 2023) enabling smart contract wallets with programmable transaction validation logic, decoupled gas payment mechanisms, and flexible account recovery, eliminating the distinction between externally owned accounts ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:bc-protocol-and-consensus,
        ngm:smart-contract ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:account-recovery,
        ngm:batch-operations,
        ngm:gasless-transactions,
        ngm:programmable-validation,
        ngm:session-keys,
        ngm:social-recovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:account-factory,
        ngm:bundler,
        ngm:entry-point-contract,
        ngm:paymaster-contract,
        ngm:signature-aggregator,
        ngm:user-operation ;
    vc:implements ngm:account-model,
        ngm:erc-4337,
        ngm:gas-sponsorship,
        ngm:user-operation-mempool ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:evm,
        ngm:gas-abstraction,
        ngm:signature-verification,
        ngm:smart-contract ;
    vc:slug "account-abstraction" ;
    vc:sourceDomain "blockchain" .

ngm:adam-optimiser a owl:Class ;
    rdfs:label "Adam Optimiser"@en ;
    rdfs:comment "The Adam optimiser (Adaptive Moment Estimation) is a first-order gradient-based optimisation algorithm that maintains exponentially decaying moving averages of both past gradients (first moment) and past squared gradients (second moment) to compute per-parameter adaptive learning rates. It combines the advantages of momentum-based optimisation and the RMSProp algorithm, making it robust to sparse gradients and non-stationary objectives. Adam is the de-facto default optimiser for training transformer-based large language models and deep neural networks across most domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:loss-function ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent ;
    vc:slug "adam-optimiser" ;
    vc:sourceDomain "artificial-intelligence" .

