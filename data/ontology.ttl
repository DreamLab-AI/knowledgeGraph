ngm:site-reliability-engineering a owl:Class ;
    rdfs:label "Site Reliability Engineering"@en ;
    rdfs:comment "Site Reliability Engineering (SRE) is a discipline that applies software engineering principles and practices to operations work, treating infrastructure management and service reliability as software problems to be solved through automation, measurement, and iterative improvement. Originating at Google in the early 2000s, SRE defines explicit reliability targets via Service Level Objectives, manages risk through error budgets, and uses observability tooling to maintain confidence in production systems. SRE practitioners reduce operational toil through systematic automation, implement incident management processes, and balance the competing demands of feature velocity and system stability. The discipline formalises the role of the operations engineer as a software engineer who designs for reliability, scalability, and maintainability from the outset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        ngm:reliability-engineering ;
    vc:bridgesTo ngm:aiops,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:devops,
        ngm:itil ;
    vc:dependsOn ngm:distributed-systems,
        ngm:software-engineering ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:error-budget,
        ngm:postmortem,
        ngm:service-level-objective,
        ngm:toil-reduction ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:kubernetes,
        ngm:platform-engineering,
        ngm:service-mesh ;
    vc:requires ngm:incident-management,
        ngm:monitoring,
        ngm:observability ;
    vc:slug "site-reliability-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:chaos-engineering,
        ngm:continuous-deployment,
        ngm:distributed-tracing,
        ngm:infrastructure-as-code .

ngm:slashing-condition a owl:Class ;
    rdfs:label "Slashing Condition"@en ;
    rdfs:comment "A slashing condition is a rule in a proof-of-stake protocol that defines provable validator misbehaviour, such as double-signing or equivocation, and triggers the forfeiture of part of the offender's staked collateral. It makes attacks economically costly by penalising actions that threaten consensus safety, aligning validator incentives with honest participation. It is a core economic-security primitive of staking-based consensus."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:sustainable-consensus ;
    vc:slug "slashing-condition" ;
    vc:sourceDomain "blockchain" .

ngm:solana a owl:Class ;
    rdfs:label "Solana"@en ;
    rdfs:comment "Solana is a high-performance layer-1 blockchain designed by Anatoly Yakovenko and co-founded with Greg Fitzgerald, launched as mainnet-beta in 2020 by Solana Labs and the Solana Foundation. Its defining innovation, Proof of History, embeds a cryptographic clock — a verifiable delay function based on sequential SHA-256 hashing — into the ledger itself, enabling validators to agree on transaction ordering without peer-to-peer timestamp negotiation. This is complemented by the Sealevel parallel transaction execution runtime, the Gulf Stream mempool-less transaction forwarding protocol, Turbine block propagation, and the Tower BFT consensus algorithm, together enabling sustained throughputs of tens of thousands of transactions per second with sub-second finality at sub-cent fees. Solana underpins major DeFi ecosystems, NFT infrastructure, payments applications, and, more recently, AI-adjacent on-chain compute experiments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-history ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:smart-contract-platform ;
    vc:bridgesTo ngm:decentralised-compute,
        ngm:on-chain-ai-inference ;
    vc:contrastsWith ngm:avalanche,
        ngm:bitcoin,
        ngm:ethereum,
        ngm:near-protocol ;
    vc:enables ngm:blockchain-gaming,
        ngm:decentralised-exchange,
        ngm:decentralised-finance,
        ngm:nft-marketplace,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gulf-stream,
        ngm:proof-of-history,
        ngm:sealevel,
        ngm:tower-bft,
        ngm:turbine ;
    vc:implements ngm:blockchain-scalability,
        ngm:parallel-transaction-processing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation,
        ngm:solana-program-library,
        ngm:token-standard ;
    vc:requires ngm:stake-weighted-quality-of-service,
        ngm:validator-node ;
    vc:slug "solana" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:rust-programming-language,
        ngm:verifiable-delay-function .

ngm:spatial-data-structure a owl:Class ;
    rdfs:label "Spatial Data Structure"@en ;
    rdfs:comment "A Spatial Data Structure is a data organisation scheme that partitions, indexes, or hierarchically organises geometric, geographic, or positional information to enable efficient queries over proximity, containment, intersection, and visibility. Classical families include space-partitioning trees (k-d trees, octrees, BSP trees, quadtrees), bounding-volume hierarchies (BVH), and spatial hash grids, each offering distinct trade-offs between construction cost, query throughput, memory footprint, and support for dynamic updates. These structures underpin performance-critical systems including real-time 3-D rendering, physics simulation, geographic information systems (GIS), robotics path planning, and spatial databases. The choice of structure is governed by data dimensionality, scene dynamism, query distribution, and hardware parallelism constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:data-structure ;
    vc:bridgesTo ngm:lidar-mapping,
        ngm:spatial-ai ;
    vc:contrastsWith ngm:brute-force-collision,
        ngm:uniform-grid ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:nearest-neighbour-search,
        ngm:path-planning,
        ngm:ray-tracing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy,
        ngm:bsp-tree,
        ngm:k-d-tree,
        ngm:octree,
        ngm:quadtree,
        ngm:r-tree,
        ngm:spatial-hash-grid ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computational-geometry,
        ngm:level-of-detail,
        ngm:spatial-mapping ;
    vc:requires ngm:spatial-indexing ;
    vc:slug "spatial-data-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:geographic-information-system,
        ngm:physics-simulation,
        ngm:point-cloud-processing,
        ngm:spatial-database ;
    vc:uses ngm:bounding-volume,
