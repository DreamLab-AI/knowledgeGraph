ngm:accuracy a owl:Class ;
    rdfs:label "Accuracy"@en ;
    rdfs:comment "A classification performance metric representing the proportion of correct predictions made by an artificial intelligence model across all instances in a dataset, calculated as the ratio of the sum of true positives and true negatives to the total number of predictions, providing an aggregate mea..."@en ;
