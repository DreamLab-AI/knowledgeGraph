ngm:large-scale-pretrained-foundation-model a owl:Class ;
    rdfs:label "Large-Scale Pretrained Foundation Model"@en ;
    rdfs:comment "Foundation models are large-scale neural networks trained on broad, diverse datasets via self-supervised learning that acquire general-purpose representations transferable to a wide range of downstream tasks. They are characterised by massive parameter counts, emergent capabilities not explicitly trained for, and the ability to be fine-tuned or prompted for specialised applications. Prominent examples include GPT-4, BERT, CLIP, and Stable Diffusion, spanning language, vision, and multimodal domains. Their scale and generality make them qualitatively distinct from narrow task-specific models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:machine-learning-discipline-model ;
    vc:enables ngm:fine-tuning,
        ngm:image-generation,
        ngm:multimodal-ai-architecture-ai,
        ngm:transfer-learning,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:generative-model,
        ngm:large-language-models ;
    vc:requires ngm:gpu-compute,
        ngm:training-data ;
    vc:slug "large-scale-pretrained-foundation-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:parameter-count,
        ngm:scaling-laws .

ngm:model-evaluation a owl:Class ;
    rdfs:label "Model Evaluation"@en ;
    rdfs:comment "Model Evaluation is the systematic process of measuring the performance, reliability, safety, and fitness-for-purpose of machine learning models against defined metrics, held-out datasets, and behavioural benchmarks. It spans quantitative metric computation (accuracy, F1, perplexity, BLEU, AUC-ROC), qualitative red-teaming and adversarial probing, and comparative benchmarking across standardised test suites. Evaluation drives deployment decisions, informs architectural iteration, and increasingly underpins regulatory conformity assessments demanded by AI governance frameworks. Both static offline evaluation and dynamic online evaluation in live production environments are within scope."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:audit-and-compliance ;
    vc:contrastsWith ngm:model-training,
        ngm:overfitting ;
    vc:dependsOn ngm:machine-learning-pipeline,
        ngm:training-data ;
    vc:enables ngm:ai-governance,
        ngm:ai-safety-evaluation,
        ngm:model-deployment,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bias-and-fairness,
        ngm:hyperparameter-tuning,
        ngm:interpretability,
        ngm:performance-metrics,
        ngm:red-teaming ;
    vc:requires ngm:experiment-tracking,
        ngm:ground-truth,
        ngm:labelled-data ;
    vc:slug "model-evaluation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:mlops,
        ngm:responsible-ai ;
    vc:uses ngm:benchmarks,
        ngm:confusion-matrix,
        ngm:cross-validation,
        ngm:evaluation-metric,
        ngm:statistical-hypothesis-testing,
        ngm:test-dataset .

ngm:physically-based-rendering a owl:Class ;
    rdfs:label "Physically Based Rendering"@en ;
    rdfs:comment "Physically Based Rendering (PBR) is a rendering methodology that simulates the interaction of light with materials using first-principles optics — energy conservation, the microfacet BRDF model, Fresnel reflectance equations, and radiometric correctness — to produce consistent, predictable visual output across arbitrary lighting environments. Surface materials are parameterised through a compact, artist-friendly set of maps (albedo, metalness, roughness, normal, ambient occlusion) that together drive evaluation of the Cook-Torrance or similar BRDF at each pixel. PBR has become the dominant material workflow in real-time engines (Unreal Engine, Unity) and offline path tracers alike, and is codified in the glTF 2.0 metallic-roughness material model, ensuring cross-renderer portability. Its physical correctness makes it the foundation for photorealistic digital twins, metaverse environments, and cinematic VFX pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:texture-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:brdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:rendering-technique ;
    vc:bridgesTo ngm:metaverse,
        ngm:neural-radiance-field ;
    vc:contrastsWith ngm:phong-shading,
        ngm:rasterisation ;
    vc:dependsOn ngm:energy-conservation,
        ngm:radiometry ;
    vc:enables ngm:3-d-asset,
        ngm:digital-twin,
        ngm:photorealism,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:brdf,
        ngm:environment-map,
        ngm:image-based-lighting,
        ngm:microfacet-model,
        ngm:normal-map ;
    vc:implements ngm:cook-torrance-model,
        ngm:fresnel-equation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:global-illumination,
        ngm:path-tracing,
        ngm:ray-tracing,
        ngm:subsurface-scattering ;
    vc:requires ngm:gpu,
        ngm:rendering-pipeline,
        ngm:shader,
        ngm:texture-mapping ;
    vc:slug "physically-based-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf,
        ngm:khronos-group ;
    vc:uses ngm:gltf,
        ngm:hdri,
        ngm:monte-carlo-integration .

ngm:quadratic-voting a owl:Class ;
    rdfs:label "Quadratic Voting"@en ;
    rdfs:comment "Collective decision-making mechanism where the cost of casting n votes on any single proposal equals n² voice credits, formalising preference-intensity revelation whilst resisting plutocratic capture — developed by Steven Lalley and E."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
