    vc:uses ngm:computer-vision,
        ngm:gps,
        ngm:lidar,
        ngm:sensor .

ngm:urdf-robot-model a owl:Class ;
    rdfs:label "URDF Robot Model"@en ;
    rdfs:comment "A URDF (Unified Robot Description Format) robot model is an XML specification that describes a robot's kinematic and dynamic properties, including links, joints, inertial parameters, visual meshes and collision geometry. It is the canonical model format in the ROS ecosystem, consumed by simulators, motion planners and visualisation tools to reason about a robot's physical structure. URDF files enable consistent representation of articulated robots across simulation and control software."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gazebo-simulator,
        ngm:robot-operating-system ;
    vc:slug "urdf-robot-model" ;
    vc:sourceDomain "robotics" .

ngm:uri-scheme a owl:Class ;
    rdfs:label "Uri Scheme"@en ;
    rdfs:comment "A URI scheme is the leading component of a Uniform Resource Identifier that names the namespace, protocol, or resolution mechanism by which the remainder of the identifier is to be interpreted, appearing before the colon delimiter (for example http, https, mailto, did, urn, or ipfs). Schemes are registered with IANA under provisional or permanent status and define the syntax and semantics of the scheme-specific part. Custom and decentralised schemes such as did: and ipfs: extend the URI model to identity and content-addressed systems, making the scheme a foundational element of how distributed resources are addressed and trusted."@en ;
    rdfs:subClassOf ngm:protocol ;
    vc:bridgesTo ngm:decentralised-identifiers ;
    vc:enables ngm:authentication,
        ngm:decentralised-identifiers,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:naming-scheme,
        ngm:protocol ;
    vc:isPartOf ngm:decentralised-identifiers ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:naming-scheme,
        ngm:web ;
    vc:slug "uri-scheme" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:did ;
    vc:uses ngm:identifier,
        ngm:standards .

ngm:usage-analytics a owl:Class ;
    rdfs:label "Usage Analytics"@en ;
    rdfs:comment "Usage analytics is the collection, measurement and interpretation of data describing how users interact with a product, service or platform, including session frequency, feature adoption, retention and engagement patterns. It transforms raw event telemetry into actionable insight for product, design and governance decisions. When applied responsibly it can inform well-being metrics while raising privacy considerations about behavioural tracking."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-well-being-index,
        ngm:telemetry-and-analytics ;
    vc:slug "usage-analytics" ;
    vc:sourceDomain "data" .

ngm:usdc a owl:Class ;
    rdfs:label "USDC"@en ;
    rdfs:comment "A fiat-backed stablecoin pegged to the United States dollar, issued against reserves of cash and short-term government securities and redeemable on a one-for-one basis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
