ngm:breez a owl:Class ;
    rdfs:label "Breez"@en ;
    rdfs:comment "Breez is a company and open-source platform providing a non-custodial [[Lightning Network]] wallet and a [[Software Development Kit]] (SDK) that enables developers to embed Bitcoin Lightning payments into applications without managing node infrastructure. Breez operates as a Lightning Service Provider (LSP), handling inbound liquidity and channel management on behalf of users while users retain sole custody of their private keys. The Breez SDK abstracts away the complexity of [[Payment Channel]] lifecycle management, splicing, and [[Liquidity]] provisioning, exposing a clean API for instant, low-fee Bitcoin payments. Its architecture is grounded in the [[LNURL]] protocol suite and [[Greenlight]] node-as-a-service infrastructure from Blockstream."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:open-banking ;
    vc:contrastsWith ngm:custodial-wallet,
        ngm:strike ;
    vc:dependsOn ngm:bitcoin,
        ngm:lightning-network ;
    vc:enables ngm:instant-payment,
        ngm:non-custodial-wallet,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:lightning-service-provider ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:lnd,
        ngm:phoenix-wallet ;
    vc:requires ngm:bitcoin,
        ngm:liquidity,
        ngm:payment-channel ;
    vc:slug "breez" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bolt-11,
        ngm:bolt12-offers,
        ngm:submarine-swap .

