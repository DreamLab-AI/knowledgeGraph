        ngm:task-and-motion-planning ;
    vc:uses ngm:deep-learning,
        ngm:domain-randomisation,
        ngm:multi-modal-sensing,
        ngm:physics-simulation,
        ngm:slam,
        ngm:transformer-architecture .

ngm:hyperparameter-tuning a owl:Class ;
    rdfs:label "Hyperparameter Tuning"@en ;
    rdfs:comment "Hyperparameter tuning is the process of searching for the optimal configuration of parameters that govern the training process of a machine learning model, as distinct from the model parameters learned during training itself. Hyperparameters include learning rate, batch size, network depth, regularisation coefficients, optimiser choice, and architectural choices such as kernel size or number of attention heads. The tuning process employs search strategies—grid search, random search, Bayesian optimisation, or evolutionary algorithms—to identify configurations that maximise model performance on a held-out validation set. Efficient hyperparameter tuning is critical to practical machine learning deployment, as model performance is often highly sensitive to these configuration choices."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:auto-ml,
        ngm:bayesian-inference,
        ngm:overfitting ;
    vc:slug "hyperparameter-tuning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:model-evaluation-results ;
    vc:uses ngm:feature-engineering,
        ngm:gradient-descent,
        ngm:machine-learning-pipeline .

ngm:incident-response a owl:Class ;
    rdfs:label "Incident Response"@en ;
    rdfs:comment "Incident Response is the structured organisational process for detecting, containing, eradicating, and recovering from cybersecurity incidents, and subsequently analysing them to prevent recurrence. It follows lifecycle models such as NIST SP 800-61 or SANS PICERL (Preparation, Identification, Containment, Eradication, Recovery, Lessons Learned), and is operationalised through playbooks, security operations centre (SOC) workflows, and automation tooling including SIEM and SOAR platforms. Effective incident response minimises dwell time—the interval between initial compromise and detection—and limits lateral movement, data exfiltration, and operational disruption. With the increasing scale and sophistication of threats, AI-assisted triage, automated containment, and threat-intelligence enrichment have become standard components of mature incident response programmes."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-breach,
        ngm:incident-reporting,
        ngm:information-security,
        ngm:vulnerability ;
    vc:slug "incident-response" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cybersecurity-standard,
        ngm:data-security ;
    vc:uses ngm:ai-trust-risk-and-security-management,
        ngm:digital-forensics-framework .

ngm:json-ld-1-1 a owl:Class ;
    rdfs:label "JSON-LD 1.1"@en ;
    rdfs:comment "JSON-LD 1.1 is a W3C Recommendation that extends JSON-LD 1.0 with features including scoped contexts, type-scoped contexts, and propagation control, enabling richer mapping of JSON document terms to IRIs within RDF-based knowledge systems. It provides a framing algorithm for reshaping a flat graph into a tree, and supports compaction and expansion algorithms that allow any conformant document to be normalised to a canonical form. JSON-LD 1.1 underpins interoperable semantic data exchange on the Web and is the serialisation format used by the Verifiable Credentials and Activity Streams standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:ai-technique,
        ngm:semantic-web-standards ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:semantic-web,
        ngm:sparql ;
    vc:requires ngm:rdf ;
    vc:slug "json-ld-1-1" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:json-ld .

ngm:kinematic-model a owl:Class ;
    rdfs:label "KinematicModel"@en ;
    rdfs:comment "A kinematic model is a mathematical abstraction that describes the geometry of a robot's motion by relating joint-space variables (angles and displacements) to the position and orientation of the end-effector in Cartesian space, without accounting for the forces or torques that produce that motion. Forward kinematics maps joint configurations to end-effector poses using homogeneous transformation matrices or Denavit-Hartenberg parameters, whereas inverse kinematics solves the reverse problem of finding joint configurations that achieve a desired pose. Kinematic models are foundational to trajectory generation, motion planning, and simulation in robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:sensor-fusion ;
    vc:requires ngm:forward-kinematics,
        ngm:inverse-kinematics ;
    vc:slug "kinematic-model" ;
    vc:sourceDomain "robotics" .

ngm:learning-management-system a owl:Class ;
    rdfs:label "Learning Management System"@en ;
    rdfs:comment "Software platforms that deliver, track, and manage educational content and training programmes, increasingly integrating with VR, AR, and metaverse technologies through SCORM, xAPI, and LTI standards to enable immersive learning experiences."@en ;
    rdfs:subClassOf ngm:educational-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:vr-training-delivery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "learning-management-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:light-node a owl:Class ;
    rdfs:label "Light Node"@en ;
    rdfs:comment "A Light Node is a blockchain network participant that downloads and verifies only block headers rather than the full transaction history, using Simplified Payment Verification (SPV) to confirm transaction inclusion via Merkle proofs. This design allows resource-constrained devices—mobile wallets, IoT devices, embedded clients—to interact securely with a blockchain without the storage and bandwidth demands of a Full Node, relying on connected full nodes to supply the underlying transaction data when required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain-entity ;
    vc:contrastsWith ngm:archival-node,
        ngm:full-node ;
    vc:enables ngm:digital-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:bootstrap-node,
        ngm:validator-node ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:peer-to-peer-network ;
    vc:slug "light-node" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-network,
        ngm:cryptographic-protocol .

ngm:liquid-proof-of-stake a owl:Class ;
    rdfs:label "Liquid Proof of Stake"@en ;
    rdfs:comment "A Proof of Stake consensus variant that decouples staking participation from token illiquidity by allowing holders to delegate validation rights to elected validators (bakers) while retaining full ownership and transferability of their tokens. Pioneered by Tezos, it combines on-chain governance with delegated staking, enabling small token holders to participate in consensus rewards without running validator infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:dependsOn ngm:blockchain-governance,
        ngm:consensus-mechanism ;
    vc:enables ngm:decentralized-autonomous-organization,
        ngm:tokenomics-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:proof-of-stake-sustainability ;
    vc:requires ngm:epoch,
        ngm:validator-node ;
    vc:slug "liquid-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:token-economics,
        ngm:validator-set .

