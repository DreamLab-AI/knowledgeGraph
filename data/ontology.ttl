ngm:distributed-ledger-technology a owl:Class ;
    rdfs:label "Distributed Ledger Technology"@en ;
    rdfs:comment "Distributed Ledger Technology (DLT) refers to a class of decentralised database protocols in which transaction records are replicated, shared, and synchronised across multiple networked nodes without a central administrator. Consensus mechanisms — such as proof-of-work, proof-of-stake, and Byzantine fault-tolerant protocols — ensure agreement on the canonical state of the ledger. DLT underpins blockchain networks, permissioned enterprise ledgers, and novel consensus architectures used in finance, supply chain, and identity management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:blockchain,
        ngm:consensus-mechanism ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:financial-regulation ;
    vc:slug "distributed-ledger-technology" ;
    vc:sourceDomain "blockchain" .

ngm:gdpr-compliance a owl:Class ;
    rdfs:label "GDPR Compliance"@en ;
    rdfs:comment "GDPR Compliance refers to the totality of organisational, technical, and procedural measures an entity must implement to satisfy obligations under the EU General Data Protection Regulation (Regulation 2016/679), including lawful bases for processing, data subject rights fulfilment, data-breach notification, and appointment of a Data Protection Officer where required. The regulation applies extraterritorially to any organisation processing personal data of EU data subjects, regardless of where processing occurs. Compliance programmes span privacy-by-design principles, data minimisation, consent management, audit trails, and demonstrable accountability to supervisory authorities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:data-governance,
        ngm:data-minimisation ;
    vc:requires ngm:consent-management,
        ngm:data-protection,
        ngm:privacy-by-design ;
    vc:slug "gdpr-compliance" ;
    vc:sourceDomain "infrastructure" .

ngm:inference a owl:Class ;
    rdfs:label "Inference"@en ;
    rdfs:comment "Inference is the process of applying a trained AI model to new, unseen data to produce predictions, classifications, or generated outputs. It is distinct from training in that model parameters are fixed; the computational objective is throughput, latency, and memory efficiency. Inference is the primary execution path in production deployments and is governed by ISO/IEC 22989:2022 clause 3.3.4."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:training ;
    vc:dependsOn ngm:model-training,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "inference" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:hardware-acceleration,
        ngm:inference-hardware .

ngm:kinematics a owl:Class ;
    rdfs:label "Kinematics"@en ;
    rdfs:comment "Kinematics in robotics describes the geometry of motion of a robot's links and joints without reference to the forces producing that motion. Forward kinematics maps joint parameters to end-effector pose; inverse kinematics solves the reverse problem. Kinematic analysis is foundational for motion planning, trajectory generation, workspace analysis, and robot programming, forming the mathematical basis on which dynamic and control models build."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
