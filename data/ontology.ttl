    vc:uses ngm:encryption .

ngm:privilege-escalation a owl:Class ;
    rdfs:label "Privilege Escalation"@en ;
    rdfs:comment "Privilege escalation is the act of gaining rights beyond those originally granted, allowing an attacker or process to perform actions reserved for higher-trust principals. Vertical escalation moves from a lower to a higher privilege level, while horizontal escalation moves laterally to another principal at the same level. It is a pivotal phase in attack chains, typically exploiting misconfiguration, flawed access control or software vulnerabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:security ;
    vc:contrastsWith ngm:least-privilege ;
    vc:dependsOn ngm:authentication ;
    vc:enables ngm:penetration-testing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:authorization,
        ngm:observability ;
    vc:requires ngm:vulnerability ;
    vc:slug "privilege-escalation" ;
    vc:sourceDomain "security" .

ngm:probabilistic-forecasting a owl:Class ;
    rdfs:label "Probabilistic Forecasting"@en ;
    rdfs:comment "Probabilistic forecasting predicts future quantities as full probability distributions rather than single point estimates, quantifying uncertainty in the prediction. Outputs are typically expressed as predictive intervals, quantiles, or samples. It is essential for risk-aware decision-making in domains such as demand planning, energy, and finance where the cost of error is asymmetric."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model,
        ngm:time-series-forecasting ;
    vc:slug "probabilistic-forecasting" ;
    vc:sourceDomain "ai" .

ngm:production-pipeline a owl:Class ;
    rdfs:label "Production Pipeline"@en ;
    rdfs:comment "The end-to-end sequence of tools, processes, and automated stages that transform raw creative or data assets into finished, deployable outputs. In spatial computing contexts a production pipeline typically spans asset creation, format conversion, quality assurance, rendering, and deployment to target platforms (game engines, XR runtimes, or streaming services)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-workflow ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
