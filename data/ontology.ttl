    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "standardization-bodies" ;
    vc:sourceDomain "spatial-computing" .

ngm:stark a owl:Class ;
    rdfs:label "STARK"@en ;
    rdfs:comment "A STARK is a scalable transparent argument of knowledge, a cryptographic proof system that lets a verifier check a computation was performed correctly without a trusted setup and with proof verification far cheaper than re-execution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:cryptography ;
    vc:enables ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:zero-knowledge-proof ;
    vc:slug "stark" ;
    vc:sourceDomain "metaverse" .

ngm:steganography a owl:Class ;
    rdfs:label "Steganography"@en ;
    rdfs:comment "Steganography is the practice of concealing the existence of a message by embedding it within an innocuous carrier such as an image, audio file or text, so that only the intended recipient is aware that hidden information is present. Unlike encryption, which scrambles content but leaves it visibly protected, steganography aims to make the very presence of communication undetectable. The two techniques are complementary and are often combined for layered confidentiality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obfuscation ],
        ngm:cryptography ;
    vc:bridgesTo ngm:privacy ;
    vc:contrastsWith ngm:digital-watermarking,
        ngm:encryption ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:digital-watermarking,
        ngm:encryption ;
    vc:requires ngm:obfuscation ;
    vc:slug "steganography" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy ;
    vc:uses ngm:obfuscation .

ngm:storage-engine a owl:Class ;
    rdfs:label "Storage Engine"@en ;
    rdfs:comment "A storage engine is the component of a database system responsible for how data is physically laid out, written, indexed and retrieved on durable media. It implements the on-disk data structures, transaction and concurrency control, write-ahead logging and recovery that guarantee durability and consistency. Different engines, such as B-tree and log-structured merge-tree designs, optimise for different read, write and space trade-offs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:acid-properties ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:write-ahead-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:write-ahead-logging ],
        ngm:data-persistence ;
    vc:bridgesTo ngm:data-storage-layer ;
    vc:dependsOn ngm:data-persistence ;
    vc:enables ngm:nosql-database,
        ngm:relational-database ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:acid-properties,
        ngm:write-ahead-logging ;
    vc:implements ngm:acid-properties ;
    vc:isPartOf ngm:database-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:postgre-sql ;
    vc:requires ngm:data-persistence,
        ngm:write-ahead-logging ;
    vc:slug "storage-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-management-system ;
    vc:uses ngm:database-query .

ngm:sustainable-bitcoin-protocol a owl:Class ;
    rdfs:label "Sustainable Bitcoin Protocol"@en ;
    rdfs:comment "The Sustainable Bitcoin Protocol (SBP) is a certification and tokenisation framework that attests the use of renewable or stranded energy in Bitcoin mining and issues on-chain Sustainable Bitcoin Certificates to verified miners. It enables green bitcoin premiums and provides institutional investors with auditable environmental provenance for Bitcoin holdings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-mining ],
        ngm:blockchain-sustainability ;
    vc:bridgesTo ngm:governance,
        ngm:infrastructure ;
    vc:contrastsWith ngm:bitcoin-mining-council,
        ngm:voluntary-carbon-market ;
    vc:enables ngm:environmental-certificate,
        ngm:esg-investing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:additionality,
        ngm:bitcoin-proof-of-work-protocol-environmental-issues,
        ngm:carbon-neutral-blockchain,
        ngm:provenance-tracking,
        ngm:stranded-energy-monetisation ;
    vc:requires ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:slug "sustainable-bitcoin-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:carbon-accounting,
        ngm:net-zero-commitment ;
    vc:uses ngm:blockchain-attestation,
        ngm:green-mining-pool,
        ngm:proof-of-work,
        ngm:renewable-energy-certificates,
        ngm:sustainable-bitcoin-certificates .

ngm:symmetric-key a owl:Class ;
    rdfs:label "Symmetric Key"@en ;
    rdfs:comment "A symmetric key is a single shared secret used by both the sender and receiver to encrypt and decrypt data in symmetric-key cryptography. Because the same key performs both operations, it must be kept secret and distributed securely between the communicating parties. Symmetric-key algorithms such as AES are fast and efficient for bulk data encryption, which makes them the workhorse of confidentiality in practice, often combined with asymmetric techniques that solve the problem of securely exchanging the shared key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:cryptographic-key ;
    vc:contrastsWith ngm:asymmetric-encryption,
        ngm:public-key ;
    vc:dependsOn ngm:key-exchange ;
    vc:enables ngm:encryption,
        ngm:symmetric-encryption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:block-cipher,
        ngm:stream-cipher ;
    vc:implements ngm:aes,
        ngm:cipher ;
    vc:isPartOf ngm:symmetric-encryption ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:hash-function ;
    vc:requires ngm:key-exchange,
        ngm:key-management ;
    vc:slug "symmetric-key" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cryptography,
        ngm:tls .

ngm:tamper-detection a owl:Class ;
    rdfs:label "Tamper Detection"@en ;
    rdfs:comment "Tamper detection is the set of technical mechanisms and protocols that identify whether a digital asset, data record, physical device, or communication has been unauthorisedly modified since its creation or last verified state. In the digital domain it employs cryptographic hash functions, digital signatures, Merkle proofs, and content-addressed storage to generate verifiable commitments that reveal any change to the protected content. Applied to media authenticity, hardware integrity, and data provenance, tamper detection is a foundational component of trust architectures for critical systems, supply chains, digital forensics, and content authenticity verification."@en ;
    rdfs:subClassOf ngm:data-integrity ;
    vc:enables ngm:content-authentication,
        ngm:digital-forensics,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:audit-trail ;
    vc:slug "tamper-detection" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:cryptographic-signature,
        ngm:digital-signature .

ngm:task-and-motion-planning a owl:Class ;
    rdfs:label "Task and Motion Planning"@en ;
    rdfs:comment "Task and motion planning is an approach in robotics that combines high-level symbolic task planning with low-level geometric motion planning to produce fully executable robot plans. It jointly addresses what actions to perform and how to physically execute each movement, interleaving logical goal satisfaction with collision-free trajectory synthesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:task-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        ngm:motion-planning ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:classical-planning,
        ngm:reactive-planning ;
    vc:dependsOn ngm:robot-perception,
        ngm:scene-representation ;
    vc:enables ngm:autonomous-manipulation,
        ngm:robot-control,
        ngm:task-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:task-planning,
        ngm:trajectory-planning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning ;
    vc:requires ngm:collision-detection,
        ngm:constraint-satisfaction,
        ngm:kinematics,
        ngm:planning ;
    vc:slug "task-and-motion-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:pathfinding-algorithm,
        ngm:pddl,
        ngm:probabilistic-roadmap,
        ngm:rapidly-exploring-random-tree .

ngm:tc-0002-collaborative-document-editing a owl:Class ;
    rdfs:label "tc 0002 collaborative document editing"@en ;
    rdfs:comment "Collaborative Document Editing - Real-time or asynchronous shared editing technology enabling multiple distributed users to simultaneously create, modify, and comment on digital documents with live synchronization and version control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
