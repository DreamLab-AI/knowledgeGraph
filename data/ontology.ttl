ngm:aisi a owl:Class ;
    rdfs:label "AISI"@en ;
    rdfs:comment "The AI Safety Institute is a UK government body that evaluates advanced AI systems for safety and security risks. It was established to test frontier models and inform policy."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:enables ngm:ai-governance,
        ngm:ai-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "aisi" ;
    vc:sourceDomain "governance" .

ngm:aisi-inspect-framework a skos:Concept ;
    rdfs:label "Aisi Inspect Framework"@en .

ngm:aistats a skos:Concept ;
    rdfs:label "Aistats"@en .

ngm:aisystem a owl:Class ;
    rdfs:label "AISystem"@en ;
    rdfs:comment "A comprehensive system architecture comprising machine learning models, data pipelines, inference engines, and deployment infrastructure that enables intelligent decision-making and automation across diverse application domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-agent-system ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:machine-learning-discipline-model,
        ngm:neural-network ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:ai-agent-system ;
    vc:slug "aisystem" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:aiethics,
        ngm:governance-framework ;
    vc:uses ngm:computer-vision,
        ngm:natural-language-processing .

