ngm:enterprise-search a owl:Class ;
    rdfs:label "Enterprise Search"@en ;
    rdfs:comment "Enterprise search is the organisational capability to retrieve relevant information from heterogeneous internal data sources—documents, databases, emails, intranets, and code repositories—within a single unified query interface. Modern enterprise search systems increasingly combine full-text indexing with semantic retrieval, vector embeddings, and retrieval-augmented generation (RAG) to surface contextually relevant results rather than mere keyword matches. The discipline sits at the intersection of information retrieval, knowledge management, and applied AI, requiring connectors, access-control enforcement, and relevance tuning at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-retrieval ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:natural-language-processing ;
    vc:requires ngm:information-retrieval ;
    vc:slug "enterprise-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:semantic-search,
        ngm:vector-database .

ngm:erasure-coding a owl:Class ;
    rdfs:label "Erasure Coding"@en ;
    rdfs:comment "Erasure coding is a forward error-correction technique that encodes a data object into n fragments (shards), distributed across nodes or storage devices, such that any k of those n fragments are sufficient to reconstruct the original data without any centralised copy. The redundancy overhead (n − k) / k is typically much lower than full replication, making erasure coding the preferred durability mechanism in large-scale distributed storage systems and distributed ledgers where storage efficiency matters. Common schemes include Reed-Solomon codes, and more computationally efficient variants such as LDPC and Cauchy Reed-Solomon."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:ipfs,
        ngm:storage-infrastructure ;
    vc:slug "erasure-coding" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-replication .

ngm:etsi a owl:Class ;
    rdfs:label "ETSI"@en ;
    rdfs:comment "ETSI (European Telecommunications Standards Institute) is a not-for-profit, independent standardisation organisation that produces globally applicable standards for information and communications technology, including telecommunications, broadcasting, and electronic signatures. Headquartered in Sophia Antipolis, France, it operates under a unique membership model that grants access to industry, research organisations, and governments worldwide. ETSI standards underpin technologies such as 5G NR, NFV, MEC, and the eIDAS-compliant electronic signature formats (CAdES, XAdES, PAdES)."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:open-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:etsi-domain-taxonomy ;
    vc:slug "etsi" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:interoperability .

ngm:feature-store a owl:Class ;
    rdfs:label "Feature Store"@en ;
    rdfs:comment "A centralised repository for storing, managing, versioning, and serving machine learning features at scale. It ensures point-in-time consistency between training and online inference, prevents training-serving skew, and enables cross-team feature reuse so that features computed once can be shared across multiple models and pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
