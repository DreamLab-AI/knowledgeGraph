# Social Presence Theory
distributed-collaboration:SocialPresenceTheory rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:CommunicationTheory ;
    rdfs:label "Social Presence Theory"@en ;
    rdfs:comment "\"A theoretical framework explaining how communication media vary in their capacity to convey social cues (facial expressions, vocal intonation, body language, interpersonal warmth), thereby influencing the degree to which communicators perceive each other as psychologically present, real, and engaged in interpersonal exchange.\""@en ;
    skos:prefLabel "Social Presence Theory"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:social-presence-theory" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:social-presence-theory> ;
    vcw:contentHash "sha256-12-8c3b29a23cac" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0190" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0190" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

distributed-collaboration:SocialPresenceTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:NonverbalCommunication
] .

