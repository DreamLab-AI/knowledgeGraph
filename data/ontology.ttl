ngm:safety-engineering a owl:Class ;
    rdfs:label "Safety Engineering"@en ;
    rdfs:comment "Safety engineering is the engineering discipline concerned with designing systems that avoid causing harm to people, property, and the environment under both normal and fault conditions. It applies hazard analysis, redundancy, fail-safe design, and quantified risk assessment across the system lifecycle. Functional safety and reliability engineering are specialised branches that address fault behaviour and dependable operation."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
