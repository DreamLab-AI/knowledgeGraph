        ngm:technical-standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:data-discovery,
        ngm:description-logic,
        ngm:information-exchange,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoding-specification,
        ngm:schema-definition,
        ngm:validation-constraints ;
    vc:isPartOf ngm:data-management-system,
        ngm:interoperability-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:controlled-vocabulary,
        ngm:data-model,
        ngm:namespace-management ;
    vc:slug "metadata-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:model-performance a owl:Class ;
    rdfs:label "Model Performance"@en ;
    rdfs:comment "The quantitative and qualitative measure of how effectively an artificial intelligence model accomplishes its designated tasks, typically assessed through statistical metrics evaluating prediction accuracy, reliability, generalisability, computational efficiency, and robustness, considered across different data distributions, operational conditions, and stakeholder requirements, serving as a critical basis for model selection, deployment decisions, ongoing monitoring, and continuous improvement throughout the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evaluation-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmark-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:f1-score ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:test-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accuracy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:roc-curve ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:confusion-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recall ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:precision ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:ai-model-card,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:overfitting,
        ngm:underfitting ;
    vc:dependsOn ngm:data-drift,
        ngm:training-data ;
    vc:enables ngm:hyperparameter-tuning,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accuracy,
        ngm:confusion-matrix,
        ngm:f1-score,
        ngm:precision,
        ngm:recall,
        ngm:roc-curve ;
    vc:isPartOf ngm:ai-lifecycle,
        ngm:model-evaluation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-monitoring,
        ngm:calibration,
        ngm:explainability,
        ngm:fairness,
        ngm:robustness ;
    vc:requires ngm:benchmark-standard,
        ngm:evaluation-metric,
        ngm:model-training,
        ngm:test-dataset ;
    vc:slug "model-performance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:onion-routing a owl:Class ;
    rdfs:label "Onion Routing"@en ;
    rdfs:comment "Onion routing is an anonymous-communication technique in which messages are wrapped in successive layers of encryption and relayed through a sequence of intermediary nodes, each of which removes one layer to learn only the next hop. Because no single relay knows both the source and destination, onion routing conceals the network path and protects communication metadata. It is the basis of the Tor network and is adapted in systems such as the Lightning Network for private multi-hop payment forwarding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:payment-channel-network,
        ngm:source-routing ;
    vc:contrastsWith ngm:vpn ;
    vc:dependsOn ngm:distributed-trust,
        ngm:network-routing ;
    vc:enables ngm:anonymous-communication,
        ngm:censorship-resistance,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:node ;
    vc:implements ngm:lightning-network,
        ngm:tor ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol ;
    vc:requires ngm:key-exchange,
        ngm:public-key-infrastructure ;
    vc:slug "onion-routing" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-privacy,
        ngm:traffic-analysis-resistance ;
    vc:uses ngm:diffie-hellman-key-exchange,
        ngm:encryption,
        ngm:public-key-cryptography,
        ngm:symmetric-encryption .

ngm:reward-model a owl:Class ;
    rdfs:label "Reward Model"@en ;
    rdfs:comment "A neural network trained to predict scalar rewards for model outputs based on human feedback, used to provide learning signals in reinforcement learning from human feedback (RLHF). The reward model serves as a proxy for human preferences, enabling efficient optimisation without constant human evaluation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pairwise-comparison ],
        ngm:reinforcement-learning ;
    vc:bridgesTo ngm:ai-safety,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:direct-preference-optimization,
        ngm:inverse-reinforcement-learning ;
    vc:dependsOn ngm:human-annotation ;
    vc:enables ngm:ai-alignment,
        ngm:policy-optimisation,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:scalable-oversight ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rlhf ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai-training-methodology,
        ngm:model-performance,
        ngm:preference-learning,
        ngm:reward-hacking ;
    vc:requires ngm:human-feedback,
        ngm:pairwise-comparison,
        ngm:preference-data,
        ngm:supervised-fine-tuning ;
    vc:slug "reward-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bradley-terry-model,
        ngm:large-language-model,
        ngm:proximal-policy-optimisation .

ngm:smart-city a owl:Class ;
    rdfs:label "Smart City"@en ;
    rdfs:comment "A smart city uses networked sensors, data platforms and analytics to manage urban systems such as transport, energy and public services, often paired with spatial digital twins and governed by open data standards and citizen-centric policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-building ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-grid ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:spatial-computing ;
    vc:dependsOn ngm:5-g-network,
