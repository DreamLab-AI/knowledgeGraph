        ngm:ground-truth ;
    vc:slug "benchmark-dataset" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:image-classification,
        ngm:natural-language-processing ;
    vc:uses ngm:training-data .

ngm:benchmarking a owl:Class ;
    rdfs:label "Benchmarking"@en ;
    rdfs:comment "Benchmarking is the disciplined practice of measuring the performance, accuracy, efficiency, or quality of a system, component, or model against a standardised workload and a set of comparable baselines. It produces reproducible quantitative metrics — such as latency, throughput, resource utilisation, or task accuracy — that allow engineers to compare alternatives, detect regressions, and guide optimisation. Robust benchmarking requires controlled environments, representative workloads, statistically sound measurement, and transparent reporting to avoid misleading or non-generalisable results."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-assurance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing ],
        ngm:performance-optimization ;
    vc:bridgesTo ngm:performance-optimization ;
    vc:enables ngm:continuous-integration,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:testing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:classification,
        ngm:continuous-integration,
        ngm:high-performance-computing ;
    vc:requires ngm:quality-assurance,
        ngm:testing ;
    vc:slug "benchmarking" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:quality-assurance ;
    vc:uses ngm:bandwidth,
        ngm:latency .

ngm:block-size a owl:Class ;
    rdfs:label "Block Size"@en ;
    rdfs:comment "Block Size is the maximum data capacity—measured in bytes or weight units—that a single block in a blockchain may contain, governing how many transactions can be confirmed per block and therefore setting a fundamental upper bound on network throughput. Larger blocks increase per-block transaction capacity but raise propagation latency, orphan-block rates, and hardware requirements for full nodes, while smaller blocks favour decentralisation and faster propagation at the cost of throughput and higher fee markets when demand exceeds capacity. The Bitcoin block-size debate (resulting in the SegWit upgrade and eventual Bitcoin Cash fork) made block size one of the most consequential and politically contentious protocol parameters in blockchain history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:finality,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-time,
        ngm:distributed-ledger,
        ngm:gas,
        ngm:latency,
        ngm:network-protocol,
        ngm:sidechain ;
    vc:requires ngm:block,
        ngm:blockchain ;
    vc:slug "block-size" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:merkle-tree,
        ngm:node .

ngm:block-time a owl:Class ;
    rdfs:label "Block Time"@en ;
    rdfs:comment "Block Time is the average elapsed time between the creation of consecutive blocks on a blockchain, governed by the network's consensus mechanism and difficulty adjustment algorithm. Shorter block times increase transaction throughput and reduce confirmation latency but raise the risk of forks due to block propagation delays, creating a fundamental tradeoff between speed and chain security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-propagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:block-size,
        ngm:blockchain-scalability ;
    vc:dependsOn ngm:mining-pool,
        ngm:network-latency,
        ngm:peer-to-peer-network ;
    vc:enables ngm:transaction-confirmation,
        ngm:transaction-finality,
        ngm:uncle-block ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment ;
    vc:implements ngm:nakamoto-consensus ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-size,
        ngm:blockchain-scalability,
        ngm:finality,
        ngm:mempool,
        ngm:mining,
        ngm:orphan-block ;
    vc:requires ngm:block-propagation,
        ngm:consensus-mechanism,
        ngm:hash-rate,
        ngm:proof-of-work ;
    vc:slug "block-time" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ieee-2418-1,
        ngm:iso-iec-23257-2021 ;
    vc:supports ngm:blockchain-security,
