    vc:enables ngm:information-retrieval,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:encoder-decoder-architecture,
        ngm:large-language-models,
        ngm:transformer ;
    vc:slug "m-t5" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:tokenization,
        ngm:transfer-learning .

ngm:making-available a owl:Class ;
    rdfs:label "Making Available"@en ;
    rdfs:comment "Under EU AI Act Article 3(14), Making Available is the supply of an AI system for distribution or use on the Union market in the course of a commercial activity, whether in return for payment or free of charge. It is broader than Placing on the Market, covering all subsequent distributions after initial market entry, and triggers compliance obligations for distributors, providers, and authorised representatives throughout the AI value chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance ;
