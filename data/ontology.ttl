    vc:slug "training-hardware" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transaction-ledger a owl:Class ;
    rdfs:label "Transaction Ledger"@en ;
    rdfs:comment "A transaction ledger is an ordered, append-only record of value transfers or state changes that serves as the authoritative history of activity within a financial or blockchain system. Each entry captures the parties, amounts, and timing of a transaction, and in distributed settings the ledger is cryptographically chained and replicated to guarantee integrity and auditability."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-tax-compliance-node,
        ngm:transaction-standard ;
    vc:slug "transaction-ledger" ;
    vc:sourceDomain "blockchain" .

ngm:transaction-propagation a owl:Class ;
    rdfs:label "Transaction Propagation"@en ;
    rdfs:comment "Transaction propagation is the process by which a newly broadcast transaction spreads across a peer-to-peer blockchain network from its originating node to the rest of the participants. Nodes relay valid transactions to their peers using a gossip protocol, typically announcing availability before transferring full data, so that the transaction reaches miners and validators for inclusion in a block while resisting spam through validation and fee policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:gossip-protocol ;
    vc:bridgesTo ngm:mempool ;
    vc:contrastsWith ngm:block-propagation ;
    vc:dependsOn ngm:gossip-protocol,
        ngm:node ;
    vc:enables ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:gossip-protocol ;
    vc:isPartOf ngm:peer-to-peer-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:mempool ;
    vc:requires ngm:peer-to-peer-network ;
    vc:slug "transaction-propagation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:mempool ;
    vc:uses ngm:network-topology .

ngm:transaction-standard a owl:Class ;
    rdfs:label "Transaction Standard"@en ;
    rdfs:comment "A protocol defining secure exchange of digital assets and services within virtual economies, specifying message formats, authentication mechanisms, settlement procedures, and integrity guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:atomic-swap,
        ngm:multi-party-transactions ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:authentication-mechanism,
        ngm:integrity-verification,
        ngm:message-format,
        ngm:settlement,
        ngm:transaction-ledger ;
    vc:implements ngm:payment-system ;
    vc:isPartOf ngm:payment-system,
        ngm:virtual-economy-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-key-management,
        ngm:data-persistence,
        ngm:digital-identity,
        ngm:network-protocol ;
    vc:slug "transaction-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:transfer-of-funds-regulation a owl:Class ;
    rdfs:label "Transfer Of Funds Regulation"@en ;
    rdfs:comment "The Transfer of Funds Regulation is a body of financial regulation requiring that information about the payer and payee accompany transfers of funds and certain crypto-asset transfers, so that transactions remain traceable for anti-money-laundering and counter-terrorist-financing purposes. It implements the Financial Action Task Force travel rule within a regulatory framework, obliging payment service providers and crypto-asset service providers to collect, transmit, and screen originator and beneficiary data. It is a central pillar of payment-chain transparency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:beneficial-ownership ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:privacy ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:travel-rule ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crypto-asset-service-provider,
        ngm:governance,
        ngm:payment-service-provider ;
    vc:requires ngm:beneficial-ownership,
        ngm:know-your-customer ;
    vc:slug "transfer-of-funds-regulation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:financial-action-task-force ;
    vc:supports ngm:anti-money-laundering,
        ngm:counter-terrorist-financing ;
    vc:uses ngm:payment-system .

ngm:transformers-library a owl:Class ;
    rdfs:label "Transformers Library"@en ;
    rdfs:comment "The Transformers library is an open-source software framework that provides unified access to thousands of pretrained transformer-based models for natural language processing, computer vision, audio and multimodal tasks. Maintained primarily by Hugging Face, it exposes a consistent interface for loading, fine-tuning and running inference across architectures, and integrates with deep-learning backends such as PyTorch. It has become a de facto standard toolkit for working with large pretrained models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenizer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pretrained-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:deep-learning-framework ;
    vc:bridgesTo ngm:pretraining ;
    vc:dependsOn ngm:python-pytorch-deep-learning-stack,
        ngm:transformer-architecture ;
    vc:enables ngm:fine-tuning,
        ngm:model-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:attention-mechanism,
        ngm:pretrained-model,
        ngm:tokenizer ;
    vc:implements ngm:vision-transformer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hugging-face,
        ngm:hugging-face-model-hub ;
    vc:slug "transformers-library" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-model,
        ngm:natural-language-processing ;
    vc:uses ngm:multi-head-attention,
        ngm:transformer .

ngm:transmission-delay a skos:Concept ;
    rdfs:label "Transmission Delay"@en .

ngm:transparency-and-explainability a owl:Class ;
    rdfs:label "Transparency and Explainability"@en ;
    rdfs:comment "Transparency and Explainability is a core AI trustworthiness dimension requiring that AI systems disclose sufficient information about their operation, decision logic, data provenance, and limitations to enable appropriate understanding and oversight by developers, deployers, and affected users. It encompasses traceability (audit trails, dataset documentation), explainability (global and local model explanations, counterfactuals), and communication transparency (disclosing AI involvement and system boundaries). Regulatory frameworks such as the EU AI Act Article 13 mandate transparency obligations for high-risk AI systems, driving demand for methods such as SHAP, LIME, and AI model cards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-model-card ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:explainability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-model-card,
        ngm:audit-trail,
        ngm:explainability,
        ngm:interpretability ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-regulation,
        ngm:decision-transparency,
        ngm:feature-importance,
        ngm:post-hoc-explanation ;
    vc:requires ngm:ai-audit,
        ngm:explainable-ai ;
    vc:slug "transparency-and-explainability" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transparency-obligation a owl:Class ;
    rdfs:label "Transparency Obligation"@en ;
    rdfs:comment "A transparency obligation is a regulatory duty to disclose how a system works or that it is in use, such as informing people when they interact with an AI system or with generated content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:regulatory-compliance ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ai-regulation ;
    vc:slug "transparency-obligation" ;
    vc:sourceDomain "metaverse" .

ngm:travel-rule-protocol a owl:Class ;
    rdfs:label "Travel Rule Protocol"@en ;
    rdfs:comment "A travel rule protocol is a technical standard that lets virtual asset service providers securely exchange the originator and beneficiary information required by the FATF Travel Rule when transferring crypto-assets. Implementations such as the IVMS101 data model and the TRP and OpenVASP messaging schemes define how counterparty identity data is formatted, transmitted, and verified between regulated entities."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:travel-rule ;
    vc:slug "travel-rule-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:treasury-analytics a owl:Class ;
    rdfs:label "Treasury Analytics"@en ;
    rdfs:comment "Treasury analytics is the analysis of an organisation's or DAO's financial holdings, cash flows, and asset allocation to inform liquidity, runway, and risk-management decisions. In the on-chain context it aggregates wallet balances, token positions, and protocol revenues into dashboards and metrics that support transparent, data-driven treasury governance."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics,
        ngm:treasury-management ;
    vc:slug "treasury-analytics" ;
    vc:sourceDomain "blockchain" .

