ngm:transaction-confirmation a owl:Class ;
    rdfs:label "Transaction Confirmation"@en ;
    rdfs:comment "The process by which a blockchain transaction achieves inclusion in a mined or validated block and subsequently accumulates additional blocks on top of it, reducing the probability of reversal. The number of confirmations required for sufficient security depends on consensus mechanism and transaction value; Bitcoin typically requires 6 confirmations while Proof-of-Stake systems with deterministic finality may confirm in a single block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:audit-trail,
        ngm:blockchain-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:transaction-finality ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:slug "transaction-confirmation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block,
        ngm:block-time,
        ngm:timestamp .

ngm:transaction-validation a owl:Class ;
    rdfs:label "Transaction Validation"@en ;
    rdfs:comment "Transaction validation is the process by which network participants check that a blockchain transaction conforms to the protocol rules before accepting it. It ensures only valid transactions enter the ledger by verifying signatures, input availability, and compliance with consensus rules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        ngm:consensus ;
    vc:bridgesTo ngm:payment-settlement,
        ngm:regulatory-compliance,
        ngm:smart-contract-execution ;
    vc:contrastsWith ngm:centralised-transaction-processing,
        ngm:permissioned-ledger ;
    vc:dependsOn ngm:full-node,
        ngm:protocol-rules,
        ngm:transaction ;
    vc:enables ngm:bitcoin-network,
        ngm:blockchain-finality,
        ngm:double-spend-prevention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fee-validation,
        ngm:script-execution,
        ngm:signature-verification ;
    vc:implements ngm:bitcoin-script,
        ngm:proof-of-work ;
    vc:isPartOf ngm:block-production,
        ngm:consensus ;
    vc:qualityScore "0.72"^^xsd:float ;
