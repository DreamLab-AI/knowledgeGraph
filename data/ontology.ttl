    vc:sourceDomain "artificial-intelligence" .

ngm:comfy-ui a owl:Class ;
    rdfs:label "Comfy Ui"@en ;
    rdfs:comment "ComfyUI is an open-source, node-graph based interface for building and executing generative-AI image and video pipelines, most commonly around diffusion models such as Stable Diffusion. Users assemble workflows by wiring together nodes for model loading, sampling, conditioning and post-processing, giving fine-grained control over the generation graph. Its modular design supports extensions, custom nodes and reproducible, shareable workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python ],
        [ a owl:Restriction ;
