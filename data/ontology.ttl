    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Decoder
artificial-intelligence:Decoder rdf:type owl:Class ;
    rdfs:label "Decoder"@en ;
    rdfs:comment "The component in an encoder-decoder architecture that generates the output sequence autoregressively, using masked self-attention, cross-attention to encoder outputs, and feed-forward layers."@en ;
    skos:prefLabel "Decoder"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:decoder" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:decoder> ;
