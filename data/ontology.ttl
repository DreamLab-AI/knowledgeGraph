# Robot Operating System
robotics:RobotOperatingSystem rdf:type owl:Class ;
    rdfs:subClassOf robotics:RoboticMiddleware ;
    rdfs:subClassOf robotics:PublishSubscribeFramework ;
    rdfs:label "Robot Operating System"@en ;
    rdfs:comment "The Robot Operating System (ROS / ROS 2) is an open-source middleware framework providing a structured communication layer, tool ecosystem, and package repository for robotic software development, enabling modular composition of perception, planning, and actuation subsystems through a publish-subscribe and service-call graph. ROS 2, built on the Data Distribution Service (DDS) transport, adds real-time guarantees, multi-platform support, and security (SROS2) absent from the original ROS 1, making it the de-facto integration substrate for both research robots and production autonomous systems, and a bridging target for VisionClaw Agentic Container agent skills interacting with physical hardware."@en ;
    skos:prefLabel "Robot Operating System"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:robot-operating-system" ;
    owl:sameAs <urn:visionclaw:concept:robotics:robot-operating-system> ;
    vcw:contentHash "sha256-12-8b2d4f6e1a3c" ;
    vcw:qualityScore "0.7"^^xsd:decimal ;
    vcw:legacyTermId "RB-robot-operating-system" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.85"^^xsd:decimal ;
    dcterms:identifier "RB-robot-operating-system" ;
    dcterms:subject "robotics" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

