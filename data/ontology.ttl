ngm:knowledge-discovery a owl:Class ;
    rdfs:label "Knowledge Discovery"@en ;
    rdfs:comment "Knowledge Discovery is the process of identifying valid, novel, useful and understandable patterns in data, transforming raw records into actionable knowledge. It spans data selection, cleaning, transformation, mining and interpretation, and draws on statistics, machine learning, information retrieval and database technology. The discipline is often framed as Knowledge Discovery in Databases (KDD), within which data mining is the specific pattern-extraction step."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-retrieval ],
        ngm:knowledge-management ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:contrastsWith ngm:information-retrieval ;
    vc:dependsOn ngm:ontology ;
    vc:enables ngm:data-analytics,
        ngm:enterprise-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:information-retrieval ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management ;
    vc:requires ngm:metadata ;
    vc:slug "knowledge-discovery" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:search-engine,
        ngm:semantic-search ;
    vc:uses ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:text-mining .

ngm:learning-rate a owl:Class ;
    rdfs:label "Learning Rate"@en ;
    rdfs:comment "The learning rate is a hyperparameter in gradient-based optimisation that scales the size of each parameter update applied in the direction of the negative gradient. It governs the trade-off between the speed of convergence and the stability of training: too large a value can cause divergence or oscillation, while too small a value leads to slow progress or stalling in poor regions. It is one of the most consequential settings when training neural networks and is often varied over the course of training by a schedule or adapted per parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:hyperparameter ;
    vc:bridgesTo ngm:adam-optimiser ;
    vc:contrastsWith ngm:stochastic-gradient-descent ;
    vc:dependsOn ngm:optimiser ;
    vc:enables ngm:convergence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:hyperparameter-tuning ;
    vc:isPartOf ngm:gradient-descent ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:hyperparameter,
        ngm:loss-function ;
    vc:requires ngm:gradient-descent ;
    vc:slug "learning-rate" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:neural-network-training ;
    vc:uses ngm:learning-rate-schedule .

ngm:linearizability a owl:Class ;
    rdfs:label "Linearizability"@en ;
    rdfs:comment "Linearizability is a strong consistency model for concurrent and distributed systems requiring that every operation appears to take effect atomically at a single point in time between its invocation and its response, consistent with a global real-time ordering. It is a composable (local) property: a system is linearizable if each individual object is linearizable. Informally it guarantees that once a write completes, all subsequent reads observe that write or a later one, giving the illusion of a single, instantaneous copy of the data. Formalised by Herlihy and Wing, it is the gold standard against which weaker models such as eventual consistency are contrasted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:consistency-model ;
    vc:contrastsWith ngm:cap-theorem ;
    vc:dependsOn ngm:distributed-consensus ;
    vc:enables ngm:fault-tolerance,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:concurrency-control,
        ngm:consensus-algorithm,
        ngm:distributed-consensus,
        ngm:replication ;
    vc:requires ngm:consensus-algorithm,
        ngm:quorum ;
    vc:slug "linearizability" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:distributed-systems ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:liquidity-coverage-ratio a owl:Class ;
    rdfs:label "Liquidity Coverage Ratio"@en ;
    rdfs:comment "The Liquidity Coverage Ratio (LCR) is a prudential regulatory standard requiring banks to hold a stock of high-quality liquid assets sufficient to cover their projected net cash outflows over a thirty-day stress scenario. Introduced under Basel III, it is expressed as the ratio of the liquidity buffer to stressed net outflows and must equal or exceed one hundred per cent. The measure is designed to ensure short-term resilience to acute liquidity shocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:capital-adequacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stress-testing ],
        ngm:banking-regulation ;
    vc:bridgesTo ngm:regulatory-framework ;
    vc:contrastsWith ngm:capital-adequacy ;
    vc:dependsOn ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:capital-adequacy ;
    vc:implements ngm:prudential-regulation ;
    vc:isPartOf ngm:basel-iii ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:capital-adequacy,
        ngm:financial-regulation ;
    vc:requires ngm:stress-testing ;
    vc:slug "liquidity-coverage-ratio" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:basel-iii ;
    vc:supports ngm:financial-stability .

ngm:logistics-optimisation a owl:Class ;
    rdfs:label "Logistics Optimisation"@en ;
    rdfs:comment "Logistics optimisation is the application of mathematical optimisation and operations-research techniques to minimise cost or time across logistics operations such as routing, scheduling, and inventory placement. It formulates problems like vehicle routing, network flow, and bin packing, often solved with linear programming, heuristics, or machine learning. The goal is to extract maximal efficiency from constrained transport and storage resources."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation,
        ngm:demand-forecasting ;
    vc:slug "logistics-optimisation" ;
    vc:sourceDomain "supply-chain" .

ngm:low-latency-network a owl:Class ;
    rdfs:label "Low-Latency Network"@en ;
    rdfs:comment "A low-latency network is a communications network engineered to minimise the round-trip delay experienced by data packets travelling between endpoints. It combines short physical paths, fast switching, prioritised traffic handling, and edge placement of compute so that interactive and real-time applications respond within tight, predictable time bounds. Such networks are foundational to immersive and time-critical experiences where perceptible delay degrades usability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:latency ;
    vc:dependsOn ngm:edge-computing,
        ngm:network-topology ;
    vc:enables ngm:cloud-gaming,
        ngm:immersive-experience,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:spatial-computing ;
    vc:requires ngm:bandwidth,
        ngm:quality-of-service ;
    vc:slug "low-latency-network" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:real-time-communication,
        ngm:real-time-rendering ;
    vc:uses ngm:content-delivery-network,
        ngm:network-protocol .

ngm:lp-token a owl:Class ;
    rdfs:label "LP Token"@en ;
    rdfs:comment "An LP (Liquidity Provider) token is a fungible cryptographic token minted by a decentralised exchange or liquidity pool smart contract to represent a depositor's proportional ownership stake in a pool's combined assets, accrued fees, and associated yield. LP tokens serve as receipts that can be redeemed to withdraw the underlying liquidity position at any time."@en ;
    rdfs:subClassOf ngm:token-standard ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:liquidity-provider,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:impermanent-loss ;
    vc:slug "lp-token" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:liquidity-pool,
        ngm:smart-contract .

ngm:machine-learning-operations a owl:Class ;
    rdfs:label "Machine Learning Operations"@en ;
    rdfs:comment "Machine learning operations is the discipline of applying DevOps principles, tooling, and automation to the end-to-end machine learning lifecycle so that models can be reliably built, deployed, monitored, and retrained in production. It coordinates data pipelines, experiment tracking, model registries, continuous integration and delivery, serving infrastructure, and observability to bridge the gap between data-science experimentation and dependable operational systems. By treating data, code, and models as versioned, testable artifacts, it makes ML systems reproducible, auditable, and continuously improvable rather than fragile one-off deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-versioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:devops,
        ngm:machine-learning ;
    vc:dependsOn ngm:data-pipeline ;
    vc:enables ngm:model-serving,
        ngm:model-versioning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-deployment,
        ngm:model-monitoring,
        ngm:model-registry ;
    vc:implements ngm:devops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-deployment,
        ngm:model-training ;
    vc:requires ngm:data-pipeline,
        ngm:data-versioning ;
    vc:slug "machine-learning-operations" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:model-governance ;
    vc:uses ngm:continuous-integration,
        ngm:feature-store,
        ngm:kubernetes .

ngm:medical-diagnosis-ai a owl:Class ;
    rdfs:label "Medical Diagnosis AI"@en ;
    rdfs:comment "Medical Diagnosis AI refers to artificial intelligence systems that automate or assist in the diagnostic process by analysing patient symptoms, medical history, laboratory results, imaging findings, and other clinical data to generate differential diagnoses, diagnostic hypotheses, and diagnostic ..."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:medical-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:clinical-decision-support,
        ngm:treatment-planning-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai,
        ngm:healthcare-ai ;
    vc:slug "medical-diagnosis-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:knowledge-graph .

ngm:medical-image-analysis a owl:Class ;
    rdfs:label "Medical Image Analysis"@en ;
    rdfs:comment "Medical Image Analysis is the application of computer-vision and machine-learning methods to interpret images produced by medical imaging modalities such as radiography, computed tomography, magnetic resonance imaging, ultrasound and pathology slides. It encompasses tasks including segmentation of anatomy and lesions, detection and classification of abnormalities, registration across images, and quantitative measurement. Modern systems rely heavily on deep convolutional and transformer-based models trained on annotated clinical data. It supports radiologists and clinicians in diagnosis, treatment planning and monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:medical-imaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:healthcare-ai,
        ngm:precision-medicine ;
    vc:dependsOn ngm:transfer-learning ;
    vc:enables ngm:computer-aided-diagnosis,
        ngm:diagnostic-imaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:image-classification,
        ngm:image-segmentation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:image-registration,
        ngm:object-detection ;
    vc:requires ngm:annotated-data,
        ngm:medical-imaging ;
    vc:slug "medical-image-analysis" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:radiology,
        ngm:treatment-planning ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning .

ngm:memory-store a owl:Class ;
    rdfs:label "Memory Store"@en ;
    rdfs:comment "A memory store is the persistence layer in an AI agent system that retains information across turns and sessions for later retrieval. It typically holds conversation history, facts, and learned context, often as embeddings in a vector database to enable semantic recall. The memory store is what allows agents to maintain continuity, personalise responses, and accumulate knowledge beyond a single context window."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:context-engineering ;
    vc:slug "memory-store" ;
    vc:sourceDomain "ai" .

ngm:meta-ai a owl:Class ;
    rdfs:label "Meta AI"@en ;
    rdfs:comment "Meta AI is the artificial intelligence research and applied AI division of Meta Platforms, Inc., encompassing the Fundamental AI Research (FAIR) laboratory for long-horizon academic research and multiple applied AI teams that embed machine-learning capabilities into Meta products including Facebook, Instagram, and WhatsApp. The division is best known for its open-weight large language model series LLaMA, the zero-shot image segmentation model Segment Anything (SAM), the multimodal joint-embedding model ImageBind, and early contributions to the broader AI ecosystem including the PyTorch deep-learning framework and fastText word embeddings. Meta AI's open-weight release strategy has materially shaped the open-source AI ecosystem by enabling community fine-tuning, on-device deployment, and proliferation of derivative models without dependence on proprietary inference APIs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:meta-llama-model-family ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:anthropic,
        ngm:google-ai-technology-corporation-deep-mind,
        ngm:openai-research-organisation ;
    vc:enables ngm:multimodal-ai-architecture-ai,
        ngm:on-device-inference,
        ngm:open-source-ai,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fundamental-ai-research,
        ngm:imagebind,
        ngm:meta-llama-model-family,
        ngm:segment-anything ;
    vc:implements ngm:ai-model-card,
        ngm:responsible-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-research-organisation,
        ngm:ai-safety,
        ngm:fine-tuning,
        ngm:open-weight-model,
        ngm:zero-shot-learning ;
    vc:requires ngm:distributed-training,
        ngm:gpu-cluster ;
    vc:slug "meta-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:uses ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:python-pytorch-deep-learning-stack,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:self-supervised-learning .

ngm:metadata-repository a owl:Class ;
    rdfs:label "Metadata Repository"@en ;
    rdfs:comment "Storage systems that centralise metadata from diverse data sources, providing unified access to technical, business, and operational metadata for data discovery, cataloguing, lineage tracking, and governance across enterprise environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:data-management ;
    vc:enables ngm:data-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metadata-repository" ;
    vc:sourceDomain "spatial-computing" .

ngm:microphone a owl:Class ;
    rdfs:label "Microphone"@en ;
    rdfs:comment "A microphone is a transducer that converts acoustic sound waves into an electrical signal, serving as the primary audio sensor in interactive and telepresence systems. Common types include electret, MEMS, condenser, and dynamic, characterised by polar pattern, sensitivity, and signal-to-noise ratio. In robots and voice interfaces, microphone arrays additionally enable beamforming and source localisation."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:tc-0003-telepresence-robot,
        ngm:voice-interaction ;
    vc:slug "microphone" ;
    vc:sourceDomain "robotics" .

ngm:microphone-array a owl:Class ;
    rdfs:label "Microphone Array"@en ;
    rdfs:comment "A microphone array is an arrangement of multiple microphone elements at known spatial positions whose signals are combined to infer or shape the directional properties of captured sound. By exploiting the time and phase differences between elements, an array supports beamforming, source localisation and spatial noise suppression that a single microphone cannot achieve. Microphone arrays underpin far-field voice capture, conferencing systems and spatial-audio acquisition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
