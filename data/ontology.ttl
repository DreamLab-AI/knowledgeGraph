@prefix ngm: <https://narrativegoldmine.com/class/> .
@prefix ngmi: <https://narrativegoldmine.com/individual/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vc: <https://narrativegoldmine.com/ns/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ngm:3-d-and-4-d a owl:Class ;
    rdfs:label "3D and 4D"@en ;
    rdfs:comment "The domain of three-dimensional and four-dimensional content creation, covering tools, techniques, and AI-powered pipelines for generating, editing, and rendering 3D assets and temporally dynamic (4D) representations. Encompasses text-to-3D systems (NVIDIA Edify, Luma Genie, Point-E), neural radiance fields, Gaussian splatting, and diffusion-based mesh generation, as well as 6D pose estimation, scene-scale generation, and integration with AR/VR workflows."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-asset,
        ngm:augmented-reality,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:machine-learning ;
    vc:slug "3-d-and-4-d" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-ai,
        ngm:neural-radiance-field .

ngm:3-d-scene-exchange-protocol-sxp a owl:Class ;
    rdfs:label "3D Scene Exchange Protocol (SXP)"@en ;
    rdfs:comment "Open standards framework enabling interoperable transfer of complete 3D scene graphs including geometric meshes (polygon topology vertex positions normals texture coordinates with indexed triangle lists optimized for GPU rendering), physically-based rendering (PBR) material systems (metallic-roug..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:3-d-asset-interchange,
        ngm:ar-vr-experiences,
        ngm:asset-portability,
        ngm:collaborative-workflows,
        ngm:cross-platform-compatibility,
        ngm:e-commerce-3-d,
        ngm:metaverse-interoperability,
        ngm:real-time-rendering,
        ngm:web-3-d-visualization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:animation-rig,
        ngm:camera-definition,
        ngm:geometric-mesh,
        ngm:lighting-environment,
        ngm:lod-specification,
        ngm:material-system,
        ngm:normal-map,
        ngm:pbr-workflow,
        ngm:polygon-topology,
        ngm:scene-hierarchy,
        ngm:skeletal-bone,
        ngm:texture-map,
        ngm:uv-coordinate,
        ngm:vertex-attribute ;
    vc:implements ngm:extension-mechanism,
        ngm:mesh-lod,
        ngm:non-destructive-editing,
        ngm:pbr-materials,
        ngm:progressive-loading,
        ngm:scene-composition,
        ngm:scene-graph-format,
        ngm:skeletal-animation,
        ngm:version-control ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-modeling-software,
        ngm:animation-tools,
        ngm:game-engine,
        ngm:material-converter,
        ngm:mesh-compression,
        ngm:rendering-pipeline,
        ngm:scene-validator,
        ngm:texture-authoring ;
    vc:slug "3-d-scene-exchange-protocol-sxp" ;
    vc:sourceDomain "spatial-computing" .

ngm:accountable-party a owl:Class ;
    rdfs:label "Accountable Party"@en ;
    rdfs:comment "An Accountable Party is an individual, organisation, or role that bears defined responsibility for specific aspects of an AI system's development, deployment, operation, or outcomes, with corresponding obligations to ensure compliance with governance principles, regulatory requirements, and ethical standards. Accountability addresses the foundational question of who bears responsibility when AI systems cause harm or produce unfair outcomes, requiring that identifiable parties possess the authority, resources, and monitoring capacity commensurate with their obligations. Accountable parties span the AI value chain—from data providers and model developers to deploying organisations, system operators, and governance bodies—each with lifecycle-specific duties enforced through formal reporting structures and consequence mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-ethics-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:compliance-monitoring,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-ethics-board ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:audit-trail,
        ngm:compliance-control,
        ngm:risk-assessment ;
    vc:requires ngm:accountability,
        ngm:compliance-framework,
        ngm:human-oversight ;
    vc:slug "accountable-party" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-governance-framework ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:governance-framework .

ngm:agentic-workshop a owl:Class ;
    rdfs:label "Agentic Workshop"@en ;
    rdfs:comment "A structured training programme introducing practitioners to agentic AI systems, covering context engineering, memory management, agent orchestration tools (such as Roo Code), and practical case studies in project management, data visualisation, and academic research through phased, multi-session instruction."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:agentic-ai,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:advice-for-developing-gen-ai,
        ngm:agent-frameworks ;
    vc:slug "agentic-workshop" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-and-ethics ;
    vc:uses ngm:ai-agent-system,
        ngm:large-language-models .

ngm:agreement-protocol a owl:Class ;
    rdfs:label "Agreement Protocol"@en ;
    rdfs:comment "An Agreement Protocol is a distributed protocol specifically designed to enable multiple independent nodes to reach consensus on a single value, decision, or sequence of events despite the presence of failures, network asynchrony, and potentially malicious participants. Agreement protocols must satisfy safety (all honest nodes agree on the same value), liveness (the protocol eventually terminates), and validity (the agreed value was proposed by some participant), and their design space is constrained by impossibility results such as the FLP theorem and Byzantine Agreement bounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:bc-protocol-and-consensus,
        ngm:distributed-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-governance,
        ngm:blockchain-protocol,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-algorithm,
        ngm:consensus-mechanism ;
    vc:implements ngm:nakamoto-consensus ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:node,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:slug "agreement-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:agricultural-robot a owl:Class ;
    rdfs:label "Agricultural Robot"@en ;
    rdfs:comment "Agricultural Robot - A semi-autonomous or fully autonomous platform equipped with Precision Agriculture Sensors, Manipulation Modules, and Crop Analysis Systems for performing field operations including planting, selective weeding, harvesting, and health monitoring whilst minimising s..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:soft-robotics ],
        ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:crop-quality-improvement,
        ngm:environmental-sustainability,
        ngm:labour-cost-reduction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:precision-agriculture-system,
        ngm:sustainable-farming ;
    vc:qualityScore "0.53"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:environmental-sensors,
        ngm:soft-robotics,
        ngm:terrain-navigation ;
    vc:slug "agricultural-robot" ;
    vc:sourceDomain "robotics" .

ngm:ai-as-a-step-function a owl:Class ;
    rdfs:label "AI as a step function"@en ;
    rdfs:comment "A conceptual framework positing that AI capability does not progress linearly but instead exhibits discontinuous threshold transitions—analogous to the mathematical step function—where accumulated incremental improvements trigger rapid, self-reinforcing shifts in capability order, akin to historical inflection points such as the Cambrian explosion or the printing press. The framework draws on self-organisation theory and feedback-loop dynamics to argue that AI represents the next major complexity transition in evolutionary and technological history."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:ai-safety,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:artificial-intelligence,
        ngm:generative-ai ;
    vc:slug "ai-as-a-step-function" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-concept .

ngm:ai-core-concepts a owl:Class ;
    rdfs:label "ai core concepts"@en ;
    rdfs:comment "Foundational artificial intelligence technologies — including machine learning paradigms (supervised, unsupervised, reinforcement), neural architectures (neural networks, transformers, CNNs), generative models, and classical symbolic reasoning — that collectively enable intelligent system behaviour. In metaverse contexts these concepts drive NPC dialogue, environment perception, procedural content generation, and federated privacy-preserving learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:computer-vision,
        ngm:inference,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:generative-ai,
        ngm:machine-learning,
        ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "ai-core-concepts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:federated-learning .

ngm:ai-defence-doc a owl:Class ;
    rdfs:label "AI Defence Doc"@en ;
    rdfs:comment "A curated reference document compiling empirical evidence countering common objections to AI capability and originality claims, aggregating benchmarks, research findings, and expert commentary demonstrating that large language models exhibit reasoning, world-model construction, and generalisation beyond stochastic pattern matching. Serves as an evidence base for constructive discourse on AI capabilities and their societal implications."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-ethics,
        ngm:explainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "ai-defence-doc" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:responsible-ai .

ngm:ai-documentation-standards a owl:Class ;
    rdfs:label "AI Documentation Standards"@en ;
    rdfs:comment "AI Documentation Standards are structured frameworks and templates for comprehensively documenting AI systems, datasets, and models to ensure transparency, accountability, reproducibility, and informed stakeholder decision-making throughout the AI lifecycle."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-governance ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ai-documentation-standards" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-grounded-domain a owl:Class ;
    rdfs:label "AI-GroundedDomain"@en ;
    rdfs:comment "A meta-classification domain for AI concepts that are empirically grounded in operational systems, validated through real-world deployment, and supported by measurable performance data rather than purely theoretical constructs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:performance-metrics ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:performance-metrics ;
    vc:slug "ai-grounded-domain" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-machine-learning a owl:Class ;
    rdfs:label "Ai Machine Learning"@en ;
    rdfs:comment "AI Machine Learning in the metaverse context refers to the application of artificial intelligence algorithms, neural networks, and deep learning architectures that enable intelligent virtual environments through natural language processing, computer vision, procedural content generation, and adap..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-infrastructure ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:adaptive-npcs,
        ngm:content-generation,
        ngm:personalized-experiences,
        ngm:smart-virtual-environments ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:computational-infrastructure,
        ngm:neural-network-architecture,
        ngm:training-data ;
    vc:slug "ai-machine-learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-metadata a owl:Class ;
    rdfs:label "AI Metadata"@en ;
    rdfs:comment "Descriptive information, provenance data, and contextual attributes associated with AI models, datasets, and computational artefacts. Includes model cards documenting architecture, training procedures, performance metrics, intended use, and known limitations; dataset metadata capturing collection methods, labelling procedures, and potential biases; and lineage records enabling reproducibility, regulatory compliance, and responsible deployment throughout the machine learning lifecycle."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:ai-governance,
        ngm:data-provenance,
        ngm:transparency-oecd ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ai-metadata" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-audit,
        ngm:data-governance ;
    vc:uses ngm:ai-model-card,
        ngm:training-dataset-metadata .

ngm:ai-privacy-at-the-2024-olympics a owl:Class ;
    rdfs:label "AI privacy at the 2024 Olympics"@en ;
    rdfs:comment "A case study examining the deployment of AI-based surveillance systems at the Paris 2024 Olympic Games, involving real-time video analytics, geolocation tracking, behavioural pattern analysis, and predictive event detection contracted to vendors including Viet, Orange Business, Chaps Vision, and Windex. The deployment required French legislative modifications expanding surveillance powers and raised significant GDPR compliance questions regarding continuous monitoring, data retention, algorithmic bias, and the post-event normalisation of pervasive AI surveillance infrastructure."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-ethics,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:cryptography,
        ngm:fairness,
        ngm:privacy-by-design ;
    vc:slug "ai-privacy-at-the-2024-olympics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:object-detection-and-tracking .

ngm:ai-tri-sm a owl:Class ;
    rdfs:label "AI TRiSM"@en ;
    rdfs:comment "AI TRiSM (Artificial Intelligence Trust, Risk, and Security Management) is a Gartner-coined framework that integrates technical, organisational, and regulatory controls to ensure AI systems are trustworthy, fair, reliable, and secure throughout their lifecycle. It addresses algorithmic bias, model opacity, data privacy, adversarial vulnerabilities, and compliance with regulations such as the EU AI Act, structured around three pillars: Trust, Risk, and Security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-trustworthiness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-robustness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-risk-management ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:ai-risk-management,
        ngm:ai-security,
        ngm:ai-trustworthiness ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-lifecycle,
        ngm:ai-regulation,
        ngm:ai-safety,
        ngm:red-teaming ;
    vc:requires ngm:algorithmic-bias,
        ngm:explainable-ai,
        ngm:model-robustness ;
    vc:slug "ai-tri-sm" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:aiapplications a owl:Class ;
    rdfs:label "AIApplications"@en ;
    rdfs:comment "A domain classification encompassing the practical deployment and use cases of artificial intelligence systems across industries, including autonomous systems, decision support, content generation, predictive analytics, and intelligent automation."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-capability ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "aiapplications" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:aicafev6 a owl:Class ;
    rdfs:label "AICafev6"@en ;
    rdfs:comment "AICafev6 is the sixth iteration of the AI Cafe demonstration platform, an open-source immersive knowledge development environment built on VisionFlow that integrates multi-modal AI, GPU-accelerated analytics, and agentic workflows for collaborative knowledge creation and presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:agentic-ai,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:large-language-models ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision ;
    vc:slug "aicafev6" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:ai-agent-system,
        ngm:generative-ai .

ngm:aidomain a owl:Class ;
    rdfs:label "AIDomain"@en ;
    rdfs:comment "AIDomain is the compact namespace identifier for the Artificial Intelligence Domain within this ontology, serving as a top-level classification anchor for all AI-related concepts including methods, models, systems, applications, and governance frameworks. It is semantically equivalent to ArtificialIntelligenceDomain and is used in belongsToDomain assertions and cross-domain bridge declarations to link AI concepts with blockchain, metaverse, robotics, and telecollaboration domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:ai-research-area,
        ngm:technology-domain ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain-domain,
        ngm:metaverse-domain,
        ngm:robotics-domain,
        ngm:telecollaboration-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-governance,
        ngm:computer-vision,
        ngm:deep-learning,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-applications,
        ngm:ai-ethics,
        ngm:artificial-intelligence-domain ;
    vc:slug "aidomain" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:aiethics-domain a owl:Class ;
    rdfs:label "AIEthicsDomain"@en ;
    rdfs:comment "The AIEthicsDomain is the comprehensive knowledge domain encompassing ethical considerations, fairness principles, governance frameworks, and accountability mechanisms for artificial intelligence systems, spanning mathematical fairness metrics, bias mitigation techniques, transparency methods, and regulatory compliance across the full AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accountability,
        ngm:bias,
        ngm:explainability,
        ngm:fairness ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:aiethics ;
