# Accessible Design
spatial-computing:AccessibleDesign rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:UniversalDesign ;
    rdfs:subClassOf spatial-computing:InclusiveDesign ;
    rdfs:label "Accessible Design"@en ;
    rdfs:comment "Accessible Design is the practice of creating virtual environments and interactions usable by people with diverse disabilities, incorporating universal design principles from conception through implementation. It integrates Accessibility Standards, Accessible Experience philosophy, and inclusive 3D User Interface design ensuring equitable Metaverse participation across visual, auditory, motor, and cognitive access dimensions."@en ;
    skos:prefLabel "Accessible Design"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:accessible-design" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:accessible-design> ;
    vcw:contentHash "sha256-12-3a61408a9e49" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "MV-9511" ;
