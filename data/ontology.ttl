ngm:adversarial-testing a owl:Class ;
    rdfs:label "Adversarial Testing"@en ;
    rdfs:comment "A testing methodology that deliberately attempts to cause AI system failures through adversarial inputs, edge cases, and challenging scenarios in order to identify robustness issues, safety vulnerabilities, and alignment failures before deployment. It encompasses both explicitly adversarial prompts and implicitly problematic queries, drawing on red-teaming practices and formalised by NIST AI 100-2."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:cybersecurity,
        ngm:digital-twin ;
    vc:contrastsWith ngm:conventional-software-testing,
        ngm:unit-testing ;
    vc:dependsOn ngm:benchmark-dataset,
        ngm:model-evaluation ;
    vc:enables ngm:bias-detection,
        ngm:robustness-evaluation,
        ngm:vulnerability-disclosure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:nist-ai-rmf,
        ngm:security-testing ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:adversarial-training,
        ngm:ai-governance,
        ngm:model-safety-evaluation ;
    vc:requires ngm:machine-learning-discipline-model,
        ngm:test-oracle,
        ngm:threat-model ;
    vc:slug "adversarial-testing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:nist-ai-100-2 ;
    vc:supports ngm:ai-alignment,
        ngm:ai-safety,
        ngm:responsible-ai,
        ngm:robustness ;
    vc:uses ngm:adversarial-examples,
        ngm:fuzzing,
        ngm:prompt-injection,
        ngm:red-teaming .

ngm:audit-log a owl:Class ;
    rdfs:label "Audit Log"@en ;
    rdfs:comment "An audit log is an immutable, chronologically ordered record of discrete system events that captures who performed an action, what action was performed, on which resource, at what time, and from what source context, providing an authoritative evidence trail for security investigation, regulatory compliance, and forensic analysis. Each entry is structured with a timestamp, actor identity, event type, affected object identifier, outcome status, and contextual metadata. Audit logs are foundational to accountability in information systems, distinguished from operational logs by their emphasis on human-actionable accountability and legal evidentiary weight rather than system diagnostics. In high-assurance environments, entries are cryptographically chained so that deletion or modification of any record invalidates all subsequent hashes, making tampering detectable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:time-synchronisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:audit-trail ;
    vc:bridgesTo ngm:blockchain,
        ngm:certificate-transparency ;
    vc:contrastsWith ngm:debug-log,
        ngm:operational-log ;
    vc:enables ngm:anomaly-detection,
        ngm:regulatory-reporting,
        ngm:security-audit ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audit-logging,
        ngm:compliance-audit-trail,
        ngm:data-integrity,
        ngm:forensic-analysis,
        ngm:non-repudiation,
        ngm:siem ;
    vc:requires ngm:identity-management,
        ngm:tamper-evident-storage,
        ngm:time-synchronisation ;
    vc:slug "audit-log" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:common-event-format,
        ngm:iso-27001,
        ngm:nist-sp-800-92 ;
    vc:supports ngm:access-control,
        ngm:compliance-framework,
        ngm:incident-response,
        ngm:information-security,
        ngm:threat-detection ;
    vc:uses ngm:append-only-data-structure,
        ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:event-sourcing,
        ngm:merkle-tree .

ngm:authentication-standards a owl:Class ;
    rdfs:label "Authentication Standards"@en ;
    rdfs:comment "Authentication Standards encompass protocols and specifications for verifying user identity in digital systems, particularly FIDO2 and WebAuthn standards that enable passwordless, phishing-resistant authentication using public key cryptography and hardware authenticators for secure access to metaverse platforms and blockchain applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
