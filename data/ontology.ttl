    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:creative-expression,
        ngm:emergent-behavior,
        ngm:non-linear-storytelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emergent-gameplay,
        ngm:non-linear-narrative,
