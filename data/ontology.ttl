ngm:agentic-finance a owl:Class ;
    rdfs:label "Agentic Finance"@en ;
    rdfs:comment "Infrastructure enabling autonomous AI agents to hold cryptographic wallets, provision compute resources, negotiate contracts, and transact with other agents or humans without intermediaries. AgentFi bridges decentralised finance protocols with agentic AI systems, creating machine-to-machine economic coordination layers."@en ;
