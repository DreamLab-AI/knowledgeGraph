ngm:inter-world-remittance a owl:Class ;
    rdfs:label "Inter-world Remittance"@en ;
    rdfs:comment "The transfer of economic value, digital currency, or tokenised assets across distinct virtual worlds, metaverse platforms, or between virtual and physical economies via blockchain bridges, smart-contract escrow, or centralised exchange mechanisms. Inter-world remittance enables labour mobility, cross-platform portfolio management, and arbitrage within interconnected digital economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-interoperability ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:tokenisation ;
    vc:requires ngm:blockchain-interoperability,
        ngm:smart-contract ;
    vc:slug "inter-world-remittance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-asset,
        ngm:virtual-currency .

