ngm:decentralized-control a owl:Class ;
    rdfs:comment "Decentralized control is a control paradigm in which decision-making authority is distributed across many independent agents or nodes rather than concentrated in a single central controller, with global behaviour emerging from local rules and limited peer-to-peer communication. It trades the predictability of centralised control for robustness to single-point failure, scalability to large numbers of agents, and resilience under communication or node loss. Decentralized control is applied both in political and organisational governance and, in engineering, in domains such as swarm robotics where large numbers of simple agents must coordinate without a central coordinator."@en ;
    rdfs:label "Decentralized Control"@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:enables ngm:swarm-robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "decentralized-control" ;
    vc:sourceDomain "distributed-systems" .
