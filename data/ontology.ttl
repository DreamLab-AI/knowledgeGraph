ngm:gpu-acceleration a owl:Class ;
    rdfs:label "GPU Acceleration"@en ;
    rdfs:comment "GPU Acceleration is the use of graphics processing units to perform general-purpose computational workloads in a massively parallel fashion, exploiting thousands of shader cores arranged in a single-instruction-multiple-data (SIMD) architecture to achieve throughput orders of magnitude beyond conventional CPUs for data-parallel tasks such as matrix multiplication and tensor contraction. It is the dominant execution paradigm for training and inference in modern deep learning, scientific simulation, and real-time rendering pipelines. The programming model is exposed through vendor APIs such as CUDA and ROCm, as well as cross-platform standards including OpenCL and SYCL. Hierarchical parallelism — threads grouped into warps, warps into thread blocks, blocks into grids dispatched across streaming multiprocessors — enables fine-grained exploitation of data parallelism at every level of the memory hierarchy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-core ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        ngm:hardware-acceleration ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:cpu-computing,
        ngm:neuromorphic-computing,
        ngm:tensor-processing-unit ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:memory-bandwidth ;
    vc:enables ngm:deep-learning,
        ngm:inference,
        ngm:large-language-model,
        ngm:ray-tracing,
        ngm:scientific-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:high-bandwidth-memory,
        ngm:tensor-core ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:gpu-computing,
        ngm:quantisation ;
    vc:requires ngm:cuda,
        ngm:gpu-driver,
        ngm:parallel-programming-model ;
    vc:slug "gpu-acceleration" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-parallelism,
        ngm:inference-serving,
        ngm:model-parallelism,
        ngm:neural-network-training ;
    vc:uses ngm:compute-shader,
        ngm:cuda,
        ngm:mixed-precision-training,
        ngm:opencl .

ngm:graph-theory a owl:Class ;
    rdfs:label "Graph Theory"@en ;
    rdfs:comment "Graph Theory is the branch of mathematics that studies graphs, structures consisting of vertices connected by edges, used to model pairwise relationships between objects. It examines properties such as connectivity, paths, cycles, colourings, matchings and flows, and classifies graphs by structure (for example trees, bipartite and planar graphs). Originating with Euler's 1736 solution of the Seven Bridges of Konigsberg problem, it now underpins network analysis, optimisation and computer science. Graph algorithms are fundamental to routing, scheduling, social network analysis and the representation of knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-algorithms ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain,
        ngm:cryptography,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:euclidean-geometry,
        ngm:relational-algebra ;
    vc:enables ngm:knowledge-graph,
        ngm:network-analysis,
        ngm:recommendation-system,
        ngm:routing-protocol,
        ngm:social-network-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graph-algorithms,
        ngm:path-planning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computational-complexity-theory,
        ngm:topology ;
    vc:requires ngm:combinatorics,
        ngm:set-theory ;
    vc:slug "graph-theory" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:graph-neural-network,
        ngm:ontology ;
    vc:uses ngm:adjacency-matrix,
        ngm:dynamic-programming,
        ngm:linear-algebra .

