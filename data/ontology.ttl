            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-to-speech ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-translation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:bridgesTo ngm:ai-application,
        ngm:communication-infrastructure ;
    vc:enables ngm:market-expansion,
        ngm:remote-work,
        ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automatic-speech-recognition,
