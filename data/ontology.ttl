vf:training-and-fine-tuning a owl:Class ;
    rdfs:label "Training and fine tuning"@en ;
    rdfs:comment "**Fine-tuning** is the post-pre-training adaptation of a large neural network — typically a transformer-based [[Foundation Models]] or [[Large Language Models]] — to narrower task distributions or behavioural objectives by continuing gradient-based optimisation on comparatively small, curated datasets (10 K–1 M examples), contrasting with the trillion-token self-supervised pre-training covered in [[Model Training]]. Fine-tuning subdivides into four principal tracks: (1) **Supervised Fine-Tuning (SFT)**, also termed *instruction tuning*, presents (instruction, response) pairs to the model under a causal language modelling loss applied exclusively over response tokens, transforming a raw next-token predictor into an instruction-following assistant — exemplified by InstructGPT (Ouyang et al. 2022), Alpaca (Stanford 2023), FLAN (Wei et al. 2022), and Llama-3.1-Instruct; (2) **Preference Alignment** via Reinforcement Learning from Human Feedback ([[Reinforcement Learning from Human Feedback]]) using Proximal Policy Optimisation (PPO, Schulman et al. 2017) to maximise a learned scalar [[Reward Model]] while penalising KL-divergence from the SFT reference policy J(θ) = E[R_φ(x,y)] − β·KL("@en ;
    rdfs:subClassOf <urn:visionflow:linked:transfer-learning>,
        vf:deep-learning,
        vf:foundation-models,
        vf:machine-learning,
        vf:model-training ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:agents,
        vf:code-generation,
        vf:evaluation-benchmarks-and-leaderboards,
        vf:large-language-models,
        vf:medical-ai,
        vf:multi-task-learning,
        vf:safety-and-alignment ;
    vc:hasPart vf:constitutional-ai,
        vf:direct-preference-optimisation,
        vf:instruction-tuning,
        vf:knowledge-distillation,
        vf:lo-ra-do-ra-etc,
        vf:parameter-efficient-fine-tuning,
        vf:reinforcement-learning-from-human-feedback,
        vf:reward-model,
        vf:safety-fine-tuning,
        vf:supervised-fine-tuning ;
    vc:implements <urn:visionflow:linked:causal-language-modelling>,
        <urn:visionflow:linked:low-rank-adaptation>,
        vf:backpropagation,
        vf:preference-learning,
        vf:prefix-tuning,
        vf:prompt-tuning,
        vf:proximal-policy-optimisation ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:pre-trained-model>,
        vf:compute-infrastructure,
        vf:gradient-descent,
        vf:loss-function,
        vf:tokenization,
        vf:training-data ;
    vc:slug "training-and-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

