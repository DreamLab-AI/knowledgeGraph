ngm:enterprise-training a owl:Class ;
    rdfs:label "Enterprise Training"@en ;
    rdfs:comment "Enterprise Training in spatial computing is the use of immersive virtual and augmented reality experiences to upskill, certify and onboard a workforce at organisational scale. It places learners in realistic, interactive simulations of equipment, procedures and hazardous scenarios that would be costly or dangerous to reproduce physically. By combining experiential learning with analytics and learning-management integration, it improves retention, standardises competency and reduces training risk."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-experiences ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        ngm:immersive-experiences ;
    vc:bridgesTo ngm:workforce-development ;
    vc:contrastsWith ngm:learning-management-system ;
    vc:dependsOn ngm:virtual-reality ;
    vc:enables ngm:workforce-development ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:simulation ;
    vc:isPartOf ngm:immersive-experiences ;
