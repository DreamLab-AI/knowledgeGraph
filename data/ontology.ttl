    vc:slug "transaction-fees" ;
    vc:sourceDomain "blockchain" .

ngm:transaction-parameter a owl:Class ;
    rdfs:label "Transaction Parameter"@en ;
    rdfs:comment "Transaction Parameters are the configuration values that define the execution characteristics of a blockchain transaction, including gas limit, gas price (or priority fee under EIP-1559), nonce, value, and calldata. These parameters determine transaction priority, cost, computational resources consumed, and ordering within blocks, directly influencing DeFi strategies such as MEV extraction and Layer 2 batching efficiency."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-transaction ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:gas-optimization,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:layer2,
        ngm:smart-contract ;
    vc:slug "transaction-parameter" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:eip-1559,
        ngm:gas-limit,
        ngm:gas-price .

ngm:trojan-attack a owl:Class ;
    rdfs:label "Trojan Attack"@en ;
    rdfs:comment "A Trojan Attack is a supply-chain-oriented backdoor attack on AI models in which a pre-trained model or training pipeline is maliciously modified to embed hidden triggers; the model performs normally on clean inputs but produces attacker-defined outputs when specific trigger patterns are present. Unlike general backdoor attacks, Trojan attacks emphasise persistence through fine-tuning and distribution via public model repositories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:dependsOn ngm:ai-security ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attack,
        ngm:backdoor-attack,
        ngm:data-poisoning ;
    vc:requires ngm:supply-chain ;
    vc:slug "trojan-attack" ;
    vc:sourceDomain "spatial-computing" .

ngm:trusted-execution-pbft a owl:Class ;
    rdfs:label "Trusted Execution PBFT"@en ;
    rdfs:comment "Trusted Execution PBFT is a variant of Practical Byzantine Fault Tolerance that leverages Trusted Execution Environments (TEEs), specifically Intel SGX, to implement a Unique Sequential Identifier Generator (USIG) that reduces the protocol to two message phases rather than the standard three. By anchoring sequence number generation inside a tamper-resistant enclave, it eliminates the view-change overhead of classical PBFT while preserving Byzantine fault safety up to f < n/3 faulty replicas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        ngm:bc-protocol-and-consensus,
        ngm:practical-byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:fault-tolerance,
        ngm:node,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:trusted-execution-environment ;
    vc:slug "trusted-execution-pbft" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature,
        ngm:secure-enclave .

ngm:ucl a owl:Class ;
    rdfs:label "UCL"@en ;
