ngm:video-object-segmentation a owl:Class ;
    rdfs:comment "Video object segmentation is the computer-vision task of delineating and tracking the pixel-level boundaries of one or more objects across the frames of a video sequence. It extends single-image segmentation with temporal coherence, propagating masks while handling motion, occlusion and appearance change. It underpins video editing, autonomous perception, surveillance and content analysis."@en ;
    rdfs:label "Video Object Segmentation"@en ;
    rdfs:subClassOf ngm:computer-vision ;
