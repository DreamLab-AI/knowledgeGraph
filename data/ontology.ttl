    vc:hasPart ngm:public-key ;
    vc:implements ngm:key-agreement ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography ;
    vc:relatedTo ngm:elliptic-curve-cryptography ;
    vc:slug "diffie-hellman-key-exchange" ;
