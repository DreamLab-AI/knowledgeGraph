    vc:slug "solid-pod" ;
    vc:sourceDomain "infrastructure" .

ngm:sovereign-ai a owl:Class ;
    rdfs:label "Sovereign AI"@en ;
    rdfs:comment "National strategies for building indigenous AI capabilities—foundational models trained on sovereign data using domestically controlled compute infrastructure—to reduce dependence on foreign hyperscaler platforms. Encompasses government investment in national AI compute clusters, local language models, and data governance frameworks."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:competition-in-ai,
        ngm:open-source-ai ;
    vc:slug "sovereign-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:space-robotics a owl:Class ;
    rdfs:label "Space Robotics"@en ;
    rdfs:comment "Space robotics is the engineering discipline concerned with the design, development, and operation of robotic systems that function in the space environment, including planetary rovers, orbital manipulators, free-flying servicer spacecraft, and landers. These systems must contend with extreme thermal cycling, vacuum, radiation, communications latency, and the absence of gravity, requiring high degrees of autonomy, fault tolerance, and dexterous manipulation capability. Space robotics intersects closely with teleoperation research, autonomous navigation, computer vision, and the emerging field of on-orbit servicing and assembly."@en ;
    rdfs:subClassOf ngm:autonomous-robot ;
    vc:enables ngm:autonomous-system,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning ;
    vc:slug "space-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:simultaneous-localisation-and-mapping .

ngm:spatial-interaction a owl:Class ;
    rdfs:label "Spatial Interaction"@en ;
    rdfs:comment "The design and implementation of user input mods within extended reality environments that enable natural manipulation of virtual objects through gestures, eye tracking, voice commands, and physical movement in three-dimensional space."@en ;
    rdfs:subClassOf ngm:human-computer-interaction,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-user-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:stakeholder-engagement-in-ai a owl:Class ;
    rdfs:label "Stakeholder Engagement in AI"@en ;
    rdfs:comment "Stakeholder Engagement in AI is a participatory process that systematically identifies, involves, and incorporates perspectives from individuals, groups, and communities affected by or having legitimate interests in AI systems, ensuring inclusive design, accountable deployment, and responsive governance. Engagement spans a spectrum from information provision and consultation through to co-design and empowerment mechanisms, and is required by frameworks including the EU AI Act and the OECD AI Principles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-impact-assessment,
        ngm:bias-detection-methods,
        ngm:ethical-review-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:fairness,
        ngm:human-oversight,
        ngm:participation-framework ;
    vc:requires ngm:accountability,
        ngm:ai-governance,
        ngm:transparency ;
    vc:slug "stakeholder-engagement-in-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework,
        ngm:ai-policy .

ngm:stakeholder-trust a owl:Class ;
    rdfs:label "Stakeholder Trust"@en ;
    rdfs:comment "Stakeholder trust is the confident reliance that individuals, groups, or organisations — including users, operators, regulators, and affected communities — place in a system, institution, or technology to behave reliably, safely, and in accordance with stated values. In the context of AI and automated systems, stakeholder trust encompasses both calculative assessments of technical competence and affective judgements about integrity and ethical alignment, and is recognised as a prerequisite for adoption, legitimate deployment, and effective governance. It must be earned through demonstrated performance, transparency, and accountability rather than assumed."@en ;
    rdfs:subClassOf ngm:trust ;
    vc:enables ngm:ai-governance,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:stakeholder,
        ngm:stakeholder-engagement,
        ngm:trust-framework ;
    vc:slug "stakeholder-trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:trust-and-safety .

ngm:standards-conformance a owl:Class ;
    rdfs:label "Standards Conformance"@en ;
    rdfs:comment "The state or process of meeting the requirements specified in a technical standard, specification, or guideline, ensuring that a product, process, or system aligns with internal or industry-specific standards for interoperability, quality, and compatibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:interoperability,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:standards-conformance-testing ;
    vc:requires ngm:technical-standards ;
    vc:slug "standards-conformance" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards-body .

ngm:standards-documentation a owl:Class ;
    rdfs:label "Standards Documentation"@en ;
    rdfs:comment "Established guidelines, rules, and best practices that govern the creation of technical documentation, including structure, formatting conventions, terminology usage, delivery methods, and presentation to ensure consistency, clarity, and accuracy across all content. Standards documentation underpins interoperability, regulatory compliance, and knowledge transfer in technical domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standard ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:standards-conformance,
        ngm:standards-validation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:standards-body ;
    vc:requires ngm:technical-standard ;
    vc:slug "standards-documentation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:interoperability,
        ngm:standards-compliance .

ngm:surgical-navigation a owl:Class ;
    rdfs:label "Surgical Navigation"@en ;
    rdfs:comment "Surgical Navigation is the intraoperative technology and methodology that provides surgeons with real-time spatial guidance by registering preoperative imaging data (CT, MRI) with the patient's anatomy and continuously tracking the position of surgical instruments relative to that registered model. It is analogous to GPS navigation but for the operating room, enabling submillimetre accuracy in procedures where anatomical landmarks are obscured, such as orthopaedic, neurosurgery, and spinal operations."@en ;
    rdfs:subClassOf ngm:navigation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:haptic-feedback,
        ngm:surgical-robot,
        ngm:surgical-robotics ;
    vc:slug "surgical-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:healthcare-ai,
        ngm:precision-medicine ;
    vc:uses ngm:medical-imaging,
        ngm:pose-estimation,
        ngm:sensor-fusion,
        ngm:tracking-system .

ngm:sustainable-development-goals a owl:Class ;
    rdfs:label "Sustainable Development Goals"@en ;
    rdfs:comment "The Sustainable Development Goals (SDGs) are a set of 17 interlinked global goals adopted by all United Nations member states in 2015 as part of the 2030 Agenda for Sustainable Development, spanning the elimination of poverty, zero hunger, quality education, gender equality, clean energy, decent work, reduced inequalities, climate action, and partnerships for implementation. Each goal is operationalised through targets and indicators that define measurable progress benchmarks, providing a shared framework for national governments, international organisations, civil society, and the private sector to align strategies and report progress. The SDGs extend and deepen the Millennium Development Goals, recognising that sustainable development requires integrated action across social, economic, and environmental dimensions simultaneously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-sustainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainability-reporting ],
        ngm:sustainable-development ;
    vc:enables ngm:carbon-accounting,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:environmental-standards,
        ngm:esg-investing,
        ngm:global-inequality,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:environmental-sustainability,
        ngm:sustainability-reporting ;
    vc:slug "sustainable-development-goals" ;
    vc:sourceDomain "governance" .

ngm:system-software a owl:Class ;
    rdfs:label "System Software"@en ;
    rdfs:comment "Low-level software that directly manages hardware resources and provides foundational services upon which application software operates. In XR and spatial computing contexts, system software encompasses device drivers, operating system kernels, firmware, and hardware abstraction layers that expose display, tracking, and input peripherals to higher-level runtimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-abstraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:operating-system ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:rendering-pipeline,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hardware-abstraction,
        ngm:operating-system ;
    vc:isPartOf ngm:technology-stack ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "system-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:middleware .

ngm:tamper-detection a owl:Class ;
    rdfs:label "Tamper Detection"@en ;
    rdfs:comment "Tamper detection is the set of technical mechanisms and protocols that identify whether a digital asset, data record, physical device, or communication has been unauthorisedly modified since its creation or last verified state. In the digital domain it employs cryptographic hash functions, digital signatures, Merkle proofs, and content-addressed storage to generate verifiable commitments that reveal any change to the protected content. Applied to media authenticity, hardware integrity, and data provenance, tamper detection is a foundational component of trust architectures for critical systems, supply chains, digital forensics, and content authenticity verification."@en ;
    rdfs:subClassOf ngm:data-integrity ;
    vc:enables ngm:content-authentication,
        ngm:digital-forensics,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:audit-trail ;
    vc:slug "tamper-detection" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:cryptographic-signature,
        ngm:digital-signature .

ngm:technology-ecosystem a owl:Class ;
    rdfs:label "Technology Ecosystem"@en ;
    rdfs:comment "A Technology Ecosystem is the interconnected network of platforms, developer tools, standards bodies, runtime environments, and community participants that collectively sustain a technology domain. In the metaverse context it encompasses rendering engines, spatial-computing SDKs, open standards (OpenXR, USD, WebXR), cloud infrastructure, hardware manufacturers, and application developers whose interdependencies determine adoption trajectories and competitive dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technology-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:adoption-of-convergent-technologies,
        ngm:convergence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:open-standard,
        ngm:technology-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-domain,
        ngm:spatial-computing ;
    vc:slug "technology-ecosystem" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-system .

ngm:tele-001-telepresence a owl:Class ;
    rdfs:label "TELE 001 telepresence"@en ;
    rdfs:comment "TELE 001 Telepresence is a foundational concept within the telecollaboration domain that defines the sense of physical presence transmitted across a distance through audio-visual, haptic, and immersive communication technologies. It serves as the baseline specification for how distributed participants experience co-presence in collaborative environments, underpinning higher-order telecollaboration and virtual meeting systems."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:immersive-communication,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:telecollaboration ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "tele-001-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:audio-system,
        ngm:avatar .

ngm:tensor-processing-unit a owl:Class ;
    rdfs:label "Tensor Processing Unit"@en ;
    rdfs:comment "Tensor Processing Unit is a artificial intelligence concept and a type of Inference Hardware. that enables Large Language Models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:inference-hardware ;
    vc:enables ngm:large-language-models ;
