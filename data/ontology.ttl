        ngm:nft-marketplace .

ngm:virtual-clinic a owl:Class ;
    rdfs:label "Virtual Clinic"@en ;
    rdfs:comment "A telemedicine platform that enables clinicians to provide health services by connecting with patients through virtual means, offering remote consultations, diagnosis, treatment recommendations, and follow-up care using HIPAA-compliant video and digital communication technologies."@en ;
