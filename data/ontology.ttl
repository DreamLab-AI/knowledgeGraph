ngm:automated-market-maker a owl:Class ;
    rdfs:label "Automated Market Maker"@en ;
    rdfs:comment "Automated Market Maker (AMM) is a decentralized exchange protocol that uses algorithmic pricing mechanisms and liquidity pools instead of traditional order books, enabling permissionless token swaps where prices adjust automatically based on supply and demand within smart contract-managed reserves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:liquidity-provision,
        ngm:permissionless-trading,
        ngm:token-swaps ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:liquidity-pool,
        ngm:pricing-algorithms,
        ngm:smart-contracts ;
    vc:slug "automated-market-maker" ;
    vc:sourceDomain "spatial-computing" .

ngm:embedding-model a owl:Class ;
    rdfs:label "Embedding Model"@en ;
    rdfs:comment "An embedding model is a neural network trained to project discrete or high-dimensional inputs—such as tokens, sentences, images, or knowledge-graph nodes—into dense, fixed-dimensional vector representations in a continuous latent space that preserves semantic and structural relationships. The geometry of the resulting embedding space encodes similarity: semantically related inputs map to vectors with high cosine similarity, enabling downstream tasks such as semantic search, clustering, classification, and retrieval-augmented generation. Embedding models are trained using objectives such as contrastive learning, masked language modelling, or cross-modal alignment."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:dependsOn ngm:transformer ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph ;
    vc:slug "embedding-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:vector-database .

ngm:hardware-acceleration a owl:Class ;
    rdfs:label "Hardware Acceleration"@en ;
    rdfs:comment "The use of specialised hardware components, particularly GPUs and dedicated processors, to offload computationally intensive rendering, physics simulation, and AI workloads from the CPU, enabling real-time performance essential for immersive VR/AR metaverse experiences."@en ;
    rdfs:subClassOf ngm:computing-infrastructure,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:real-time-vr-performance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "hardware-acceleration" ;
    vc:sourceDomain "spatial-computing" .

ngm:interoperability-standard a owl:Class ;
    rdfs:label "Interoperability Standard"@en ;
    rdfs:comment "Formal specifications and protocols that enable different metaverse platforms, XR devices, and virtual environments to exchange data and operate toger seamlessly, including OpenXR, glTF, and emerging standards from the Metaverse Standards Forum."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:technical-standard ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:cross-platform-compatibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "interoperability-standard" ;
    vc:sourceDomain "infrastructure" .

ngm:reasoning a owl:Class ;
    rdfs:label "Reasoning"@en ;
    rdfs:comment "Reasoning in artificial intelligence encompasses the computational processes by which systems derive conclusions, formulate plans, solve problems, and generate explanations from knowledge, data, and prior context."@en ;
