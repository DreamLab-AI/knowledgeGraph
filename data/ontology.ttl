        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:low-latency-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:quality-of-service ;
    vc:implements ngm:network-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:network-performance-metrics ;
    vc:slug "latency-management-protocol" ;
    vc:sourceDomain "spatial-computing" .

ngm:liquidity-management a owl:Class ;
    rdfs:label "Liquidity Management"@en ;
    rdfs:comment "Liquidity management is the practice of ensuring that an institution holds sufficient liquid assets and funding to meet its financial obligations as they fall due, without incurring unacceptable losses. It involves forecasting cash flows, maintaining liquidity buffers, diversifying funding sources and managing the maturity profile of assets and liabilities. For central banks, liquidity management refers to steering aggregate reserves to keep short-term interest rates near the policy target."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:finance ;
    vc:contrastsWith ngm:risk-management ;
    vc:dependsOn ngm:central-bank,
        ngm:liquidity ;
    vc:enables ngm:monetary-policy-implementation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:treasury-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interest-rate,
        ngm:monetary-policy,
        ngm:risk-management ;
    vc:requires ngm:liquidity,
        ngm:risk-management ;
    vc:slug "liquidity-management" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:financial-stability,
        ngm:price-stability ;
    vc:uses ngm:open-market-operations .

ngm:lo-ra a owl:Class ;
    rdfs:label "Lo RA"@en ;
    rdfs:comment "A parameter-efficient fine-tuning mod that freezes pre-trained weights and injects trainable low-rank decomposition matrices into each layer of the transformer, dramatically reducing trainable parameters whilst maintaining performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:knowledge-distillation ;
    vc:enables ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:transformer-architecture ;
    vc:slug "lo-ra" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:loop-closure-detection a owl:Class ;
    rdfs:label "Loop Closure Detection"@en ;
    rdfs:comment "Loop closure detection is the process by which a SLAM or mapping system recognises that it has returned to a previously visited location. By identifying these revisits, it adds constraints that correct accumulated odometry drift and produce globally consistent maps. It is a critical component of robust simultaneous localisation and mapping, typically implemented via appearance-based place recognition or geometric matching."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:long-range-navigation,
        ngm:topological-map ;
    vc:slug "loop-closure-detection" ;
    vc:sourceDomain "robotics" .

ngm:lora a owl:Class ;
    rdfs:label "LoRa"@en ;
    rdfs:comment "LoRa is a long-range, low-power wireless modulation technology that uses chirp spread-spectrum signalling to transmit small amounts of data over distances of several kilometres on unlicensed sub-gigahertz radio bands. It trades data rate for range and energy efficiency, enabling battery-powered devices to operate for years. LoRa provides the physical layer beneath the LoRaWAN networking protocol used in wide-area sensor deployments. It is a foundational technology for low-power wide-area Internet-of-things connectivity."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:bridgesTo ngm:edge-computing ;
    vc:contrastsWith ngm:cellular-network,
        ngm:wi-fi ;
    vc:dependsOn ngm:unlicensed-spectrum ;
    vc:enables ngm:energy-efficiency,
        ngm:low-power-wide-area-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chirp-spread-spectrum ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:internet-of-things,
        ngm:sensor-networks ;
    vc:slug "lora" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:iot-device,
        ngm:lo-ra-wan ;
    vc:uses ngm:radio-frequency,
        ngm:spread-spectrum .

ngm:machine-vision a owl:Class ;
    rdfs:label "Machine Vision"@en ;
    rdfs:comment "Machine vision is the engineering discipline that applies digital imaging, optics, and automated image analysis to perform inspection, measurement, guidance, and identification tasks in industrial and manufacturing environments. It integrates hardware components — cameras, illumination, optics, and frame grabbers — with software pipelines that extract actionable decisions from image data, typically operating in real time under strict cycle-time constraints. Distinguished from the broader research field of computer vision by its emphasis on reliability, determinism, and seamless integration with programmable logic controllers and industrial automation systems. Modern machine vision systems increasingly incorporate deep learning inference alongside classical morphological and blob-analysis algorithms to handle appearance variability that rule-based methods alone cannot address."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pattern-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:deep-learning,
        ngm:digital-twin ;
    vc:contrastsWith ngm:computer-vision ;
    vc:enables ngm:defect-detection,
        ngm:object-detection,
        ngm:optical-character-recognition ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feature-extraction,
        ngm:image-preprocessing,
        ngm:pattern-recognition ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barcode-scanning ;
    vc:requires ngm:camera,
        ngm:optics,
        ngm:sensor ;
    vc:slug "machine-vision" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:industrial-automation,
        ngm:quality-control,
        ngm:robotics ;
    vc:uses ngm:convolutional-neural-network,
        ngm:edge-detection,
        ngm:image-segmentation .

ngm:market-surveillance a owl:Class ;
    rdfs:label "Market Surveillance"@en ;
    rdfs:comment "Market surveillance is the ongoing monitoring of trading venues and participant activity by exchanges and regulators to detect manipulation, abuse, and systemic risk. It ingests order, trade, and reference data in real time, applies alerting logic, and escalates suspected violations for enforcement. It underpins fair and orderly markets and is mandated by securities regulation."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-liability,
        ngm:securities-regulation ;
    vc:slug "market-surveillance" ;
    vc:sourceDomain "governance" .

ngm:materiality-assessment a owl:Class ;
    rdfs:label "Materiality Assessment"@en ;
    rdfs:comment "Materiality assessment is the structured process by which an organisation identifies and prioritises the environmental, social and governance topics that are significant enough to influence its decisions or the decisions of its stakeholders. It establishes which sustainability matters warrant disclosure, management attention and resource allocation. Double materiality extends the concept to consider both financial impact on the firm and the firm's impact on society and the environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        ngm:sustainability-reporting ;
    vc:bridgesTo ngm:climate-risk ;
    vc:enables ngm:disclosure,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:double-materiality,
        ngm:financial-materiality ;
    vc:isPartOf ngm:sustainability-reporting ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:carbon-accounting,
        ngm:esg ;
    vc:requires ngm:disclosure,
        ngm:stakeholder-engagement ;
    vc:slug "materiality-assessment" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:issb,
        ngm:tcfd ;
    vc:supports ngm:corporate-governance,
        ngm:risk-management ;
    vc:uses ngm:climate-scenario-analysis .

ngm:mechanical-component a owl:Class ;
    rdfs:label "Mechanical Component"@en ;
    rdfs:comment "MechanicalComponent is the ontological superclass for all physical structural, kinematic, and power-transmission elements constituting robotic hardware systems."@en ;
