    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:bayesian-inference .

ngm:packet-compression a owl:Class ;
    rdfs:label "Packet Compression"@en ;
    rdfs:comment "The application of lossless or lossy compression algorithms to network packets to reduce transmission bandwidth and latency in real-time data pipelines. In metaverse and spatial computing contexts, packet compression is critical for streaming 3D scene state, avatar motion data, and sensor telemetry with minimal perceptual degradation at constrained network bandwidths."@en ;
