        ngm:incentive-mechanism ;
    vc:contrastsWith ngm:merged-mining,
        ngm:proof-of-stake,
        ngm:solo-mining ;
    vc:dependsOn ngm:block-reward,
        ngm:hash-rate,
        ngm:transaction-fee ;
    vc:enables ngm:block-validation,
        ngm:distributed-ledger-technology,
        ngm:income-smoothing ;
    vc:hasMaturity ngmi:maturity-established ;
