ngm:qbft a owl:Class ;
    rdfs:label "QBFT"@en ;
    rdfs:comment "QBFT is a Byzantine fault tolerant consensus algorithm used in enterprise Ethereum clients to provide immediate finality among a known set of validators. It tolerates a minority of faulty or malicious validators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:byzantine-fault-tolerance ;
    vc:enables ngm:distributed-ledger-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm ;
    vc:slug "qbft" ;
    vc:sourceDomain "blockchain" .

