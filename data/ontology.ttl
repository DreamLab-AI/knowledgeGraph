ngm:cross-validation a owl:Class ;
    rdfs:label "Cross-Validation"@en ;
    rdfs:comment "Cross-validation is a statistical resampling technique for evaluating machine learning model performance by partitioning available data into complementary training and validation subsets, training the model on each partition in turn, and averaging the resulting error estimates. It provides a less optimistic and more generalisable estimate of out-of-sample predictive performance than a single train–test split."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:bridgesTo ngm:data-governance,
        ngm:statistical-inference ;
    vc:contrastsWith ngm:annotated-training-data,
        ngm:holdout-validation ;
    vc:dependsOn ngm:statistical-estimation,
        ngm:train-test-split ;
    vc:enables ngm:bias-variance-tradeoff,
        ngm:generalisation-error-estimation,
        ngm:hyperparameter-tuning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:k-fold-cross-validation,
        ngm:leave-one-out-cross-validation,
        ngm:stratified-sampling ;
    vc:isPartOf ngm:applied-machine-learning,
        ngm:model-selection ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:benign-overfitting,
        ngm:ensemble-learning,
        ngm:regularisation ;
    vc:requires ngm:labelled-dataset,
        ngm:resampling ;
    vc:slug "cross-validation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:applied-machine-learning,
        ngm:model-comparison,
        ngm:overfitting-prevention ;
    vc:uses ngm:convolutional-neural-network,
        ngm:performance-metric .

ngm:data-quality a owl:Class ;
    rdfs:label "Data Quality"@en ;
    rdfs:comment "Data Quality is the degree to which a dataset is fit for its intended purpose, evaluated across multiple dimensions including accuracy, completeness, consistency, timeliness, uniqueness, and validity. It encompasses the processes, standards, and metrics used to assess, monitor, cleanse, and continuously improve the reliability and trustworthiness of data assets. High data quality is a foundational prerequisite for sound analytics, machine learning model performance, regulatory compliance, and effective decision-making across all data-driven disciplines. Its absence propagates errors through downstream systems, undermining the value of even sophisticated analytical and AI pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lineage ],
        ngm:data-management ;
    vc:bridgesTo ngm:feature-engineering,
        ngm:machine-learning ;
    vc:contrastsWith ngm:dark-data,
        ngm:data-debt ;
    vc:dependsOn ngm:data-integration,
        ngm:etl ;
    vc:enables ngm:business-intelligence,
        ngm:master-data-management,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-cleansing,
        ngm:data-lineage,
        ngm:data-profiling,
        ngm:data-validation ;
    vc:isPartOf ngm:data-management ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-mesh,
        ngm:data-observability ;
    vc:requires ngm:data-cataloguing,
        ngm:data-governance,
        ngm:metadata-management ;
    vc:slug "data-quality" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:dama-dmbok,
        ngm:iso-8000 ;
    vc:supports ngm:data-warehouse,
        ngm:decision-support-systems ;
    vc:uses ngm:entity-resolution,
        ngm:statistical-process-control .

ngm:decentralized-finance a owl:Class ;
    rdfs:label "Decentralized Finance"@en ;
    rdfs:comment "Decentralized finance (DeFi) is an ecosystem of financial services built on public blockchains using smart contracts to provide lending, trading, derivatives and asset management without traditional intermediaries. Protocols are composable and permissionless, letting users transact directly from self-custodied wallets. DeFi introduces novel mechanisms such as automated market makers and liquidity pools, along with risks like impermanent loss and smart-contract exploits."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:impermanent-loss ;
    vc:slug "decentralized-finance" ;
    vc:sourceDomain "blockchain" .

ngm:defi-protocol a owl:Class ;
    rdfs:label "DeFi Protocol"@en ;
    rdfs:comment "A DeFi Protocol is a set of immutable or upgradeable smart contracts deployed on a public blockchain that implements a specific financial primitive—such as lending, decentralised exchange, derivatives, or yield aggregation—in a permissionless and non-custodial manner. Protocol logic encodes all rules governing asset custody, interest-rate models, fee distribution, and liquidation mechanics directly in on-chain code that executes deterministically without intermediaries. Most DeFi protocols expose a composable interface through standardised token standards so that outputs (liquidity tokens, receipt tokens, or yield-bearing positions) can be consumed as inputs by other protocols. Governance over protocol parameters is typically delegated to token holders via an on-chain voting system, making protocol evolution itself a decentralised process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:traditional-finance ;
    vc:dependsOn ngm:composability ;
    vc:enables ngm:flash-loan,
        ngm:liquidity-mining,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-token,
        ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:dao,
        ngm:impermanent-loss,
        ngm:mev,
        ngm:tokenomics ;
    vc:requires ngm:blockchain-oracle,
        ngm:erc-20,
        ngm:token-standard ;
    vc:slug "defi-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:price-oracle,
        ngm:stablecoin .

ngm:description-logic a owl:Class ;
    rdfs:label "Description Logic"@en ;
    rdfs:comment "A family of formal knowledge representation languages used to describe concepts, roles, and individuals with well-defined model-theoretic semantics, providing decidable fragments of first-order logic tailored to structured knowledge representation and automated reasoning."@en ;
