        ngm:gpu-compute,
        ngm:hardware-acceleration,
        ngm:npu ;
    vc:slug "tpu" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:model-training .

ngm:transaction-signing a skos:Concept ;
    rdfs:label "Transaction Signing"@en .

ngm:triple-store a owl:Class ;
    rdfs:label "Triple Store"@en ;
    rdfs:comment "A triple store is a database purpose-built to store and query RDF data as subject-predicate-object triples, forming the storage layer for semantic-web and knowledge-graph applications. It supports the SPARQL query language and often provides reasoning and inference over ontologies, enabling expressive graph traversal and entailment beyond what relational stores offer."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:knowledge-graphing ;
    vc:slug "triple-store" ;
    vc:sourceDomain "data" .

ngm:trust-establishment a owl:Class ;
    rdfs:label "Trust Establishment"@en ;
    rdfs:comment "Trust Establishment is the process by which parties in a digital or physical system form justified confidence in each other's identities, capabilities, intentions, and assertions prior to exchanging sensitive information or delegating authority. It encompasses cryptographic mechanisms such as certificate chain validation, attestation, and verifiable credential presentation, as well as organisational mechanisms including trust frameworks, legal agreements, and reputation systems. In decentralised and multi-stakeholder environments, trust establishment must operate without relying on a single trusted authority, requiring distributed protocols such as web-of-trust models, blockchain-anchored attestations, and federated identity systems. Trust establishment is a foundational prerequisite for secure communication, authorisation, and coordination across organisational and jurisdictional boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:trust-architecture ;
    vc:bridgesTo ngm:ai-governance,
        ngm:federated-identity ;
    vc:contrastsWith ngm:implicit-trust,
        ngm:perimeter-security ;
    vc:dependsOn ngm:certificate-authority,
        ngm:reputation-system ;
    vc:enables ngm:authentication,
        ngm:authorisation,
        ngm:secure-communication,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:web-of-trust,
        ngm:zero-trust-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attestation,
        ngm:certificate-transparency ;
    vc:requires ngm:cryptographic-verification,
        ngm:identity-verification,
        ngm:public-key-infrastructure ;
    vc:slug "trust-establishment" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:eidas-2,
        ngm:trust-framework ;
    vc:uses ngm:decentralised-identifier,
        ngm:digital-signature-verification,
        ngm:humanity-attestation,
        ngm:verifiable-credential .

ngm:type-system a skos:Concept ;
    rdfs:label "Type System"@en .

ngm:uk-online-safety-act a owl:Class ;
    rdfs:label "UK Online Safety Act"@en ;
    rdfs:comment "The UK Online Safety Act 2023 is landmark primary legislation that imposes statutory duties of care on providers of user-to-user services and search engines operating in or accessible from the United Kingdom, compelling them to assess and mitigate risks of illegal content and content harmful to children. It designates Ofcom as the UK's online safety regulator with powers to set binding codes of practice, conduct compliance audits, and impose fines of up to ten per cent of global annual turnover for non-compliance. The Act introduces mandatory age assurance obligations for services hosting pornographic or other age-restricted content, transparency reporting requirements, and a suite of user empowerment tools designed to give adults greater control over the content they encounter. A contested set of provisions concerning end-to-end encrypted messaging — deferring client-side scanning requirements until Ofcom deems them technically feasible — reflect the Act's tension between child protection goals and the integrity of secure communications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:age-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-accountability ],
        ngm:digital-regulation ;
    vc:bridgesTo ngm:client-side-scanning,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:digital-services-act,
        ngm:gdpr,
        ngm:us-section-230 ;
    vc:enables ngm:child-protection-online,
        ngm:trust-and-safety,
        ngm:user-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:age-verification,
        ngm:content-risk-assessment,
        ngm:transparency-reporting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:end-to-end-encryption,
        ngm:illegal-content-detection,
        ngm:platform-governance ;
    vc:requires ngm:content-moderation,
        ngm:platform-accountability,
        ngm:regulatory-compliance ;
    vc:slug "uk-online-safety-act" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ofcom,
        ngm:uk-parliament ;
    vc:supports ngm:data-protection,
        ngm:freedom-of-expression ;
    vc:uses ngm:content-moderation-standards,
        ngm:regulatory-reporting,
        ngm:risk-assessment-framework .

ngm:universal-design a owl:Class ;
    rdfs:label "Universal Design"@en ;
    rdfs:comment "Universal Design is the architectural, product, and communication design philosophy asserting that environments, systems, and products should be designed from the outset to be usable by all people — regardless of age, disability, or circumstance — to the greatest extent possible without the need for adaptation or specialised design. Codified by architect Ronald Mace at NC State University in the 1990s across seven principles (equitable use, flexibility, simple and intuitive use, perceptible information, tolerance for error, low physical effort, size and space for approach and use), Universal Design goes beyond legal accessibility compliance to treat inclusive design as a quality standard that benefits all users. It has been extended to digital products, extended reality experiences, and AI systems."@en ;
    rdfs:subClassOf ngm:design-thinking ;
    vc:bridgesTo ngm:artificial-intelligence-ethics,
        ngm:natural-language-interfaces,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:retrofitting,
        ngm:specialised-design ;
    vc:enables ngm:assistive-technology,
        ngm:digital-equity,
        ngm:inclusive-participation,
        ngm:inclusive-xr-experience,
        ngm:xr-accessibility-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:multimodal-interaction,
        ngm:pour-framework ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:accessibility-standards,
        ngm:ergonomics,
        ngm:human-centred-design,
        ngm:inclusive-design,
        ngm:user-experience ;
    vc:slug "universal-design" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:eu-accessibility-act,
        ngm:un-convention-on-rights-of-persons-with-disabilities,
        ngm:web-content-accessibility-guidelines,
        ngm:xr-accessibility-user-requirements ;
    vc:supports ngm:built-environment,
        ngm:human-factors,
        ngm:product-design,
        ngm:user-interface-design .

ngm:uri-canonicaliser a owl:Class ;
    rdfs:label "URI Canonicaliser"@en ;
    rdfs:comment "The canonical URI minting and resolution engine implementing the VisionClaw Agentic Container|VisionClaw urn:visionclaw: grammar (ADR-013, R1–R3 rules) for stable, content-addressed, and scope-bearing identifiers, enabling deterministic roundtrip serialisation and cryptographic verification o..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressing ],
        ngm:identity-systems,
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:content-addressing,
        ngm:decentralised-resolution,
        ngm:deterministic-serialisation,
        ngm:tamper-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-addressing,
        ngm:hash-computation,
        ngm:scope-bearer,
        ngm:slug-derivation ;
    vc:implements ngm:ietf-content-addressable-architecture,
        ngm:rfc-8141-urn-syntax,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:requires ngm:bip-340-pubkey,
        ngm:json-data-interchange-format-stringification,
        ngm:sha-256-hash-function,
        ngm:uri-rfc-8141 ;
    vc:slug "uri-canonicaliser" ;
    vc:sourceDomain "infrastructure" .

ngm:user-authentication a owl:Class ;
    rdfs:label "User Authentication"@en ;
    rdfs:comment "User authentication is the process of verifying that a person claiming a digital identity is who they assert to be, by validating one or more authentication factors: something they know (password, PIN), something they have (hardware token, mobile device), or something they are (biometric). It is the gateway control between unauthenticated network access and authorised use of a system or resource, and its assurance level — defined by standards such as NIST SP 800-63 — must be calibrated to the sensitivity of protected resources. Modern implementations favour phishing-resistant factors (passkeys, hardware security keys) over knowledge-based authentication."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:identity-and-access-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:passwordless-authentication ;
    vc:slug "user-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:fido2,
        ngm:oauth-2-0,
        ngm:web-authn .

ngm:vector-search a owl:Class ;
    rdfs:label "Vector Search"@en ;
    rdfs:comment "Vector search is a retrieval paradigm that identifies the items in a corpus whose high-dimensional vector representations are most similar to a query vector, using distance or similarity metrics such as cosine similarity, dot product, or Euclidean distance. Because exhaustive pairwise comparison scales as O(n·d) and becomes intractable for large corpora, practical systems use approximate nearest neighbour (ANN) algorithms — including HNSW, IVF-PQ, and LSH — that trade a small, configurable recall loss for orders-of-magnitude latency improvement. Vectors are typically produced by embedding models that encode semantic, visual, or multimodal meaning into dense float arrays, making vector search inherently meaning-sensitive rather than lexical. The paradigm underpins semantic search, recommendation systems, retrieval-augmented generation, duplicate detection, and cross-modal retrieval across text, image, audio, and structured data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:spatial-indexing ;
    vc:contrastsWith ngm:exact-nearest-neighbour,
        ngm:keyword-search ;
    vc:dependsOn ngm:approximate-nearest-neighbour,
        ngm:vector-index ;
    vc:enables ngm:cross-modal-retrieval,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hnsw,
        ngm:inverted-file-index,
        ngm:product-quantisation ;
    vc:isPartOf ngm:vector-database ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dense-retrieval,
        ngm:hybrid-search,
        ngm:large-language-model ;
    vc:requires ngm:embedding-model,
        ngm:embeddings,
        ngm:similarity-metric ;
    vc:slug "vector-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cosine-similarity,
        ngm:dot-product,
        ngm:locality-sensitive-hashing .

ngm:vesting-schedule a owl:Class ;
    rdfs:label "Vesting Schedule"@en ;
    rdfs:comment "A vesting schedule is a contractually or programmatically enforced timetable that releases allocated digital assets or equity to recipients incrementally over a defined period, typically beginning after an initial cliff during which no release occurs. In blockchain and token-based systems, schedules are commonly encoded in smart contracts that autonomously unlock portions of a token allocation at fixed intervals or milestones, aligning the long-term incentives of founders, contributors, and investors with project health. The schedule's parameters — cliff length, total duration, release cadence, and revocation conditions — are a principal instrument of tokenomics design and governance risk management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:defi-protocol,
        ngm:equity-vesting ;
    vc:contrastsWith ngm:airdrop,
        ngm:immediate-token-release ;
    vc:dependsOn ngm:blockchain,
        ngm:time-lock ;
    vc:enables ngm:incentive-alignment,
        ngm:supply-schedule ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cliff-period,
        ngm:release-interval,
        ngm:revocation-clause ;
    vc:implements ngm:token ;
    vc:isPartOf ngm:tokenomics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:initial-coin-offering,
        ngm:staking,
        ngm:tokenomics-governance,
        ngm:treasury-management ;
    vc:requires ngm:smart-contract,
        ngm:token-allocation ;
    vc:slug "vesting-schedule" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:dao,
        ngm:governance-token ;
    vc:uses ngm:escrow,
        ngm:multisig-wallet .

ngm:video-encoding a owl:Class ;
    rdfs:label "Video Encoding"@en ;
    rdfs:comment "Video encoding is the process of compressing raw or lightly-compressed video frames into a deliverable bitstream using a video codec, encompassing decisions about encoding parameters (resolution, frame rate, bitrate mode, keyframe interval, codec profile and level), rate control algorithms, and hardware or software encoder selection to balance output quality, file size, and encoding speed for a given delivery target."@en ;
    rdfs:subClassOf ngm:video-codec ;
    vc:dependsOn ngm:compute-resources ;
    vc:enables ngm:bandwidth-adaptation,
        ngm:bandwidth-optimization,
        ngm:cdn ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:decoder ;
    vc:slug "video-encoding" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:computer-vision-video-analysis,
        ngm:encoder .

ngm:virtual-presence a owl:Class ;
    rdfs:label "Virtual Presence"@en ;
    rdfs:comment "The psychological experience of being there within a virtual place or situation, encompassing spatial presence (sense of location), social presence (connection with others), and self-presence (embodiment in virtual form), achieved through telepresence technologies and immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:telepresence ;
    vc:enables ngm:immersive-experience,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:extended-reality ;
    vc:requires ngm:avatar,
        ngm:virtual-reality ;
    vc:slug "virtual-presence" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptic-feedback,
        ngm:spatial-audio .

ngm:virtual-society a owl:Class ;
    rdfs:label "Virtual Society"@en ;
    rdfs:comment "An organised social structure emerging within virtual worlds and metaverse platforms, comprising the norms, governance mechanisms, economic systems, communities, and social interactions of persistent digital environments. Virtual societies exhibit properties analogous to physical societies — ownership, law, culture, and commerce — mediated through digital platforms, avatars, and blockchain-based economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
