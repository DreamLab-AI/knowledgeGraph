        ngm:self-sovereign-identity ;
    vc:uses ngm:cbor,
        ngm:json-ld,
        ngm:linked-data .

ngm:credential-issuance a owl:Class ;
    rdfs:label "Credential Issuance"@en ;
    rdfs:comment "Credential issuance is the process by which an authoritative entity — an issuer — creates, signs, and delivers a structured attestation about a subject's attributes, qualifications, or identity to that subject or to a designated holder. In the W3C Verifiable Credentials model, issuance involves binding claims to a subject's decentralised identifier using the issuer's cryptographic key, producing a tamper-evident credential that the holder can present to verifiers without returning to the issuer. The issuance process encompasses schema selection, claim population, signature generation, and delivery, and may be implemented with varying degrees of issuer privacy, holder binding strength, and revocability."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:enables ngm:credential-verification,
        ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:digital-identity ;
    vc:slug "credential-issuance" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:credential-schema,
        ngm:cryptographic-signature,
        ngm:decentralized-identifiers,
        ngm:verifiable-credentials .

ngm:cross-border-settlement a owl:Class ;
    rdfs:label "Cross-Border Settlement"@en ;
    rdfs:comment "Cross-border settlement is the process of finalising the transfer of funds or assets between counterparties in different jurisdictions, including currency conversion, compliance checks, and the irrevocable discharge of obligations across correspondent banking chains, central bank systems, or emerging blockchain-based rails. It encompasses the full lifecycle from trade initiation to finality across multiple legal, regulatory, and technical environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sanctions-screening ],
        ngm:cross-border-payments ;
    vc:bridgesTo ngm:cbdc-cross-border-settlement,
        ngm:stablecoin-payments ;
    vc:contrastsWith ngm:domestic-settlement ;
    vc:dependsOn ngm:atomic-settlement,
        ngm:nostro-vostro-accounts,
        ngm:swift-messaging ;
    vc:enables ngm:cross-border-payment-transparency,
        ngm:financial-inclusion,
        ngm:international-trade-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fx-settlement,
        ngm:payment-finality,
        ngm:sanctions-screening ;
    vc:implements ngm:iso-20022,
        ngm:payment-versus-payment ;
    vc:isPartOf ngm:international-payments-system ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:correspondent-banking,
        ngm:delivery-versus-payment ;
    vc:requires ngm:aml-compliance,
        ngm:currency-conversion,
        ngm:liquidity-management ;
    vc:slug "cross-border-settlement" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:fsb-cross-border-payments-roadmap,
        ngm:g20-cross-border-payments ;
    vc:uses ngm:cls-bank,
        ngm:real-time-gross-settlement .

ngm:cross-chain-governance a owl:Class ;
    rdfs:label "Cross-Chain Governance"@en ;
    rdfs:comment "Cross-Chain Governance is a coordination framework and set of protocols that enable governance proposals, voting outcomes, and policy updates to propagate and be enforced across multiple heterogeneous blockchain networks without requiring a single trusted intermediary. It extends on-chain governance mechanisms — token-weighted voting, quadratic voting, time-locked execution — to multi-chain environments using interoperability layers such as IBC (Inter-Blockchain Communication), cross-chain message-passing bridges, or relay networks. Achieving consistent governance state across chains requires solving distributed consensus problems while preserving each chain's sovereignty. The field sits at the intersection of blockchain interoperability, distributed systems coordination, and decentralised decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-chain-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:multi-stakeholder-governance ;
    vc:contrastsWith ngm:centralised-governance,
        ngm:off-chain-governance,
        ngm:on-chain-governance ;
    vc:dependsOn ngm:cross-chain-bridge,
        ngm:fraud-proof,
        ngm:relay-network ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:protocol-upgrade,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cosmos-ibc,
        ngm:optimistic-rollup,
        ngm:polkadot-parachain,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:blockchain-interoperability,
        ngm:cross-chain-messaging,
        ngm:distributed-consensus,
        ngm:smart-contract ;
    vc:slug "cross-chain-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:governance-token,
        ngm:on-chain-voting,
        ngm:time-lock .

ngm:cryptographic-algorithm a owl:Class ;
    rdfs:label "Cryptographic Algorithm"@en ;
    rdfs:comment "A Cryptographic Algorithm is a precisely defined mathematical procedure that transforms data to achieve security properties—confidentiality, integrity, authentication, or non-repudiation—based on computational hardness assumptions. The class encompasses symmetric ciphers, asymmetric (public-key) schemes, hash functions, digital signature algorithms, and zero-knowledge proof systems, each providing different security guarantees and performance characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
