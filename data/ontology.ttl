# LangChain
artificial-intelligence:LangChain rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:AgentOrchestrationFramework ;
    rdfs:subClassOf artificial-intelligence:LLMApplicationFramework ;
    rdfs:label "LangChain"@en ;
    rdfs:comment "LangChain is an open-source Python and TypeScript framework for composing Large Language Model applications as chains of modular components — prompt templates, LLM wrappers, output parsers, memory stores, retrieval augmented generation pipelines, and tool-calling agents — providing a unified interface across LLM providers (OpenAI, Anthropic, Cohere, local Ollama) and complementary services (vector databases, document loaders, external APIs) that accelerates the development of conversational AI systems, RAG pipelines, and agentic workflows, integrating natively with the Model Context Protocol tool surface used by VisionClaw Agentic Container agent skills."@en ;
    skos:prefLabel "LangChain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:langchain" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:langchain> ;
    vcw:contentHash "sha256-12-3b7f1d5e9c2a" ;
    vcw:qualityScore "0.6"^^xsd:decimal ;
    vcw:legacyTermId "AI-langchain" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.75"^^xsd:decimal ;
    dcterms:identifier "AI-langchain" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

