ngm:nakamoto-consensus a owl:Class ;
    rdfs:label "Nakamoto Consensus"@en ;
    rdfs:comment "The proof-of-work based consensus mechanism introduced in the Bitcoin whitepaper, where nodes expend computational effort to extend the longest valid chain. It achieves probabilistic Byzantine fault tolerance in open, permissionless networks through the longest-chain rule and difficulty-adjusted mining, enabling trustless agreement without a central coordinator."@en ;
