        ngm:robo-navigation-and-planning ;
    vc:enables ngm:active-perception,
        ngm:belief-space-planning,
        ngm:robot-localisation,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping,
        ngm:target-tracking,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:belief-state,
        ngm:measurement-update-step,
        ngm:motion-model,
        ngm:normalisation-constant,
        ngm:observation-model,
        ngm:posterior-distribution,
        ngm:prediction-step,
        ngm:prior-distribution ;
    vc:implements ngm:bayes-rule,
        ngm:chapman-kolmogorov-equation,
        ngm:recursive-state-estimation,
        ngm:sequential-bayesian-updating ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:expectation-maximisation,
        ngm:factor-graph,
        ngm:pomdp,
        ngm:smoothing-and-mapping,
        ngm:variational-inference ;
    vc:requires ngm:control-inputs,
        ngm:initial-belief,
        ngm:markov-assumption,
        ngm:probabilistic-motion-model,
        ngm:probabilistic-observation-model,
