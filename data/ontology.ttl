        ngm:resource-availability-data ;
    vc:slug "edge-orchestration" ;
    vc:sourceDomain "spatial-computing" .

ngm:embedding-search a owl:Class ;
    rdfs:label "Embedding Search"@en ;
    rdfs:comment "Embedding search is a retrieval paradigm in which queries and documents are encoded into dense vector representations in a shared semantic space, and similarity—typically measured by cosine distance or dot product—is used to rank and retrieve the most relevant items. Unlike keyword-based search, embedding search captures semantic relatedness, enabling matches on meaning rather than exact lexical overlap."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-search ],
        ngm:semantic-search ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dense-retrieval ;
    vc:requires ngm:vector-search ;
    vc:slug "embedding-search" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:vector-embedding,
