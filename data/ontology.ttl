    rdfs:label "Perpetual Revenue"@en .
ngm:perplexity-ai-search-platform a owl:Class ;
    rdfs:comment "Perplexity AI is a conversational search platform that combines large language models with live web retrieval to produce cited, synthesised answers to natural-language queries. Offered through consumer applications and an API, it applies retrieval-augmented generation to web-scale content, sitting between traditional search engines and generative AI assistants."@en ;
    rdfs:label "Perplexity AI Search Platform"@en ;
