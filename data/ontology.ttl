ngm:eu-ai-act a owl:Class ;
    rdfs:comment "The European Union's Artificial Intelligence Act (Regulation (EU) 2024/1689), the world's first comprehensive horizontal legal framework for artificial intelligence, which classifies AI systems into risk tiers — unacceptable, high, limited and minimal — and imposes proportionate obligations on providers and deployers, including conformity assessment, data governance, transparency, human oversight, robustness and post-market monitoring, with extraterritorial reach over any system placed on the EU market and penalties of up to 7% of global annual turnover."@en ;
    rdfs:label "EU AI Act"@en ;
    rdfs:subClassOf ngm:regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:risk-based-regulation ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias ;
    vc:relatedTo ngm:compliance-audit-trail ;
    vc:slug "eu-ai-act" ;
    vc:sourceDomain "governance" .
