ngm:extended-kalman-filter a owl:Class ;
    rdfs:label "Extended Kalman Filter"@en ;
    rdfs:comment "The Extended Kalman Filter is a recursive state estimator that applies the Kalman filter to non-linear systems by linearising the process and measurement models about the current estimate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bayesian-inference ],
        ngm:kalman-filter ;
    vc:enables ngm:localization,
