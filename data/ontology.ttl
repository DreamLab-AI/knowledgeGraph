    vc:relatedTo ngm:attack-surface-management,
        ngm:security-orchestration ;
    vc:requires ngm:asset-inventory,
        ngm:threat-intelligence,
        ngm:vulnerability ;
    vc:slug "vulnerability-management" ;
    vc:sourceDomain "security" ;
