ngm:cross-border-remittances a owl:Class ;
    rdfs:comment "Cross-border remittances are transfers of money by individuals—typically migrant workers—to recipients in another country, often family members. Traditionally routed through banks and money-transfer operators with high fees and slow settlement, they are increasingly served by stablecoins and crypto rails that lower cost and latency. They represent a major global financial flow and a key driver of crypto payment adoption."@en ;
    rdfs:label "Cross-Border Remittances"@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stable-coins ;
    vc:slug "cross-border-remittances" ;
    vc:sourceDomain "blockchain" .
ngm:cross-border-settlement a owl:Class ;
    rdfs:comment "Cross-border settlement is the process of finalising the transfer of funds or assets between counterparties in different jurisdictions, including currency conversion, compliance checks, and the irrevocable discharge of obligations across correspondent banking chains, central bank systems, or emerging blockchain-based rails. It encompasses the full lifecycle from trade initiation to finality across multiple legal, regulatory, and technical environments."@en ;
    rdfs:label "Cross-Border Settlement"@en ;
    rdfs:subClassOf ngm:cross-border-payments ;
    rdfs:subClassOf _:r6050 ;
    rdfs:subClassOf _:r6051 ;
    rdfs:subClassOf _:r6052 ;
