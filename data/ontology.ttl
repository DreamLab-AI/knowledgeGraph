ngm:quasi-direct-drive a owl:Class ;
    rdfs:label "Quasi-Direct Drive"@en ;
    rdfs:comment "Quasi-direct drive (QDD) is an actuation architecture that pairs a high-torque electric motor with a low-ratio gearbox to achieve high force fidelity, backdrivability, and impact tolerance while retaining usable torque density. By minimising gear reduction it preserves transparency between the motor and the load, enabling accurate force sensing and control without dedicated torque sensors. It is a dominant approach in legged and dynamic robots."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "quasi-direct-drive" ;
    vc:sourceDomain "robotics" .

ngm:ragdoll-physics a owl:Class ;
    rdfs:label "Ragdoll Physics"@en ;
    rdfs:comment "Ragdoll physics is a procedural animation technique that simulates the limp, physically reactive motion of an articulated character body using a system of rigid bodies connected by constrained joints. Instead of playing pre-authored animation, the character's limbs respond dynamically to gravity, collisions and impulses via a physics engine. It is widely used in games and interactive media to produce believable falls, impacts and death animations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        ngm:physics-based-animation ;
    vc:bridgesTo ngm:inverse-kinematics ;
    vc:contrastsWith ngm:motion-capture,
        ngm:skeletal-animation ;
    vc:dependsOn ngm:physics-simulation ;
    vc:enables ngm:character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:procedural-animation ;
    vc:isPartOf ngm:physics-based-animation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inverse-kinematics,
        ngm:procedural-animation,
        ngm:skeletal-animation ;
    vc:requires ngm:rigid-body-dynamics ;
    vc:slug "ragdoll-physics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:game-engine ;
    vc:uses ngm:collision-detection,
        ngm:rigid-body-dynamics .

ngm:raid a owl:Class ;
    rdfs:label "Raid"@en ;
    rdfs:comment "RAID (Redundant Array of Independent Disks) is a data storage virtualisation technology that combines multiple physical drives into one or more logical units to improve performance, capacity, or fault tolerance. Different RAID levels trade off redundancy, write performance and usable capacity using techniques such as striping, mirroring and parity. It protects against individual drive failure but is complementary to, not a substitute for, backups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:data-storage ;
    vc:contrastsWith ngm:distributed-storage,
        ngm:erasure-coding ;
    vc:enables ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-storage ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:block-storage,
        ngm:erasure-coding,
        ngm:fault-tolerance,
        ngm:redundancy ;
    vc:requires ngm:data-storage ;
    vc:slug "raid" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-integrity,
        ngm:fault-tolerance,
        ngm:high-availability ;
    vc:uses ngm:block-storage,
        ngm:redundancy .

