ngm:energy-consumption a owl:Class ;
    rdfs:label "Energy Consumption"@en ;
    rdfs:comment "Energy consumption is the total quantity of energy drawn by a system, process, or device over a defined time period, typically expressed in kilowatt-hours (kWh) or joules. In computing and digital infrastructure contexts it encompasses the electrical power used by processors, memory, networking equipment, and cooling systems. It is a foundational metric in evaluating the environmental footprint, operational cost, and sustainability compliance of data centres, blockchain networks, AI training pipelines, and distributed systems. Minimising energy consumption without sacrificing throughput or reliability is a core design constraint across hardware architecture, consensus mechanisms, and large-scale deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cooling-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-usage-effectiveness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-infrastructure ],
        ngm:sustainability ;
    vc:bridgesTo ngm:distributed-ledger-technology,
        ngm:edge-computing,
        ngm:model-training ;
    vc:contrastsWith ngm:energy-efficiency,
        ngm:proof-of-work ;
    vc:dependsOn ngm:hardware-architecture,
        ngm:workload-scheduling ;
    vc:enables ngm:carbon-accounting,
        ngm:green-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:power-usage-effectiveness,
