ngm:blockchain-consensus a owl:Class ;
    rdfs:label "Blockchain Consensus"@en ;
    rdfs:comment "Blockchain Consensus refers to the family of distributed agreement protocols by which independent, potentially adversarial nodes in a blockchain network reach agreement on a single canonical version of the transaction ledger, including the ordering, validity, and finality of all blocks. These protocols must tolerate Byzantine faults — nodes that may behave maliciously or arbitrarily — and operate across open, permissionless networks without a trusted coordinator. The choice of consensus mechanism fundamentally shapes a blockchain's security model, throughput, energy consumption, and degree of decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:practical-byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tendermint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nakamoto-consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:decentralised-governance,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:centralised-database,
        ngm:paxos,
        ngm:raft-consensus ;
    vc:dependsOn ngm:byzantine-fault-tolerance,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree ;
    vc:enables ngm:double-spend-prevention,
        ngm:finality,
        ngm:permissionless-participation,
        ngm:sybil-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delegated-proof-of-stake,
        ngm:nakamoto-consensus,
        ngm:practical-byzantine-fault-tolerance,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:tendermint ;
    vc:isPartOf ngm:blockchain-protocol,
        ngm:distributed-ledger-technology ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:block-production,
        ngm:blockchain-ledger,
        ngm:fork-choice-rule,
        ngm:slashing ;
