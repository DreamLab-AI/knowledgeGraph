        ngm:kubernetes ;
    vc:slug "cloud-native-applications" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation,
        ngm:open-container-initiative ;
    vc:uses ngm:cloud-infrastructure,
        ngm:devops,
        ngm:edge-cloud-collaboration,
        ngm:platform-engineering .

ngm:commitment-scheme a owl:Class ;
    rdfs:label "Commitment Scheme"@en ;
    rdfs:comment "A commitment scheme is a two-phase cryptographic primitive that allows a party (the committer) to bind itself to a chosen value by producing a short commitment string — analogous to sealing a value in an envelope — that is later opened by revealing the original value and a randomness parameter, with the scheme satisfying two security properties: binding (the committer cannot change the value after committing) and hiding (the commitment reveals nothing about the value before opening). Commitment schemes are foundational building blocks for zero-knowledge proofs, secure multi-party computation, and blockchain protocols."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:blockchain-data-availability,
        ngm:smart-contract ;
    vc:contrastsWith ngm:digital-signature,
        ngm:encryption-scheme ;
    vc:enables ngm:blockchain-anchoring,
        ngm:coin-flipping-protocol,
        ngm:secure-multi-party-computation,
        ngm:verifiable-random-function,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:kzg-polynomial-commitment,
        ngm:pedersen-commitment,
        ngm:vector-commitment ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:information-theoretic-security,
        ngm:merkle-proof,
        ngm:post-quantum-cryptography,
        ngm:zero-knowledge ;
    vc:requires ngm:cryptographic-assumption,
        ngm:randomness ;
    vc:slug "commitment-scheme" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:commit-reveal-pattern,
        ngm:threshold-signature,
        ngm:zksnark,
        ngm:zkstark ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:merkle-tree .

ngm:correspondent-banking a owl:Class ;
    rdfs:label "Correspondent Banking"@en ;
    rdfs:comment "Correspondent banking is an arrangement in which one bank (the correspondent) holds accounts and provides payment, settlement, trade finance, and liquidity services on behalf of another bank (the respondent) that lacks a direct presence or licence in a given jurisdiction or currency. The respondent bank maintains a nostro account at the correspondent and an equivalent vostro account on its own books, enabling cross-border value transfer without requiring every institution to maintain a full global branch network. This intermediated model underpins a substantial share of international wire transfers and documentary trade, but introduces multi-hop settlement chains, foreign-exchange conversion costs, and heightened anti-money-laundering compliance obligations, motivating ongoing efforts to reform or replace the model through ISO 20022, CBDC corridors, and distributed ledger payment rails."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-ledger-technology ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:payment-hub ;
    vc:enables ngm:cross-border-payments,
        ngm:documentary-credit,
        ngm:foreign-exchange,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:loro-account,
        ngm:nostro-account,
        ngm:vostro-account ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:de-risking,
        ngm:financial-inclusion,
        ngm:payment-messaging ;
    vc:requires ngm:anti-money-laundering,
        ngm:know-your-customer,
        ngm:liquidity-management ;
    vc:slug "correspondent-banking" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:financial-action-task-force ;
    vc:uses ngm:iso-20022,
        ngm:real-time-gross-settlement,
        ngm:swift .

ngm:cross-chain-messaging a owl:Class ;
    rdfs:label "Cross-Chain Messaging"@en ;
    rdfs:comment "Protocols and mechanisms that enable communication and data transfer between different blockchain networks, facilitating interoperability and cross-chain applications without centralised intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
