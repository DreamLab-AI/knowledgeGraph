        ngm:code-signing,
        ngm:identity-verification,
        ngm:non-repudiation,
        ngm:supply-chain,
        ngm:transaction-authorisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-signing,
        ngm:hash-function,
        ngm:key-generation-algorithm,
        ngm:nonce,
        ngm:private-key,
