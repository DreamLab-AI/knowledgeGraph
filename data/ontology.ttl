ngm:climate-change a owl:Class ;
    rdfs:label "Climate Change"@en ;
    rdfs:comment "Climate change refers to long-term shifts in temperatures and weather patterns, driven predominantly since the industrial era by human emissions of greenhouse gases that trap heat in the atmosphere. Its impacts include rising sea levels, more frequent extreme weather, ecosystem disruption and threats to food, water and economic systems. Responses span mitigation (reducing emissions) and adaptation (managing unavoidable impacts), coordinated through policy frameworks such as the Paris Agreement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:climate-action ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decarbonisation ],
        ngm:sustainability ;
    vc:bridgesTo ngm:carbon-offsetting,
        ngm:net-zero ;
    vc:dependsOn ngm:greenhouse-gas-emissions ;
    vc:enables ngm:climate-risk ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:sustainability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:climate-risk,
        ngm:environmental-sustainability,
        ngm:esg ;
    vc:requires ngm:climate-action,
        ngm:decarbonisation ;
    vc:slug "climate-change" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:paris-agreement ;
    vc:supports ngm:renewable-energy .

ngm:cnc-machining a owl:Class ;
    rdfs:label "CNC Machining"@en ;
    rdfs:comment "CNC (computer numerical control) machining is a subtractive manufacturing process in which programmed instructions drive automated cutting tools to remove material from a workpiece and produce precise parts. Toolpaths derived from a digital model control multi-axis motion of mills, lathes and routers to achieve tight tolerances and repeatable results. It is a cornerstone of precision manufacturing across metals, plastics and composites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-control ],
        ngm:precision-manufacturing ;
    vc:contrastsWith ngm:additive-manufacturing ;
    vc:dependsOn ngm:automation ;
    vc:enables ngm:digital-fabrication,
        ngm:manufacturing-automation,
        ngm:prototyping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:motion-control ;
    vc:isPartOf ngm:precision-manufacturing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:slug "cnc-machining" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:industrial-robotics,
        ngm:robotics ;
    vc:uses ngm:actuator,
        ngm:cad-software,
        ngm:computer-aided-design .

ngm:collaborative-systems-modality-filtering a owl:Class ;
    rdfs:label "Collaborative Filtering"@en ;
    rdfs:comment "Collaborative filtering is a machine learning technique for building recommendation systems that generates predictions about user preferences by aggregating the behaviour or ratings of many users, without requiring explicit knowledge of item content. Memory-based approaches compute similarity between users (user-based) or items (item-based) using rating vectors; model-based approaches such as matrix factorisation decompose the user-item interaction matrix into latent factor spaces. The method operates on the assumption that users who agreed in the past will agree in the future, and is the foundational algorithm behind recommendation engines at Netflix, Spotify, and Amazon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:matrix-factorisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        ngm:machine-learning-discipline-technique ;
    vc:contrastsWith ngm:content-based-filtering,
        ngm:search-engine ;
    vc:enables ngm:hyper-personalisation,
        ngm:recommendation-engine,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:latent-factor-model,
        ngm:matrix-factorisation,
        ngm:neighbourhood-method,
        ngm:user-item-interaction-matrix ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:filter-bubble,
        ngm:knowledge-graph,
        ngm:privacy-preserving-data-mining,
        ngm:recommendation-systems ;
    vc:requires ngm:embeddings,
        ngm:sparse-data,
        ngm:user-behaviour-data ;
    vc:slug "collaborative-filtering" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:approximate-nearest-neighbour-search,
        ngm:gradient-descent,
        ngm:machine-learning-discipline .

ngm:collective-intelligence-system a owl:Class ;
    rdfs:label "Collective Intelligence System"@en ;
    rdfs:comment "Mechanism enabling groups of humans and agents to solve problems collaboratively using shared data through swarm intelligence and emergent decision-making."@en ;
