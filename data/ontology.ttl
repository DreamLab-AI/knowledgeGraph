    vc:uses ngm:finite-element-analysis,
        ngm:laplace-transform .

ngm:digital-product-passport a owl:Class ;
    rdfs:label "Digital Product Passport"@en ;
    rdfs:comment "A Digital Product Passport (DPP) is a standardised, machine-readable digital record that captures and communicates authoritative information about a product's material composition, manufacturing origin, environmental footprint, repair history, and end-of-life options throughout its full lifecycle. Mandated across product categories by the EU Ecodesign for Sustainable Products Regulation (ESPR) and related instruments such as the EU Battery Regulation, DPPs are accessible to consumers, regulators, recyclers, and supply chain actors via data carriers such as QR codes, NFC tags, or RFID. They serve as a foundational infrastructure of circular economy policy by enabling traceability, transparency, and interoperability across complex global supply chains. DPPs are frequently implemented atop distributed ledger or verifiable credential technologies to ensure provenance integrity and tamper-evident audit trails."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-interoperability ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-ledger-technology,
        ngm:semantic-web-linked-data-standard ;
    vc:dependsOn ngm:data-governance,
        ngm:iot-sensor,
        ngm:supply-chain ;
    vc:enables ngm:circular-economy,
        ngm:esg-reporting,
        ngm:extended-producer-responsibility,
        ngm:right-to-repair,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint,
        ngm:digital-twin,
        ngm:eu-battery-regulation,
        ngm:life-cycle-assessment ;
    vc:requires ngm:data-interoperability,
        ngm:open-standard ;
    vc:slug "digital-product-passport" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:eu-espr,
        ngm:gs-1-standards,
        ngm:iso-iec ;
    vc:uses ngm:decentralised-identifier,
        ngm:provenance-tracking,
        ngm:qr-code,
        ngm:rfid,
        ngm:verifiable-credentials .

ngm:digital-signatures a owl:Class ;
    rdfs:label "Digital Signatures"@en ;
    rdfs:comment "A cryptographic mechanism that uses asymmetric key pairs to produce a verifiable seal on digital data, ensuring authenticity, integrity, and non-repudiation of messages, transactions, and documents across distributed and decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asymmetric-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signature-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:post-quantum-cryptography ;
    vc:contrastsWith ngm:message-authentication-code,
        ngm:symmetric-cryptography ;
    vc:enables ngm:authentication,
        ngm:code-signing,
        ngm:data-integrity,
        ngm:non-repudiation,
        ngm:transaction-authorisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hash-function,
        ngm:private-key,
        ngm:public-key,
        ngm:signature-algorithm ;
    vc:implements ngm:bls-signature,
        ngm:ecdsa,
        ngm:ed-dsa,
        ngm:schnorr-signature ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:asymmetric-cryptography,
        ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:slug "digital-signatures" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-cryptographic-standards,
        ngm:nist-fips-186 ;
    vc:supports ngm:decentralised-identity,
        ngm:smart-contracts,
        ngm:zero-knowledge-proof .

ngm:educational-technology a owl:Class ;
    rdfs:label "Educational Technology"@en ;
    rdfs:comment "Educational Technology (EdTech) is the systematic application of digital tools, platforms, pedagogical frameworks, and immersive media to the design, delivery, and assessment of learning experiences. In spatial-computing and metaverse contexts, it encompasses virtual classrooms, simulation-based training, adaptive learning systems, and collaborative virtual environments that extend education beyond physical and temporal constraints. The field draws on learning science, human-computer interaction, artificial intelligence, and networked infrastructure to personalise instruction and reduce barriers to access. Mature EdTech deployments span K-12, higher education, corporate training, and professional development, increasingly leveraging extended reality modalities and AI-driven tutoring systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-classroom ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gamification ],
        ngm:metaverse-technology ;
    vc:bridgesTo ngm:data-governance,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:enables ngm:collaborative-systems-modality-learning,
        ngm:immersive-learning,
        ngm:personalised-learning,
        ngm:remote-education ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gamification,
        ngm:learning-analytics,
        ngm:virtual-classroom ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:human-computer-interaction ;
    vc:requires ngm:digital-identity,
        ngm:learning-management-system,
        ngm:network-infrastructure ;
    vc:slug "educational-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:scorm,
        ngm:xapi ;
    vc:uses ngm:adaptive-learning,
        ngm:artificial-intelligence,
        ngm:augmented-reality,
        ngm:simulation,
        ngm:virtual-reality .

ngm:enterprise-architecture a owl:Class ;
    rdfs:label "Enterprise Architecture"@en ;
    rdfs:comment "A strategic framework for aligning business processes, information systems, and technology infrastructure with organisational goals, increasingly incorporating metaverse technologies such as XR, digital twins, and AI to enable digital transformation and persistent virtual work environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-architecture ],
        ngm:system-architecture ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:cloud-computing,
        ngm:system-architecture ;
    vc:contrastsWith ngm:solution-architecture ;
    vc:dependsOn ngm:enterprise-integration,
        ngm:identity-and-access-management ;
    vc:enables ngm:digital-twin,
        ngm:enterprise-metaverse,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:application-architecture,
        ngm:business-architecture,
        ngm:data-architecture,
        ngm:technology-architecture ;
    vc:implements ngm:togaf,
        ngm:zachman-framework ;
    vc:isPartOf ngm:digital-transformation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-resource-planning,
        ngm:service-oriented-architecture ;
    vc:requires ngm:governance-framework,
        ngm:it-strategy ;
    vc:slug "enterprise-architecture" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-42010 ;
    vc:supports ngm:compliance,
        ngm:risk-management ;
    vc:uses ngm:capability-model,
        ngm:reference-architecture .

ngm:feed-forward-network a owl:Class ;
    rdfs:label "Feed Forward Network"@en ;
    rdfs:comment "A feed-forward network (FFN) is a class of artificial neural network in which information propagates strictly in one direction — from input nodes through one or more hidden layers to output nodes — with no feedback cycles, recurrent connections, or lateral synapses between units at the same layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hidden-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:weight-matrix ],
