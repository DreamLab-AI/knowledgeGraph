        ngm:node .

ngm:breakout-room a owl:Class ;
    rdfs:label "Breakout Room"@en ;
    rdfs:comment "Breakout rooms are temporary, parallel sub-session spaces embedded within a primary virtual meeting or conferencing environment that partition a large group of participants into smaller, purpose-bounded clusters for focused collaborative work, deliberation, or learning activities, enabling concur..."@en ;
