ngm:urdf-robot-model a owl:Class ;
    rdfs:label "URDF Robot Model"@en ;
    rdfs:comment "A URDF (Unified Robot Description Format) robot model is an XML specification that describes a robot's kinematic and dynamic properties, including links, joints, inertial parameters, visual meshes and collision geometry. It is the canonical model format in the ROS ecosystem, consumed by simulators, motion planners and visualisation tools to reason about a robot's physical structure. URDF files enable consistent representation of articulated robots across simulation and control software."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gazebo-simulator,
        ngm:robot-operating-system ;
    vc:slug "urdf-robot-model" ;
    vc:sourceDomain "robotics" .

ngm:uri-scheme a skos:Concept ;
    rdfs:label "Uri Scheme"@en .

ngm:usage-analytics a owl:Class ;
    rdfs:label "Usage Analytics"@en ;
    rdfs:comment "Usage analytics is the collection, measurement and interpretation of data describing how users interact with a product, service or platform, including session frequency, feature adoption, retention and engagement patterns. It transforms raw event telemetry into actionable insight for product, design and governance decisions. When applied responsibly it can inform well-being metrics while raising privacy considerations about behavioural tracking."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-well-being-index,
        ngm:telemetry-and-analytics ;
    vc:slug "usage-analytics" ;
    vc:sourceDomain "data" .

ngm:user-directory a owl:Class ;
    rdfs:label "User Directory"@en ;
    rdfs:comment "A user directory is a centralised repository that stores and organises identity records, attributes and credentials for the principals of a system, supporting authentication and authorisation queries. Common implementations include LDAP directories, Active Directory and cloud identity stores, which identity providers consume to validate and describe users. It is a core component of identity and access management infrastructure."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-provider,
        ngm:identity-provider-id-p ;
    vc:slug "user-directory" ;
    vc:sourceDomain "security" .

ngm:user-monitoring a owl:Class ;
    rdfs:label "User Monitoring"@en ;
    rdfs:comment "User monitoring is the observation and logging of user behaviour and interactions within a platform to detect policy violations, abuse, safety risks or anomalous activity. In metaverse and online environments it supports trust-and-safety enforcement and agreement compliance, balancing protective oversight against privacy and consent. It typically feeds moderation, incident response and compliance reporting workflows."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-safety-protocol,
        ngm:user-agreement-compliance ;
    vc:slug "user-monitoring" ;
    vc:sourceDomain "governance" .

ngm:user-protection a owl:Class ;
    rdfs:label "User Protection"@en ;
    rdfs:comment "User Protection encompasses the legal frameworks, platform policies, and technical mechanisms designed to safeguard individuals from harm when using digital services and online platforms. It spans data protection rights, content moderation obligations, anti-manipulation requirements, and consumer protection rules applicable to platform operators. Regulation such as the UK Online Safety Act and the EU Digital Services Act impose positive duties on platforms to assess and mitigate risks to users, particularly minors and vulnerable populations. Technical controls include content filtering, safety settings, transparency mechanisms, and redress systems that give users agency over their online experience."@en ;
    rdfs:subClassOf ngm:consumer-protection ;
    vc:enables ngm:gdpr-compliance,
        ngm:user-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation-standards,
        ngm:data-protection,
        ngm:digital-well-being-index,
        ngm:online-safety-act-2023,
        ngm:uk-online-safety-act ;
    vc:slug "user-protection" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:consent-management,
        ngm:content-moderation,
        ngm:digital-rights .

ngm:user-trust a owl:Class ;
    rdfs:label "User Trust"@en ;
    rdfs:comment "User trust is the confidence individuals place in a system to handle their data, decisions and interactions reliably, securely and in their interests. It is built through transparency, predictable behaviour, privacy safeguards and demonstrable accountability, and is a key outcome of privacy and data-protection practices. Eroded trust undermines adoption, while sustained trust is a competitive and ethical asset."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:privacy-impact-assessment-pia ;
    vc:slug "user-trust" ;
    vc:sourceDomain "governance" .

ngm:validation-constraints a owl:Class ;
    rdfs:label "Validation Constraints"@en ;
    rdfs:comment "Validation constraints are the formally specified rules that data or metadata must satisfy to be considered valid against a schema, covering datatypes, cardinality, value ranges, required fields and structural relationships. Expressed through languages such as SHACL, JSON Schema or XSD, they let systems automatically verify conformance and reject malformed input. They are an integral part of metadata standards and ontology schemas."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-standard,
        ngm:metaverse-ontology-schema ;
    vc:slug "validation-constraints" ;
    vc:sourceDomain "data" .

ngm:validation-process a owl:Class ;
    rdfs:label "Validation Process"@en ;
    rdfs:comment "Activity of systematically checking wher systems, components, or implementations satisfy specified requirements, standards, and compliance criteria through verification testing and quality assurance procedures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-testing ],
        [ a owl:Restriction ;
