ngm:digital-gold a owl:Class ;
    rdfs:label "Digital Gold"@en ;
    rdfs:comment "Digital Gold is a conceptual and investment category that characterises a cryptocurrency—most commonly Bitcoin—as a bearer instrument that performs the monetary functions traditionally attributed to gold: a scarce, durable, fungible, portable, and divisible store of value that preserves purchasing power across time and political regimes without dependence on any issuing authority. The analogy rests on Bitcoin's algorithmically enforced supply cap of 21 million coins, its proof-of-work scarcity mechanism, and its censorship resistance, which proponents argue replicate or improve upon gold's monetary properties in a digital-native form. The digital gold thesis underpins institutional Bitcoin investment strategies and shapes regulatory and macroeconomic discourse about the role of cryptographic assets in global monetary systems."@en ;
    rdfs:subClassOf ngm:cryptocurrency ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:digital-currency ;
    vc:enables ngm:bitcoin-etf ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:bitcoin-standard,
        ngm:monetary-policy,
        ngm:sound-money ;
    vc:slug "digital-gold" ;
    vc:sourceDomain "blockchain" .

ngm:digital-heritage a owl:Class ;
    rdfs:label "Digital Heritage"@en ;
    rdfs:comment "The digitisation, preservation, and interactive presentation of cultural artefacts, historical sites, and intangible heritage through spatial computing technologies such as 3D reconstruction, AR, and VR. Digital heritage enables remote access, scholarly analysis, and public engagement with cultural memory that may otherwise be physically inaccessible or at risk of loss."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cultural-heritage-xr-experience ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:archival-standards ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:archival-standards,
        ngm:cultural-heritage-xr-experience ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:nft ;
    vc:slug "digital-heritage" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-reconstruction,
        ngm:digital-preservation .

ngm:digital-marketing a owl:Class ;
    rdfs:label "Digital Marketing"@en ;
    rdfs:comment "Digital Marketing encompasses the strategies and technologies used to promote products and services through digital channels, including search engines, social media, email, and immersive platforms. In spatial computing and metaverse contexts, digital marketing extends to in-world advertising, NFT-based brand activations, virtual experiential campaigns, and personalised AR overlays that contextualise commercial messages within physical environments."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
