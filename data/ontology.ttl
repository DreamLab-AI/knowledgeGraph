ngm:gan a owl:Class ;
    rdfs:label "GAN"@en ;
    rdfs:comment "A Generative Adversarial Network (GAN) is a deep-learning framework in which two neural networks — a generator and a discriminator — are trained simultaneously in a minimax game: the generator maps random latent vectors to synthetic data samples, while the discriminator learns to distinguish real training samples from generated ones. Through adversarial feedback propagated via backpropagation, the generator progressively improves at synthesising realistic outputs while the discriminator improves at detection. GANs have achieved state-of-the-art results in image synthesis, style transfer, super-resolution, and conditional generation, but are prone to training instabilities such as mode collapse and vanishing gradients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generator-network ],
        ngm:generative-model ;
    vc:bridgesTo ngm:deepfake,
        ngm:procedural-content-generation,
        ngm:synthetic-data ;
    vc:contrastsWith ngm:autoregressive-model,
        ngm:diffusion-model,
        ngm:variational-autoencoder ;
    vc:enables ngm:data-augmentation,
        ngm:image-generation,
        ngm:image-to-image-translation,
        ngm:super-resolution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:discriminator-network,
        ngm:generator-network,
        ngm:latent-space ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:mode-collapse,
        ngm:unsupervised-learning,
        ngm:wasserstein-distance ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent,
        ngm:neural-network ;
    vc:slug "gan" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:adversarial-training,
        ngm:batch-normalisation,
        ngm:convolutional-neural-network .

