ngm:zero-trust a owl:Class ;
    rdfs:comment "A security architecture built on the principle of 'never trust, always verify': no user, device, or workload is trusted by virtue of its network location, and every access request must be continuously authenticated, authorised, and encrypted based on identity, device posture, and context, replacing the traditional perimeter model in which anything inside the corporate network was implicitly trusted."@en ;
    rdfs:label "Zero Trust"@en ;
    rdfs:subClassOf ngm:security-architecture ;
    rdfs:subClassOf _:r22633 ;
    rdfs:subClassOf _:r22634 ;
    vc:contrastsWith ngm:perimeter-security ;
    vc:contrastsWith ngm:virtual-private-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:least-privilege ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control ;
    vc:relatedTo ngm:network-security ;
    vc:requires ngm:authentication ;
    vc:requires ngm:identity-and-access-management ;
    vc:slug "zero-trust" ;
    vc:sourceDomain "security" .
ngm:zero-trust-architecture a owl:Class ;
    rdfs:comment "Zero Trust Architecture (ZTA) is a cybersecurity paradigm that abandons the notion of a trusted network perimeter and instead requires explicit, continuous verification of every principal — user, device, or service — for every request regardless of network origin. Grounded in least-privilege access, ZTA evaluates contextual signals including identity assertions, device health posture, behavioural risk, and data sensitivity at each access decision point, enforced by a Policy Decision Point and Policy Enforcement Point pair operating across micro-segmented environments. Formalised in NIST SP 800-207, ZTA has become the dominant enterprise security reference model in response to the dissolution of traditional perimeter boundaries by cloud-native, remote-work, and supply-chain threat vectors."@en ;
    rdfs:label "Zero Trust Architecture"@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    rdfs:subClassOf _:r22630 ;
    rdfs:subClassOf _:r22631 ;
    rdfs:subClassOf _:r22632 ;
