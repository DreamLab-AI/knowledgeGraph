ngm:x-402 a owl:Class ;
    rdfs:label "X402"@en ;
    rdfs:comment "An open protocol that uses the HTTP 402 Payment Required status code to enable machine-to-machine payments for accessing web resources and services. It allows clients to pay programmatically before a request is served."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stablecoin ],
        ngm:digital-currency ;
    vc:enables ngm:decentralized-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:stablecoin ;
    vc:slug "x-402" ;
    vc:sourceDomain "blockchain" .

