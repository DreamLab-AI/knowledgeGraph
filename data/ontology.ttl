ngm:decentralised-authentication a owl:Class ;
    rdfs:comment "Decentralised authentication verifies the identity of a party without relying on a single central identity provider, instead using cryptographic keys, decentralised identifiers and verifiable credentials controlled by the user. The holder proves control of an identifier and presents credentials that a verifier checks against a distributed trust registry rather than a federated login service. This shifts control of identity from platforms to individuals while preserving cryptographic assurance."@en ;
    rdfs:label "Decentralised Authentication"@en ;
    rdfs:subClassOf ngm:authentication-protocol ;
    rdfs:subClassOf _:r7249 ;
    rdfs:subClassOf _:r7250 ;
