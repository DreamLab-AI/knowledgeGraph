    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bank-for-international-settlements ;
    vc:supports ngm:anti-money-laundering,
        ngm:sanctions-compliance .

ngm:technology-transfer a owl:Class ;
    rdfs:label "Technology Transfer"@en ;
    rdfs:comment "Technology transfer is the process of moving knowledge, skills, methods and inventions from the setting where they are created, such as a university or research laboratory, to organisations that can develop and commercialise them. It encompasses the legal, organisational and economic mechanisms, including licensing, spin-outs and collaborative research, by which research outputs become products, services and capabilities. Effective technology transfer is a central channel through which research and development drives economic and societal impact."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-and-development ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-transfer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:patent ],
        ngm:innovation ;
    vc:bridgesTo ngm:research-and-development ;
    vc:enables ngm:innovation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:knowledge-transfer ;
    vc:isPartOf ngm:innovation ;
