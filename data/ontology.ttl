ngm:ai-surveillance a owl:Class ;
    rdfs:comment "AI surveillance is the application of machine learning and computer vision to monitoring at scale: automated facial recognition in public space, gait and behaviour analysis, licence-plate reading, social-media and communications analytics, and predictive scoring of individuals or crowds. It differs from conventional surveillance in that inference, not observation, does the work — systems classify, track, and flag people continuously without human attention per subject, raising distinct governance questions about bias, proportionality, chilling effects, and the legal basis for algorithmic monitoring."@en ;
    rdfs:label "AI Surveillance"@en ;
    rdfs:subClassOf ngm:surveillance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:digital-society-surveillance ;
