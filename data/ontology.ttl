            owl:someValuesFrom ngm:scope-1-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-2-emissions ],
        ngm:sc-governance-and-safety,
        ngm:strategic-planning ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:infrastructure,
