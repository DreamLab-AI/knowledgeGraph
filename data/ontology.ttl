        ngm:dao-legal-structures,
        ngm:legal-framework ;
    vc:slug "dispute-resolution" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:arbitration-decision-engine,
        ngm:legal-compliance,
        ngm:smart-contract .

