ngm:decentralized-identity a owl:Class ;
    rdfs:label "Decentralized Identity"@en ;
    rdfs:comment "Decentralized identity (DID) is an approach to digital identity management in which individuals, organisations, and devices control their own identifiers and associated credentials without reliance on a centralised identity provider. Built on W3C Decentralized Identifier (DID) specifications and Verifiable Credential (VC) standards, decentralized identity systems enable self-sovereign control where the subject generates cryptographic key pairs, anchors the DID document to a verifiable data registry (such as a blockchain or distributed ledger), and presents credentials that can be cryptographically verified by any relying party without querying a central authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:didcomm ],
        ngm:digital-identity ;
    vc:enables ngm:digital-identity-wallet,
