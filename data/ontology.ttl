    vc:sourceDomain "artificial-intelligence" .

ngm:fairness-accuracy-tradeoffs a owl:Class ;
    rdfs:label "Fairness Accuracy Tradeoffs"@en ;
    rdfs:comment "The fundamental tension in supervised machine learning between maximising predictive accuracy and satisfying fairness constraints, characterised by the Pareto frontier of achievable (accuracy, fairness) pairs. Imposing fairness constraints restricts the hypothesis space, excluding models that achieve accuracy through reliance on protected-attribute correlations. The magnitude of the accuracy cost depends on the chosen fairness criterion (demographic parity, equalised odds, calibration), the base rate differences between groups, and the flexibility of the model class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:algorithmic-bias-and-variance ;
    vc:dependsOn ngm:ai-fairness,
        ngm:bias-mitigation-techniques ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-ethics,
        ngm:explainable-ai,
        ngm:responsible-ai ;
    vc:requires ngm:algorithmic-bias,
        ngm:machine-learning-model ;
    vc:slug "fairness-accuracy-tradeoffs" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:responsible-ai-principles .

ngm:fairness-auditing-tools a owl:Class ;
    rdfs:label "Fairness Auditing Tools"@en ;
    rdfs:comment "Fairness Auditing Tools are software libraries, platforms, and frameworks designed to detect, measure, and mitigate algorithmic bias in AI systems through automated analysis, visualisation, and intervention capabilities. They operationalise fairness metrics—such as demographic parity, equalised odds, and predictive parity—across protected attribute groups, supporting both pre-deployment model assessments and continuous production monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-mitigation-techniques ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:explainability,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bias-detection-methods,
        ngm:bias-mitigation-techniques,
        ngm:fairness-metrics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:data-governance,
        ngm:fairness-constraints ;
    vc:requires ngm:algorithmic-bias,
        ngm:machine-learning-model,
        ngm:training-data ;
    vc:slug "fairness-auditing-tools" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-ethics,
        ngm:ai-risk-management .

ngm:feature-importance a owl:Class ;
    rdfs:label "Feature Importance"@en ;
    rdfs:comment "Quantitative measures indicating the relative contribution or influence of individual input features on a machine learning model's predictions, enabling identification of the most critical variables driving model outputs. Methods include permutation importance, SHAP (SHapley Additive exPlanations) values, and tree-based Gini impurity scores, each providing global or local views of feature influence that support model debugging, data selection, and regulatory explainability requirements."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:explainability ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:global-explanation,
        ngm:model-interpretability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "feature-importance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:transparency ;
    vc:uses ngm:dimensionality-reduction,
        ngm:machine-learning .

ngm:feature-matching a owl:Class ;
    rdfs:label "Feature Matching"@en ;
    rdfs:comment "Feature Matching is a computer vision technique that identifies and associates corresponding salient regions—keypoints and their descriptors—across two or more images or point clouds, enabling geometric relationships such as homographies, fundamental matrices, or rigid-body transformations to be estimated. Classical detectors such as SIFT, SURF, and ORB extract rotation- and scale-invariant descriptors; modern deep learning approaches learn matched embeddings end-to-end from training data. Feature matching is a foundational step in Structure-from-Motion, visual odometry, SLAM, and image-based localisation pipelines. The accuracy and efficiency of matching directly determine downstream reconstruction quality and real-time performance in robotics and augmented reality applications."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:photogrammetry,
        ngm:slam,
        ngm:structure-from-motion,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:depth-sensing,
        ngm:lidar,
        ngm:point-cloud ;
    vc:slug "feature-matching" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:depth-estimation,
        ngm:stereo-camera .

ngm:file-system a owl:Class ;
    rdfs:label "File System"@en ;
    rdfs:comment "A file system is the data structure and associated management software that an operating system uses to organise, store, retrieve, and manage data on storage media. It defines how data is logically partitioned into named files and directories, governs access permissions, maintains metadata such as timestamps and ownership, and translates logical file operations into physical block I/O against underlying storage hardware. File systems range from local single-disk formats (NTFS, ext4, APFS) to distributed and network-attached systems (NFS, HDFS, GFS) that span many physical storage nodes."@en ;
    rdfs:subClassOf ngm:operating-system ;
    vc:enables ngm:content-addressed-storage,
        ngm:data-storage-layer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-storage,
        ngm:distributed-storage,
        ngm:ipfs,
        ngm:storage-systems ;
    vc:slug "file-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:storage-hardware,
        ngm:virtual-machine .

ngm:film-production a owl:Class ;
    rdfs:label "Film Production"@en ;
    rdfs:comment "The end-to-end creative and technical process of making motion picture content, encompassing development, pre-production, principal photography, visual effects, post-production, and distribution. Modern film production increasingly integrates spatial computing technologies such as virtual production workflows, LED volume stages, real-time game engine rendering, and AI-assisted tools that compress timelines and reduce location dependency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
