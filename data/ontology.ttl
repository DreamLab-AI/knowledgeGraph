ngm:statistical-testing a skos:Concept ;
    rdfs:label "Statistical Testing"@en .

ngm:superintelligence a owl:Class ;
    rdfs:label "Superintelligence"@en ;
    rdfs:comment "Superintelligence refers to a hypothetical form of artificial intelligence that surpasses the cognitive performance of any human across virtually all domains of interest, including scientific reasoning, social manipulation, and strategic planning. Nick Bostrom distinguishes speed superintelligence (same algorithms, faster hardware), collective superintelligence (many coordinated AI agents), and quality superintelligence (genuinely superior algorithms), each presenting distinct safety and control challenges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        ngm:artificial-superintelligence-theory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:agi-timelines ;
    vc:requires ngm:ai-alignment ;
    vc:slug "superintelligence" ;
    vc:sourceDomain "ai" .

ngm:supply-cap a owl:Class ;
    rdfs:label "Supply Cap"@en ;
    rdfs:comment "A Supply Cap is a hard-coded or governance-determined upper bound on the total number of tokens or coins that will ever be issued by a blockchain protocol, creating a form of programmatic scarcity that underpins deflationary monetary policy. Bitcoin's 21 million coin cap is the canonical example, encoded in the protocol's halvening schedule and providing a predictable issuance curve. Supply caps differentiate blockchain-native assets from fiat currencies and influence long-run security models, since block rewards approach zero as the cap is neared and transaction fees must compensate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:fee-market ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-standard,
        ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circulating-supply,
        ngm:cryptocurrency,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:requires ngm:block-reward,
        ngm:consensus-algorithm ;
    vc:slug "supply-cap" ;
    vc:sourceDomain "blockchain" .

ngm:supply-chain-risk-management a skos:Concept ;
    rdfs:label "Supply Chain Risk Management"@en .

ngm:synchronisation a owl:Class ;
    rdfs:label "Synchronisation"@en ;
    rdfs:comment "Synchronisation is the coordination of multiple processes, devices, or data replicas so that they reach a consistent state or act in a precise temporal relationship. In computing it covers concurrency primitives like locks and barriers; in distributed and robotic systems it covers clock alignment and coordinated motion. Accurate synchronisation is essential wherever independent components must agree on order, timing, or shared state."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delta-robot,
        ngm:edge-computing ;
    vc:slug "synchronisation" ;
    vc:sourceDomain "infrastructure" .

ngm:system-integration a owl:Class ;
    rdfs:label "System Integration"@en ;
    rdfs:comment "System Integration is the engineering discipline of connecting and orchestrating disparate software components, services, databases, and external platforms so that they behave as a unified, interoperable system. It spans interface design via APIs and messaging protocols, middleware orchestration, data transformation pipelines, identity federation, and governance of information flows across organisational and technical boundaries. Unlike simple point-to-point coupling, mature system integration imposes coherent contracts, observability, and error-recovery strategies so that independently developed or procured subsystems can exchange information reliably. The discipline underpins enterprise IT, cloud-native architectures, IoT deployments, and the composable software stacks that drive spatial computing and AI platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-federation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:ai-orchestration,
        ngm:spatial-computing,
        ngm:supply-chain-visibility ;
    vc:contrastsWith ngm:monolithic-architecture,
        ngm:point-to-point-integration ;
    vc:dependsOn ngm:network-protocol,
        ngm:security-policy ;
    vc:enables ngm:composable-architecture,
        ngm:digital-twin,
        ngm:distributed-systems,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:api-gateway,
        ngm:data-pipeline,
        ngm:message-broker,
        ngm:middleware,
        ngm:service-mesh ;
    vc:implements ngm:event-driven-architecture,
        ngm:microservices,
        ngm:service-oriented-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:devops,
        ngm:enterprise-architecture,
        ngm:observability ;
    vc:requires ngm:api-design,
        ngm:data-serialisation,
        ngm:identity-federation ;
    vc:slug "system-integration" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:asyncapi,
        ngm:open-api-specification ;
    vc:uses ngm:apache-kafka,
        ngm:graphql,
        ngm:grpc,
        ngm:rest-api .

ngm:tamper-detection a owl:Class ;
    rdfs:label "Tamper Detection"@en ;
    rdfs:comment "Tamper detection is the set of technical mechanisms and protocols that identify whether a digital asset, data record, physical device, or communication has been unauthorisedly modified since its creation or last verified state. In the digital domain it employs cryptographic hash functions, digital signatures, Merkle proofs, and content-addressed storage to generate verifiable commitments that reveal any change to the protected content. Applied to media authenticity, hardware integrity, and data provenance, tamper detection is a foundational component of trust architectures for critical systems, supply chains, digital forensics, and content authenticity verification."@en ;
    rdfs:subClassOf ngm:data-integrity ;
    vc:enables ngm:content-authentication,
        ngm:digital-forensics,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:audit-trail ;
    vc:slug "tamper-detection" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:cryptographic-signature,
        ngm:digital-signature .

ngm:task-automation a owl:Class ;
    rdfs:label "Task Automation"@en ;
    rdfs:comment "The automation of individual, often repetitive tasks so that they run without manual effort. It addresses discrete actions rather than coordinating entire business processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automation ],
        ngm:automation ;
    vc:enables ngm:business-process-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automation ;
    vc:slug "task-automation" ;
    vc:sourceDomain "robotics" .

ngm:technical-debt a skos:Concept ;
    rdfs:label "Technical Debt"@en .

ngm:technical-expertise a owl:Class ;
    rdfs:label "Technical Expertise"@en ;
    rdfs:comment "Technical expertise is the specialised knowledge, skill, and practical judgement required to design, build, or operate within a complex technical domain. It is a prerequisite and a gating factor for advanced work, and its scarcity can both enable progress and act as a barrier to misuse. The level and distribution of expertise materially affects how quickly capabilities such as AI development or biotechnology proliferate."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-development,
