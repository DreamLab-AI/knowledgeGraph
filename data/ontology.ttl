            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-lake ],
        ngm:ai-infrastructure,
        ngm:machine-learning-pipeline ;
    vc:enables ngm:machine-learning-pipeline,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:feature-engineering,
        ngm:feature-extraction,
        ngm:training-data ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:vector-database ;
    vc:requires ngm:data-lake,
        ngm:data-pipeline ;
    vc:slug "feature-store" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:gaussian-splatting a owl:Class ;
    rdfs:label "Gaussian Splatting"@en ;
    rdfs:comment "Novel view synthesis and 3D scene representation technique introduced by Kerbl, Kopanas, Leimkühler and Drettakis at SIGGRAPH 2023 (INRIA Sophia Antlis), representing scenes as explicit collections of s of anisotropic 3D Gaussian primitives — each defined by a 3D mean position μ ∈ ℝ³, a 3×3 covar..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:structure-from-motion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
