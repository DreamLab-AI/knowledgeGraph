ngm:digital-payment-system a owl:Class ;
    rdfs:label "Digital Payment System"@en ;
    rdfs:comment "The integrated infrastructure of protocols, platforms, and financial instruments enabling secure monetary transactions within metaverse environments, encompassing cryptocurrency payments, stablecoin transfers, fiat gateways, and smart contract-based payment automation for virtual goods and servic..."@en ;
