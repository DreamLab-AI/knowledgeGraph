        ngm:functional-safety,
        ngm:safety-critical-systems ;
    vc:requires ngm:hazard-analysis,
        ngm:safety-assessment,
        ngm:verification ;
    vc:slug "arp4754-a" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:compliance,
        ngm:systems-engineering .

