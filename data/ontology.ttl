ngm:digital-well-being-index a owl:Class ;
    rdfs:label "Digital Well-Being Index"@en ;
    rdfs:comment "Composite indicator assessing psychological, social, physical, and temporal impacts of extended virtual engagement, providing quantitative measures of healthy metaverse usage patterns."@en ;
