ngm:enforcement-action a owl:Class ;
    rdfs:comment "An enforcement action is a formal measure taken by a regulatory or supervisory authority against an entity that has violated laws, rules, or licence conditions. It can include fines, cease-and-desist orders, licence revocation, restitution to affected parties, or referral for prosecution. Enforcement actions are the operative mechanism by which consumer-protection and market-conduct regulations are made binding."@en ;
    rdfs:label "Enforcement Action"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
