    vc:slug "obfuscation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-privacy,
        ngm:privacy ;
    vc:uses ngm:cryptographic-protocols,
        ngm:tokenization .

ngm:objective a owl:Class ;
    rdfs:label "Objective"@en ;
    rdfs:comment "A formal specification of the goal or criterion that an AI system, optimisation algorithm, or training procedure is designed to satisfy or maximise. In machine learning this is typically expressed as a loss function or reward signal that guides parameter updates; in planning and reinforcement learning it encodes desired agent behaviour through utility or reward functions."@en ;
