ngm:animate-diff a owl:Class ;
    rdfs:label "AnimateDiff"@en ;
    rdfs:comment "AnimateDiff is an open-source framework that inserts lightweight motion-module adapters into pre-trained text-to-image diffusion models to generate temporally consistent animated sequences without retraining the base image model. Developed by researchers at CUHK and ByteDance and released in 2023, it enables personalised diffusion model checkpoints to produce video clips by learning motion priors from video data in a plug-and-play manner. AnimateDiff integrates natively with the Stable Diffusion ecosystem, including ControlNet conditioning and LoRA fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latent-diffusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:video-generation ;
    vc:contrastsWith ngm:motion-capture-technology ;
    vc:enables ngm:animation-technique,
        ngm:image-to-image-translation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:generative-ai,
        ngm:stable-diffusion,
        ngm:video-processing ;
    vc:requires ngm:attention-mechanism,
        ngm:diffusion-model,
        ngm:latent-diffusion ;
    vc:slug "animate-diff" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:fine-tuning,
        ngm:generative-model,
        ngm:motion-capture,
        ngm:parameter-efficient-fine-tuning .

ngm:anthropic a owl:Class ;
    rdfs:label "Anthropic"@en ;
    rdfs:comment "Anthropic is an AI safety company founded in 2021 that develops large language models under the Claude family brand, with research programmes centred on constitutional AI, mechanistic interpretability, and scalable oversight. The company occupies the position of a safety-focused frontier AI laboratory, publishing research on alignment and interpretability while deploying Claude models commercially via API and consumer products. Anthropic's Constitutional AI (CAI) approach trains models to follow a set of principles using AI feedback rather than solely human labelling, aiming to reduce harmful outputs systematically."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interpretability ;
    vc:slug "anthropic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety-research,
        ngm:constitutional-ai ;
    vc:uses ngm:large-language-models,
        ngm:rlhf .

ngm:api-management a owl:Class ;
    rdfs:label "API Management"@en ;
    rdfs:comment "API Management is the discipline and tooling concerned with designing, publishing, documenting, securing, monitoring, and analysing application programming interfaces throughout their lifecycle. It provides a centralised control plane that governs how internal and external consumers discover and consume backend services, enforcing policies such as authentication, rate-limiting, and traffic shaping at a gateway layer. Modern API management platforms combine developer portals, analytics dashboards, and policy engines to ensure reliability, security, and business alignment across distributed service ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:enables ngm:api-integration,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway,
        ngm:authentication-service,
        ngm:monitoring-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:api-standard,
        ngm:oauth-2-0,
        ngm:rest-api ;
    vc:slug "api-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:graph-ql .

ngm:ar-display-device a owl:Class ;
    rdfs:label "Ar Display Device"@en ;
    rdfs:comment "AR Display Device encompasses hardware systems including smart glasses, headsets, and head-mounted displays that superimpose computer-generated imagery onto the user's view of the real world through optical technologies such as waveguides, birdbath optics, holographic displays, and metasurfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
