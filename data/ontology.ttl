ngm:naive-bayes-classifier a owl:Class ;
    rdfs:comment "A naive Bayes classifier is a probabilistic classification algorithm that applies Bayes' theorem under the simplifying (naive) assumption that features are conditionally independent given the class label. Despite this assumption rarely holding exactly in practice, the classifier is computationally efficient, requires little training data, and performs competitively on tasks such as text classification and spam filtering. It estimates class-conditional feature distributions from training data and selects the class maximising posterior probability for a new observation."@en ;
    rdfs:label "Naive Bayes Classifier"@en ;
    rdfs:subClassOf ngm:bayesian-decision-theory ;
