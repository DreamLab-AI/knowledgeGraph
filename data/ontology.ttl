    vc:slug "carbon-footprint-assessment" ;
    vc:sourceDomain "spatial-computing" .

ngm:centralised-identity a owl:Class ;
    rdfs:label "Centralised Identity"@en ;
    rdfs:comment "Centralised identity is a digital identity model in which a single authority — such as a government, enterprise, or platform identity provider — issues, stores, and controls users' identity credentials and authenticates them on behalf of relying parties. Users authenticate against the central provider, which holds the authoritative record of their attributes and mediates access to connected services. The model is operationally simple and widely deployed, but concentrates control, data, and risk in one party, creating single points of failure, surveillance potential, and vendor lock-in that decentralised and self-sovereign identity approaches are designed to counter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-provider ],
        ngm:identity-management ;
    vc:bridgesTo ngm:verifiable-credentials ;
    vc:contrastsWith ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:dependsOn ngm:authentication ;
    vc:enables ngm:federated-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:authentication,
        ngm:identity-provider ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:identity-management ;
    vc:requires ngm:identity-provider ;
    vc:slug "centralised-identity" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:access-control ;
    vc:uses ngm:access-control,
        ngm:oauth,
        ngm:single-sign-on .

ngm:channel-factory a owl:Class ;
    rdfs:label "Channel Factory"@en ;
    rdfs:comment "A channel factory is a Bitcoin Lightning Network scaling construction in which multiple participants share a single on-chain funding transaction (a multiparty channel) from which many off-chain payment channels can be opened, closed, and rebalanced without further on-chain transactions. By amortising one on-chain output across many channels, it reduces the on-chain footprint and cost of channel management. It matters because it improves the capital efficiency and scalability of layer-2 payments."@en ;
    rdfs:subClassOf ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "channel-factory" ;
    vc:sourceDomain "blockchain" .

ngm:checkerboard-pattern a owl:Class ;
    rdfs:label "Checkerboard Pattern"@en ;
    rdfs:comment "A checkerboard pattern is a planar grid of alternating black and white squares used as a calibration target in computer vision. Its regularly spaced corners are easy to detect with sub-pixel accuracy and have precisely known relative positions, providing reliable correspondences for estimating camera parameters. The checkerboard is the most common target for intrinsic calibration, distortion correction, and stereo rig alignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-detection ],
        ngm:optical-calibration-target ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:fiducial-marker ;
    vc:enables ngm:camera-calibration,
