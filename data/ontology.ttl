ngm:source-routing a owl:Class ;
    rdfs:comment "Source routing is a packet-forwarding technique in which the sender, rather than intermediate routers, specifies all or part of the path a packet must traverse, embedding the route as a list of hops within the packet itself. By moving path selection to the originator it enables explicit path control, multipath delivery, and privacy-preserving forwarding, at the cost of overhead and forwarding-table-bypass security considerations. It underpins onion-routing anonymity networks and payment-channel networks, where the sender constructs and conceals an end-to-end route across an overlay before any hop sees the full path."@en ;
    rdfs:label "Source Routing"@en ;
    rdfs:subClassOf ngm:routing-protocol ;
    rdfs:subClassOf _:r19718 ;
