ngm:enterprise-search a owl:Class ;
    rdfs:label "Enterprise Search"@en ;
    rdfs:comment "Enterprise Search is the organisational capability to retrieve relevant information from heterogeneous internal data sources—documents, databases, emails, intranets, wikis, and code repositories—through a single unified query interface with access-control enforcement. Modern systems combine full-text inverted-index retrieval with dense vector embeddings and semantic search to surface contextually relevant results beyond simple keyword matching. The discipline integrates information retrieval, knowledge management, and applied AI, requiring content connectors, identity-aware access control, relevance tuning, and low-latency indexing pipelines at organisational scale. Retrieval-Augmented Generation (RAG) architectures have become a dominant deployment pattern, passing retrieved document chunks to large language models to synthesise grounded, cited answers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverted-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:conversational-ai,
        ngm:large-language-model ;
    vc:contrastsWith ngm:database-query,
        ngm:web-search ;
    vc:dependsOn ngm:data-ingestion-pipeline,
        ngm:document-processing ;
    vc:enables ngm:decision-support,
        ngm:knowledge-discovery,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-connector,
        ngm:inverted-index,
        ngm:query-understanding,
        ngm:relevance-ranking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:document-management-system,
        ngm:knowledge-graph,
        ngm:knowledge-management ;
    vc:requires ngm:access-control,
        ngm:identity-provider,
        ngm:information-retrieval ;
    vc:slug "enterprise-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bm25,
        ngm:natural-language-processing,
        ngm:semantic-search,
        ngm:text-embeddings,
        ngm:vector-database .

ngm:epoch a owl:Class ;
    rdfs:label "Epoch"@en ;
    rdfs:comment "In machine learning, an Epoch is one complete pass through the entire training dataset, during which model parameters are updated after each constituent batch. The number of epochs is a primary training hyperparameter: too few yield underfitting, whilst too many risk overfitting—a trade-off managed by techniques such as early stopping and learning-rate scheduling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:deep-learning,
        ngm:early-stopping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:batch-size ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:hyperparameter ;
    vc:slug "epoch" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:event-sourcing a owl:Class ;
    rdfs:label "Event Sourcing"@en ;
    rdfs:comment "Event sourcing is an architectural pattern for data persistence in which the state of a system is stored not as a mutable current-state record but as an append-only, ordered log of discrete domain events — each representing a fact that occurred at a specific point in time. Current application state is derived by replaying the event log from the beginning (or from a periodic snapshot), making the full history of state transitions a first-class, queryable artefact. This contrasts with CRUD-oriented architectures where only the latest state is stored, discarding historical change information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:snapshot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:idempotency ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:ai-agent-memory,
        ngm:distributed-ledger ;
    vc:contrastsWith ngm:crud-architecture ;
    vc:enables ngm:agent-event-stream,
        ngm:retroactive-correction,
        ngm:state-management,
        ngm:temporal-query ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-projection,
        ngm:snapshot ;
    vc:implements ngm:cqrs,
        ngm:immutability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:domain-driven-design,
        ngm:event-driven-architecture,
        ngm:microservices-architecture,
        ngm:write-ahead-log ;
    vc:requires ngm:event-store,
        ngm:idempotency ;
    vc:slug "event-sourcing" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:eventual-consistency,
        ngm:optimistic-concurrency-control ;
    vc:uses ngm:apache-kafka,
        ngm:append-only-log,
        ngm:data-persistence,
        ngm:eventstoredb,
        ngm:message-queue .

ngm:f1-score a owl:Class ;
    rdfs:label "F1 Score"@en ;
    rdfs:comment "A classification performance metric representing the harmonic mean of precision and recall, providing a single score that balances a model's ability to avoid false positives (precision) with its ability to avoid false negatives (recall), calculated to give equal weight to both metrics whilst penalising extreme imbalances, particularly useful for comparing models or setting decision thresholds when both prediction reliability and completeness are important and when class distributions are imbalanced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recall ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:precision ],
        ngm:evaluation-metric ;
    vc:bridgesTo ngm:evaluation-metric,
        ngm:information-retrieval-metric ;
    vc:contrastsWith ngm:accuracy,
        ngm:matthews-correlation-coefficient,
        ngm:roc-auc ;
    vc:dependsOn ngm:harmonic-mean,
        ngm:supervised-learning ;
    vc:enables ngm:imbalanced-dataset-evaluation,
        ngm:model-selection,
        ngm:threshold-optimisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:false-positive,
        ngm:precision,
        ngm:recall,
        ngm:true-positive ;
    vc:implements ngm:f-beta-score ;
    vc:isPartOf ngm:classification-evaluation,
        ngm:model-performance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-fairness,
        ngm:mlops,
        ngm:model-governance ;
    vc:requires ngm:binary-classification,
        ngm:confusion-matrix ;
    vc:slug "f1-score" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:macro-f1,
        ngm:micro-f1,
        ngm:precision-recall-curve,
        ngm:weighted-f1 .

ngm:gltf-standard a owl:Class ;
    rdfs:label "Gltf Standard"@en ;
    rdfs:comment "Graphics Library Transmission Format (glTF) is a royalty-free, open interoperable 3D asset format developed by Khronos Group, designed for efficient runtime transmission and loading of 3D scenes across native and web-based engines, serving as a foundational standard for metaverse asset interoperability. Standardised as ISO/IEC 12113:2022, glTF 2.0 supports geometry, PBR materials, skeletal animation, morph targets, and a modular extension system enabling progressive capability extension."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:skeletal-animation ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:3-d-asset-standard,
        ngm:gaussian-splatting,
        ngm:neural-radiance-fields ;
    vc:contrastsWith ngm:fbx-format,
        ngm:obj-format,
        ngm:usd-universal-scene-description ;
    vc:dependsOn ngm:open-standard,
        ngm:royalty-free-licensing ;
    vc:enables ngm:cross-platform-3-d-content,
        ngm:digital-twin,
        ngm:metaverse-asset-interoperability,
        ngm:real-time-3-d-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:binary-geometry-data,
        ngm:gltf-extension-system,
        ngm:pbr-materials,
        ngm:skeletal-animation ;
    vc:implements ngm:3-d-asset-standard,
        ngm:iso-iec-12113 ;
    vc:isPartOf ngm:khronos-group-standards,
        ngm:metaverse-standards-forum ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:e-commerce-3-d,
        ngm:vrm-avatar-format,
        ngm:webxr ;
    vc:requires ngm:json-serialisation,
        ngm:webgl ;
    vc:slug "gltf-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-iec,
        ngm:khronos-group ;
    vc:supports ngm:augmented-reality,
        ngm:avatar-standard,
        ngm:virtual-reality ;
    vc:uses ngm:physically-based-rendering,
        ngm:webgpu .

ngm:http-protocol a owl:Class ;
    rdfs:label "HTTP Protocol"@en ;
    rdfs:comment "The Hypertext Transfer Protocol (HTTP) is a stateless, application-layer request-response protocol that forms the foundation of data communication on the World Wide Web, defining the format and semantics of messages exchanged between clients (browsers, API consumers) and servers (web servers, API gateways) over TCP/IP connections. Each HTTP transaction consists of a request message specifying a method (GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS), a target URI, headers conveying metadata, and an optional body, followed by a response message containing a status code, headers, and an optional body. HTTP has evolved through versions 1.0, 1.1, 2, and 3, with each version improving multiplexing, compression, and connection management."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:bridgesTo ngm:ai-agent,
        ngm:llm-api ;
    vc:contrastsWith ngm:grpc ;
    vc:enables ngm:api-gateway,
        ngm:content-delivery-network-cdn,
        ngm:model-context-protocol,
        ngm:rest-api,
        ngm:server-sent-events,
        ngm:web-application,
        ngm:web-socket-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:http-header,
        ngm:http-method,
        ngm:http-status-code ;
    vc:implements ngm:request-response-pattern,
        ngm:stateless-protocol ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:graph-ql,
        ngm:load-balancer,
        ngm:open-api-specification ;
    vc:requires ngm:client-server-architecture ;
    vc:slug "http-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf ;
    vc:uses ngm:communication-protocol,
        ngm:quic-protocol,
        ngm:tcp-ip,
        ngm:tls,
        ngm:uri .

ngm:iclr a owl:Class ;
    rdfs:label "ICLR"@en ;
    rdfs:comment "The International Conference on Learning Representations (ICLR) is a premier academic venue dedicated to research in deep learning and representation learning, co-founded in 2013 by Yoshua Bengio and Yann LeCun to provide a focused home for the emerging field. ICLR is distinguished by its fully open, internet-based double-open peer review conducted on the OpenReview platform, making submitted manuscripts, reviewer critiques, and author rebuttals publicly visible throughout the review cycle. The conference covers neural network architectures, optimisation methods, generalisation theory, self-supervised learning, reinforcement learning, and the intersection of deep learning with natural language processing, computer vision, and scientific domains. ICLR ranks among the three most competitive machine-learning venues globally and has been the publication forum for many landmark advances including attention-based sequence models, large-language-model scaling investigations, and representation-learning theory."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:neuroscience ;
    vc:contrastsWith ngm:closed-peer-review ;
    vc:enables ngm:deep-learning,
        ngm:generative-model,
        ngm:open-peer-review,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:academic-conference-series,
        ngm:ai-research-community ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:aaai,
        ngm:ai-safety-research,
        ngm:cvpr,
        ngm:icml,
        ngm:machine-learning-conference,
        ngm:neurips,
        ngm:open-source-ai,
        ngm:openreview ;
    vc:slug "iclr" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:large-language-model,
        ngm:neural-network,
        ngm:scientific-machine-learning ;
    vc:uses ngm:attention-mechanism,
        ngm:reinforcement-learning,
        ngm:representation-learning,
        ngm:transformer .

ngm:instance-segmentation a owl:Class ;
    rdfs:label "Instance Segmentation"@en ;
    rdfs:comment "A computer vision task that extends object detection by predicting precise pixel-level masks for each individual object instance, jointly performing detection and segmentation to delineate the exact boundaries of distinct objects. Architectures such as Mask R-CNN, YOLACT, and SOLOv2 enable fine-grained object localisation essential for robotics manipulation, autonomous driving, and medical image analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:computer-vision,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:panoptic-segmentation,
        ngm:semantic-segmentation ;
    vc:dependsOn ngm:bounding-box-regression,
        ngm:image-feature-extraction ;
    vc:enables ngm:autonomous-driving,
        ngm:medical-image-analysis,
        ngm:robotic-manipulation,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:mask-r-cnn,
        ngm:solov2,
        ngm:yolact ;
    vc:isPartOf ngm:panoptic-segmentation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task,
        ngm:deep-learning,
        ngm:image-segmentation ;
    vc:requires ngm:convolutional-neural-network,
        ngm:object-detection,
        ngm:region-proposal-network,
        ngm:semantic-segmentation ;
    vc:slug "instance-segmentation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:anchor-based-detection,
        ngm:feature-pyramid-network,
        ngm:non-maximum-suppression .

ngm:interaction-design a owl:Class ;
    rdfs:label "Interaction Design"@en ;
    rdfs:comment "Interaction design (IxD) is the practice of defining and shaping the dynamic behaviour of interactive systems — determining how they respond to user inputs, communicate state and feedback, and guide users through task sequences — with the goal of creating products that are usable, efficient, and satisfying across diverse contexts. It encompasses the design of interaction flows, affordances, timing, error recovery patterns, and multi-modal input modalities across digital, physical, spatial, and conversational interfaces. Interaction design is distinguished from visual design by its focus on behaviour over time rather than static composition, and from software engineering by its concern for the human experience of system use rather than technical implementation. As interactive surfaces expand into AR, VR, voice, and AI-mediated interfaces, the field continuously develops new design vocabularies, prototyping methods, and evaluation heuristics to address emergent interaction paradigms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cognitive-science ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-mechanism ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:multimodal-interaction,
        ngm:natural-language-interface,
        ngm:spatial-user-interface ;
    vc:enables ngm:accessible-design,
        ngm:conversational-interface,
        ngm:inclusive-design,
        ngm:product-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:affordance,
        ngm:error-recovery,
        ngm:feedback-mechanism,
        ngm:interaction-flow ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:user-experience-design ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:design-system,
        ngm:usability-testing,
        ngm:user-experience,
        ngm:user-interface ;
    vc:requires ngm:cognitive-science,
        ngm:prototyping,
        ngm:user-research ;
    vc:slug "interaction-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:information-architecture,
        ngm:mental-model,
        ngm:task-analysis,
        ngm:wireframing .

ngm:io-t-sensors a owl:Class ;
    rdfs:label "Io T Sensors"@en ;
    rdfs:comment "IoT Sensors are networked sensing devices that collect physical and environmental data (temperature, pressure, motion, humidity, vibration, etc.) and transmit it via internet protocols to edge or cloud systems for processing and analysis."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:internet-of-things ;
    vc:enables ngm:predictive-maintenance,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "io-t-sensors" ;
    vc:sourceDomain "robotics" .

ngm:iso-14064 a owl:Class ;
    rdfs:label "ISO 14064"@en ;
    rdfs:comment "ISO 14064 is a three-part international standard series published by the International Organisation for Standardisation that specifies principles and requirements for the quantification, monitoring, reporting, and independent verification of greenhouse gas (GHG) emissions and removals. Part 1 addresses organisational-level GHG inventories including Scope 1, 2, and 3 emissions; Part 2 covers project-level GHG mitigation quantification underpinning carbon credit issuance; and Part 3 prescribes competence and process requirements for validation and verification bodies. Together the three parts form an auditable, globally recognised framework that underpins corporate sustainability reporting, voluntary and compliance carbon markets, and emerging blockchain-based carbon credit tokenisation schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-factors ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-auditor ],
        ngm:environmental-standards ;
    vc:bridgesTo ngm:carbon-tokenisation,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:ghg-protocol ;
    vc:enables ngm:carbon-accounting,
        ngm:carbon-credits,
        ngm:corporate-sustainability-reporting,
        ngm:esg-reporting,
        ngm:voluntary-carbon-markets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-project-accounting,
        ngm:ghg-inventory-management,
        ngm:ghg-verification-bodies ;
    vc:isPartOf ngm:climate-governance-frameworks,
        ngm:iso-14000-series ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ghg-protocol,
        ngm:iso-14001,
        ngm:paris-agreement,
        ngm:scope-3-emissions,
        ngm:tcfd ;
    vc:requires ngm:conformity-assessment,
        ngm:emission-factors,
        ngm:third-party-auditor ;
    vc:slug "iso-14064" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:environmental-standards,
        ngm:international-organisation-for-standardisation .

ngm:iso-27001 a owl:Class ;
    rdfs:label "ISO 27001"@en ;
    rdfs:comment "ISO/IEC 27001 is the internationally recognised standard specifying requirements for establishing, implementing, maintaining, and continually improving an Information Security Management System (ISMS). Published jointly by the International Organisation for Standardisation (ISO) and the International Electrotechnical Commission (IEC), the standard takes a risk-based approach to information security governance, requiring organisations to systematically identify information assets, assess threats and vulnerabilities, select appropriate controls from the accompanying Annex A catalogue, and demonstrate conformance through a formal audit and certification process. The 2022 edition restructured the Annex A catalogue to 93 controls across four themes — Organisational, People, Physical, and Technological — and introduced eleven new controls addressing cloud security, threat intelligence, and secure coding. Certification is granted by accredited third-party certification bodies and has become a de facto procurement prerequisite in technology supply chains, financial services, healthcare, and government contracting worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:cybersecurity-standard ;
    vc:bridgesTo ngm:ai-governance,
        ngm:cloud-security ;
    vc:contrastsWith ngm:nist-cybersecurity-framework,
        ngm:soc-2 ;
    vc:enables ngm:compliance-audit-trail,
        ngm:data-security,
        ngm:privacy-by-design,
        ngm:third-party-risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:information-security-management-system,
        ngm:risk-treatment-plan,
        ngm:statement-of-applicability ;
    vc:isPartOf ngm:iso-iec-27000-family ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:gdpr-compliance,
        ngm:iso-iec-27002,
        ngm:iso-iec-27005,
        ngm:iso-iec-42001 ;
    vc:requires ngm:internal-audit,
        ngm:management-review,
        ngm:risk-assessment ;
    vc:slug "iso-27001" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iec,
        ngm:iso ;
    vc:uses ngm:access-control,
        ngm:compliance-framework,
        ngm:information-security,
        ngm:risk-management .

ngm:iso-iec a owl:Class ;
    rdfs:label "ISO/IEC"@en ;
    rdfs:comment "ISO/IEC refers to the joint technical committee structure formed by the International Organisation for Standardisation (ISO) and the International Electrotechnical Commission (IEC) to develop international standards in information technology and related fields. The primary body is ISO/IEC JTC 1, which oversees standards in areas including software engineering, cybersecurity, artificial intelligence, and biometrics. ISO/IEC standards are developed through consensus among national standardisation bodies and carry significant weight in regulatory compliance, procurement, and international trade agreements. Landmark outputs include ISO/IEC 27001 for information security management and ISO/IEC 42001 for AI management systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:enables ngm:ai-governance-framework,
        ngm:information-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-standards,
        ngm:cybersecurity-standard,
        ngm:iso-iec-27001,
        ngm:iso-iec-42001 ;
    vc:slug "iso-iec" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:data-standards,
        ngm:technical-standards .

ngm:jacobian-matrix a owl:Class ;
    rdfs:label "Jacobian Matrix"@en ;
    rdfs:comment "The Jacobian matrix is the matrix of all first-order partial derivatives of a vector-valued function, representing the best linear approximation to that function near a point and encoding how each output component changes with respect to each input variable. In robotics, the geometric and analytic Jacobian matrices map from joint velocity space to end-effector Cartesian velocity space, providing the fundamental tool for differential kinematics, inverse kinematics resolution, singularity analysis, and force-torque transmission between joint and task space. The Jacobian's rank and condition number determine the manipulability of a robot configuration and identify singular configurations where the end-effector loses degrees of freedom in certain directions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:denavit-hartenberg-parameters ],
        ngm:differential-kinematics ;
    vc:bridgesTo ngm:coordinate-transformation,
        ngm:differentiable-simulation,
        ngm:neural-network-backpropagation ;
    vc:contrastsWith ngm:hessian-matrix ;
    vc:enables ngm:force-torque-control,
