ngm:synchronous-communication a owl:Class ;
    rdfs:comment "Synchronous communication is an interaction pattern in which participants exchange messages in real time, with sender and receiver engaged simultaneously and responses expected without significant delay. In collaboration it covers video conferencing, live chat and voice calls; in distributed systems it covers blocking request-response exchanges where a caller waits for a reply. It favours immediacy and tight coordination at the cost of requiring co-presence and tolerance to latency."@en ;
    rdfs:label "Synchronous Communication"@en ;
    rdfs:subClassOf ngm:real-time-communication ;
    rdfs:subClassOf _:r20363 ;
    rdfs:subClassOf _:r20364 ;
