mv:VirtualMuseumTour a owl:Class ;
    rdfs:subClassOf mv:VirtualTour ;
    rdfs:label "Virtual Museum Tour"@en ;
    rdfs:comment "An immersive digital experience that enables users to explore museum collections, exhibitions, and cultural heritage sites through VR, AR, 360-degree imagery, or interactive 3D environments, providing global access to art and artifacts regardless of physical location."@en ;
