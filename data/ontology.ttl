    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contracts ;
    vc:slug "yearn" ;
    vc:sourceDomain "metaverse" .

ngm:yoti a owl:Class ;
    rdfs:label "Yoti"@en ;
    rdfs:comment "A digital identity company that provides identity verification, age estimation and authentication services for individuals and organisations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
