ngm:triton-inference-server a owl:Class ;
    rdfs:label "Triton Inference Server"@en ;
    rdfs:comment "Triton Inference Server is NVIDIA's open-source platform for serving machine-learning models in production across CPUs and GPUs. It supports multiple frameworks through a common interface, batches and schedules concurrent requests, and exposes models over HTTP and gRPC. Triton is a standard component of GPU-accelerated inference stacks, often paired with TensorRT-optimised models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
