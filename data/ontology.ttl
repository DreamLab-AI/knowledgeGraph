    vc:uses ngm:carbon-footprint,
        ngm:life-cycle-assessment .

ngm:grid-search a owl:Class ;
    rdfs:label "Grid Search"@en ;
    rdfs:comment "Grid search is a hyperparameter-optimisation method that exhaustively evaluates every combination of values drawn from a predefined discrete grid over the hyperparameter space. Each candidate configuration is trained and scored, typically using cross-validation, and the best-performing combination is selected. Grid search is simple and fully parallelisable but scales exponentially with the number of hyperparameters."@en ;
    rdfs:subClassOf ngm:hyperparameter-optimisation ;
    vc:contrastsWith ngm:bayesian-optimisation,
        ngm:random-search ;
    vc:dependsOn ngm:machine-learning,
        ngm:search-space ;
    vc:enables ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:hyperparameter-tuning ;
    vc:isPartOf ngm:hyperparameter-optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:parallel-computing,
        ngm:random-search ;
    vc:slug "grid-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-selection ;
    vc:uses ngm:cross-validation,
        ngm:search-space .

ngm:gs1-digital-link a owl:Class ;
    rdfs:label "Gs1 Digital Link"@en ;
    rdfs:comment "GS1 Digital Link is a standard that expresses GS1 identifiers, such as the Global Trade Item Number, as web URIs so that a single QR code or data carrier can connect a physical product to multiple online resources. A resolver service interprets the URI and routes requests to information such as product details, instructions, provenance, or recycling guidance. It bridges traditional barcodes with the web and semantic data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:uri ],
        ngm:gs1 ;
    vc:dependsOn ngm:gs1 ;
    vc:enables ngm:circular-economy,
        ngm:supply-chain-provenance,
        ngm:traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:resolver,
        ngm:uri ;
    vc:implements ngm:web-standard ;
    vc:isPartOf ngm:gs1 ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:resolver ;
    vc:slug "gs1-digital-link" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:gs1 ;
    vc:supports ngm:interoperability,
        ngm:semantic-web ;
    vc:uses ngm:barcode,
        ngm:qr-code,
        ngm:uri .

ngm:hard-fork a owl:Class ;
    rdfs:label "Hard Fork"@en ;
    rdfs:comment "A Hard Fork is a backward-incompatible change to a blockchain protocol's consensus rules that permanently diverges the chain into two distinct networks if not universally adopted by all nodes. Because old software versions reject blocks produced under the new rules, a hard fork requires coordinated network-wide consensus to proceed without a chain split. Historical hard forks include the Ethereum/Ethereum Classic split in 2016 and the Bitcoin/Bitcoin Cash split in 2017."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency-mining ;
    vc:slug "hard-fork" ;
    vc:sourceDomain "blockchain" .

ngm:health-check a owl:Class ;
    rdfs:label "Health Check"@en ;
    rdfs:comment "A health check is a periodic probe that determines whether a service instance is functioning correctly and able to handle requests. Health checks distinguish between liveness, whether a process is running and should be restarted if not, and readiness, whether it is prepared to receive traffic. Load balancers, orchestrators, and service meshes use health checks to route around failed instances, trigger restarts, and gate traffic, making them a foundational primitive for high availability and self-healing distributed systems."@en ;
    rdfs:subClassOf ngm:high-availability ;
    vc:dependsOn ngm:observability ;
    vc:enables ngm:auto-scaling,
        ngm:fault-tolerance,
        ngm:graceful-degradation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liveness ;
    vc:implements ngm:circuit-breaker ;
    vc:isPartOf ngm:high-availability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:microservices,
        ngm:service-level-agreement,
        ngm:uptime ;
    vc:slug "health-check" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:kubernetes,
        ngm:load-balancer,
        ngm:service-discovery ;
    vc:uses ngm:heartbeat-mechanism,
        ngm:monitoring .

ngm:hidden-layer a owl:Class ;
    rdfs:label "Hidden Layer"@en ;
    rdfs:comment "A hidden layer is an intermediate layer of neurons in a neural network situated between the input and output layers, whose activations are not directly observed. Each hidden layer applies a learned linear transformation followed by a non-linear activation, building increasingly abstract feature representations. Stacking multiple hidden layers is what gives deep networks their representational power."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:feed-forward-network ;
    vc:slug "hidden-layer" ;
    vc:sourceDomain "ai" .

ngm:hm-treasury a owl:Class ;
    rdfs:label "HM Treasury"@en ;
    rdfs:comment "HM Treasury (His Majesty's Treasury) is the United Kingdom government's principal economics and finance ministry, responsible for setting and implementing fiscal policy, managing public expenditure, and overseeing the financial services regulatory framework. Led by the Chancellor of the Exchequer, it coordinates macroeconomic strategy, tax policy, and sovereign debt management through the Debt Management Office. HM Treasury acts as the primary interface between the UK government and major financial regulators — including the Bank of England, the Financial Conduct Authority, and the Prudential Regulation Authority — establishing the legislative framework within which those bodies operate. It also leads the UK government's policy position on emerging financial technologies including cryptoassets, stablecoins, and central bank digital currencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiscal-policy ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:cryptoasset-regulation,
        ngm:open-banking ;
    vc:contrastsWith ngm:european-central-bank,
        ngm:us-treasury ;
    vc:dependsOn ngm:bank-of-england,
        ngm:financial-conduct-authority ;
    vc:enables ngm:financial-regulation,
        ngm:monetary-policy,
        ngm:sovereign-debt-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:debt-management-office,
        ngm:office-for-budget-responsibility ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:chancellor-of-the-exchequer,
        ngm:government-institution,
        ngm:prudential-regulation-authority ;
    vc:requires ngm:fiscal-policy,
        ngm:public-finance ;
    vc:slug "hm-treasury" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-services-and-markets-act,
        ngm:uk-parliament ;
    vc:supports ngm:consumer-protection,
        ngm:economic-growth,
        ngm:financial-stability ;
    vc:uses ngm:public-spending,
        ngm:taxation .

ngm:htn-planning a owl:Class ;
    rdfs:label "HTN Planning"@en ;
    rdfs:comment "HTN (Hierarchical Task Network) planning is an automated planning approach that solves problems by recursively decomposing high-level compound tasks into ordered subtasks using a library of methods, until only directly executable primitive actions remain. Unlike classical goal-state planning, it encodes domain knowledge as task decompositions, yielding efficient, human-interpretable plans. HTN planning is widely used in robotics, game AI, and workflow automation."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games,
        ngm:task-planning ;
    vc:slug "htn-planning" ;
    vc:sourceDomain "ai" .

ngm:http2 a owl:Class ;
    rdfs:label "Http2"@en ;
    rdfs:comment "HTTP/2 is a major revision of the Hypertext Transfer Protocol that introduces a binary framing layer, multiplexed streams over a single TCP connection, header compression and server push. It reduces latency and head-of-line blocking at the application layer compared with HTTP/1.1 while preserving the protocol's semantics. It is standardised in RFC 7540 (later RFC 9113) and is widely deployed across the modern web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        ngm:http ;
    vc:contrastsWith ngm:quic,
        ngm:websocket ;
    vc:dependsOn ngm:tls-handshake,
        ngm:transport-layer ;
    vc:enables ngm:latency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:network-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:application-layer,
        ngm:http,
        ngm:rest ;
    vc:requires ngm:tcp,
        ngm:tls ;
    vc:slug "http2" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:network-protocol ;
    vc:uses ngm:multiplexing,
        ngm:server-push,
        ngm:transport-layer .

ngm:hugging-face-accelerate a owl:Class ;
    rdfs:label "Hugging Face Accelerate"@en ;
    rdfs:comment "Hugging Face Accelerate is an open-source Python library that lets PyTorch training code run unchanged across CPUs, single or multiple GPUs, and TPUs by abstracting device placement and distributed launch. It handles mixed precision, gradient accumulation, and sharded data/model parallelism with minimal boilerplate. Accelerate lowers the barrier to scaling deep-learning training and inference across hardware configurations."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-speed,
        ngm:fast-ai ;
    vc:slug "hugging-face-accelerate" ;
    vc:sourceDomain "ai" .

ngm:hugging-face-model-hub a owl:Class ;
    rdfs:label "Hugging Face Model Hub"@en ;
    rdfs:comment "The Hugging Face Model Hub is a public repository and platform for sharing, discovering, and versioning machine-learning models, datasets, and demo spaces. Built on Git and Git-LFS, it hosts hundreds of thousands of pretrained models with standardised model cards, metadata, and direct integration into the Transformers ecosystem. It functions as the central distribution layer for open machine-learning artefacts."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fooocus,
        ngm:safetensors ;
    vc:slug "hugging-face-model-hub" ;
    vc:sourceDomain "ai" .

ngm:human-centred-design a owl:Class ;
    rdfs:label "Human Centred Design"@en ;
    rdfs:comment "Human centred design is a problem-solving approach that places the needs, capabilities and behaviours of people at the centre of the design process, iteratively shaping products and systems around real user contexts. It draws on empirical understanding of users and tasks, involves stakeholders throughout development, and refines solutions through repeated evaluation. The practice underpins usable, accessible and inclusive interactive systems across digital and physical domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-computer-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interaction-design ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:ergonomics ;
    vc:contrastsWith ngm:universal-design ;
    vc:enables ngm:accessibility,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interaction-design,
        ngm:usability ;
    vc:implements ngm:design-thinking,
        ngm:user-centered-design ;
    vc:isPartOf ngm:user-experience-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accessibility-standards,
        ngm:prototyping,
        ngm:user-interface-design ;
    vc:requires ngm:human-computer-interaction ;
    vc:slug "human-centred-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:inclusive-design ;
    vc:uses ngm:user-experience-design .

ngm:human-centred-values a owl:Class ;
    rdfs:label "Human Centred Values"@en ;
    rdfs:comment "AI systems should be designed and operated in ways that respect the rule of law, human rights, democratic values and diversity, with appropriate safeguards to ensure human determination and control over consequential decisions (human agency), whilst incorporating mechanisms to protect fairness an..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:ai-risk ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:fairness,
        ngm:value-alignment ;
    vc:requires ngm:accountability,
        ngm:human-oversight ;
    vc:slug "human-centred-values" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ai-governance,
        ngm:trustworthy-ai .

ngm:human-computer-interface a owl:Class ;
    rdfs:label "Human Computer Interface"@en ;
    rdfs:comment "The set of hardware and software components through which a human user perceives, commands, and receives feedback from a computing system. In spatial computing, human computer interfaces extend beyond screens and keyboards to include gesture input, voice commands, gaze control, haptic feedback, and brain-computer interfaces, fundamentally shaping how users navigate and manipulate virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hand-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-user-interface,
        ngm:brain-computer-interfaces ;
    vc:slug "human-computer-interface" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:spatial-tracking-technology .

ngm:hybrid-search a owl:Class ;
    rdfs:label "Hybrid Search"@en ;
    rdfs:comment "Hybrid search is an information retrieval approach that combines sparse lexical retrieval — typically BM25 or TF-IDF — with dense vector search over neural embeddings, fusing their complementary strengths: precise keyword matching and semantic understanding respectively. Score fusion via Reciprocal Rank Fusion or learned weighting combines ranked lists from both systems. The combination consistently outperforms either method alone across diverse query types, and has become the dominant retrieval pattern underpinning Retrieval-Augmented Generation pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dense-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:data ;
    vc:contrastsWith ngm:keyword-search,
        ngm:pure-vector-search ;
    vc:dependsOn ngm:deep-learning,
        ngm:transformer ;
    vc:enables ngm:cross-encoder-reranking,
        ngm:enterprise-search,
        ngm:question-answering,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dense-retrieval,
        ngm:rank-fusion,
        ngm:sparse-retrieval ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:colbert,
        ngm:natural-language-processing,
        ngm:neural-network,
        ngm:retrieval-augmented-generation-rag ;
    vc:requires ngm:text-encoder,
        ngm:vector-database ;
    vc:slug "hybrid-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bm25,
        ngm:inverted-index,
        ngm:nearest-neighbor-search,
        ngm:reciprocal-rank-fusion,
        ngm:semantic-search,
        ngm:vector-embedding .

ngm:hyperautomation a owl:Class ;
    rdfs:label "Hyperautomation"@en ;
    rdfs:comment "Hyperautomation is a disciplined approach to automating as many business and IT processes as possible by orchestrating a coordinated set of technologies including robotic process automation, machine learning, process mining and low-code platforms. Rather than automating tasks in isolation, it discovers, designs and integrates end-to-end automated workflows with intelligence layered in. The goal is scalable, adaptive automation that augments human work across the enterprise."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:low-code-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:process-mining ],
        ngm:intelligent-automation ;
    vc:bridgesTo ngm:workflow-automation ;
    vc:contrastsWith ngm:robotic-process-automation ;
    vc:dependsOn ngm:orchestration ;
    vc:enables ngm:digital-transformation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:low-code-platform,
        ngm:workflow-automation ;
    vc:implements ngm:business-process-automation ;
    vc:isPartOf ngm:intelligent-automation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:business-process-automation,
        ngm:orchestration ;
    vc:requires ngm:process-mining ;
    vc:slug "hyperautomation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:digital-transformation ;
    vc:uses ngm:machine-learning,
        ngm:process-mining,
        ngm:robotic-process-automation .

ngm:iec-61131-3 a owl:Class ;
    rdfs:label "IEC 61131-3"@en ;
    rdfs:comment "IEC 61131-3 is the third part of the IEC 61131 international standard for programmable logic controllers, defining the syntax and semantics of five programming languages used in industrial automation: Ladder Diagram (LD), Function Block Diagram (FBD), Structured Text (ST), Instruction List (IL), and Sequential Function Chart (SFC). The standard provides a common programming model across PLC vendors, enabling portability of control logic and reducing the effort required to maintain industrial systems. It is the primary reference for software engineering practice in the industrial automation domain and forms the basis of IEC 61131-3-compliant toolchains and runtime environments used in manufacturing, process control, and infrastructure systems."@en ;
    rdfs:subClassOf ngm:iso-iec ;
    vc:enables ngm:automated-compliance,
        ngm:planning-and-scheduling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:industrial-automation,
        ngm:safety-plc ;
    vc:slug "iec-61131-3" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-27001 ;
    vc:supports ngm:industrial-robot,
        ngm:sheffield-advanced-manufacturing .

ngm:ieee-802-3 a owl:Class ;
    rdfs:label "IEEE 802.3"@en ;
    rdfs:comment "An IEEE standard defining Ethernet, including the physical layer and media access control for wired local area networks. It covers a range of speeds and media types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ieee ;
    vc:slug "ieee-802-3" ;
    vc:sourceDomain "standards" .

ngm:ieee-standards-association a owl:Class ;
    rdfs:label "IEEE Standards Association"@en ;
    rdfs:comment "The IEEE Standards Association (IEEE SA) is the standards development arm of the Institute of Electrical and Electronics Engineers, operating a consensus-based process through which industry, government, and academic stakeholders collaboratively develop and maintain technical standards covering electrical, electronic, computing, and communications technologies, with over 1,400 active standards and more than 900 standards under active development at any time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-control-systems-society ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-robotics-and-automation-society ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-802-x ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:working-group ],
        ngm:standards-body ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:infrastructure,
        ngm:robotics ;
    vc:enables ngm:interoperability-standard,
        ngm:technical-standards ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ieee-802-x,
        ngm:ieee-control-systems-society,
        ngm:ieee-robotics-and-automation-society ;
    vc:implements ngm:open-standards ;
    vc:isPartOf ngm:ieee ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:etsi,
        ngm:iec,
        ngm:iso,
        ngm:technical-standard,
        ngm:wi-fi ;
    vc:requires ngm:working-group ;
    vc:slug "ieee-standards-association" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:ai-ethics,
        ngm:autonomous-vehicle,
        ngm:cybersecurity,
        ngm:wireless-networking .

ngm:ietf-rfc a owl:Class ;
    rdfs:label "IETF RFC"@en ;
    rdfs:comment "An IETF RFC (Request for Comments) is a numbered document published by the Internet Engineering Task Force and the RFC Editor that records Internet specifications, protocols, procedures, and informational notes. Standards-track RFCs progress through community review to define the protocols that constitute the Internet, while other categories capture experimental, informational, or historic material. The RFC series is the canonical record through which Internet technology is standardised and disseminated."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:bridgesTo ngm:interoperability ;
    vc:contrastsWith ngm:iso,
        ngm:w3-c ;
    vc:enables ngm:internet-protocol ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:protocol-specification ;
    vc:isPartOf ngm:internet-standard ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-communication,
        ngm:tcp-ip ;
    vc:slug "ietf-rfc" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:interoperability,
        ngm:network-protocol ;
    vc:uses ngm:request-for-comments .

ngm:immutable-record a owl:Class ;
    rdfs:label "Immutable Record"@en ;
    rdfs:comment "An immutable record is a data entry that, once written, cannot be altered or deleted without cryptographic or consensus-based detection of tampering. Immutability is enforced through hash chaining, Merkle trees, distributed ledger consensus mechanisms, or append-only data structures, making immutable records foundational to audit trails, provenance tracking, and trustworthy data archiving."@en ;
    rdfs:subClassOf ngm:distributed-ledger ;
    vc:enables ngm:audit-log,
        ngm:data-provenance,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-integrity,
        ngm:trusted-timestamping ;
    vc:slug "immutable-record" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-ledger,
        ngm:cryptographic-signature,
        ngm:merkle-tree .

ngm:implicit-neural-representation a owl:Class ;
    rdfs:label "Implicit Neural Representation"@en ;
    rdfs:comment "An Implicit Neural Representation (INR) is a method of encoding continuous signals—such as 3D shapes, scenes, or images—as the weights of a neural network rather than as discrete grids or meshes. The network acts as a function that maps spatial or temporal coordinates to signal values, enabling theoretically infinite resolution. INRs are widely used in novel-view synthesis, shape reconstruction, and physics simulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        ngm:machine-learning ;
    vc:contrastsWith ngm:point-cloud,
        ngm:voxel-grid ;
    vc:dependsOn ngm:coordinate-based-network,
        ngm:neural-network ;
    vc:enables ngm:3d-reconstruction,
        ngm:novel-view-synthesis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:3d-gaussian-splatting,
        ngm:neural-radiance-field,
        ngm:signed-distance-function ;
    vc:requires ngm:differentiable-rendering,
        ngm:positional-encoding ;
    vc:slug "implicit-neural-representation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:3d-content-generation,
        ngm:spatial-computing ;
    vc:uses ngm:gradient-descent,
        ngm:multilayer-perceptron .

ngm:incentive-structures a owl:Class ;
    rdfs:label "Incentive Structures"@en ;
    rdfs:comment "Incentive structures are the systems of rewards and penalties that shape the behaviour of agents within an economic or protocol system, aligning individual self-interest with desired collective outcomes. In decentralised systems they encode rewards such as block subsidies, fees, and staking yields, alongside slashing or penalties, to make honest participation the rational choice. Well-designed incentive structures are central to mechanism design and the security of token economies."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-theory ;
    vc:slug "incentive-structures" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:economics .

ngm:inclusive-participation a owl:Class ;
    rdfs:label "Inclusive Participation"@en ;
    rdfs:comment "Inclusive participation is the design principle and operational practice of structuring technologies, platforms, and governance processes to enable full and meaningful engagement by individuals of diverse abilities, economic circumstances, cultural backgrounds, and technical literacy levels, removing barriers that would otherwise exclude underrepresented or marginalised populations. In technology contexts, inclusive participation encompasses accessible user interface design, multilingual support, low-bandwidth alternatives, assistive technology compatibility, and governance mechanisms that distribute decision-making power beyond technically or economically privileged groups. It is a cross-cutting concern in XR platform design, DAO governance, metaverse standards development, and public goods infrastructure."@en ;
    rdfs:subClassOf ngm:participation-framework ;
    vc:enables ngm:community-governance,
        ngm:digital-technology-access-equity,
        ngm:inclusive-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diversity-non-discrimination-and-fairness,
        ngm:governance-framework,
        ngm:social-impact,
        ngm:xr-accessibility-standards ;
    vc:slug "inclusive-participation" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:accessibility,
        ngm:localization,
        ngm:universal-design .

ngm:inductive-bias a owl:Class ;
    rdfs:label "Inductive Bias"@en ;
    rdfs:comment "Inductive bias is the set of assumptions a learning algorithm uses to generalise from finite training data to unseen inputs. Because infinitely many functions fit any finite sample, a learner must prefer some hypotheses over others, and that preference — encoded in model architecture, regularisation, priors, or the choice of hypothesis space — is its inductive bias. Appropriate inductive bias is what lets a model extrapolate sensibly rather than merely memorise."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-architecture ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:no-free-lunch-theorem ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:model-architecture,
        ngm:regularisation ;
    vc:enables ngm:generalisation,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:deep-learning,
        ngm:generalisation,
        ngm:hypothesis-space ;
    vc:requires ngm:hypothesis-space,
        ngm:model-architecture ;
    vc:slug "inductive-bias" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:neural-network ;
    vc:uses ngm:bias-variance-tradeoff,
        ngm:regularisation .

ngm:industrial-symbiosis a owl:Class ;
    rdfs:label "Industrial Symbiosis"@en ;
    rdfs:comment "Industrial symbiosis is a collaborative approach within industrial ecology in which geographically proximate companies exchange materials, energy, water, and by-products to achieve collective environmental and economic benefits that are unattainable individually. By treating the waste or surplus of one facility as a resource input for another, industrial symbiosis operationalises circular economy principles at an industrial park or regional scale."@en ;
    rdfs:subClassOf ngm:circular-economy ;
    vc:enables ngm:resource-efficiency,
        ngm:waste-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:e-waste,
        ngm:sustainability ;
    vc:slug "industrial-symbiosis" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:life-cycle-assessment,
        ngm:material-flow-analysis .

ngm:inertia-tensor a owl:Class ;
    rdfs:label "Inertia Tensor"@en ;
    rdfs:comment "The inertia tensor is a 3x3 symmetric matrix that characterises how a rigid body's mass is distributed about a reference point, relating the body's angular velocity to its angular momentum. Its diagonal entries are the moments of inertia about the coordinate axes and its off-diagonal entries are the products of inertia. It is a foundational quantity in rigid-body dynamics, enabling computation of rotational acceleration under applied torques."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body ],
        ngm:robot-dynamics ;
    vc:bridgesTo ngm:robotics ;
    vc:contrastsWith ngm:kinematics ;
    vc:dependsOn ngm:manipulator ;
    vc:enables ngm:dynamics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:rigid-body-dynamics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:robot-dynamics ;
    vc:requires ngm:rigid-body ;
    vc:slug "inertia-tensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:control-theory,
        ngm:physics-simulation,
        ngm:simulation ;
    vc:uses ngm:torque,
        ngm:velocity .

ngm:informed-decision-making a owl:Class ;
    rdfs:label "Informed decision-making"@en ;
    rdfs:comment "Informed decision-making is a cognitive and organisational process in which choices are grounded in accurate, relevant, and timely evidence rather than intuition, habit, or incomplete information. It encompasses the collection, analysis, and interpretation of data, the surfacing of relevant context through knowledge management systems, and the mitigation of cognitive biases that distort judgement. In digital and AI-augmented environments, informed decision-making is increasingly supported by decision support tools, predictive analytics, and transparent reasoning systems that make the basis of recommendations auditable."@en ;
    rdfs:subClassOf ngm:decision-support ;
    vc:enables ngm:distributed-decision-making,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-analytics,
        ngm:knowledge-management,
        ngm:transparent-decision-making ;
    vc:slug "informed-decision-making" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:transparency ;
    vc:uses ngm:knowledge-graph,
        ngm:predictive-analytics .

ngm:infrared-led-illuminator a owl:Class ;
    rdfs:label "Infrared Led Illuminator"@en ;
    rdfs:comment "LED-based infrared light sources integrated into or used alongside VR/AR headsets to provide illumination for tracking systems, featuring compact form factors, low power consumption, and wavelengths optimised for camera sensor detection."@en ;
    rdfs:subClassOf ngm:infrared-illuminator,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:hand-tracking-enhancement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-led-illuminator" ;
    vc:sourceDomain "spatial-computing" .

ngm:initialization-vector a owl:Class ;
    rdfs:label "Initialization Vector"@en ;
    rdfs:comment "An initialization vector (IV) is a fixed-size input to a symmetric encryption mode of operation that randomises the encryption process so that identical plaintexts produce different ciphertexts under the same key. By introducing fresh, unpredictable variation for each message, it prevents an attacker from detecting repetition and defeats certain chosen-plaintext attacks. Depending on the mode, an IV must be unpredictable, unique, or both, and is typically transmitted in the clear alongside the ciphertext because its secrecy is not required, only its non-repetition. Misusing an IV, such as reusing it, can catastrophically undermine the security of an otherwise sound cipher."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        ngm:symmetric-encryption ;
    vc:contrastsWith ngm:nonce,
        ngm:salt ;
    vc:dependsOn ngm:entropy ;
    vc:enables ngm:data-integrity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:nonce ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:encryption,
        ngm:message-authentication-code ;
    vc:requires ngm:entropy ;
    vc:slug "initialization-vector" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:encryption,
        ngm:symmetric-encryption ;
    vc:uses ngm:cryptographic-key .

ngm:inscription a owl:Class ;
    rdfs:label "Inscription"@en ;
    rdfs:comment "An inscription is arbitrary data, such as an image, text or document, written directly onto an individual satoshi on the Bitcoin blockchain so that the content is stored entirely on-chain. Enabled by the Taproot upgrade and the Ordinals numbering scheme, inscriptions embed their payload in the witness portion of a transaction, making each inscribed satoshi a verifiable, transferable digital artefact. They underpin Bitcoin-native non-fungible assets and digital collectibles without relying on external metadata storage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:ordinals ;
    vc:dependsOn ngm:bitcoin ;
    vc:enables ngm:digital-art,
        ngm:non-fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-asset,
        ngm:metadata ;
    vc:isPartOf ngm:ordinals ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-art,
        ngm:nft,
        ngm:utility-token ;
    vc:requires ngm:blockchain,
        ngm:satoshi ;
    vc:slug "inscription" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:nft-marketplace,
        ngm:provenance ;
    vc:uses ngm:bitcoin,
        ngm:data-storage,
        ngm:taproot .

ngm:inside-out-tracking a owl:Class ;
    rdfs:label "Inside Out Tracking"@en ;
    rdfs:comment "Inside-out tracking is a positional-tracking method in which cameras and sensors mounted on a head-mounted display observe the surrounding environment to determine the device's own pose in space. It requires no external base stations, computing six-degrees-of-freedom position and orientation from features detected in the scene. The approach underpins standalone virtual and mixed reality headsets by enabling self-contained spatial tracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:visual-inertial-odometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:six-degrees-of-freedom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:positional-tracking ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:dependsOn ngm:head-mounted-display ;
    vc:enables ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:camera,
        ngm:visual-inertial-odometry ;
    vc:implements ngm:motion-tracking ;
    vc:isPartOf ngm:tracking-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality ;
    vc:requires ngm:sensor-fusion,
        ngm:six-degrees-of-freedom ;
    vc:slug "inside-out-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-mapping ;
    vc:uses ngm:computer-vision,
        ngm:slam .

ngm:inspection-robot a owl:Class ;
    rdfs:label "Inspection Robot"@en ;
    rdfs:comment "A specialised robotic system designed to autonomously examine physical structures, components, or manufactured products for defects, faults, or deviations from specification. Inspection robots combine computer vision, sensor fusion, and AI-driven anomaly detection to replace or augment manual quality-assurance processes in hazardous or high-throughput environments."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:collaborative-systems-modality-robot,
        ngm:mobile-robot ;
    vc:slug "inspection-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:sensor-fusion .

ngm:instant-settlement a owl:Class ;
    rdfs:label "Instant Settlement"@en ;
    rdfs:comment "Instant settlement is the near-immediate, final transfer of value between parties, eliminating the multi-day clearing and settlement delays of traditional banking and card networks. In blockchain and payment-channel systems it is achieved through cryptographic finality or off-chain channel updates that make funds usable within seconds. It reduces counterparty and credit risk, frees up working capital, and is a defining property of digital money."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-lightning-network,
        ngm:digital-money ;
    vc:slug "instant-settlement" ;
    vc:sourceDomain "blockchain" .

ngm:institutional-investment a owl:Class ;
    rdfs:label "Institutional Investment"@en ;
    rdfs:comment "The investment of pooled funds by organisations such as pension funds, insurers, endowments and asset managers on behalf of their beneficiaries or clients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-management ],
