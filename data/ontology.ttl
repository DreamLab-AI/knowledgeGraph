        ngm:edge-computing ;
    vc:uses ngm:hot-aisle-cold-aisle-containment,
        ngm:power-usage-effectiveness,
        ngm:virtualisation .

ngm:data-collection a owl:Class ;
    rdfs:label "Data Collection"@en ;
    rdfs:comment "Data collection is the systematic process of gathering raw observations, measurements, or records from primary sources — including sensors, user interactions, instruments, surveys, and web scraping — in a form suitable for storage, processing, and analysis. As a foundational stage of the data lifecycle, it determines the completeness, representativeness, and quality of all downstream analytical products. In machine learning contexts, data collection encompasses sourcing, labelling, and curating training datasets that govern model capability and bias characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:io-t-sensor-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-annotation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:data-management ;
    vc:bridgesTo ngm:edge-computing,
        ngm:federated-learning ;
    vc:contrastsWith ngm:synthetic-data ;
    vc:dependsOn ngm:data-governance,
        ngm:data-privacy,
        ngm:etl-pipeline ;
    vc:enables ngm:data-analysis,
        ngm:data-pipeline,
        ngm:data-processing,
        ngm:machine-learning,
        ngm:training-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-annotation,
        ngm:data-labelling,
