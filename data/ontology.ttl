ngm:nist-ai-rmf a owl:Class ;
    rdfs:label "NIST AI RMF"@en ;
    rdfs:comment "The NIST AI Risk Management Framework (AI RMF) is a voluntary, technology-agnostic guidance document published by the National Institute of Standards and Technology in January 2023 that helps organisations identify, assess, and manage risks arising from the design, development, deployment, and operation of AI systems. It structures AI risk management practice through four core functions — Govern, Map, Measure, and Manage — forming a continuous lifecycle cycle applicable across sectors and organisational sizes. The framework explicitly promotes seven trustworthy-AI characteristics (accountable, explainable, fair, privacy-enhanced, reliable, resilient, and secure) as unifying goals, and is supported by a companion Playbook and a growing library of sector-specific profiles, including one for generative AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:ai-risk,
        ngm:machine-learning-operations,
        ngm:responsible-ai ;
    vc:contrastsWith ngm:eu-ai-act-regulatory-instrument,
        ngm:iso-42001 ;
    vc:enables ngm:accountability,
        ngm:ai-governance-maturity-model,
        ngm:ai-risk-management,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-impact-assessment,
        ngm:cybersecurity-framework,
        ngm:risk-management ;
    vc:requires ngm:risk-assessment,
        ngm:stakeholder-engagement ;
    vc:slug "nist-ai-rmf" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:ai-safety,
        ngm:explainability,
        ngm:fairness,
        ngm:privacy,
        ngm:reliability,
        ngm:transparency .

ngm:payment-channel a owl:Class ;
    rdfs:label "Payment Channel"@en ;
    rdfs:comment "A payment channel is a cryptographic construct that allows two or more parties to conduct multiple off-chain transactions by exchanging signed commitment messages, with only the channel-opening and channel-closing states recorded on a base-layer blockchain. Channels are secured by multisignature scripts, time-locked contracts, and mutual revocation mechanisms that ensure neither party can unilaterally broadcast a superseded state without penalty. By batching an unbounded number of value transfers into two on-chain transactions, payment channels achieve high throughput and negligible per-payment fees while inheriting the settlement finality and trustlessness of the underlying blockchain. They form the foundational primitive of routed payment networks such as the Lightning Network and of generalised state-channel protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:revocation-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multisignature ],
        ngm:off-chain-scaling ;
    vc:bridgesTo ngm:machine-economy ;
    vc:contrastsWith ngm:on-chain-transaction,
        ngm:rollup ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:on-chain-settlement ;
    vc:enables ngm:micropayment,
        ngm:payment-routing,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:revocation-mechanism ;
    vc:implements ngm:off-chain-scaling ;
    vc:isPartOf ngm:layer-2-solutions,
        ngm:lightning-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:channel-factory,
        ngm:settlement,
        ngm:state-channel ;
    vc:requires ngm:blockchain,
        ngm:digital-signature,
        ngm:multisignature ;
    vc:slug "payment-channel" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:peer-to-peer-network ;
    vc:uses ngm:hash-time-locked-contract,
        ngm:smart-contract,
        ngm:timelock .

ngm:agentic-ai a owl:Class ;
    rdfs:label "Agentic AI"@en ;
    rdfs:comment "Agentic AI refers to AI systems characterised by autonomy, goal-directedness, and the capacity to take sustained sequences of actions — including calling external tools, spawning sub-agents, and modifying their own environment — in pursuit of high-level objectives specified by a user or orchestrator. Agentic systems differ from reactive or conversational AI in that they operate over extended time horizons, maintain persistent state across steps, and may take consequential or irreversible actions without per-step human approval. The architectural backbone is typically a large language model serving as a cognitive core inside a closed sense-plan-act loop, augmented by memory stores, tool registries, and inter-agent communication protocols. The term encompasses both single-agent pipelines and heterogeneous multi-agent architectures in which agentic components collaborate, compete, or are hierarchically orchestrated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-orchestrator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-runtime ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:agent-based-modelling,
        ngm:digital-twin,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:conversational-ai,
        ngm:reactive-system ;
    vc:dependsOn ngm:foundation-model,
        ngm:retrieval-augmented-generation,
        ngm:vector-database ;
    vc:enables ngm:agentic-rag,
        ngm:autonomous-agent,
        ngm:multi-agent-system,
        ngm:software-development-automation,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent-loop,
        ngm:agent-orchestrator,
        ngm:agent-runtime,
