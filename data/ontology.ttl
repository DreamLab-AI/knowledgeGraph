        ngm:risk-management ;
    vc:requires ngm:risk-management,
        ngm:threat-intelligence ;
    vc:slug "cyber-resilience" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:security-operations ;
    vc:uses ngm:defense-in-depth,
        ngm:intrusion-detection,
        ngm:zero-trust-architecture .

