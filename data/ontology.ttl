ngm:agent-layer a owl:Class ;
    rdfs:comment "The Agent Layer is the stratum that hosts autonomous entities capable of perceiving, deciding, and acting toward goals. It sits above control and inference strata that supply its capabilities and below coordination and application strata that direct collectives of agents. It contains agent policies, goal representations, memory, and decision loops."@en ;
    rdfs:label "Agent Layer"@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    rdfs:subClassOf ngm:owl-thing ;
    rdfs:subClassOf _:r1343 ;
