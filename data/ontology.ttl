    rdfs:label "Zero Trust"@en .

ngm:zigbee2-mqtt a owl:Class ;
    rdfs:label "Zigbee2MQTT"@en ;
    rdfs:comment "Zigbee2MQTT is an open-source bridge that connects Zigbee smart-home devices to MQTT, allowing them to be controlled independently of any proprietary vendor hub or cloud. Using an inexpensive Zigbee coordinator radio, it translates device messages into MQTT topics with a large database of supported devices. It matters as a vendor-neutral, locally controlled integration path for Zigbee hardware into platforms like Home Assistant."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "zigbee2-mqtt" ;
    vc:sourceDomain "infrastructure" .

