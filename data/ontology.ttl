ngm:anti-counterfeiting a owl:Class ;
    rdfs:label "Anti Counterfeiting"@en ;
    rdfs:comment "Blockchain-based systems employing cryptographic verification, immutable ledgers, and physical-digital integration technologies (NFC tags, QR codes, RFID) to authenticate products, prevent counterfeiting, and establish verifiable supply chain provenance across pharmaceuticals, luxury goods, electronics, and consumer products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supply-chain-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pharmaceutical-traceability ],
        ngm:bc-network-component,
        ngm:supply-chain-blockchain ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:luxury-goods-authentication,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:pharmaceutical-traceability,
        ngm:supply-chain-management ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "anti-counterfeiting" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:blockchain-compliance ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

