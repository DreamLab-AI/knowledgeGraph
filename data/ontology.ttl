ngm:high-energy-consumption a owl:Class ;
    rdfs:label "High Energy Consumption"@en ;
    rdfs:comment "High Energy Consumption characterises Proof-of-Work blockchain networks that secure the ledger through computationally intensive mining, requiring significant and ongoing electricity expenditure proportional to network hash rate. This property creates environmental concerns, drives carbon footprint assessments, and motivates regulatory scrutiny of PoW chains, contrasting sharply with the energy profile of stake-based consensus alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        ngm:bc-governance-and-regulation,
        ngm:blockchain-energy-consumption ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:low-energy-consumption,
        ngm:proof-of-stake,
        ngm:proof-of-stake-sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mining-pool,
        ngm:mining-reward ;
    vc:qualityScore "0.0"^^xsd:float ;
