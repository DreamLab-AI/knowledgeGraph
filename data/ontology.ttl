ngm:policy-enforcement-point a owl:Class ;
    rdfs:label "Policy Enforcement Point"@en ;
    rdfs:comment "A Policy Enforcement Point (PEP) is an architectural component in access control systems that intercepts resource access requests, forwards them to a Policy Decision Point (PDP) for authorisation evaluation, and then enforces the resulting permit or deny decision. The PEP–PDP separation—defined in the XACML standard and central to attribute-based access control (ABAC) architectures—decouples policy logic from enforcement infrastructure, enabling centralised policy management and consistent enforcement across heterogeneous systems. In zero-trust architectures, every network transaction passes through a PEP, which may be implemented as a reverse proxy, API gateway, service mesh sidecar, or network firewall. The model extends naturally to identity-aware proxies, software-defined perimeters, and AI governance enforcement layers."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:enables ngm:privileged-access-management,
        ngm:zero-trust-architecture-zta ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control-system,
        ngm:identity-and-access-management,
        ngm:policy-enforcement,
        ngm:zero-trust-architecture ;
    vc:slug "policy-enforcement-point" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:api-gateway,
        ngm:oauth-2-0 .

ngm:quality-of-service a owl:Class ;
    rdfs:label "Quality Of Service"@en ;
    rdfs:comment "A set of network management techniques and policies that prioritise, control, and guarantee specified performance characteristics—including latency, jitter, bandwidth, and packet loss—for different traffic classes. In metaverse and real-time XR applications, QoS mechanisms are critical for maintaining acceptable user experience under variable network load."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:real-time,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:latency ;
    vc:requires ngm:network-infrastructure,
        ngm:network-protocol ;
    vc:slug "quality-of-service" ;
    vc:sourceDomain "infrastructure" .

ngm:raft-consensus a owl:Class ;
    rdfs:label "RAFT Consensus"@en ;
    rdfs:comment "Raft is a distributed consensus algorithm designed as a more understandable alternative to Paxos, decomposing consensus into three relatively independent sub-problems: leader election, log replication, and safety. A Raft cluster elects a single leader by majority vote during which followers grant a term-limited mandate; the leader receives all client writes, appends them to its log, and replicates them to followers, committing entries once a quorum acknowledges receipt. Raft guarantees that committed entries are never lost as long as a majority of nodes remain connected, providing crash fault tolerance but not Byzantine fault tolerance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:fault-tolerance,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger ;
    vc:requires ngm:consensus-algorithm,
        ngm:distributed-system ;
    vc:slug "raft-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:rb-0056-impedance-control a owl:Class ;
    rdfs:label "rb 0056 impedance control"@en ;
    rdfs:comment "Impedance control is a robot interaction-control strategy that regulates the dynamic relationship between end-effector force and motion by imposing a desired mechanical impedance (mass, damping, stiffness) on the robot's behaviour at the point of contact. Rather than commanding precise positions or forces independently, impedance control allows compliant, safe physical interaction with humans or uncertain environments by shaping the robot's apparent mechanical response. It is fundamental to collaborative robotics, enabling robots to yield to external forces in a controlled manner without requiring an explicit force setpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        ngm:interaction-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0053-force-control,
        ngm:rb-0057-admittance-control ;
    vc:requires ngm:rb-0067-force-torque-sensor,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0056-impedance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0007-collaborative-robot,
        ngm:rb-0094-power-and-force-limiting .

