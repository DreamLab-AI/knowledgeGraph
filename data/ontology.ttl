        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-framework ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:community-governance,
        ngm:decentralized-governance,
        ngm:platform-governance,
        ngm:self-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability-mechanism,
        ngm:ai-governance-framework,
        ngm:decision-structure,
        ngm:ethical-framework,
