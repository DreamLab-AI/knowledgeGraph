ngm:conditional-payment a owl:Class ;
    rdfs:label "Conditional Payment"@en ;
    rdfs:comment "A conditional payment is a transfer of value that is released only when one or more predefined conditions are met, rather than executing unconditionally on submission. On blockchains these conditions are enforced by smart contracts or scripts such as hash and time locks, removing the need for a trusted intermediary to adjudicate. Conditional payments are the foundation of escrow, payment channels and atomic cross-chain swaps."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        ngm:smart-contract ;
    vc:contrastsWith ngm:micropayment ;
    vc:enables ngm:atomic-swap,
        ngm:micropayment,
        ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:hash-time-locked-contract,
        ngm:trustless-execution ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:trustless-execution ;
    vc:requires ngm:oracle,
        ngm:timelock ;
    vc:slug "conditional-payment" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:lightning-network ;
    vc:uses ngm:smart-contract,
        ngm:state-channel .

