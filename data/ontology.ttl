ngm:business-process-automation a owl:Class ;
    rdfs:label "Business Process Automation"@en ;
    rdfs:comment "The use of technology to automate complex, multi-step business processes beyond individual tasks, integrating systems and people to streamline operations. It targets end-to-end workflows rather than isolated actions."@en ;
