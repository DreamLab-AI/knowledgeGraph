ngm:creative-ai a owl:Class ;
    rdfs:label "Creative AI"@en ;
    rdfs:comment "Creative AI refers to artificial intelligence systems designed to generate, augment, or evaluate creative artefacts including images, music, text, video, and interactive experiences. Drawing on generative models such as diffusion models, large language models, and generative adversarial networks, these systems can produce novel content that mimics or extends human creative practice. They are increasingly deployed in professional creative pipelines, raising concurrent questions about authorship, copyright, and the economic displacement of human creators. Creative AI represents a convergence of machine learning research and aesthetic domains traditionally reserved for human agency."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:enables ngm:content-creation,
        ngm:digital-content-creation,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-art-categorization,
        ngm:creative-media-domain,
        ngm:creative-software ;
    vc:slug "creative-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:large-language-models .

ngm:credential-issuance a owl:Class ;
    rdfs:label "Credential Issuance"@en ;
    rdfs:comment "Credential issuance is the process by which an authoritative entity — an issuer — creates, signs, and delivers a structured attestation about a subject's attributes, qualifications, or identity to that subject or to a designated holder. In the W3C Verifiable Credentials model, issuance involves binding claims to a subject's decentralised identifier using the issuer's cryptographic key, producing a tamper-evident credential that the holder can present to verifiers without returning to the issuer. The issuance process encompasses schema selection, claim population, signature generation, and delivery, and may be implemented with varying degrees of issuer privacy, holder binding strength, and revocability."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:enables ngm:credential-verification,
        ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:digital-identity ;
    vc:slug "credential-issuance" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:credential-schema,
        ngm:cryptographic-signature,
        ngm:decentralized-identifiers,
        ngm:verifiable-credentials .

ngm:cross-chain-governance a owl:Class ;
    rdfs:label "Cross-Chain Governance"@en ;
    rdfs:comment "Cross-Chain Governance is a coordination framework and set of protocols that enable governance proposals, voting outcomes, and policy updates to propagate and be enforced across multiple heterogeneous blockchain networks without requiring a single trusted intermediary. It extends on-chain governance mechanisms — token-weighted voting, quadratic voting, time-locked execution — to multi-chain environments using interoperability layers such as IBC (Inter-Blockchain Communication), cross-chain message passing bridges, or relay networks. Achieving consistent governance state across chains requires solving distributed consensus problems whilst preserving each chain's sovereignty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-chain-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-interoperability ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:on-chain-governance ;
    vc:requires ngm:blockchain-interoperability,
        ngm:cross-chain-messaging ;
    vc:slug "cross-chain-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:smart-contract .

ngm:cryptocurrency-token a owl:Class ;
    rdfs:label "Cryptocurrency Token"@en ;
    rdfs:comment "A programmable digital asset implemented via smart contracts on a blockchain platform, categorised into utility tokens (access rights), security tokens (equity or debt instruments), governance tokens (protocol voting rights), and non-fungible tokens (NFTs, unique digital ownership). Token behaviour and interoperability are defined by standards such as ERC-20, ERC-721, and ERC-1155."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fungible-token,
