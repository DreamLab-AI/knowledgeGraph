ngm:multimodal-ai-architecture-learning a owl:Class ;
    rdfs:label "Multimodal Learning"@en ;
    rdfs:comment "Multimodal learning is a sub-field of machine learning concerned with building models that can process, align, and reason over data from two or more sensory modalities — such as text, images, audio, video, and structured data — within a unified representation space. Models trained multimodally acquire richer, grounded representations than unimodal counterparts by exploiting cross-modal correlations and complementarity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:representation-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-modal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:contrastive-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        ngm:ai-machine-learning ;
    vc:bridgesTo ngm:autonomous-driving-perception,
        ngm:embodied-ai,
        ngm:medical-imaging-ai ;
    vc:contrastsWith ngm:self-supervised-learning ;
    vc:enables ngm:text-to-image-generation,
        ngm:vision-language-action-models,
        ngm:visual-question-answering ;
