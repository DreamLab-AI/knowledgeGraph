ngm:global-localisation a owl:Class ;
    rdfs:label "Global Localisation"@en ;
    rdfs:comment "Global localisation is the problem of estimating a robot's pose within a known map without any prior knowledge of its starting position, often called the kidnapped-robot problem. Unlike pose tracking, it must resolve ambiguity across the entire map, typically by maintaining and refining multiple pose hypotheses from sensor observations. It is fundamental to robot navigation, autonomous vehicles, and recovery from localisation failures."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:particle-filter ;
    vc:slug "global-localisation" ;
    vc:sourceDomain "robotics" .

ngm:glsl a owl:Class ;
    rdfs:label "GLSL"@en ;
    rdfs:comment "GLSL (OpenGL Shading Language) is a high-level C-like programming language for writing shaders that execute on the GPU within the OpenGL and WebGL graphics pipelines. It lets developers program the programmable stages, principally vertex and fragment shaders, to control geometry transformation, lighting, and per-pixel colour. GLSL is a foundational tool for real-time rendering and visual effects."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "glsl" ;
    vc:sourceDomain "metaverse" .

ngm:gnosis-safe a owl:Class ;
    rdfs:label "Gnosis Safe"@en ;
    rdfs:comment "Gnosis Safe, later rebranded as Safe, is a smart-contract wallet for Ethereum and compatible networks that requires multiple signatures to authorise transactions. Rather than relying on a single private key, it enforces a configurable threshold, such as three of five owners, before funds move or contract calls execute. It is widely used by decentralised autonomous organisations, projects and individuals to manage treasuries and reduce the risk of a single compromised key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:blockchain-domain ;
    vc:enables ngm:multisignature-wallets,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:smart-contract ;
    vc:slug "gnosis-safe" ;
    vc:sourceDomain "gnosis-safe" .

ngm:google-gemini a owl:Class ;
    rdfs:label "Google Gemini"@en ;
    rdfs:comment "Google Gemini is a family of natively multimodal large language models developed by Google DeepMind, capable of reasoning across text, images, audio, video, and code. Released in tiers (such as Ultra, Pro, Flash, and Nano) it spans data-centre to on-device deployment and powers Google's assistant and developer APIs. It is a leading frontier model used for chat assistants, agents, and integrated productivity tools."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agentic-internet,
