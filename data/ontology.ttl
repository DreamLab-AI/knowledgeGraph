    vc:requires ngm:dao,
        ngm:dao-governance ;
    vc:slug "tele-252-dao-governance-telecollaboration" ;
    vc:sourceDomain "metaverse" .

ngm:temperature-sensor a owl:Class ;
    rdfs:label "Temperature Sensor"@en ;
    rdfs:comment "A temperature sensor is a transducer that converts thermal energy into an electrical signal, enabling robotic and autonomous systems to monitor ambient, surface, or internal temperatures. Common types include thermocouples, RTDs, and infrared sensors, each suited to different accuracy, range, and response-time requirements in industrial, healthcare, and field robotics."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robo-perception,
        ngm:robotic-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:sensor,
        ngm:sensor-data,
        ngm:sensor-fusion ;
    vc:slug "temperature-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:sensor-technology .

ngm:tensor-rt a owl:Class ;
    rdfs:label "TensorRT"@en ;
    rdfs:comment "TensorRT is NVIDIA's high-performance deep learning inference optimisation SDK that takes trained neural network models and compiles them into highly efficient inference engines tuned for specific NVIDIA GPU architectures. It performs a suite of graph-level and kernel-level optimisations including layer fusion, tensor fusion, kernel auto-tuning, precision calibration (FP32, FP16, INT8, FP8), and dynamic shape support to maximise throughput and minimise latency. Models from training frameworks are ingested primarily via the ONNX interchange format, then compiled offline into serialised engine files that are loaded at runtime. TensorRT underpins production AI inference across data-centre GPU clusters, autonomous vehicle compute stacks, and NVIDIA Jetson edge platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        ngm:inference-engine ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:robotics-inference ;
    vc:contrastsWith ngm:onnx-runtime,
        ngm:openvino,
        ngm:tensorflow-lite ;
    vc:dependsOn ngm:cuda-toolkit,
        ngm:deep-learning-framework ;
    vc:enables ngm:edge-inference,
        ngm:low-latency-serving,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:graph-optimisation,
        ngm:post-training-quantisation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:jetson,
        ngm:pytorch,
        ngm:tensorflow ;
    vc:requires ngm:cuda,
        ngm:hardware-acceleration,
        ngm:nvidia-gpu ;
    vc:slug "tensor-rt" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:autonomous-driving,
        ngm:model-deployment,
        ngm:triton-inference-server ;
    vc:uses ngm:kernel-fusion,
        ngm:mixed-precision-training,
        ngm:onnx,
        ngm:quantisation .

ngm:term-index a owl:Class ;
    rdfs:label "TERM INDEX"@en ;
    rdfs:comment "A Term Index is a comprehensive reference catalogue mapping domain terminology, identifiers, and conceptual relationships within ontologies, enabling discovery and navigation of complex knowledge spaces across metaverse, blockchain, and robotics ecosystems. Well-structured indices provide hierarchical classification, cross-references, and semantic linking that facilitate knowledge retrieval, API design, and knowledge-graph integration, serving both user-facing navigation and machine-readable specifications supporting automated reasoning and SPARQL query optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:domain-ontology ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:knowledge-graph,
        ngm:sparql ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:domain-ontology,
        ngm:ontology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:metaverse,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "term-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:third-party-vulnerability a owl:Class ;
    rdfs:label "Third-Party Vulnerability"@en ;
    rdfs:comment "A Third-Party Vulnerability is a security weakness originating in externally sourced software components, libraries, APIs, or services that are integrated into an AI system, creating risk vectors outside the direct control of the system developer or operator. Exploitation of these vulnerabilities can compromise model integrity, data confidentiality, or system availability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
