ngm:search-technology a owl:Class ;
    rdfs:label "Search Technology"@en ;
    rdfs:comment "Search technology encompasses the algorithms, indexing systems, and retrieval mechanisms that enable efficient discovery of relevant information across structured and unstructured data sources. Modern search systems combine inverted indices, vector embeddings, and machine learning ranking models to support keyword, semantic, and hybrid queries at scale."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:enterprise-search,
        ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "search-technology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedding-model,
        ngm:natural-language-processing .

ngm:secondary-market-integration a owl:Class ;
    rdfs:label "Secondary Market Integration"@en ;
    rdfs:comment "Technical and business infrastructure connecting primary asset creation with resale marketplaces, enabling liquidity for digital collectibles, virtual real estate, and NFTs through automated royalty distribution and cross-platform trading protocols."@en ;
    rdfs:subClassOf ngm:digital-asset-trading,
        ngm:sc-platform-and-environment ;
