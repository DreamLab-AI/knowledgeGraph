            owl:someValuesFrom ngm:anomaly-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavior-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioral-learning ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-agent,
        ngm:fraud-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
        ngm:behavior-analysis,
