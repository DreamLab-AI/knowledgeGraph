ngm:supply-chain-resilience a owl:Class ;
    rdfs:comment "Supply chain resilience is the capacity of a supply network to anticipate, absorb, adapt to, and recover from disruptions while maintaining the continuity of supply at acceptable cost and service levels. It combines visibility into the network, redundancy and flexibility in sourcing and capacity, and the ability to reconfigure flows when shocks occur. Resilience strategies balance efficiency against the buffers and diversification needed to withstand events such as supplier failure, natural disaster, or demand volatility."@en ;
    rdfs:label "Supply Chain Resilience"@en ;
    rdfs:subClassOf ngm:supply-chain ;
    rdfs:subClassOf _:r20216 ;
    rdfs:subClassOf _:r20217 ;
