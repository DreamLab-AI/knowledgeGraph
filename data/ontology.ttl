ngm:etsi-domain-virtual-economy a owl:Class ;
    rdfs:comment "ETSI domain encompassing economic systems, digital assets, and financial mechanisms enabling value exchange within metaverse and virtual environments through crypto tokens, cryptocurrencies, CBDCs, NFTs, and virtual assets. It coordinates decentralised exchanges, creator economy mechanisms, creator royalty tokens, carbon credit tokenisation, and standards development integrating virtual economies with traditional finance and regulatory compliance frameworks."@en ;
    rdfs:label "ETSI_Domain_Virtual_Economy"@en ;
