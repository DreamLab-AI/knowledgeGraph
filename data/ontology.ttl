        ngm:rdf ;
    vc:slug "classification-rules" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:knowledge-graph,
        ngm:logic-programming,
        ngm:ontology .

ngm:claude a owl:Class ;
    rdfs:label "Claude"@en ;
    rdfs:comment "Claude is a family of large language model AI assistants developed by Anthropic, trained using Constitutional AI and reinforcement learning from human feedback to be helpful, harmless, and honest. The Claude model family encompasses tiered variants (Haiku, Sonnet, and Opus) spanning cost-performance trade-offs, with support for extended context windows, multimodal inputs, tool use, and agentic workflows via the Model Context Protocol. Claude embodies Anthropic's research programme on aligning advanced AI systems with human values, serving as both a commercial API product and a living demonstration that safety and capability are complementary rather than opposed. The model family has evolved through multiple generations, with each iteration advancing state-of-the-art performance on reasoning, coding, and instruction-following benchmarks whilst maintaining rigorous safety evaluation."@en ;
    rdfs:subClassOf ngm:large-language-model ;
    vc:bridgesTo ngm:enterprise-software-integration,
        ngm:workflow-automation ;
    vc:contrastsWith ngm:gemini,
        ngm:gpt-4,
        ngm:llama ;
    vc:dependsOn ngm:human-feedback,
        ngm:pre-training ;
    vc:enables ngm:code-generation,
        ngm:conversational-ai,
        ngm:function-calling,
        ngm:multi-step-reasoning,
        ngm:retrieval-augmented-generation,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-model-card,
        ngm:model-context-protocol ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
