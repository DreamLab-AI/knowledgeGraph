ngm:distributed-governance a owl:Class ;
    rdfs:label "Distributed Governance"@en ;
    rdfs:comment "Distributed governance is a model of collective decision-making in which authority over a protocol, network or organisation is spread across many independent participants rather than held by a central body. In blockchain systems it is typically enacted through on-chain mechanisms such as token-weighted or quadratic voting, proposals and treasury control, allowing stakeholders to direct upgrades, parameters and resource allocation. It aims to align incentives, resist capture and make governance transparent and verifiable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:treasury-management ],
        ngm:decentralised-governance ;
    vc:bridgesTo ngm:dao,
        ngm:decentralised-governance ;
    vc:enables ngm:decentralized-autonomous-organization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:treasury-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance,
        ngm:self-regulation ;
    vc:requires ngm:consensus-mechanism,
        ngm:governance-token ;
    vc:slug "distributed-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:stakeholder,
        ngm:tokenomics ;
    vc:uses ngm:multisignature,
        ngm:quadratic-voting .

ngm:distributed-system-protocol a owl:Class ;
    rdfs:label "Distributed System Protocol"@en ;
    rdfs:comment "A Distributed System Protocol is a formal specification of rules, message formats, and coordination procedures that govern how autonomous nodes in a networked system communicate, synchronise state, and jointly accomplish tasks without centralised control. Such protocols address the fundamental challenges of partial failure, network partitioning, and asynchronous message delivery described by the CAP theorem, providing mechanisms for consensus, leader election, gossip dissemination, and fault recovery. They underpin peer-to-peer networks, blockchain infrastructures, distributed databases, and large-scale cloud orchestration systems. Correctness properties — safety, liveness, and eventual consistency — are formally analysed and proven against adversarial models such as Byzantine fault tolerance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        ngm:protocol-layer ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning,
        ngm:inter-blockchain-communication ;
    vc:contrastsWith ngm:centralised-system,
        ngm:client-server-architecture ;
    vc:enables ngm:blockchain-network,
        ngm:distributed-system,
        ngm:eventual-consistency,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:communication-protocol,
        ngm:consensus-protocol,
        ngm:gossip-protocol,
        ngm:leader-election ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:cap-theorem,
        ngm:paxos,
        ngm:raft-consensus ;
    vc:requires ngm:message-passing,
        ngm:network-infrastructure ;
    vc:slug "distributed-system-protocol" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:distributed-ledger-technology,
        ngm:microservices,
        ngm:peer-to-peer-network ;
    vc:uses ngm:cryptographic-protocol,
        ngm:digital-signature,
        ngm:distributed-hash-table .

ngm:distributed-trust a owl:Class ;
    rdfs:label "Distributed Trust"@en ;
    rdfs:comment "Distributed trust is a model in which confidence in a system arises from the collective behaviour of many independent participants rather than from a single trusted authority. Through cryptography, consensus and economic incentives, no single party needs to be trusted for the system as a whole to behave correctly. It is the foundational principle behind blockchains and other decentralised infrastructures."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:bridgesTo ngm:reputation-system,
        ngm:web-of-trust ;
    vc:contrastsWith ngm:trust ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:cryptography,
        ngm:digital-signature ;
    vc:enables ngm:decentralisation,
        ngm:smart-contract,
        ngm:trustless-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:isPartOf ngm:blockchain,
        ngm:decentralisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:identity,
        ngm:immutability,
        ngm:provenance ;
    vc:slug "distributed-trust" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:web-of-trust ;
    vc:uses ngm:distributed-ledger,
        ngm:merkle-tree .

ngm:document-retrieval a owl:Class ;
    rdfs:label "Document Retrieval"@en ;
    rdfs:comment "Document Retrieval is the process of identifying and returning relevant documents from a corpus in response to an information need expressed as a query. It forms the foundational layer of search engines, question-answering systems, and retrieval-augmented generation pipelines. Retrieval methods range from sparse keyword matching to dense neural embedding approaches that encode semantic similarity. Effectiveness is typically measured using metrics such as precision, recall, mean reciprocal rank, and normalised discounted cumulative gain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hybrid-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dense-retrieval ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:email-corpus-retrieval-architecture ;
    vc:contrastsWith ngm:dense-passage-retrieval ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:embedding-search,
        ngm:zero-knowledge-machine-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:dense-retrieval,
        ngm:hybrid-retrieval ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graph-embedding,
        ngm:information-retrieval ;
    vc:requires ngm:embedding-layer ;
    vc:slug "document-retrieval" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:cross-modal-retrieval,
        ngm:embedding-model ;
    vc:uses ngm:embedding,
        ngm:embedding-space .

ngm:document-verification a owl:Class ;
    rdfs:label "Document Verification"@en ;
    rdfs:comment "Document verification is the process of confirming that an identity or supporting document presented by a customer is authentic, unaltered, and belongs to the presenting individual. In financial onboarding it combines optical capture, security-feature and template checks, data extraction, and cross-referencing against issuing-authority records or biometric liveness, forming a core step within know-your-customer and anti-money-laundering controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        ngm:know-your-customer ;
    vc:bridgesTo ngm:digital-signature ;
    vc:dependsOn ngm:fraud-detection ;
    vc:enables ngm:onboarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fraud-detection ;
    vc:isPartOf ngm:know-your-customer,
        ngm:onboarding ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:compliance ;
    vc:slug "document-verification" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:aml,
        ngm:compliance ;
    vc:uses ngm:machine-learning .

ngm:dspy a owl:Class ;
    rdfs:label "DSPy"@en ;
    rdfs:comment "DSPy is an open-source framework for programming language models in which developers declare the structure of a task using typed signatures and composable modules, and an optimiser automatically generates and tunes the prompts and few-shot examples needed to maximise a defined metric. By treating prompts as learnable parameters rather than hand-written strings, DSPy shifts language-model application development from manual prompt engineering toward systematic, metric-driven compilation of pipelines. It targets reliable, portable multi-stage LLM programs such as retrieval-augmented and agentic systems."@en ;
    rdfs:subClassOf ngm:automatic-prompt-optimisation,
        ngm:llm-application-framework ;
    vc:enables ngm:ai-agents,
        ngm:llm-orchestration,
        ngm:multi-step-reasoning,
        ngm:retrieval-augmented-generation,
        ngm:structured-output ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:automatic-prompt-optimisation ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:foundation-model,
        ngm:hallucination,
        ngm:langchain,
        ngm:llm-agents ;
    vc:slug "dspy" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bayesian-optimisation,
        ngm:few-shot-prompting,
        ngm:in-context-learning,
        ngm:large-language-models,
        ngm:prompt-engineering .

ngm:dynamic-batching a owl:Class ;
    rdfs:label "Dynamic Batching"@en ;
    rdfs:comment "Dynamic batching is a serving-system technique that aggregates multiple independently arriving inference requests into a single batch for joint GPU execution, without requiring a fixed batch size determined at service startup. Requests are collected over a short time window or until a target batch size is reached, then processed together in one forward pass, amortising the fixed overhead of GPU kernel launches and memory transfers across requests. This substantially increases GPU utilisation and throughput compared with processing each request independently, at the cost of a small, controllable increase in per-request latency."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:contrastsWith ngm:static-batching ;
    vc:dependsOn ngm:kv-cache,
        ngm:transformer ;
    vc:enables ngm:cost-efficient-inference,
        ngm:high-throughput-serving,
        ngm:token-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-scheduler,
        ngm:padding-strategy,
        ngm:request-queue ;
    vc:implements ngm:request-scheduling ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:latency-throughput-tradeoff,
        ngm:speculative-decoding,
        ngm:tensor-parallelism ;
    vc:slug "dynamic-batching" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:large-language-model,
        ngm:model-serving ;
    vc:uses ngm:continuous-batching,
        ngm:gpu-acceleration,
        ngm:inference-engine .

ngm:dynamic-lighting a owl:Class ;
    rdfs:label "Dynamic Lighting"@en ;
    rdfs:comment "Dynamic lighting is a real-time rendering technique in which light sources, shadows, and indirect illumination are computed per-frame based on the current state of a scene, allowing lights to move, change intensity or colour, and interact with animated geometry without relying on pre-baked static lighting data. It is foundational to believable 3D environments in games, virtual production, and spatial computing applications."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:enables ngm:global-illumination,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:rendering-pipeline ;
    vc:slug "dynamic-lighting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physically-based-rendering,
        ngm:ray-tracing,
        ngm:shader .

ngm:ecmascript a owl:Class ;
    rdfs:label "Ecmascript"@en ;
    rdfs:comment "ECMAScript is the standardised specification of the scripting language commonly implemented as JavaScript, defining its syntax, semantics, and core libraries. Maintained by Ecma International as the ECMA-262 standard and developed through the TC39 process, it provides a stable, versioned contract that browser and runtime vendors implement. ECMAScript underpins client-side web programming and a large ecosystem of server-side and tooling runtimes."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:bridgesTo ngm:devops ;
    vc:dependsOn ngm:programming-language ;
    vc:enables ngm:rest-api,
        ngm:web-application ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:web-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:css,
        ngm:w3-c ;
    vc:slug "ecmascript" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ecma-international,
        ngm:iso ;
    vc:supports ngm:html,
        ngm:user-interface ;
    vc:uses ngm:web-standards .

ngm:econometrics a owl:Class ;
    rdfs:label "Econometrics"@en ;
    rdfs:comment "Econometrics is the application of statistical and mathematical methods to economic data in order to test hypotheses, estimate relationships, and forecast economic phenomena. It combines economic theory with regression analysis, time-series modelling, and causal-inference techniques to quantify effects such as elasticities and policy impacts. Econometrics is foundational to empirical economics and increasingly overlaps with machine learning for prediction."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:time-series-forecasting ;
    vc:slug "econometrics" ;
    vc:sourceDomain "data" .

ngm:economic-development a skos:Concept ;
    rdfs:label "Economic Development"@en .

ngm:economic-layer a owl:Class ;
    rdfs:label "Economic Layer"@en ;
    rdfs:comment "The Economic Layer is the abstraction level at which concrete economic mechanisms are implemented in blockchain and distributed systems, encompassing fee markets, reward distribution formulae, automated market makers, staking yield calculations, and game-theoretic incentive structures. It is distinct from conceptual economic theory in that it specifies exact parameters, formulas, and on-chain behaviours."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-model ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:virtual-economy-market-framing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-model,
        ngm:governance-token ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:governance-framework ;
    vc:slug "economic-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:edge-ai-for-smart-cities a owl:Class ;
    rdfs:label "Edge AI for Smart Cities"@en ;
    rdfs:comment "Edge AI for Smart Cities is the deployment of machine learning inference directly on distributed urban infrastructure—smart cameras, IoT sensors, edge gateways, and computing nodes embedded in roads, buildings, and public spaces—enabling real-time autonomous decision-making for traffic management, public safety monitoring, environmental sensing, and energy optimisation without requiring centrally routed cloud processing. This architecture achieves sub-second response latencies, preserves citizen privacy by processing video locally, and overcomes bandwidth constraints that make continuous cloud uplink of high-resolution urban sensor streams impractical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-twin-ecosystem ;
    vc:enables ngm:autonomous-system,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:edge-ai-accelerator,
        ngm:edge-ai-security ;
    vc:requires ngm:edge-ai-system,
        ngm:edge-computing,
        ngm:real-time-processing ;
    vc:slug "edge-ai-for-smart-cities" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning-discipline,
        ngm:object-detection,
        ngm:sensor-fusion .

ngm:education-metaverse a owl:Class ;
    rdfs:label "Education Metaverse"@en ;
    rdfs:comment "A virtual platform that provides immersive educational experiences through interconnected digital learning environments, enabling collaborative instruction, skills development, and knowledge transfer across distributed participants."@en ;
