ngm:data-quality-management a owl:Class ;
    rdfs:label "Data Quality Management"@en ;
    rdfs:comment "Data quality management is the discipline of measuring, monitoring, and improving the accuracy, completeness, consistency, and timeliness of data across its lifecycle. It combines profiling, validation, cleansing, and continuous monitoring with governance policies that define quality expectations. Reliable data quality is a precondition for trustworthy analytics, machine learning, and regulatory reporting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
