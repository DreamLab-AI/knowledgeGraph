    vc:supports ngm:machine-learning,
        ngm:predictive-analytics .

ngm:newton-euler-dynamics a owl:Class ;
    rdfs:label "Newton-Euler Dynamics"@en ;
    rdfs:comment "Recursive formulation of rigid-body mechanics that applies Newton's second law (F=ma) and Euler's rotation equation (τ=Iα) to each link of a robot chain in outward and inward passes, computing joint torques and reaction forces for dynamics simulation, control, and real-time motion planning."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:control-system,
        ngm:embodied-ai-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robot-dynamics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:inertia,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:rigid-body-dynamics,
        ngm:robot-joint,
        ngm:robot-kinematics ;
    vc:slug "newton-euler-dynamics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-torque-sensor,
        ngm:physics-simulation .

ngm:nist-cybersecurity-framework a owl:Class ;
    rdfs:label "NIST Cybersecurity Framework"@en ;
    rdfs:comment "The NIST Cybersecurity Framework (CSF) is a voluntary risk-based framework published by the US National Institute of Standards and Technology that provides organisations with a common taxonomy and structured approach for managing cybersecurity risk. It organises security activities around six core functions—Govern, Identify, Protect, Detect, Respond, and Recover—each decomposed into categories and subcategories aligned to industry standards. Version 2.0, published in 2024, added the Govern function and broadened applicability beyond critical infrastructure to all sectors and organisation sizes globally. The framework is widely adopted as a baseline for cybersecurity programme assessment and communication with leadership."@en ;
    rdfs:subClassOf ngm:security-framework ;
    vc:enables ngm:incident-response,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:nist,
        ngm:nist-ai-rmf ;
    vc:slug "nist-cybersecurity-framework" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:compliance-monitoring,
        ngm:regulatory-compliance .

ngm:noise-function-library a owl:Class ;
    rdfs:label "Noise Function Library"@en ;
    rdfs:comment "A software library providing coherent noise generation algorithms like Perlin, simplex, value, and Voronoi noise for procedural content generation in computer graphics, enabling the creation of natural-looking textures, terrain, and visual effects without manual authoring."@en ;
    rdfs:subClassOf ngm:graphics-library,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:procedural-content ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "noise-function-library" ;
    vc:sourceDomain "spatial-computing" .

ngm:non-linear-narrative a owl:Class ;
    rdfs:label "Non Linear Narrative"@en ;
    rdfs:comment "A storytelling approach where events are presented out of chronological order or where audience choices create branching paths through the narrative, allowing multiple ways to experience story events based on interactions and decisions."@en ;
    rdfs:subClassOf ngm:narrative-structure,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:player-agency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "non-linear-narrative" ;
    vc:sourceDomain "spatial-computing" .

ngm:notification-system a owl:Class ;
    rdfs:label "Notification System"@en ;
    rdfs:comment "A software component that delivers event-driven alerts, presence indicators, and system messages to users or services in real time. In virtual world and metaverse contexts, notification systems manage social events, user-to-user signals, and platform state changes across distributed infrastructure, typically using push protocols or pub-sub messaging patterns."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:event-management,
