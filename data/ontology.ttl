ngm:operational-technology a owl:Class ;
    rdfs:label "Operational Technology"@en ;
    rdfs:comment "Operational technology (OT) is the hardware and software that directly monitors and controls physical processes, devices, and infrastructure in industrial environments. It encompasses industrial control systems such as SCADA and distributed control systems, programmable logic controllers, sensors, and actuators that manage manufacturing, energy, and utilities. OT prioritises availability, safety, and real-time determinism, distinguishing it from information technology, with which it increasingly converges under Industry 4.0."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iec-62443 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:process-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scada ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
