ngm:intelligence-amplification a owl:Class ;
    rdfs:comment "Intelligence amplification is the use of computational tools to augment and extend human cognitive abilities rather than to replace them with autonomous machine intelligence. It frames AI as a partner that enhances human reasoning, memory, and decision-making through interfaces, recommendation, and on-demand expertise. Contrasted with fully autonomous AI, it is a recurring vision in human-computer interaction and a component of discussions about a technological singularity."@en ;
    rdfs:label "Intelligence Amplification"@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
