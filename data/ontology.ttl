ngm:policy-information-point a owl:Class ;
    rdfs:comment "A Policy Information Point (PIP) is the component in a policy-based access control architecture that retrieves and supplies attribute values needed by a Policy Decision Point to evaluate access requests against policies. The PIP acts as an attribute authority, querying identity stores, databases, and external services to resolve subject attributes, resource properties, and environmental conditions at decision time. It decouples the decision logic from the data sources that inform it."@en ;
    rdfs:label "Policy Information Point"@en ;
    rdfs:subClassOf ngm:access-control ;
