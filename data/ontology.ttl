        ngm:storage-layer ;
    vc:isPartOf ngm:computing-hardware,
        ngm:hardware-and-edge ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-processing-hardware,
        ngm:inference-hardware,
        ngm:processing-hardware,
        ngm:training-hardware ;
    vc:requires ngm:data-storage,
        ngm:storage-infrastructure ;
    vc:slug "storage-hardware" ;
    vc:sourceDomain "spatial-computing" .

ngm:structured-light a owl:Class ;
    rdfs:label "Structured Light"@en ;
    rdfs:comment "Structured light is a 3D surface measurement technique that projects one or more known patterns — typically binary stripe sequences, sinusoidal fringes, or dot grids — onto a scene using a projector or laser, then captures the deformed pattern with one or more calibrated cameras. Because the geometry of the projection and capture system is precisely known, the per-pixel deformation of the projected pattern encodes depth, allowing a complete 3D point cloud or depth map of the object surface to be recovered through triangulation. Structured light systems achieve sub-millimetre to micrometre-scale depth accuracy and are widely deployed in industrial metrology, 3D scanning, face recognition, robotic guidance, and augmented reality depth sensing."@en ;
    rdfs:subClassOf ngm:depth-sensing ;
    vc:enables ngm:3-d-reconstruction,
        ngm:industrial-inspection,
        ngm:point-cloud-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:depth-sensor,
        ngm:lidar,
        ngm:stereo-camera ;
    vc:slug "structured-light" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:computer-vision,
        ngm:depth-estimation .

ngm:swift a owl:Class ;
    rdfs:label "SWIFT"@en ;
    rdfs:comment "SWIFT, the Society for Worldwide Interbank Financial Telecommunication, is a cooperative that operates a secure messaging network used by banks and other financial institutions to exchange payment and securities instructions. It does not move money itself but standardises the messages that instruct transfers between institutions, which then settle through correspondent banking relationships or payment systems. Founded in 1973 and based in Belgium, it connects thousands of institutions across most countries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:correspondent-banking ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:blockchain-based-settlement,
        ngm:geopolitical-financial-sanctions ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:ripple-net ;
    vc:dependsOn ngm:bc-defi-and-economics,
        ngm:network-infrastructure ;
    vc:enables ngm:cross-border-payments,
        ngm:interbank-settlement,
        ngm:securities-settlement,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:business-identifier-code,
        ngm:swift-gpi,
        ngm:swift-messaging-network ;
    vc:implements ngm:iso-20022,
        ngm:mt-message-format ;
    vc:isPartOf ngm:global-payment-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nostro-vostro-accounts,
        ngm:real-time-gross-settlement ;
    vc:requires ngm:correspondent-banking,
        ngm:financial-institution-membership,
        ngm:secure-messaging-protocol ;
    vc:slug "swift" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bank-for-international-settlements,
        ngm:iso-9362 ;
    vc:supports ngm:anti-money-laundering,
        ngm:financial-sanctions-compliance .

ngm:tcp-ip a skos:Concept ;
