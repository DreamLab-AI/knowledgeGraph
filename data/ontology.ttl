ngm:explanation a owl:Class ;
    rdfs:label "Explanation"@en ;
    rdfs:comment "An Explanation in the context of AI systems is a human-interpretable account of why a model produced a particular output, which features influenced the prediction, and how the system would behave differently under alternative inputs. Explanations may be global (describing overall model behaviour across the input space), local (accounting for a single prediction), or contrastive (answering why outcome A rather than outcome B). They are the primary instrument through which AI Transparency and Explainability is operationalised for stakeholders including regulators, domain experts, and affected individuals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-hoc-explanation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-importance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:algorithmic-accountability,
        ngm:decision-transparency,
        ngm:transparency-and-explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-importance,
        ngm:post-hoc-explanation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:blockchain,
        ngm:digital-twin,
        ngm:explainability,
        ngm:interpretability ;
    vc:requires ngm:explainable-ai,
        ngm:model-interpretability ;
    vc:slug "explanation" ;
    vc:sourceDomain "artificial-intelligence" .

