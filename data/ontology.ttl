        ngm:geospatial-engine,
        ngm:machine-learning .

ngm:ghg-protocol-corporate-standard a owl:Class ;
    rdfs:label "GHG Protocol Corporate Standard"@en ;
    rdfs:comment "The GHG Protocol Corporate Accounting and Reporting Standard is the most widely used international framework for measuring and reporting an organisation's greenhouse-gas emissions. Developed by the World Resources Institute and the World Business Council for Sustainable Development, it organises emissions into Scope 1 (direct), Scope 2 (purchased energy), and Scope 3 (value-chain) categories, establishing consistent boundaries, accounting principles, and disclosure rules. It underpins corporate climate reporting, science-based targets, and most national and regional emissions-disclosure regulations."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-offset ;
    vc:slug "ghg-protocol-corporate-standard" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:carbon-accounting .

ngm:gini-coefficient a owl:Class ;
    rdfs:label "Gini Coefficient"@en ;
    rdfs:comment "The Gini coefficient is a scalar summary statistic derived from the Lorenz curve that measures the degree of inequality in a distribution, yielding 0 for perfect equality and 1 for maximum concentration in a single entity. Originally developed by statistician Corrado Gini to measure income and wealth inequality, it has been applied in blockchain analytics to quantify the concentration of token holdings, staking power, or validator stake across on-chain addresses. High Gini values in a proof-of-stake network signal plutocratic tendencies that may undermine decentralisation claims."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:financial-inclusion,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:slug "gini-coefficient" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance .

ngm:gitcoin-grants a owl:Class ;
    rdfs:label "Gitcoin Grants"@en ;
    rdfs:comment "Gitcoin Grants is a decentralised crowdfunding programme for open-source and public goods projects in the Web3 ecosystem, which implements quadratic funding as its core matching mechanism to amplify contributions from a broad community of small donors relative to a smaller number of large funders. In quadratic funding, the matching pool allocation for each project is proportional to the square of the sum of the square roots of individual contributions, incentivising broad participation over concentrated giving and making grant outcomes resistant to plutocratic capture. Gitcoin Grants operates in periodic rounds with a central matching pool funded by protocols, DAOs, and foundations, and uses Gitcoin Passport as a Sybil resistance layer to prevent fake identity manipulation of the quadratic formula."@en ;
    rdfs:subClassOf ngm:knowledge-graph-publication-classifier-goods-funding ;
    vc:enables ngm:dao,
        ngm:open-source-development,
        ngm:retroactive-public-goods-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:gitcoin,
        ngm:web3 ;
    vc:slug "gitcoin-grants" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gitcoin-passport,
        ngm:quadratic-funding,
        ngm:smart-contract,
        ngm:sybil-resistance .

ngm:glsl a owl:Class ;
    rdfs:label "GLSL"@en ;
    rdfs:comment "GLSL (OpenGL Shading Language) is a high-level C-like programming language for writing shaders that execute on the GPU within the OpenGL and WebGL graphics pipelines. It lets developers program the programmable stages, principally vertex and fragment shaders, to control geometry transformation, lighting, and per-pixel colour. GLSL is a foundational tool for real-time rendering and visual effects."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "glsl" ;
    vc:sourceDomain "metaverse" .

ngm:gpu-architecture a owl:Class ;
    rdfs:label "GPU Architecture"@en ;
    rdfs:comment "GPU architecture describes the design of graphics processing units as massively parallel processors built around many simple cores, wide memory interfaces and hardware for graphics-specific tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-hierarchy ],
        ngm:computer-hardware ;
    vc:enables ngm:parallel-computing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:memory-hierarchy ;
    vc:slug "gpu-architecture" ;
    vc:sourceDomain "metaverse" .

ngm:gradient-clipping a owl:Class ;
    rdfs:label "Gradient Clipping"@en ;
    rdfs:comment "A technique that limits the magnitude of gradients during backpropagation to prevent exploding gradients and training instability. Gradient clipping rescales gradients when their norm exceeds a threshold, enabling stable training of deep networks, especially recurrent architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
