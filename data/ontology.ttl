ngm:micropayment a owl:Class ;
    rdfs:label "Micropayment"@en ;
    rdfs:comment "A very small electronic payment, typically fractions of a cent to a few dollars, processed automatically within digital environments to enable low-value, high-frequency transactions that are economically infeasible with traditional payment infrastructure."@en ;
