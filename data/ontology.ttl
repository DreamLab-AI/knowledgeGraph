            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:federated-learning,
        ngm:supply-chain-security ;
    vc:contrastsWith ngm:blockchain-scalability ;
    vc:dependsOn ngm:distributed-systems,
