    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-addressing,
        ngm:hash-computation,
        ngm:scope-bearer,
        ngm:slug-derivation ;
    vc:implements ngm:ietf-content-addressable-architecture,
