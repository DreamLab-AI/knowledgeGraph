    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# AI Risk
artificial-intelligence:AIRisk rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:RiskManagement ;
    rdfs:label "AI Risk"@en ;
    rdfs:comment "The potential for AI systems to cause adverse effects on individuals, groups, organizations, communities, or society, arising from technical failures, security vulnerabilities, biased outcomes, privacy violations, or unintended consequences of system design, deployment, or operation. AI risks span from immediate operational failures to long-term catastrophic scenarios requiring proactive identification, assessment, and mitigation strategies."@en ;
    skos:prefLabel "AI Risk"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-risk" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-risk> ;
    vcw:contentHash "sha256-12-0f7fcc3a5548" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0076" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.95"^^xsd:decimal ;
    dcterms:identifier "AI-0076" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AIRisk rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:AIRiskAssessment
] .

artificial-intelligence:AIRisk vcw:bridgesTo artificial-intelligence:SmartContract .

# Risk Management
artificial-intelligence:RiskManagement rdf:type owl:Class ;
    rdfs:label "Risk Management"@en ;
    rdfs:comment "The coordinated activities to direct and control an AI system with regard to risk, encompassing risk identification, assessment, treatment, monitoring, and communication throughout the AI lifecycle to minimize potential adverse effects while maximizing benefits."@en ;
    skos:prefLabel "Risk Management"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:risk-management" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:risk-management> ;
    vcw:contentHash "sha256-12-9659302a5dbe" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0077" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0077" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Risk Mitigation
artificial-intelligence:RiskMitigation rdf:type owl:Class ;
    rdfs:label "Risk Mitigation"@en ;
    rdfs:comment "Actions taken to reduce the likelihood or impact of identified AI risks through technical, organizational, or procedural controls, implemented throughout the AI lifecycle to achieve acceptable risk levels."@en ;
    skos:prefLabel "Risk Mitigation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:risk-mitigation" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:risk-mitigation> ;
    vcw:contentHash "sha256-12-71959b500fcf" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0079" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0079" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Risk Treatment
artificial-intelligence:RiskTreatment rdf:type owl:Class ;
    rdfs:label "Risk Treatment"@en ;
    rdfs:comment "The process of selecting and implementing measures to modify AI risk, including risk avoidance, risk reduction (mitigation), risk sharing (transfer), and risk retention, based on risk assessment outcomes and organizational risk appetite."@en ;
    skos:prefLabel "Risk Treatment"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:risk-treatment" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:risk-treatment> ;
    vcw:contentHash "sha256-12-82330c71141c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0080" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0080" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# High Risk AI System
artificial-intelligence:HighRiskAISystem rdf:type owl:Class ;
    rdfs:label "High Risk AI System"@en ;
    rdfs:comment "An AI system classified as presenting significant risk to health, safety, fundamental rights, or other critical interests based on its intended purpose, deployment context, and potential for substantial adverse impact, subject to stringent regulatory requirements under the EU AI Act and similar frameworks."@en ;
    skos:prefLabel "High Risk AI System"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:high-risk-ai-system" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:high-risk-ai-system> ;
    vcw:contentHash "sha256-12-fa400566b3ce" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0081" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0081" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:HighRiskAISystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom artificial-intelligence:ConformityAssessmentAI0103
] .

artificial-intelligence:HighRiskAISystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom artificial-intelligence:HumanOversightAI0041
] .

# AI Incident
artificial-intelligence:AIIncident rdf:type owl:Class ;
    rdfs:label "AI Incident"@en ;
    rdfs:comment "An event involving an AI system that causes or has the potential to cause harm to individuals, property, environment, or fundamental rights, including malfunctions, security breaches, bias-driven discrimination, privacy violations, or unintended consequences requiring investigation and remediation."@en ;
    skos:prefLabel "AI Incident"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-incident" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-incident> ;
    vcw:contentHash "sha256-12-0d4cad238896" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0082" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0082" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AIIncident vcw:bridgesTo artificial-intelligence:AIAgentSystem .

# Harmful Bias
artificial-intelligence:HarmfulBias rdf:type owl:Class ;
    rdfs:label "Harmful Bias"@en ;
    rdfs:comment "Systematic and unjust discrimination in AI system outcomes that disadvantages individuals or groups based on protected characteristics (race, gender, age, disability, religion, etc.) or other sensitive attributes, resulting in material harm, dignity violations, or perpetuation of societal inequalities."@en ;
    skos:prefLabel "Harmful Bias"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:harmful-bias" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:harmful-bias> ;
    vcw:contentHash "sha256-12-942812655dc9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0083" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0083" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Adversarial Attack
artificial-intelligence:AdversarialAttack rdf:type owl:Class ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "A deliberate attempt to manipulate an AI system by crafting malicious inputs or exploiting vulnerabilities to cause misclassification, extract confidential information, degrade performance, or subvert the system's intended behavior."@en ;
    skos:prefLabel "Adversarial Attack"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:adversarial-attack" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:adversarial-attack> ;
    vcw:contentHash "sha256-12-69f46310a7ea" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0084" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0084" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T20:12:08Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AdversarialAttack vcw:bridgesTo artificial-intelligence:ComputerVision .

# Data Poisoning
artificial-intelligence:DataPoisoning rdf:type owl:Class ;
    rdfs:label "Data Poisoning"@en ;
    rdfs:comment "A training-time adversarial attack where malicious actors inject, modify, or manipulate training data to compromise model integrity, causing targeted misclassifications, backdoor triggers, or general performance degradation."@en ;
    skos:prefLabel "Data Poisoning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:data-poisoning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:data-poisoning> ;
    vcw:contentHash "sha256-12-7f3a527315e3" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0085" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0085" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Model Inversion
artificial-intelligence:ModelInversion rdf:type owl:Class ;
    rdfs:label "Model Inversion"@en ;
    rdfs:comment "An inference-time privacy attack that reconstructs sensitive training data or attributes from a trained model by exploiting model outputs, predictions, or internal representations, potentially revealing confidential information about individuals in the training dataset."@en ;
    skos:prefLabel "Model Inversion"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-inversion" ;
