        ngm:transformer-architecture ;
    vc:enables ngm:code-generation,
        ngm:image-captioning,
        ngm:machine-translation,
        ngm:natural-language-generation,
        ngm:question-answering,
        ngm:speech-recognition,
        ngm:text-generation,
        ngm:text-summarisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:constrained-decoding,
        ngm:coverage-penalty,
        ngm:diverse-beam-search,
