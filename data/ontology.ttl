ngm:verification a owl:Class ;
    rdfs:label "VERIFICATION"@en ;
    rdfs:comment "Verification is the process of confirming that information, claims, and digital artefacts meet specified standards for accuracy, completeness, and compliance with constraints through cryptographic proofs, rule-based validation, consensus mechanisms, and user acceptance testing. Within metaverse and blockchain contexts it encompasses transaction authenticity, smart contract correctness, ontology schema conformance, and digital asset provenance, establishing trust between stakeholders in decentralised systems."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-framework,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:standards-validation ;
    vc:slug "verification" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptography,
        ngm:digital-signature .

ngm:vulkan a owl:Class ;
    rdfs:label "Vulkan"@en ;
    rdfs:comment "Vulkan is a low-overhead, cross-platform graphics and compute API developed by the Khronos Group and released in 2016 as the successor to OpenGL, designed to give developers explicit control over GPU resources including memory allocation, synchronisation, command buffer submission, and render pass configuration in order to minimise CPU overhead and achieve predictable, high-performance rendering across diverse hardware. Vulkan operates closer to metal than its predecessor: applications manage their own memory pools, pipeline state objects, descriptor sets, and queue families, while the driver's role is reduced to translating API calls into hardware commands with minimal hidden magic. Vulkan shaders are compiled to SPIR-V, a portable intermediate representation, enabling shader code authored in GLSL or HLSL to execute on any conforming GPU without driver-side shader compilation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spir-v ],
        ngm:graphics-api ;
    vc:bridgesTo ngm:inference,
        ngm:safety-critical-systems ;
    vc:contrastsWith ngm:direct3d,
        ngm:metal-api,
        ngm:open-gl ;
    vc:enables ngm:gpu-compute,
        ngm:mesh-shading,
        ngm:ray-tracing,
        ngm:real-time-rendering,
        ngm:real-time-rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:pipeline-state-object ;
    vc:implements ngm:open-xr ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-shader,
        ngm:rendering-pipeline,
        ngm:shader ;
    vc:requires ngm:gpu-driver,
        ngm:spir-v ;
    vc:slug "vulkan" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:uses ngm:command-buffer,
        ngm:descriptor-set,
        ngm:gpu-computing,
        ngm:shader-language .

ngm:asymmetric-cryptography a owl:Class ;
    rdfs:label "Asymmetric Cryptography"@en ;
    rdfs:comment "Asymmetric Cryptography is a cryptographic paradigm in which mathematically related key pairs — a public key and a private key — serve distinct roles: the public key may be freely shared and used to encrypt messages or verify signatures, while the private key is kept secret and used to decrypt or sign. Security rests on the computational intractability of reversing the underlying mathematical problems without knowledge of the private key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-pair ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trapdoor-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:post-quantum-cryptography,
        ngm:symmetric-cryptography ;
    vc:dependsOn ngm:hardware-security-module,
        ngm:key-management ;
    vc:enables ngm:authentication,
        ngm:non-repudiation,
        ngm:public-key-infrastructure,
        ngm:tls ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:digital-signature,
        ngm:key-pair,
        ngm:private-key,
        ngm:public-key ;
    vc:implements ngm:diffie-hellman-key-exchange,
        ngm:elliptic-curve-cryptography,
        ngm:rsa ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:certificate-transparency,
        ngm:fido2,
        ngm:key-management ;
    vc:requires ngm:random-number-generation,
        ngm:trapdoor-function ;
    vc:slug "asymmetric-cryptography" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:code-signing,
        ngm:end-to-end-encryption .

ngm:batch-processing a owl:Class ;
    rdfs:label "Batch Processing"@en ;
    rdfs:comment "A computational paradigm in which jobs are accumulated and executed as a group rather than individually in real-time. Batch processing optimises throughput by amortising fixed overhead across many records, enabling efficient ETL pipelines, model training over large datasets, report generation, and vulnerability scanning. Scheduling may be time-based, event-triggered, or dependency-driven."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        ngm:data-pipeline ;
    vc:bridgesTo ngm:digital-twin,
        ngm:infra-data-management,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:inference,
        ngm:real-time-processing,
        ngm:stream-processing ;
    vc:dependsOn ngm:workflow-orchestration ;
    vc:enables ngm:etl-pipeline,
