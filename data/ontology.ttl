    vc:slug "safe" ;
    vc:sourceDomain "blockchain" .

ngm:safety-vulnerability a owl:Class ;
    rdfs:label "Safety Vulnerability"@en ;
    rdfs:comment "A Safety Vulnerability is an identified weakness or flaw in an AI system's design, training data, architecture, or deployment context that could be exploited to cause harmful, unintended, or unsafe behaviours—including adversarial attacks, data poisoning, prompt injection, or misalignment failures. Safety vulnerabilities are distinct from conventional software security vulnerabilities in that they may arise from statistical properties of learned models rather than explicit coding errors, making them harder to enumerate exhaustively and more sensitive to distribution shift. Systematic identification requires red-teaming, adversarial testing, and formal verification where feasible."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jailbreaking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-injection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adversarial-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-poisoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:model-robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adversarial-attack,
        ngm:data-poisoning,
        ngm:jailbreaking,
        ngm:prompt-injection ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attacks,
        ngm:ai-risk,
        ngm:ai-safety,
        ngm:vulnerability ;
    vc:requires ngm:adversarial-testing,
        ngm:red-teaming ;
    vc:slug "safety-vulnerability" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-risk-management .

ngm:scroll a owl:Class ;
