ngm:icvcm-core-carbon-principles a owl:Class ;
    rdfs:label "ICVCM Core Carbon Principles"@en ;
    rdfs:comment "The ICVCM Core Carbon Principles (CCPs) are a set of ten threshold standards established by the Integrity Council for the Voluntary Carbon Market to define what constitutes a high-quality carbon credit. They cover governance, emissions impact, and sustainable development dimensions, requiring that credits be real, additional, quantified, permanent, independently verified, and contribute positively to sustainable development goals without causing harm to local communities or ecosystems."@en ;
    rdfs:subClassOf ngm:icvcm-framework ;
    vc:enables ngm:carbon-credit-retirement,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-standard-certification,
        ngm:verra-vcs-standard ;
    vc:slug "icvcm-core-carbon-principles" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:integrity-council-for-the-voluntary-carbon-market ;
    vc:supports ngm:carbon-markets .

ngm:idempotency a owl:Class ;
    rdfs:label "Idempotency"@en ;
    rdfs:comment "Idempotency is the property of an operation whereby applying it multiple times produces the same result as applying it once. In distributed systems and APIs it is essential for safe retries, ensuring that duplicated requests caused by network failures do not corrupt state or cause unintended side effects. Idempotency is commonly enforced via idempotency keys, deterministic merge functions, or naturally commutative state updates."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "idempotency" ;
    vc:sourceDomain "infrastructure" .

ngm:identity a owl:Class ;
    rdfs:label "Identity"@en ;
    rdfs:comment "Identity is the complete, verifiable representation of a principal — person, organisation, device, or agent — within a digital system, constituted by a set of attributes, credentials, and cryptographically anchored claims that distinguish that principal from all others. Digital identity underpins authentication, authorisation, and accountability across networked systems, and increasingly extends to self-sovereign, decentralised forms in which control of the identity record rests with the subject rather than a centralised authority. In spatial computing and metaverse contexts, identity further encompasses persistent avatars, reputational history, and cross-platform portability anchored to decentralised identifiers (DIDs). The coherent management of identity is the foundation upon which access control, trust hierarchies, and privacy-preserving interactions are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:ai-agent,
        ngm:avatar ;
    vc:contrastsWith ngm:anonymity,
        ngm:pseudonymity ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:access-control,
        ngm:accountability,
        ngm:authorisation,
        ngm:privacy,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:credential,
        ngm:decentralised-identifier,
        ngm:verifiable-claim ;
    vc:implements ngm:federated-identity,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:digital-twin,
        ngm:identity-management,
        ngm:reputation ;
    vc:requires ngm:authentication,
        ngm:cryptography,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:verifiable-credentials,
        ngm:w3c-did-core .

ngm:iec-62443 a owl:Class ;
    rdfs:label "IEC 62443"@en ;
    rdfs:comment "IEC 62443 is a multi-part international standards series developed by IEC Technical Committee 65 (in collaboration with ISA99) that defines requirements, policies, and lifecycle processes for securing Industrial Automation and Control Systems (IACS) against cyber threats. It establishes a risk-based framework covering security management systems, security policies and procedures, system and component requirements, and security levels (SL 1–4) that grade protection against progressively sophisticated threat actors. The standard addresses all stakeholders in the IACS lifecycle — asset owners, system integrators, and product suppliers — assigning distinct roles, responsibilities, and conformance obligations to each. IEC 62443 is widely adopted in sectors such as energy, water, chemicals, manufacturing, and critical national infrastructure as the authoritative basis for operational technology (OT) cybersecurity governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:it-security ;
    vc:contrastsWith ngm:iso-iec-27001,
        ngm:nist-sp-800-82 ;
    vc:dependsOn ngm:access-control,
        ngm:defense-in-depth,
        ngm:network-segmentation ;
    vc:enables ngm:critical-infrastructure-protection,
        ngm:industrial-cybersecurity,
        ngm:supply-chain-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conduit,
        ngm:security-level,
        ngm:security-management-system,
        ngm:security-zone ;
    vc:implements ngm:cybersecurity-governance,
        ngm:risk-based-security ;
    vc:isPartOf ngm:ot-cybersecurity-framework ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:iec-61511,
        ngm:nerc-cip,
        ngm:nis2-directive ;
    vc:requires ngm:patch-management,
        ngm:risk-assessment,
        ngm:vulnerability-management ;
    vc:slug "iec-62443" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iec,
        ngm:isa ;
    vc:supports ngm:industrial-control-system,
        ngm:operational-technology,
        ngm:scada-security .

ngm:ieee-standards-association a owl:Class ;
    rdfs:label "IEEE Standards Association"@en ;
    rdfs:comment "The IEEE Standards Association (IEEE SA) is the standards development arm of the Institute of Electrical and Electronics Engineers, operating a consensus-based process through which industry, government, and academic stakeholders collaboratively develop and maintain technical standards covering electrical, electronic, computing, and communications technologies, with over 1,400 active standards and more than 900 standards under active development at any time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-robotics-and-automation-society ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-control-systems-society ],
        ngm:standards-body ;
    vc:enables ngm:interoperability-standard,
        ngm:technical-standards ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ieee-control-systems-society,
        ngm:ieee-robotics-and-automation-society ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ieee,
        ngm:technical-standard ;
    vc:slug "ieee-standards-association" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:standards-organization .

ngm:image-preprocessing a skos:Concept ;
    rdfs:label "Image Preprocessing"@en .

ngm:image-sensor a owl:Class ;
    rdfs:label "Image Sensor"@en ;
    rdfs:comment "An image sensor is a solid-state device that converts incident light into electrical signals to capture a digital image, typically implemented as a CMOS or CCD array of photodetector pixels. Each pixel accumulates charge proportional to received photons, which is read out, digitised, and assembled into a frame. Image sensors are the core capture element in cameras and many computer-vision and tracking systems."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:eye-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:slug "image-sensor" ;
    vc:sourceDomain "robotics" .

ngm:immersion a owl:Class ;
    rdfs:label "Immersion"@en ;
    rdfs:comment "Subjective experience of psychological engagement and sense of presence within a virtual environment, characterized by reduced awareness of physical surroundings and absorption in virtual context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emotional-immersion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensory-immersion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-technology ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:flow-state,
        ngm:presence,
        ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-established ;
