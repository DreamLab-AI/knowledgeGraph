        ngm:ieee-754,
        ngm:khronos-group,
        ngm:microsoft-direct-x,
        ngm:open-gl-arb,
        ngm:w3-c-web-gpu ;
    vc:supports ngm:architectural-visualisation,
        ngm:augmented-reality,
        ngm:film-visual-effects,
        ngm:medical-imaging,
        ngm:scientific-visualisation,
        ngm:video-game-development,
        ngm:virtual-reality ;
    vc:uses ngm:direct-x-12,
        ngm:dlss,
        ngm:fsr,
        ngm:glsl,
