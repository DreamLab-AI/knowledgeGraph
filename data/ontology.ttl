        ngm:international-coordination .

ngm:fatf-travel-rule a owl:Class ;
    rdfs:label "FATF Travel Rule"@en ;
    rdfs:comment "The FATF Travel Rule (Recommendation 16 extended to virtual assets) requires Virtual Asset Service Providers (VASPs) to collect, verify, and transmit originator and beneficiary identity information alongside cryptocurrency transactions that meet or exceed a jurisdictional threshold, typically USD/EUR 1,000. Issued by the Financial Action Task Force, it extends the longstanding wire-transfer obligation — rooted in the FATF 40 Recommendations and aligned with SWIFT messaging norms — to crypto-asset transfers, obligating sending VASPs to share identifying data with receiving VASPs before or simultaneously with the transfer. Compliance demands interoperability protocols, counterparty discovery infrastructure, and shared data standards such as IVMS 101 between exchanges, custodians, and wallet providers across different jurisdictions. The rule has been progressively transposed into national and regional law, including the EU Transfer of Funds Regulation, UK Money Laundering Regulations, and Singapore Payment Services Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ivms-101 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credential,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:decentralised-exchange,
        ngm:privacy-coin,
        ngm:self-hosted-wallet ;
    vc:enables ngm:crypto-asset-compliance,
        ngm:financial-intelligence,
        ngm:transaction-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fatf-recommendation-16,
        ngm:wire-transfer-rule ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:sanctions-screening,
        ngm:transfer-of-funds-regulation,
        ngm:virtual-asset,
        ngm:virtual-asset-service-provider ;
    vc:requires ngm:anti-money-laundering,
        ngm:digital-identity,
        ngm:ivms-101,
        ngm:know-your-customer,
        ngm:vasp-counterparty-discovery ;
    vc:slug "fatf-travel-rule" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:fatf,
        ngm:financial-action-task-force ;
    vc:uses ngm:openvasp,
        ngm:public-key-infrastructure,
