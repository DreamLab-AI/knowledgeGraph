    vc:sourceDomain "infrastructure" .

ngm:data-governance-domain a owl:Class ;
    rdfs:label "Data Governance Domain"@en ;
    rdfs:comment "The Data Governance Domain classifies concepts concerning the policies, roles and controls that govern data as an organisational asset. It covers ownership, quality, lineage and the rules for access, retention and use. As a top-level subject axis it establishes how data is managed responsibly across systems and throughout its lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retention-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lineage ],
        ngm:owl-thing ;
    vc:enables ngm:regulatory-reporting,
        ngm:trusted-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-catalogue,
        ngm:data-lineage,
        ngm:data-ownership,
        ngm:data-quality,
        ngm:retention-policy ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-management-domain,
        ngm:governance-domain ;
    vc:slug "data-governance-domain" ;
    vc:sourceDomain "data-governance" .

ngm:data-lineage a owl:Class ;
    rdfs:label "Data Lineage"@en ;
    rdfs:comment "Data lineage is the documented record of data's origins, movements, transformations and consumption as it flows through systems and pipelines. It maps how a data element is derived end to end, supporting impact analysis, debugging, audit and regulatory compliance. As a pillar of data governance and metadata management it makes data trustworthy by exposing its provenance."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-governance-domain,
        ngm:metadata-management ;
    vc:slug "data-lineage" ;
    vc:sourceDomain "data" .

ngm:data-model a owl:Class ;
    rdfs:label "Data Model"@en ;
    rdfs:comment "A data model is an abstract specification of how data elements are structured, related and constrained within a domain or system. It defines entities, attributes, relationships and integrity rules at conceptual, logical or physical levels of abstraction. Data models are prerequisites for metadata standards and for designing storage, exchange and querying of data."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-management-domain,
        ngm:metadata-standard ;
    vc:slug "data-model" ;
    vc:sourceDomain "data" .

ngm:data-models a owl:Class ;
    rdfs:label "Data Models"@en ;
    rdfs:comment "Data models are the collected structural specifications that define how information is represented, related and constrained within a system or framework. In digital-twin and layered service architectures they describe the shape of state, telemetry and interactions exchanged between components. Well-defined data models are a prerequisite for interoperability, validation and consistent behaviour across service layers."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-framework,
        ngm:service-layer ;
    vc:slug "data-models" ;
    vc:sourceDomain "data" .

ngm:data-processing-hardware a owl:Class ;
    rdfs:label "Data Processing Hardware"@en ;
    rdfs:comment "The computing infrastructure including GPUs, CPUs, specialized accelerators, and edge computing devices that power metaverse applications, virtual reality experiences, and immersive environments, providing the massive processing capabilities required for real-time 3D rendering, AI inference, and ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cooling-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:computing-infrastructure,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:ai-processing,
        ngm:immersive-computing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cooling-system,
        ngm:high-bandwidth-memory,
        ngm:power-infrastructure ;
    vc:slug "data-processing-hardware" ;
    vc:sourceDomain "infrastructure" .

ngm:data-synchronization a owl:Class ;
    rdfs:label "Data Synchronization"@en ;
    rdfs:comment "Data synchronization is the process of keeping data consistent across multiple devices, replicas or systems by propagating changes and reconciling conflicts. It may be one-way or bidirectional, real-time or batch, and relies on change tracking, versioning and conflict-resolution strategies. It is essential wherever distributed copies of data must converge, from device sync to collective-intelligence systems aggregating many participants."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence-system,
        ngm:etsi-domain-data-management ;
    vc:slug "data-synchronization" ;
    vc:sourceDomain "infrastructure" .

ngm:data-warehouse a owl:Class ;
    rdfs:label "Data Warehouse"@en ;
    rdfs:comment "A data warehouse is a centralised analytical repository that integrates cleansed, structured data from multiple operational sources into a subject-oriented, historical model optimised for querying and reporting. It supports business intelligence through schemas such as star and snowflake and columnar storage for fast aggregation. It is a core data-engineering asset enabling consistent enterprise analytics."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-engineering,
        ngm:metadata-management ;
    vc:slug "data-warehouse" ;
    vc:sourceDomain "data" .

ngm:database-management-system a owl:Class ;
    rdfs:label "Database Management System"@en ;
    rdfs:comment "A database management system (DBMS) is software that defines, stores, retrieves, secures and manages structured data while enforcing integrity, concurrency and durability. It mediates all access to the underlying database through a query interface and transaction manager, supporting models such as relational, document, key-value and graph. It is the foundational platform for persistent data services including ontology repositories and taxonomy registries."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-ontology-repository,
        ngm:digital-taxonomy-registry ;
    vc:slug "database-management-system" ;
    vc:sourceDomain "data" .

ngm:death-of-the-internet a owl:Class ;
    rdfs:label "Death of the Internet"@en ;
    rdfs:comment "Death of the Internet is a concept cluster in the ics-society and Media Theory domains capturing the convergent degradation of the public World Wide Web as a space for authentic human knowledge-exchange, discovery, and democratic discourse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
