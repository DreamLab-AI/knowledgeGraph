    vcw:owlRole "Concept" .

# Virtual Set Design
spatial-computing:VirtualSetDesign rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ProductionDesign ;
    rdfs:label "Virtual Set Design"@en ;
    rdfs:comment "The creation of digital environments and backgrounds for film, television, and broadcast production using 3D modeling, game engines, and LED wall technology, enabling dynamic digital sets that can be modified in real-time during filming to replace or augment physical set construction."@en ;
    skos:prefLabel "Virtual Set Design"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-set-design" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-set-design> ;
