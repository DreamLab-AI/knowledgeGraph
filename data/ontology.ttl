ngm:permissioned-network a owl:Class ;
    rdfs:label "Permissioned Network"@en ;
    rdfs:comment "A Permissioned Network is a distributed ledger architecture in which participation—whether as a validator, transaction submitter, or read-only observer—is restricted to entities that have been explicitly authorised by a governing body or membership protocol. Unlike public blockchains, nodes must satisfy identity verification, legal agreement, or technical credentialing requirements before joining, enabling stronger privacy guarantees, higher throughput, and deterministic finality than open networks while sacrificing censorship resistance. Permissioned networks are the dominant choice for enterprise and consortium deployments such as trade finance, healthcare data exchange, and central-bank digital currency infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:public-blockchain ;
    vc:enables ngm:blockchain-compliance,
        ngm:blockchain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:validator-node ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:distributed-ledger-technology,
        ngm:private-blockchain ;
    vc:requires ngm:access-control,
        ngm:identity-management ;
    vc:slug "permissioned-network" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:smart-contract .

ngm:permissionless-innovation a owl:Class ;
    rdfs:label "Permissionless Innovation"@en ;
    rdfs:comment "A policy stance holding that new technologies and business models should generally be allowed to develop without prior approval, with regulation applied only to address demonstrated harms. It is often discussed in the context of the internet and digital finance."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:decentralization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "permissionless-innovation" ;
    vc:sourceDomain "technology-policy" .

ngm:permissionless-lending a owl:Class ;
    rdfs:label "Permissionless Lending"@en ;
    rdfs:comment "Permissionless lending is the provision of on-chain credit through open protocols that anyone may access without identity gating or intermediary approval. Lenders deposit assets into smart-contract liquidity pools and borrowers draw against over-collateralised positions, with interest rates set algorithmically by utilisation. It is a foundational DeFi primitive that replaces credit underwriting with collateralisation and code-enforced liquidation."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance-domain,
        ngm:decentralized-finance-de-fi ;
    vc:slug "permissionless-lending" ;
    vc:sourceDomain "blockchain" .

ngm:permissionless-participation a owl:Class ;
    rdfs:label "Permissionless Participation"@en ;
    rdfs:comment "Permissionless participation is the property of a network whereby any actor may join, transact, validate, or contribute without requesting approval from a central authority. It is a defining characteristic of public blockchains, where open access to running nodes and proposing or validating blocks underpins censorship resistance and decentralisation. The property is enforced by economic and cryptographic mechanisms rather than identity vetting."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:consensus-mechanism ;
    vc:slug "permissionless-participation" ;
    vc:sourceDomain "blockchain" .

ngm:perpetual-futures a owl:Class ;
    rdfs:label "Perpetual Futures"@en ;
    rdfs:comment "Perpetual futures are derivative contracts that track an underlying asset's price without an expiry or settlement date. A periodic funding-rate payment between long and short holders tethers the contract price to the spot index, replacing the convergence that expiry provides in traditional futures. They are a dominant instrument in crypto derivatives markets, enabling leveraged directional exposure that can be held indefinitely."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:d-yd-x,
        ngm:gmx ;
    vc:slug "perpetual-futures" ;
    vc:sourceDomain "blockchain" .

ngm:persistent-ar-placement a owl:Class ;
    rdfs:label "Persistent AR Placement"@en ;
    rdfs:comment "The capability to anchor augmented reality content at specific real-world locations that persists across sessions and devices, using cloud-stored spatial anchors and environmental mapping to enable shared, location-based AR experiences."@en ;
    rdfs:subClassOf ngm:augmented-reality,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:shared-ar-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "persistent-ar-placement" ;
    vc:sourceDomain "spatial-computing" .

ngm:persistent-content-anchoring a owl:Class ;
    rdfs:label "Persistent Content Anchoring"@en ;
    rdfs:comment "Persistent content anchoring is the augmented-reality capability of fixing virtual content to a precise real-world location so that it reappears in the same place across sessions, devices, and users. It relies on saving spatial-anchor data, typically derived from visual feature maps, and relocalising against that map on subsequent visits. The technique is essential for shared and durable AR experiences tied to physical space."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:ar-registration ;
    vc:slug "persistent-content-anchoring" ;
    vc:sourceDomain "metaverse" .

ngm:personal-assistance a owl:Class ;
    rdfs:label "Personal Assistance"@en ;
    rdfs:comment "Personal assistance is an AI application class in which an agent helps an individual accomplish everyday tasks such as scheduling, information lookup, communication, and device or browser control. It combines natural-language understanding with tool use and memory to act on the user's behalf within their personal context. Modern personal assistants increasingly automate multi-step workflows rather than only answering questions."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "personal-assistance" ;
    vc:sourceDomain "ai" .

ngm:personalized-experiences a owl:Class ;
    rdfs:label "Personalized Experiences"@en ;
    rdfs:comment "Personalized experiences are interactions, content, or services dynamically tailored to an individual's preferences, history, and context. They are produced by models that infer user intent and situation from behavioural signals and contextual data, then adapt recommendations, interfaces, or responses accordingly. Personalization aims to increase relevance and engagement while balancing privacy and the risk of filter bubbles."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-machine-learning,
        ngm:context-awareness ;
    vc:slug "personalized-experiences" ;
    vc:sourceDomain "ai" .

ngm:personalized-interaction a owl:Class ;
    rdfs:label "Personalized Interaction"@en ;
    rdfs:comment "Personalized interaction is a conversational or interface exchange that adapts in real time to the specific user it is engaging, using their context, history, and inferred state. Unlike static personalization of content, it tailors the moment-to-moment dialogue, tone, and follow-ups based on prior turns and behavioural feedback. It is central to adaptive assistants that improve as they learn an individual's patterns."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:behavioural-feedback-loop,
        ngm:context-aware-response ;
    vc:slug "personalized-interaction" ;
    vc:sourceDomain "ai" .

ngm:pharmaceutical-logistics a owl:Class ;
    rdfs:label "Pharmaceutical Logistics"@en ;
    rdfs:comment "Pharmaceutical logistics is the specialised management of storage, handling, and transport of medicines and biologics under strict regulatory and environmental controls. It enforces cold-chain integrity, serialisation, and chain-of-custody to preserve product efficacy and prevent counterfeiting or diversion. The discipline combines temperature-controlled distribution with traceability and compliance reporting across the supply chain."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:pharmaceutical-supply-chain ;
    vc:slug "pharmaceutical-logistics" ;
    vc:sourceDomain "supply-chain" .

ngm:phoenix a owl:Class ;
    rdfs:label "Phoenix"@en ;
    rdfs:comment "Phoenix is a self-custodial Bitcoin Lightning wallet developed by ACINQ that manages channels automatically on behalf of the user. It is available as a mobile application."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning ],
        ngm:wallet ;
    vc:enables ngm:bolt-12 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:lightning ;
    vc:slug "phoenix" ;
    vc:sourceDomain "blockchain" .

ngm:photorealistic-synthesis a owl:Class ;
    rdfs:label "Photorealistic Synthesis"@en ;
    rdfs:comment "Photorealistic synthesis is the generation of images or scenes that are visually indistinguishable from real photographs. It is achieved with generative models such as diffusion networks and GANs, or with physically based rendering, that reproduce accurate lighting, materials, geometry, and texture detail. It underpins high-fidelity image generation and the creation of realistic 4D and procedural content."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:procedural-and-hybrid-4-d,
        ngm:proprietary-image-generation ;
    vc:slug "photorealistic-synthesis" ;
    vc:sourceDomain "ai" .

ngm:photorealistic-telepresence a owl:Class ;
    rdfs:label "Photorealistic Telepresence"@en ;
    rdfs:comment "Photorealistic telepresence is remote real-time communication in which participants appear as lifelike, volumetrically accurate representations rather than video tiles or stylised avatars. It reconstructs a person's appearance and motion using techniques such as neural avatars and 3D Gaussian splatting, rendering them convincingly in a shared spatial scene. The goal is a sense of co-presence that closely matches being physically together."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:ai-avatars ;
    vc:slug "photorealistic-telepresence" ;
    vc:sourceDomain "metaverse" .

ngm:physical-network-hardware a owl:Class ;
    rdfs:label "Physical Network Hardware"@en ;
    rdfs:comment "The networking infrastructure components that enable connectivity and data transmission for metaverse applications, including routers, switches, access points, edge computing devices, and 5G equipment required for low-latency immersive experiences."@en ;
    rdfs:subClassOf ngm:network-infrastructure,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:low-latency-connectivity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "physical-network-hardware" ;
    vc:sourceDomain "spatial-computing" .

ngm:physical-presence a owl:Class ;
    rdfs:label "Physical Presence"@en ;
    rdfs:comment "Physical presence is the perceptual sense of being bodily situated in a remote or virtual environment, including the ability to act on and feel that environment. In telepresence it is produced by combining spatial audio-visual immersion with embodiment cues such as haptic feedback and a controllable remote body or robot. Strong physical presence makes a mediated location feel as though the user is genuinely there."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:haptics,
        ngm:tc-0003-telepresence-robot ;
    vc:slug "physical-presence" ;
    vc:sourceDomain "metaverse" .

ngm:pick-and-place a owl:Class ;
    rdfs:label "Pick and Place"@en ;
    rdfs:comment "Pick and place is a canonical robotic manipulation task in which a manipulator grasps an object at a source location and deposits it at a target location. It chains perception to localise the object, motion planning to reach and grasp it, and controlled placement, often repeated at high speed in structured settings. It is the foundational operation of industrial automation in assembly, packaging, and sorting."@en ;
    rdfs:subClassOf ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cylindrical-robot,
        ngm:position-control ;
    vc:slug "pick-and-place" ;
    vc:sourceDomain "robotics" .

ngm:piracy-prevention a owl:Class ;
    rdfs:label "Piracy Prevention"@en ;
    rdfs:comment "Piracy prevention is the set of technical and procedural measures that deter and detect unauthorised copying, distribution, and use of digital content. It encompasses encryption, licensing, access control, watermarking, and tamper resistance, typically delivered through digital rights management systems. Its objective is to enforce usage rights while balancing legitimate user access and interoperability."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-rights-management,
        ngm:digital-rights-management-extended ;
    vc:slug "piracy-prevention" ;
    vc:sourceDomain "security" .

ngm:plan-and-execute a owl:Class ;
    rdfs:label "Plan and Execute"@en ;
    rdfs:comment "Plan and execute is an agentic reasoning strategy in which an LLM-based agent first generates a multi-step plan for a task and then carries out each step, optionally re-planning when steps fail or new information appears. Separating planning from execution improves coherence on long-horizon tasks compared with purely reactive, single-step prompting. It is a common control pattern for autonomous and computer-use agents."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "plan-and-execute" ;
    vc:sourceDomain "ai" .

ngm:plan-and-execute-pattern a owl:Class ;
    rdfs:label "Plan and Execute Pattern"@en ;
    rdfs:comment "The plan-and-execute pattern is an agent-architecture design in which a dedicated planner component produces a structured task plan that an executor component then realises step by step using tools. Formalising the strategy as a reusable pattern lets agent frameworks separate high-level reasoning from low-level tool invocation, enabling re-planning and observability. It is widely implemented through function-calling pipelines in LLM agent frameworks."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:function-calling ;
    vc:slug "plan-and-execute-pattern" ;
    vc:sourceDomain "ai" .

ngm:planetary-exploration a owl:Class ;
    rdfs:label "Planetary Exploration"@en ;
    rdfs:comment "Planetary exploration is the robotic investigation of planets, moons, and other bodies using rovers, landers, and orbiters operating in remote, unstructured, communication-delayed environments. It demands highly autonomous navigation and perception because round-trip signal delays make teleoperation impractical, requiring robots to plan paths and avoid hazards on their own. It is a demanding proving ground for autonomous ground-robot capability."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:navigation ;
    vc:slug "planetary-exploration" ;
    vc:sourceDomain "robotics" .

ngm:platform-middleware a owl:Class ;
    rdfs:label "Platform Middleware"@en ;
    rdfs:comment "A software layer that connects operating systems, applications, and services by providing common capabilities such as API management, message routing, authentication, and data integration to enable seamless communication between diverse systems."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:software-infrastructure ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "platform-middleware" ;
    vc:sourceDomain "spatial-computing" .

ngm:player-engagement a owl:Class ;
    rdfs:label "Player Engagement"@en ;
    rdfs:comment "Player engagement is the degree to which a game holds a player's attention, motivation, and continued participation over time. It is measured through behavioural signals such as session length, retention, progression, and emotional investment. Game designers and AI systems optimise engagement to sustain player communities and, in token-based games, to drive economic activity."@en ;
    rdfs:subClassOf ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:play-to-earn-p2-e ;
    vc:slug "player-engagement" ;
    vc:sourceDomain "metaverse" .

ngm:player-two-code a owl:Class ;
    rdfs:label "Player Two code"@en ;
    rdfs:comment "Player Two code is the technical implementation layer of the Player Two platform, comprising a Vue.js front-end, BIP85-derived key management for trustless authentication, a Nostr-relay-based messaging architecture, and middleware whitelist logic. It enables encrypted group collaboration without server-held keys, using derivation path m/44'/1237 for per-user identity."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:collaboration-platform ;
    vc:enables ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decentralised-identity,
        ngm:player-two ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "player-two-code" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:cryptography .

ngm:pneumatic-motor a owl:Class ;
    rdfs:label "Pneumatic Motor"@en ;
    rdfs:comment "A Pneumatic Motor is an actuator that converts the energy stored in compressed air into continuous rotational mechanical motion, producing torque and speed proportional to the supply pressure and airflow rate. Pneumatic motors are characterised by high power-to-weight ratios, inherent overload protection through stall behaviour, and suitability for hazardous environments where electrical motors would pose ignition risks. They are widely used in industrial tooling, material handling equipment, and mobile robotics applications requiring lightweight, spark-free drive systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pneumatic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:torque ],
        ngm:pneumatic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:hydraulic-motor,
        ngm:servo-motor ;
    vc:enables ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:torque ;
    vc:isPartOf ngm:robo-actuation-and-control,
        ngm:robotic-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:pneumatic-cylinder,
        ngm:robotics-control ;
    vc:requires ngm:pneumatic-actuator ;
    vc:slug "pneumatic-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:torque-control .

ngm:podcast-production a owl:Class ;
    rdfs:label "Podcast Production"@en ;
    rdfs:comment "Podcast production is the end-to-end process of creating episodic audio programmes, encompassing recording, editing, mixing, mastering, and distribution. AI tools increasingly automate transcription, voice synthesis, noise removal, and chaptering. It is a key application domain for speech and audio machine-learning systems."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:music-and-audio,
        ngm:speech-and-voice ;
    vc:slug "podcast-production" ;
    vc:sourceDomain "ai" .

ngm:polkadot-parachains a owl:Class ;
    rdfs:label "Polkadot Parachains"@en ;
    rdfs:comment "Application-specific sovereign blockchains that lease a slot on the Polkadot Relay Chain, inheriting its shared security model and cross-chain messaging infrastructure. Parachains can have custom runtime logic, consensus rules, and token economics whilst relying on the relay chain's validator set for finalisation, enabling heterogeneous specialised chains to interoperate without sacrificing security or decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-interoperability,
        ngm:blockchain-scalability,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-network ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:blockchain-protocol,
        ngm:cross-chain-bridge,
        ngm:proof-of-stake,
        ngm:smart-contract ;
    vc:requires ngm:consensus-mechanism,
        ngm:nominated-proof-of-stake,
        ngm:validator-node,
        ngm:web-assembly ;
    vc:slug "polkadot-parachains" ;
    vc:sourceDomain "blockchain" .

ngm:polygon-agg-layer a owl:Class ;
    rdfs:label "Polygon AggLayer"@en ;
    rdfs:comment "The Polygon AggLayer (Aggregation Layer) is a cross-chain settlement protocol that unifies liquidity and state across independent Polygon and zk-based chains. It uses zero-knowledge proofs to aggregate proofs from connected chains and enable near-atomic cross-chain transactions while preserving each chain's sovereignty. It aims to make a network of L1s and L2s feel like a single unified chain."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:data-layer ;
    vc:slug "polygon-agg-layer" ;
    vc:sourceDomain "blockchain" .

ngm:portable-identity a owl:Class ;
    rdfs:label "Portable Identity"@en ;
    rdfs:comment "Portable identity is the property of a digital identity that allows it to be carried by its owner across services, platforms, and trust domains without being locked to any single provider. It relies on user-held credentials and identifiers that any relying party can verify cryptographically. Portability is a core goal of decentralised and self-sovereign identity systems."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:self-sovereign-identity ;
    vc:slug "portable-identity" ;
    vc:sourceDomain "security" .

ngm:positional-audio a owl:Class ;
    rdfs:label "Positional Audio"@en ;
    rdfs:comment "Positional Audio is a technique for rendering sound sources at specific locations within a 3D virtual or mixed-reality environment, simulating how sound propagates, attenuates, and is spatially perceived by the listener. It relies on head-related transfer functions (HRTFs) and room acoustics modelling to create realistic auditory presence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-spatialization ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-audio-system,
        ngm:spatial-audio ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-audio-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:procedural-audio-generator ;
    vc:requires ngm:audio-spatialization ;
    vc:slug "positional-audio" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audio-processing-system .

ngm:positive-feedback a owl:Class ;
    rdfs:label "Positive Feedback"@en ;
    rdfs:comment "Positive feedback is a control and systems mechanism in which the output of a process amplifies the input that produced it, reinforcing change rather than damping it. While destabilising in control systems, it underlies self-reinforcing dynamics such as network effects, exponential growth, and adoption cascades. Its behaviour contrasts with negative feedback, which seeks equilibrium."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:network-effects ;
    vc:slug "positive-feedback" ;
    vc:sourceDomain "infrastructure" .

ngm:power-electronics a owl:Class ;
    rdfs:label "Power Electronics"@en ;
    rdfs:comment "Power electronics is the engineering discipline concerned with the conversion and control of electrical power using switching semiconductor devices, central to motor drives, power supplies and energy systems."@en ;
    rdfs:subClassOf ngm:embedded-systems-domain ;
    vc:enables ngm:electric-motor,
        ngm:motor-driver ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "power-electronics" ;
    vc:sourceDomain "robotics" .

ngm:pre-production a owl:Class ;
    rdfs:label "Pre Production"@en ;
    rdfs:comment "Pre-production is the planning and preparation phase of a creative or software project that occurs before active content creation or development commences. It encompasses conceptual design, narrative structuring, technical specification, asset planning, and prototyping activities that reduce risk and align stakeholder expectations in film, game, and metaverse content pipelines."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-content-creation,
        ngm:virtual-environment-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:game-development ;
    vc:slug "pre-production" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-production-workflow,
        ngm:creative-tools .

ngm:precision-agriculture a owl:Class ;
    rdfs:label "Precision Agriculture"@en ;
    rdfs:comment "Precision agriculture is a farming-management approach that uses sensing, geolocation, and data analytics to observe and respond to variability within fields at fine spatial resolution. It applies inputs such as water, fertiliser, and pesticide only where and when needed, improving yield and reducing waste. It integrates IoT sensors, satellite and drone imagery, and increasingly autonomous ground robots."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:io-t-sensor-network ;
    vc:slug "precision-agriculture" ;
    vc:sourceDomain "robotics" .

ngm:predictions a owl:Class ;
    rdfs:label "Predictions"@en ;
    rdfs:comment "A curated set of near-term forecasts for the generative AI video and creative-tool landscape, covering model aggregators, story-level tooling, template ecosystems, real-time trend integration, open-source convergence, inference cost reduction, specialised models, and the social/legal challenges of AI-generated content. These predictions frame strategic planning for platforms operating in the AI creative economy."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:proprietary-ai-video ;
    vc:enables ngm:ai-generated-content-disclosure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-video,
        ngm:generative-ai,
        ngm:video-generation ;
    vc:slug "predictions" ;
    vc:sourceDomain "infrastructure" .

ngm:predictive-processing a owl:Class ;
    rdfs:label "Predictive Processing"@en ;
    rdfs:comment "Predictive processing is a theoretical framework in cognitive science and AI in which the brain or agent continuously generates predictions about sensory input and updates internal models to minimise prediction error. Perception, action, and learning are unified as processes of reducing the mismatch between expected and actual signals. It motivates active inference and free-energy approaches to embodied, cognitive systems."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-ai,
        ngm:embodied-minds ;
    vc:slug "predictive-processing" ;
    vc:sourceDomain "ai" .

ngm:pretrained-weights a owl:Class ;
    rdfs:label "Pretrained Weights"@en ;
    rdfs:comment "Pretrained Weights are the learned parameter tensors of a neural network obtained by training on a large corpus prior to task-specific adaptation. They encode generalised representations—syntactic, semantic, visual, or domain knowledge—that downstream tasks can exploit through fine-tuning or zero-shot inference, dramatically reducing the data and compute required to achieve strong performance on new problems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-architecture ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:neural-network,
        ngm:neural-network-architecture ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:feature-engineering,
        ngm:machine-learning,
        ngm:pretrained-model ;
    vc:requires ngm:deep-learning,
        ngm:model-training,
        ngm:training-data ;
    vc:slug "pretrained-weights" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:privacy-architecture a owl:Class ;
    rdfs:label "Privacy Architecture"@en ;
    rdfs:comment "A systematic design framework that embeds data protection principles into software systems from inception, incorporating privacy-by-design modologies, access controls, anonymization techniques, and compliance mechanisms to safeguard personal information."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety,
        ngm:system-architecture ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:data-privacy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "privacy-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:privacy-disclosure a owl:Class ;
    rdfs:label "Privacy Disclosure"@en ;
    rdfs:comment "The formal process by which platforms communicate to users what personal data is collected, how it is used, who it is shared with, and what rights users hold over it. In spatial computing and metaverse contexts, privacy disclosure must address novel data types including biometric signals, eye tracking, motion data, and behavioural analytics gathered in immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:privacy-framework ;
    vc:requires ngm:consent-management,
        ngm:data-protection ;
    vc:slug "privacy-disclosure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accountability .

ngm:privacy-impact-assessment-pia a owl:Class ;
    rdfs:label "Privacy Impact Assessment (PIA)"@en ;
    rdfs:comment "Systematic eprocess that identifies and assesses privacy risks arising from the processing of personal data in metaverse systems, ensuring compliance with data protection regulations and ical standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-requirements ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment-methodology ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-by-design,
        ngm:risk-mitigation,
        ngm:transparent-data-processing,
        ngm:user-trust ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-verification-system,
        ngm:impact-analysis-framework,
        ngm:mitigation-strategy-generator,
        ngm:risk-identification-module,
        ngm:stakeholder-consultation-engine ;
    vc:isPartOf ngm:data-protection-management-system,
        ngm:privacy-governance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-flow-mapping,
        ngm:privacy-requirements,
        ngm:regulatory-compliance-database,
        ngm:risk-assessment-methodology ;
    vc:slug "privacy-impact-assessment-pia" ;
    vc:sourceDomain "spatial-computing" .

ngm:privacy-preservation a owl:Class ;
    rdfs:label "Privacy Preservation"@en ;
    rdfs:comment "Privacy preservation is the practice and set of techniques for protecting personal or sensitive information against unauthorised access, inference, or disclosure while still permitting useful processing. It spans cryptographic methods, data minimisation, anonymisation, and policy controls. It is foundational to compliant data systems and to trust in digital services."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:privacy-filter ;
    vc:slug "privacy-preservation" ;
    vc:sourceDomain "security" .

ngm:privacy-preserving-compliance a owl:Class ;
    rdfs:label "Privacy-Preserving Compliance"@en ;
    rdfs:comment "Privacy-preserving compliance is the use of cryptographic and selective-disclosure techniques to satisfy regulatory requirements such as KYC, AML, and audit without exposing the underlying personal data. It lets a party prove a fact (e.g. age, jurisdiction, sanction-list status) to a regulator or counterparty while revealing nothing more. It is central to reconciling decentralised identity and digital-currency systems with financial regulation."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:hyperledger-indy ;
    vc:slug "privacy-preserving-compliance" ;
    vc:sourceDomain "governance" .

ngm:privacy-preserving-computation a owl:Class ;
    rdfs:label "Privacy-Preserving Computation"@en ;
    rdfs:comment "Privacy-preserving computation is a family of techniques that allow data to be processed or analysed without exposing the underlying plaintext to the computing party. It includes homomorphic encryption, secure multiparty computation, trusted execution environments, federated learning, and differential privacy. These methods enable collaboration and analytics over sensitive data while maintaining confidentiality."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:edge-computing ;
    vc:slug "privacy-preserving-computation" ;
    vc:sourceDomain "security" .

ngm:privacy-utility-tradeoffs a owl:Class ;
    rdfs:label "Privacy Utility Tradeoffs"@en ;
    rdfs:comment "Privacy-Utility Tradeoffs represent the fundamental tension in privacy-preserving AI between privacy preservation—protecting sensitive information through techniques such as differential privacy, anonymisation, or encryption—and model utility, which encompasses accuracy and other performance metrics necessary for effective decision-making. This tension is characterised by Pareto frontiers of achievable (privacy, utility) pairs where strengthening privacy typically degrades model performance and vice versa."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-budget-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:privacy-preserving-analytics,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:data-minimisation,
        ngm:encryption,
        ngm:fairness-accuracy-tradeoffs,
        ngm:gdpr-compliance ;
    vc:requires ngm:differential-privacy,
        ngm:privacy-budget-management ;
    vc:slug "privacy-utility-tradeoffs" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:k-anonymity-in-datasets .

ngm:probabilistic-forecasting a owl:Class ;
    rdfs:label "Probabilistic Forecasting"@en ;
    rdfs:comment "Probabilistic forecasting predicts future quantities as full probability distributions rather than single point estimates, quantifying uncertainty in the prediction. Outputs are typically expressed as predictive intervals, quantiles, or samples. It is essential for risk-aware decision-making in domains such as demand planning, energy, and finance where the cost of error is asymmetric."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model,
        ngm:time-series-forecasting ;
    vc:slug "probabilistic-forecasting" ;
    vc:sourceDomain "ai" .

ngm:probabilistic-inference a owl:Class ;
    rdfs:label "Probabilistic Inference"@en ;
    rdfs:comment "Probabilistic inference is the computation of the probability of unknown quantities given observed evidence within a probabilistic model. It produces posterior distributions used for prediction and decision making under uncertainty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bayesian-inference ],
        ngm:bayesian-inference ;
    vc:enables ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bayesian-inference,
        ngm:probabilistic-model ;
    vc:slug "probabilistic-inference" ;
    vc:sourceDomain "machine-learning" .

ngm:procedural-audio-generator a owl:Class ;
    rdfs:label "Procedural Audio Generator"@en ;
    rdfs:comment "System that produces context-sensitive sound effects algorithmically in real-time, generating audio content through computational rules rather than playing back pre-recorded samples."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter-modulation-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-awareness-system ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:adaptive-music,
        ngm:dynamic-soundscapes,
        ngm:interactive-audio,
        ngm:responsive-sound-effects ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-synthesis-engine,
        ngm:context-analysis-module,
        ngm:parameter-modulation-system,
        ngm:real-time-mixer ;
    vc:isPartOf ngm:audio-rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:audio-api,
        ngm:context-awareness-system,
        ngm:digital-signal-processing ;
    vc:slug "procedural-audio-generator" ;
    vc:sourceDomain "spatial-computing" .

ngm:procedural-texture a owl:Class ;
    rdfs:label "Procedural Texture"@en ;
    rdfs:comment "Algorithmically generated pattern used to simulate surface detail without stored images, computed on-demand using mathematical functions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter-set ],
        ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:dynamic-surface-detail,
        ngm:memory-efficient-texturing,
        ngm:procedural-materials,
        ngm:resolution-independent-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:noise-function,
        ngm:parameter-set,
        ngm:pattern-generator,
        ngm:shader-code ;
    vc:isPartOf ngm:material-system,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:gpu-shader,
        ngm:mathematical-functions,
        ngm:texture-coordinates ;
    vc:slug "procedural-texture" ;
    vc:sourceDomain "spatial-computing" .

ngm:process-control a owl:Class ;
    rdfs:label "Process Control"@en ;
    rdfs:comment "Process control is the discipline of regulating continuous industrial processes, such as chemical reactions, temperature, flow, and pressure, to maintain outputs at desired setpoints despite disturbances. It relies on sensors, controllers, and actuators arranged in feedback loops, using techniques from PID control to model predictive control. It is fundamental to manufacturing, energy, and process-industry automation."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:model-based-control ;
    vc:slug "process-control" ;
    vc:sourceDomain "robotics" .

ngm:product-liability-directive a owl:Class ;
    rdfs:label "Product Liability Directive"@en ;
    rdfs:comment "The Product Liability Directive is European Union legislation establishing rules on liability for damage caused by defective products. A revised directive adopted in 2024 extends its scope to software and AI systems."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "product-liability-directive" ;
    vc:sourceDomain "law" .

ngm:product-management a owl:Class ;
    rdfs:label "Product Management"@en ;
    rdfs:comment "Product management is the organisational function responsible for guiding a product through its lifecycle by defining vision, strategy, and roadmap based on user needs, business goals, and market conditions. It coordinates design, engineering, and go-to-market work and prioritises features against constraints. AI tools increasingly assist with research synthesis, prioritisation, and roadmap visualisation."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-diagram-tools,
        ngm:product-design ;
    vc:slug "product-management" ;
    vc:sourceDomain "infrastructure" .

ngm:production-design a owl:Class ;
    rdfs:label "Production Design"@en ;
    rdfs:comment "Production Design is the creative and technical discipline responsible for defining the visual aesthetic, spatial environment, and material world of a production — whether film, game, or virtual world. It spans concept art, environment modelling, asset creation pipelines, and art direction, ensuring visual coherence across all content elements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-content-creation ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:content-production-workflow,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-design,
        ngm:digital-content-creation ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "production-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:animation-software,
        ngm:creative-tools,
        ngm:design-software .

ngm:programmable-finance a owl:Class ;
    rdfs:label "Programmable Finance"@en ;
    rdfs:comment "Programmable finance is the encoding of financial logic, agreements, and assets as executable code on blockchains, so that payments, lending, settlement, and compliance execute automatically and verifiably. It is enabled by smart contracts that compose into open, permissionless financial primitives. It underpins decentralised finance and emerging layered scaling on networks such as Bitcoin."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3,
        ngm:smart-contract ;
    vc:slug "programmable-finance" ;
    vc:sourceDomain "blockchain" .

ngm:prohibited-ai-practice a owl:Class ;
    rdfs:label "Prohibited AI Practice"@en ;
    rdfs:comment "Prohibited AI Practices are categories of AI deployment banned under EU AI Act Article 5 (effective 2 February 2025), covering subliminal manipulation, exploitation of vulnerability groups, social scoring by public or private bodies, and real-time remote biometric identification in publicly accessible spaces. Violations carry fines up to €35 million or 7% of global annual turnover."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:content-moderation,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance-and-ethics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:gdpr-compliance ;
    vc:requires ngm:ai-governance,
        ngm:ai-regulation ;
    vc:slug "prohibited-ai-practice" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:project-agora a owl:Class ;
    rdfs:label "Project Agora"@en ;
    rdfs:comment "Project Agora is a cross-border wholesale payments initiative led by the Bank for International Settlements with several central banks and private financial institutions. It explores integrating tokenised commercial-bank deposits with tokenised central-bank money on a unified programmable ledger to improve cross-border settlement. It is a flagship experiment in the tokenisation of the monetary and financial system."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:hyperledger-iroha ;
    vc:slug "project-agora" ;
    vc:sourceDomain "blockchain" .

ngm:project-bro-bots a owl:Class ;
    rdfs:label "Project BroBots"@en ;
    rdfs:comment "Project BroBots is a multi-agent research initiative to identify, classify, and counter toxic online content using NLP-based harm detection and counter-narrative generation. It employs fine-tuned large language models on social media corpora, the Agentic Alliance tech stack, and is motivated by the harms of automated bot-driven misinformation and harassment across internet platforms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:death-of-the-internet,
        ngm:digital-society-harms ;
    vc:enables ngm:content-moderation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:projects ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "project-bro-bots" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:agentic-alliance,
        ngm:agents,
        ngm:natural-language-processing .

ngm:project-m-bridge a owl:Class ;
    rdfs:label "Project mBridge"@en ;
    rdfs:comment "A multi-central-bank initiative testing a shared distributed ledger platform for cross-border payments settled in central bank digital currencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:atomic-settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wholesale-cbdc ],
        ngm:cross-border-settlement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:atomic-settlement,
        ngm:wholesale-cbdc ;
    vc:slug "project-m-bridge" ;
    vc:sourceDomain "blockchain" .

ngm:project-nexus a owl:Class ;
    rdfs:label "Project Nexus"@en ;
    rdfs:comment "Project Nexus is a Bank for International Settlements initiative to interlink domestic instant-payment systems across countries through a standardised hub, enabling fast, low-cost cross-border retail payments. Rather than building a single global system, it provides a common protocol that connects existing national fast-payment rails. It is relevant to discussions of cross-border CBDC interoperability and payment-system modernisation."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:cbdcs ;
    vc:slug "project-nexus" ;
    vc:sourceDomain "blockchain" .

ngm:project-rosalind a owl:Class ;
    rdfs:label "Project Rosalind"@en ;
    rdfs:comment "A joint experiment by the Bank of England and the Bank for International Settlements Innovation Hub that explored how an application programming interface layer could support retail central bank digital currency payments. It tested programmability and interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank-digital-currency ],
        ngm:central-bank-digital-currency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:central-bank-digital-currency ;
    vc:slug "project-rosalind" ;
    vc:sourceDomain "finance" .

ngm:property-schema a owl:Class ;
    rdfs:label "Property Schema"@en ;
    rdfs:comment "A formal specification of the object properties, data properties, and annotation properties that relate classes within an ontology, including domain and range constraints, cardinality axioms, and logical characteristics such as transitivity and symmetry. Property schemas are the mechanism by which OWL2 ontologies encode typed, machine-readable relations between entities."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-graph,
        ngm:sparql ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:linked-data,
        ngm:semantic-web ;
    vc:isPartOf ngm:ontology,
        ngm:owl-class-hierarchy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "property-schema" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:rdf .

ngm:protein-structure-prediction a owl:Class ;
    rdfs:label "Protein Structure Prediction"@en ;
    rdfs:comment "Protein structure prediction is the computational determination of a protein's three-dimensional folded structure from its amino-acid sequence. Deep-learning systems such as AlphaFold, built on attention-based architectures, achieved near-experimental accuracy and transformed structural biology. It is a landmark AI application with deep impact on drug discovery and molecular biology."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:transformers ;
    vc:slug "protein-structure-prediction" ;
    vc:sourceDomain "ai" .

ngm:protocol-sustainability a owl:Class ;
    rdfs:label "Protocol Sustainability"@en ;
    rdfs:comment "Protocol sustainability is the capacity of a blockchain or DeFi protocol to remain economically viable, secure, and well-governed over the long term without relying on unsustainable token emissions or external subsidies. It depends on durable revenue, balanced tokenomics, treasury resilience, and active governance that can fund maintenance and development. It contrasts with growth models that depend on continuous inflationary incentives."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:tokenomics-governance,
        ngm:treasury-management ;
    vc:slug "protocol-sustainability" ;
    vc:sourceDomain "blockchain" .

ngm:protocol-upgrades a owl:Class ;
    rdfs:label "Protocol Upgrades"@en ;
    rdfs:comment "Protocol upgrades are coordinated modifications to the consensus rules, transaction format, or feature set of a blockchain network, deployed through soft forks, hard forks, or activation mechanisms. They allow a decentralised system to evolve while preserving network continuity and, where possible, backward compatibility. Because no central authority can impose changes, upgrades typically require broad stakeholder coordination and on-chain or social signalling."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:on-chain-voting ;
    vc:slug "protocol-upgrades" ;
    vc:sourceDomain "blockchain" .

ngm:provenance-ontology-prov-o a owl:Class ;
    rdfs:label "Provenance Ontology (PROV-O)"@en ;
    rdfs:comment "W3C standard ontology for representing and interchanging provenance information, capturing the origin, attribution, derivation, and lifecycle of digital entities through formal Entity-Activity-Agent relationships."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-store ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:audit-trail,
        ngm:blockchain-provenance,
        ngm:data-lineage-tracking,
        ngm:scientific-reproducibility,
        ngm:trust-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activity-model,
        ngm:agent-model,
        ngm:attribution-model,
        ngm:derivation-chains,
        ngm:entity-model,
        ngm:generation-events,
        ngm:influence-patterns,
        ngm:qualified-relations,
        ngm:usage-events ;
    vc:isPartOf ngm:semantic-web-standards ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ontology-reasoner,
        ngm:rdf-store,
        ngm:sparql-endpoint ;
    vc:slug "provenance-ontology-prov-o" ;
    vc:sourceDomain "spatial-computing" .

ngm:provenance-standard a owl:Class ;
    rdfs:label "Provenance Standard"@en ;
    rdfs:comment "Technical specifications and protocols for recording immutable ownership history and authenticity verification of digital assets through blockchain-based token IDs, contract addresses, and metadata that establish chain of custody from creation to present ownership."@en ;
    rdfs:subClassOf ngm:digital-asset-standards,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-authenticity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "provenance-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:pseudonymity a owl:Class ;
    rdfs:label "Pseudonymity"@en ;
    rdfs:comment "Pseudonymity is the state of acting under a persistent identifier that is not linked to one's real-world identity. It allows consistent reputation while concealing who a participant is."@en ;
    rdfs:subClassOf ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "pseudonymity" ;
    vc:sourceDomain "identity" .

ngm:psnr-metric a owl:Class ;
    rdfs:label "PSNR Metric"@en ;
    rdfs:comment "Peak Signal-to-Noise Ratio (PSNR) is an objective image- and video-quality metric expressing the ratio between the maximum possible signal power and the power of distorting noise, computed from the mean squared error between a reference and a degraded signal. Measured in decibels, higher PSNR values indicate closer fidelity to the original. It is widely used to benchmark lossy compression, restoration, and reconstruction algorithms despite its known weak correlation with perceived quality."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:image-and-video-restoration ;
    vc:slug "psnr-metric" ;
    vc:sourceDomain "ai" .

ngm:psychological-research a owl:Class ;
    rdfs:label "Psychological Research"@en ;
    rdfs:comment "Scientific investigation of mental health applications within virtual reality and metaverse environments, examining therapeutic benefits for conditions including PTSD, anxiety, and depression, while assessing potential risks such as addiction and attention impairment."@en ;
    rdfs:subClassOf ngm:research-methods,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:evidence-based-vr-treatment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "psychological-research" ;
    vc:sourceDomain "spatial-computing" .

ngm:public-access a owl:Class ;
    rdfs:label "Public Access"@en ;
    rdfs:comment "Public access is a data-governance and infrastructure model in which digital resources, collections, or services are made openly available to the general public without restrictive authentication or paywalls. In cultural-heritage and digital-curation contexts it underpins open repositories, online catalogues, and reading-room digitisation programmes. It balances openness against rights management, preservation constraints, and equitable availability."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-curation-platform,
        ngm:etsi-domain-data-management-cultural-heritage ;
    vc:slug "public-access" ;
    vc:sourceDomain "data" .

ngm:publish-subscribe-pattern a owl:Class ;
    rdfs:label "Publish-Subscribe Pattern"@en ;
    rdfs:comment "A messaging pattern in which senders, called publishers, categorise messages into topics without knowledge of which receivers, called subscribers, will consume them. A broker or event channel delivers messages to interested subscribers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-queue ],
        ngm:message-queue ;
    vc:enables ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:message-queue ;
    vc:slug "publish-subscribe-pattern" ;
    vc:sourceDomain "software-architecture" .

ngm:quadratic-programming a owl:Class ;
    rdfs:label "Quadratic Programming"@en ;
    rdfs:comment "Quadratic programming (QP) is a class of mathematical optimisation problems in which a quadratic objective function is minimised subject to linear equality and inequality constraints. It is a convex optimisation problem when the quadratic term is positive semidefinite, admitting efficient and globally optimal solvers. QP is foundational to model-based control, trajectory optimisation, and constrained robotic motion generation."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:model-based-control ;
    vc:slug "quadratic-programming" ;
    vc:sourceDomain "robotics" .

ngm:quantitative-finance a owl:Class ;
    rdfs:label "Quantitative Finance"@en ;
    rdfs:comment "Quantitative finance is the application of mathematical models, statistical methods, and computational techniques to financial markets for pricing, risk management, and trading. It draws heavily on stochastic calculus, probability theory, and optimisation to value derivatives, model asset dynamics, and construct portfolios. It is the analytical backbone of derivatives desks, algorithmic trading, and risk analytics."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stochastic-process,
        ngm:stochastic-processes ;
    vc:slug "quantitative-finance" ;
    vc:sourceDomain "infrastructure" .

ngm:quantum-cryptography a owl:Class ;
    rdfs:label "Quantum Cryptography"@en ;
    rdfs:comment "Quantum cryptography uses principles of quantum mechanics, such as the no-cloning theorem and measurement disturbance, to perform cryptographic tasks whose security rests on physical law rather than computational hardness. Its best-known application, quantum key distribution, lets two parties establish a shared secret with detectable eavesdropping. It is distinct from post-quantum cryptography, which is classical algorithms resistant to quantum attack."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:quantum-network-node ;
    vc:slug "quantum-cryptography" ;
    vc:sourceDomain "security" .

ngm:quantum-key-distribution a owl:Class ;
    rdfs:label "Quantum Key Distribution"@en ;
    rdfs:comment "A method of securely sharing cryptographic keys using the principles of quantum mechanics, such that any eavesdropping disturbs the transmission and can be detected. It provides key exchange whose security rests on physics rather than computational hardness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-computing ],
        ngm:quantum-computing ;
    vc:enables ngm:post-quantum-cryptography ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:quantum-computing ;
    vc:slug "quantum-key-distribution" ;
    vc:sourceDomain "cryptography" .

ngm:quasi-direct-drive a owl:Class ;
    rdfs:label "Quasi-Direct Drive"@en ;
    rdfs:comment "Quasi-direct drive (QDD) is an actuation architecture that pairs a high-torque electric motor with a low-ratio gearbox to achieve high force fidelity, backdrivability, and impact tolerance while retaining usable torque density. By minimising gear reduction it preserves transparency between the motor and the load, enabling accurate force sensing and control without dedicated torque sensors. It is a dominant approach in legged and dynamic robots."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "quasi-direct-drive" ;
    vc:sourceDomain "robotics" .

ngm:queries a owl:Class ;
    rdfs:label "Queries"@en ;
    rdfs:comment "Queries, in the Logseq context, are structured Datalog or advanced query expressions embedded in pages using the `#+BEGIN_QUERY` / `#+END_QUERY` syntax. They dynamically retrieve and display blocks or pages matching specified conditions—such as filtering private pages by the absence of a `#Public` tag—without modifying underlying data. In the broader NarrativeGoldmine ontology, Queries represent the retrieval-layer mechanism that surfaces knowledge from the graph at read time."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:information-retrieval,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:database-query,
        ngm:linked-data,
        ngm:semantic-web ;
    vc:slug "queries" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-management,
        ngm:knowledge-graph .

ngm:quic a owl:Class ;
    rdfs:label "QUIC"@en ;
    rdfs:comment "A transport layer network protocol built on UDP that provides multiplexed, encrypted, low-latency connections and forms the basis of HTTP/3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        ngm:communication-protocol ;
    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:communication-protocol ;
    vc:slug "quic" ;
    vc:sourceDomain "distributed-systems" .

ngm:rack-and-pinion-actuator a owl:Class ;
    rdfs:label "Rack and Pinion Actuator"@en ;
    rdfs:comment "A rack and pinion actuator is a mechanical transmission mechanism that converts rotary motion from a pinion gear into linear motion along a toothed rack, commonly used in robotics and industrial automation for precise linear positioning. The pinion rotates against the rack to produce controlled translational displacement, with speed and force determined by gear ratio and motor torque. It offers high stiffness, repeatability, and scalability for long-stroke linear axes in robotic manipulators and CNC systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stepper-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:electric-actuator ],
        ngm:electric-linear-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:hydraulic-actuator,
        ngm:lead-screw-actuator,
        ngm:pneumatic-actuator ;
    vc:enables ngm:position-control,
        ngm:robot-kinematics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder,
        ngm:stepper-motor ;
    vc:isPartOf ngm:industrial-automation,
        ngm:manipulator ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:robot-joint ;
    vc:requires ngm:electric-actuator,
        ngm:motion-control,
        ngm:torque ;
    vc:slug "rack-and-pinion-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:dc-servo-motor,
        ngm:forward-kinematics .

ngm:radio-access-network a owl:Class ;
    rdfs:label "Radio Access Network"@en ;
    rdfs:comment "A radio access network (RAN) is the part of a mobile telecommunications system that connects user devices to the core network over the air interface via base stations and antennas. It manages radio resource allocation, modulation, and handover across cells. Modern architectures such as Open RAN disaggregate hardware and software to enable multi-vendor, virtualised deployments."@en ;
    rdfs:subClassOf ngm:network-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer,
        ngm:wireless-radio ;
    vc:slug "radio-access-network" ;
    vc:sourceDomain "infrastructure" .

ngm:ray-marching a owl:Class ;
    rdfs:label "Ray Marching"@en ;
    rdfs:comment "Ray Marching is a rendering technique in which a ray is incrementally stepped through a scene, evaluating a signed distance field (SDF) at each step to determine proximity to geometry. The step size adapts to the SDF value (sphere tracing), enabling efficient rendering of implicit surfaces, volumetric effects, soft shadows, and ambient occlusion that are impractical with triangle-based rasterisation. It is widely implemented in GPU shader programs and is foundational to procedural 3D scene generation in real-time and offline contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        ngm:rendering-technique,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:rasterization,
        ngm:ray-tracing ;
    vc:enables ngm:global-illumination,
        ngm:procedural-generation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:gpu-compute,
        ngm:shader ;
    vc:slug "ray-marching" ;
    vc:sourceDomain "spatial-computing" .

ngm:rb-0012-wheeled-mobile-robot a owl:Class ;
    rdfs:label "rb 0012 wheeled mobile robot"@en ;
    rdfs:comment "A wheeled mobile robot (WMR) is a ground-based autonomous or semi-autonomous robot that uses wheels for locomotion. WMRs range from differential-drive platforms to omnidirectional holonomic designs; they rely on odometry for dead-reckoning, SLAM for map building, and path-planning algorithms for autonomous navigation in structured or semi-structured environments."@en ;
    rdfs:subClassOf ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:dependsOn ngm:autonomous-navigation,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:differential-drive-robot,
        ngm:mobile-robot-platform,
        ngm:wheeled-mobile-robot ;
    vc:slug "rb-0012-wheeled-mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:odometry,
        ngm:rb-0075-range-finder,
        ngm:slam .

ngm:rb-0027-robot-link a owl:Class ;
    rdfs:label "rb 0027 robot link"@en ;
    rdfs:comment "A robot link is a rigid (or semi-rigid) structural body that forms one segment of a robot's kinematic chain, connecting adjacent joints and transmitting forces and torques between them. Links define the geometry of the robot's workspace by their length, mass, and inertial properties, and together with joints they constitute the Denavit-Hartenberg representation used in forward and inverse kinematics. Link stiffness, material choice, and mass distribution directly affect dynamic performance, vibration characteristics, and safety in human-robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint,
        ngm:robot-link ;
    vc:isPartOf ngm:robot,
        ngm:robot-kinematics ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:inertia,
        ngm:kinematics,
        ngm:rb-0039-stiffness,
        ngm:rigid-body ;
    vc:slug "rb-0027-robot-link" ;
    vc:sourceDomain "robotics" .

ngm:rb-0033-payload a owl:Class ;
    rdfs:label "rb 0033 payload"@en ;
    rdfs:comment "Payload in robotics refers to the maximum mass that a robot can carry or manipulate while maintaining its specified performance characteristics, including accuracy, repeatability, and speed. Payload capacity is a fundamental design parameter for robot arms, mobile robots, and drones, directly constraining the tools, parts, or cargo the robot can handle. It is typically quoted at the wrist or end-effector mounting face and may vary with configuration and speed; dynamic payload accounts for inertial forces during acceleration."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0039-stiffness ;
    vc:enables ngm:end-effector ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy,
        ngm:rb-0041-inertia,
        ngm:rb-0043-torque ;
    vc:slug "rb-0033-payload" ;
    vc:sourceDomain "robotics" .

ngm:rb-0040-backlash a owl:Class ;
    rdfs:label "rb 0040 backlash"@en ;
    rdfs:comment "Backlash in robotics is the lost motion in a mechanical transmission — the angular or linear displacement of the output element when the input reverses direction without producing corresponding output movement, caused by clearance gaps between mating gear teeth or other drive components. Backlash degrades positional accuracy and repeatability, introduces nonlinearity into the control loop, and can cause oscillation or chattering in feedback control systems. Minimising backlash is critical for precision robot joints, and it is typically reduced through the use of preloaded gear pairs, harmonic drives, or cycloidal transmissions."@en ;
    rdfs:subClassOf ngm:backlash,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:actuator ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0038-compliance,
        ngm:rb-0039-stiffness,
        ngm:rb-0043-torque,
        ngm:rb-0047-feedback-control ;
    vc:slug "rb-0040-backlash" ;
    vc:sourceDomain "robotics" .

ngm:rb-0073-imu a owl:Class ;
    rdfs:label "rb 0073 imu"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device that measures and reports a body's specific force, angular rate, and sometimes magnetic field using a combination of accelerometers, gyroscopes, and optional magnetometers. In robotics, IMUs provide high-frequency proprioceptive feedback for state estimation, pose tracking, and stabilisation control, and are commonly fused with odometry or SLAM algorithms to reduce drift."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gyroscope ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accelerometer ],
        ngm:inertial-measurement-unit,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:localization,
        ngm:odometry,
        ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accelerometer,
        ngm:gyroscope ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0066-robot-sensor,
        ngm:rb-0072-encoder,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "rb-0073-imu" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-navigation .

ngm:rb-0078-infrared-sensor a owl:Class ;
    rdfs:label "rb 0078 infrared sensor"@en ;
    rdfs:comment "An infrared (IR) sensor is an exteroceptive sensor that detects and measures infrared radiation emitted or reflected by objects in the environment, enabling proximity detection, thermal profiling, and obstacle identification in robotic systems. IR sensors operate across near-infrared (NIR), short-wave, mid-wave, and long-wave bands; common robotics applications include proximity switches, line-following, and thermal imaging for human detection. They complement other ranging sensors such as LiDAR and ultrasonic devices, and are frequently fused in multi-modal perception pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:infrared-sensor,
        ngm:proximity-sensor,
        ngm:rb-0066-robot-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0075-range-finder ;
    vc:slug "rb-0078-infrared-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0052-collision-avoidance,
        ngm:rb-0095-safety-zone ;
    vc:uses ngm:exteroceptive-sensor,
        ngm:sensor-fusion .

ngm:rb-0101-performance-level a owl:Class ;
    rdfs:label "rb 0101 performance level"@en ;
    rdfs:comment "Performance Level (PL) is a discrete safety metric defined in ISO 13849-1 that quantifies the ability of a safety-related control system to perform a safety function under foreseeable conditions. Levels range from PLa (lowest) to PLe (highest), each corresponding to a target probability of dangerous failure per hour. PL is determined through risk assessment and verified against the required PL (PLr) derived from the hazard and risk analysis of the application."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:rb-0089-risk-assessment,
        ngm:rb-0100-safety-integrity-level ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0090-emergency-stop ;
    vc:slug "rb-0101-performance-level" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-10218 ;
    vc:supports ngm:rb-0096-safeguarding .

ngm:rb-0104-hand-guiding a owl:Class ;
    rdfs:label "rb 0104 hand guiding"@en ;
    rdfs:comment "Hand guiding is a collaborative robot operation mode in which an operator physically moves the robot arm by direct physical contact, typically through a dedicated hand-guiding device, while the robot's safety systems monitor force, speed, and separation. It is one of four collaborative operation modes defined in ISO/TS 15066 and ISO 10218, enabling intuitive programming-by-demonstration and safe human-robot co-manipulation tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0056-impedance-control ],
        ngm:human-robot-interaction,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0103-collaborative-operation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:rb-0007-collaborative-robot,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0056-impedance-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0104-hand-guiding" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 .

ngm:rdf-schema a owl:Class ;
    rdfs:label "RDF Schema"@en ;
    rdfs:comment "A World Wide Web Consortium vocabulary that extends the Resource Description Framework with the means to describe classes, properties and their hierarchies. It provides a lightweight modelling layer for typing resources and defining property domains and ranges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:rdf ;
    vc:enables ngm:owl-2-web-ontology-language,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:rdf ;
    vc:slug "rdf-schema" ;
    vc:sourceDomain "general" .

ngm:re-act-pattern a owl:Class ;
    rdfs:label "ReAct Pattern"@en ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting and agent-control pattern in which a language model interleaves explicit reasoning traces with action steps such as tool calls, observing the results before reasoning again. This loop lets the model decompose tasks, gather information, and self-correct rather than answering in a single pass. It is a foundational design for tool-using LLM agents."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:function-calling ;
    vc:slug "re-act-pattern" ;
    vc:sourceDomain "ai" .

ngm:re-lu-activation a owl:Class ;
    rdfs:label "ReLU Activation"@en ;
    rdfs:comment "The Rectified Linear Unit (ReLU) is a nonlinear activation function defined as f(x) = max(0, x), outputting the input directly when positive and zero otherwise. Its simplicity, sparse activation, and non-saturating gradient for positive inputs make it the default activation in most deep neural networks, mitigating the vanishing-gradient problem. Variants such as Leaky ReLU and GELU address its dead-neuron limitation."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai,
        ngm:generative-adversarial-networks ;
    vc:slug "re-lu-activation" ;
    vc:sourceDomain "ai" .

ngm:real-estate-tokenization a owl:Class ;
    rdfs:label "Real Estate Tokenization"@en ;
    rdfs:comment "Blockchain-based systems employing security tokens (ERC-3643, ERC-1400, ERC-20 standards) to represent fractional ownership interests in real estate properties, enabling automated dividend distribution through smart contracts, reducing investment minimums from tens of thousands to £50, and creati..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:dependsOn ngm:blockchain-compliance ;
    vc:enables ngm:decentralised-finance,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:decentralised-identity,
        ngm:smart-contract ;
    vc:slug "real-estate-tokenization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:distributed-ledger-technology .

ngm:real-time-collaborative-editing a owl:Class ;
    rdfs:label "Real-Time Collaborative Editing"@en ;
    rdfs:comment "Real-time collaborative editing is the capability for multiple users to concurrently modify a shared document or data structure and see each other's changes near-instantaneously with automatic conflict resolution. It depends on synchronisation algorithms such as operational transformation or conflict-free replicated data types to maintain a consistent merged state across replicas. It underpins shared documents, whiteboards, and collaborative virtual workspaces."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "real-time-collaborative-editing" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-digital-twin-synchronization a owl:Class ;
    rdfs:label "Real Time Digital Twin Synchronization"@en ;
    rdfs:comment "The continuous bidirectional data exchange between physical industrial assets and their virtual replicas in the industrial metaverse, enabling real-time monitoring, predictive maintenance, and scenario testing through IoT sensor integration and cloud-based rendering."@en ;
    rdfs:subClassOf ngm:digital-twin-technology,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-real-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "real-time-digital-twin-synchronization" ;
    vc:sourceDomain "spatial-computing" .

ngm:real-time-language-translation a owl:Class ;
    rdfs:label "Real-Time Language Translation"@en ;
    rdfs:comment "\"The use of artificial intelligence-powered natural language processing to automatically translate spoken or written communication between languages during live telepresence interactions with sub-second latency, enabling cross-lingual collaboration without human interpreters through neural machin..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-machine-translation ],
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:cross-lingual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:neural-machine-translation ;
    vc:slug "real-time-language-translation" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:real-time-settlement a owl:Class ;
    rdfs:label "Real-Time Settlement"@en ;
    rdfs:comment "Real-time settlement is the immediate, final transfer of value between parties at the moment of transaction, eliminating the delay and counterparty risk of deferred net settlement cycles. In payments and securities it collapses the gap between trade and final exchange of funds. Distributed ledgers and central bank digital currencies enable atomic, near-instant settlement around the clock."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:financial-infrastructure-domain ;
    vc:slug "real-time-settlement" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-vfx a owl:Class ;
    rdfs:label "Real-Time VFX"@en ;
    rdfs:comment "Real-time VFX is the generation of visual effects such as particles, fluids, fire, and dynamic simulations rendered live at interactive frame rates rather than pre-baked offline. It leverages GPU compute, particle systems, and procedural techniques to produce reactive effects within a game or virtual-production frame budget. It enables interactive spectacle in games, live events, and metaverse experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:particle-systems,
        ngm:procedural-and-hybrid-4-d ;
    vc:slug "real-time-vfx" ;
    vc:sourceDomain "metaverse" .

ngm:reality-capture-workflow a owl:Class ;
    rdfs:label "Reality Capture Workflow"@en ;
    rdfs:comment "A reality capture workflow is the end-to-end pipeline that converts real-world objects, people, or environments into digital 3D assets through sensing, alignment, reconstruction, and optimisation stages. It typically chains scanning techniques such as photogrammetry, LiDAR, or volumetric capture with mesh generation, texturing, and retopology steps. The workflow matters because asset fidelity and downstream usability depend on disciplined sequencing of capture, processing, and cleanup."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-performance-capture,
        ngm:photogrammetry ;
    vc:slug "reality-capture-workflow" ;
    vc:sourceDomain "metaverse" .

ngm:reality-eth-oracle a owl:Class ;
    rdfs:label "Reality ETH Oracle"@en ;
    rdfs:comment "Reality.eth is an Ethereum-based crowdsourced oracle that resolves arbitrary questions by escalating bonds, allowing anyone to post or challenge answers until an economically final result is reached. It feeds resolved outcomes into smart contracts and is widely used to settle governance proposals and prediction-market events. The escalation-game design lets it answer subjective or off-chain questions that price-feed oracles cannot."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-tooling,
        ngm:snapshot-voting ;
    vc:slug "reality-eth-oracle" ;
    vc:sourceDomain "blockchain" .

ngm:reasoning-models a owl:Class ;
    rdfs:label "Reasoning Models"@en ;
    rdfs:comment "Reasoning models are large language models trained or post-trained to generate extended intermediate chains of thought before producing a final answer, trading inference-time compute for higher accuracy on complex tasks. They are typically optimised with reinforcement learning on verifiable problems in mathematics, coding, and logic. By spending more tokens deliberating, they outperform standard models on multi-step problems where single-pass generation fails."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:frontier-models,
        ngm:prime-intellect ;
    vc:slug "reasoning-models" ;
    vc:sourceDomain "ai" .

ngm:reciprocal-rank-fusion a owl:Class ;
    rdfs:label "Reciprocal Rank Fusion"@en ;
    rdfs:comment "Reciprocal Rank Fusion (RRF) is a rank-aggregation method that combines multiple ranked result lists by summing the reciprocal of each document's rank across lists, weighted by a small smoothing constant. It requires no score calibration between systems, making it ideal for merging lexical and vector retrieval results in hybrid search. Its robustness and parameter simplicity have made it a default fusion technique in modern retrieval pipelines."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:semantic-search ;
    vc:slug "reciprocal-rank-fusion" ;
    vc:sourceDomain "ai" .

ngm:record-keeping-system a owl:Class ;
    rdfs:label "Record Keeping System"@en ;
    rdfs:comment "A Record Keeping System, in the blockchain domain, is an immutable, append-only ledger in which transactions or state changes are cryptographically hashed, linked via Merkle trees, and validated by a consensus mechanism to provide a tamper-evident audit trail. It replaces or augments traditional centralised databases in applications requiring transparent provenance, non-repudiation, and multi-party data integrity—including asset registries, supply-chain tracking, and compliance logging."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:data-provenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:smart-contract ;
    vc:slug "record-keeping-system" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:distributed-ledger,
        ngm:merkle-tree .

ngm:rectified-flow a owl:Class ;
    rdfs:label "Rectified Flow"@en ;
    rdfs:comment "Rectified Flow is a generative modelling framework that trains a velocity field to transport samples along straight-line trajectories in the ODE sense between a source noise distribution and a target data distribution. By reflow iterations—repeatedly pairing coupled samples and re-training—the learned trajectories become increasingly linear, minimising the number of function evaluations (NFEs) required at inference time. The approach unifies flow matching and score-based diffusion models, offering competitive image and video generation quality with substantially faster sampling compared to standard diffusion schedules."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:flow-matching ;
    vc:slug "rectified-flow" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model .

ngm:reflexion a owl:Class ;
    rdfs:label "Reflexion"@en ;
    rdfs:comment "Reflexion is a framework for language-model agents that converts feedback from failed attempts into reflective verbal self-critiques stored in an episodic memory, which condition subsequent attempts. Rather than updating model weights, it reinforces behaviour through natural-language reflections, enabling rapid trial-and-error learning. It improves agent performance on decision-making, reasoning, and coding benchmarks across repeated episodes."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reflexion" ;
    vc:sourceDomain "ai" .

ngm:regulatory-capture a owl:Class ;
    rdfs:label "Regulatory Capture"@en ;
    rdfs:comment "Regulatory capture is a situation in which a regulator advances the interests of the entities it oversees rather than the public interest."@en ;
    rdfs:subClassOf ngm:regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "regulatory-capture" ;
    vc:sourceDomain "governance" .

ngm:regulatory-compliance-domain a owl:Class ;
    rdfs:label "Regulatory Compliance Domain"@en ;
    rdfs:comment "The Regulatory Compliance Domain classifies concepts concerning the practices by which organisations meet and demonstrate adherence to applicable rules. It covers controls, monitoring, evidence and the audit processes that confirm conformance. As a top-level subject axis it operationalises the obligations set by the Regulatory Domain within systems and processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:evidence-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-framework ],
        ngm:owl-thing ;
    vc:enables ngm:audit-readiness,
        ngm:certification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:attestation,
        ngm:audit-trail,
        ngm:compliance-monitoring,
        ngm:control-framework,
        ngm:evidence-collection ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-governance-domain,
        ngm:regulatory-domain ;
    vc:slug "regulatory-compliance-domain" ;
    vc:sourceDomain "regulatory-compliance" .

ngm:regulatory-conformance a owl:Class ;
    rdfs:label "Regulatory Conformance"@en ;
    rdfs:comment "Regulatory conformance is the demonstrable state of an organisation's systems and processes meeting the legal and regulatory requirements applicable to its domain. It is evidenced through controls, documentation, and audits that map obligations to operational practice. For AI and data systems, conformance increasingly covers risk classification, transparency, and accountability mandates."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-domain,
        ngm:compliance-domain ;
    vc:slug "regulatory-conformance" ;
    vc:sourceDomain "governance" .

ngm:regulatory-reporting-automation a owl:Class ;
    rdfs:label "Regulatory Reporting Automation"@en ;
    rdfs:comment "Regulatory reporting automation is the use of software, and increasingly smart contracts, to generate and submit mandated regulatory reports directly from source transaction data without manual compilation. On enterprise and consortium blockchains, shared ledgers let supervisors receive standardised, near-real-time disclosures. Automating reporting reduces error, lowers compliance cost, and shortens the lag between activity and oversight."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consortium-blockchain,
        ngm:enterprise-smart-contracts ;
    vc:slug "regulatory-reporting-automation" ;
    vc:sourceDomain "blockchain" .

ngm:rehabilitation-robotics a owl:Class ;
    rdfs:label "Rehabilitation Robotics"@en ;
    rdfs:comment "Rehabilitation robotics is the field of robotic devices that assist therapy and recovery of motor function, including exoskeletons, end-effector trainers, and assistive manipulators. These systems deliver repeatable, intensity-controlled movement while measuring patient progress, and rely on compliant, force-controlled actuation to interact safely with the body. They aim to improve outcomes and scale access to physical therapy."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:pneumatic-actuator ;
    vc:slug "rehabilitation-robotics" ;
    vc:sourceDomain "robotics" .

ngm:remittances a owl:Class ;
    rdfs:label "Remittances"@en ;
    rdfs:comment "Remittances are cross-border transfers of money, typically sent by migrant workers to family in their home country, representing a major global flow of funds to developing economies. Traditional rails impose high fees and slow settlement, which cryptocurrencies and the Lightning Network aim to reduce. As a use case, remittances anchor much of the argument for Bitcoin and stablecoins as practical money."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:bitcoin-value-proposition ;
    vc:slug "remittances" ;
    vc:sourceDomain "blockchain" .

ngm:remote-education a owl:Class ;
    rdfs:label "Remote Education"@en ;
    rdfs:comment "Remote education is the delivery of teaching and learning to geographically dispersed participants over digital networks, spanning live virtual classrooms, recorded content, and immersive metaverse environments. It depends on collaboration tools such as breakout rooms, shared media, and presence to recreate interactive instruction. Immersive variants add spatial co-presence to improve engagement over flat video."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room,
        ngm:education-metaverse ;
    vc:slug "remote-education" ;
    vc:sourceDomain "metaverse" .

ngm:remote-work-infrastructure a owl:Class ;
    rdfs:label "Remote Work Infrastructure"@en ;
    rdfs:comment "Remote work infrastructure is the combined set of networking, collaboration, and presence technologies that let distributed teams work together as if co-located. It includes real-time communication, shared workspaces, presence and status signalling, and adaptive transport that copes with variable connectivity. As workforces decentralise, this infrastructure underpins productivity, security, and a sense of shared presence."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:presence-indicator ;
    vc:slug "remote-work-infrastructure" ;
    vc:sourceDomain "metaverse" .

ngm:remotely-operated-vehicle-rov a owl:Class ;
    rdfs:label "Remotely Operated Vehicle (ROV)"@en ;
    rdfs:comment "A Remotely Operated Vehicle (ROV) is a tethered underwater robot controlled by a human operator at the surface via a cable that supplies electrical power and bidirectional communications. ROVs are deployed for inspection, maintenance, and intervention tasks in environments too hazardous or deep for human divers, including oil and gas infrastructure, offshore wind farms, and scientific ocean exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        ngm:robo-robot-type,
        ngm:underwater-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:camera,
        ngm:control-system,
        ngm:sensor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:inspection-robot,
        ngm:marine-robot,
        ngm:robotics ;
    vc:slug "remotely-operated-vehicle-rov" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:navigation,
        ngm:sensor-fusion .

ngm:render-target a owl:Class ;
    rdfs:label "Render Target"@en ;
    rdfs:comment "A memory buffer or texture surface to which a GPU writes the output of a rendering pass, including the default framebuffer displayed on screen and off-screen targets used for post-processing effects, shadow maps, reflections, and multi-pass rendering in real-time graphics pipelines."@en ;
    rdfs:subClassOf ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pixel-shader,
        ngm:shader,
        ngm:vertex-shader ;
    vc:slug "render-target" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute .

ngm:renewable-energy-tracking a owl:Class ;
    rdfs:label "Renewable Energy Tracking"@en ;
    rdfs:comment "Renewable energy tracking is the verifiable measurement and accounting of clean-energy generation and consumption, often recorded on a ledger to prevent double counting of attributes. It underpins renewable energy certificates by binding each megawatt-hour to a unique, auditable claim. Reliable tracking is essential for credible decarbonisation reporting and voluntary climate commitments."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crypto-climate-accord,
        ngm:renewable-energy-certificates ;
    vc:slug "renewable-energy-tracking" ;
    vc:sourceDomain "blockchain" .

ngm:reproducibility a owl:Class ;
    rdfs:label "Reproducibility"@en ;
    rdfs:comment "The ability to obtain consistent results using the same data and methods, a central criterion for the reliability and credibility of scientific findings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:replication ],
        ngm:quality-assurance ;
    vc:enables ngm:robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:replication ;
    vc:slug "reproducibility" ;
    vc:sourceDomain "general" .

ngm:reputation-data a owl:Class ;
    rdfs:label "Reputation Data"@en ;
    rdfs:comment "A structured dataset containing historical records of user behavior, transaction outcomes, peer feedback, and trust metrics used to calculate reputation scores in peer-to-peer systems and virtual communities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-history ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timestamp-service ],
        ngm:reputation-system,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:access-control,
        ngm:community-moderation,
        ngm:fraud-detection,
        ngm:trust-scoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavioral-pattern,
        ngm:feedback-score,
        ngm:transaction-history,
        ngm:trust-indicator ;
    vc:isPartOf ngm:reputation-system,
        ngm:social-graph,
        ngm:trust-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-storage,
        ngm:identity-provider,
        ngm:timestamp-service ;
    vc:slug "reputation-data" ;
    vc:sourceDomain "spatial-computing" .

ngm:reputation-scoring-model a owl:Class ;
    rdfs:label "Reputation Scoring Model"@en ;
    rdfs:comment "An algorithmic process that computes quantitative reputation scores by aggregating behavioral data, applying weighted scoring functions, implementing temporal decay, and evaluating threshold conditions to generate trust indicators for entities in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reputation-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-rules ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control-decisions,
        ngm:governance-voting-weight,
        ngm:risk-assessment,
        ngm:trust-score-metric ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:behavioral-data-aggregator,
        ngm:temporal-decay-engine,
        ngm:threshold-evaluator,
        ngm:weighted-scoring-function ;
    vc:isPartOf ngm:trust-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:behavioral-models,
        ngm:reputation-data,
        ngm:scoring-algorithms,
        ngm:validation-rules ;
    vc:slug "reputation-scoring-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:rescue-robot a owl:Class ;
    rdfs:label "Rescue Robot"@en ;
    rdfs:comment "A Rescue Robot is a specialised mobile robot engineered to operate in hazardous, unstructured environments—including collapsed structures, disaster zones, and nuclear incidents—where direct human presence is unsafe. Such systems integrate multimodal locomotion (tracked, wheeled, or legged), sensor suites (IR, LIDAR, acoustic, tactile), and teleoperation or autonomous navigation to locate, assess, and extract casualties or gather situational data. Conformance with safety standards such as ISO 8373 and participation in benchmarks such as the RoboCup Rescue Robot League drives continuous capability development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:functional-safety ;
    vc:requires ngm:autonomous-navigation,
        ngm:sensor-fusion ;
    vc:slug "rescue-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:human-robot-interaction,
        ngm:path-planning .

ngm:research-agents a owl:Class ;
    rdfs:label "Research Agents"@en ;
    rdfs:comment "Research agents are autonomous LLM-based systems that plan and execute multi-step information-gathering tasks, issuing searches, reading sources, and synthesising cited findings into reports. They combine tool use, memory, and reasoning to pursue an objective across many web or document queries with minimal supervision. They represent a leading application of agentic AI for knowledge work."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agentic-internet,
        ngm:context-engineering ;
    vc:slug "research-agents" ;
    vc:sourceDomain "ai" .

ngm:resolution-test-chart a owl:Class ;
    rdfs:label "Resolution Test Chart"@en ;
    rdfs:comment "Standardized calibration patterns such as ISO 12233 charts used to measure and validate the optical resolution, colour accuracy, and image quality of displays in virtual reality and augmented reality headsets through computational analysis."@en ;
    rdfs:subClassOf ngm:calibration-tools,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:display-calibration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "resolution-test-chart" ;
    vc:sourceDomain "spatial-computing" .

ngm:resource-efficiency a owl:Class ;
    rdfs:label "Resource Efficiency"@en ;
    rdfs:comment "Resource efficiency is the practice of producing the same output or value while consuming fewer material, energy, or computational inputs. It encompasses minimising waste, reusing by-products, and optimising processes so that resources deliver maximum useful work. In sustainability and industrial contexts it is a primary lever for reducing cost and environmental footprint."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-symbiosis,
        ngm:performance-optimization ;
    vc:slug "resource-efficiency" ;
    vc:sourceDomain "infrastructure" .

ngm:responsible-deployment a owl:Class ;
    rdfs:label "Responsible Deployment"@en ;
    rdfs:comment "Responsible deployment is the disciplined release of AI systems into production with safeguards that manage risk to users and society throughout the system lifecycle. It involves staged rollout, monitoring, impact assessment, access controls, and the ability to roll back or restrict capabilities when harms emerge. It operationalises governance principles at the point where models meet real users."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-domain,
        ngm:social-impact-assessment-sia ;
    vc:slug "responsible-deployment" ;
    vc:sourceDomain "ai" .

ngm:revenue-distribution a owl:Class ;
    rdfs:label "Revenue Distribution"@en ;
    rdfs:comment "Revenue Distribution is the mechanism by which income generated by a platform, protocol, or creative ecosystem is allocated among contributors, token holders, and operational costs. In Web3 and spatial computing contexts, it is commonly encoded in smart contracts via tokenomics rules, protocol fee splits, and DAO-governed treasury allocations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:economic-systems ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:treasury-management ;
    vc:requires ngm:smart-contract,
        ngm:tokenomics ;
    vc:slug "revenue-distribution" ;
    vc:sourceDomain "spatial-computing" .

ngm:revenue-sharing a owl:Class ;
    rdfs:label "Revenue Sharing"@en ;
    rdfs:comment "Blockchain-enabled distribution mechanisms that automatically allocate earnings between creators, platforms, and stakeholders through smart contracts, with NFT royalties providing perpetual income streams for digital asset creators in metaverse economies."@en ;
    rdfs:subClassOf ngm:creator-economy,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:creator-monetization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "revenue-sharing" ;
    vc:sourceDomain "spatial-computing" .

ngm:right-to-be-forgotten a owl:Class ;
    rdfs:label "Right to Be Forgotten"@en ;
    rdfs:comment "A privacy right framework enabling individuals to request deletion or removal of personal data from online platforms and databases, with verification and audit mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:infra-legal-and-regulatory,
        ngm:privacy-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:compliance-reporting,
        ngm:content-removal,
        ngm:data-erasure,
        ngm:user-privacy-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:deletion-request,
        ngm:erasure-verification,
        ngm:privacy-policy ;
    vc:isPartOf ngm:data-protection-framework,
        ngm:privacy-rights-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:consent-management,
        ngm:data-inventory,
        ngm:identity-verification ;
    vc:slug "right-to-be-forgotten" ;
    vc:sourceDomain "infrastructure" .

ngm:rigid-body a owl:Class ;
    rdfs:label "Rigid Body"@en ;
    rdfs:comment "A Rigid Body is an idealised mechanical object whose internal distances between all constituent points remain constant regardless of applied forces, making it the foundational abstraction for classical mechanics, robotic kinematics, and physics simulation. In robotics, links of a kinematic chain are modelled as rigid bodies connected by joints; their mass, centre of gravity, and inertia tensor parameterise the dynamics equations used for motion planning, control, and simulation. Rigid body assumptions break down for flexible or soft-robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:control-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:kinematics ;
    vc:isPartOf ngm:robot-component ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "rigid-body" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:forward-kinematics,
        ngm:inverse-kinematics .

ngm:risk-based-authentication a owl:Class ;
    rdfs:label "Risk-Based Authentication"@en ;
    rdfs:comment "Risk-based authentication (RBA) is an adaptive security method that adjusts the strength of identity verification based on the assessed risk of a login attempt. It evaluates contextual signals such as device, location, network reputation, and behaviour to decide whether to allow access, require step-up factors, or block the request. RBA balances security and usability by escalating friction only when risk is elevated."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-provider,
        ngm:trust-framework ;
    vc:slug "risk-based-authentication" ;
    vc:sourceDomain "security" .

ngm:ritual-artifact a owl:Class ;
    rdfs:label "Ritual Artifact"@en ;
    rdfs:comment "Digital objects within virtual worlds that hold cultural, spiritual, or ceremonial significance, often represented as NFTs enabling communities to preserve and share cultural heritage through blockchain-verified authenticity and ownership."@en ;
    rdfs:subClassOf ngm:digital-heritage,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-cultural-heritage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ritual-artifact" ;
    vc:sourceDomain "spatial-computing" .

ngm:robot-localisation a owl:Class ;
    rdfs:label "Robot Localisation"@en ;
    rdfs:comment "Robot localisation is the problem of estimating a robot's pose, its position and orientation, within a known map from noisy sensor measurements and motion commands. It is typically solved with probabilistic filters that maintain a belief over possible poses and update it as new observations arrive. Accurate localisation is a prerequisite for reliable navigation and planning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:particle-filter ;
    vc:slug "robot-localisation" ;
    vc:sourceDomain "robotics" .

ngm:robot-rb-0001 a owl:Class ;
    rdfs:label "Robot RB-0001"@en ;
    rdfs:comment "Robot RB-0001 is an identifier-class for a reference mobile-manipulator robot platform that combines a mobile base with an articulated manipulator arm. As a composite robot, it integrates locomotion and manipulation subsystems so the system can both navigate an environment and perform physical tasks within it. It serves as a canonical example linking mobile-robot and manipulator capabilities."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:manipulator,
        ngm:mobile-robot ;
    vc:slug "robot-rb-0001" ;
    vc:sourceDomain "robotics" .

ngm:robot-simulation a owl:Class ;
    rdfs:label "Robot Simulation"@en ;
    rdfs:comment "Robot simulation is the use of physics-based virtual environments to model a robot's kinematics, dynamics, sensors, and interactions before or instead of deploying on hardware. It enables developers to test control software, validate motion plans, and generate training data safely and cheaply. Tight integration with robot middleware lets the same code run in simulation and on the physical robot."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:robot-operating-system ;
    vc:slug "robot-simulation" ;
    vc:sourceDomain "robotics" .

ngm:robot-singularity a owl:Class ;
    rdfs:label "Robot Singularity"@en ;
    rdfs:comment "A Robot Singularity is a configuration of a serial or parallel robot manipulator at which the Jacobian matrix loses rank, causing the determinant to approach zero. At a singularity, the robot loses one or more degrees of freedom in Cartesian space: it cannot produce force or motion in certain directions, and inverse kinematics solutions become ill-conditioned or non-unique. Singularity avoidance and detection are central problems in motion planning, trajectory generation, and real-time control of robotic arms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:kinematics ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:path-planning ;
    vc:requires ngm:differential-kinematics,
        ngm:inverse-kinematics ;
    vc:slug "robot-singularity" ;
    vc:sourceDomain "robotics" .

ngm:robotics-application a owl:Class ;
    rdfs:label "Robotics Application"@en ;
    rdfs:comment "A deployed use-case or task domain in which robotic systems perform physical or cyber-physical work, spanning industrial automation, telepresence, telemedicine, logistics, hazardous environment inspection, and collaborative human-robot interaction. Robotics applications integrate perception, planning, actuation, and communication subsystems to accomplish domain-specific objectives with varying degrees of autonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-control ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:robotic-telepresence,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-system,
        ngm:human-robot-interaction ;
    vc:requires ngm:robot-control ;
    vc:slug "robotics-application" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:robotic-system,
        ngm:sensor-fusion .

ngm:robotics-core-concepts a owl:Class ;
    rdfs:label "RoboticsCoreConcepts"@en ;
    rdfs:comment "A hierarchical taxonomic framework organizing the fundamental conceptual domains within robotics science and engineering, comprising ten core subdomains structured into four primary categories—autonomous systems (encompassing independent robotic platforms implementing path planning algorithms suc..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mathematical-foundations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:teleoperation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swarm-robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manipulator-arm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-vehicle,
        ngm:industrial-automation,
        ngm:robotics-education,
        ngm:robotics-research,
        ngm:service-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-robot,
        ngm:human-robot-interaction,
        ngm:manipulator-arm,
        ngm:path-planning,
        ngm:robot-learning,
        ngm:sensor-fusion,
        ngm:slam,
        ngm:soft-robotics,
        ngm:swarm-robotics,
        ngm:teleoperation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:computational-methods,
        ngm:hardware-design,
        ngm:mathematical-foundations,
        ngm:physics-modeling,
        ngm:software-engineering ;
    vc:slug "robotics-core-concepts" ;
    vc:sourceDomain "robotics" .

ngm:robotics-simulation a owl:Class ;
    rdfs:label "Robotics Simulation"@en ;
    rdfs:comment "Robotics simulation is the discipline of creating high-fidelity virtual worlds in which robots and their environments are modelled for development, testing, and synthetic-data generation. It emphasises scene description, physically based rendering, and interoperable asset pipelines so simulated environments transfer faithfully to deployment. Standards such as Universal Scene Description enable shared, composable simulation scenes across tools."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:procedural-and-hybrid-4-d,
        ngm:universal-scene-description ;
    vc:slug "robotics-simulation" ;
    vc:sourceDomain "robotics" .

ngm:robotics-telepresence-bridge a owl:Class ;
    rdfs:label "Robotics-Telepresence Bridge"@en ;
    rdfs:comment "\"The conceptual and technical integration between robotics systems and telepresence technologies, where remote operators experience physical presence in distant real-world locations through robot-mediated perception and action, combining robotic manipulation capabilities with telepresence social ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback-telepresence ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:hazardous-environment-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:haptic-feedback-telepresence ;
    vc:slug "robotics-telepresence-bridge" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:robust-control a owl:Class ;
    rdfs:label "Robust Control"@en ;
    rdfs:comment "Robust Control is a branch of control theory that designs controllers guaranteeing stable and acceptable performance across a bounded set of model uncertainties and disturbances. It formalises worst-case design requirements through H-infinity and H2 optimisation frameworks, ensuring actuated systems remain within specification even when plant parameters deviate from nominal values."@en ;
    rdfs:subClassOf ngm:control-algorithm,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:adaptive-control ;
    vc:enables ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "robust-control" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:robot-safety,
        ngm:trajectory-control ;
    vc:uses ngm:feedback-control,
        ngm:pid-control .

ngm:rocks-db a owl:Class ;
    rdfs:label "RocksDB"@en ;
    rdfs:comment "RocksDB is an embedded, high-performance key-value store built on a log-structured merge-tree and optimised for fast storage such as SSDs. It provides ordered keys, atomic batch writes, snapshots, and tunable compaction, and is embedded as a library rather than run as a server. It is widely used as the local state backend in databases and blockchain platforms."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyperledger-indy,
        ngm:hyperledger-iroha ;
    vc:slug "rocks-db" ;
    vc:sourceDomain "data" .

ngm:rootstock a owl:Class ;
    rdfs:label "Rootstock"@en ;
    rdfs:comment "A Bitcoin sidechain that supports Ethereum-compatible smart contracts, secured by merged mining with Bitcoin and connected through a two-way peg."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sidechain ],
        ngm:sidechain ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin,
        ngm:sidechain ;
    vc:slug "rootstock" ;
    vc:sourceDomain "blockchain" .

ngm:ros-industrial a owl:Class ;
    rdfs:label "ROS-Industrial"@en ;
    rdfs:comment "ROS-Industrial is an open-source project that extends the Robot Operating System with libraries, drivers, and interfaces for industrial manufacturing automation. It provides standardised drivers for industrial robot arms, motion-planning integration, and tools to bring advanced ROS capabilities into factory settings. It bridges research-grade robotics software with production-grade industrial hardware."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:robot-standard ;
    vc:slug "ros-industrial" ;
    vc:sourceDomain "robotics" .

ngm:ros-rep a owl:Class ;
    rdfs:label "ROS REP"@en ;
    rdfs:comment "A ROS Enhancement Proposal (REP) is a design document that defines conventions and standards for the Robot Operating System ecosystem, analogous to internet RFCs or Python PEPs. REPs codify agreements such as coordinate-frame conventions, units, naming, and message interfaces so that independently developed robotics components interoperate. They provide the normative reference that aligns platforms and libraries."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:robotics-platform ;
    vc:slug "ros-rep" ;
    vc:sourceDomain "robotics" .

ngm:rtab-map a owl:Class ;
    rdfs:label "RTAB-Map"@en ;
    rdfs:comment "RTAB-Map (Real-Time Appearance-Based Mapping) is an open-source library for RGB-D, stereo, and lidar graph-based SLAM with a memory-management scheme that bounds computation for large-scale, long-term operation. Its core is an appearance-based loop-closure detector that recognises previously visited places to correct accumulated drift. It is widely used on ground robots to build consistent metric and topological maps."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:topological-map ;
    vc:slug "rtab-map" ;
    vc:sourceDomain "robotics" .

ngm:rule-based-systems a owl:Class ;
    rdfs:label "Rule-Based Systems"@en ;
    rdfs:comment "Systems that represent knowledge as a set of condition-action rules and use an inference engine to derive conclusions or trigger actions from facts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:expert-systems ;
    vc:enables ngm:expert-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:inference-engine ;
    vc:slug "rule-based-systems" ;
    vc:sourceDomain "general" .

ngm:runes-protocol a owl:Class ;
    rdfs:label "Runes Protocol"@en ;
    rdfs:comment "A protocol for issuing fungible tokens on Bitcoin that records token data within transaction outputs using the unspent transaction output model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        ngm:token-standard ;
    vc:enables ngm:fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:utxo ;
    vc:slug "runes-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:runtime-inspection a owl:Class ;
    rdfs:label "Runtime Inspection"@en ;
    rdfs:comment "Runtime Inspection is the practice of dynamically examining the internal state, activations, attention patterns, and behavioural properties of an AI model while it is executing inference, as opposed to static analysis of weights or architecture prior to deployment. It enables detection of unexpected or dangerous reasoning paths, verification of safety constraints during live operation, and post-hoc explanation of individual predictions by observing intermediate computations at the moment they occur."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:ai-governance,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-safety,
        ngm:explainable-ai,
        ngm:formal-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-management,
        ngm:human-oversight,
        ngm:runtime-environment,
        ngm:traceability-mechanism ;
    vc:requires ngm:audit-trail,
        ngm:interpretability ;
    vc:slug "runtime-inspection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:model-transparency,
        ngm:monitoring-dashboard .

ngm:sa8000 a owl:Class ;
    rdfs:label "SA8000"@en ;
    rdfs:comment "SA8000 is a voluntary, auditable social-accountability standard developed by Social Accountability International that certifies organisations against decent-work criteria. It covers child and forced labour, health and safety, freedom of association, discrimination, working hours, and management systems, drawing on ILO conventions and human-rights instruments. Certification is used to demonstrate ethical labour practices across supply chains."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing ;
    vc:slug "sa8000" ;
    vc:sourceDomain "supply-chain" .

ngm:safe-human-robot-interaction a owl:Class ;
    rdfs:label "Safe Human-Robot Interaction"@en ;
    rdfs:comment "Safe human-robot interaction is the body of methods and controls that allow robots to operate in close proximity to people without causing harm. It combines compliant control, force and contact limiting, collision avoidance, and speed-and-separation monitoring so that physical contact, when it occurs, stays within safe limits. It is essential for collaborative robots that share workspaces with humans."@en ;
    rdfs:subClassOf ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:force-control ;
    vc:slug "safe-human-robot-interaction" ;
    vc:sourceDomain "robotics" .

ngm:safety-engineering a owl:Class ;
    rdfs:label "Safety Engineering"@en ;
    rdfs:comment "Safety engineering is the engineering discipline concerned with designing systems that avoid causing harm to people, property, and the environment under both normal and fault conditions. It applies hazard analysis, redundancy, fail-safe design, and quantified risk assessment across the system lifecycle. Functional safety and reliability engineering are specialised branches that address fault behaviour and dependable operation."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:reliability-engineering ;
    vc:slug "safety-engineering" ;
    vc:sourceDomain "robotics" .

ngm:safety-oecd a owl:Class ;
    rdfs:label "Safety (OECD)"@en ;
    rdfs:comment "Under the OECD AI Principles (Principle 1.4, updated 2024), AI systems must operate without posing unacceptable risks of physical, psychological, or environmental harm. This requires lifecycle-spanning hazard analysis, fail-safe design, continuous monitoring, and incident response mechanisms, with responsibilities shared between providers who design safety in and deployers who maintain operational safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:robustness-oecd ;
    vc:enables ngm:ai-governance,
        ngm:high-risk-ai-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:serious-incident ;
    vc:requires ngm:functional-safety,
        ngm:risk-management ;
    vc:slug "safety-oecd" ;
    vc:sourceDomain "spatial-computing" .

ngm:saml a owl:Class ;
    rdfs:label "SAML"@en ;
    rdfs:comment "Security Assertion Markup Language: an XML-based open standard for exchanging authentication and authorisation data between an identity provider and a service provider."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:authentication ;
    vc:enables ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:authentication ;
    vc:slug "saml" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:saml-2-0 a owl:Class ;
    rdfs:label "SAML 2.0"@en ;
    rdfs:comment "Version 2.0 of the Security Assertion Markup Language, an OASIS standard for exchanging authentication and authorisation assertions between identity providers and service providers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:authentication ;
    vc:enables ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:authentication ;
    vc:slug "saml-2-0" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:satoshi-nakamoto a owl:Class ;
    rdfs:label "Satoshi Nakamoto"@en ;
    rdfs:comment "Satoshi Nakamoto is the pseudonym used by the unidentified person or group who designed Bitcoin, authored its 2008 white paper and released the first reference implementation in 2009. Nakamoto introduced a practical solution to double-spending in a peer-to-peer electronic cash system through proof-of-work and a public, append-only ledger. The true identity behind the name remains unknown, and Nakamoto withdrew from public involvement in the project around 2010 to 2011."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:bitcoin,
        ngm:blockchain,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "satoshi-nakamoto" ;
    vc:sourceDomain "satoshi-nakamoto" .

ngm:sbti a owl:Class ;
    rdfs:label "SBTi"@en ;
    rdfs:comment "The Science Based Targets initiative (SBTi) is a body that defines and validates corporate greenhouse-gas reduction targets against climate science, specifically the goal of limiting warming to 1.5C. It publishes sector-specific methodologies and independently certifies that company targets are consistent with the Paris Agreement. SBTi validation has become a widely referenced benchmark in ESG reporting."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:science-based-targets ;
    vc:slug "sbti" ;
    vc:sourceDomain "supply-chain" .

ngm:scalable-deployment a owl:Class ;
    rdfs:label "Scalable Deployment"@en ;
    rdfs:comment "Scalable deployment is the practice of releasing and operating software so that capacity can grow or shrink with demand without redesign. It relies on stateless services, horizontal scaling, load balancing, container orchestration, and infrastructure-as-code to add resources elastically. It is essential for systems such as digital twins that must serve fluctuating workloads reliably."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-framework,
        ngm:digital-twin-infrastructure ;
    vc:slug "scalable-deployment" ;
    vc:sourceDomain "infrastructure" .

ngm:scenario-analysis a owl:Class ;
    rdfs:label "Scenario Analysis"@en ;
    rdfs:comment "Scenario analysis is a structured method for exploring how a system behaves under a set of plausible alternative futures rather than a single forecast. It defines coherent scenarios over key drivers and evaluates outcomes, risks, and decisions across each. It is widely used in financial planning, climate disclosure, and operational risk to stress-test strategies against uncertainty."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment,
        ngm:time-series-forecasting ;
    vc:slug "scenario-analysis" ;
    vc:sourceDomain "data" .

ngm:scene-design a owl:Class ;
    rdfs:label "Scene Design"@en ;
    rdfs:comment "Scene design is the process of composing and arranging the spatial, visual, and behavioural elements of a virtual or augmented environment. It encompasses layout of geometry, lighting, materials, cameras, and interactive objects within a scene graph. It is a foundational creative activity in metaverse, game, and immersive-media authoring."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authoring-tool,
        ngm:etsi-domain-creative-media ;
    vc:slug "scene-design" ;
    vc:sourceDomain "metaverse" .

ngm:scene-optimization a owl:Class ;
    rdfs:label "Scene Optimization"@en ;
    rdfs:comment "Scene Optimization is the set of techniques applied to 3D environments to reduce computational and bandwidth overhead while preserving perceptual fidelity, encompassing polygon reduction, texture compression and atlasing, draw call batching, occlusion culling, and level-of-detail management. These techniques are essential for achieving real-time frame rates on resource-constrained XR hardware and for supporting large concurrent user counts in metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-management ],
        ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:scene-management ;
    vc:slug "scene-optimization" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:level-of-detail,
        ngm:occlusion-culling .

ngm:schnorr-signatures a owl:Class ;
    rdfs:label "Schnorr Signatures"@en ;
    rdfs:comment "A digital signature scheme based on the discrete logarithm problem, producing compact signatures with linear key and signature aggregation properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:digital-signature ;
    vc:enables ngm:mu-sig-2,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:elliptic-curve-cryptography ;
    vc:slug "schnorr-signatures" ;
    vc:sourceDomain "cryptographic" .

ngm:scientific-discovery-acceleration a owl:Class ;
    rdfs:label "Scientific Discovery Acceleration"@en ;
    rdfs:comment "Scientific discovery acceleration is the application of artificial intelligence to compress the cycle of hypothesis generation, experimentation, and analysis across scientific disciplines. It includes AI-driven literature synthesis, simulation surrogates, automated experiment design, and prediction of structures or materials. It is often cited as a transformative potential outcome of advanced and general-purpose AI systems."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:history-and-path-to-agi ;
    vc:slug "scientific-discovery-acceleration" ;
    vc:sourceDomain "ai" .

ngm:scientific-research a owl:Class ;
    rdfs:label "Scientific Research"@en ;
    rdfs:comment "Scientific research is the systematic investigation of phenomena through observation, hypothesis, experiment, and analysis to produce reproducible knowledge. As an application domain for AI, it spans literature review, data analysis, modelling, and experiment automation. Modern AI systems and autonomous agents increasingly support researchers across the discovery, verification, and dissemination stages."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:ai-companies ;
    vc:slug "scientific-research" ;
    vc:sourceDomain "ai" .

ngm:scientific-simulation a owl:Class ;
    rdfs:label "Scientific Simulation"@en ;
    rdfs:comment "Scientific simulation is the numerical modelling of physical, chemical, or biological systems to predict behaviour that is impractical to observe directly. It solves governing equations across discretised domains, as in fluid dynamics, molecular dynamics, and climate modelling, typically on high-performance computing infrastructure. Machine learning increasingly augments simulation through learned surrogates and data-driven generation."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:generative-adversarial-networks ;
    vc:slug "scientific-simulation" ;
    vc:sourceDomain "infrastructure" .

ngm:scientific-visualisation a owl:Class ;
    rdfs:label "Scientific Visualisation"@en ;
    rdfs:comment "Scientific visualisation is the rendering of multidimensional scientific data into visual form to support analysis and communication. It includes volume rendering, isosurface extraction, flow and vector-field visualisation, and time-varying simulation playback. It depends on graphics rendering pipelines and techniques such as ray tracing to convey spatial and quantitative structure accurately."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing,
        ngm:rendering-pipeline ;
    vc:slug "scientific-visualisation" ;
    vc:sourceDomain "infrastructure" .

ngm:score-matching a owl:Class ;
    rdfs:label "Score Matching"@en ;
    rdfs:comment "Score matching is a method for fitting probability models by matching the gradient of the log-density, the score, of the model to that of the data, avoiding the intractable normalising constant. It underpins score-based generative models and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:machine-learning ;
    vc:enables ngm:diffusion-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "score-matching" ;
    vc:sourceDomain "machine-learning" .

ngm:screen-capture-api a owl:Class ;
    rdfs:label "Screen Capture API"@en ;
    rdfs:comment "The Screen Capture API is a W3C web platform interface, centred on getDisplayMedia, that lets web applications obtain a live media stream of a user-selected screen, window, or browser tab. It exposes the captured display as a MediaStream usable for recording, sharing, or processing, gated by an explicit user-selection prompt. It is the standard browser foundation for screen sharing and recording features."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:screen-recording,
        ngm:screen-sharing ;
    vc:slug "screen-capture-api" ;
    vc:sourceDomain "infrastructure" .

ngm:sd-jwt-vc a owl:Class ;
    rdfs:label "SD-JWT VC"@en ;
    rdfs:comment "A verifiable credential format that uses Selective Disclosure JSON Web Tokens, allowing a holder to reveal only chosen claims to a verifier. It combines the JWT structure with salted hashes that support selective disclosure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-web-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:selective-disclosure ],
        ngm:json-web-token ;
    vc:enables ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:json-web-token,
        ngm:selective-disclosure ;
    vc:slug "sd-jwt-vc" ;
    vc:sourceDomain "identity" .

ngm:sdf a owl:Class ;
    rdfs:label "SDF"@en ;
    rdfs:comment "SDF (Simulation Description Format) is an XML-based format for describing robots, sensors, and environments for simulation and control. Developed alongside the Gazebo simulator, it specifies kinematic and dynamic properties, links, joints, visual and collision geometry, and world contents. It is widely used in robotics for modelling platforms and scenes consistently across simulation and tooling."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kinematics-model,
        ngm:robotics-platform ;
    vc:slug "sdf" ;
    vc:sourceDomain "robotics" .

ngm:seals a owl:Class ;
    rdfs:label "Seals"@en ;
    rdfs:comment "Seals, in this knowledge graph context, refers to a practical AI pipeline experiment using traditional Chinese seal art (海豹-style stamps) as a five-shot image classification and translation task. The experiment demonstrates multimodal AI capabilities: image analysis via OpenAI vision APIs, English description generation, Chinese translation, and appropriateness ranking, subsequently serialised to JSON for potential NFT metadata enrichment."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:digital-asset,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:computer-vision ;
    vc:slug "seals" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-ai,
        ngm:image-generation,
        ngm:multimodal-ai .

ngm:search-interface a owl:Class ;
    rdfs:label "Search Interface"@en ;
    rdfs:comment "User-facing components that enable query input, result presentation, and navigation through search results in metaverse platforms, including text fields, voice input, spatial gestures, and augmented reality overlays for asset and experience discovery."@en ;
    rdfs:subClassOf ngm:sc-interaction,
        ngm:user-interface ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:user-query-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:search-technology a owl:Class ;
    rdfs:label "Search Technology"@en ;
    rdfs:comment "Search technology encompasses the algorithms, indexing systems, and retrieval mechanisms that enable efficient discovery of relevant information across structured and unstructured data sources. Modern search systems combine inverted indices, vector embeddings, and machine learning ranking models to support keyword, semantic, and hybrid queries at scale."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:enterprise-search,
        ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "search-technology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedding-model,
        ngm:natural-language-processing .

ngm:secondary-market-integration a owl:Class ;
    rdfs:label "Secondary Market Integration"@en ;
    rdfs:comment "Technical and business infrastructure connecting primary asset creation with resale marketplaces, enabling liquidity for digital collectibles, virtual real estate, and NFTs through automated royalty distribution and cross-platform trading protocols."@en ;
    rdfs:subClassOf ngm:digital-asset-trading,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:asset-liquidity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "secondary-market-integration" ;
    vc:sourceDomain "spatial-computing" .

ngm:section-508 a owl:Class ;
    rdfs:label "Section 508"@en ;
    rdfs:comment "Section 508 is an amendment to the US Rehabilitation Act requiring federal agencies to make their electronic and information technology accessible to people with disabilities. Its 2017 refresh harmonised the technical requirements with the WCAG 2.0 Level AA success criteria. It functions as an enforceable procurement and compliance standard for accessibility in US government IT."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility ;
    vc:slug "section-508" ;
    vc:sourceDomain "governance" .

ngm:secure-messaging a owl:Class ;
    rdfs:label "Secure Messaging"@en ;
    rdfs:comment "Secure messaging is the exchange of messages protected by cryptography so that only intended participants can read or authenticate them. It typically provides end-to-end encryption, forward secrecy, and integrity, often through ratcheting key-agreement protocols. It underpins privacy-preserving communication in consumer apps, enterprise systems, and decentralised networks."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:signal-protocol ;
    vc:slug "secure-messaging" ;
    vc:sourceDomain "security" .

ngm:securities-exchange-act-1934 a owl:Class ;
    rdfs:label "Securities Exchange Act 1934"@en ;
    rdfs:comment "The Securities Exchange Act of 1934 is the US federal law that governs secondary trading of securities and created the Securities and Exchange Commission. It establishes registration, disclosure, and anti-fraud requirements for exchanges, brokers, and listed companies. It is a foundational reference for determining how digital assets and investment products are regulated in the United States."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-etf,
        ngm:howey-test ;
    vc:slug "securities-exchange-act-1934" ;
    vc:sourceDomain "blockchain" .

ngm:security-domain a owl:Class ;
    rdfs:label "Security Domain"@en ;
    rdfs:comment "The Security Domain classifies concepts concerning the protection of systems, data and communications against unauthorised access, modification and disruption. It covers the principles of confidentiality, integrity and availability and the controls that enforce them. As a top-level subject axis it applies across all architectural layers, framing how trust is established and threats are countered."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulnerability-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-domain ],
        ngm:owl-thing ;
    vc:enables ngm:data-protection,
        ngm:trusted-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:access-control,
        ngm:authentication,
        ngm:encryption,
        ngm:threat-model,
        ngm:vulnerability-management ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-domain,
        ngm:identity-domain ;
    vc:slug "security-domain" ;
    vc:sourceDomain "security" .

ngm:security-operations a owl:Class ;
    rdfs:label "Security Operations"@en ;
    rdfs:comment "Security operations is the ongoing practice of monitoring, detecting, investigating, and responding to security threats across an organisation's systems. Centred on a security operations centre, it integrates log collection, SIEM correlation, alert triage, threat intelligence, and incident response. Its goal is to reduce dwell time and limit the impact of attacks through continuous vigilance."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring ;
    vc:slug "security-operations" ;
    vc:sourceDomain "security" .

ngm:security-standards a owl:Class ;
    rdfs:label "Security Standards"@en ;
    rdfs:comment "Security standards are published specifications that define requirements, controls, and best practices for protecting information systems. They span management frameworks such as ISO/IEC 27001, control catalogues such as NIST SP 800-53, and authentication standards. They provide a common basis for designing, assessing, and certifying the security posture of organisations and products."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:cybersecurity-standard ;
    vc:slug "security-standards" ;
    vc:sourceDomain "security" .

ngm:self-driving-car a owl:Class ;
    rdfs:label "Self Driving Car"@en ;
    rdfs:comment "A self-driving car is an autonomous passenger vehicle capable of sensing its environment and operating with minimal or no human input, employing AI-driven perception, decision-making, and control systems to navigate roads, comply with traffic regulations, and transport occupants safely. Self-driving cars represent the consumer application of autonomous vehicle technology, typically targeting SAE Level 3–5 automation in urban and highway environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:autonomous-vehicle ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adas ;
    vc:requires ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "self-driving-car" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:lidar,
        ngm:motion-planning .

ngm:self-presence a owl:Class ;
    rdfs:label "Self Presence"@en ;
    rdfs:comment "The subjective sense that one's virtual or avatar representation in a mediated environment is a genuine extension of the physical self — encompassing body ownership, proprioceptive coherence, and self-location within virtual space. Self presence is a component of overall presence and a prerequisite for authentic immersive collaboration, as it governs how naturally users interact with and move through shared virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-avatar ],
        ngm:dc-telepresence,
        ngm:presence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:embodied-ai,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:immersion,
        ngm:presence ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:emotional-immersion,
        ngm:social-presence,
        ngm:spatial-presence,
        ngm:user-experience,
        ngm:virtual-presence ;
    vc:requires ngm:avatar,
        ngm:digital-avatar ;
    vc:slug "self-presence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-capture .

ngm:self-regulation a owl:Class ;
    rdfs:label "Self-Regulation"@en ;
    rdfs:comment "An arrangement in which an industry or professional community sets and enforces its own rules of conduct, typically through codes of practice and member oversight rather than direct state legislation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:governance-framework ;
    vc:enables ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:accountability,
        ngm:compliance ;
    vc:slug "self-regulation" ;
    vc:sourceDomain "governance" .

ngm:semantic-metadata-registry a owl:Class ;
    rdfs:label "Semantic Metadata Registry"@en ;
    rdfs:comment "A centralized catalog managing structured metadata schemas, controlled vocabularies, and semantic relationships to enable consistent asset description, cross-platform interoperability, and intelligent discovery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:term-definitions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:namespace-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary-services ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabularies ],
        ngm:infra-data-management,
        ngm:metadata-registry ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:asset-cataloging,
        ngm:cross-platform-interoperability,
        ngm:data-integration,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:controlled-vocabularies,
        ngm:metadata-schema,
        ngm:namespace-management,
        ngm:relationship-mappings,
        ngm:schema-versioning,
        ngm:term-definitions ;
    vc:isPartOf ngm:metadata-management-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:rdf-store,
        ngm:schema-validator,
        ngm:vocabulary-services ;
    vc:slug "semantic-metadata-registry" ;
    vc:sourceDomain "infrastructure" .

ngm:semantic-scene-understanding a owl:Class ;
    rdfs:label "Semantic Scene Understanding"@en ;
    rdfs:comment "Semantic scene understanding is the computer-vision task of parsing a visual environment into labelled, structured representations of objects, surfaces, and their spatial and functional relationships. It goes beyond object detection by assigning meaning to regions, inferring affordances, and building a coherent model of the scene that downstream systems can reason over. It is foundational to spatial computing, where digital content must be anchored to real-world geometry and semantics."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-scene-graph,
        ngm:mixed-reality ;
    vc:slug "semantic-scene-understanding" ;
    vc:sourceDomain "ai" .

ngm:semantic-web-infrastructure a owl:Class ;
    rdfs:label "Semantic Web Infrastructure"@en ;
    rdfs:comment "Semantic web infrastructure is the stack of standards, vocabularies, and services that enable machine-readable, linked data on the web, including RDF, OWL, SPARQL endpoints, triple stores, and ontology registries. It provides the technical substrate for representing entities and relationships as interoperable graphs that agents can query and reason over. It is the backbone for knowledge graphs and linked-data ecosystems."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:metaverse-ontology-schema ;
    vc:slug "semantic-web-infrastructure" ;
    vc:sourceDomain "data" .

ngm:sensor-fusion-layer a owl:Class ;
    rdfs:label "Sensor Fusion Layer"@en ;
    rdfs:comment "The Sensor Fusion Layer is the stratum that combines data from multiple sensors into a single, more reliable estimate of state. It sits above the Hardware sensing devices and below the Perception Layer that interprets the fused result. It contains alignment, filtering, and fusion algorithms together with uncertainty models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-layer ],
        ngm:owl-thing ;
    vc:enables ngm:perception-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware-layer ;
    vc:slug "sensor-fusion-layer" ;
    vc:sourceDomain "sensor-fusion" .

ngm:seoul-declaration a owl:Class ;
    rdfs:label "Seoul Declaration"@en ;
    rdfs:comment "The Seoul Declaration is an international AI-safety commitment adopted at the 2024 AI Seoul Summit, in which participating states and companies affirmed principles of safe, innovative, and inclusive AI and pledged cooperation on frontier-model risk. It built on the Bletchley Declaration and advanced commitments to risk thresholds and safety frameworks for advanced AI systems. It is a governance instrument shaping Asia-Pacific and global AI regulation."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:asia-pacific-regulation ;
    vc:slug "seoul-declaration" ;
    vc:sourceDomain "governance" .

ngm:separation-of-powers a owl:Class ;
    rdfs:label "Separation Of Powers"@en ;
    rdfs:comment "Governance design patterns in decentralized autonomous organizations that distribute authority across distinct functional roles, preventing concentration of control through checks and balances between proposal creation, voting, execution, and oversight functions."@en ;
    rdfs:subClassOf ngm:dao-governance,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:decentralized-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "separation-of-powers" ;
    vc:sourceDomain "spatial-computing" .

ngm:sequential-monte-carlo a owl:Class ;
    rdfs:label "Sequential Monte Carlo"@en ;
    rdfs:comment "Sequential Monte Carlo is a family of methods that approximate evolving probability distributions using a set of weighted samples updated recursively as new observations arrive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monte-carlo-integration ],
        ngm:numerical-methods ;
    vc:enables ngm:particle-filter ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:monte-carlo-integration ;
    vc:slug "sequential-monte-carlo" ;
    vc:sourceDomain "metaverse" .

ngm:service-robotics a owl:Class ;
    rdfs:label "Service Robotics"@en ;
    rdfs:comment "Service robotics is the branch of robotics concerned with robots that perform useful tasks for humans outside industrial manufacturing, including cleaning, logistics, hospitality, healthcare, and domestic assistance. These systems emphasise autonomous navigation in unstructured human environments, safe interaction, and task planning under uncertainty. It is a rapidly growing application domain of mobile and collaborative robots."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robotics-core-concepts,
        ngm:task-planning ;
    vc:slug "service-robotics" ;
    vc:sourceDomain "robotics" .

ngm:sh-ex a owl:Class ;
    rdfs:label "ShEx"@en ;
    rdfs:comment "ShEx (Shape Expressions) is a language for describing and validating the structure of RDF graphs, specifying which properties a node must have, their cardinalities, and value constraints. It serves a role for linked data analogous to schemas for XML or JSON, enabling data producers and consumers to agree on graph shapes. It is widely used to validate Solid pods and Wikidata-style knowledge graphs."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:solid ;
    vc:slug "sh-ex" ;
    vc:sourceDomain "data" .

ngm:sha-3 a owl:Class ;
    rdfs:label "SHA-3"@en ;
    rdfs:comment "SHA-3 is a family of cryptographic hash functions standardised by NIST in FIPS 202, based on the Keccak sponge construction rather than the Merkle-Damgaard design of SHA-2. Its sponge structure provides strong resistance to length-extension attacks and offers configurable output lengths and extendable-output functions. It is used as a collision-resistant primitive in digital signatures and integrity verification."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:digital-signature ;
    vc:slug "sha-3" ;
    vc:sourceDomain "security" .

ngm:shared-ar-experiences a owl:Class ;
    rdfs:label "Shared Ar Experiences"@en ;
    rdfs:comment "Collaborative augmented reality interactions enabling multiple users to simultaneously view and interact with digital content overlaid on shared physical environments, supporting real-time synchronization of virtual objects across devices for social connection and joint activities."@en ;
    rdfs:subClassOf ngm:augmented-reality,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:social-ar-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "shared-ar-experiences" ;
    vc:sourceDomain "spatial-computing" .

ngm:side-channel-attack a owl:Class ;
    rdfs:label "Side-Channel Attack"@en ;
    rdfs:comment "A side-channel attack recovers secret information by observing physical or behavioural artefacts of a cryptographic implementation rather than breaking its underlying mathematics. Exploitable channels include timing variation, power consumption, electromagnetic emissions, cache access patterns, and acoustic emanations. It is a critical implementation-level threat that motivates constant-time code and masking countermeasures."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:hash-function ;
    vc:slug "side-channel-attack" ;
    vc:sourceDomain "security" .

ngm:siem a owl:Class ;
    rdfs:label "SIEM"@en ;
    rdfs:comment "SIEM (Security Information and Event Management) is a platform that aggregates, normalises, and correlates log and event data from across an organisation's IT estate to detect threats and support compliance. It combines real-time alerting, anomaly detection, and historical search with dashboards and audit reporting. It is a foundational tool of security operations centres and regulatory compliance programmes."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:cyber-security-and-cryptography ;
    vc:slug "siem" ;
    vc:sourceDomain "security" .

ngm:sign-language-recognition a owl:Class ;
    rdfs:label "Sign Language Recognition"@en ;
    rdfs:comment "Sign language recognition is the computer-vision and sequence-modelling task of translating the manual and non-manual gestures of a signed language into text or speech. It must model hand shape, motion trajectory, facial expression, and grammatical structure that differs fundamentally from spoken languages. It is an accessibility-focused application that builds on robust hand tracking and temporal recognition."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hand-tracking,
        ngm:human-computer-interaction ;
    vc:slug "sign-language-recognition" ;
    vc:sourceDomain "ai" .

ngm:simulation-layer a owl:Class ;
    rdfs:label "Simulation Layer"@en ;
    rdfs:comment "The Simulation Layer is the cross-cutting stratum that models system or environment behaviour to test and predict outcomes without acting on the real world. It sits above compute and model strata it uses and supports research, evaluation, and planning. It contains simulators, environment models, and the scenarios run within them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-layer ],
        ngm:owl-thing ;
    vc:enables ngm:evaluation-layer,
        ngm:research-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:model-layer ;
    vc:slug "simulation-layer" ;
    vc:sourceDomain "simulation" .

ngm:sink-mechanism a owl:Class ;
    rdfs:label "Sink Mechanism"@en ;
    rdfs:comment "A Sink Mechanism is an economic design pattern that permanently removes virtual currency, tokens, or items from circulation in order to counterbalance sources of supply and maintain economic equilibrium, preventing hyperinflation in metaverse economies, play-to-earn platforms, and DeFi protocols. Effective sinks are integrated into desirable activities — such as cosmetic purchases, crafting costs, or transaction fees — so that value removal feels voluntary and rewarding to participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economic-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-currency ],
        ngm:bc-defi-and-economics,
        ngm:virtual-economy ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:inflation ;
    vc:enables ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenomics,
        ngm:virtual-economy ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:economic-mechanism,
        ngm:virtual-currency ;
    vc:slug "sink-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:siopv2 a owl:Class ;
    rdfs:label "SIOPv2"@en ;
    rdfs:comment "SIOPv2 (Self-Issued OpenID Provider v2) is an OpenID Foundation specification that extends OpenID Connect so a user's own wallet acts as the identity provider, authenticating with self-issued and decentralised identifiers rather than a third-party server. It lets relying parties verify a subject controls a DID and, paired with OpenID for Verifiable Presentations, accept verifiable credentials. It is a key protocol for decentralised, wallet-centric digital identity."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:distributed-identity ;
    vc:slug "siopv2" ;
    vc:sourceDomain "security" .

ngm:situational-awareness a owl:Class ;
    rdfs:label "Situational Awareness"@en ;
    rdfs:comment "Situational awareness is an agent's perception of relevant elements in its environment, comprehension of their meaning and projection of their near-future state, supporting timely decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:robotics-domain ;
    vc:enables ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-vision ;
    vc:slug "situational-awareness" ;
    vc:sourceDomain "metaverse" .

ngm:slam-toolbox a owl:Class ;
    rdfs:label "SLAM Toolbox"@en ;
    rdfs:comment "SLAM Toolbox is an open-source ROS package for 2D simultaneous localisation and mapping using laser scan matching and pose-graph optimisation. It supports online mapping, lifelong mapping with map serialisation and continuation, and localisation against pre-built maps, making it a default mapping stack for indoor mobile robots. It is widely deployed on ground robots running the ROS navigation stack."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:mobile-robot-platform ;
    vc:slug "slam-toolbox" ;
    vc:sourceDomain "robotics" .

ngm:sliding-mode-control a owl:Class ;
    rdfs:label "Sliding Mode Control"@en ;
    rdfs:comment "Sliding mode control is a nonlinear, robust control method that drives a system's state onto a designed sliding surface and constrains it there using high-frequency switching of the control input. Once on the surface, the closed-loop dynamics become insensitive to matched disturbances and parameter uncertainty, giving strong robustness. It is a control-theory technique widely applied to robotic actuators and power electronics, though it can induce chattering."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:control-theory ;
    vc:slug "sliding-mode-control" ;
    vc:sourceDomain "robotics" .

ngm:small-modular-reactors a owl:Class ;
    rdfs:label "Small Modular Reactors"@en ;
    rdfs:comment "Small modular reactors (SMRs) are nuclear fission reactors with an electrical output typically under 300 MWe whose components are factory-fabricated as standardised modules and assembled on site. Their smaller scale, passive safety features, and modular construction aim to lower capital cost and deployment time relative to gigawatt-scale plants. They are an emerging low-carbon power-infrastructure option, including for energy-intensive data centres."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power,
        ngm:sustainability ;
    vc:slug "small-modular-reactors" ;
    vc:sourceDomain "infrastructure" .

ngm:smart-bft a owl:Class ;
    rdfs:label "SMaRT-BFT"@en ;
    rdfs:comment "SMaRT-BFT is a Byzantine fault tolerant consensus approach built on the SMaRt (State Machine Replication) library, used to order transactions deterministically across a fixed set of validating nodes. It tolerates up to f faulty replicas out of 3f+1 total while guaranteeing safety and liveness under partial synchrony. It is commonly deployed in permissioned ledgers where validator identity is known and high throughput with finality is required."@en ;
    rdfs:subClassOf ngm:consensus-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-as-a-service,
        ngm:byzantine-fault-tolerance,
        ngm:consortium-blockchain ;
    vc:slug "smart-bft" ;
    vc:sourceDomain "blockchain" .

ngm:smart-contract-enforcement a owl:Class ;
    rdfs:label "Smart Contract Enforcement"@en ;
    rdfs:comment "Smart contract enforcement is the property by which the terms encoded in a self-executing on-chain program are carried out automatically and irreversibly once predefined conditions are met, without requiring trust in a counterparty or intermediary. Enforcement derives from the deterministic execution of code on a distributed ledger and the immutability of recorded state. It reduces reliance on external legal recourse while raising questions of how code-based outcomes interact with conventional contract law."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:arbitration-process,
        ngm:non-repudiation ;
    vc:slug "smart-contract-enforcement" ;
    vc:sourceDomain "blockchain" .

ngm:smart-contract-governance a owl:Class ;
    rdfs:label "Smart Contract Governance"@en ;
    rdfs:comment "Smart contract governance is the set of mechanisms by which the rules, upgrades, and parameters of deployed on-chain contracts are proposed, decided, and applied, typically through token voting, multisig control, or upgrade proxies. It addresses how immutable code can nonetheless evolve safely and who holds authority to change protocol behaviour. Effective governance balances decentralisation against the need for timely security fixes and legal accountability."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-legal-structures,
        ngm:e-contract-arbitration,
        ngm:smart-contract ;
    vc:slug "smart-contract-governance" ;
    vc:sourceDomain "blockchain" .

ngm:smpl-body-model a owl:Class ;
    rdfs:label "SMPL Body Model"@en ;
    rdfs:comment "SMPL (Skinned Multi-Person Linear model) is a parametric 3D human body model that represents body shape and pose with a low-dimensional set of parameters driving a deformable triangle mesh. It separates identity-dependent shape blend shapes from pose-dependent corrective deformations, enabling realistic articulated bodies that fit motion capture and image data. It is a foundational representation in human pose and shape estimation pipelines."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:pose-estimation ;
    vc:slug "smpl-body-model" ;
    vc:sourceDomain "ai" .

ngm:soar a owl:Class ;
    rdfs:label "SOAR"@en ;
    rdfs:comment "SOAR (Security Orchestration, Automation and Response) is a class of platforms that coordinate detection tools, automate repetitive incident-handling workflows, and orchestrate response actions across a security stack through codified playbooks. It ingests alerts from disparate sources, enriches them with context, and executes graded responses to reduce analyst workload and mean time to respond. The acronym also denotes Soar, a cognitive architecture for modelling general intelligence, but in security contexts the orchestration sense dominates."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-ai,
        ngm:cyber-security-and-cryptography ;
    vc:slug "soar" ;
    vc:sourceDomain "security" .

ngm:social-impact a owl:Class ;
    rdfs:label "Social Impact"@en ;
    rdfs:comment "Social Impact refers to the full spectrum of effects — positive and negative, intended and unintended — that AI systems and digital technologies exert on individuals, communities, and social structures, encompassing changes to employment patterns, educational access, cultural practices, power distributions, social cohesion, and fundamental rights. Assessing social impact requires both quantitative metrics and qualitative analysis across affected stakeholder groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:social-impact-assessment-sia ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:digital-society-harms ;
    vc:enables ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-society,
        ngm:social-contract,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:ai-impact-assessment,
        ngm:social-impact-assessment-sia ;
    vc:slug "social-impact" ;
    vc:sourceDomain "spatial-computing" .

ngm:social-layer a owl:Class ;
    rdfs:label "Social Layer"@en ;
    rdfs:comment "The Social Layer is the cross-cutting stratum that represents the human relationships, norms, and communities that surround and use a system. It sits above the institutional structures that formalise it and informs governance and application design. It contains community norms, reputation, communication channels, and the informal conventions that shape behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:institutional-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:governance-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:institutional-layer ;
    vc:slug "social-layer" ;
    vc:sourceDomain "social" .

ngm:social-recovery a owl:Class ;
    rdfs:label "Social Recovery"@en ;
    rdfs:comment "Social recovery is a wallet security mechanism that lets a user regain control of an account by relying on a set of trusted guardians rather than a single seed phrase. If a signing key is lost, a quorum of designated guardians can authorise a key rotation to a new owner address without ever holding the funds themselves. It mitigates catastrophic key loss while preserving self-custody, and is a flagship use case for smart-contract wallets."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:account-abstraction,
        ngm:multi-sig-governance ;
    vc:slug "social-recovery" ;
    vc:sourceDomain "blockchain" .

ngm:sociotechnical-analysis a owl:Class ;
    rdfs:label "Sociotechnical Analysis"@en ;
    rdfs:comment "Sociotechnical analysis is a methodology that evaluates a technology by examining the interaction between its technical components and the human, organisational, and societal contexts in which it operates, rather than the artefact in isolation. Applied to AI, it traces how models, data, deployment settings, and affected communities jointly produce outcomes and harms. It is central to anticipating systemic risks that purely technical evaluation overlooks."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:sociotechnical-system ;
    vc:slug "sociotechnical-analysis" ;
    vc:sourceDomain "governance" .

ngm:sociotechnical-harm a owl:Class ;
    rdfs:label "Sociotechnical Harm"@en ;
    rdfs:comment "Sociotechnical harm is an adverse outcome that emerges from the interaction between a technical system and its social context rather than from a technical fault alone, such as representational harm, allocative discrimination, or erosion of public discourse. These harms are often diffuse, cumulative, and unevenly distributed across affected groups, making them hard to detect with conventional accuracy metrics. Identifying them requires attention to who is affected, how, and through what social mechanisms."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-in-large-language-models,
        ngm:sociotechnical-system ;
    vc:slug "sociotechnical-harm" ;
    vc:sourceDomain "governance" .

ngm:software-development-automation a owl:Class ;
    rdfs:label "Software Development Automation"@en ;
    rdfs:comment "Software development automation is the use of tooling and AI agents to perform engineering tasks such as code generation, test writing, refactoring, dependency updates, and pull-request creation with minimal human intervention. Modern systems combine large language models with execution environments and version-control integrations to act on a codebase rather than merely suggest text. It aims to compress development cycles while keeping humans in the loop for review and intent."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "software-development-automation" ;
    vc:sourceDomain "ai" .

ngm:solid-pod-storage a owl:Class ;
    rdfs:label "Solid Pod Storage"@en ;
    rdfs:comment "Solid Pod Storage refers to the personal online data stores used in the Solid project, a web specification initiated by Tim Berners-Lee for decentralising data ownership. A Pod is a user-controlled storage space that holds data as linked-data resources, with access governed by the user rather than the applications that consume it. Applications authenticate against a Pod and read or write data only with the owner's permission, separating data from the services built on top of it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linked-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-id ],
        ngm:distributed-systems-domain ;
    vc:enables ngm:data-sovereignty,
        ngm:decentralised-identity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:linked-data,
        ngm:rdf,
        ngm:web-id ;
    vc:slug "solid-pod-storage" ;
    vc:sourceDomain "solid-pod-storage" .

ngm:sound-money-principles a owl:Class ;
    rdfs:label "Sound Money Principles"@en ;
    rdfs:comment "Sound money principles are the criteria by which a monetary asset is judged a reliable store of value and medium of exchange: scarcity, durability, divisibility, portability, fungibility, verifiability, and resistance to debasement by any issuer. Rooted in classical and Austrian monetary economics, they are frequently invoked to argue that a fixed-supply, credibly neutral asset preserves purchasing power over time. They form the economic case advanced for Bitcoin as a monetary good."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:bitcoin-value-proposition ;
    vc:slug "sound-money-principles" ;
    vc:sourceDomain "blockchain" .

ngm:sovereign-mesh a owl:Class ;
    rdfs:label "Sovereign Mesh"@en ;
    rdfs:comment "A peer-to-peer agent network where each node is identified by a DID Nostr Identity|did:nostr:<pubkey> DIDs and communicates via Nostr Relay|Nostr relays, enabling decentralised agent discovery, gossip, and work distribution without a centralised broker or coordinator, whilst respecting ea..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-340-schnorr-keypair ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nostr-relay ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-nostr-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nostr-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-signing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-discovery ],
        ngm:bc-network-component,
        ngm:peer-to-peer-network ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralised-agent-coordination,
        ngm:federation,
        ngm:trustless-peer-communication,
        ngm:work-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-beacon,
        ngm:did-nostr-identity,
        ngm:gossip-protocol,
        ngm:nostr-relay,
        ngm:peer-discovery ;
    vc:implements ngm:gossip-consensus,
        ngm:nostr-protocol-nip-01,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:requires ngm:bip-340-schnorr-keypair,
        ngm:message-signing,
        ngm:network-connectivity,
        ngm:nostr-protocol ;
    vc:slug "sovereign-mesh" ;
    vc:sourceDomain "blockchain" .

ngm:sparql-query-engine a owl:Class ;
    rdfs:label "Sparql Query Engine"@en ;
    rdfs:comment "A processor implementing the SPARQL Protocol and RDF Query Language (W3C standard) for retrieving, manipulating, and joining data stored in Resource Description Framework graphs, enabling semantic web queries through pattern matching of subject-predicate-object triples with support for filtering,..."@en ;
    rdfs:subClassOf ngm:query-processor,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:semantic-data-retrieval ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "sparql-query-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-ai a owl:Class ;
    rdfs:label "Spatial AI"@en ;
    rdfs:comment "Spatial AI is the application of machine learning and computer vision to understand, represent, and reason about three-dimensional physical space. It encompasses scene understanding, semantic mapping, depth estimation, and object detection, enabling robots, AR/VR systems, and autonomous agents to interpret their environment and plan actions within it."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:embodied-ai,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:neural-radiance-field,
        ngm:spatial-computing,
        ngm:spatial-mapping-technology ;
    vc:slug "spatial-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:3-d-gaussian-splatting,
        ngm:depth-estimation,
        ngm:object-detection,
        ngm:scene-understanding,
        ngm:semantic-segmentation .

ngm:spatial-annotation a owl:Class ;
    rdfs:label "Spatial Annotation"@en ;
    rdfs:comment "Spatial annotation is the placement of digital notes, labels, or markers anchored to specific positions in a three-dimensional physical or virtual space, so that the content persists relative to real-world geometry as the viewer moves. It relies on spatial mapping and pose tracking to keep annotations registered to surfaces or objects. It is a foundational interaction for augmented reality collaboration, maintenance guidance, and shared spatial computing."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-overlay,
        ngm:digital-content-overlay ;
    vc:slug "spatial-annotation" ;
    vc:sourceDomain "metaverse" .

ngm:spatial-audio-processor a owl:Class ;
    rdfs:label "Spatial Audio Processor"@en ;
    rdfs:comment "Hardware or software component that renders three-dimensional sound using Head-Related Transfer Functions (HRTFs) and binaural synthesis, processing audio signals to simulate directional sound sources at specific positions in virtual space with real-time head tracking integration for immersive au..."@en ;
    rdfs:subClassOf ngm:audio-processing-system,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-sound-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-audio-processor" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-calibration a owl:Class ;
    rdfs:label "Spatial Calibration"@en ;
    rdfs:comment "The process of aligning virtual coordinate frames with physical world references in AR/VR systems, including camera calibration for video see-through displays and optical calibration for see-through displays, ensuring accurate registration of digital content with the real environment."@en ;
    rdfs:subClassOf ngm:ar-registration,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:accurate-ar-alignment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-calibration" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-database a owl:Class ;
    rdfs:label "Spatial Database"@en ;
    rdfs:comment "A database system optimized for storing, indexing, and querying georeferenced data and geometric objects, supporting spatial data types (points, lines, polygons) and spatial operations (intersection, containment, proximity) per OGC Simple Features specification for GIS and metaverse applications."@en ;
    rdfs:subClassOf ngm:database-system,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:geospatial-data-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-database" ;
    vc:sourceDomain "infrastructure" .

ngm:spatial-mapping-technology a owl:Class ;
    rdfs:label "Spatial Mapping Technology"@en ;
    rdfs:comment "Spatial Mapping Technology refers to hardware and software systems that capture, process, and maintain geometric representations of physical environments in real time, enabling AR and MR devices to understand and interact with their surroundings. Core techniques include depth sensing, structured light, time-of-flight, and SLAM algorithms that fuse sensor data into persistent, updatable mesh models."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:spatial-anchor,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:lidar,
        ngm:point-cloud ;
    vc:slug "spatial-mapping-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:sensor-fusion,
        ngm:slam .

ngm:spatial-metadata a owl:Class ;
    rdfs:label "Spatial Metadata"@en ;
    rdfs:comment "Descriptive information about geospatial and 3D content documenting location, coordinate system, projection, quality, lineage, and distribution attributes, following standards such as ISO 19115 and FGDC CSDGM to enable discovery, eand interoperability of spatial data resources."@en ;
    rdfs:subClassOf ngm:geospatial-information,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:spatial-data-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-metadata" ;
    vc:sourceDomain "spatial-computing" .

ngm:spir-v a owl:Class ;
    rdfs:label "SPIR-V"@en ;
    rdfs:comment "SPIR-V is a binary intermediate representation for shaders and parallel-compute kernels standardised by the Khronos Group, used as the portable bytecode target for Vulkan, OpenCL, and OpenGL. High-level shading languages such as GLSL and HLSL compile to SPIR-V, which drivers then translate to native GPU instructions, decoupling source languages from hardware. It enables offline compilation, validation, and optimisation of graphics and compute programs across vendors."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "spir-v" ;
    vc:sourceDomain "infrastructure" .

ngm:sports-analytics a owl:Class ;
    rdfs:label "Sports Analytics"@en ;
    rdfs:comment "Sports analytics is the application of data capture, statistical modelling, and machine learning to athletic performance, tactics, and injury prevention, drawing on tracking data, biomechanics, and event logs. Computer-vision pipelines increasingly supply the underlying movement data by extracting player positions and body pose from video. It informs coaching decisions, talent evaluation, broadcast insight, and load management."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:pose-estimation ;
    vc:slug "sports-analytics" ;
    vc:sourceDomain "ai" .

ngm:spot-ethereum-etf a owl:Class ;
    rdfs:label "Spot Ethereum ETF"@en ;
    rdfs:comment "A spot Ethereum ETF is an exchange-traded fund that holds actual ether and tracks its market price, allowing investors to gain regulated exposure to ETH through ordinary brokerage accounts without self-custody. Unlike futures-based products, it backs each share with the underlying asset held by a custodian. Its approval by securities regulators marked a significant step in integrating a major crypto asset into traditional capital markets."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:securities-regulation ;
    vc:slug "spot-ethereum-etf" ;
    vc:sourceDomain "blockchain" .

ngm:sprint-planning a owl:Class ;
    rdfs:label "Sprint Planning"@en ;
    rdfs:comment "Sprint planning is the Scrum event in which a development team selects items from the product backlog and defines a goal and plan for the upcoming time-boxed iteration. The team negotiates scope against capacity, decomposes chosen items into actionable work, and commits to a realistic sprint backlog. It establishes shared understanding of what will be delivered and how, anchoring the iteration's focus."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:software-development ;
    vc:slug "sprint-planning" ;
    vc:sourceDomain "infrastructure" .

ngm:ssim-metric a owl:Class ;
    rdfs:label "SSIM Metric"@en ;
    rdfs:comment "The Structural Similarity Index (SSIM) is a perceptual image-quality metric that compares two images by modelling luminance, contrast, and structural correlation over local windows, rather than measuring pixel-wise error alone. It correlates better with human judgement of quality than mean squared error or PSNR, producing a score between -1 and 1 where 1 indicates identical structure. It is widely used to evaluate compression, restoration, and generative reconstruction."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:image-and-video-restoration ;
    vc:slug "ssim-metric" ;
    vc:sourceDomain "ai" .

ngm:stable-diffusion-training a owl:Class ;
    rdfs:label "Stable Diffusion Training"@en ;
    rdfs:comment "Stable Diffusion training is the process of fitting a latent text-to-image diffusion model by teaching a denoising network to reverse a gradual noising process in a compressed latent space, conditioned on text embeddings. Operating in latent rather than pixel space sharply reduces compute and memory, while techniques such as fine-tuning, LoRA, and DreamBooth adapt a base model to new styles or subjects. It underpins much of open-weight generative image and video tooling."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai,
        ngm:proprietary-ai-video ;
    vc:slug "stable-diffusion-training" ;
    vc:sourceDomain "ai" .

ngm:stable-swap-invariant a owl:Class ;
    rdfs:label "Stable Swap Invariant"@en ;
    rdfs:comment "The stable swap invariant is an automated market maker pricing formula, introduced by Curve Finance, that blends the constant-sum and constant-product curves to provide very low slippage for trades between assets expected to hold near-equal value, such as stablecoins or pegged tokens. Near the balanced point it behaves like a constant-sum market for tight pricing, while curving toward constant-product behaviour as reserves diverge to preserve liquidity. It is the core mechanism enabling efficient stablecoin exchange on-chain."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:liquidity-provision ;
    vc:slug "stable-swap-invariant" ;
    vc:sourceDomain "blockchain" .

ngm:stablecoins-on-bitcoin a owl:Class ;
    rdfs:label "Stablecoins on Bitcoin"@en ;
    rdfs:comment "Stablecoins on Bitcoin are price-stable tokens issued and transferred on Bitcoin-based protocols such as Taproot Assets, Liquid, or RGB, rather than on smart-contract chains like Ethereum. They aim to bring dollar-denominated value transfer to the Bitcoin ecosystem, leveraging Bitcoin's settlement security and, where combined with the Lightning Network, near-instant low-cost payments. They extend Bitcoin's utility from a single monetary asset toward a broader settlement layer for fiat-pegged value."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3,
        ngm:taproot-assets ;
    vc:slug "stablecoins-on-bitcoin" ;
    vc:sourceDomain "blockchain" .

ngm:startup-ecosystem a owl:Class ;
    rdfs:label "Startup Ecosystem"@en ;
    rdfs:comment "A startup ecosystem is the interconnected network of founders, investors, talent, universities, accelerators, service providers, and regulators within a region that collectively enables new high-growth companies to form and scale. Its health depends on capital availability, dense knowledge spillovers, and supportive policy, which together produce self-reinforcing network effects. Concentrations such as Silicon Valley illustrate how these dynamics compound advantage and shape the trajectory of emerging technologies including AI."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
