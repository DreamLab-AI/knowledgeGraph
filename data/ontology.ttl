ngm:credential-format-standard a owl:Class ;
    rdfs:label "Credential Format Standard"@en ;
    rdfs:comment "Technical specifications defining the structure, encoding, and cryptographic verification methods for digital credentials, enabling secure issuance, storage, and verification of identity documents, certifications, and attestations across different platforms and systems through interoperable formats such as W3C Verifiable Credentials and ISO mDL."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proofs ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-body ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifier ],
        ngm:identity-standards ;
    vc:bridgesTo ngm:did-nostr-identity,
        ngm:eu-digital-identity-wallet ;
    vc:contrastsWith ngm:jwt-token,
        ngm:saml-assertion ;
    vc:enables ngm:credential-verification,
        ngm:identity-portability,
        ngm:selective-disclosure,
        ngm:trust-interoperability,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:iso-mdl,
        ngm:sd-jwt,
        ngm:w3c-verifiable-credentials ;
    vc:qualityScore "0.65"^^xsd:float ;
