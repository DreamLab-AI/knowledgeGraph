    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constitutional-ai-training-methodology,
        ngm:mechanistic-interpretability,
        ngm:model-context-protocol,
        ngm:responsible-scaling-policy ;
    vc:qualityScore "0.9"^^xsd:float ;
