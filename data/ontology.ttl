ngm:trustless-coordination a owl:Class ;
    rdfs:label "Trustless Coordination"@en ;
    rdfs:comment "Trustless coordination is the achievement of agreement and joint action among parties who do not trust one another, enforced by protocol rules and cryptography rather than a trusted intermediary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
