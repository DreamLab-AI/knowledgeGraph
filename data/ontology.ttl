        ngm:human-computer-interaction,
        ngm:social-robotics,
        ngm:speech-recognition,
        ngm:teleoperation,
        ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robo-actuation-and-control,
        ngm:robo-perception,
        ngm:robo-safety-and-standards,
        ngm:robot-control ;
    vc:slug "robo-human-robot-interaction" ;
    vc:sourceDomain "robotics" .

ngm:3-d-asset a owl:Class ;
    rdfs:label "3D Asset"@en ;
    rdfs:comment "A 3D Asset is a discrete, self-contained digital artefact encoding three-dimensional geometry, surface materials, skeletal animation rigs, and associated metadata in a machine-readable interchange format such as glTF 2.0, USD, FBX, or OBJ. Such assets are produced by digital content creation tools, stored in asset management systems with versioning and provenance records, and consumed at runtime by rendering engines, game engines, and spatial computing platforms. Production-quality 3D assets typically incorporate multiple levels of detail (LOD), physically-based rendering (PBR) material maps (albedo, metallic-roughness, normal, occlusion, emissive), collision meshes for physics simulation, and compressed texture atlases optimised for a target hardware envelope. Cross-platform delivery relies on open standards maintained by the Khronos Group and Pixar/Academy Software Foundation, enabling asset reuse across metaverse environments, digital twins, extended reality (XR) applications, and game titles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:polygon-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:skeletal-rig ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:generative-ai,
        ngm:neural-radiance-field,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:voxel ;
    vc:enables ngm:digital-twin,
        ngm:extended-reality,
        ngm:metaverse,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:level-of-detail,
        ngm:polygon-mesh,
        ngm:skeletal-rig,
        ngm:texture-map ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:scene-graph,
        ngm:spatial-computing ;
    vc:requires ngm:asset-pipeline,
        ngm:digital-content-creation,
        ngm:physically-based-rendering ;
    vc:slug "3-d-asset" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:academy-software-foundation,
        ngm:khronos-group,
        ngm:w3-c ;
    vc:uses ngm:digital-asset-management,
        ngm:gltf-standard,
        ngm:texture-compression,
        ngm:universal-scene-description .

ngm:containerisation a owl:Class ;
    rdfs:label "Containerisation"@en ;
    rdfs:comment "Containerisation is an operating-system-level virtualisation technique that packages an application together with its dependencies, libraries, and configuration into a single portable, isolated unit called a container. Containers share the host kernel yet maintain isolated user spaces, making them far lighter than full virtual machines while remaining reproducible across environments. The approach underpins cloud-native software delivery, providing consistent runtime behaviour from a developer's laptop to production clusters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:container-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container-runtime ],
        ngm:virtualisation ;
    vc:contrastsWith ngm:virtual-machine ;
    vc:dependsOn ngm:virtual-machine ;
    vc:enables ngm:cloud-native,
        ngm:container-orchestration,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:container-runtime ;
    vc:implements ngm:immutable-infrastructure ;
    vc:isPartOf ngm:cloud-native ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gitops,
        ngm:kubernetes ;
    vc:requires ngm:container-runtime ;
    vc:slug "containerisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:continuous-deployment,
        ngm:devops ;
    vc:uses ngm:cloud-computing .

ngm:cross-chain-interoperability a owl:Class ;
    rdfs:label "Cross-Chain Interoperability"@en ;
    rdfs:comment "Cross-Chain Interoperability is the technical capacity for distinct blockchain networks to communicate, transfer assets, and share arbitrary state without relying on a centralised intermediary, achieved through mechanisms such as light-client bridges, relay chains, atomic swaps, and standardised inter-blockchain communication protocols. It addresses the heterogeneous consensus problem—the challenge of enabling two networks with different finality guarantees and trust models to agree on the validity of cross-chain events—through cryptographic proofs, validator sets, or shared security frameworks. Prominent implementations include the Cosmos IBC protocol, Polkadot's Cross-Consensus Message Format (XCM), LayerZero's oracle-relayer model, and zero-knowledge proof bridges that verify source-chain state transitions with minimal on-chain trust. The field is foundational to the composable multi-chain ecosystem in which digital assets, governance rights, and smart contract logic can flow freely across sovereign networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-chain-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:atomic-swap ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-chain-bridge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-client-verification ],
        ngm:blockchain-interoperability ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:distributed-systems,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:wrapped-token ;
    vc:dependsOn ngm:cryptographic-proof,
        ngm:distributed-ledger-technology,
        ngm:hash-time-locked-contract ;
    vc:enables ngm:cross-chain-governance,
        ngm:cross-chain-liquidity,
        ngm:decentralised-finance,
        ngm:multi-chain-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:atomic-swap,
        ngm:cross-chain-bridge,
        ngm:cross-chain-messaging,
        ngm:light-client-verification ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:layer-2-scaling,
        ngm:oracle-network,
        ngm:polkadot ;
    vc:requires ngm:consensus-mechanism,
        ngm:merkle-proof,
        ngm:smart-contract ;
    vc:slug "cross-chain-interoperability" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:cosmos-ibc,
        ngm:ieee-standards ;
    vc:uses ngm:cosmos-ibc,
        ngm:interoperability-protocol,
        ngm:polkadot-xcm,
        ngm:zero-knowledge-proof .

ngm:data-centre a owl:Class ;
    rdfs:label "Data Centre"@en ;
    rdfs:comment "A data centre is a dedicated facility that houses computing, storage and networking infrastructure together with the power, cooling and physical security needed to operate them reliably. It provides the consolidated environment for hosting servers, cloud services and high-performance workloads such as AI training. Its energy and power demands make efficiency, measured through metrics like PUE, a central operational and sustainability concern."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cooling-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-and-power ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-distribution-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-switch ],
        ngm:computing-infrastructure ;
    vc:bridgesTo ngm:carbon-footprint,
        ngm:renewable-energy ;
    vc:contrastsWith ngm:edge-computing,
        ngm:fog-computing ;
