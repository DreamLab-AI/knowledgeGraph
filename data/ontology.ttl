            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:session-management ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:edge-computing ;
    vc:dependsOn ngm:distributed-systems,
        ngm:identity-and-access-management,
        ngm:network-quality-metric ;
    vc:enables ngm:metaverse,
        ngm:mixed-reality-platform,
        ngm:social-vr,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
