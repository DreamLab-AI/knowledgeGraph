ngm:gradle a owl:Class ;
    rdfs:label "Gradle"@en ;
    rdfs:comment "Gradle is an open-source build-automation tool that uses a directed acyclic graph of tasks to compile, test, and package software, primarily for JVM languages such as Java, Kotlin, and Groovy. Its build scripts are written as a domain-specific language in Groovy or Kotlin, and it supports incremental builds, dependency management, and a build cache for speed. It is widely used in enterprise and Android development, including blockchain platforms built on the JVM."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
