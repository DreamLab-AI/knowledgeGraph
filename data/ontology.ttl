    vc:slug "6-g-network-slice" ;
    vc:sourceDomain "infrastructure" .

ngm:accessible-experience a owl:Class ;
    rdfs:label "Accessible Experience"@en ;
    rdfs:comment "An Accessible Experience is a virtual environment or application delivering equivalent functionality and engagement to users with disabilities through multimodal access pathways, assistive technology integration, and Accessible Design principles."@en ;
    rdfs:subClassOf ngm:inclusive-experience,
        ngm:sc-governance-and-safety,
        ngm:user-experience ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:equitable-engagement,
        ngm:inclusive-participation,
        ngm:universal-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:alternative-input-methods,
        ngm:assistive-technology-support,
        ngm:multimodal-interfaces ;
    vc:slug "accessible-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:accountability-oecd a owl:Class ;
    rdfs:label "Accountability (OECD)"@en ;
    rdfs:comment "Organisations and individuals developing, deploying or operating AI systems should be accountable for their proper functioning in accordance with OECD AI Principles and applicable legal frameworks, based on their roles, context and ability to act."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:policy-framework ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:continuous-improvement,
        ngm:effective-governance,
        ngm:redress ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence ;
    vc:slug "accountability-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:accounts a owl:Class ;
    rdfs:label "Accounts"@en ;
    rdfs:comment "Accounts denotes the financial reporting and filing obligations of a limited company under UK law, encompassing annual accounts preparation, Companies House submission deadlines, confirmation statements, and the penalties regime for late filing."@en ;
