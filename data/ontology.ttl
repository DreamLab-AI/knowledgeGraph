    vc:slug "cloud-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:data-protection a owl:Class ;
    rdfs:label "Data Protection"@en ;
    rdfs:comment "A comprehensive set of processes and technologies that safeguard personal and system data in virtual environments through encryption, access control, privacy preservation, and regulatory compliance mechanisms."@en ;
