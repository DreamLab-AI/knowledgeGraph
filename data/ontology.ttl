        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:layer-2-scaling ;
    vc:bridgesTo ngm:digital-twin,
        ngm:real-time-data-stream ;
    vc:contrastsWith ngm:optimistic-rollup,
        ngm:plasma,
        ngm:rollup ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptographic-hash-function ;
    vc:enables ngm:high-frequency-trading,
        ngm:instant-finality,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dispute-resolution-mechanism,
        ngm:payment-channel,
