    owl:someValuesFrom artificial-intelligence:sociallicenceforAI
] .

# AI Audit
artificial-intelligence:AIAudit rdf:type owl:Class ;
    rdfs:label "AI Audit"@en ;
    rdfs:comment "A systematic, independent examination and evaluation of an artificial intelligence system's design, development processes, deployment procedures, operational performance, documentation, governance arrangements, and compliance with applicable requirements, conducted by qualified assessors to verify conformity with specified standards, regulations, ethical principles, or organisational policies, and to identify deficiencies, risks, or opportunities for improvement, producing documented findings and recommendations that support accountability, transparency, and continuous enhancement of AI system trustworthiness."@en ;
    skos:prefLabel "AI Audit"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-audit" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-audit> ;
    vcw:contentHash "sha256-12-940a042995bf" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0105" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0105" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AIAudit rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom artificial-intelligence:AIdocumentation
] .

