    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:feature-extraction,
        ngm:generative-adversarial-network,
        ngm:variational-autoencoders ;
    vc:slug "autoencoder" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:latent-space,
        ngm:unsupervised-learning .

