ngm:trust-in-automation a owl:Class ;
    rdfs:label "Trust in Automation"@en ;
    rdfs:comment "The psychological state in which a human user accepts vulnerability to an automated system's actions based on expectations that the system will perform appropriately to achieve the user's goals, despite uncertainty and the possibility of negative consequences. It represents the user's confidence in the system's reliability, competence, and integrity, and when miscalibrated manifests as over-trust (complacency) or under-trust (disuse)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        ngm:human-factors,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:collaborative-systems-modality-robot,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:explainable-ai,
        ngm:human-robot-interaction,
        ngm:robot,
        ngm:safety ;
    vc:requires ngm:explainability,
        ngm:transparency ;
    vc:slug "trust-in-automation" ;
    vc:sourceDomain "robotics" .

ngm:trust-in-digital-platforms a owl:Class ;
    rdfs:label "Trust in Digital Platforms"@en ;
    rdfs:comment "Trust in digital platforms is the confidence users place in online services to handle their data, transactions, and interactions safely, fairly, and reliably. It is shaped by security and privacy guarantees, transparent policies, dispute resolution, and consumer-protection measures, and is a prerequisite for sustained participation and economic activity in digital markets."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:participant-protection ;
    vc:slug "trust-in-digital-platforms" ;
    vc:sourceDomain "governance" .

