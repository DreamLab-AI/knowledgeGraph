    vc:enables ngm:capital-adequacy,
        ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:scenario-analysis ;
    vc:implements ngm:risk-assessment ;
    vc:isPartOf ngm:prudential-regulation,
        ngm:risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:basel-iii,
        ngm:central-bank ;
    vc:requires ngm:scenario-analysis,
        ngm:simulation ;
    vc:slug "stress-testing" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:regulatory-compliance ;
    vc:uses ngm:simulation .

ngm:swarm-robotics a owl:Class ;
    rdfs:label "Swarm Robotics"@en ;
    rdfs:comment "Swarm robotics employs large numbers of simple, autonomous agents that exhibit sophisticated collective behaviours through local interactions and decentralised control without centralised coordination, inspired by biological swarms like ant colonies and bird flocks. Individual robots with limited sensing, computation, and actuation communicate locally with neighbours, creating emergent system-level intelligence enabling tasks like coordinated navigation, object transport, and environmental sensing that exceed individual capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-agent-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-sensor ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:centralized-robot-control,
        ngm:single-robot-system ;
