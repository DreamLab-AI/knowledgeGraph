        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:digital-identity,
        ngm:virtual-identity ;
    vc:slug "digital-avatar" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-customization,
        ngm:generative-ai,
        ngm:motion-capture .

