    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-driving-perception,
        ngm:medical-image-analysis,
        ngm:quality-control,
        ngm:satellite-monitoring,
        ngm:surgical-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder,
        ngm:image-segmentation,
        ngm:instance-segmentation,
        ngm:medical-imaging,
        ngm:panoptic-segmentation,
