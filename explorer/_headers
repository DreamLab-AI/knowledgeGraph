/*
  # Security Headers for GitHub Pages / Netlify / Cloudflare
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Content Security Policy - Allow WASM and inline styles for React
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob:; worker-src 'self' blob:; frame-ancestors 'none'

# WASM files need correct MIME type
/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Don't cache API/data files
/api/*
  Cache-Control: no-cache, must-revalidate

/data/*
  Cache-Control: no-cache, must-revalidate
